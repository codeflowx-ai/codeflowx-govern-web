<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://www.flowable.org/test">
  <process id="drift-detection-v1" name="Drift Detection V1" isExecutable="true" version="1.0">
    <startEvent id="startDriftCheck" name="Start Drift Check">
      <timerEventDefinition>
        <timeCycle>R/PT1H</timeCycle>
      </timerEventDefinition>
    </startEvent>
    <serviceTask id="loadBaselineMetrics" name="Load Baseline Metrics" flowable:delegateExpression="${loadBaselineMetricsDelegate}"></serviceTask>
    <serviceTask id="captureCurrentMetrics" name="Capture Current Metrics" flowable:delegateExpression="${captureCurrentMetricsDelegate}"></serviceTask>
    <serviceTask id="analyzeDrift" name="Analyze Drift" flowable:delegateExpression="${analyzeDriftDelegate}"></serviceTask>
    <businessRuleTask id="calculateDriftScore" name="Calculate Drift Score (Drools)" flowable:ruleVariablesInput="${driftDetectionFact}" flowable:resultVariable="driftResult"></businessRuleTask>
    <exclusiveGateway id="driftDecisionGateway" name="Drift Decision Gateway"></exclusiveGateway>
    <serviceTask id="saveMetricsNoDrift" name="Save Metrics (No Drift)" flowable:delegateExpression="${saveDriftResultsDelegate}"></serviceTask>
    <serviceTask id="createDriftAlert" name="Create Drift Alert" flowable:delegateExpression="${createDriftAlertDelegate}"></serviceTask>
    <serviceTask id="notifyDriftCritical" name="Notify Drift Critical" flowable:delegateExpression="${notifyDriftDelegate}"></serviceTask>
    <userTask id="analyzeDriftCause" name="Analyze Drift Cause" flowable:candidateGroups="ml-engineers,mlops-engineers" flowable:formKey="console/bpmn/drift-analysis-form.zul"></userTask>
    <exclusiveGateway id="actionGateway" name="Action Gateway"></exclusiveGateway>
    <serviceTask id="triggerRetraining" name="Trigger Retraining" flowable:delegateExpression="${triggerRetrainingDelegate}"></serviceTask>
    <serviceTask id="rollbackModel" name="Rollback Model" flowable:delegateExpression="${rollbackModelDelegate}"></serviceTask>
    <serviceTask id="tuneThresholds" name="Tune Thresholds" flowable:delegateExpression="${tuneThresholdsDelegate}"></serviceTask>
    <serviceTask id="saveDriftResults" name="Save Drift Results" flowable:delegateExpression="${saveDriftResultsDelegate}"></serviceTask>
    <endEvent id="endDriftCheck" name="End Drift Check"></endEvent>
    <boundaryEvent id="driftReviewTimer" name="Drift Review Timer (48h)" attachedToRef="analyzeDriftCause" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P2D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="driftReviewDecision" name="Drift Review Decision (SLA)" flowable:candidateGroups="ml-leads,mlops-engineers" flowable:formKey="console/bpmn/drift-review-decision-form.zul" flowable:priority="90"></userTask>
    <exclusiveGateway id="reviewDecisionGateway" name="Review Decision Gateway"></exclusiveGateway>
    <sequenceFlow id="flow1" sourceRef="startDriftCheck" targetRef="loadBaselineMetrics"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="loadBaselineMetrics" targetRef="captureCurrentMetrics"></sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="captureCurrentMetrics" targetRef="analyzeDrift"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="analyzeDrift" targetRef="calculateDriftScore"></sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="calculateDriftScore" targetRef="driftDecisionGateway"></sequenceFlow>
    <sequenceFlow id="flow6" name="NO_DRIFT" sourceRef="driftDecisionGateway" targetRef="saveMetricsNoDrift">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${driftResult.decision == 'NO_DRIFT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow7" name="DRIFT_DETECTED" sourceRef="driftDecisionGateway" targetRef="createDriftAlert">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${driftResult.decision == 'DRIFT_DETECTED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow8" name="CRITICAL_DRIFT" sourceRef="driftDecisionGateway" targetRef="notifyDriftCritical">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${driftResult.decision == 'CRITICAL_DRIFT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow9" sourceRef="saveMetricsNoDrift" targetRef="endDriftCheck"></sequenceFlow>
    <sequenceFlow id="flow10" sourceRef="createDriftAlert" targetRef="analyzeDriftCause"></sequenceFlow>
    <sequenceFlow id="flow11" sourceRef="notifyDriftCritical" targetRef="analyzeDriftCause"></sequenceFlow>
    <sequenceFlow id="flow12" sourceRef="analyzeDriftCause" targetRef="actionGateway"></sequenceFlow>
    <sequenceFlow id="flow13" name="RETRAIN" sourceRef="actionGateway" targetRef="triggerRetraining">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${action_plan == 'retrain' || action_plan == 'RETRAIN'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow14" name="ROLLBACK" sourceRef="actionGateway" targetRef="rollbackModel">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${action_plan == 'rollback' || action_plan == 'ROLLBACK'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow15" name="TUNE" sourceRef="actionGateway" targetRef="tuneThresholds">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${action_plan == 'tune_threshold' || action_plan == 'TUNE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow16" name="RETRAIN" sourceRef="reviewDecisionGateway" targetRef="triggerRetraining">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reviewDecision == 'RETRAIN'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow17" name="WAIT_MORE_DATA" sourceRef="reviewDecisionGateway" targetRef="saveDriftResults">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reviewDecision == 'WAIT_MORE_DATA'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow18" name="ACCEPT_DRIFT" sourceRef="reviewDecisionGateway" targetRef="saveDriftResults">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reviewDecision == 'ACCEPT_DRIFT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow19" name="INVESTIGATE" sourceRef="actionGateway" targetRef="saveDriftResults">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${action_plan == 'investigate' || action_plan == 'INVESTIGATE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow20" sourceRef="triggerRetraining" targetRef="saveDriftResults"></sequenceFlow>
    <sequenceFlow id="flow21" sourceRef="rollbackModel" targetRef="saveDriftResults"></sequenceFlow>
    <sequenceFlow id="flow22" sourceRef="tuneThresholds" targetRef="saveDriftResults"></sequenceFlow>
    <sequenceFlow id="flow23" sourceRef="saveDriftResults" targetRef="endDriftCheck"></sequenceFlow>
    <sequenceFlow id="flow24" sourceRef="driftReviewTimer" targetRef="driftReviewDecision"></sequenceFlow>
    <sequenceFlow id="flow25" sourceRef="driftReviewDecision" targetRef="reviewDecisionGateway"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_drift-detection-v1">
    <bpmndi:BPMNPlane bpmnElement="drift-detection-v1" id="BPMNPlane_drift-detection-v1">
      <bpmndi:BPMNShape bpmnElement="startDriftCheck" id="BPMNShape_startDriftCheck">
        <omgdc:Bounds height="35.0" width="35.0" x="90.0" y="260.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="loadBaselineMetrics" id="BPMNShape_loadBaselineMetrics">
        <omgdc:Bounds height="80.0" width="100.0" x="191.0" y="238.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
