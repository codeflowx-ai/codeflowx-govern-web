      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endDriftCheck" id="BPMNShape_endDriftCheck">
        <omgdc:Bounds height="35.0" width="35.0" x="1850.0" y="318.0"></omgdc:Bounds>
