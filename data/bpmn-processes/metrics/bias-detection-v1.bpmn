      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="biasReviewTimer" id="BPMNShape_biasReviewTimer">
        <omgdc:Bounds height="30.0" width="30.0" x="941.0" y="260.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="rejectBiasedModel" id="BPMNShape_rejectBiasedModel">
        <omgdc:Bounds height="80.0" width="100.0" x="841.0" y="484.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="reviewerActionGateway" id="BPMNShape_reviewerActionGateway">
        <omgdc:Bounds height="40.0" width="40.0" x="1119.0" y="282.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="acceptResidualRisk" id="BPMNShape_acceptResidualRisk">
        <omgdc:Bounds height="80.0" width="100.0" x="1280.0" y="80.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="generateMitigationRecommendations" id="BPMNShape_generateMitigationRecommendations">
        <omgdc:Bounds height="88.0" width="121.0" x="1320.0" y="279.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="rejectModelForBias" id="BPMNShape_rejectModelForBias">
        <omgdc:Bounds height="80.0" width="100.0" x="1331.0" y="420.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="notifyBiasResults" id="BPMNShape_notifyBiasResults">
        <omgdc:Bounds height="80.0" width="100.0" x="1510.0" y="227.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endBiasDetection" id="BPMNShape_endBiasDetection">
        <omgdc:Bounds height="35.0" width="35.0" x="1720.0" y="442.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="biasUrgentDecision" id="BPMNShape_biasUrgentDecision">
        <omgdc:Bounds height="80.0" width="100.0" x="921.0" y="48.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flow1" id="BPMNEdge_flow1">
        <omgdi:waypoint x="155.0" y="322.0"></omgdi:waypoint>
        <omgdi:waypoint x="220.0" y="322.0"></omgdi:waypoint>
