<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://codeflowx.com/govern/dataset-lineage">
  <process id="dataset-lineage-tracking-v1" name="Dataset Lineage Tracking V1" isExecutable="true" version="1.0" flowable:candidateStarterGroups="data-engineers">
    <startEvent id="startLineageTracking" name="Start Lineage Tracking">
      <outgoing>flow1</outgoing>
    </startEvent>
    
    <!-- Registrar transformación -->
    <serviceTask id="recordTransformation" name="Record Transformation" flowable:class="com.codeflowx.govern.workflow.delegates.dataset.RecordTransformationDelegate">
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
    </serviceTask>
    
    <!-- Actualizar lineage -->
    <serviceTask id="updateLineage" name="Update Lineage" flowable:class="com.codeflowx.govern.workflow.delegates.dataset.UpdateLineageDelegate">
      <incoming>flow2</incoming>
      <outgoing>flow3</outgoing>
    </serviceTask>
    
    <!-- Verificar dependencias -->
    <serviceTask id="checkDependencies" name="Check Dependencies" flowable:class="com.codeflowx.govern.workflow.delegates.dataset.CheckLineageDependenciesDelegate">
      <incoming>flow3</incoming>
      <outgoing>flow4</outgoing>
    </serviceTask>
    
    <!-- Gateway: ¿Hay dependencias afectadas? -->
    <exclusiveGateway id="dependenciesGateway" name="Dependencies Affected?">
      <incoming>flow4</incoming>
      <outgoing>flow5</outgoing>
      <outgoing>flow6</outgoing>
    </exclusiveGateway>
    
    <!-- Hay dependencias: Notificar stakeholders -->
    <serviceTask id="notifyStakeholders" name="Notify Affected Stakeholders" flowable:class="com.codeflowx.govern.workflow.delegates.dataset.NotifyLineageStakeholdersDelegate">
      <incoming>flow5</incoming>
      <outgoing>flow6</outgoing>
    </serviceTask>
    
    <!-- Guardar lineage -->
    <serviceTask id="saveLineage" name="Save Lineage" flowable:class="com.codeflowx.govern.workflow.delegates.dataset.SaveLineageDelegate">
      <incoming>flow6</incoming>
      <outgoing>flow7</outgoing>
    </serviceTask>
    
    <endEvent id="endLineageTracking" name="Lineage Tracking Completed">
      <incoming>flow7</incoming>
    </endEvent>
    
    <!-- Sequence Flows -->
    <sequenceFlow id="flow1" sourceRef="startLineageTracking" targetRef="recordTransformation"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="recordTransformation" targetRef="updateLineage"></sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="updateLineage" targetRef="checkDependencies"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="checkDependencies" targetRef="dependenciesGateway"></sequenceFlow>
    <sequenceFlow id="flow5" name="Yes" sourceRef="dependenciesGateway" targetRef="notifyStakeholders">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasDependencies == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow6" name="No" sourceRef="dependenciesGateway" targetRef="saveLineage">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${hasDependencies == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow7" sourceRef="notifyStakeholders" targetRef="saveLineage"></sequenceFlow>
    <sequenceFlow id="flow8" sourceRef="saveLineage" targetRef="endLineageTracking"></sequenceFlow>
  </process>
  
  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_dataset-lineage-tracking-v1">
    <bpmndi:BPMNPlane bpmnElement="dataset-lineage-tracking-v1" id="BPMNPlane_dataset-lineage-tracking-v1">
      <bpmndi:BPMNShape id="BPMNShape_startLineageTracking" bpmnElement="startLineageTracking">
        <omgdc:Bounds x="182" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_recordTransformation" bpmnElement="recordTransformation">
        <omgdc:Bounds x="150" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateLineage" bpmnElement="updateLineage">
        <omgdc:Bounds x="150" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_checkDependencies" bpmnElement="checkDependencies">
        <omgdc:Bounds x="150" y="600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_dependenciesGateway" bpmnElement="dependenciesGateway">
        <omgdc:Bounds x="175" y="795" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_notifyStakeholders" bpmnElement="notifyStakeholders">
        <omgdc:Bounds x="150" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_saveLineage" bpmnElement="saveLineage">
        <omgdc:Bounds x="350" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endLineageTracking" bpmnElement="endLineageTracking">
        <omgdc:Bounds x="182" y="1162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="218" y="118" />
        <omgdi:waypoint x="150" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="250" y="280" />
        <omgdi:waypoint x="150" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
        <omgdi:waypoint x="250" y="460" />
        <omgdi:waypoint x="150" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4" bpmnElement="flow4">
        <omgdi:waypoint x="250" y="640" />
        <omgdi:waypoint x="175" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow5" bpmnElement="flow5">
        <omgdi:waypoint x="225" y="820" />
        <omgdi:waypoint x="150" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow6" bpmnElement="flow6">
        <omgdi:waypoint x="225" y="820" />
        <omgdi:waypoint x="350" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow7" bpmnElement="flow7">
        <omgdi:waypoint x="250" y="1000" />
        <omgdi:waypoint x="350" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow8" bpmnElement="flow8">
        <omgdi:waypoint x="450" y="1000" />
        <omgdi:waypoint x="182" y="1180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>

