      <bpmndi:BPMNShape id="BPMNShape_createAdapterRecord" bpmnElement="createAdapterRecord">
        <omgdc:Bounds x="350" y="1500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_triggerAdapterTrainingJob" bpmnElement="triggerAdapterTrainingJob">
