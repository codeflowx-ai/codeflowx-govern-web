<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://codeflowx.com/govern/prompt-approval">
  <process id="prompt-approval-v1" name="Prompt Approval Process V1" isExecutable="true" version="1.0">
    <startEvent id="startEvent" name="Start Prompt Approval">
      <outgoing>flow1</outgoing>
    </startEvent>
    <userTask id="requestApproval" name="Request Prompt Approval" flowable:candidateGroups="ml-engineers" flowable:formKey="prompt-approval-request-form">
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
    </userTask>
    <parallelGateway id="parallelStart" name="Parallel Start">
      <incoming>flow2</incoming>
      <outgoing>flowToSafety</outgoing>
      <outgoing>flowToCompliance</outgoing>
    </parallelGateway>
    <serviceTask id="safetyCheck" name="Prompt Safety Check" flowable:class="com.codeflowx.govern.workflow.delegates.PromptSafetyDelegate">
      <incoming>flowToSafety</incoming>
      <outgoing>flowFromSafety</outgoing>
    </serviceTask>
    <serviceTask id="complianceCheck" name="Compliance Check" flowable:class="com.codeflowx.govern.workflow.delegates.ComplianceCheckDelegate">
      <incoming>flowToCompliance</incoming>
      <outgoing>flowFromCompliance</outgoing>
    </serviceTask>
    <parallelGateway id="parallelMerge" name="Parallel Merge">
      <incoming>flowFromSafety</incoming>
      <incoming>flowFromCompliance</incoming>
      <outgoing>flow3</outgoing>
    </parallelGateway>
    <exclusiveGateway id="autoApproveGateway" name="Auto-Approve?">
      <incoming>flow3</incoming>
      <outgoing>flowAutoApprove</outgoing>
      <outgoing>flowNeedReview</outgoing>
    </exclusiveGateway>
    <serviceTask id="autoApprove" name="Auto-Approve" flowable:class="com.codeflowx.govern.workflow.delegates.AutoApprovePromptDelegate">
      <incoming>flowAutoApprove</incoming>
      <outgoing>flowAutoToNotify</outgoing>
    </serviceTask>
    <userTask id="humanReview" name="Human Review" flowable:candidateGroups="prompt-engineers,ml-engineers" flowable:formKey="prompt-human-review-form">
      <incoming>flowNeedReview</incoming>
      <outgoing>flow4</outgoing>
    </userTask>
    <exclusiveGateway id="approvalDecisionGateway" name="Approved?">
      <incoming>flow4</incoming>
      <outgoing>flowApproved</outgoing>
      <outgoing>flowRejected</outgoing>
    </exclusiveGateway>
    <serviceTask id="notifyApproval" name="Notify Approval" flowable:class="com.codeflowx.govern.workflow.delegates.NotifyApprovalDelegate">
      <incoming>flowApproved</incoming>
      <incoming>flowAutoToNotify</incoming>
      <outgoing>flowToApprovedEnd</outgoing>
    </serviceTask>
    <userTask id="provideRejectionReason" name="Provide Rejection Reason" flowable:candidateGroups="prompt-engineers,ml-engineers" flowable:formKey="prompt-rejection-form">
      <incoming>flowRejected</incoming>
      <outgoing>flowToNotifyReject</outgoing>
    </userTask>
    <serviceTask id="notifyRejection" name="Notify Rejection" flowable:class="com.codeflowx.govern.workflow.delegates.NotifyApprovalDelegate">
      <incoming>flowToNotifyReject</incoming>
      <outgoing>flowToRejectedEnd</outgoing>
    </serviceTask>
    <endEvent id="endApproved" name="Prompt Approved">
      <incoming>flowToApprovedEnd</incoming>
    </endEvent>
    <endEvent id="endRejected" name="Prompt Rejected">
      <incoming>flowToRejectedEnd</incoming>
    </endEvent>
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="requestApproval"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="requestApproval" targetRef="parallelStart"></sequenceFlow>
    <sequenceFlow id="flowToSafety" sourceRef="parallelStart" targetRef="safetyCheck"></sequenceFlow>
    <sequenceFlow id="flowToCompliance" sourceRef="parallelStart" targetRef="complianceCheck"></sequenceFlow>
    <sequenceFlow id="flowFromSafety" sourceRef="safetyCheck" targetRef="parallelMerge"></sequenceFlow>
    <sequenceFlow id="flowFromCompliance" sourceRef="complianceCheck" targetRef="parallelMerge"></sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="parallelMerge" targetRef="autoApproveGateway"></sequenceFlow>
    <sequenceFlow id="flowAutoApprove" name="Auto-Approve" sourceRef="autoApproveGateway" targetRef="autoApprove">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${autoApproveEligible}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowNeedReview" name="Need Review" sourceRef="autoApproveGateway" targetRef="humanReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!autoApproveEligible}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAutoToNotify" sourceRef="autoApprove" targetRef="notifyApproval"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="humanReview" targetRef="approvalDecisionGateway"></sequenceFlow>
    <sequenceFlow id="flowApproved" name="Approved" sourceRef="approvalDecisionGateway" targetRef="notifyApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowRejected" name="Rejected" sourceRef="approvalDecisionGateway" targetRef="provideRejectionReason">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!approved}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowToNotifyReject" sourceRef="provideRejectionReason" targetRef="notifyRejection"></sequenceFlow>
    <sequenceFlow id="flowToApprovedEnd" sourceRef="notifyApproval" targetRef="endApproved"></sequenceFlow>
    <sequenceFlow id="flowToRejectedEnd" sourceRef="notifyRejection" targetRef="endRejected"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_prompt-approval-v1">
    <bpmndi:BPMNPlane id="BPMNPlane_prompt-approval-v1" bpmnElement="prompt-approval-v1">
      <bpmndi:BPMNShape id="BPMNShape_startEvent" bpmnElement="startEvent">
        <omgdc:Bounds height="35.0" width="35.0" x="50.0" y="250.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_requestApproval" bpmnElement="requestApproval">
        <omgdc:Bounds height="80.0" width="100.0" x="150.0" y="227.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_parallelStart" bpmnElement="parallelStart">
        <omgdc:Bounds height="50.0" width="50.0" x="300.0" y="242.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_safetyCheck" bpmnElement="safetyCheck">
        <omgdc:Bounds height="80.0" width="100.0" x="400.0" y="160.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_complianceCheck" bpmnElement="complianceCheck">
        <omgdc:Bounds height="80.0" width="100.0" x="400.0" y="300.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_parallelMerge" bpmnElement="parallelMerge">
        <omgdc:Bounds height="50.0" width="50.0" x="550.0" y="242.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_autoApproveGateway" bpmnElement="autoApproveGateway">
        <omgdc:Bounds height="50.0" width="50.0" x="650.0" y="242.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_autoApprove" bpmnElement="autoApprove">
        <omgdc:Bounds height="80.0" width="100.0" x="750.0" y="160.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_humanReview" bpmnElement="humanReview">
        <omgdc:Bounds height="80.0" width="100.0" x="750.0" y="300.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approvalDecisionGateway" bpmnElement="approvalDecisionGateway">
        <omgdc:Bounds height="50.0" width="50.0" x="900.0" y="315.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_notifyApproval" bpmnElement="notifyApproval">
        <omgdc:Bounds height="80.0" width="100.0" x="1000.0" y="160.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_provideRejectionReason" bpmnElement="provideRejectionReason">
        <omgdc:Bounds height="80.0" width="100.0" x="1000.0" y="380.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_notifyRejection" bpmnElement="notifyRejection">
        <omgdc:Bounds height="80.0" width="100.0" x="1150.0" y="380.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endApproved" bpmnElement="endApproved">
        <omgdc:Bounds height="35.0" width="35.0" x="1150.0" y="182.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endRejected" bpmnElement="endRejected">
        <omgdc:Bounds height="35.0" width="35.0" x="1300.0" y="402.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="85.0" y="267.5"></omgdi:waypoint>
        <omgdi:waypoint x="150.0" y="267.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="250.0" y="267.5"></omgdi:waypoint>
        <omgdi:waypoint x="300.0" y="267.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowToSafety" bpmnElement="flowToSafety">
        <omgdi:waypoint x="325.0" y="242.5"></omgdi:waypoint>
        <omgdi:waypoint x="400.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowToCompliance" bpmnElement="flowToCompliance">
        <omgdi:waypoint x="325.0" y="292.5"></omgdi:waypoint>
        <omgdi:waypoint x="400.0" y="340.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowFromSafety" bpmnElement="flowFromSafety">
        <omgdi:waypoint x="500.0" y="200.0"></omgdi:waypoint>
        <omgdi:waypoint x="550.0" y="242.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowFromCompliance" bpmnElement="flowFromCompliance">
        <omgdi:waypoint x="500.0" y="340.0"></omgdi:waypoint>
        <omgdi:waypoint x="550.0" y="292.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
        <omgdi:waypoint x="600.0" y="267.5"></omgdi:waypoint>
        <omgdi:waypoint x="650.0" y="267.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowAutoApprove" bpmnElement="flowAutoApprove">
        <omgdi:waypoint x="675.0" y="242.5"></omgdi:waypoint>
        <omgdi:waypoint x="750.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowNeedReview" bpmnElement="flowNeedReview">
        <omgdi:waypoint x="675.0" y="292.5"></omgdi:waypoint>
        <omgdi:waypoint x="750.0" y="340.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowAutoToNotify" bpmnElement="flowAutoToNotify">
        <omgdi:waypoint x="850.0" y="200.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4" bpmnElement="flow4">
        <omgdi:waypoint x="850.0" y="340.0"></omgdi:waypoint>
        <omgdi:waypoint x="900.0" y="340.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowApproved" bpmnElement="flowApproved">
        <omgdi:waypoint x="925.0" y="315.0"></omgdi:waypoint>
        <omgdi:waypoint x="925.0" y="200.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowRejected" bpmnElement="flowRejected">
        <omgdi:waypoint x="925.0" y="365.0"></omgdi:waypoint>
        <omgdi:waypoint x="925.0" y="420.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="420.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowToNotifyReject" bpmnElement="flowToNotifyReject">
        <omgdi:waypoint x="1100.0" y="420.0"></omgdi:waypoint>
        <omgdi:waypoint x="1150.0" y="420.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowToApprovedEnd" bpmnElement="flowToApprovedEnd">
        <omgdi:waypoint x="1100.0" y="200.0"></omgdi:waypoint>
        <omgdi:waypoint x="1150.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowToRejectedEnd" bpmnElement="flowToRejectedEnd">
        <omgdi:waypoint x="1250.0" y="420.0"></omgdi:waypoint>
        <omgdi:waypoint x="1300.0" y="420.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
