      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowTimer" bpmnElement="flowTimer">
        <omgdi:waypoint x="1045" y="370" />
        <omgdi:waypoint x="1040" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowReminder" bpmnElement="flowReminder">
        <omgdi:waypoint x="1100" y="460" />
