        <omgdi:waypoint x="440" y="87" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3b" bpmnElement="flow3b">
        <omgdi:waypoint x="380" y="317" />
        <omgdi:waypoint x="450" y="317" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3c" bpmnElement="flow3c">
        <omgdi:waypoint x="360" y="337" />
        <omgdi:waypoint x="360" y="518" />
        <omgdi:waypoint x="450" y="519" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowPerfError" bpmnElement="flowPerfError">
        <omgdi:waypoint x="560" y="126" />
        <omgdi:waypoint x="652" y="126" />
        <omgdi:waypoint x="652" y="104" />
        <omgdi:waypoint x="759" y="104" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowPerfErrorToJoin" bpmnElement="flowPerfErrorToJoin">
        <omgdi:waypoint x="830" y="146" />
        <omgdi:waypoint x="830" y="210" />
        <omgdi:waypoint x="670" y="220" />
        <omgdi:waypoint x="670" y="297" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4a" bpmnElement="flow4a">
        <omgdi:waypoint x="505" y="125" />
        <omgdi:waypoint x="505" y="220" />
        <omgdi:waypoint x="670" y="220" />
        <omgdi:waypoint x="670" y="297" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4b" bpmnElement="flow4b">
        <omgdi:waypoint x="570" y="317" />
        <omgdi:waypoint x="650" y="317" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4c" bpmnElement="flow4c">
