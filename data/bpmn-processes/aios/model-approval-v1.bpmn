        <omgdi:waypoint x="1490" y="177" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1330" y="221" width="100" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowApprove2" bpmnElement="flowApprove2">
        <omgdi:waypoint x="1621" y="177" />
