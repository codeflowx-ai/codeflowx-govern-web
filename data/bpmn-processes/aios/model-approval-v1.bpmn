        <omgdi:waypoint x="1790" y="320" />
        <omgdi:waypoint x="1830" y="316" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowReject" bpmnElement="flowReject">
        <omgdi:waypoint x="1320" y="337" />
        <omgdi:waypoint x="1320" y="454" />
        <omgdi:waypoint x="1490" y="454" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1330" y="399" width="100" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowReject2" bpmnElement="flowReject2">
        <omgdi:waypoint x="1610" y="454" />
        <omgdi:waypoint x="1660" y="457" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowReject3" bpmnElement="flowReject3">
        <omgdi:waypoint x="1792" y="457" />
        <omgdi:waypoint x="1830" y="453" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
