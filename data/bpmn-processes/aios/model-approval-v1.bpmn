      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_mlReviewTask" bpmnElement="mlReviewTask">
        <omgdc:Bounds x="750" y="280" width="120" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_govReviewTask" bpmnElement="govReviewTask">
        <omgdc:Bounds x="940" y="287" width="120" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_slaReminder" bpmnElement="slaReminder">
        <omgdc:Bounds x="980" y="430" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_droolsScore" bpmnElement="droolsScore">
        <omgdc:Bounds x="1120" y="287" width="131" height="67" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway" bpmnElement="gateway" isMarkerVisible="true">
        <omgdc:Bounds x="1300" y="297" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approveTask" bpmnElement="approveTask">
        <omgdc:Bounds x="1490" y="145" width="131" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_mailApprove" bpmnElement="mailApprove">
        <omgdc:Bounds x="1660" y="148" width="130" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endApproved" bpmnElement="endApproved">
        <omgdc:Bounds x="1830" y="162" width="35" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_conditionalTask" bpmnElement="conditionalTask">
        <omgdc:Bounds x="1489" y="283" width="133" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_mailConditional" bpmnElement="mailConditional">
        <omgdc:Bounds x="1660" y="287" width="130" height="67" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endConditional" bpmnElement="endConditional">
        <omgdc:Bounds x="1830" y="299" width="35" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_rejectTask" bpmnElement="rejectTask">
        <omgdc:Bounds x="1490" y="424" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_mailReject" bpmnElement="mailReject">
        <omgdc:Bounds x="1660" y="424" width="132" height="66" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endRejected" bpmnElement="endRejected">
        <omgdc:Bounds x="1830" y="436" width="35" height="35" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_handlePerfError" bpmnElement="handlePerfError">
        <omgdc:Bounds x="759" y="76" width="141" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_govTimer" bpmnElement="govTimer">
        <omgdc:Bounds x="1030" y="340" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_perfError" bpmnElement="perfError">
        <omgdc:Bounds x="530" y="110" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="85" y="316" />
        <omgdi:waypoint x="150" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="281" y="320" />
        <omgdi:waypoint x="340" y="317" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3a" bpmnElement="flow3a">
        <omgdi:waypoint x="360" y="297" />
