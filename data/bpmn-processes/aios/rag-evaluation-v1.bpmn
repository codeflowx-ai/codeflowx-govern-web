<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://codeflowx.com/govern/rag-evaluation">
  <process id="rag-evaluation-v1" name="RAG Evaluation Process V1" isExecutable="true" version="1.0">
    <startEvent id="startEvent" name="Start RAG Evaluation">
      <outgoing>flow1</outgoing>
    </startEvent>
    <parallelGateway id="parallelStart" name="Parallel Start">
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
      <outgoing>flow3</outgoing>
    </parallelGateway>
    <serviceTask id="executeEvaluation" name="Execute RAG Evaluation" flowable:class="com.codeflowx.govern.workflow.delegates.RagEvaluationDelegate">
      <incoming>flow2</incoming>
      <outgoing>flow4</outgoing>
    </serviceTask>
    <serviceTask id="prepareContext" name="Prepare Context Data" flowable:class="com.codeflowx.govern.workflow.delegates.PrepareContextDataDelegate">
      <incoming>flow3</incoming>
      <outgoing>flow5</outgoing>
    </serviceTask>
    <parallelGateway id="parallelMerge" name="Parallel Merge">
      <incoming>flow4</incoming>
      <incoming>flow5</incoming>
      <outgoing>flow6</outgoing>
    </parallelGateway>
    <businessRuleTask id="calculateRagScore" name="Calculate RAG Score" flowable:ruleVariablesInput="${ragEvaluationFact}" flowable:resultVariable="ragEvaluationResult">
      <incoming>flow6</incoming>
      <outgoing>flow7</outgoing>
    </businessRuleTask>
    <exclusiveGateway id="qualityGateway" name="Quality Assessment">
      <incoming>flow7</incoming>
      <outgoing>flow8</outgoing>
      <outgoing>flow9</outgoing>
      <outgoing>flow10</outgoing>
    </exclusiveGateway>
    <serviceTask id="storeResults" name="Store Evaluation Results" flowable:class="com.codeflowx.govern.workflow.delegates.StoreRagEvaluationDelegate">
      <incoming>flow8</incoming>
      <outgoing>flow11</outgoing>
    </serviceTask>
    <serviceTask id="createAlert" name="Create RAG Alert" flowable:class="com.codeflowx.govern.workflow.delegates.CreateRagAlertDelegate">
      <incoming>flow9</incoming>
      <outgoing>flow12</outgoing>
    </serviceTask>
    <userTask id="manualReview" name="Manual Review Required" flowable:assignee="${reviewerId}" flowable:formKey="rag-review-form">
      <incoming>flow10</incoming>
      <outgoing>flow13</outgoing>
    </userTask>
    <serviceTask id="updateDashboard" name="Update Dashboard" flowable:class="com.codeflowx.govern.workflow.delegates.UpdateComplianceDashboardDelegate">
      <incoming>flow11</incoming>
      <incoming>flow12</incoming>
      <incoming>flow13</incoming>
      <outgoing>flow14</outgoing>
    </serviceTask>
    <endEvent id="endSuccess" name="Evaluation Complete">
      <incoming>flow14</incoming>
    </endEvent>
    <boundaryEvent id="timeoutEvent" name="Evaluation Timeout" attachedToRef="calculateRagScore">
      <timerEventDefinition>
        <timeDuration>PT30M</timeDuration>
      </timerEventDefinition>
      <outgoing>flow15</outgoing>
    </boundaryEvent>
    <serviceTask id="handleTimeout" name="Handle Timeout" flowable:class="com.codeflowx.govern.workflow.delegates.HandleEvaluationTimeoutDelegate">
      <incoming>flow15</incoming>
      <outgoing>flow16</outgoing>
    </serviceTask>
    <endEvent id="endTimeout" name="Timeout End">
      <incoming>flow16</incoming>
    </endEvent>
    <boundaryEvent id="errorEvent" name="Evaluation Error" attachedToRef="calculateRagScore">
      <errorEventDefinition errorRef="ragEvaluationError"></errorEventDefinition>
      <outgoing>flow17</outgoing>
    </boundaryEvent>
    <serviceTask id="handleError" name="Handle Error" flowable:class="com.codeflowx.govern.workflow.delegates.HandleRagEvaluationErrorDelegate">
      <incoming>flow17</incoming>
      <outgoing>flow18</outgoing>
    </serviceTask>
    <endEvent id="endError" name="Error End">
      <incoming>flow18</incoming>
    </endEvent>
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="parallelStart"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="parallelStart" targetRef="executeEvaluation"></sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="parallelStart" targetRef="prepareContext"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="executeEvaluation" targetRef="parallelMerge"></sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="prepareContext" targetRef="parallelMerge"></sequenceFlow>
    <sequenceFlow id="flow6" sourceRef="parallelMerge" targetRef="calculateRagScore"></sequenceFlow>
    <sequenceFlow id="flow7" sourceRef="calculateRagScore" targetRef="qualityGateway"></sequenceFlow>
    <sequenceFlow id="flow8" name="Excellent/Good" sourceRef="qualityGateway" targetRef="storeResults">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${ragEvaluationResult.riskLevel == "LOW"}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow9" name="Poor/Critical" sourceRef="qualityGateway" targetRef="createAlert">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${ragEvaluationResult.riskLevel == "HIGH" || ragEvaluationResult.riskLevel == "CRITICAL"}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow10" name="Moderate" sourceRef="qualityGateway" targetRef="manualReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${ragEvaluationResult.riskLevel == "MEDIUM"}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow11" sourceRef="storeResults" targetRef="updateDashboard"></sequenceFlow>
    <sequenceFlow id="flow12" sourceRef="createAlert" targetRef="updateDashboard"></sequenceFlow>
    <sequenceFlow id="flow13" sourceRef="manualReview" targetRef="updateDashboard"></sequenceFlow>
    <sequenceFlow id="flow14" sourceRef="updateDashboard" targetRef="endSuccess"></sequenceFlow>
    <sequenceFlow id="flow15" sourceRef="timeoutEvent" targetRef="handleTimeout"></sequenceFlow>
    <sequenceFlow id="flow16" sourceRef="handleTimeout" targetRef="endTimeout"></sequenceFlow>
    <sequenceFlow id="flow17" sourceRef="errorEvent" targetRef="handleError"></sequenceFlow>
    <sequenceFlow id="flow18" sourceRef="handleError" targetRef="endError"></sequenceFlow>
    <error id="ragEvaluationError" name="RagEvaluationError" errorCode="RAG_EVAL_ERROR"></error>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_rag-evaluation-v1">
    <bpmndi:BPMNPlane id="BPMNPlane_rag-evaluation-v1" bpmnElement="rag-evaluation-v1">
      <bpmndi:BPMNShape id="BPMNShape_startEvent" bpmnElement="startEvent">
        <omgdc:Bounds height="35.0" width="35.0" x="100.0" y="200.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_parallelStart" bpmnElement="parallelStart">
        <omgdc:Bounds height="50.0" width="50.0" x="200.0" y="187.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_executeEvaluation" bpmnElement="executeEvaluation">
        <omgdc:Bounds height="80.0" width="100.0" x="300.0" y="100.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_prepareContext" bpmnElement="prepareContext">
        <omgdc:Bounds height="80.0" width="100.0" x="300.0" y="250.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_parallelMerge" bpmnElement="parallelMerge">
        <omgdc:Bounds height="50.0" width="50.0" x="500.0" y="187.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_calculateRagScore" bpmnElement="calculateRagScore">
        <omgdc:Bounds height="80.0" width="100.0" x="650.0" y="187.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_qualityGateway" bpmnElement="qualityGateway">
        <omgdc:Bounds height="50.0" width="50.0" x="850.0" y="187.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_storeResults" bpmnElement="storeResults">
        <omgdc:Bounds height="80.0" width="100.0" x="1000.0" y="50.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_createAlert" bpmnElement="createAlert">
        <omgdc:Bounds height="80.0" width="100.0" x="1000.0" y="200.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_manualReview" bpmnElement="manualReview">
        <omgdc:Bounds height="80.0" width="100.0" x="1000.0" y="350.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateDashboard" bpmnElement="updateDashboard">
        <omgdc:Bounds height="80.0" width="100.0" x="1200.0" y="200.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endSuccess" bpmnElement="endSuccess">
        <omgdc:Bounds height="35.0" width="35.0" x="1400.0" y="212.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_timeoutEvent" bpmnElement="timeoutEvent">
        <omgdc:Bounds height="30.0" width="30.0" x="700.0" y="150.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_handleTimeout" bpmnElement="handleTimeout">
        <omgdc:Bounds height="80.0" width="100.0" x="800.0" y="50.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endTimeout" bpmnElement="endTimeout">
        <omgdc:Bounds height="35.0" width="35.0" x="1000.0" y="67.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_errorEvent" bpmnElement="errorEvent">
        <omgdc:Bounds height="30.0" width="30.0" x="700.0" y="250.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_handleError" bpmnElement="handleError">
        <omgdc:Bounds height="80.0" width="100.0" x="800.0" y="350.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endError" bpmnElement="endError">
        <omgdc:Bounds height="35.0" width="35.0" x="1000.0" y="367.5"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="135.0" y="217.5"></omgdi:waypoint>
        <omgdi:waypoint x="200.0" y="212.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="225.0" y="200.0"></omgdi:waypoint>
        <omgdi:waypoint x="300.0" y="140.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow3" bpmnElement="flow3">
        <omgdi:waypoint x="225.0" y="225.0"></omgdi:waypoint>
        <omgdi:waypoint x="300.0" y="290.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow4" bpmnElement="flow4">
        <omgdi:waypoint x="400.0" y="140.0"></omgdi:waypoint>
        <omgdi:waypoint x="500.0" y="200.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow5" bpmnElement="flow5">
        <omgdi:waypoint x="400.0" y="290.0"></omgdi:waypoint>
        <omgdi:waypoint x="500.0" y="225.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow6" bpmnElement="flow6">
        <omgdi:waypoint x="550.0" y="212.5"></omgdi:waypoint>
        <omgdi:waypoint x="650.0" y="227.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow7" bpmnElement="flow7">
        <omgdi:waypoint x="750.0" y="227.5"></omgdi:waypoint>
        <omgdi:waypoint x="850.0" y="212.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow8" bpmnElement="flow8">
        <omgdi:waypoint x="875.0" y="187.5"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="90.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="68.0" x="881.0" y="173.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow9" bpmnElement="flow9">
        <omgdi:waypoint x="875.0" y="212.5"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="240.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="60.0" x="1429.0" y="272.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow10" bpmnElement="flow10">
        <omgdi:waypoint x="875.0" y="237.5"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="390.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="73.0" x="1380.0" y="385.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow11" bpmnElement="flow11">
        <omgdi:waypoint x="1100.0" y="90.0"></omgdi:waypoint>
        <omgdi:waypoint x="1200.0" y="160.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow12" bpmnElement="flow12">
        <omgdi:waypoint x="1100.0" y="240.0"></omgdi:waypoint>
        <omgdi:waypoint x="1200.0" y="240.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow13" bpmnElement="flow13">
        <omgdi:waypoint x="1100.0" y="390.0"></omgdi:waypoint>
        <omgdi:waypoint x="1200.0" y="320.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow14" bpmnElement="flow14">
        <omgdi:waypoint x="1300.0" y="240.0"></omgdi:waypoint>
        <omgdi:waypoint x="1400.0" y="230.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow15" bpmnElement="flow15">
        <omgdi:waypoint x="715.0" y="165.0"></omgdi:waypoint>
        <omgdi:waypoint x="800.0" y="90.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow16" bpmnElement="flow16">
        <omgdi:waypoint x="900.0" y="90.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="85.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow17" bpmnElement="flow17">
        <omgdi:waypoint x="715.0" y="265.0"></omgdi:waypoint>
        <omgdi:waypoint x="800.0" y="390.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow18" bpmnElement="flow18">
        <omgdi:waypoint x="900.0" y="390.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="385.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
