        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="32.0" width="88.0" x="1030.0" y="250.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow21" bpmnElement="flow21">
        <omgdi:waypoint x="1100.0" y="90.0"></omgdi:waypoint>
        <omgdi:waypoint x="800.0" y="227.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow22" bpmnElement="flow22">
        <omgdi:waypoint x="1100.0" y="190.0"></omgdi:waypoint>
        <omgdi:waypoint x="800.0" y="227.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow23" bpmnElement="flow23">
        <omgdi:waypoint x="1150.0" y="350.0"></omgdi:waypoint>
        <omgdi:waypoint x="1000.0" y="307.5"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
