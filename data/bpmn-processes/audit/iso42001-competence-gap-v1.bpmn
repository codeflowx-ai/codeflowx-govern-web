<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://codeflowx.com/govern/iso42001/competence-gap"
             expressionLanguage="http://www.w3.org/1999/XPath"
             typeLanguage="http://www.w3.org/2001/XMLSchema">

  <process id="iso42001CompetenceGapV1"
           name="ISO 42001 Competence Gap Closure"
           isExecutable="true"
           versionTag="1.0">

    <startEvent id="gapIdentifiedStart" name="Gap de competencias detectado">
      <outgoing>flowAssessGap</outgoing>
    </startEvent>

    <userTask id="assessCompetenceGapTask"
              name="Evaluar gap de competencias"
              flowable:formKey="console/bpmn/competence-gap-assessment-form.zul"
              flowable:candidateGroups="hr-managers,compliance-officers">
      <incoming>flowAssessGap</incoming>
      <outgoing>flowPlanTraining</outgoing>
    </userTask>

    <serviceTask id="generateTrainingPlanTask"
                 name="Generar plan de capacitación"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.GenerateCompetenceTrainingPlanDelegate">
      <incoming>flowPlanTraining</incoming>
      <outgoing>flowTrainingApproval</outgoing>
    </serviceTask>

    <userTask id="approveTrainingPlanTask"
              name="Aprobar plan de capacitación"
              flowable:formKey="console/bpmn/competence-gap-approval-form.zul"
              flowable:candidateGroups="top-management,hr-directors">
      <incoming>flowTrainingApproval</incoming>
      <outgoing>flowExecutePlanGateway</outgoing>
    </userTask>

    <exclusiveGateway id="approvalGateway" name="¿Plan aprobado?">
      <incoming>flowExecutePlanGateway</incoming>
      <outgoing>flowReworkPlan</outgoing>
      <outgoing>flowExecutePlan</outgoing>
    </exclusiveGateway>

    <userTask id="reworkTrainingPlanTask"
              name="Ajustar plan de capacitación"
              flowable:formKey="console/bpmn/competence-gap-rework-form.zul"
              flowable:candidateGroups="hr-managers,compliance-officers">
      <incoming>flowReworkPlan</incoming>
      <outgoing>flowPlanTraining</outgoing>
    </userTask>

    <userTask id="executeTrainingPlanTask"
              name="Ejecutar plan de capacitación"
              flowable:formKey="console/bpmn/competence-gap-implementation-form.zul"
              flowable:candidateGroups="training-coordinators">
      <incoming>flowExecutePlan</incoming>
      <outgoing>flowVerifyEffectiveness</outgoing>
    </userTask>

    <serviceTask id="evaluateTrainingEffectivenessTask"
                 name="Evaluar efectividad"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.EvaluateCompetenceTrainingEffectivenessDelegate">
      <incoming>flowVerifyEffectiveness</incoming>
      <outgoing>flowEffectivenessGateway</outgoing>
    </serviceTask>

    <exclusiveGateway id="effectivenessGateway" name="¿Efectivo?">
      <incoming>flowEffectivenessGateway</incoming>
      <outgoing>flowNeedAdditionalActions</outgoing>
      <outgoing>flowCloseGap</outgoing>
    </exclusiveGateway>

    <userTask id="defineAdditionalActionsTask"
              name="Definir acciones adicionales"
              flowable:formKey="console/bpmn/competence-gap-additional-actions-form.zul"
              flowable:candidateGroups="hr-managers,training-coordinators">
      <incoming>flowNeedAdditionalActions</incoming>
      <outgoing>flowExecutePlan</outgoing>
    </userTask>

    <serviceTask id="closeCompetenceGapTask"
                 name="Cerrar gap de competencias"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.CloseCompetenceGapDelegate">
      <incoming>flowCloseGap</incoming>
      <outgoing>flowEndCompetenceGap</outgoing>
    </serviceTask>

    <endEvent id="competenceGapClosed" name="Gap cerrado">
      <incoming>flowEndCompetenceGap</incoming>
    </endEvent>

    <sequenceFlow id="flowAssessGap"
                  sourceRef="gapIdentifiedStart"
                  targetRef="assessCompetenceGapTask"/>
    <sequenceFlow id="flowPlanTraining"
                  sourceRef="assessCompetenceGapTask"
                  targetRef="generateTrainingPlanTask"/>
    <sequenceFlow id="flowTrainingApproval"
                  sourceRef="generateTrainingPlanTask"
                  targetRef="approveTrainingPlanTask"/>
    <sequenceFlow id="flowExecutePlanGateway"
                  sourceRef="approveTrainingPlanTask"
                  targetRef="approvalGateway"/>
    <sequenceFlow id="flowReworkPlan"
                  sourceRef="approvalGateway"
                  targetRef="reworkTrainingPlanTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${trainingPlanApproved == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowExecutePlan"
                  sourceRef="approvalGateway"
                  targetRef="executeTrainingPlanTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${trainingPlanApproved == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowVerifyEffectiveness"
                  sourceRef="executeTrainingPlanTask"
                  targetRef="evaluateTrainingEffectivenessTask"/>
    <sequenceFlow id="flowEffectivenessGateway"
                  sourceRef="evaluateTrainingEffectivenessTask"
                  targetRef="effectivenessGateway"/>
    <sequenceFlow id="flowNeedAdditionalActions"
                  sourceRef="effectivenessGateway"
                  targetRef="defineAdditionalActionsTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${trainingEffective == false}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowCloseGap"
                  sourceRef="effectivenessGateway"
                  targetRef="closeCompetenceGapTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${trainingEffective == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowEndCompetenceGap"
                  sourceRef="closeCompetenceGapTask"
                  targetRef="competenceGapClosed"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_iso42001CompetenceGap">
    <bpmndi:BPMNPlane id="BPMNPlane_iso42001CompetenceGap" bpmnElement="iso42001CompetenceGapV1">
      <bpmndi:BPMNShape id="BPMNShape_gapIdentifiedStart" bpmnElement="gapIdentifiedStart">
        <omgdc:Bounds x="182" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_assessCompetenceGapTask" bpmnElement="assessCompetenceGapTask">
        <omgdc:Bounds x="150" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_generateTrainingPlanTask" bpmnElement="generateTrainingPlanTask">
        <omgdc:Bounds x="150" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approveTrainingPlanTask" bpmnElement="approveTrainingPlanTask">
        <omgdc:Bounds x="150" y="600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approvalGateway" bpmnElement="approvalGateway">
        <omgdc:Bounds x="175" y="795" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reworkTrainingPlanTask" bpmnElement="reworkTrainingPlanTask">
        <omgdc:Bounds x="150" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_executeTrainingPlanTask" bpmnElement="executeTrainingPlanTask">
        <omgdc:Bounds x="350" y="960" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_evaluateTrainingEffectivenessTask" bpmnElement="evaluateTrainingEffectivenessTask">
        <omgdc:Bounds x="150" y="1140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_effectivenessGateway" bpmnElement="effectivenessGateway">
        <omgdc:Bounds x="175" y="1335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_defineAdditionalActionsTask" bpmnElement="defineAdditionalActionsTask">
        <omgdc:Bounds x="150" y="1500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_closeCompetenceGapTask" bpmnElement="closeCompetenceGapTask">
        <omgdc:Bounds x="350" y="1500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_competenceGapClosed" bpmnElement="competenceGapClosed">
        <omgdc:Bounds x="182" y="1702" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flowAssessGap" bpmnElement="flowAssessGap">
        <omgdi:waypoint x="218" y="118" />
        <omgdi:waypoint x="150" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowPlanTraining" bpmnElement="flowPlanTraining">
        <omgdi:waypoint x="250" y="280" />
        <omgdi:waypoint x="150" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowTrainingApproval" bpmnElement="flowTrainingApproval">
        <omgdi:waypoint x="250" y="460" />
        <omgdi:waypoint x="150" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowExecutePlanGateway" bpmnElement="flowExecutePlanGateway">
        <omgdi:waypoint x="250" y="640" />
        <omgdi:waypoint x="175" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowReworkPlan" bpmnElement="flowReworkPlan">
        <omgdi:waypoint x="225" y="820" />
        <omgdi:waypoint x="150" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowExecutePlan" bpmnElement="flowExecutePlan">
        <omgdi:waypoint x="225" y="820" />
        <omgdi:waypoint x="350" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowVerifyEffectiveness" bpmnElement="flowVerifyEffectiveness">
        <omgdi:waypoint x="450" y="1000" />
        <omgdi:waypoint x="150" y="1180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowEffectivenessGateway" bpmnElement="flowEffectivenessGateway">
        <omgdi:waypoint x="250" y="1180" />
        <omgdi:waypoint x="175" y="1360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowNeedAdditionalActions" bpmnElement="flowNeedAdditionalActions">
        <omgdi:waypoint x="225" y="1360" />
        <omgdi:waypoint x="150" y="1540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowCloseGap" bpmnElement="flowCloseGap">
        <omgdi:waypoint x="225" y="1360" />
        <omgdi:waypoint x="350" y="1540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowEndCompetenceGap" bpmnElement="flowEndCompetenceGap">
        <omgdi:waypoint x="450" y="1540" />
        <omgdi:waypoint x="182" y="1720" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>


