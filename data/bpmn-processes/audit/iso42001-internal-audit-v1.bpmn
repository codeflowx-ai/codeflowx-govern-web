<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://codeflowx.com/govern/iso42001/internal-audit"
             expressionLanguage="http://www.w3.org/1999/XPath"
             typeLanguage="http://www.w3.org/2001/XMLSchema">

  <process id="iso42001InternalAuditV1"
           name="ISO 42001 Internal Audit"
           isExecutable="true"
           versionTag="1.0">

    <startEvent id="internalAuditTimer" name="Anual">
      <timerEventDefinition>
        <timeCycle>R/P1Y</timeCycle>
      </timerEventDefinition>
      <outgoing>flowGenerateChecklist</outgoing>
    </startEvent>

    <serviceTask id="generateAuditChecklist"
                 name="Generar checklist auditoría"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.GenerateInternalAuditChecklistDelegate">
      <incoming>flowGenerateChecklist</incoming>
      <outgoing>flowScheduleAudit</outgoing>
    </serviceTask>

    <userTask id="scheduleAuditTask"
              name="Programar auditoría"
              flowable:formKey="console/bpmn/internal-audit-scheduling-form.zul"
              flowable:candidateGroups="compliance-coordinators,audit-leads">
      <incoming>flowScheduleAudit</incoming>
      <outgoing>flowExecuteAudit</outgoing>
    </userTask>

    <userTask id="conductAuditTask"
              name="Realizar auditoría"
              flowable:formKey="console/bpmn/internal-audit-execution-form.zul"
              flowable:candidateGroups="auditors,compliance-officers">
      <incoming>flowExecuteAudit</incoming>
      <outgoing>flowCalculateCompliance</outgoing>
    </userTask>

    <serviceTask id="calculateComplianceScore"
                 name="Calcular score cumplimiento"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.CalculateInternalAuditComplianceScoreDelegate">
      <incoming>flowCalculateCompliance</incoming>
      <outgoing>flowNonConformityGateway</outgoing>
    </serviceTask>

    <exclusiveGateway id="nonConformityGateway" name="¿No conformidades?">
      <incoming>flowNonConformityGateway</incoming>
      <outgoing>flowCreateNonConformities</outgoing>
      <outgoing>flowSkipNonConformities</outgoing>
    </exclusiveGateway>

    <serviceTask id="createNonConformities"
                 name="Crear no conformidades"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.CreateInternalAuditNonConformitiesDelegate">
      <incoming>flowCreateNonConformities</incoming>
      <outgoing>flowRecordResults</outgoing>
    </serviceTask>

    <serviceTask id="recordAuditResults"
                 name="Registrar resultados auditoría"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.RecordInternalAuditResultsDelegate">
      <incoming>flowSkipNonConformities</incoming>
      <incoming>flowRecordResults</incoming>
      <outgoing>flowEndInternalAudit</outgoing>
    </serviceTask>

    <endEvent id="endInternalAudit" name="Auditoría completada">
      <incoming>flowEndInternalAudit</incoming>
    </endEvent>

    <sequenceFlow id="flowGenerateChecklist"
                  sourceRef="internalAuditTimer"
                  targetRef="generateAuditChecklist"/>
    <sequenceFlow id="flowScheduleAudit"
                  sourceRef="generateAuditChecklist"
                  targetRef="scheduleAuditTask"/>
    <sequenceFlow id="flowExecuteAudit"
                  sourceRef="scheduleAuditTask"
                  targetRef="conductAuditTask"/>
    <sequenceFlow id="flowCalculateCompliance"
                  sourceRef="conductAuditTask"
                  targetRef="calculateComplianceScore"/>
    <sequenceFlow id="flowNonConformityGateway"
                  sourceRef="calculateComplianceScore"
                  targetRef="nonConformityGateway"/>
    <sequenceFlow id="flowCreateNonConformities"
                  sourceRef="nonConformityGateway"
                  targetRef="createNonConformities">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${auditHasNonConformities}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowSkipNonConformities"
                  sourceRef="nonConformityGateway"
                  targetRef="recordAuditResults">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!auditHasNonConformities}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowRecordResults"
                  sourceRef="createNonConformities"
                  targetRef="recordAuditResults"/>
    <sequenceFlow id="flowEndInternalAudit"
                  sourceRef="recordAuditResults"
                  targetRef="endInternalAudit"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_iso42001InternalAudit">
    <bpmndi:BPMNPlane id="BPMNPlane_iso42001InternalAudit" bpmnElement="iso42001InternalAuditV1">
      <bpmndi:BPMNShape id="BPMNShape_internalAuditTimer" bpmnElement="internalAuditTimer">
        <omgdc:Bounds x="182" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_generateAuditChecklist" bpmnElement="generateAuditChecklist">
        <omgdc:Bounds x="150" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_scheduleAuditTask" bpmnElement="scheduleAuditTask">
        <omgdc:Bounds x="150" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_conductAuditTask" bpmnElement="conductAuditTask">
        <omgdc:Bounds x="150" y="600" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_calculateComplianceScore" bpmnElement="calculateComplianceScore">
        <omgdc:Bounds x="150" y="780" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_nonConformityGateway" bpmnElement="nonConformityGateway">
        <omgdc:Bounds x="175" y="975" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_createNonConformities" bpmnElement="createNonConformities">
        <omgdc:Bounds x="150" y="1140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_recordAuditResults" bpmnElement="recordAuditResults">
        <omgdc:Bounds x="350" y="1140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endInternalAudit" bpmnElement="endInternalAudit">
        <omgdc:Bounds x="182" y="1342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flowGenerateChecklist" bpmnElement="flowGenerateChecklist">
        <omgdi:waypoint x="218" y="118" />
        <omgdi:waypoint x="150" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowScheduleAudit" bpmnElement="flowScheduleAudit">
        <omgdi:waypoint x="250" y="280" />
        <omgdi:waypoint x="150" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowExecuteAudit" bpmnElement="flowExecuteAudit">
        <omgdi:waypoint x="250" y="460" />
        <omgdi:waypoint x="150" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowCalculateCompliance" bpmnElement="flowCalculateCompliance">
        <omgdi:waypoint x="250" y="640" />
        <omgdi:waypoint x="150" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowNonConformityGateway" bpmnElement="flowNonConformityGateway">
        <omgdi:waypoint x="250" y="820" />
        <omgdi:waypoint x="175" y="1000" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowCreateNonConformities" bpmnElement="flowCreateNonConformities">
        <omgdi:waypoint x="225" y="1000" />
        <omgdi:waypoint x="150" y="1180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowSkipNonConformities" bpmnElement="flowSkipNonConformities">
        <omgdi:waypoint x="225" y="1000" />
        <omgdi:waypoint x="350" y="1180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowRecordResults" bpmnElement="flowRecordResults">
        <omgdi:waypoint x="250" y="1180" />
        <omgdi:waypoint x="350" y="1180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowEndInternalAudit" bpmnElement="flowEndInternalAudit">
        <omgdi:waypoint x="450" y="1180" />
        <omgdi:waypoint x="182" y="1360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>


