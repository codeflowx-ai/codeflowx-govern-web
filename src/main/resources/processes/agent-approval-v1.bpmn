        <omgdi:waypoint x="1300.0" y="347.0"></omgdi:waypoint>
        <omgdi:waypoint x="1400.0" y="347.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="100.0" x="1310.0" y="327.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowReject" id="BPMNEdge_flowReject">
        <omgdi:waypoint x="830.0" y="313.0"></omgdi:waypoint>
        <omgdi:waypoint x="830.0" y="504.0"></omgdi:waypoint>
        <omgdi:waypoint x="930.0" y="504.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="48.0" width="100.0" x="730.0" y="383.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowReject2" id="BPMNEdge_flowReject2">
        <omgdi:waypoint x="1050.0" y="504.0"></omgdi:waypoint>
        <omgdi:waypoint x="1280.0" y="504.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowReject3" id="BPMNEdge_flowReject3">
        <omgdi:waypoint x="1400.0" y="504.0"></omgdi:waypoint>
        <omgdi:waypoint x="1460.0" y="503.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>