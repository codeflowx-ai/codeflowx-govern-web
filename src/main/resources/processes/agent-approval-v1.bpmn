<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://www.activiti.org/test">
  <process id="agent-approval-v1" name="Agent Approval V1" isExecutable="true" activiti:candidateStarterGroups="ml-engineers,governance-admins">
    <documentation>Proceso de aprobación de Agent IA - VERSIÓN COMPLETA

ELEMENTOS: ParallelGateway, BusinessRuleTask, Error Boundary, Timer Boundary, MailTask
PROPORCIÓN: 80% Automatizado - 20% HITL</documentation>
    <startEvent id="start" name="Inicio"></startEvent>
    <parallelGateway id="fork" name="Fork"></parallelGateway>
    <serviceTask id="riskTask" name="AI Risk Assessment" activiti:class="com.codeflowx.govern.workflow.delegates.AIRiskAssessmentDelegate">
      <documentation>Evalúa riesgos usando LLM. Output: riskScore (0-100)</documentation>
    </serviceTask>
    <boundaryEvent id="riskError" name="Error" attachedToRef="riskTask">
      <errorEventDefinition></errorEventDefinition>
    </boundaryEvent>
    <scriptTask id="handleRiskError" name="Score Conservador" scriptFormat="javascript" activiti:autoStoreVariables="false">
      <script><![CDATA[execution.setVariable('riskScore', 75);]]></script>
    </scriptTask>
    <serviceTask id="complianceTask" name="AI Compliance Check" activiti:class="com.codeflowx.govern.workflow.delegates.AIComplianceCheckDelegate">
      <documentation>Verifica compliance. Output: complianceScore (0-100), compliant (bool)</documentation>
    </serviceTask>
    <serviceTask id="ethicsTask" name="AI Ethical Review" activiti:class="com.codeflowx.govern.workflow.delegates.AIEthicalReviewDelegate">
      <documentation>Evalúa ética. Output: ethicsScore (0-100)</documentation>
    </serviceTask>
    <parallelGateway id="join" name="Join"></parallelGateway>
    <businessRuleTask id="droolsScore" name="Calculate Score (Drools)" activiti:ruleVariablesInput="${agentApprovalFact}" activiti:rules="agent-scoring" activiti:resultVariable="decision">
      <documentation>Ejecuta reglas Drools.
Input: AgentApprovalFact
Output: decision, minScore, confidenceLevel, justification
DRL: agent-scoring.drl (9 reglas)</documentation>
    </businessRuleTask>
    <exclusiveGateway id="gateway" name="Decisión"></exclusiveGateway>
    <serviceTask id="approveTask" name="Auto Aprobar" activiti:class="com.codeflowx.govern.workflow.delegates.AutoApproveAgentDelegate">
      <documentation>Marca Agent como aprobado.</documentation>
    </serviceTask>
    <serviceTask id="mailApprove" name="Email: Aprobado" activiti:type="mail">
      <extensionElements>
        <activiti:field name="to">
          <activiti:expression><![CDATA[${approverEmail}]]></activiti:expression>
        </activiti:field>
        <activiti:field name="from">
          <activiti:string><![CDATA[governance@company.com]]></activiti:string>
        </activiti:field>
        <activiti:field name="subject">
          <activiti:expression><![CDATA[Agent Aprobado: ${agentName}]]></activiti:expression>
        </activiti:field>
        <activiti:field name="html">
          <activiti:expression><![CDATA[Agent aprobado: ${agentName}, Score: ${minScore}]]></activiti:expression>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="endApproved" name="Aprobado"></endEvent>
    <userTask id="hitlTask" name="Human Review" activiti:candidateGroups="governance-admins" activiti:dueDate="PT4H" activiti:formKey="bpmn/agent-approval-human-override-form.zul" activiti:priority="80">
      <documentation>Revisión humana requerida.</documentation>
    </userTask>
    <boundaryEvent id="hitlTimer" name="SLA 24h" attachedToRef="hitlTask" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P1D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="hitlReminder" name="Recordatorio" activiti:candidateGroups="governance-leads" activiti:formKey="bpmn/hitl-sla-reminder-form.zul" activiti:priority="95">
      <documentation>Recordatorio SLA excedido.</documentation>
    </userTask>
    <exclusiveGateway id="hitlGateway" name="Decisión Humana"></exclusiveGateway>
    <endEvent id="endHitlApproved" name="HITL Aprobado"></endEvent>
    <endEvent id="endHitlRejected" name="HITL Rechazado"></endEvent>
    <serviceTask id="rejectTask" name="Auto Rechazar" activiti:class="com.codeflowx.govern.workflow.delegates.AutoRejectAgentDelegate">
      <documentation>Marca Agent como rechazado.</documentation>
    </serviceTask>
    <serviceTask id="mailReject" name="Email: Rechazado" activiti:type="mail">
      <extensionElements>
        <activiti:field name="to">
          <activiti:expression><![CDATA[${approverEmail}]]></activiti:expression>
        </activiti:field>
        <activiti:field name="from">
          <activiti:string><![CDATA[governance@company.com]]></activiti:string>
        </activiti:field>
        <activiti:field name="subject">
          <activiti:expression><![CDATA[Agent Rechazado: ${agentName}]]></activiti:expression>
        </activiti:field>
        <activiti:field name="html">
          <activiti:expression><![CDATA[Agent rechazado: ${agentName}, Razón: ${justification}]]></activiti:expression>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="endRejected" name="Rechazado"></endEvent>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="fork"></sequenceFlow>
    <sequenceFlow id="flow2a" sourceRef="fork" targetRef="riskTask"></sequenceFlow>
    <sequenceFlow id="flow2b" sourceRef="fork" targetRef="complianceTask"></sequenceFlow>
    <sequenceFlow id="flow2c" sourceRef="fork" targetRef="ethicsTask"></sequenceFlow>
    <sequenceFlow id="flowRiskError" sourceRef="riskError" targetRef="handleRiskError"></sequenceFlow>
    <sequenceFlow id="flowRiskErrorToJoin" sourceRef="handleRiskError" targetRef="join"></sequenceFlow>
    <sequenceFlow id="flow3a" sourceRef="riskTask" targetRef="join"></sequenceFlow>
    <sequenceFlow id="flow3b" sourceRef="complianceTask" targetRef="join"></sequenceFlow>
    <sequenceFlow id="flow3c" sourceRef="ethicsTask" targetRef="join"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="join" targetRef="droolsScore"></sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="droolsScore" targetRef="gateway"></sequenceFlow>
    <sequenceFlow id="flowApprove" name="AUTO_APPROVE" sourceRef="gateway" targetRef="approveTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'AUTO_APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowApprove2" sourceRef="approveTask" targetRef="mailApprove"></sequenceFlow>
    <sequenceFlow id="flowApprove3" sourceRef="mailApprove" targetRef="endApproved"></sequenceFlow>
    <sequenceFlow id="flowHitl" name="HITL_REQUIRED" sourceRef="gateway" targetRef="hitlTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'HITL_REQUIRED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowHitl2" sourceRef="hitlTask" targetRef="hitlGateway"></sequenceFlow>
    <sequenceFlow id="flowTimer" sourceRef="hitlTimer" targetRef="hitlReminder"></sequenceFlow>
    <sequenceFlow id="flowReminder" sourceRef="hitlReminder" targetRef="hitlGateway"></sequenceFlow>
    <sequenceFlow id="flowHitlApp" name="approve" sourceRef="hitlGateway" targetRef="endHitlApproved">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${human_decision == 'approve'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowHitlRej" name="reject" sourceRef="hitlGateway" targetRef="endHitlRejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${human_decision == 'reject'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowReject" name="AUTO_REJECT" sourceRef="gateway" targetRef="rejectTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'AUTO_REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowReject2" sourceRef="rejectTask" targetRef="mailReject"></sequenceFlow>
    <sequenceFlow id="flowReject3" sourceRef="mailReject" targetRef="endRejected"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_agent-approval-v1">
    <bpmndi:BPMNPlane bpmnElement="agent-approval-v1" id="BPMNPlane_agent-approval-v1">
      <bpmndi:BPMNShape bpmnElement="start" id="BPMNShape_start">
        <omgdc:Bounds height="35.0" width="35.0" x="60.0" y="297.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="fork" id="BPMNShape_fork">
        <omgdc:Bounds height="40.0" width="40.0" x="170.0" y="294.0"></omgdc:Bounds>
