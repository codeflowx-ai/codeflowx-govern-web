package com.codeflowx.govern.workflow.drools.rules;

import com.codeflowx.govern.workflow.drools.facts.BiasDetectionFact;

// =====================================================
// REGLAS DE SCORING PARA BIAS DETECTION V1
// =====================================================
// Proceso: bias-detection-v1
// Propósito: Determinar nivel de bias y acciones requeridas
// 
// INPUT: demographicBiasScore, geographicBiasScore, temporalBiasScore
// OUTPUT: decision, overallBiasScore, confidenceLevel, justification, requiresMitigation, riskLevel
// =====================================================

// REGLA 1: NO BIAS DETECTADO (Todos los scores < 30)
rule "No Bias Detected - Low Scores"
    when
        $fact: BiasDetectionFact(
            demographicBiasScore < 30,
            geographicBiasScore < 30,
            temporalBiasScore < 30
        )
    then
        $fact.setDecision("NO_BIAS");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Todos los tipos de bias están por debajo del umbral crítico (30). Modelo considerado libre de bias significativo.");
        $fact.setRequiresMitigation(false);
        $fact.setRiskLevel("LOW");
        update($fact);
end

// REGLA 2: BIAS DETECTADO - MODERADO (Algunos scores 30-60)
rule "Bias Detected - Moderate Level"
    when
        $fact: BiasDetectionFact(
            (demographicBiasScore >= 30 && demographicBiasScore < 60) ||
            (geographicBiasScore >= 30 && geographicBiasScore < 60) ||
            (temporalBiasScore >= 30 && temporalBiasScore < 60),
            overallBiasScore == null
        )
    then
        $fact.setDecision("BIAS_DETECTED");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("MEDIUM");
        $fact.setJustification("Se detectó bias moderado en uno o más aspectos. Requiere revisión humana para determinar acciones de mitigación.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("MEDIUM");
        update($fact);
end

// REGLA 3: BIAS CRÍTICO - ALTO (Algún score >= 60)
rule "Critical Bias - High Scores"
    when
        $fact: BiasDetectionFact(
            (demographicBiasScore >= 60) ||
            (geographicBiasScore >= 60) ||
            (temporalBiasScore >= 60),
            overallBiasScore == null
        )
    then
        $fact.setDecision("CRITICAL_BIAS");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Bias crítico detectado. El modelo presenta sesgos significativos que pueden causar discriminación. Rechazo automático recomendado.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("CRITICAL");
        update($fact);
end

// REGLA 4: BIAS DEMOGRÁFICO CRÍTICO
rule "Critical Demographic Bias"
    when
        $fact: BiasDetectionFact(
            demographicBiasScore >= 70,
            overallBiasScore == null
        )
    then
        $fact.setDecision("CRITICAL_BIAS");
        $fact.setOverallBiasScore($fact.getDemographicBiasScore());
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Bias demográfico crítico detectado (" + $fact.getDemographicBiasScore() + "/100). Riesgo de discriminación por género, edad, raza u otros atributos demográficos.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("CRITICAL");
        update($fact);
end

// REGLA 5: BIAS GEOGRÁFICO CRÍTICO
rule "Critical Geographic Bias"
    when
        $fact: BiasDetectionFact(
            geographicBiasScore >= 70,
            overallBiasScore == null
        )
    then
        $fact.setDecision("CRITICAL_BIAS");
        $fact.setOverallBiasScore($fact.getGeographicBiasScore());
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Bias geográfico crítico detectado (" + $fact.getGeographicBiasScore() + "/100). El modelo puede discriminar por ubicación geográfica.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("CRITICAL");
        update($fact);
end

// REGLA 6: BIAS TEMPORAL CRÍTICO
rule "Critical Temporal Bias"
    when
        $fact: BiasDetectionFact(
            temporalBiasScore >= 70,
            overallBiasScore == null
        )
    then
        $fact.setDecision("CRITICAL_BIAS");
        $fact.setOverallBiasScore($fact.getTemporalBiasScore());
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Bias temporal crítico detectado (" + $fact.getTemporalBiasScore() + "/100). El modelo puede discriminar por período temporal o estacionalidad.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("CRITICAL");
        update($fact);
end

// REGLA 7: BIAS MÚLTIPLE MODERADO
rule "Multiple Moderate Bias"
    when
        $fact: BiasDetectionFact(
            (demographicBiasScore >= 30 && demographicBiasScore < 60) &&
            (geographicBiasScore >= 30 && geographicBiasScore < 60) ||
            (demographicBiasScore >= 30 && demographicBiasScore < 60) &&
            (temporalBiasScore >= 30 && temporalBiasScore < 60) ||
            (geographicBiasScore >= 30 && geographicBiasScore < 60) &&
            (temporalBiasScore >= 30 && temporalBiasScore < 60),
            overallBiasScore == null
        )
    then
        $fact.setDecision("BIAS_DETECTED");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Múltiples tipos de bias moderado detectados. Requiere plan de mitigación integral y revisión exhaustiva.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("HIGH");
        update($fact);
end

// REGLA 8: BIAS EN MODELOS LLM
rule "LLM Model Bias Assessment"
    when
        $fact: BiasDetectionFact(
            modelType == "LLM",
            (demographicBiasScore >= 40 || geographicBiasScore >= 40 || temporalBiasScore >= 40),
            overallBiasScore == null
        )
    then
        $fact.setDecision("BIAS_DETECTED");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("MEDIUM");
        $fact.setJustification("Modelo LLM con bias detectado. Los LLMs requieren umbrales más estrictos debido a su impacto en generación de contenido.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("HIGH");
        update($fact);
end

// REGLA 9: DATASET PEQUEÑO CON BIAS
rule "Small Dataset with Bias"
    when
        $fact: BiasDetectionFact(
            datasetSize < 1000,
            (demographicBiasScore >= 25 || geographicBiasScore >= 25 || temporalBiasScore >= 25),
            overallBiasScore == null
        )
    then
        $fact.setDecision("BIAS_DETECTED");
        $fact.setOverallBiasScore(($fact.getDemographicBiasScore() + $fact.getGeographicBiasScore() + $fact.getTemporalBiasScore()) / 3);
        $fact.setConfidenceLevel("LOW");
        $fact.setJustification("Dataset pequeño (" + $fact.getDatasetSize() + " muestras) con bias detectado. La confianza es baja debido al tamaño limitado del dataset.");
        $fact.setRequiresMitigation(true);
        $fact.setRiskLevel("MEDIUM");
        update($fact);
end
