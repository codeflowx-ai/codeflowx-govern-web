package com.codeflowx.govern.workflow.drools.rules;

import com.codeflowx.govern.workflow.drools.facts.RagEvaluationFact;
import java.util.ArrayList;
import java.util.List;

// Reglas de evaluación para RAG (Retrieval-Augmented Generation)
// Sistema de puntuación y clasificación de calidad de respuestas RAG

rule "Calculate Overall RAG Score"
    when
        $fact: RagEvaluationFact(
            relevanceScore != 0.0,
            accuracyScore != 0.0,
            completenessScore != 0.0,
            coherenceScore != 0.0,
            factualConsistencyScore != 0.0
        )
    then
        $fact.calculateOverallScore();
        update($fact);
end

rule "Determine Quality Grade"
    when
        $fact: RagEvaluationFact(
            overallScore != 0.0,
            qualityGrade == null
        )
    then
        $fact.determineQualityGrade();
        update($fact);
end

rule "Check Performance Thresholds"
    when
        $fact: RagEvaluationFact(
            overallScore != 0.0
        )
    then
        $fact.checkThresholds();
        update($fact);
end

rule "Determine Risk Level"
    when
        $fact: RagEvaluationFact(
            overallScore != 0.0
        )
    then
        $fact.determineRiskLevel();
        update($fact);
end

rule "Excellent RAG Performance"
    when
        $fact: RagEvaluationFact(
            overallScore >= 0.9,
            relevanceScore >= 0.9,
            accuracyScore >= 0.9,
            hallucinationCount == 0,
            responseTimeMs <= 3000
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Mantener configuración actual");
        recommendations.add("Documentar mejores prácticas");
        recommendations.add("Usar como benchmark para otros modelos");
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("LOW");
        $fact.setRequiresReview(false);
        update($fact);
end

rule "Good RAG Performance with Minor Issues"
    when
        $fact: RagEvaluationFact(
            overallScore >= 0.8,
            overallScore < 0.9,
            hallucinationCount <= 1
        )
    then
        List<String> recommendations = new ArrayList<>();
        if ($fact.getRelevanceScore() < 0.8) {
            recommendations.add("Mejorar algoritmo de recuperación de documentos");
            recommendations.add("Optimizar embeddings del vector store");
        }
        if ($fact.getAccuracyScore() < 0.8) {
            recommendations.add("Revisar fuentes de datos");
            recommendations.add("Implementar validación cruzada");
        }
        if ($fact.getResponseTimeMs() > 3000) {
            recommendations.add("Optimizar consultas a la base de datos");
            recommendations.add("Implementar caché de respuestas frecuentes");
        }
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("LOW");
        $fact.setRequiresReview(false);
        update($fact);
end

rule "Moderate RAG Performance - Requires Attention"
    when
        $fact: RagEvaluationFact(
            overallScore >= 0.7,
            overallScore < 0.8
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Revisar configuración del modelo RAG");
        recommendations.add("Analizar calidad de los documentos fuente");
        recommendations.add("Implementar filtros de relevancia más estrictos");
        
        if ($fact.getHallucinationCount() > 0) {
            recommendations.add("Implementar detección de alucinaciones");
            recommendations.add("Ajustar parámetros de generación");
        }
        
        if ($fact.getRetrievalPrecision() < 0.7) {
            recommendations.add("Mejorar algoritmo de ranking de documentos");
            recommendations.add("Ajustar umbrales de similitud");
        }
        
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("MEDIUM");
        $fact.setRequiresReview(true);
        update($fact);
end

rule "Poor RAG Performance - High Risk"
    when
        $fact: RagEvaluationFact(
            overallScore >= 0.6,
            overallScore < 0.7
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Revisión completa del sistema RAG requerida");
        recommendations.add("Reentrenar embeddings del vector store");
        recommendations.add("Actualizar documentos fuente");
        recommendations.add("Implementar validación humana");
        
        if ($fact.getHallucinationCount() > 1) {
            recommendations.add("CRÍTICO: Implementar sistema anti-alucinación");
            recommendations.add("Revisar prompt engineering");
        }
        
        if ($fact.getContextRelevanceScore() < 0.6) {
            recommendations.add("Revisar estrategia de recuperación de contexto");
            recommendations.add("Implementar filtros de calidad de documentos");
        }
        
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("HIGH");
        $fact.setRequiresReview(true);
        update($fact);
end

rule "Critical RAG Performance - Immediate Action Required"
    when
        $fact: RagEvaluationFact(
            overallScore < 0.6
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("ACCIÓN INMEDIATA: Suspender uso en producción");
        recommendations.add("Revisión completa del pipeline RAG");
        recommendations.add("Reentrenar modelo de generación");
        recommendations.add("Auditoría completa de datos fuente");
        recommendations.add("Implementar supervisión humana obligatoria");
        
        if ($fact.getHallucinationCount() > 2) {
            recommendations.add("CRÍTICO: Sistema de alucinaciones inaceptable");
        }
        
        if ($fact.getAccuracyScore() < 0.5) {
            recommendations.add("CRÍTICO: Precisión inaceptable para uso empresarial");
        }
        
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("CRITICAL");
        $fact.setRequiresReview(true);
        update($fact);
end

rule "High Hallucination Risk"
    when
        $fact: RagEvaluationFact(
            hallucinationCount > 2
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("CRÍTICO: Nivel de alucinaciones inaceptable");
        recommendations.add("Implementar detección automática de alucinaciones");
        recommendations.add("Revisar fuentes de datos por veracidad");
        recommendations.add("Ajustar parámetros de temperatura del modelo");
        recommendations.add("Implementar validación cruzada con múltiples fuentes");
        
        $fact.setRecommendations(recommendations);
        $fact.setRiskLevel("CRITICAL");
        $fact.setRequiresReview(true);
        update($fact);
end

rule "Slow Response Time Alert"
    when
        $fact: RagEvaluationFact(
            responseTimeMs > 10000
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Tiempo de respuesta inaceptable (>10s)");
        recommendations.add("Optimizar consultas a la base de datos");
        recommendations.add("Implementar caché de respuestas");
        recommendations.add("Revisar infraestructura de vector store");
        recommendations.add("Considerar escalado horizontal");
        
        $fact.setRecommendations(recommendations);
        if ($fact.getRiskLevel().equals("LOW")) {
            $fact.setRiskLevel("MEDIUM");
        }
        update($fact);
end

rule "Poor Retrieval Performance"
    when
        $fact: RagEvaluationFact(
            retrievalPrecision < 0.6 || retrievalRecall < 0.6
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Rendimiento de recuperación deficiente");
        recommendations.add("Revisar embeddings del vector store");
        recommendations.add("Ajustar algoritmo de búsqueda semántica");
        recommendations.add("Implementar re-ranking de resultados");
        recommendations.add("Revisar calidad de metadatos de documentos");
        
        $fact.setRecommendations(recommendations);
        if ($fact.getRiskLevel().equals("LOW")) {
            $fact.setRiskLevel("MEDIUM");
        }
        update($fact);
end

rule "Context Coverage Issues"
    when
        $fact: RagEvaluationFact(
            contextCoverageScore < 0.7,
            missingContexts != null,
            missingContexts.size() > 2
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Cobertura de contexto insuficiente");
        recommendations.add("Expandir base de conocimientos");
        recommendations.add("Mejorar estrategia de recuperación de contexto");
        recommendations.add("Implementar búsqueda en múltiples fuentes");
        
        $fact.setRecommendations(recommendations);
        if ($fact.getRiskLevel().equals("LOW")) {
            $fact.setRiskLevel("MEDIUM");
        }
        update($fact);
end

rule "Set Final Evaluation Status"
    when
        $fact: RagEvaluationFact(
            overallScore != 0.0,
            qualityGrade != null,
            riskLevel != null
        )
    then
        // Marcar evaluación como completada
        $fact.setEvaluationMethod("automatic");
        update($fact);
end
