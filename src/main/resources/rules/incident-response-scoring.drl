package com.codeflowx.govern.workflow.drools.rules;

import com.codeflowx.govern.workflow.drools.facts.IncidentResponseFact;
import java.util.ArrayList;
import java.util.List;

// Reglas inteligentes para respuesta automática a incidentes ML
// AI-powered Root Cause Analysis y auto-remediation

rule "Calculate Incident Metrics"
    when
        $fact: IncidentResponseFact(
            incidentStartTime != null
        )
    then
        $fact.calculateMinutesSinceStart();
        update($fact);
end

rule "Determine Severity"
    when
        $fact: IncidentResponseFact(
            errorRate != 0.0,
            severity == null
        )
    then
        $fact.determineSeverity();
        update($fact);
end

rule "Determine Response Action"
    when
        $fact: IncidentResponseFact(
            severity != null
        )
    then
        $fact.determineResponseAction();
        update($fact);
end

rule "P1 Critical - Immediate Auto-Rollback"
    when
        $fact: IncidentResponseFact(
            severity == "P1_CRITICAL",
            errorRate > 0.5,
            recentDeployment == true
        )
    then
        List<String> actions = new ArrayList<>();
        actions.add("Rollback inmediato a última versión estable");
        actions.add("Notificar a on-call team");
        actions.add("Iniciar incident war room");
        actions.add("Habilitar circuit breaker");
        
        $fact.setAutomatedActions(actions);
        $fact.setResponseAction("ROLLBACK");
        $fact.setCanAutoRemediate(true);
        $fact.setRequiresApproval(false);
        $fact.setEstimatedRecoveryTime(5);
        $fact.setConfidenceScore(95);
        update($fact);
end

rule "Known Issue - Auto-Fix"
    when
        $fact: IncidentResponseFact(
            isKnownIssue == true,
            causeConfidence > 0.8
        )
    then
        List<String> actions = new ArrayList<>();
        actions.add("Aplicar fix conocido automáticamente");
        actions.add("Validar resolución en 2 minutos");
        actions.add("Actualizar KB con éxito/fallo");
        
        $fact.setAutomatedActions(actions);
        $fact.setResponseAction("AUTO_FIX");
        $fact.setCanAutoRemediate(true);
        $fact.setRequiresApproval(false);
        $fact.setWasAutoResolved(true);
        update($fact);
end

rule "Throughput Drop - Auto-Scale"
    when
        $fact: IncidentResponseFact(
            throughputDrop > 30,
            environment == "PRODUCTION"
        )
    then
        List<String> actions = new ArrayList<>();
        actions.add("Escalar horizontalmente +50%");
        actions.add("Habilitar auto-scaling agresivo");
        actions.add("Validar capacity en 3 minutos");
        
        $fact.setAutomatedActions(actions);
        $fact.setResponseAction("SCALE");
        $fact.setCanAutoRemediate(true);
        $fact.setEstimatedRecoveryTime(3);
        update($fact);
end

rule "High Latency - Optimize"
    when
        $fact: IncidentResponseFact(
            latencyIncrease > 200,
            errorRate < 0.1
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Latencia alta detectada");
        recommendations.add("Revisar cache hit rate");
        recommendations.add("Optimizar queries DB");
        recommendations.add("Considerar CDN para assets");
        
        $fact.setRecommendations(recommendations);
        $fact.setResponseAction("HITL_REQUIRED");
        update($fact);
end

rule "Recent Config Change - Revert"
    when
        $fact: IncidentResponseFact(
            recentConfigChange == true,
            minutesSinceStart < 30,
            causeConfidence > 0.7
        )
    then
        List<String> actions = new ArrayList<>();
        actions.add("Revertir cambio de configuración");
        actions.add("Restaurar config anterior");
        actions.add("Validar estabilidad");
        
        $fact.setAutomatedActions(actions);
        $fact.setResponseAction("ROLLBACK");
        $fact.setCanAutoRemediate(true);
        $fact.setRemediationStrategy("CONFIG_REVERT");
        update($fact);
end

rule "Infrastructure Event - Correlate"
    when
        $fact: IncidentResponseFact(
            infrastructureEvent == true
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Correlacionado con evento de infraestructura");
        recommendations.add("Verificar estado de cloud provider");
        recommendations.add("Activar multi-region failover si disponible");
        
        $fact.setRecommendations(recommendations);
        $fact.setPrimaryCause("INFRASTRUCTURE_EVENT");
        update($fact);
end

rule "Long Running Incident - Escalate"
    when
        $fact: IncidentResponseFact(
            minutesSinceStart > 15,
            severity == "P1_CRITICAL" || severity == "P2_HIGH"
        )
    then
        List<String> actions = new ArrayList<>();
        actions.add("ESCALATE: Incidente >15 min sin resolver");
        actions.add("Notificar a engineering leadership");
        actions.add("Activar incident commander");
        
        $fact.setAutomatedActions(actions);
        $fact.setResponseAction("ESCALATE");
        $fact.setRequiresPostMortem(true);
        update($fact);
end

rule "P4 Low Severity - Monitor Only"
    when
        $fact: IncidentResponseFact(
            severity == "P4_LOW",
            errorRate < 0.01
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Incidente de baja severidad - monitoreo continuo");
        recommendations.add("No requiere acción inmediata");
        recommendations.add("Agrupar con incidentes similares para análisis");
        
        $fact.setRecommendations(recommendations);
        $fact.setResponseAction("MONITOR");
        $fact.setRequiresApproval(false);
        update($fact);
end

rule "Peak Hours - Careful Remediation"
    when
        $fact: IncidentResponseFact(
            timeOfDay == "PEAK",
            environment == "PRODUCTION"
        )
    then
        List<String> recommendations = new ArrayList<>();
        recommendations.add("Horas pico - remediación cuidadosa");
        recommendations.add("Evitar cambios disruptivos");
        recommendations.add("Considerar rolling restart vs full restart");
        
        $fact.setRecommendations(recommendations);
        $fact.setRequiresApproval(true);
        update($fact);
end

rule "Require Incident Report"
    when
        $fact: IncidentResponseFact(
            severity == "P1_CRITICAL" || severity == "P2_HIGH",
            affectedRequests > 1000
        )
    then
        $fact.setRequiresIncidentReport(true);
        $fact.setRequiresPostMortem(true);
        update($fact);
end

rule "Set Final Response Config"
    when
        $fact: IncidentResponseFact(
            responseAction != null,
            severity != null
        )
    then
        // Configuración final lista
        update($fact);
end
