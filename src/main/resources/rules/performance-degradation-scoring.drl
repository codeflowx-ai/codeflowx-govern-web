package com.codeflowx.govern.workflow.drools.rules;

import com.codeflowx.govern.workflow.drools.facts.PerformanceDegradationFact;

// =====================================================
// REGLAS DE SCORING PARA PERFORMANCE DEGRADATION V1
// =====================================================
// Proceso: performance-degradation-v1
// Propósito: Determinar nivel de degradación y acciones requeridas
// 
// INPUT: latencyMs, errorRate, throughput, cpuUsage, memoryUsage
// OUTPUT: decision, severity, confidenceLevel, justification, canAutoscale, recommendedAction
// =====================================================

// REGLA 1: NO DEGRADATION (Todo normal)
rule "No Performance Degradation"
    when
        $fact: PerformanceDegradationFact(
            latencyMs < 500,
            errorRate < 1.0,
            cpuUsage < 70,
            memoryUsage < 70
        )
    then
        $fact.setDecision("NO_DEGRADATION");
        $fact.setSeverity("LOW");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Todas las métricas dentro de rangos normales.");
        $fact.setCanAutoscale(false);
        $fact.setRecommendedAction("MONITOR");
        update($fact);
end

// REGLA 2: DEGRADATION por Latencia Alta
rule "High Latency Degradation"
    when
        $fact: PerformanceDegradationFact(
            latencyMs >= 500,
            latencyMs < 2000,
            errorRate < 5.0,
            decision == null
        )
    then
        $fact.setDecision("DEGRADATION_DETECTED");
        $fact.setSeverity("MEDIUM");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Latencia elevada (" + $fact.getLatencyMs() + "ms). Puede requerir optimización o scaling.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE");
        update($fact);
end

// REGLA 3: CRITICAL DEGRADATION por Latencia Crítica
rule "Critical Latency Degradation"
    when
        $fact: PerformanceDegradationFact(
            latencyMs >= 2000,
            decision == null
        )
    then
        $fact.setDecision("CRITICAL_DEGRADATION");
        $fact.setSeverity("CRITICAL");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Latencia crítica (" + $fact.getLatencyMs() + "ms). Intervención inmediata requerida.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("ROLLBACK_OR_SCALE");
        update($fact);
end

// REGLA 4: CRITICAL por Error Rate Alto
rule "High Error Rate"
    when
        $fact: PerformanceDegradationFact(
            errorRate >= 5.0,
            decision == null
        )
    then
        $fact.setDecision("CRITICAL_DEGRADATION");
        $fact.setSeverity("CRITICAL");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Tasa de error crítica (" + $fact.getErrorRate() + "%). Probable fallo del modelo o servicio.");
        $fact.setCanAutoscale(false);
        $fact.setRecommendedAction("ROLLBACK");
        update($fact);
end

// REGLA 5: DEGRADATION por CPU Alto
rule "High CPU Usage"
    when
        $fact: PerformanceDegradationFact(
            cpuUsage >= 70,
            cpuUsage < 90,
            errorRate < 5.0,
            decision == null
        )
    then
        $fact.setDecision("DEGRADATION_DETECTED");
        $fact.setSeverity("MEDIUM");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Uso de CPU alto (" + $fact.getCpuUsage() + "%). Scaling horizontal recomendado.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE");
        update($fact);
end

// REGLA 6: CRITICAL por CPU Crítico
rule "Critical CPU Usage"
    when
        $fact: PerformanceDegradationFact(
            cpuUsage >= 90,
            decision == null
        )
    then
        $fact.setDecision("CRITICAL_DEGRADATION");
        $fact.setSeverity("CRITICAL");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("CPU crítico (" + $fact.getCpuUsage() + "%). Riesgo de colapso del servicio.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE_URGENT");
        update($fact);
end

// REGLA 7: DEGRADATION por Memoria Alta
rule "High Memory Usage"
    when
        $fact: PerformanceDegradationFact(
            memoryUsage >= 70,
            memoryUsage < 90,
            errorRate < 5.0,
            decision == null
        )
    then
        $fact.setDecision("DEGRADATION_DETECTED");
        $fact.setSeverity("MEDIUM");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Uso de memoria alto (" + $fact.getMemoryUsage() + "%). Posible memory leak o carga excesiva.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE");
        update($fact);
end

// REGLA 8: CRITICAL por Memoria Crítica
rule "Critical Memory Usage"
    when
        $fact: PerformanceDegradationFact(
            memoryUsage >= 90,
            decision == null
        )
    then
        $fact.setDecision("CRITICAL_DEGRADATION");
        $fact.setSeverity("CRITICAL");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Memoria crítica (" + $fact.getMemoryUsage() + "%). Riesgo inminente de OOM (Out of Memory).");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE_URGENT");
        update($fact);
end

// REGLA 9: DEGRADATION Combinada (CPU + Memoria)
rule "Combined CPU Memory Degradation"
    when
        $fact: PerformanceDegradationFact(
            cpuUsage >= 60,
            memoryUsage >= 60,
            (cpuUsage + memoryUsage) / 2 >= 70,
            decision == null
        )
    then
        $fact.setDecision("DEGRADATION_DETECTED");
        $fact.setSeverity("HIGH");
        $fact.setConfidenceLevel("HIGH");
        $fact.setJustification("Degradación combinada: CPU " + $fact.getCpuUsage() + "% + Memoria " + $fact.getMemoryUsage() + "%. Scaling requerido.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("AUTOSCALE");
        update($fact);
end

// REGLA 10: Throughput Bajo (posible problema)
rule "Low Throughput"
    when
        $fact: PerformanceDegradationFact(
            throughput < 10,
            latencyMs >= 1000,
            decision == null
        )
    then
        $fact.setDecision("DEGRADATION_DETECTED");
        $fact.setSeverity("HIGH");
        $fact.setConfidenceLevel("MEDIUM");
        $fact.setJustification("Throughput bajo (" + $fact.getThroughput() + " req/s) con latencia alta. Posible cuello de botella.");
        $fact.setCanAutoscale(true);
        $fact.setRecommendedAction("INVESTIGATE_AND_SCALE");
        update($fact);
end
