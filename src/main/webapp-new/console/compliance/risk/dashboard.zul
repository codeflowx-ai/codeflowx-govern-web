<?page title="Dashboard de Evaluaciones" contentType="text/html;charset=UTF-8"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd">
    <div sclass="container-fluid" 
         viewModel="@id('vm') @init('org.suinsit.compliance.web.DashboardVM')">
        
        <!-- Filtros Superiores -->
        <div sclass="row mb-3">
            <div sclass="col-md-3">
                <div sclass="form-group">
                    <label>Sector</label>
                    <combobox model="@load(vm.sectors)" 
                             selectedItem="@bind(vm.selectedSector)"
                             onChange="@command('filterData')">
                        <template name="model">
                            <comboitem label="@load(each.name)"/>
                        </template>
                    </combobox>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="form-group">
                    <label>Período</label>
                    <combobox model="@load(vm.periods)" 
                             selectedItem="@bind(vm.selectedPeriod)"
                             onChange="@command('filterData')"/>
                </div>
            </div>
            <div sclass="col-md-6 text-end">
                <button sclass="btn btn-outline-primary" 
                        onClick="@command('exportReport')">
                    <i sclass="fas fa-download"></i> Exportar Informe
                </button>
            </div>
        </div>

        <!-- Indicadores Principales -->
        <div sclass="row mb-4">
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body">
                        <h6 sclass="card-subtitle mb-2 text-muted">Empresas Evaluadas</h6>
                        <h3 sclass="card-title">@load(vm.stats.totalCompanies)</h3>
                        <div sclass="small text-success">
                            <i sclass="fas fa-arrow-up"></i> 
                            @load(vm.stats.companyGrowth)% vs período anterior
                        </div>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body">
                        <h6 sclass="card-subtitle mb-2 text-muted">Cumplimiento Promedio</h6>
                        <h3 sclass="card-title">@load(vm.stats.avgCompliance)%</h3>
                        <div sclass="progress" style="height: 5px;">
                            <div sclass="progress-bar" 
                                 style="width: @load(vm.stats.avgCompliance)%"/>
                        </div>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body">
                        <h6 sclass="card-subtitle mb-2 text-muted">Evidencias Validadas</h6>
                        <h3 sclass="card-title">@load(vm.stats.validatedEvidences)</h3>
                        <div sclass="small text-info">
                            @load(vm.stats.pendingEvidences) pendientes
                        </div>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body">
                        <h6 sclass="card-subtitle mb-2 text-muted">Respuestas Críticas</h6>
                        <h3 sclass="card-title">@load(vm.stats.criticalAnswers)</h3>
                        <div sclass="small text-danger">
                            Requieren atención inmediata
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráficos -->
        <div sclass="row mb-4">
            <div sclass="col-md-6">
                <div sclass="card">
                    <div sclass="card-body">
                        <h5 sclass="card-title">Cumplimiento por Categoría</h5>
                        <charts id="categoryChart" type="column"
                               model="@load(vm.categoryComplianceModel)"/>
                    </div>
                </div>
            </div>
            <div sclass="col-md-6">
                <div sclass="card">
                    <div sclass="card-body">
                        <h5 sclass="card-title">Tendencia de Evaluaciones</h5>
                        <charts id="trendChart" type="line"
                               model="@load(vm.evaluationTrendModel)"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tablas de Datos -->
        <div sclass="row">
            <div sclass="col-md-6">
                <div sclass="card">
                    <div sclass="card-body">
                        <h5 sclass="card-title">Top Empresas por Cumplimiento</h5>
                        <grid model="@load(vm.topCompanies)" 
                              emptyMessage="No hay datos disponibles">
                            <columns>
                                <column label="Empresa"/>
                                <column label="Sector"/>
                                <column label="Cumplimiento"/>
                                <column label="Tendencia"/>
                            </columns>
                            <template name="model">
                                <row>
                                    <label value="@load(each.companyName)"/>
                                    <label value="@load(each.sectorName)"/>
                                    <label value="@load(each.complianceScore)%"
                                           sclass="@load(vm.getScoreClass(each.complianceScore))"/>
                                    <div sclass="@load(vm.getTrendClass(each.trend))">
                                        <i sclass="@load(vm.getTrendIcon(each.trend))"/>
                                    </div>
                                </row>
                            </template>
                        </grid>
                    </div>
                </div>
            </div>
            <div sclass="col-md-6">
                <div sclass="card">
                    <div sclass="card-body">
                        <h5 sclass="card-title">Alertas Recientes</h5>
                        <grid model="@load(vm.recentAlerts)" 
                              emptyMessage="No hay alertas recientes">
                            <columns>
                                <column label="Tipo"/>
                                <column label="Descripción"/>
                                <column label="Fecha"/>
                                <column label="Estado"/>
                            </columns>
                            <template name="model">
                                <row>
                                    <label value="@load(each.type)"
                                           sclass="@load(vm.getAlertClass(each.type))"/>
                                    <label value="@load(each.description)"/>
                                    <label value="@load(each.createdAt) 
                                                  @converter('formattedDateTime')"/>
                                    <label value="@load(each.status)"
                                           sclass="@load(vm.getStatusClass(each.status))"/>
                                </row>
                            </template>
                        </grid>
                    </div>
                </div>
            </div>
        </div>
    </div>
</zk>