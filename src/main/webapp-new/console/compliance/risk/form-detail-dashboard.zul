<?page title="Dashboard Formulario" contentType="text/html;charset=UTF-8"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd">
	<div sclass="container-fluid"
		viewModel="@id('vm') @init('org.suinsit.compliance.web.FormDetailDashboardVM')">

		<!-- Header -->
		<div sclass="row mb-3">
			<div sclass="col">
				<div
					sclass="d-flex justify-content-between align-items-center">
					<div>
						<button sclass="btn btn-outline-secondary me-2"
							onClick="@command('goBack')">
							<i sclass="fas fa-arrow-left"></i>
						</button>
						<span sclass="h4">@load(vm.form.title)</span>
					</div>
					<div>
						<button sclass="btn btn-outline-primary"
							onClick="@command('exportDetail')">
							<i sclass="fas fa-download"></i>
							Exportar Detalle
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Estadísticas Generales -->
		<div sclass="row mb-4">
			<div sclass="col-md-3">
				<div sclass="card">
					<div sclass="card-body">
						<h6>Empresas Evaluadas</h6>
						<h3>@load(vm.stats.participatingCompanies)</h3>
						<small>
							De @load(vm.stats.totalEligibleCompanies)
							elegibles
						</small>
					</div>
				</div>
			</div>
			<div sclass="col-md-3">
				<div sclass="card">
					<div sclass="card-body">
						<h6>Cumplimiento Promedio</h6>
						<h3>@load(vm.stats.avgCompliance)%</h3>
						<div sclass="progress" style="height: 5px;">
							<div sclass="progress-bar"
								style="width: @load(vm.stats.avgCompliance)%" />
						</div>
					</div>
				</div>
			</div>
			<div sclass="col-md-3">
				<div sclass="card">
					<div sclass="card-body">
						<h6>Respuestas Críticas</h6>
						<h3>@load(vm.stats.criticalAnswers)</h3>
						<small>Requieren atención</small>
					</div>
				</div>
			</div>
			<div sclass="col-md-3">
				<div sclass="card">
					<div sclass="card-body">
						<h6>Evidencias Pendientes</h6>
						<h3>@load(vm.stats.pendingEvidences)</h3>
						<small>
							De @load(vm.stats.totalEvidences) totales
						</small>
					</div>
				</div>
			</div>
		</div>

		<!-- Gráficos -->
		<div sclass="row mb-4">
			<div sclass="col-md-6">
				<div sclass="card">
					<div sclass="card-body">
						<h5>Distribución por Categoría</h5>
						<charts id="categoryChart" type="pie"
							model="@load(vm.categoryDistributionModel)">
							<zscript>
	import org.zkoss.chart.Charts;
	void initPieChart(Charts chart) {
		chart.getPlotOptions().getPie().setAllowPointSelect(true);
		chart.getPlotOptions().getPie().setCursor("pointer");
		chart.getTooltip().setPointFormat("{point.y} preguntas ({point.percentage:.1f}%)");
	}
	initPieChart(categoryChart);
</zscript>
						</charts>
					</div>
				</div>
			</div>
			<div sclass="col-md-6">
				<div sclass="card">
					<div sclass="card-body">
						<h5>Puntuaciones por Peso</h5>
						<charts id="weightChart" type="column"
							model="@load(vm.weightScoresModel)">
							<zscript>
	import org.zkoss.chart.Charts;
	void initColumnChart(Charts chart) {
		chart.getYAxis().setMin(0);
		chart.getYAxis().setTitle("Puntuación");
		chart.getTooltip().setPointFormat("{point.y:.1f}%");
	}
	initColumnChart(weightChart);
</zscript>
						</charts>
					</div>
				</div>
			</div>
		</div>

		<!-- Tabla de Empresas -->
		<div sclass="row">
			<div sclass="col">
				<div sclass="card">
					<div sclass="card-body">
						<h5>Detalle por Empresa</h5>
						<grid model="@load(vm.companyDetails)"
							mold="paging" pageSize="10">
							<columns>
								<column hflex="2" label="Empresa"
									sort="auto(companyName)" />
								<column hflex="1" label="Progreso"
									sort="auto(completionRate)" />
								<column hflex="1" label="Puntuación"
									sort="auto(score)" />
								<column hflex="1" label="Evidencias"
									sort="auto(evidenceCount)" />
								<column hflex="1" label="Estado"
									sort="auto(status)" />
								<column hflex="1"
									label="Última Actualización" sort="auto(lastUpdate)" />
								<column hflex="1" label="Acciones" />
							</columns>
							<template name="model">
								<row>
									<label
										value="@load(each.companyName)" />
									<div>
										<label
											value="@load(each.completionRate)%" />
										<div sclass="progress"
											style="height: 5px;">
											<div sclass="progress-bar"
												style="width: @load(each.completionRate)%" />
										</div>
									</div>
									<label value="@load(each.score)%"
										sclass="@load(vm.getScoreClass(each.score))" />
									<label
										value="@load(each.evidenceCount)/@load(each.requiredEvidences)" />
									<label value="@load(each.status)"
										sclass="@load(vm.getStatusClass(each.status))" />
									<label
										value="@load(each.lastUpdate) @converter('formattedDateTime')" />
									<div>
										<button
											sclass="btn btn-sm btn-info"
											onClick="@command('viewCompanyDetail', company=each)"
											tooltiptext="Ver Detalle">
											<i sclass="fas fa-eye"></i>
										</button>
										<button
											sclass="btn btn-sm btn-primary"
											onClick="@command('downloadCompanyReport', company=each)"
											tooltiptext="Descargar Reporte">
											<i
												sclass="fas fa-file-download">
											</i>
										</button>
									</div>
								</row>
							</template>
						</grid>
					</div>
				</div>
			</div>
		</div>
	</div>
</zk>