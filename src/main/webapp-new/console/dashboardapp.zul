<zk xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="d-flex btn-mov" onCreate="@global-command('onCreateDashboard',container=contenedor,sidebar=sidebar)">
	    <label id="toggleBtn" class="hidden " 
	    style="font-size: 24px; color: #000; cursor: pointer; margin-top: -25px; margin-right: 15px; border-right: 1px solid var(--card-border);" 
       onClick="toggleSidebar()">☰</label>
       
		<div id="sidebar"  class="menu-sidebar sidebar-menu" visible="true">
		  <div class="sidebar-content">
		  <label id="closeBtn" class="visible close-btn" style="" 
           onClick="toggleSidebar()">✖</label>
             <vbox>
				<a iconSclass="@load(ds.item.iconClass)" label="@load(ds.item.name)" class="sidebar-title" />
				<separator bar="true" />
				<tree>
					<treechildren>
					 <forEach items="@load(ds.items)" varStatus="st">
					   	  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell  label="@load(each.name)"  />
				            </treerow>
				            <treechildren>
				               <forEach items="${each.items}" var="item" varStatus="su">
				                 <treeitem>
				                    <treerow>
									    <treecell label="@load(item.name)" onClick="@global-command('selectItem',item=item,main=each.name,contenedor=contenedor)">
									    </treecell>
				                    </treerow>
				                </treeitem>
				               </forEach>
				            </treechildren>
				        </treeitem>
					 </forEach>
					</treechildren>
				</tree>
			</vbox>
		  </div>
			
		</div>
		<div>

			 <div class="block-overlay" visible="false" id="blocked">
			 	<!-- 
		        <h:image src="../img/candado-icon.png" width="100px" height="100px"/>
		        <label value="Acceso restringido" style="color: white; font-size: 18px; margin-top: 10px;" />
		         -->
		    </div>

			<div class="section-suinsit d-section" id="contenedor" style="position: relative;">
		    <!-- Aquí se cargará el contenido normal -->
		    <include src="dashboard.zul"></include>
			</div>
		</div>
	

</div>

<style>
.block-overlay {
    content: "";
    position: absolute;
    width: 100%; /* Se expande al tamaño del contenedor */
    max-width: 84vw; /* Máximo el ancho del viewport */
    min-width: 320px; /* Mínimo para que no sea demasiado pequeño */
    height: 100%;
    top: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999999999;
    border-radius: 10px;
    pointer-events: all;
}

</style>
<zscript>
         void toggleSidebar() {
            boolean isVisible = sidebar.isVisible();
            sidebar.setVisible(!isVisible);
            
            // Alternar visibilidad de los botones
                     
            
	            if (!isVisible) {
				    toggleBtn.setSclass("hidden");
				    closeBtn.setSclass("visible close-btn");
				} else {
				    toggleBtn.setSclass("visible");
				    closeBtn.setSclass("hidden"); 
				}

        }
    </zscript>
</zk>