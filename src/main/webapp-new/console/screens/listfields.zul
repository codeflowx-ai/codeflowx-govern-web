<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
			<hbox spacing="2px" align="center" width="95%">
				<listbox height="650px" id="listFields"  droppable="true">
			     <listhead></listhead>
					</listbox>
				<vbox spacing="10px" width="24px" align="center">
					<a iconSclass="bx bx-up-arrow-alt" id="fieldsupBtn"
						tooltiptext="move up field">
					</a>
					<a iconSclass="bx bx-down-arrow-alt "
						id="fieldsdownBtn" tooltiptext="move down field">
					</a>
				</vbox>
			</hbox>
</zk>