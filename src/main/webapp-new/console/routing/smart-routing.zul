<?page title="Smart Routing Dashboard" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
	<div self="@define(content)"
		viewModel="@id('vm') @init('org.suinsit.apps.routing.SmartRoutingVM')">

		<!-- Smart Routing Overview -->
		<hlayout sclass="routing-header">
			<div sclass="metric-box">
				<label value="Active Routes" />
				<label value="@load(vm.activeRoutes)" />
			</div>
			<div sclass="metric-box">
				<label value="Routing Efficiency" />
				<label value="@load(vm.routingEfficiency)%"
					sclass="@load(vm.efficiencyStyle)" />
			</div>
			<div sclass="metric-box">
				<label value="Cost Optimization" />
				<label value="@load(vm.costSavings)%"
					sclass="@load(vm.savingsStyle)" />
			</div>
			<div sclass="metric-box">
				<label value="Health Status" />
				<label value="@load(vm.healthStatus)"
					sclass="@load(vm.healthStyle)" />
			</div>
		</hlayout>

		<tabbox>
			<tabs>
				<tab label="Route Configuration" />
				<tab label="Load Balancing" />
				<tab label="Cost Optimization" />
				<tab label="Route Monitoring" />
				<tab label="Performance Metrics" />
			</tabs>
			<tabpanels>
				<!-- Route Configuration Panel -->
				<tabpanel>
					<vlayout>
						<hlayout>
							<button label="Add Route"
								onClick="@command('showAddRouteDialog')" sclass="action-button" />
							<button label="Import Config"
								onClick="@command('importConfig')" sclass="action-button" />
						</hlayout>

						<listbox model="@load(vm.routeConfigurations)"
							mold="paging" pageSize="10">
							<listhead>
								<listheader label="Route Name" />
								<listheader label="Pattern" />
								<listheader label="Target Models" />
								<listheader label="Priority" />
								<listheader label="Status" />
								<listheader label="Actions" />
							</listhead>
							<template name="model" var="route">
								<listitem>
									<listcell label="@load(route.name)" />
									<listcell
										label="@load(route.pattern)" />
									<listcell>
										<forEach
											items="@load(route.targetModels)" var="model">
											<label value="@load(model)" />
										</forEach>
									</listcell>
									<listcell
										label="@load(route.priority)" />
									<listcell>
										<label
											value="@load(route.status)"
											sclass="@load(route.statusStyle)" />
									</listcell>
									<listcell>
										<button label="Edit"
											onClick="@command('editRoute', route=route)" />
										<button label="Toggle"
											onClick="@command('toggleRoute', route=route)" />
										<button label="Test"
											onClick="@command('testRoute', route=route)" />
									</listcell>
								</listitem>
							</template>
						</listbox>

						<!-- Route Rules -->
						<groupbox title="Routing Rules">
							<listbox model="@load(vm.routingRules)">
								<listhead>
									<listheader label="Rule Type" />
									<listheader label="Condition" />
									<listheader label="Action" />
									<listheader label="Priority" />
									<listheader label="Status" />
								</listhead>
								<template name="model" var="rule">
									<listitem>
										<listcell
											label="@load(rule.type)" />
										<listcell
											label="@load(rule.condition)" />
										<listcell
											label="@load(rule.action)" />
										<listcell
											label="@load(rule.priority)" />
										<listcell>
											<label
												value="@load(rule.status)" sclass="@load(rule.statusStyle)" />
										</listcell>
									</listitem>
								</template>
							</listbox>
						</groupbox>
					</vlayout>
				</tabpanel>

				<!-- Load Balancing Panel -->
				<tabpanel>
					<vlayout>
						<!-- Load Distribution Chart -->
						<charts id="loadDistribution" type="pie"
							height="300px" title="Current Load Distribution"
							model="@load(vm.loadDistributionData)" />

						<!-- Load Balancing Configuration -->
						<groupbox title="Load Balancing Settings">
							<grid>
								<rows>
									<row>
										<label value="Algorithm" />
										<combobox
											model="@load(vm.balancingAlgorithms)"
											selectedItem="@bind(vm.selectedAlgorithm)" />
									</row>
									<row>
										<label
											value="Health Check Interval" />
										<intbox
											value="@bind(vm.healthCheckInterval)" />
									</row>
									<row>
										<label
											value="Max Load Threshold" />
										<decimalbox
											value="@bind(vm.maxLoadThreshold)" />
									</row>
								</rows>
							</grid>
						</groupbox>

						<!-- Model Health Status -->
						<listbox model="@load(vm.modelHealthStatus)">
							<listhead>
								<listheader label="Model" />
								<listheader label="Current Load" />
								<listheader label="Response Time" />
								<listheader label="Health Score" />
								<listheader label="Status" />
							</listhead>
							<template name="model" var="health">
								<listitem>
									<listcell
										label="@load(health.modelName)" />
									<listcell>
										<progressmeter
											value="@load(health.currentLoad)" />
										<label
											value="@load(health.currentLoad)%" />
									</listcell>
									<listcell
										label="@load(health.responseTime)ms" />
									<listcell
										label="@load(health.healthScore)%" />
									<listcell>
										<label
											value="@load(health.status)"
											sclass="@load(health.statusStyle)" />
									</listcell>
								</listitem>
							</template>
						</listbox>
					</vlayout>
				</tabpanel>

				<!-- Cost Optimization Panel -->
				<tabpanel>
					<vlayout>
						<!-- Cost Overview -->
						<hlayout>
							<groupbox title="Cost Trends" width="50%">
								<charts id="costTrendsChart" type="line"
									height="300px" model="@load(vm.costTrendsData)" />
							</groupbox>

							<groupbox title="Savings Analysis"
								width="50%">
								<charts id="savingsChart" type="bar"
									height="300px" model="@load(vm.savingsData)" />
							</groupbox>
						</hlayout>

						<!-- Cost Optimization Settings -->
						<groupbox title="Optimization Settings">
							<grid>
								<rows>
									<row>
										<label value="Cost Strategy" />
										<combobox
											model="@load(vm.costStrategies)"
											selectedItem="@bind(vm.selectedStrategy)" />
									</row>
									<row>
										<label value="Budget Threshold" />
										<decimalbox
											value="@bind(vm.budgetThreshold)" />
									</row>
									<row>
										<label
											value="Auto-Optimization" />
										<checkbox
											checked="@bind(vm.autoOptimization)" />
									</row>
								</rows>
							</grid>
						</groupbox>

						<!-- Cost Metrics by Model -->
						<listbox model="@load(vm.costMetrics)">
							<listhead>
								<listheader label="Model" />
								<listheader label="Current Cost" />
								<listheader label="Projected Cost" />
								<listheader label="Potential Savings" />
								<listheader label="Status" />
								<listheader label="Actions" />
							</listhead>
							<template name="model" var="cost">
								<listitem>
									<listcell
										label="@load(cost.modelName)" />
									<listcell
										label="$@load(cost.currentCost)" />
									<listcell
										label="$@load(cost.projectedCost)" />
									<listcell>
										<label
											value="@load(cost.savings)%"
											sclass="@load(cost.savingsStyle)" />
									</listcell>
									<listcell
										label="@load(cost.optimizationStatus)" />
									<listcell>
										<button label="Optimize"
											onClick="@command('optimizeCost', cost=cost)" />
									</listcell>
								</listitem>
							</template>
						</listbox>
					</vlayout>
				</tabpanel>

				<!-- Route Monitoring Panel -->
				<tabpanel>
					<vlayout>
						<!-- Real-time Monitoring -->
						<charts id="routingFlowChart" type="sankey"
							height="400px" title="Real-time Routing Flow"
							model="@load(vm.routingFlowData)" />

						<!-- Route Health Status -->
						<listbox model="@load(vm.routeHealth)">
							<listhead>
								<listheader label="Route" />
								<listheader label="Success Rate" />
								<listheader label="Latency" />
								<listheader label="Traffic" />
								<listheader label="Health" />
								<listheader label="Actions" />
							</listhead>
							<template name="model" var="health">
								<listitem>
									<listcell
										label="@load(health.routeName)" />
									<listcell>
										<label
											value="@load(health.successRate)%" />
									</listcell>
									<listcell
										label="@load(health.avgLatency)ms" />
									<listcell>
										<progressmeter
											value="@load(health.trafficPercentage)" />
									</listcell>
									<listcell>
										<label
											value="@load(health.health)"
											sclass="@load(health.healthStyle)" />
									</listcell>
									<listcell>
										<button label="Diagnose"
											onClick="@command('diagnoseRoute', health=health)" />
									</listcell>
								</listitem>
							</template>
						</listbox>

						<!-- Alert Configuration -->
						<groupbox title="Alert Configuration">
							<grid>
								<rows>
									<row>
										<label
											value="Error Rate Threshold" />
										<decimalbox
											value="@bind(vm.errorRateThreshold)" />
									</row>
									<row>
										<label
											value="Latency Threshold" />
										<intbox
											value="@bind(vm.latencyThreshold)" />
									</row>
									<row>
										<label value="Alert Channels" />
										<textbox
											value="@bind(vm.alertChannels)"
											placeholder="email,slack,webhook" />
									</row>
								</rows>
							</grid>
						</groupbox>
					</vlayout>
				</tabpanel>
				<!-- Performance Metrics Panel -->
				<tabpanel>
					<vlayout>
						<!-- Performance Overview -->
						<hlayout>
							<groupbox title="Response Time Distribution"
								width="50%">
								<charts id="responseTimeChart"
									type="histogram" height="300px"
									model="@load(vm.responseTimeData)" />
							</groupbox>

							<groupbox title="Success Rate Trends"
								width="50%">
								<charts id="successRateChart"
									type="line" height="300px" model="@load(vm.successRateData)" />
							</groupbox>
						</hlayout>

						<!-- Detailed Performance Metrics -->
						<listbox model="@load(vm.routePerformance)">
							<listhead>
								<listheader label="Route" />
								<listheader label="Success Rate" />
								<listheader label="Avg Latency" />
								<listheader label="Requests" />
								<listheader label="Performance" />
								<listheader label="Trend" />
							</listhead>
							<template name="model" var="perf">
								<listitem>
									<listcell
										label="@load(perf.routeName)" />
									<listcell
										label="@load(perf.successRate)%" />
									<listcell
										label="@load(perf.avgLatency)ms" />
									<listcell
										label="@load(perf.requestCount)" />
									<listcell>
										<label
											value="@load(perf.performance)"
											sclass="@load(perf.performanceStyle)" />
									</listcell>
									<listcell>
										<charts type="sparkline"
											model="@load(perf.trendData)" width="100px" height="30px" />
									</listcell>
								</listitem>
							</template>
						</listbox>

						<!-- Performance Analysis Tools -->
						<groupbox title="Analysis Tools">
							<hlayout>
								<button label="Generate Report"
									onClick="@command('generatePerformanceReport')" />
								<button label="Export Metrics"
									onClick="@command('exportMetrics')" />
								<button label="Analyze Bottlenecks"
									onClick="@command('analyzeBottlenecks')" />
							</hlayout>
						</groupbox>
					</vlayout>
				</tabpanel>
			</tabpanels>
		</tabbox>
	</div>
</zk>