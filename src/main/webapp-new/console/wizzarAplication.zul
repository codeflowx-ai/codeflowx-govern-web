<?component name="stepbar" templateURI="stepApp/shadow_elements/step_bar/stepbar.zul"?>
<zk xmlns:h="native">
<style src="stepApp/shadow_elements/step_bar/stepbar.css" />
	
	<div class="container-edit">
	<nodom
		viewModel="@id('vm') @init('com.suinsit.webapp.wizzars.application.WizzarAplicationUI')"
		validationMessages="@id('vmsgs')" form="@id('fx') @load(vm.aplication) @save(vm.aplication,before={'next','create'})">
		<div class="col-xl-12">
			<div class="card border card-border-primary border-opacity-75">
				<div class="card-header">
					<h:h4 class="mb-sm-0">Crear Modulo</h:h4>
					  <div class="list-icons">
					  <button  zclass="pull-right" class="btn btn-icon waves-effect waves-light" iconSclass="fa-sharp-duotone fa-solid fa-xmark" onClick="@global-command('cerrarWizzarApp')"/>
					  </div>
				</div>
				<div class="card-body">
					<stepbar stepBarModel="@init(vm.stepBarModel)"
						gotoStepCommand="gotoStep" />

					<div style="padding: 0 57px; margin-top: 16px;">
						<label sclass="page-title"
							value="@load(vm.stepBarModel.current.label)" />
						<div style="margin-top: 26px;"
							sclass="stepbar-content">
							<apply
								templateURI="@load(vm.stepBarModel.current.uri)"
								step="@load(vm.stepBarModel.current)" />
						</div>
					</div>
				</div>
				<!-- Rounded with Label -->
				<div class="card-footer">
					<div
						style="padding: 0 57px; position: relative; margin-top: 32px;">
						<if
							test="@load(!vm.stepBarModel.first and !vm.stepBarModel.last)">
							<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
						</if>
						<if test="@load(!vm.stepBarModel.last)">
							<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('next')" label="Siguiente" />
						</if>
						<if test="@load(vm.stepBarModel.last)">
							<button zclass="pull-right" sclass="btn btn-success btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-check-double label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('create')" label="Confirmar" />
						</if>
					</div>
					
				</div>
			</div>
		</div>
	</nodom>
	</div>

</zk>