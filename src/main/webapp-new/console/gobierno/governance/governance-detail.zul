<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="governance"
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.governance.GovernanceDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-shield-check label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de políticas de gobierno" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('savePolicy')"
										tooltiptext="Guardar política">
									</a>
									
									<a class="waves-effect waves-light"
										onClick="@command('evaluatePolicy')"
										iconSclass="fa-sharp-duotone fa-solid fa-badge-check label-icon align-middle fs-16 me-2"
										tooltiptext="Evaluar política" 
										visible="@load(vm.isEditing)"/>
									
									<a class="waves-effect waves-light"
										iconSclass="fa-sharp-duotone fa-solid fa-clipboard-check label-icon align-middle fs-16 me-2"
										onClick="@command('runComplianceCheck')"
										tooltiptext="Verificar cumplimiento" 
										visible="@load(vm.isEditing)"/>
									
									<a class="waves-effect waves-light"
										iconSclass="fa-sharp-duotone fa-solid fa-calculator label-icon align-middle fs-16 me-2"
										onClick="@command('calculatePolicyScore')"
										tooltiptext="Calcular puntuación" 
										visible="@load(vm.isEditing)"/>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">
										<div class="form-group row">
											<!-- Nombre -->
											<div class="default col-lg-8 col-xlg-8 col-md-8">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nombre de la Política" />
														<textbox tabindex="1" id="name"
															value="@bind(vm.currentPolicy.name)"
															sclass="border-danger" maxlength="100" />
														<label sclass="text-danger" value="@load(vmsgs['name'])" />
													</div>
												</div>
											</div>
											
											<!-- Versión -->
											<div class="default col-lg-2 col-xlg-2 col-md-2">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Versión" />
														<intbox tabindex="2" id="version"
															value="@bind(vm.currentPolicy.version)"
															readonly="true" />
														<label sclass="text-danger" value="@load(vmsgs['version'])" />
													</div>
												</div>
											</div>
											
											<!-- Tipo -->
											<div class="default col-lg-2 col-xlg-2 col-md-2">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tipo" />
														<combobox tabindex="3" id="policytype"
															selectedItem="@bind(vm.currentPolicy.policytype)"
															readonly="true">
															<comboitem label="Seguridad" value="SECURITY"/>
															<comboitem label="Cumplimiento" value="COMPLIANCE"/>
															<comboitem label="Ética" value="ETHICS"/>
															<comboitem label="Privacidad" value="PRIVACY"/>
															<comboitem label="Operacional" value="OPERATIONAL"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['policytype'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Categoría -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Categoría" />
														<textbox tabindex="4" id="category"
															value="@bind(vm.currentPolicy.category)"
															maxlength="100" />
														<label sclass="text-danger" value="@load(vmsgs['category'])" />
													</div>
												</div>
											</div>
											
											<!-- Enforcement Level -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nivel de Enforcement" />
														<combobox tabindex="5" id="enforcementlevel"
															selectedItem="@bind(vm.currentPolicy.enforcementlevel)"
															readonly="true">
															<comboitem label="Obligatorio" value="MANDATORY"/>
															<comboitem label="Recomendado" value="RECOMMENDED"/>
															<comboitem label="Opcional" value="OPTIONAL"/>
															<comboitem label="Información" value="INFORMATIONAL"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['enforcementlevel'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Descripción -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Descripción" />
														<textbox tabindex="6" id="description"
															value="@bind(vm.currentPolicy.description)"
															rows="3" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['description'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Fecha Efectiva -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Fecha Efectiva" />
														<datebox tabindex="7" id="effectivedate"
															value="@bind(vm.currentPolicy.effectivedate)"
															format="yyyy-MM-dd" />
														<label sclass="text-danger" value="@load(vmsgs['effectivedate'])" />
													</div>
												</div>
											</div>
											
											<!-- Fecha de Expiración -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Fecha de Expiración" />
														<datebox tabindex="8" id="expirationdate"
															value="@bind(vm.currentPolicy.expirationdate)"
															format="yyyy-MM-dd" />
														<label sclass="text-danger" value="@load(vmsgs['expirationdate'])" />
													</div>
												</div>
											</div>
											
											<!-- Estado -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Estado" />
														<combobox tabindex="9" id="status"
															selectedItem="@bind(vm.currentPolicy.status)"
															readonly="true">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Borrador" value="DRAFT"/>
															<comboitem label="Revisión" value="UNDER_REVIEW"/>
															<comboitem label="Archivado" value="ARCHIVED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['status'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Metadata JSON -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata (JSON)" />
														<textbox tabindex="10" id="metadata"
															value="@bind(vm.currentPolicy.metadata)"
															rows="4" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['metadata'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							
							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.isEditing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Reglas" />
												<tab label="Evaluaciones" />
												<tab label="Violaciones" />
												<tab label="Cumplimiento" />
												<tab label="Estadísticas" />
											</tabs>
											<tabpanels>
												
												<!-- Panel 1: Reglas -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Reglas de la Política"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalRules)"/> 
															<label value="reglas"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Condición"/></h:th>
																	<h:th><label value="Acción"/></h:th>
																	<h:th><label value="Prioridad"/></h:th>
																	<h:th><label value="Activa"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.policyRules)" var="rule">
																	<h:tr>
																		<h:td><label value="@load(rule.idxpolicyrule)"/></h:td>
																		<h:td><label value="@load(rule.name)"/></h:td>
																		<h:td><label value="@load(rule.conditiontext)" maxlength="50"/></h:td>
																		<h:td><label value="@load(rule.actiontext)" maxlength="50"/></h:td>
																		<h:td>
																			<h:span class="badge bg-info">
																				<label value="@load(rule.priority)"/>
																			</h:span>
																		</h:td>
																		<h:td>
																			<h:span class="badge ${rule.isactive ? 'bg-success' : 'bg-secondary'}">
																				<label value="@load(rule.isactive ? 'Sí' : 'No')"/>
																			</h:span>
																		</h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.policyRules)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay reglas definidas"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 2: Evaluaciones -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Evaluaciones de Política"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalEvaluations)"/> 
															<label value="evaluaciones"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																	<h:th><label value="Resultado"/></h:th>
																	<h:th><label value="Puntuación"/></h:th>
																	<h:th><label value="Evaluador"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.policyEvaluations)" var="eval">
																	<h:tr>
																		<h:td><label value="@load(eval.idxpolicyevaluation)"/></h:td>
																		<h:td><label value="@load(eval.evaluationdate)"/></h:td>
																		<h:td>
																			<h:span class="badge ${eval.result eq 'PASS' ? 'bg-success' : 'bg-danger'}">
																				<label value="@load(eval.result)"/>
																			</h:span>
																		</h:td>
																		<h:td>
																			<h:span class="badge bg-primary">
																				<label value="@load(eval.compliancescore)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(eval.evaluatedby)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.policyEvaluations)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay evaluaciones registradas"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 3: Violaciones -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Violaciones Detectadas"/>
														</h:h5>
														<h:span class="badge ${vm.totalViolations > 0 ? 'bg-danger' : 'bg-success'}">
															<label value="@load(vm.totalViolations)"/> 
															<label value="violaciones"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Tipo"/></h:th>
																	<h:th><label value="Descripción"/></h:th>
																	<h:th><label value="Severidad"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.policyViolations)" var="violation">
																	<h:tr>
																		<h:td><label value="@load(violation.idxpolicyviolation)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-warning">
																				<label value="@load(violation.violationtype)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(violation.description)" maxlength="60"/></h:td>
																		<h:td>
																			<h:span class="badge ${violation.severity eq 'CRITICAL' ? 'bg-danger' : (violation.severity eq 'HIGH' ? 'bg-warning' : 'bg-info')}">
																				<label value="@load(violation.severity)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(violation.detectedat)"/></h:td>
																		<h:td>
																			<h:span class="badge ${violation.status eq 'RESOLVED' ? 'bg-success' : 'bg-danger'}">
																				<label value="@load(violation.status)"/>
																			</h:span>
																		</h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.policyViolations)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay violaciones registradas"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 4: Cumplimiento -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Evaluaciones de Cumplimiento"/>
														</h:h5>
														<h:span class="badge bg-success">
															<label value="Score Promedio"/>: 
															<label value="@load(vm.averageComplianceScore)"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																	<h:th><label value="Área"/></h:th>
																	<h:th><label value="Score"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Hallazgos"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.complianceAssessments)" var="assessment">
																	<h:tr>
																		<h:td><label value="@load(assessment.idxcomplianceassessment)"/></h:td>
																		<h:td><label value="@load(assessment.assessmentdate)"/></h:td>
																		<h:td><label value="@load(assessment.compliancearea)"/></h:td>
																		<h:td>
																			<h:span class="badge ${assessment.compliancescore >= 80 ? 'bg-success' : (assessment.compliancescore >= 60 ? 'bg-warning' : 'bg-danger')}">
																				<label value="@load(assessment.compliancescore)"/>
																			</h:span>
																		</h:td>
																		<h:td>
																			<h:span class="badge ${assessment.status eq 'PASSED' ? 'bg-success' : 'bg-danger'}">
																				<label value="@load(assessment.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(assessment.totalfindings)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.complianceAssessments)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay evaluaciones de cumplimiento"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 5: Estadísticas -->
												<tabpanel>
													<h:div class="row g-3">
														<h:div class="col-md-3">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-list-check" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalRules)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Reglas"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-3">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-clipboard-list" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalEvaluations)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Evaluaciones"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-3">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-exclamation-triangle" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalViolations)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Violaciones"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-3">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-chart-line" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.currentPolicyScore)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Score Actual"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-12">
															<h:div class="card shadow-sm border-0">
																<h:div class="card-body">
																	<h:h5 class="mb-3">
																		<label value="Información de la Política"/>
																	</h:h5>
																	<h:div class="row">
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Creado por"/>:</h:strong> 
																				<label value="@load(vm.currentPolicy.createdby)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Fecha de creación"/>:</h:strong> 
																				<label value="@load(vm.currentPolicy.createdat)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Última evaluación"/>:</h:strong> 
																				<label value="@load(vm.lastEvaluationDate)"/>
																			</h:p>
																		</h:div>
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Última actualización"/>:</h:strong> 
																				<label value="@load(vm.currentPolicy.updatedat)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Estado evaluación"/>:</h:strong> 
																				<h:span class="badge ${vm.lastEvaluationStatus eq 'PASS' ? 'bg-success' : 'bg-warning'}">
																					<label value="@load(vm.lastEvaluationStatus)"/>
																				</h:span>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Score cumplimiento"/>:</h:strong> 
																				<label value="@load(vm.averageComplianceScore)"/>%
																			</h:p>
																		</h:div>
																	</h:div>
																</h:div>
															</h:div>
														</h:div>
													</h:div>
												</tabpanel>
												
											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>
							
						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>

