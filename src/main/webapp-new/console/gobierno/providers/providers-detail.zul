<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="providers"
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.providers.ProvidersDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-server label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de proveedores de modelos" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveProvider')"
										tooltiptext="Guardar proveedor">
									</a>
									
									<a class="waves-effect waves-light"
										onClick="@command('testConnection')"
										iconSclass="fa-sharp-duotone fa-solid fa-plug label-icon align-middle fs-16 me-2"
										tooltiptext="Probar conexión" 
										visible="@load(vm.editing)"/>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">
										<div class="form-group row">
											<!-- Nombre -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nombre del Proveedor" />
														<textbox tabindex="1" id="modname"
															value="@bind(vm.currentProvider.modname)"
															sclass="border-danger" maxlength="100" />
														<label sclass="text-danger" value="@load(vmsgs['modname'])" />
													</div>
												</div>
											</div>
											
											<!-- Display Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nombre para Mostrar" />
														<textbox tabindex="2" id="moddisplayname"
															value="@bind(vm.currentProvider.moddisplayname)"
															maxlength="255" />
														<label sclass="text-danger" value="@load(vmsgs['moddisplayname'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Tipo -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tipo de Proveedor" />
														<combobox tabindex="3" id="modprovidertype"
															selectedItem="@bind(vm.currentProvider.modprovidertype)"
															readonly="true">
															<comboitem label="Cloud" value="CLOUD"/>
															<comboitem label="Open Source" value="OPEN_SOURCE"/>
															<comboitem label="Enterprise" value="ENTERPRISE"/>
															<comboitem label="Local" value="LOCAL"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modprovidertype'])" />
													</div>
												</div>
											</div>
											
											<!-- Estado -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Estado" />
														<combobox tabindex="4" id="modstatus"
															selectedItem="@bind(vm.currentProvider.modstatus)"
															readonly="true">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Mantenimiento" value="MAINTENANCE"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modstatus'])" />
													</div>
												</div>
											</div>
											
											<!-- Tipo de Auth -->
											<div class="default col-lg-4 col-xlg-4 col-md-4">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tipo de Autenticación" />
														<combobox tabindex="5" id="modauthtype"
															selectedItem="@bind(vm.currentProvider.modauthtype)"
															readonly="true">
															<comboitem label="API Key" value="API_KEY"/>
															<comboitem label="OAuth" value="OAUTH"/>
															<comboitem label="Basic" value="BASIC"/>
															<comboitem label="Bearer Token" value="BEARER"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modauthtype'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- URL Base -->
											<div class="default col-lg-9 col-xlg-9 col-md-9">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="URL Base (Endpoint)" />
														<textbox tabindex="6" id="modbaseurl"
															value="@bind(vm.currentProvider.modbaseurl)"
															maxlength="500" />
														<label sclass="text-danger" value="@load(vmsgs['modbaseurl'])" />
													</div>
												</div>
											</div>
											
											<!-- API Version -->
											<div class="default col-lg-3 col-xlg-3 col-md-3">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Versión API" />
														<textbox tabindex="7" id="modapiversion"
															value="@bind(vm.currentProvider.modapiversion)"
															maxlength="50" />
														<label sclass="text-danger" value="@load(vmsgs['modapiversion'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Descripción -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Descripción" />
														<textbox tabindex="8" id="moddescription"
															value="@bind(vm.currentProvider.moddescription)"
															rows="3" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['moddescription'])" />
													</div>
												</div>
											</div>
										</div>
										
										<div class="form-group row">
											<!-- Modelo de Pricing -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Modelo de Pricing" />
														<textbox tabindex="9" id="modpricingmodel"
															value="@bind(vm.currentProvider.modpricingmodel)"
															maxlength="50" />
														<label sclass="text-danger" value="@load(vmsgs['modpricingmodel'])" />
													</div>
												</div>
											</div>
											
											<!-- Detalles de Pricing (JSON) -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Detalles de Pricing (JSON)" />
														<textbox tabindex="10" id="modpricingdetails"
															value="@bind(vm.currentProvider.modpricingdetails)"
															rows="3" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['modpricingdetails'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							
							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Modelos Disponibles" />
												<tab label="Credenciales" />
												<tab label="Estadísticas" />
											</tabs>
											<tabpanels>
												
												<!-- Panel 1: Modelos -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Catálogo de Modelos"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModels)"/> 
															<label value="modelos"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Tipo"/></h:th>
																	<h:th><label value="Versión"/></h:th>
																	<h:th><label value="Disponible"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.catalogModels)" var="model">
																	<h:tr>
																		<h:td><label value="@load(model.idxmodelcatalog)"/></h:td>
																		<h:td><label value="@load(model.modmodelname)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-secondary">
																				<label value="@load(model.modmodeltype)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(model.modmodelversion)"/></h:td>
																		<h:td>
																			<h:span class="badge ${model.modisavailable ? 'bg-success' : 'bg-secondary'}">
																				<label value="@load(model.modisavailable ? 'Sí' : 'No')"/>
																			</h:span>
																		</h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.catalogModels)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay modelos en el catálogo"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 2: Credenciales -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Credenciales de Acceso"/>
														</h:h5>
														<h:span class="badge bg-warning">
															<label value="@load(vm.totalCredentials)"/> 
															<label value="credenciales"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Tipo"/></h:th>
																	<h:th><label value="Última Rotación"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.providerCredentials)" var="cred">
																	<h:tr>
																		<h:td><label value="@load(cred.idxprovidercredential)"/></h:td>
																		<h:td><label value="@load(cred.modcredentialname)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-info">
																				<label value="@load(cred.modcredentialtype)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(cred.modlastrotatedat)"/></h:td>
																		<h:td>
																			<h:span class="badge ${cred.modisactive ? 'bg-success' : 'bg-secondary'}">
																				<label value="@load(cred.modisactive ? 'Activa' : 'Inactiva')"/>
																			</h:span>
																		</h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.providerCredentials)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay credenciales registradas"/>
														</h:p>
													</h:div>
												</tabpanel>
												
												<!-- Panel 3: Estadísticas -->
												<tabpanel>
													<h:div class="row g-3">
														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-cube" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalModels)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Modelos Disponibles"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-key" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalCredentials)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Credenciales"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-signal" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.uptimePercentage)"/>%
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Uptime"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>
														
														<h:div class="col-md-12">
															<h:div class="card shadow-sm border-0">
																<h:div class="card-body">
																	<h:h5 class="mb-3">
																		<label value="Información del Proveedor"/>
																	</h:h5>
																	<h:div class="row">
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Creado por"/>:</h:strong> 
																				<label value="@load(vm.currentProvider.modcreatedby)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Fecha de creación"/>:</h:strong> 
																				<label value="@load(vm.currentProvider.modcreatedat)"/>
																			</h:p>
																		</h:div>
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Actualizado por"/>:</h:strong> 
																				<label value="@load(vm.currentProvider.modupdatedby)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Última actualización"/>:</h:strong> 
																				<label value="@load(vm.currentProvider.modupdatedat)"/>
																			</h:p>
																		</h:div>
																	</h:div>
																</h:div>
															</h:div>
														</h:div>
													</h:div>
												</tabpanel>
												
											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>
							
						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>

