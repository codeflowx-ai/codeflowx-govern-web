<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    <idspace id="projects"
        viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.projects.ProjectDetailViewModel')"
        validationMessages="@id('vmsgs')">
        <div class="row">
            <div>
                <div class="left tittle-principal">
                    <h:h2 class="mb-1" style="font-weight: bold;">
                        <h:i class="fa-sharp-duotone fa-solid fa-folder-tree label-icon align-middle fs-16 me-2"></h:i>
                        <label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
                    </h:h2>
                    <h:p class="text-muted">
                        <label value="Gestión y configuración de Project" class="text-muted" />
                    </h:p>
                </div>
            </div>
            
            <div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="flex-grow-1">
                                <a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
                                    onClick="@command('cancelEdit')"
                                    sclass="waves-effect waves-light" 
                                    tooltiptext="Volver">
                                </a>
                            </div>
                            <div class="flex-shrink-0">
                                <div class="hstack text-nowrap gap-2 d-flex">
                                    <a class="waves-effect waves-light"
                                        iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
                                        onClick="@command('saveProject')"
                                        tooltiptext="Guardar Project">
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body">
                        <div class="row">
                            <!-- Formulario Principal -->
                            <div class="col-lg-12 col-xlg-12 col-md-12">
                                <div class="card default shadow-xl">
                                    <div class="card-body">
                                        <div class="form-group row">
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="I D X P R O J E C T" />
                                        <textbox tabindex="1" id="idxproject"
                                            value="@bind(vm.currentProject.idxproject)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['idxproject'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="N A M E" />
                                        <textbox tabindex="2" id="name"
                                            value="@bind(vm.currentProject.name)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['name'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-12 col-xlg-12 col-md-12">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="D E S C R I P T I O N" />
                                        <textbox tabindex="3" id="description"
                                            value="@bind(vm.currentProject.description)"
                                            rows="3" multiline="true" />
                                        <label sclass="text-danger" value="@load(vmsgs['description'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="P R O J E C T C O D E" />
                                        <textbox tabindex="4" id="projectcode"
                                            value="@bind(vm.currentProject.projectcode)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['projectcode'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="P R O J E C T T Y P E" />
                                        <combobox tabindex="5" id="projecttype"
                                            selectedItem="@bind(vm.currentProject.projecttype)"
                                            readonly="true">
                                            <comboitem label="LLM" value="LLM"/>
                                            <comboitem label="Visión" value="VISION"/>
                                            <comboitem label="Audio" value="AUDIO"/>
                                            <comboitem label="Embedding" value="EMBEDDING"/>
                                        </combobox>
                                        <label sclass="text-danger" value="@load(vmsgs['projecttype'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="S T A T U S" />
                                        <combobox tabindex="6" id="status"
                                            selectedItem="@bind(vm.currentProject.status)"
                                            readonly="true">
                                            <comboitem label="Activo" value="ACTIVE"/>
                                            <comboitem label="Inactivo" value="INACTIVE"/>
                                            <comboitem label="Pendiente" value="PENDING"/>
                                        </combobox>
                                        <label sclass="text-danger" value="@load(vmsgs['status'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="P R I O R I T Y" />
                                        <combobox tabindex="7" id="priority"
                                            selectedItem="@bind(vm.currentProject.priority)"
                                            readonly="true">
                                            <comboitem label="Opción 1" value="OPTION1"/>
                                            <comboitem label="Opción 2" value="OPTION2"/>
                                            <comboitem label="Opción 3" value="OPTION3"/>
                                        </combobox>
                                        <label sclass="text-danger" value="@load(vmsgs['priority'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="O W N E R I D" />
                                        <textbox tabindex="8" id="ownerid"
                                            value="@bind(vm.currentProject.ownerid)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['ownerid'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="C L I E N T I D" />
                                        <textbox tabindex="9" id="clientid"
                                            value="@bind(vm.currentProject.clientid)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['clientid'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="D E P A R T M E N T I D" />
                                        <textbox tabindex="10" id="departmentid"
                                            value="@bind(vm.currentProject.departmentid)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['departmentid'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="S T A R T D A T E" />
                                        <textbox tabindex="11" id="startdate"
                                            value="@bind(vm.currentProject.startdate)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['startdate'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="E N D D A T E" />
                                        <textbox tabindex="12" id="enddate"
                                            value="@bind(vm.currentProject.enddate)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['enddate'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="E S T I M A T E D H O U R S" />
                                        <textbox tabindex="13" id="estimatedhours"
                                            value="@bind(vm.currentProject.estimatedhours)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['estimatedhours'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="A C T U A L H O U R S" />
                                        <textbox tabindex="14" id="actualhours"
                                            value="@bind(vm.currentProject.actualhours)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['actualhours'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="B U D G E T" />
                                        <textbox tabindex="15" id="budget"
                                            value="@bind(vm.currentProject.budget)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['budget'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="A C T U A L C O S T" />
                                        <textbox tabindex="16" id="actualcost"
                                            value="@bind(vm.currentProject.actualcost)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['actualcost'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="M A N A G E R I D" />
                                        <textbox tabindex="17" id="managerid"
                                            value="@bind(vm.currentProject.managerid)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['managerid'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="C R E A T E D B Y" />
                                        <textbox tabindex="18" id="createdby"
                                            value="@bind(vm.currentProject.createdby)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['createdby'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="I S A C T I V E" />
                                        <textbox tabindex="19" id="isactive"
                                            value="@bind(vm.currentProject.isactive)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['isactive'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="C R E A T E D A T" />
                                        <textbox tabindex="20" id="createdat"
                                            value="@bind(vm.currentProject.createdat)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['createdat'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="U P D A T E D A T" />
                                        <textbox tabindex="21" id="updatedat"
                                            value="@bind(vm.currentProject.updatedat)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['updatedat'])" />
                                    </div>
                                </div>
                            </div>
                            <div class="default col-lg-6 col-xlg-6 col-md-6">
                                <div class="row">
                                    <div class="col-md-12 input-group">
                                        <label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
                                            value="M E T A D A T A" />
                                        <textbox tabindex="22" id="metadata"
                                            value="@bind(vm.currentProject.metadata)"
                                            maxlength="255" />
                                        <label sclass="text-danger" value="@load(vmsgs['metadata'])" />
                                    </div>
                                </div>
                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Tabs de Información Descendente -->
                            <div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
                                <div class="card default shadow-xl">
                                    <div class="card-body">
                                        <tabbox>
                                            <tabs>
                                <tab label="" onClick="@command('onSelectProjectArtifactTab')" />
                                <tab label="" onClick="@command('onSelectProjectMemberTab')" />
                                <tab label="" onClick="@command('onSelectProjectTechnologyTab')" />
                                            </tabs>
                                            <tabpanels>
                                <!-- Panel: ProjectArtifact -->
                                <tabpanel>
                                    <h:div class="d-flex justify-content-between align-items-center mb-3">
                                        <h:h5 class="mb-0">
                                            <label value=""/>
                                        </h:h5>
                                        <h:span class="badge bg-primary">
                                            <label value="@load(vm.totalProjectArtifacts)"/> 
                                            <label value="registros"/>
                                        </h:span>
                                    </h:div>
                                    
                                    <h:div class="table-responsive">
                                        <h:table class="table table-hover table-sm">
                                            <h:thead class="table-light">
                                                <h:tr>
                                                    <h:th><label value="ID"/></h:th>
                                                    <h:th><label value="Nombre"/></h:th>
                                                    <h:th><label value="Estado"/></h:th>
                                                    <h:th><label value="Fecha"/></h:th>
                                                </h:tr>
                                            </h:thead>
                                            <h:tbody>
                                                <forEach items="@load(vm.subgovprojectartifacts)" var="subgovprojectartifacts">
                                                    <h:tr>
                                                        <h:td><label value="@load(subgovprojectartifacts.id)"/></h:td>
                                                        <h:td><label value="@load(subgovprojectartifacts.name)"/></h:td>
                                                        <h:td>
                                                            <h:span class="badge bg-success">
                                                                <label value="@load(subgovprojectartifacts.status)"/>
                                                            </h:span>
                                                        </h:td>
                                                        <h:td><label value="@load(subgovprojectartifacts.createdAt)"/></h:td>
                                                    </h:tr>
                                                </forEach>
                                            </h:tbody>
                                        </h:table>
                                    </h:div>
                                    
                                    <h:div class="text-center text-muted py-3" visible="@load(empty vm.subgovprojectartifacts)">
                                        <h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
                                        <h:p class="mt-2">
                                            <label value="No hay registros"/>
                                        </h:p>
                                    </h:div>
                                </tabpanel>
                                <!-- Panel: ProjectMember -->
                                <tabpanel>
                                    <h:div class="d-flex justify-content-between align-items-center mb-3">
                                        <h:h5 class="mb-0">
                                            <label value=""/>
                                        </h:h5>
                                        <h:span class="badge bg-primary">
                                            <label value="@load(vm.totalProjectMembers)"/> 
                                            <label value="registros"/>
                                        </h:span>
                                    </h:div>
                                    
                                    <h:div class="table-responsive">
                                        <h:table class="table table-hover table-sm">
                                            <h:thead class="table-light">
                                                <h:tr>
                                                    <h:th><label value="ID"/></h:th>
                                                    <h:th><label value="Nombre"/></h:th>
                                                    <h:th><label value="Estado"/></h:th>
                                                    <h:th><label value="Fecha"/></h:th>
                                                </h:tr>
                                            </h:thead>
                                            <h:tbody>
                                                <forEach items="@load(vm.subgovprojectmembers)" var="subgovprojectmembers">
                                                    <h:tr>
                                                        <h:td><label value="@load(subgovprojectmembers.id)"/></h:td>
                                                        <h:td><label value="@load(subgovprojectmembers.name)"/></h:td>
                                                        <h:td>
                                                            <h:span class="badge bg-success">
                                                                <label value="@load(subgovprojectmembers.status)"/>
                                                            </h:span>
                                                        </h:td>
                                                        <h:td><label value="@load(subgovprojectmembers.createdAt)"/></h:td>
                                                    </h:tr>
                                                </forEach>
                                            </h:tbody>
                                        </h:table>
                                    </h:div>
                                    
                                    <h:div class="text-center text-muted py-3" visible="@load(empty vm.subgovprojectmembers)">
                                        <h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
                                        <h:p class="mt-2">
                                            <label value="No hay registros"/>
                                        </h:p>
                                    </h:div>
                                </tabpanel>
                                <!-- Panel: ProjectTechnology -->
                                <tabpanel>
                                    <h:div class="d-flex justify-content-between align-items-center mb-3">
                                        <h:h5 class="mb-0">
                                            <label value=""/>
                                        </h:h5>
                                        <h:span class="badge bg-primary">
                                            <label value="@load(vm.totalProjectTechnologys)"/> 
                                            <label value="registros"/>
                                        </h:span>
                                    </h:div>
                                    
                                    <h:div class="table-responsive">
                                        <h:table class="table table-hover table-sm">
                                            <h:thead class="table-light">
                                                <h:tr>
                                                    <h:th><label value="ID"/></h:th>
                                                    <h:th><label value="Nombre"/></h:th>
                                                    <h:th><label value="Estado"/></h:th>
                                                    <h:th><label value="Fecha"/></h:th>
                                                </h:tr>
                                            </h:thead>
                                            <h:tbody>
                                                <forEach items="@load(vm.subprjprojecttechnologies)" var="subprjprojecttechnologies">
                                                    <h:tr>
                                                        <h:td><label value="@load(subprjprojecttechnologies.id)"/></h:td>
                                                        <h:td><label value="@load(subprjprojecttechnologies.name)"/></h:td>
                                                        <h:td>
                                                            <h:span class="badge bg-success">
                                                                <label value="@load(subprjprojecttechnologies.status)"/>
                                                            </h:span>
                                                        </h:td>
                                                        <h:td><label value="@load(subprjprojecttechnologies.createdAt)"/></h:td>
                                                    </h:tr>
                                                </forEach>
                                            </h:tbody>
                                        </h:table>
                                    </h:div>
                                    
                                    <h:div class="text-center text-muted py-3" visible="@load(empty vm.subprjprojecttechnologies)">
                                        <h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
                                        <h:p class="mt-2">
                                            <label value="No hay registros"/>
                                        </h:p>
                                    </h:div>
                                </tabpanel>
                                            </tabpanels>
                                        </tabbox>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </idspace>
</zk>