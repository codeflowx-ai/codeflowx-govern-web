<zk xmlns:h="native">
<div class="row">
	<h:div class="col-lg-4 ">
		<div class="card">
			<div class="card-header header-elements-inline bg-indigo">
				<h:h6 class="card-title">Select Views</h:h6>
			</div>
			<div class="card-body">
				<listbox model="@load(vm.entidades)"
					selectedItem="@load(vm.vista)"  checkmark="false"
					multiple="false" height="400px" pagingPosition="top" onSelect="@command('selectEntity',item=self.selectedItem.value)">
					<listhead>
						<listheader label="Views"></listheader>
					</listhead>
					<template name="model" var="item">
						<listitem value="${item}"
							label="${item.name}" />
					</template>
				</listbox>
			</div>
			<div class="card-footer">
			<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  
			onClick="@command('nextExecute')" label="Siguiente" />
				
			</div>
		</div>
	</h:div>

	<h:div sclass="col-md-4">
		<html>
			<p>${labels.MddMentity.text1}</p>
			<p style="color:#ed4845">${labels.MddMentity.text2}</p>
		</html>
	</h:div>
</div>
</zk>