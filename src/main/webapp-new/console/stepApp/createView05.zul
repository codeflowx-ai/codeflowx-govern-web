<zk xmlns:h="native">
	<div class="row">
		<h:div class="card border-1 border-indigo col-lg-8">
			<div class="card">
				<div
					class="card-header header-elements-inline bg-indigo">
					<h:h6 class="card-title">
						${labels.views.create.calculate}
					</h:h6>
				</div>
				<div class="card-body">
					<hbox spacing="10px">
						<button label="+ Mathematic"
							onClick="@command('addCalculateMath',cp=wincalculo,popup=winpopup)" tooltiptext="add operation mathematic">
						</button>
						<button label="+ Text"
							onClick="@command('addCalculateString',cp=wincalculo,popup=winpopup)" tooltiptext="add operation text">
						</button>
						<button label="+ Date"
							onClick="@command('addCalculateDate',cp=wincalculo,popup=winpopup)" tooltiptext="add operation date">
						</button>
					</hbox>

					<listbox model="@load(vm.calculate)" height="400px"
						pagingPosition="top">
						<listhead>
							<listheader label="Field Name" width="20%"></listheader>
							<listheader label="Formula" width="33%">
							</listheader>
							<listheader label="Tipo" width="10%">
							</listheader>
							<listheader label=""></listheader>

						</listhead>
						<template name="model" var="item">
							<listitem value="${item}">
								<listcell >
						 		  <textbox value="@bind(item.atribute)" constraint="no empty"></textbox>
								</listcell>
								<listcell label="${item.formula}"></listcell>
									<listcell
										label="${item.typefield}">
									</listcell>
								<listcell>
									<button
										onClick="@command('removeCalculate',item=item)"
										tooltiptext="${labels.MddMentity.remove}"
										iconSclass="icon-trash"
										sclass="btn btn-outline bg-danger text-primary-800 btn-icon ml-2 legitRipple" />
								</listcell>
							</listitem>

						</template>
					</listbox>
<label value="@load(vm.visibleCalculo)"></label>
				</div>
				<div class="card-footer">
												<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" 
								onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
	
									<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  
			onClick="@command('nextExecute',form=fx)" label="Siguiente" />
				
				
				
					
				</div>
			</div>
		</h:div>
<!-- 		<div class="card col-lg-5" visible="@bind(vm.visibleCalculo)"> -->
<!-- 		 <iframe src="math.zhtml" width="100%" height="600px"></iframe> -->
<!-- 	    </div> -->
		<window id ="winpopup" title="Nueva Formula" border="normal" 
		width="60%" height="400px" position="center,center"
		 visible="false">
<!-- 		 <iframe src="math.zhtml" width="100%" height="600px"></iframe> -->
		</window>
	</div>
</zk>