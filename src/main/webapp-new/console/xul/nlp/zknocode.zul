<zk xmlns:h="xhtml">
	<include src="include/breadcrumbs2.zul"></include>
	<div class="col-sm-1 col-xl-1"></div>
	<div class="col-sm-10 col-xl-11">
	<div class="row">
	<div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Analisis de requisitos</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarImportDocument.zul',title='Requisitos Pantallas - Modelo',menu='IA Importar Requisitos')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/semantic.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Importe los requistos mediante nuestras
						plantillas en word para crear pantallas y/o
						micro servicios.
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Definición procesos de negocio BPMN</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarImportBpmn.zul',title='Proceso de negocio',menu='IA Importar Requisitos')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/bpmn-bussines.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Defina con LEKA sus procesos de negocio y reglas de ejecución de los procesos , importando un documento word
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Definición de micro servicios</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA LEKA')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/api.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Importe los requistos mediante nuestras
						plantillas en word para crear 
						micro servicios  exponer su aplicacion a terceros.
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    
    
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Entrene a LEKA</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA LEKA')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/img/bot.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Cree sus propios agentes de IA , combinado diferentes modelos para que sean utilizados por sus usuarios.
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
	  <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Creación de Informes  </h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarReports.zul',title='Informes Gráficos',menu='IA Importar Requisitos')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/INFORMES.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Defina mediante LEKA en lenguaje natural el contenido de sus informes, para que sus usuarios puedan utilizarlo. 
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Creación de Gráficos y Totalizadores</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarReports.zul',title='Informes Gráficos',menu='IA Importar Requisitos')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/GRAFICOS.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Defina mediante LEKA los Graficos y calculos de totalización que podrá utilizar en los dashboard que diseñe. 
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Reglas de negocio </h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA LEKA')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/base-de-datos.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Defina las reglas de negocio de su modelo. 
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    
    <div class="col-sm-3 col-xl-3">
		 <div class="card border card-border-dark  ">
		   <div class="card-header">
			 <div class="d-flex align-items-center">
			   <div class="flex-grow-1">
                      <h:h6 class="card-title">Reglas y Eventos en pantallas</h:h6>   
			   </div>
			  <div class="flex-shrink-0">
			      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item btn-ic">
					     <button onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA LEKA')"
								iconSclass="fa-duotone fa-solid fa-gear" sclass="ic-btn-app" />
					     </h:li>
			      </h:ul>
			</div> 
		  </div>	
		  </div>
		  <div class="card-body border-top-0">
		   <div class="row">
	         <div class="col-lg-6">
	            <div class="row">
                  <div class="col-md-12 col-xl-12">
                    <image src="/console/img/news/disenadores.png" width="90%" height="90%" />
			     </div>
              </div>                     
	       </div>
	       <div class="col-lg-6">
	          <div class="row">
	           <h:span
						class="font-weight-semibold text-justify ">
						Defina reglas y eventos en las pantallas de la
						aplicación. 
					</h:span>
	          </div>
	       </div>     
		  </div>
		</div>
	  </div>	 
    </div>
    
    
     
    
    
    
  </div>  
    </div>
</zk>