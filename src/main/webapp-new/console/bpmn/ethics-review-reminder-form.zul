<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Recordatorio: Revisión Ética Pendiente (14 días)" border="normal" width="750px" 
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.EthicsReviewReminderViewModel')">
        
        <vlayout spacing="15px" style="padding: 20px;">
            <div style="background: #fff3e0; padding: 15px; border-left: 4px solid #ff9800;">
                <label value="⏰ Han pasado 14 días desde que se envió al comité ético" style="font-weight: bold;"/>
                <separator height="5px"/>
                <label value="Sistema/Modelo: ${vm.systemName}" style="color: #666;"/>
            </div>

            <radiogroup id="rg" selectedItem="@bind(vm.selectedDecision)">
                <vlayout spacing="10px">
                    <radio value="COMPLETE_NOW" label="✅ Completar Ahora (tomar decisión inmediata)"/>
                    <radio value="ESCALATE" label="🚨 Escalar a Comité Ejecutivo"/>
                    <radio value="EXTEND" label="⏸️ Extender 7 días más"/>
                </vlayout>
            </radiogroup>

            <separator/>
            <label value="Notas:"/>
            <textbox rows="2" width="100%" value="@bind(vm.notes)"/>

            <separator/>
            <hlayout spacing="10px" style="float: right;">
                <button label="Cancelar" onClick="@command('cancel')"/>
                <button label="Confirmar" onClick="@command('confirm')" style="background: #1976d2; color: white;"/>
            </hlayout>
        </vlayout>
    </window>
</zk>

