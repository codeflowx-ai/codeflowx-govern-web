<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <window id="window_compliance_review_form" 
            title="Revisión de compliance findings"
            border="normal" 
            width="80%" 
            height="70%"
            closable="true"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.ComplianceReviewViewModel')">

        <!-- Header -->
        <hlayout style="padding: 15px; background: #f8f9fa; border-bottom: 2px solid #dee2e6;">
            <label value="Revisión de compliance findings" 
                   style="font-size: 18px; font-weight: bold;"/>
        </hlayout>

        <!-- Content -->
        <groupbox style="margin: 15px;">
            <caption label="Form Data" style="font-weight: bold;"/>
            
            <vlayout spacing="10px" style="padding: 10px;">
                <hlayout>
                    <label value="Decision:" style="font-weight: 600; width: 120px;"/>
                    <textbox value="@bind(vm.decision)" width="400px"/>
                </hlayout>

                <hlayout>
                    <label value="Notes:" style="font-weight: 600; width: 120px;"/>
                    <textbox value="@bind(vm.notes)" 
                             rows="4" 
                             width="600px"
                             placeholder="Enter notes..."/>
                </hlayout>
            </vlayout>
        </groupbox>

        <!-- Footer -->
        <div style="padding: 15px; background: #f8f9fa; border-top: 2px solid #dee2e6;">
            <hlayout spacing="10px">
                <space hflex="1"/>
                <button label="Cancel" onClick="@command('doCancel')" width="120px"/>
                <button label="Submit" 
                        onClick="@command('doSubmit')" 
                        width="150px"
                        disabled="@load(empty vm.decision)"
                        style="background: #007bff; color: white; font-weight: bold;"/>
            </hlayout>
        </div>

    </window>

</zk>
