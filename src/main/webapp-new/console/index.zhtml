<!doctype html>
<html class="h-100" lang="en" xmlns="http://www.w3.org/1999/xhtml"
	xmlns:zk="zk" xmlns:z="zul" xmlns:c="client"
	xmlns:b='http://www.google.com/2005/gml/b'
	xmlns:data='http://www.google.com/2005/gml/data'
	xmlns:expr='http://www.google.com/2005/gml/expr'
	xmlns:og='http://opengraphprotocol.org/schema/'>
	<head>
		<meta charset="utf-8">
			<meta name="viewport"
				content="width=device-width, initial-scale=1">
				<meta name="description" content="">
					<title>Codeflowx | Govern</title>
					<!-- Favicon -->
					<link href="img/favicon.png" rel="icon">
						<link rel="canonical" href="">
							<!-- CSS Bootstrap -->
							<link href="css/bootstrap.min.css"
								rel="stylesheet">
								<link
									href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
									rel="stylesheet">
									<!-- Font Awesome -->
									<link rel="stylesheet"
										href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
										<!-- Kid Font Awesome -->
										<link rel="stylesheet"
											href="https://kit.fontawesome.com/5b0fb4f6f9.css"
											crossorigin="anonymous">
											<!-- Estilos personalizados -->
											<link href="css/styles.css" rel="stylesheet">

	</head>
	<body class="bd-back"
		>
		<z:div
			viewModel="@id('ds') @init('com.suinsit.webapp.nocode.DashboardUI')">
<!-- 			    <zk:custom-attributes dashboard="dashboardapp.zul" /> -->
			    <zk:custom-attributes dashboard="dashboard.zul" />
<!-- 			<zk:custom-attributes dashboard="gobierno/models/models-overview.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="gobierno/analytics/analytics-metrics.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="gobierno/core/security-audit.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="gobierno/core/system-health.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="gobierno/core/menus.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="gobierno/core/departments.zul" /> -->
<!-- 			<zk:custom-attributes dashboard="index-am.zul" /> -->
			<z:include src="header.zul"></z:include>
			<div class="d-flex">
			   <z:include id="menuLeft" src="menuLeft.zul"></z:include>
				<section class="w-100">
<!-- 				<z:include id="menuHeader" src="menuHeader.zul"></z:include> -->
				  <br/><br/>
					<z:div id="iddesktop" sclass="col-12">
        
                        </z:div>
                        
				</section>
			</div>
			<footer class="container-fluid footer">
				<div class="row">
					<div class="col-12 text-center">
						© 2025 Todos los derechos reservados |
						<span>
							<a href="https://www.codeflowx.com">
								www.codeflowx.com
							</a>
						</span>
					</div>
				</div>
			</footer>


			<script>


				// Obtener el ancho de la ventana function
				checkWindowWidth() { const sidebar =
				document.querySelector('.sidebar-left'); const
				windowWidth = window.innerWidth;

				if (windowWidth <= 2500) {
				sidebar.classList.add('closed'); } else {
				sidebar.classList.remove('closed'); } }

				// Llamar a la función al cargar la página y al cambiar
				el tamaño de la ventana window.addEventListener('load',
				checkWindowWidth); window.addEventListener('resize',
				checkWindowWidth);



				// Evento de clic para el botón de alternancia


				document.querySelector('.toggle-btn-left').addEventListener('click',
				function() {
				document.querySelector('.sidebar-left').classList.toggle('closed');
				document.querySelector('.section-suinsit').classList.toggle('collapsed');
				document.querySelector('.toggle-btn-left').classList.toggle('collapsed');
				});

				// Modal function openModal() {
				document.getElementById("modal").style.display =
				"block"; }

				function closeModal() {
				document.getElementById("modal").style.display = "none";
				}


			</script>

		</z:div>
	</body>

</html>
