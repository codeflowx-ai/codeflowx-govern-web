	<div class="section-suinsit d-section" id="contenedor">
	        
		<div class="row">
	
			<div class="col-md-2 col-xl-2">
				<div class="card "
					onClick="@command('selectPage',action='xul/screens/autoreport.zul')">
					<div
						class="card-body bg-white text-center card-img-top">
						<div class="card-img-actions mx-1 mt-1">
							<image class="card-img img-fluid"
								src="img/news/INFORMES.png" width="30%" height="30%">
							</image>
						</div>
						<h:h6 class="font-weight-semibold mb-0">
							Informes
						</h:h6>
						<h:span class="d-block opacity-75 text-teal-800">
							Activado
						</h:span>
					</div>
					<div class="card-body border-top-0">
						<h:span
							class="font-weight-semibold text-justify ">
							Integre Informes en sus aplicaciones.
						</h:span>
					</div>
				</div>
			</div>
			<div class="col-md-2 col-xl-2">
				<div class="card "
					onClick="@command('selectPage',action='xul/charts.zul')">
