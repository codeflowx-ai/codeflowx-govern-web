<?page title="Performance Optimization" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.performance.PerformanceOptimizationVM')">
        
        <!-- Performance Overview -->
        <hlayout sclass="performance-header">
            <div sclass="metric-box">
                <label value="Average Response Time"/>
                <label value="@load(vm.avgResponseTime)ms" 
                       sclass="@load(vm.responseTimeStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Token Optimization"/>
                <label value="@load(vm.tokenOptimization)%" 
                       sclass="@load(vm.tokenOptimizationStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Cost Efficiency"/>
                <label value="@load(vm.costEfficiency)%" 
                       sclass="@load(vm.costEfficiencyStyle)"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Real-time Monitoring"/>
                <tab label="Resource Optimization"/>
                <tab label="Cost Analysis"/>
                <tab label="Recommendations"/>
            </tabs>
            <tabpanels>
                <!-- Real-time Monitoring -->
                <tabpanel>
                    <vlayout>
                        <charts id="performanceChart" 
                               type="line"
                               height="300px"
                               title="Real-time Performance"
                               model="@load(vm.performanceData)"/>
                        
                        <listbox model="@load(vm.performanceMetrics)" 
                                mold="paging" pageSize="10">
                            <listhead>
                                <listheader label="Model"/>
                                <listheader label="Response Time"/>
                                <listheader label="Throughput"/>
                                <listheader label="Error Rate"/>
                                <listheader label="Status"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="metric">
                                <listitem>
                                    <listcell label="@load(metric.modelName)"/>
                                    <listcell label="@load(metric.responseTime)ms"/>
                                    <listcell label="@load(metric.throughput)/s"/>
                                    <listcell>
                                        <label value="@load(metric.errorRate)%" 
                                               sclass="@load(metric.errorRateStyle)"/>
                                    </listcell>
                                    <listcell>
                                        <label value="@load(metric.status)" 
                                               sclass="@load(metric.statusStyle)"/>
                                    </listcell>
                                    <listcell>
                                        <button label="Optimize" 
                                                onClick="@command('optimizeModel', metric=metric)"/>
                                        <button label="Details" 
                                                onClick="@command('showModelDetails', metric=metric)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>

                <!-- Resource Optimization -->
                <tabpanel>
                    <vlayout>
                        <groupbox title="Resource Allocation">
                            <charts id="resourceChart" 
                                   type="pie"
                                   height="300px"
                                   model="@load(vm.resourceAllocationData)"/>
                        </groupbox>

                        <listbox model="@load(vm.resourceOptimizations)" 
                                emptyMessage="No optimization suggestions available">
                            <listhead>
                                <listheader label="Resource"/>
                                <listheader label="Current Usage"/>
                                <listheader label="Recommended"/>
                                <listheader label="Potential Savings"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="resource">
                                <listitem>
                                    <listcell label="@load(resource.name)"/>
                                    <listcell>
                                        <progressmeter value="@load(resource.currentUsage)"/>
                                        <label value="@load(resource.currentUsage)%"/>
                                    </listcell>
                                    <listcell label="@load(resource.recommended)%"/>
                                    <listcell label="@load(resource.potentialSavings)%"/>
                                    <listcell>
                                        <button label="Apply" 
                                                onClick="@command('applyOptimization', resource=resource)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>

                <!-- Cost Analysis Panel -->
                <tabpanel>
                    <vlayout>
                        <charts id="costTrendsChart" 
                               type="line"
                               height="300px"
                               title="Cost Trends"
                               model="@load(vm.costTrendsData)"/>
                               
                        <listbox model="@load(vm.costAnalysis)">
                            <listhead>
                                <listheader label="Model"/>
                                <listheader label="Daily Cost"/>
                                <listheader label="Usage"/>
                                <listheader label="Cost per Request"/>
                                <listheader label="Trend"/>
                            </listhead>
                            <template name="model" var="cost">
                                <listitem>
                                    <listcell label="@load(cost.modelName)"/>
                                    <listcell label="$@load(cost.dailyCost)"/>
                                    <listcell label="@load(cost.usage) requests"/>
                                    <listcell label="$@load(cost.costPerRequest)"/>
                                    <listcell>
                                        <label value="@load(cost.trend)" 
                                               sclass="@load(cost.trendStyle)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>
    </div>
</zk>