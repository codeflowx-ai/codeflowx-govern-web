<zk xmlns:h="native">
<zscript><![CDATA[
	String imgPath = "iconos/nuevos/png";
]]></zscript>
<div sclass="row">
		<div sclass="col-md-6">
			<radiogroup id="sv1"
				onCheck="@command('selectTipo',app=self.selectedItem.value,label=self.selectedItem.label,form=fx) " />
			<div sclass="form-group">
				<label value="Tipo formulario en Data Grid"></label>
				<textbox id="arq" sclass="form-control required"
					value="@bind(fx.modoView) @validator(vm.validator,required=true)"
					visible="false">
				</textbox>
				<label id="arq2"
					class="text-indigo font-weight-bold font-size-lg text-uppercase"
					value="@bind(fx.modoView)">
				</label>
			</div>
		</div>
	</div>
<div class="row">
         <div sclass="col-lg-3">
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
							<div class="col-md-5 col-xl-5">
								<div
									class="card-img-actions ">
									<image class="card-img img-fluid"
										src="${imgPath}/imagenes-01.png">
									</image>
								</div>
							</div>
							<div
								class="col-md-7 col-xl-7 border-top-0">
								 <radio label="Form as Dialog"
									class=" text-uppercase"
									radiogroup="sv1" value="form-dialog" checked="@load(fx.modoView eq 'form-dialog')"
									/>
								
							</div>
						</div>
					</div>
				</div>
			</div>
			<div sclass="col-lg-3">
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
							<div class="col-md-5 col-xl-5">
								<div
									class="card-img-actions ">
									<image class="card-img img-fluid"
										src="${imgPath}/imagenes-02.png">
									</image>
								</div>
							</div>
							<div
								class="col-md-7 col-xl-7 border-top-0">
								
								 <radio label="Form Bellow"
									class=" text-uppercase"
									radiogroup="sv1" value="form-bellow" checked="@load(fx.modoView eq 'form-bellow')"
									/>
								
							</div>
						</div>
					</div>
				</div>
			</div>
			<div sclass="col-lg-3">
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
							<div class="col-md-5 col-xl-5">
								<div
									class="card-img-actions ">
									<image class="card-img img-fluid"
										src="${imgPath}/imagenes-04.png">
									</image>
								</div>
							</div>
							<div
								class="col-md-7 col-xl-7 border-top-0">
								
								 <radio label="Quick Edit"
									class=" text-uppercase"
									radiogroup="sv1" value="quick-edit" checked="@load(fx.modoView eq 'quick-edit')"
									/>
								
							</div>
						</div>
					</div>
				</div>
			</div>
            <div sclass="col-lg-3" >
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
						   	<div class="col-md-12 col-xl-12">
						   	 
						   	   <label value="Seleccione la pantalla que se mostrará"></label>
						   	    <combobox
							value="@bind(vm.dialog)"
							selectedItem="@load(vm.dialog)"
							model="@load(vm.screens)">
							<template name="model" var="item">
								<comboitem label="${item.nameScreen}"
									value="${item.pageName}" />
							</template>
						</combobox>
						   	
								
							</div>
							
						</div>
					</div>
				</div>
			</div>

  		

</div>

<div >
				<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" 
								onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />

				<button zclass="pull-right"
					sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" 
					onClick="@command('nextCrud',form=fx)" label="Siguiente" />
			</div>
</zk>