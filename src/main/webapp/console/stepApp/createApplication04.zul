<zk xmlns:h="native">
	<div sclass="row">
		<div sclass="col-md-3">

		</div>
		<div sclass="col-md-6">
			<div sclass="form-group">
				<label value="Seleccione Base de datos "></label>
				<listbox model="@load(vm.databases)"
					selectedItem="@load(fx.database)" checkmark="false"
					multiple="false" height="300px" pagingPosition="top"
					onSelect="@command('selectBBDD',bbdd=self.selectedItem.value,form=fx)"
					value="@bind(fx.iddatabase)" width="60%">
					<listhead>
						<listheader label="Database"></listheader>
					</listhead>
					<template name="model" var="item">
						<listitem value="@bind(item.id)">
							<listcell label="@load(item.name)" />
						</listitem>
					</template>
				</listbox>



				<!-- 				<combobox model="@load(vm.databases)" selectedItem="@load(fx.database)" onSelect="@command('selectBBDD',bbdd=self.selectedItem.value,form=fx)" value="@bind(fx.iddatabase)" constraint="no empty"> -->
				<!-- 				  <template name="model" var="item"> -->
				<!-- 				      <comboitem label="@load(item.name)" value="@bind(item.id)" /> -->
				<!-- 					</template> -->
				<!-- 				</combobox> -->
			</div>

		</div>
		<div sclass="col-md-3">
			<html>
				<p>${labels.MddMentity.text1}</p>
				<p style="color:#ed4845">${labels.MddMentity.text2}</p>
			</html>
		</div>
	</div>
</zk>