		<!-- 		 	<image src="stepApp/shadow_elements/step_bar/steps/pcs.jpg" style="object-fit: cover;" width="225px" height="180px"></image> -->
		<!-- 		 	<radio id="ra1" label="Aplicacion Web" class="text-indigo font-weight-bold font-size-lg text-uppercase" radiogroup="sv1" value="71"/> -->

		<!-- 		</vbox> -->
		<!-- 		</div> -->
