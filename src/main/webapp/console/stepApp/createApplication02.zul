<zk xmlns:h="native">
	<div sclass="row">
		<div sclass="col-md-6">
			<radiogroup id="sv1"
				onCheck="@command('selectTipo',app=self.selectedItem.value,label=self.selectedItem.label,form=fx) " />
			<div sclass="form-group">
				<label value="Tipo de Aplicacion"></label>
				<textbox id="arq" sclass="form-control required"
					value="@bind(fx.idarquitectura) @validator(vm.validator,required=true)"
					visible="false">
				</textbox>
				<label id="arq2"
					class="text-indigo font-weight-bold font-size-lg text-uppercase"
					value="@bind(fx.labelarquitectura)">
				</label>
				<label sclass="text-danger"
					value="@load(vmsgs['arq'])">
				</label>
			</div>
		</div>
	</div>
	<div sclass="row">
		<forEach items="@init(vm.arquitecturas)" var="item">
			<div sclass="col-lg-3">
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
							<div class="col-md-3 col-xl-3">
								<div
									class="card-img-actions ">
									<image class="card-img img-fluid"
										src="${item.imagen}">
									</image>
								</div>
							</div>
							<div
								class="col-md-9 col-xl-9 border-top-0">
								<vbox spacing="2px">
								 <radio label="${item.txname}"
									class="text-indigo font-weight-bold font-size-lg text-uppercase"
									radiogroup="sv1" value="${item.idxarchitect}"
									disabled="${item.active?false:true}" />
								<label value="${item.dsdescription}"></label>
								</vbox>
									
							</div>


						</div>
					</div>

				</div>


				<!-- 						<vbox spacing="2px" align="center"> -->
				<!-- 						width="180px" height="95px" -->
				<!-- 							<image src="${item.imagen}" -->
				<!-- 								style="object-fit: cover;" > -->
				<!-- 							</image> -->
				<!-- 							<radio label="${item.txname}" -->
				<!-- 								class="text-indigo font-weight-bold font-size-lg text-uppercase" -->
				<!-- 								radiogroup="sv1" value="${item.idxarchitect}" disabled="${item.active?false:true}"/> -->
				<!-- 						</vbox> -->
			</div>
		</forEach>
