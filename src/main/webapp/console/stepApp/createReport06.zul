<zk xmlns:h="native">
	<div class="row">
		<h:div class="card border-1 border-indigo col-lg-10">
			<div class="card">
				<div
					class="card-header header-elements-inline bg-indigo">
					<h:h6 class="card-title">
						${labels.views.create.confirm}
					</h:h6>
				</div>
				<div class="card-body">
					<h:h3 class="card-title">Confirmar</h:h3>
					<div class="form-group row">
						<div class="col-md-3">
							<label value="${labels.wz.title.$}" />
							<textbox type="text" placeholder="Name of report" value="@bind(vm.report.name)"
								sclass="form-control border-warning" />
						</div>
					</div>

				</div>
				<div class="card-footer">
					<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" 
								onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
	<button zclass="pull-right" sclass="btn btn-success btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-check-double label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('confirm')" label="Confirmar" />
					
	
				</div>
			</div>
		</h:div>
	</div>
</zk>