<zk xmlns:h="native">
	<div sclass="row">
		<h:div class="col-md-4 ">

			<vbox spacing="10px">
				<hbox spacing="3px">
					<label
						sclass="fw-bold text-primary-emphasis text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Nombre del Proyecto :" />
					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@bind(vm.almproject.proyectoalm)" />
				</hbox>
				<hbox spacing="3px">
					<label
						sclass="fw-bold text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Namespace" />
					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@bind(vm.almproject.namespace)" />
				</hbox>
				<hbox spacing="10px">
					<label
						sclass="fw-bold text form-label  text-capitalize  font-weight-bold align-text-middle"
						style="  " value="Se clonara la solución/aplicación " />
					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@load(vm.solution.solucion)" />
				</hbox>
				<hbox spacing="10px">
					<label
						sclass="fw-bold text form-label  text-capitalize  font-weight-bold align-text-middle"
						style="  " value="Se clonara el proyecto: " />

					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@load(vm.almprojectClone.proyectoalm)" />
				</hbox>
				<hbox spacing="3px">
					<label
						sclass="fw-bold text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Repositorio Git" />
					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@load(vm.repository.scm)" />
				</hbox>
				<hbox spacing="3px">
					<label
						sclass="fw-bold text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Url Git" />
					<label
						sclass="text form-label  font-weight-normal align-text-middle"
						style="  " value="@load(vm.repository.urlrepomaster)" />
				</hbox>
				<hbox spacing="3px">
					<label
						sclass="fw-bold  text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Nombre Base datos" />
					<label
						sclass="text form-label  font-weight-normal align-text-middle"
						style="  " value="@load(vm.basedatos)" />

				</hbox>
				<hbox spacing="3px">
					<label
						sclass="fw-bold  text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="Cluster" />
					<label
						sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
						style="  " value="@load(vm.kubeCloud.cluster)" />
				</hbox>
		</vbox>
		</h:div>
		<h:div class="col-md-8 ">
		    <label 	sclass="fw-bold fs-3 text form-label  text-info  font-weight-normal align-text-middle" style="  " value="@load(vm.info)" />
			<listbox model="@load(vm.messages)"
				 height="400px"
				 width="99%">
				<listhead>
					<listheader label="Mensaje" sort="auto" />
				</listhead>
				<template name="model" var="item">
					<listitem value="${item}">
						<listcell label="${item}"></listcell>
					</listitem>
				</template>
			</listbox>
		</h:div>
	</div>

	<space></space>
	<div class="card-footer">
		<button zclass="pull-left"
			sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
			onClick="@command('back')"
			iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			label="Anterior" />
		<button zclass="pull-right"
			sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
			iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			onClick="@command('nextCrear')" label="Crear Proyecto" />
	</div>
</zk>