<zk xmlns:h="native">
	<div sclass="row">
		<h:div class="col-lg-12 ">
			<div class="card">
				<div class="card-body">
				<div sclass="row">
				<radiogroup id="sv1" onCheck="@command('selectTipo',tipo=self.selectedItem.value) "/>
					<div sclass="col-md-4">
						<div sclass="form-group">
							<label value="Nombre"></label>
							<textbox id="nameapp"
								sclass="form-control required"
								value="@bind(fx.nameScreen) @validator(vm.validator,required=true,minl=5,maxl=30)">
							</textbox>
							<label sclass="text-danger"
								value="@load(vmsgs['nameapp'])">
							</label>
						</div>
					</div>
					<div sclass="col-md-4">
						<div sclass="form-group">
							<label value="Title"></label>
							<textbox id="nameshort"
								sclass="form-control required"
								value="@bind(fx.title) @validator(vm.validator,required=true,minl=5,maxl=100)">
							</textbox>
							<label sclass="text-danger"
								value="@load(vmsgs['nameshort'])">
							</label>
						</div>
					</div>
					<div sclass="col-md-4">
						<div sclass="form-group">
							<label value="Descripción"></label>
							<textbox id="description" multiline="true" rows="2"
								sclass="form-control required"
								value="@bind(fx.descripcion) @validator(vm.validator,required=true,minl=5,maxl=100)">
							</textbox>
							<label sclass="text-danger"
								value="@load(vmsgs['description'])">
							</label>
						</div>
					</div>
					<div sclass="col-md-2">
						<div sclass="form-group">
							<label value="Pantalla emergente"></label>
							 <checkbox value="@bind(fx.popup)" checked="@bind(fx.popup)"/>
						</div>
					</div>
					<div sclass="col-md-2">
						<div sclass="form-group">
							<radio label="Asociar a Objeto de base de datos"
									class="text-indigo font-weight-bold font-size-lg text-uppercase"
									radiogroup="sv1" value="datamodel" checked="@bind(fx.datamodel)"/>
						</div>
					</div>
					<div sclass="col-md-2">
						<div sclass="form-group">
						   <radio label="Crear nuevo objeto base datos"
									class="text-indigo font-weight-bold font-size-lg text-uppercase"
									radiogroup="sv1" value="create" checked="@bind(fx.createObject)"/>
					   </div>
					</div>
					<div sclass="col-md-2">
						<div sclass="form-group">
						   <radio label="Utilizar multiples objetos base datos"
									class="text-indigo font-weight-bold font-size-lg text-uppercase"
									radiogroup="sv1" value="multiple" checked="@bind(fx.datamultiple)"/>
					   </div>
					</div>
					</div>
				</div>
				<div class="card-footer">
				<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('nextTipo')" label="Siguiente" />
				</div>
			</div>
		</h:div>
	</div>
</zk>