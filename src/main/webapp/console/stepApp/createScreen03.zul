<zk xmlns:h="native">
	<h:div class="col-lg-12 ">
		<div class="card">
			<div class="card-body">
				<div sclass="row"  style="overflow-y: scroll;" height="300px;">
					
					<div sclass="col-md-6" >
						<listbox model="@load(vm.entitys)"
							selectedItem="@bind(vm.entity)" checkmark="true" height="300px;">
							<listhead>
								<listheader label="Modelo Datos"></listheader>
							</listhead>
							<template name="model" var="item">
								<listitem value="${item}"
									label="${item.namesql}" />
							</template>
						</listbox>
					</div>
				</div>
			</div>
			<div class="card-footer">
				<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
				<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" 
				iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  
				onClick="@command('nextResume',form=fx)" label="Siguiente" />
			</div>
		</div>
	</h:div>
</zk>