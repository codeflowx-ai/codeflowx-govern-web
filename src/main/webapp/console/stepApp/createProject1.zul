<zk xmlns:h="native">
	<div sclass="row">
		<div sclass="col-md-6">
			<radiogroup id="sv1"
				onCheck="@command('selectArchitecture',item=self.selectedItem.value) " />
			<div sclass="form-group">
				<label value="Tipo de Arquitectura"></label>
				<label id="arq2"
					class="text-indigo font-weight-bold font-size-xl text-uppercase"
					value="@bind(vm.architecture.arquitectura)">
				</label>
				<label sclass="text-danger"
					value="@load(vmsgs['arq'])">
				</label>
			</div>
		</div>
	</div>
	<div sclass="row">
		<forEach items="@init(vm.architectures)" var="item">
			<div sclass="col-lg-3">
				<div class="card">
					<div class="card-body border-top-0">
						<div class="row">
							<div class="col-lg-4">
								<div class="row">
									<div class="col-md-12 col-xl-12">
										<image sclass=""
											content="@load(vm.getImage(item,'AVATAR'))" width="100%"
											height="100%" />
									</div>
								</div>
							</div>
							<div class="col-lg-8">
								<div class="row">
									<h:div class="col-md-auto">
										<label
											sclass="form-label  text-capitalize  font-weight-normal align-text-middle"
											style=" "
											value="@load(item.descshort) @converter(vm.fieldConverter)">
										</label>
									</h:div>
								</div>
							</div>
							<div
								class="col-md-9 col-xl-9 border-top-0">
								<vbox spacing="2px">
									<radio label="${item.arquitectura}"
										class="text-indigo font-weight-bold font-size-lg text-uppercase"
										radiogroup="sv1" value="${item}"
										disabled="${item.activo?false:true}"
										selected="${item.arquitectura eq vm.architecture.arquitectura?true:false }" />

								</vbox>

							</div>
						</div>
					</div>
				</div>
			</div>
		</forEach>

	</div>
	<div class="card-footer">
		<button zclass="pull-right"
			sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
			iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			onClick="@command('nextProject')" label="Siguiente" />
	</div>
</zk>