<zk xmlns:h="native">
	<div class="row">
		<h:div class="col-lg-12 ">
			<div class="card">
				<div
					class="card-header header-elements-inline bg-indigo">
					<h:h6 class="card-title">
						Configure Select Criteria
					</h:h6>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-lg-8">
						<grid rowRenderer="${vm.propRender}" >
						    <columns>
						    <column label="Prop."></column>
						    <column label="Value"></column>
						    </columns>
						</grid>
							<listbox model="@load(vm.entidad.fields)"
								selectedItems="@bind(vm.charsBean.fields)" checkmark="true"
								multiple="true" height="400px" pagingPosition="top" >
								<listhead>
									<listheader label="Field"></listheader>
									<listheader label="Label"></listheader>
									<listheader label="Use Crieria"></listheader>
									<listheader label="Use Listbox"></listheader>
									<listheader label="Aggregation"></listheader>
								</listhead>
								<template name="model" var="item">
									<listitem value="${item}">
										<listcell
											label="${item.atribute}">
										</listcell>
										<listcell>
										    <textbox value="@bind(item.txlabel)"></textbox>
										</listcell>
										<listcell>
											<checkbox
												value="@bind(item.criteria)" checked="@bind(item.criteria)" />
										</listcell>
										<listcell>
											<checkbox
												value="@bind(item.lboxDistint)" checked="@bind(item.lboxDistint)" disabled="@load(item.criteria ?false:true)"/>
										</listcell>
										<listcell>
											<combobox model="@bind(vm.evals)"
												selectedItem="@bind(item.comparison)"
												value="@bind(item.comparison)" disabled="@load(item.criteria ?false:true)">
												<template
													name="model" var="item">
													<comboitem
														label="${item}" value="${item}" />
												</template>
											</combobox>
										</listcell>
									
									</listitem>
								</template>
							</listbox>
						</div>
						<div class="col-lg-4">
						<grid rowRenderer="${vm.propRender}" height="400px" model="@load(vm.charsBean.props)" >
						    <columns>
						    <column label="Prop."></column>
						    <column label="Value"></column>
						    </columns>
						</grid>
						</div>
					</div>

				</div>
				<div class="card-footer">
					<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
					<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('preview')" label="Siguiente" />
		
				
				
				
				</div>
			</div>
		</h:div>


	</div>
</zk>