<zk xmlns:h="native">
	<div sclass="row">
		<div sclass="col-md-3">

		</div>
		<div sclass="col-md-6">
		 <vbox spacing="5px">
		 <h:table>
				<h:tr>
					<h:td>
						<label value="Nombre Aplicacion"
							sclass="font-weight-bold font-size-xl text-uppercase">
						</label>
					</h:td>
					<h:td>
						<label
							sclass="text-indigo font-weight-bold font-size-lg text-uppercase"
							value="@load(fx.projectBase.txname)">
						</label>
					</h:td>
				</h:tr>
				<h:tr>
					<h:td>
						<label value="Tipo de Aplicacion"
							sclass="font-weight-bold font-size-xl text-uppercase">
						</label>
					</h:td>
					<h:td>
						<label
							sclass="text-indigo font-weight-bold font-size-lg text-uppercase"
							value="@load(fx.labelarquitectura)">
						</label>
					</h:td>
				</h:tr>
				<h:tr>
					<h:td>
						<label value="Aplicacion Complementaria de"
							sclass="font-weight-bold font-size-xl text-uppercase">
						</label>
					</h:td>
					<h:td>
						<label
							sclass="text-indigo font-weight-bold font-size-lg text-uppercase"
							value="@load(fx.projectAsociado.txname)">
						</label>
					</h:td>
				</h:tr>
				<h:tr>
					<h:td>
						<label value="Base de datos "
							sclass="font-weight-bold font-size-xl text-uppercase">
						</label>
					</h:td>
					<h:td>
						<label
							sclass="text-indigo font-weight-bold font-size-lg text-uppercase"
							value="@load(fx.database.name)">
						</label>
					</h:td>
				</h:tr>

			</h:table>
			<space></space>
		  <hbox id="progress" align="center" >
                <progressmeter id="currmet" value="@load(vm.progres)" width="300px" />
                <label  value="@load(vm.sprogress)" ></label>
            </hbox>
		 </vbox>
			
		</div>
		<div sclass="col-md-2">
		   <image src="@load(fx.arquitectura.architect.imagen)" style="object-fit: cover;" ></image>
		<!-- 
		  <choose>
			<when test="@load(fx.idarquitectura eq '71')">
			 <image src="stepApp/shadow_elements/step_bar/steps/pcs.jpg" style="object-fit: cover;" width="225px" height="180px"></image>
			</when>
			<when test="@load(fx.idarquitectura eq '72')">
			 <image src="stepApp/shadow_elements/step_bar/steps/network1.jpg" style="object-fit: cover;" width="225px" height="180px"></image>
			</when>
			<when test="@load(fx.idarquitectura eq '73')">
			 <image src="stepApp/shadow_elements/step_bar/steps/analisis.jpg" style="object-fit: cover;" width="225px" height="180px"></image>
			</when>
