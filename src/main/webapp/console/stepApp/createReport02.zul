<zk xmlns:h="native">
	<div class="row">
		<h:div class="card border-1 border-indigo col-lg-10">
			<div class="card">
				<div
					class="card-header header-elements-inline bg-indigo">
					<h:h6 class="card-title">Select Columns</h:h6>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-lg-4">
							<hbox spacing="15px" align="center">
								<!-- selectedItems="@bind(vm.attsSelected)" -->
								<listbox model="@bind(vm.atts)"
									height="450px" pagingPosition="top"
									selectedItem="@bind(vm.column)">
									<listhead>
										<listheader label="Column"
											width="10%">
										</listheader>
										<!-- 							<listheader label="Label" width="10%"></listheader> -->
										<!-- 							<listheader label="width" width="40px"></listheader> -->
										<!-- 							<listheader label="Totalizar" width="80px">	</listheader> -->
										<!-- 							<listheader label="Mask" width="80px"></listheader> -->
										<!-- 							<listheader label="Group" width="80px"></listheader> -->
										<!-- 							<listheader label="Clazz" width="80px"></listheader> -->
									</listhead>
									<template name="model" var="item">
										<listitem value="${item}">
											<listcell
												label="${item.field.atribute}">
											</listcell>

											<!-- 								<listcell> -->

											<!-- 								</listcell> -->
											<!-- 								<listcell> -->

											<!-- 								</listcell> -->

											<!-- 								<listcell -->
											<!-- 									label="${item.clazz}"> -->
											<!-- 								</listcell> -->
										</listitem>

									</template>
								</listbox>
								<vbox spacing="10px" width="24px"
									align="center">
									<a iconSclass="icon-arrow-up16 "
										id="upBtn" tooltiptext="move up field"
										onClick="@command('upBtn')">
									</a>
									<a iconSclass="icon-arrow-down16 "
										id="downBtn" tooltiptext="move down field"
										onClick="@command('downBtn')">
									</a>
								</vbox>

							</hbox>
						</div>
						<div class="col-lg-8">
							<div align="left"
								style="vertical-align:top;">
								<tabbox width="99%"
									style="vertical-align:top;"
									visible="@load(vm.column ne null)">
									<tabs width="99%">
										<tab label="Propiedades" />
										<tab label="Header Style" />
										<tab label="Column Style" />
										<tab label="Group Style" />
										<tab label="Totalize Style" />
									</tabs>
									<tabpanels width="99%">
										<tabpanel width="99%">
										<grid oddRowSclass="NONE"
												height="450px">
												<columns>
													<column
														label="Propiedad" />
													<column
														label="Valor" />
												</columns>
												<rows>
													<row>
														<label
															value="Label" />
														<textbox
															value="@bind(vm.column.label)">
														</textbox>
													</row>
													<row>
														<label
															value="Mostrar">
														</label>
														<checkbox
															value="@bind(vm.column.mostrar)"
															checked="@bind(vm.column.mostrar)" />
													</row>
													<row>
														<label
															value="Es Parametro">
														</label>
														<checkbox
															value="@bind(vm.column.criteria)"
															checked="@bind(vm.column.criteria)" />
													</row>
													<row>
														<label
															value="Agrupar">
														</label>
														<checkbox
															value="@bind(vm.column.group)"
															checked="@bind(vm.column.group)" />
													</row>
													<row>
														<label
															value="Width" />
														<intbox
															value="@bind(vm.column.width)">
														</intbox>
													</row>
													<row>
														<label
															value="Calcular/Totalizar">
														</label>
														<combobox
															selectedItem="@bind(vm.column.totalizar)"
															value="@bind(vm.column.totalizar)">
															<comboitem
																label="SUM" value="SUM" />
															<comboitem
																label="COUNT" value="COUNT" />
															<comboitem
																label="AVERAGE" value="AVERAGE" />
															<comboitem
																label="FIRST" value="FIRST" />
															<comboitem
																label="HIGHEST" value="HIGHEST" />
																<comboitem
																label="LOWEST" value="LOWEST" />
																<comboitem
																label="HIGHEST" value="HIGHEST" />
																<comboitem
																label="NOTHING" value="NOTHING" />
																<comboitem
																label="STANDARD_DEVIATION" value="STANDARD_DEVIATION" />
																<comboitem
																label="VARIANCE" value="VARIANCE" />
																<comboitem
																label="DISTINCT_COUNT" value="DISTINCT_COUNT" />
														</combobox>
													</row>
													<row>
														<label
															value="Mask">
														</label>
														<combobox
															model="@load(vm.column.masks)"
															selectedItem="@bind(vm.column.mask)"
															value="@bind(vm.column.mask)">
															<template
																name="model">
																<comboitem
																	label="${each}" value="${each}" />
															</template>

														</combobox>
													</row>
													<row>
														<label
															value="Barcode">
														</label>
														<combobox
															model="@load(vm.barcodes)"
															selectedItem="@bind(vm.column.barcode)"
															value="@bind(vm.column.barcode)">
															<template
																name="model">
																<comboitem
																	label="${each}" value="${each}" />
															</template>

														</combobox>
													</row>
												</rows>
											</grid>
											
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleHeaderColumn.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
										<apply templateURI="stepApp/report/styleColumnColumn.zul"></apply>
											
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleGroupColumn.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleTotalColumn.zul"></apply>
										</tabpanel>
									</tabpanels>
								</tabbox>

							</div>
						</div>
					</div>


				</div>
				<div class="card-footer">
					<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" 
								onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />

								<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  
			onClick="@command('nextColumns')" label="Siguiente" />
					
				</div>
			</div>
		</h:div>
	</div>
</zk>