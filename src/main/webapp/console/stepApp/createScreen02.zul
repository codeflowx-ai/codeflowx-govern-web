<zk xmlns:h="native">

	<h:div class="col-lg-12 " >
		<div class="card">
			<div class="card-body">
				<div sclass="row">
					<div sclass="col-md-6">
						<radiogroup id="sv1"
							onCheck="@command('selectTemplate',template=self.selectedItem.value,form=fx) " />
					</div>
				</div>
				<div sclass="row" style="overflow-y: scroll;" height="300px;">
					<forEach items="@init(vm.templates)" var="item">
						<div sclass="col-lg-3">
						     <div sclass="row">
						       <div sclass="col-md-6">
						         <image src="${item.icon32}"
									style="object-fit: contain;" >
								</image>
						       </div>
						       <div sclass="col-md-12">
						        <radio label="${item.label}"
									
									radiogroup="sv1" value="${item}" checked="@load(fx.templateName eq item.name)"/>
						       </div>
						       <div sclass="col-md-12">
<!-- 						         <label value="${item.description}"></label> -->
						       </div>
						     </div>
							
						</div>
					</forEach>
				</div>
			</div>
			<div class="card-footer">
				<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
				<button zclass="pull-right" visible="@load(vm.templateLayout eq null?false:true)" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  onClick="@command('nextTemplate')" label="Siguiente" />
			</div>
		</div>
	</h:div>

</zk>