<zk xmlns:h="native">
	<div class="row">
		<h:div class="card border-1 border-indigo col-lg-10">
			<div class="card">
				<div
					class="card-header header-elements-inline bg-indigo">
					<h:h6 class="card-title">Configuracion Report</h:h6>
				</div>
				<div class="card-body">
					<div class="form-group row">
						<div class="col-md-3">
							<label value="${labels.wz.title.$}" />
							<textbox type="text"
								placeholder="Title of report" value="@bind(vm.report.title)"
								sclass="form-control border-warning" />
						</div>
						<div class="col-md-3">
							<label value="${labels.wz.subtitle.$}" />
							<textbox type="text"
								placeholder="Sub Title of report"
								value="@bind(vm.report.subtitle) "
								sclass="form-control border-warning" />
						</div>
						<div class="col-md-3">
							<label value="Page / Orientation)" />
							<combobox model="@load(vm.orientation)"
								selectedItem="@bind(vm.report.orientation)"
								value="@bind(vm.report.orientation)">
								<template name="model">
									<comboitem label="${each}"
										value="${each}" />
								</template>

							</combobox>
						</div>
						<div class="col-md-3">
							<hbox spacing="10px">
								<checkbox
									value="@bind(vm.report.multipleExport)"
									checked="@bind(vm.report.multipleExport)"
									label="Multiple Export" />
								<checkbox
									value="@bind(vm.addChart)"
									checked="@bind(vm.addChart)" label="Add Chart" />
								<checkbox
									value="@bind(vm.addCrosTable)"
									checked="@bind(vm.addCrosTable)"
									label="Add CrossTable" />

							</hbox>

						</div>
					</div>
					<div class="form-group row">
						<div class="col-md-4">
							<vbox spacing="10px">
								<hbox spacing="10px">
									<checkbox
										value="@bind(vm.report.config.applyGlobalStyle)"
										checked="@bind(vm.report.config.applyGlobalStyle)"
										label="Apply GlobalStyle" />
									<checkbox
										value="@bind(vm.report.config.useFullPageWidth)"
										checked="@bind(vm.report.config.useFullPageWidth)"
										label="Full Page" />

								</hbox>
								<hbox spacing="10px">
									<checkbox
										value="@bind(vm.report.config.printBackgroundOnOddRows)"
										checked="@bind(vm.report.config.printBackgroundOnOddRows)"
										label="Background On OddRows" />
									<checkbox
										value="@bind(vm.report.config.printColumnNames)"
										checked="@bind(vm.report.config.printColumnNames)"
										label="Print ColumnNames" />


								</hbox>
								<hbox spacing="10px">

									<checkbox
										value="@bind(vm.report.config.showDetailBand)"
										checked="@bind(vm.report.config.showDetailBand)"
										label="Show DetailBand" />
									<checkbox
										value="@bind(vm.report.config.totalizeFooter)"
										checked="@bind(vm.report.config.totalizeFooter)"
										label="Totalize Footer" />
								</hbox>
								<hbox spacing="10px">

									<checkbox
										value="@bind(vm.report.config.totalizeHeader)"
										checked="@bind(vm.report.config.totalizeHeader)"
										label="Totalize Header" />
									<checkbox
										value="@bind(vm.report.config.reprintHeaderOnEachPage)"
										checked="@bind(vm.report.config.reprintHeaderOnEachPage)"
										label="Print header On each Page" />
								</hbox>

							</vbox>

						</div>
						<div class="col-md-8">

							<div align="left"
								style="vertical-align:top;">
								<tabbox width="99%"
									style="vertical-align:top;">
									<tabs width="99%">
										<tab label="Title Style" />
										<tab label="SubTitle Style" />
										<tab label="Header Style"
											visible="@bind(vm.report.config.applyGlobalStyle)" />
										<tab label="Column Style"
											visible="@bind(vm.report.config.applyGlobalStyle)" />
										<tab label="Group Style"
											visible="@bind(vm.report.config.applyGlobalStyle)" />
										<tab label="Totalize Style"
											visible="@bind(vm.report.config.applyGlobalStyle)" />
										<tab label="Footer Style" />
									</tabs>
									<tabpanels>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleTitle.zul"></apply>
										</tabpanel>
										
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleSubTitle.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleHeader.zul"></apply>
										</tabpanel>
										
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleColumn.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleGroup.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleTotales.zul"></apply>
										</tabpanel>
										<tabpanel width="99%">
											<apply templateURI="stepApp/report/styleFooter.zul"></apply>
										</tabpanel>
									</tabpanels>
								</tabbox>

							</div>
						</div>
					</div>
				</div>
				<div class="card-footer">
								<button zclass="pull-left"
								sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill" 
								onClick="@command('back')" iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2" label="Anterior" />
	
						<button zclass="pull-right" sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill" iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"  
			onClick="@command('nextConfig')" label="Siguiente" />
					
				</div>
			</div>
		</h:div>
	</div>
</zk>

