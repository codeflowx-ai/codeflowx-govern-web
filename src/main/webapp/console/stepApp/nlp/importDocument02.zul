<zk xmlns:h="native">
	<div class="row s-bot">
		<h:div class="card col-lg-12">
			<div class="card-body">
				<div class="row card-brd">
					<h:div class="col-lg-3">
						<div class="card">
							<div
								class="card-header header-elements-inline bg-indigo">
								<h:h6 class="card-title">
									Tablas definidas en los requisitos
									${vm.totalTables}
								</h:h6>
							</div>
							<div class="card-body">
								<listbox model="@load(vm.entidades)"
									onSelect="@command('selectTable' , item=self.selectedItem.value)"  sclass="scrollable-barra">
									<listhead>
										<listheader
											label="Tables/Views">
										</listheader>
										<listheader label="Type"
											sort="auto">
										</listheader>
									</listhead>
									<template name="model" var="item">
										<listitem value="${item}">
											<listcell
												label="${item.namesql }">
											</listcell>
											<listcell
												label="${item.entitype }">
											</listcell>
										</listitem>

									</template>
								</listbox>
							</div>

						</div>
					</h:div>
					<h:div class="col-lg-9">
						<div class="card">
							<div
								class="card-header header-elements-inline bg-indigo">
								<h:h6 class="card-title">
									${vm.entity.namesql}
								</h:h6>
							</div>
							<div class="card-body crd-tabs">
							<tabbox>
								<tabs>
									<tab label="Campos" />
									<tab label="Relaciones" />
									<tab label="Sub Tablas" />
								</tabs>
								<tabpanels>
									<tabpanel>
										<listbox id="atributtes"
											 model="@bind(vm.atts)"
											selectedItem="@bind(vm.atts)" sizedByContent="true"
											sclass="scrollable-barra">
											<listhead>
												<listheader
													label="${labels.EntityMaster.type}" width="50px" />
												<listheader
													label="${labels.EntityMaster.name}" width="250px" />
												<listheader
													label="${labels.EntityMaster.unique}" />
												<listheader
													label="${labels.EntityMaster.primarykey}" />
												<listheader
													label="Obligatorio" />
												<listheader
													label="${labels.EntityMaster.criteria}" />
												<listheader
													label="Listar" />
												<listheader
													label="${labels.EntityMaster.increment}" />
												<listheader
													label="Encriptar" />

												<listheader
													label="Auditar" />

												<listheader
													label="Puede Filtrar" />
												<listheader
													label="${labels.EntityMaster.size}" width="150px" />

											</listhead>
											<template name="model"
												var="item" status="s">
												<listitem>
													<listcell>

														<image
															src="@load(item.fieldBean.icono)">
														</image>
													</listcell>
													<listcell
														label="@load(item.columnname)">

													</listcell>
													<listcell>
														<checkbox
															checked="@bind(item.unique) "
															disabled="@load(item.pk eq true)">
														</checkbox>
													</listcell>
													<listcell>
														<choose>
															<when
																test="@load(item.pk)">
																<h:i
																	class="fa-sharp-duotone fa-solid fa-key">
																</h:i>
															</when>
															<otherwise>
																<h:i
																	class="fa-sharp fa-solid fa-xmark">
																</h:i>
															</otherwise>
														</choose>

													</listcell>

													<listcell>
														<checkbox
															checked="@bind(item.nullable) "
															disabled="@load(item.pk eq true or item.system eq true)">
														</checkbox>
													</listcell>
													<listcell>
														<checkbox
															checked="@bind(item.criteria) "
															disabled="@load(item.pk eq true or item.system eq true)" />
													</listcell>
													<listcell>
														<checkbox
															checked="@bind(item.showList) "
															disabled="@load(item.pk eq true or item.system eq true)" />
													</listcell>
													<listcell>
														<choose>
															<when
																test="@load(item.fieldBean.idx eq 6)">
																<checkbox
																	checked="@bind(item.increment) "
																	disabled="@load(item.pk eq true or item.system eq true)">
																</checkbox>
															</when>
															<otherwise>
																<label
																	sclass="icon-cross3 btn btn-pure"
																	style="font-size: 16px;">
																</label>
															</otherwise>
														</choose>
													</listcell>
													<listcell>
														<checkbox
															checked="@bind(item.encriptar) ">
														</checkbox>
													</listcell>


													<listcell>
														<checkbox
															checked="@bind(item.auditable) ">
														</checkbox>
													</listcell>



													<listcell>
														<checkbox
															checked="@bind(item.filter)">
														</checkbox>
													</listcell>

													<listcell>
														<combobox
															model="@load(item.fieldBean.sizes)"
															selectedItem="@bind(item.fieldBean.size)" width="90%"
															disabled="@load(item.pk eq true or item.columnsize gt 0 or item.system eq true)">
															<template
																name="model" var="item1">
																<comboitem
																	label="@load(item1)" value="@bind(item1)" />
															</template>
														</combobox>
													</listcell>

												</listitem>
											</template>
										</listbox>

									</tabpanel>
									<tabpanel>
										<listbox id="foreings"
											height="550px" model="@load(vm.foreings)"
											 sizedByContent="true">
											<listhead>
												<listheader
													label="${labels.EntityMaster.entity}" width="150px" />
												<listheader
													label="${labels.EntityMaster.alias}" width="150px" />
											</listhead>
											<template name="model"
												var="item" status="s">
												<listitem>
													<listcell>
														<label
															value="@load(item.fkentitynamedb)">
														</label>
													</listcell>
													<listcell>
														<label
															value="@load(item.alias)">
														</label>
													</listcell>
												</listitem>
											</template>
										</listbox>

									</tabpanel>
									<tabpanel>
									
										<listbox 
											height="550px" model="@load(vm.entity.descendens)"
											 sizedByContent="true">
											<listhead>
												<listheader
													label="${labels.EntityMaster.entity}" width="150px" />
												<listheader
													label="${labels.EntityMaster.alias}" width="150px" />
											</listhead>
											<template name="model"
												var="item" status="s">
												<listitem>
													<listcell>
														<label
															value="@load(item.fktablename)">
														</label>
													</listcell>
													<listcell>
														<label
															value="@load(item.coname)">
														</label>
													</listcell>
												</listitem>
											</template>
										</listbox>

									</tabpanel>
								</tabpanels>
							</tabbox>
							</div>
						</div>
					</h:div>

				</div>
			</div>
			<div class="card-footer">
				<button zclass="pull-left"
					sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
					onClick="@command('back')"
					iconSclass="fa-duotone fa-solid fa-arrow-left align-middle rounded-pill fs-16 me-2"
					label="Anterior" />

				<button zclass="pull-right"
					sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
					iconSclass="fa-duotone fa-solid fa-arrow-right align-middle rounded-pill fs-16 me-2"
					onClick="@command('evalScreens')" label="Siguiente" />

			</div>

		</h:div>

	</div>
</zk>