<zk xmlns:h="native">
	<div class="row">
		<h:div class="card col-lg-12">
			<div class="card-body">
				<div class="row">
					<h:div class="card col-lg-5">
						<div class="card">
							<div
								class="card-header header-elements-inline bg-indigo">
								<h:h6 class="card-title">
									Campos disponibles para la consulta
								</h:h6>
							</div>
							<div class="card-body">
								<listbox model="@load(vm.atts)"
									height="500px" pagingPosition="top" autopaging="true"
									mold="paging">
									<listhead>
										<listheader label="Field"></listheader>
										<listheader label="Tabla"></listheader>
										<listheader label="Foreing"></listheader>
										<listheader label="Tipo"></listheader>
									</listhead>
									<template name="model" var="item"
										varStatus="status">
										<listitem value="${item}">
											<listcell
												label="${item.atribute}">
											</listcell>
											<listcell
												label="${item.entitynamedb}">
											</listcell>
											<listcell
												label="${item.aliases}">
											</listcell>
											<listcell
												label="${item.typefield}">
											</listcell>
										</listitem>
									</template>
								</listbox>
							</div>

						</div>
					</h:div>
					<h:div class="card col-lg-5">
						<hbox spacing="3px" sclass="margin-field">
							<label
								sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
								style="" value="¿Qué Consulta deseas crear?" />
						</hbox>
						<tabbox id="tbbox" mold="accordion">
							<tabs>
								<tab id="natural" label="Instruccion Natural" />
								<tab id="sql" label="SQL Query" />
							</tabs>
							<tabpanels>
								<tabpanel>
									<textbox tabindex="1"
										value="@bind(vm.evalText)"
										sclass="margin-field form-control  form-control " width="98%"
										multiline="true" rows="20"
										placeholder="Escribe una consulta SQL que calcule el valor total de todos los pedidos del 01/04/2023.">
									</textbox>

								</tabpanel>
								<tabpanel>
									<div class="form-group row ">
										<textbox id="message"
											tabindex="1" value="@bind(vm.message)"
											sclass="margin-field form-control  form-control "
											multiline="true" rows="20" width="98%">
										</textbox>

									</div>
								</tabpanel>
							</tabpanels>
						</tabbox>


					</h:div>
					<h:div class="card col-lg-2">
						<div class="form-group row ">
						<h:div class="col-md-12">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="Incluir solo código de ejemplo" />
								</hbox>
								<checkbox
									checked="@bind(vm.sinComentarios)"
									value="@bind(vm.sinComentarios)" />

							</h:div>
							<h:div class="col-md-12">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="Núm. Max. Tokens" />
								</hbox>


								<slider maxpos="5000" minpos="100"
									scaleInput="50" curpos="@bind(vm.tokens)" />
							</h:div>
							<h:div class="col-md-12">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="Total tokens" />
								</hbox>
								<intbox tabindex="1"
									value="@bind(vm.tokensRes)"
									sclass="margin-field form-control  form-control "
									width="40%">
								</intbox>
								<space></space>
								<button tooltiptext="Evaluar"
									iconSclass="mdi mdi-motion-play-outline label-icon align-middle fs-16 me-2"
									onClick="@command('evalCode' ,tab=tbbox)"
									sclass="btn btn-label btn-secondary waves-effect waves-light">
									Evaluar Instrucción
								</button>
							</h:div>
						</div>

					</h:div>
				</div>
			</div>
			<div class="card-footer">
				<button zclass="pull-left"
					sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
					onClick="@command('back')"
					iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
					label="Anterior" />

				<button zclass="pull-right"
					sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
					iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
					onClick="@command('evalSQL')" label="Siguiente" />

			</div>

		</h:div>

	</div>
</zk>