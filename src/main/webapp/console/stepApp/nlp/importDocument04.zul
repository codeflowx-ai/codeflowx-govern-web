<zk xmlns:h="native">

	<div class="row s-bot">
		<h:div class="col-lg-12 ">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div
							class="col-12 col-md-6 col-lg-6 full-height">
							<div class="chatbot-body">
								<div class="chatbot">
									<div
										class="chatbot-header justify-content-center">
										<h:h5>
											Seleccionar Arquitectura
										</h:h5>
									</div>
									<div class="chatbot-body">
										<div
											class="row element-input">
											<div
												class="input-group-flex ">
												<div class="col">
													<h:label
														for="prompt tokens">
														Arquitectura
													</h:label>

												</div>
												<div class="col">
													<combobox>
														<comboitem
															label="" />
														<comboitem
															label="" />
													</combobox>
												</div>
											</div>
											<div
												class="input-group-flex ">
												<div class="col">
													<h:label
														for="prompt tokens">
														Base de Datos
													</h:label>

												</div>
												<div class="col">
													<combobox>
														<comboitem
															label="" />
														<comboitem
															label="" />
													</combobox>
												</div>
											</div>
											<div
												class="input-group-flex ">
												<div class="col">
													<h:label
														for="prompt tokens">
														Repositorio Git
													</h:label>

												</div>
												<div class="col">
													<combobox>
														<comboitem
															label="" />
														<comboitem
															label="" />
													</combobox>

												</div>
											</div>
											<div
												class="input-group-flex ">
												<div class="col">
													<h:label
														for="completion tokens">
														Cluster
														Kubernetes
													</h:label>

												</div>
												<div class="col">
													<combobox>
														<comboitem
															label="" />
														<comboitem
															label="" />
													</combobox>

												</div>
											</div>

											<div
												class="input-group-flex ">
												<div class="col">
													<h:label
														for="Nombre del modulo">
														Nombre del
														modulo
													</h:label>

												</div>
												<div class="col">
													<textbox
														class="form-control" />
												</div>
											</div>
											<div
												class="input-group-flex">
												<div class="col">
													<h:label
														for="acronimo">
														Acronimo
													</h:label>
												</div>
												<div class="col">
													<textbox
														class="form-control" />
												</div>
											</div>



										</div>
										<div
											class="d-flex align-items-center flex-wrap gap-2">

											<div
												class="flex-shrink-0 w-100">

												<div
													class="hstack text-nowrap w-100 gap-2">

												</div>
											</div>
										</div>
										<div
											class="d-flex align-items-center flex-wrap gap-2">
											<div class="flex-grow-1">


											</div>
										</div>


									</div>
								</div>
							</div>



						</div>


						<div class="col-12 col-md-4 col-lg-4">



						</div>


					</div>
				</div>
				<div class="card-footer">
					<button zclass="pull-left"
						sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
						onClick="@command('back')"
						iconSclass="fa-duotone fa-solid fa-arrow-left align-middle rounded-pill fs-16 me-2"
						label="Anterior" />
					<button zclass="pull-right"
						sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
						iconSclass="fa-duotone fa-solid fa-arrow-right align-middle rounded-pill fs-16 me-2"
						onClick="@command('nextTables',form=fx)" label="Siguiente" />

				</div>
			</div>
		</h:div>

	</div>
</zk>