<zk xmlns:h="native">
	<div class="row s-bot">
		<h:div class="card col-lg-12">
			<div class="card-body"> 
				<div class="row card-brd">
					<h:div class="col-lg-2">
						<div class="card">
							<div
								class="card-header header-elements-inline bg-indigo">
								<h:h6 class="card-title">
									Pantallas
								</h:h6>
							</div>
							<div class="card-body">
								<listbox model="@load(vm.pantallas)"
									 onSelect="@command('selectView' , item=self.selectedItem.value,vista=previa)"
									 sclass="scrollable-barra">
									<listhead>
										<listheader
											label="Name Screen">
										</listheader>
									</listhead>
									<template name="model" var="item">
										<listitem  label="${item}" value="${item}">
											
										</listitem>

									</template>
								</listbox>
							</div>

						</div>
					</h:div>
					
					
					<h:div class="col-lg-10">
						
					    <div id="previa" class="card col-lg-12"></div> 	


					</h:div>
					
				</div>
			</div>
			<div class="card-footer">
				<button zclass="pull-left"
					sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
					onClick="@command('back')"
					iconSclass="fa-duotone fa-solid fa-arrow-left align-middle rounded-pill fs-16 me-2"
					label="Anterior" />

				<button zclass="pull-right"
					sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
					iconSclass="fa-duotone fa-solid fa-arrow-right align-middle rounded-pill fs-16 me-2"
					onClick="@command('evalChart')" label="Siguiente" />

			</div>

		</h:div>

	</div>
</zk>