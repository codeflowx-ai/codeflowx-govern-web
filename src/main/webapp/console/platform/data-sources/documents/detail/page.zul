<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

	<idspace id="documentDetail"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.datasources.DataSourceDocumentViewModel')"
		validationMessages="@id('vmsgs')">

		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-file label-icon align-middle fs-16 me-2"></h:i>
						<label value="Gestión de Documentos" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Subir y gestionar documentos de fuentes de datos" />
					</h:p>
				</h:div>
			</h:div>

			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<h:h5 class="mb-0">
									<label value="Subir Documentos" />
								</h:h5>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light btn btn-sm btn-primary"
										onClick="@command('selectFiles')"
										tooltiptext="Seleccionar Archivos">
										<h:i class="fa-duotone fa-solid fa-upload me-1"></h:i>
										<label value="Seleccionar" />
									</a>
									<a class="waves-effect waves-light btn btn-sm btn-success"
										onClick="@command('processUpload')"
										tooltiptext="Procesar">
										<h:i class="fa-duotone fa-solid fa-play me-1"></h:i>
										<label value="Procesar" />
									</a>
									<a class="waves-effect waves-light btn btn-sm btn-secondary"
										onClick="@command('refreshDocuments')"
										tooltiptext="Refrescar">
										<h:i class="fa-duotone fa-solid fa-arrows-rotate me-1"></h:i>
										<label value="Refrescar" />
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div>

					<h:div class="card-body">
						<h:div class="row">
							<h:div class="col-lg-12">
								<h:div class="card default shadow-sm mb-3">
									<h:div class="card-header bg-light">
										<h:h5 class="mb-0">
											<h:i class="fa-duotone fa-solid fa-list me-2"></h:i>
											<label value="Documentos Subidos" />
										</h:h5>
									</h:div>
									<h:div class="card-body">
										<grid model="@load(vm.documentsList)" style="overflow:auto;">
											<columns sizable="true">
												<column label="Nombre" width="30%" />
												<column label="Tipo" width="10%" />
												<column label="Tamaño" width="10%" />
												<column label="Estado" width="15%" />
												<column label="Subido" width="15%" />
												<column label="Acciones" width="20%" align="center" />
											</columns>
											<template name="model" var="doc">
												<row>
													<label value="@load(doc.docname)" />
													<label value="@load(doc.doctype)" sclass="badge bg-info" />
													<label value="@load(doc.docfilesize) @converter('vm.formatFileSize')" />
													<label value="@load(doc.docstatus)"
														sclass="badge ${doc.docstatus eq 'PROCESSED' ? 'bg-success' : (doc.docstatus eq 'PROCESSING' ? 'bg-warning' : (doc.docstatus eq 'ERROR' ? 'bg-danger' : 'bg-info'))}" />
													<label value="@load(doc.docuploadedat) @converter('vm.formatDate')" />
													<cell align="center" class="d-flex">
														<a onClick="@command('viewDocument', doc=doc)"
															iconSclass="fa-duotone fa-solid fa-eye fs-2x"
															sclass="waves-effect waves-info me-2"
															tooltiptext="Ver" />
														<a onClick="@command('reprocessDocument', doc=doc)"
															iconSclass="fa-duotone fa-solid fa-rotate fs-2x"
															sclass="waves-effect waves-warning me-2"
															tooltiptext="Reprocesar" />
														<a onClick="@command('deleteDocument', doc=doc)"
															iconSclass="fa-light fa-nfc-trash fa-xl"
															sclass="waves-effect waves-danger"
															tooltiptext="Eliminar" />
													</cell>
												</row>
											</template>
											<foot>
												<footer span="3" align="right">
													<paging id="topagin"
														pageSize="@load(vm.pageParams.maxRows)"
														totalSize="@load(vm.pageResult.totalRows)"
														activePage="@load(vm.pageParams.pageActual - 1)"
														onPaging="@command('loadDocuments')"
														mold="os" width="100%" />
												</footer>
											</foot>
										</grid>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
		</h:div>
	</idspace>
</zk>
