<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

	<idspace id="databaseDetail"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.datasources.DataSourceDatabaseViewModel')"
		validationMessages="@id('vmsgs')">

		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-database label-icon align-middle fs-16 me-2"></h:i>
						<label value="Gestión de Bases de Datos" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Configurar conexiones a bases de datos" />
					</h:p>
				</h:div>
			</h:div>

			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<h:h5 class="mb-0">
									<label value="Nueva Base de Datos" />
								</h:h5>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light btn btn-sm btn-primary"
										onClick="@command('createDatabaseDataSource')"
										tooltiptext="Nueva Base de Datos">
										<h:i class="fa-duotone fa-solid fa-plus me-1"></h:i>
										<label value="Nueva" />
									</a>
									<a class="waves-effect waves-light btn btn-sm btn-success"
										onClick="@command('saveDatabaseDataSource')"
										tooltiptext="Guardar">
										<h:i class="fa-duotone fa-solid fa-save me-1"></h:i>
										<label value="Guardar" />
									</a>
									<a class="waves-effect waves-light btn btn-sm btn-info"
										onClick="@command('testDbConnection')"
										tooltiptext="Probar Conexión">
										<h:i class="fa-duotone fa-solid fa-vial me-1"></h:i>
										<label value="Probar" />
									</a>
									<a class="waves-effect waves-light btn btn-sm btn-secondary"
										onClick="@command('cancelDbConfig')"
										tooltiptext="Cancelar">
										<h:i class="fa-duotone fa-solid fa-times me-1"></h:i>
										<label value="Cancelar" />
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div>

					<h:div class="card-body">
						<h:div class="row">
							<h:div class="col-lg-8">
								<h:div class="card default shadow-sm mb-3">
									<h:div class="card-header bg-light">
										<h:h5 class="mb-0">
											<h:i class="fa-duotone fa-solid fa-info-circle me-2"></h:i>
											<label value="Configuración de Base de Datos" />
										</h:h5>
									</h:div>
									<h:div class="card-body">
										<h:div class="row mb-3">
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Nombre *" /></h:label>
												<textbox value="@bind(vm.dbName)" class="form-control" />
											</h:div>
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Tipo" /></h:label>
												<combobox value="@bind(vm.dbType)" class="form-control">
													<comboitem label="MySQL" value="MYSQL" />
													<comboitem label="PostgreSQL" value="POSTGRESQL" />
													<comboitem label="Oracle" value="ORACLE" />
													<comboitem label="SQL Server" value="SQLSERVER" />
												</combobox>
											</h:div>
										</h:div>
										<h:div class="row mb-3">
											<h:div class="col-md-12">
												<h:label class="form-label"><label value="Descripción" /></h:label>
												<textbox value="@bind(vm.dbDescription)" class="form-control" multiline="true" rows="2" />
											</h:div>
										</h:div>
										<h:div class="row mb-3">
											<h:div class="col-md-8">
												<h:label class="form-label"><label value="Host *" /></h:label>
												<textbox value="@bind(vm.dbHost)" class="form-control" />
											</h:div>
											<h:div class="col-md-4">
												<h:label class="form-label"><label value="Puerto *" /></h:label>
												<intbox value="@bind(vm.dbPort)" class="form-control" />
											</h:div>
										</h:div>
										<h:div class="row mb-3">
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Usuario" /></h:label>
												<textbox value="@bind(vm.dbUsername)" class="form-control" />
											</h:div>
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Contraseña" /></h:label>
												<textbox value="@bind(vm.dbPassword)" type="password" class="form-control" />
											</h:div>
										</h:div>
										<h:div class="row mb-3">
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Schema" /></h:label>
												<textbox value="@bind(vm.dbSchema)" class="form-control" />
											</h:div>
											<h:div class="col-md-6">
												<h:label class="form-label"><label value="Estado" /></h:label>
												<combobox value="@bind(vm.dbStatus)" class="form-control">
													<comboitem label="ACTIVE" value="ACTIVE" />
													<comboitem label="INACTIVE" value="INACTIVE" />
													<comboitem label="ERROR" value="ERROR" />
												</combobox>
											</h:div>
										</h:div>
										<h:div class="row mb-3">
											<h:div class="col-md-12">
												<h:label class="form-label"><label value="Connection String" /></h:label>
												<textbox value="@bind(vm.dbConnectionString)" class="form-control" />
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>
							<h:div class="col-lg-4">
								<h:div class="card default shadow-sm">
									<h:div class="card-header bg-light">
										<h:h5 class="mb-0">
											<h:i class="fa-duotone fa-solid fa-list me-2"></h:i>
											<label value="Bases de Datos Configuradas" />
										</h:h5>
									</h:div>
									<h:div class="card-body">
										<grid model="@load(vm.dbSourcesList)" style="overflow:auto; max-height: 500px;">
											<columns>
												<column label="Nombre" width="100%" />
											</columns>
											<template name="model" var="db">
												<row onClick="@command('editDbSource', db=db)" style="cursor:pointer;">
													<label value="@load(db.dbname)" />
												</row>
											</template>
										</grid>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
		</h:div>
	</idspace>
</zk>
