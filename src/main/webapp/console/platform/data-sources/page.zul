<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <vlayout vflex="1" apply="org.zkoss.bind.BindComposer"
        viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.datasources.DataSourceOverviewViewModel')">
        
        <!-- Header -->
        <hlayout sclass="page-header">
            <vlayout hflex="1">
                <label value="Data Sources" sclass="page-title"/>
                <label value="Gestión centralizada de fuentes de datos" sclass="page-subtitle"/>
            </vlayout>
            <button label="Nueva Fuente de Datos" iconSclass="z-icon-plus" 
                    onClick="@command('showCreateDialog')" sclass="btn btn-primary"/>
        </hlayout>

        <!-- Statistics Cards -->
        <hlayout spacing="20px" sclass="mb-4">
            <vlayout sclass="stat-card" hflex="1">
                <label value="@load(vm.totalDataSources)" sclass="stat-value"/>
                <label value="Total de Fuentes" sclass="stat-label"/>
            </vlayout>
            <vlayout sclass="stat-card stat-card-success" hflex="1">
                <label value="@load(vm.activeDataSources)" sclass="stat-value"/>
                <label value="Activas" sclass="stat-label"/>
            </vlayout>
            <vlayout sclass="stat-card stat-card-warning" hflex="1">
                <label value="@load(vm.syncingDataSources)" sclass="stat-value"/>
                <label value="En Sincronización" sclass="stat-label"/>
            </vlayout>
            <vlayout sclass="stat-card stat-card-danger" hflex="1">
                <label value="@load(vm.errorDataSources)" sclass="stat-value"/>
                <label value="Con Errores" sclass="stat-label"/>
            </vlayout>
        </hlayout>

        <!-- Filters -->
        <hlayout spacing="10px" sclass="mb-3">
            <textbox placeholder="Buscar por nombre..." value="@bind(vm.searchTerm)" 
                     instant="true" sclass="form-control" style="width: 300px;"/>
            <combobox placeholder="Tipo" selectedItem="@bind(vm.filterType)" 
                      model="@load(vm.availableTypes)" sclass="form-control" style="width: 200px;">
                <template name="model">
                    <comboitem label="@load(each)"/>
                </template>
            </combobox>
            <combobox placeholder="Estado" selectedItem="@bind(vm.filterStatus)" 
                      model="@load(vm.availableStatuses)" sclass="form-control" style="width: 200px;">
                <template name="model">
                    <comboitem label="@load(each)"/>
                </template>
            </combobox>
            <button label="Limpiar Filtros" onClick="@command('clearFilters')" sclass="btn btn-secondary"/>
        </hlayout>

        <!-- Data Sources Grid -->
        <grid model="@load(vm.dataSourcesList)" emptyMessage="No hay fuentes de datos" vflex="1">
            <columns>
                <column label="Nombre" sort="auto(dsname)" hflex="2"/>
                <column label="Tipo" sort="auto(dstype)" hflex="1"/>
                <column label="Estado" sort="auto(dsstatus)" hflex="1"/>
                <column label="Última Sync" sort="auto(dslastsyncat)" hflex="1"/>
                <column label="Documentos" sort="auto(dsdocumentcount)" hflex="1"/>
                <column label="Acciones" width="200px" align="center"/>
            </columns>
            <template name="model">
                <row>
                    <label value="@load(each.dsname)" sclass="fw-bold"/>
                    <label value="@load(each.dstype)">
                        <attribute name="sclass">
                            badge 
                            @load(each.dstype eq 'API' ? 'badge-info' : 
                                 each.dstype eq 'DATABASE' ? 'badge-primary' : 
                                 each.dstype eq 'UPLOAD_DOCUMENTS' ? 'badge-success' : 'badge-warning')
                        </attribute>
                    </label>
                    <label value="@load(each.dsstatus)">
                        <attribute name="sclass">
                            badge 
                            @load(each.dsstatus eq 'ACTIVE' ? 'badge-success' : 
                                 each.dsstatus eq 'SYNCING' ? 'badge-warning' : 
                                 each.dsstatus eq 'INACTIVE' ? 'badge-secondary' : 'badge-danger')
                        </attribute>
                    </label>
                    <label value="@load(each.dslastsyncat) @converter('formatedDate', format='dd/MM/yyyy HH:mm')"/>
                    <label value="@load(each.dsdocumentcount)"/>
                    <hlayout spacing="5px">
                        <button iconSclass="z-icon-eye" tooltiptext="Ver Detalles" 
                                onClick="@command('viewDetails', item=each)" sclass="btn btn-sm btn-info"/>
                        <button iconSclass="z-icon-edit" tooltiptext="Editar" 
                                onClick="@command('editDataSource', item=each)" sclass="btn btn-sm btn-primary"/>
                        <button iconSclass="z-icon-sync" tooltiptext="Sincronizar" 
                                onClick="@command('syncDataSource', item=each)" sclass="btn btn-sm btn-success"/>
                        <button iconSclass="z-icon-trash" tooltiptext="Eliminar" 
                                onClick="@command('deleteItem', item=each)" sclass="btn btn-sm btn-danger"/>
                    </hlayout>
                </row>
            </template>
        </grid>

        <!-- Pagination -->
        <paging pageSize="@load(vm.pageSize)" totalSize="@load(vm.totalSize)" 
                activePage="@bind(vm.activePage)" onPaging="@command('changePage')"/>

    </vlayout>
</zk>

