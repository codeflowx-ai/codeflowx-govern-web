<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="dashboard"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.dashboard.TokenMetricsDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Token Metrics" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveTokenMetrics')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Dshtokentype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtokentype *" />
														<combobox tabindex="2" id="dshtokentype"
															selectedItem="@bind(vm.currentTokenMetrics.dshtokentype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['dshtokentype'])" />
													</div>
												</div>
											</div>											<!-- Dshtotaltokens -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtotaltokens *" />
														<textbox tabindex="3" id="dshtotaltokens"
															value="@bind(vm.currentTokenMetrics.dshtotaltokens)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshtotaltokens'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshtokenstoday -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtokenstoday" />
														<textbox tabindex="4" id="dshtokenstoday"
															value="@bind(vm.currentTokenMetrics.dshtokenstoday)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshtokenstoday'])" />
													</div>
												</div>
											</div>											<!-- Dshtokensweek -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtokensweek" />
														<textbox tabindex="5" id="dshtokensweek"
															value="@bind(vm.currentTokenMetrics.dshtokensweek)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshtokensweek'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshtokensmonth -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtokensmonth" />
														<textbox tabindex="6" id="dshtokensmonth"
															value="@bind(vm.currentTokenMetrics.dshtokensmonth)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshtokensmonth'])" />
													</div>
												</div>
											</div>											<!-- Dshavgtokensrequest -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshavgtokensrequest" />
														<textbox tabindex="7" id="dshavgtokensrequest"
															value="@bind(vm.currentTokenMetrics.dshavgtokensrequest)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshavgtokensrequest'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshcostper1k -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcostper1k" />
														<textbox tabindex="8" id="dshcostper1k"
															value="@bind(vm.currentTokenMetrics.dshcostper1k)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshcostper1k'])" />
													</div>
												</div>
											</div>											<!-- Dshtotalcost -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtotalcost" />
														<textbox tabindex="9" id="dshtotalcost"
															value="@bind(vm.currentTokenMetrics.dshtotalcost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshtotalcost'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshcurrency -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcurrency" />
														<textbox tabindex="10" id="dshcurrency"
															value="@bind(vm.currentTokenMetrics.dshcurrency)"
															maxlength="10"
															constraint="max 10" />
														<label sclass="text-danger" value="@load(vmsgs['dshcurrency'])" />
													</div>
												</div>
											</div>											<!-- Dshmodelname -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshmodelname" />
														<textbox tabindex="11" id="dshmodelname"
															value="@bind(vm.currentTokenMetrics.dshmodelname) @save(vm.currentTokenMetrics.dshmodelname, before=('saveItem')) @validator(vm.unique, field='DSHMODELNAME', required=false, oldValue=vm.originalDshmodelname)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['dshmodelname'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshprovider -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshprovider" />
														<textbox tabindex="12" id="dshprovider"
															value="@bind(vm.currentTokenMetrics.dshprovider)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['dshprovider'])" />
													</div>
												</div>
											</div>											<!-- Dshtrend -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtrend" />
														<textbox tabindex="13" id="dshtrend"
															value="@bind(vm.currentTokenMetrics.dshtrend)"
															maxlength="20"
															constraint="max 20" />
														<label sclass="text-danger" value="@load(vmsgs['dshtrend'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshchangepercentage -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshchangepercentage" />
														<textbox tabindex="14" id="dshchangepercentage"
															value="@bind(vm.currentTokenMetrics.dshchangepercentage)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshchangepercentage'])" />
													</div>
												</div>
											</div>											<!-- Dshperiod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshperiod" />
														<combobox tabindex="15" id="dshperiod"
															selectedItem="@bind(vm.currentTokenMetrics.dshperiod)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['dshperiod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshperiodstart -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshperiodstart" />
														<textbox tabindex="16" id="dshperiodstart"
															value="@bind(vm.currentTokenMetrics.dshperiodstart)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshperiodstart'])" />
													</div>
												</div>
											</div>											<!-- Dshperiodend -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshperiodend" />
														<textbox tabindex="17" id="dshperiodend"
															value="@bind(vm.currentTokenMetrics.dshperiodend)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshperiodend'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Dshmeasurementdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshmeasurementdate *" />
														<textbox tabindex="18" id="dshmeasurementdate"
															value="@bind(vm.currentTokenMetrics.dshmeasurementdate)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshmeasurementdate'])" />
													</div>
												</div>
											</div>											<!-- Dshcreatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcreatedat *" />
														<textbox tabindex="19" id="dshcreatedat"
															value="@bind(vm.currentTokenMetrics.dshcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>