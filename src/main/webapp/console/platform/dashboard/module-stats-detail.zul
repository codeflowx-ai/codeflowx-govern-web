<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="dashboard"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.dashboard.ModuleStatsDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Module Stats" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Dshmodulename -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshmodulename *" />
														<textbox tabindex="2" id="dshmodulename"
															value="@bind(vm.currentModuleStats.dshmodulename) @save(vm.currentModuleStats.dshmodulename, before=('saveItem')) @validator(vm.unique, field='DSHMODULENAME', required=true, oldValue=vm.originalDshmodulename)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['dshmodulename'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dshtotalitems -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshtotalitems *" />
														<textbox tabindex="3" id="dshtotalitems"
															value="@bind(vm.currentModuleStats.dshtotalitems)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshtotalitems'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dshactiveitems -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshactiveitems *" />
														<textbox tabindex="4" id="dshactiveitems"
															value="@bind(vm.currentModuleStats.dshactiveitems)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshactiveitems'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dshpendingitems -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshpendingitems *" />
														<textbox tabindex="5" id="dshpendingitems"
															value="@bind(vm.currentModuleStats.dshpendingitems)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshpendingitems'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dshcompleteditems -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcompleteditems *" />
														<textbox tabindex="6" id="dshcompleteditems"
															value="@bind(vm.currentModuleStats.dshcompleteditems)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshcompleteditems'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dshsuccessrate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshsuccessrate" />
														<textbox tabindex="7" id="dshsuccessrate"
															value="@bind(vm.currentModuleStats.dshsuccessrate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshsuccessrate'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dshavgscore -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshavgscore" />
														<textbox tabindex="8" id="dshavgscore"
															value="@bind(vm.currentModuleStats.dshavgscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshavgscore'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dshactivealerts -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshactivealerts" />
														<textbox tabindex="9" id="dshactivealerts"
															value="@bind(vm.currentModuleStats.dshactivealerts)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshactivealerts'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dshcustommetrics -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcustommetrics" />
														<textbox tabindex="10" id="dshcustommetrics"
															value="@bind(vm.currentModuleStats.dshcustommetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['dshcustommetrics'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dshcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshcreatedat *" />
														<textbox tabindex="11" id="dshcreatedat"
															value="@bind(vm.currentModuleStats.dshcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dshupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dshupdatedat *" />
														<textbox tabindex="12" id="dshupdatedat"
															value="@bind(vm.currentModuleStats.dshupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['dshupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>