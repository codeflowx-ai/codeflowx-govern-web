<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.dashboard.DistributionOverviewViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row" style="background-color:;">
			<div><!-- Titulo pantalla -->
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-cube me-2"></h:i>
						<label value="Distribution" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión de Distribution" />
					</h:p>
				</div>
			</div>
			<div class="col-lg-12 s-bot ">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1"></div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a
										iconSclass="fa-duotone fa-solid fa-plus label-icon align-middle fs-16 me-2"
										class="waves-effect waves-light"
										onClick="@command('registerDistribution')"
										label="Registrar Distribution">
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!--end col-->
			</div>
			<div class="col-lg-12 s-bot ">
				<!-- Métricas Resumen -->
				<h:div class="row g-3 mb-4">
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total</p>
								<h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent="@load(vm.total{entity.class_name}s)"></h2>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <p class="mb-2" style="font-size: 14px; opacity: 0.9;">Activos</p>
								<h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent="@load(vm.active{entity.class_name}s)"></h2>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <p class="mb-2" style="font-size: 14px; opacity: 0.9;">Pendientes</p>
								<h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent="@load(vm.pending{entity.class_name}s)"></h2>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <p class="mb-2" style="font-size: 14px; opacity: 0.9;">Inactivos</p>
								<h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent="@load(vm.inactive{entity.class_name}s)"></h2>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</div>
			<div class="section filters">
				<div class="search-bar">
					<!-- Búsqueda por texto -->
					<textbox value="@bind(vm.searchTerm)"
						placeholder="Buscar..."
						class="form-control" onOK="@command('applyFilters')" />
				</div>
				<div class="filter-icons">
					<a tooltiptext="Buscar"
						iconSclass="fa-duotone fa-magnifying-glass-waveform"
						onClick="@command('applyFilters')" />
					<a tooltiptext="Limpiar"
						iconSclass="fa-duotone fa-broom-wide"
						onClick="@command('clearFilters')" />
				</div>
			</div>
			<div class="col-xxl-12 s-bot">
				<div class="card">
					<div class="card-body">
						<div id="divTemplate" sclass="col-lg-12">
							<!-- listado -->
							<grid model="@load(vm.filteredItems)"
								style="overflow:auto;">
								<columns sizable="true"
									columnsgroup="false" columnshide="false">
									<column
										label="ID" align="center"
										sort="auto" width="5%" />

									<column sclass=" text-capitalize "
										label="Dshmodulename" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Dshcategory" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Dshlabel" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Dshvalue" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Dshpercentage" align="center"
										width="15%" />

									<column
										label="Acciones"
										align="center" />
								</columns>

								<template name="model" var="dashboard">
									<row
										style="text-align:right;cursor:pointer;"
										onClick="@command('viewDistributionDetails', dashboardId=dashboard.idxdistribution)">
										<label
											value="@load(dashboard.idxdistribution) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(dashboard.dshmodulename) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(dashboard.dshcategory) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(dashboard.dshlabel) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(dashboard.dshvalue) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(dashboard.dshpercentage) @converter(vm.fieldConverter)">
										</label>
										<cell align="center"
											class="d-flex">
											<div class="edit">
												<a
													onClick="@command('viewDistributionDetails', dashboardId=dashboard.idxdistribution)"
													iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"
													tooltiptext="Ver detalles" />
											</div>
											<div class="delete">
												<a
													onClick="@command('deleteDistribution', dashboardId=dashboard.idxdistribution)"
													iconSclass="fa-light fa-nfc-trash fa-xl"
													sclass="waves-effect waves-danger"
													tooltiptext="Eliminar" />
											</div>
										</cell>
									</row>
								</template>
								<foot>
									<footer span="3" align="right">
										<paging id="topagin"
											pageSize="@load(vm.pageParams.maxRows)" 
											totalSize="@load(vm.pageResult.totalRows)"
											activePage="@load(vm.pageParams.pageActual - 1)"
											onPaging="@command('onPaging', event=event)"
											mold="os" width="100%" />
									</footer>
									<footer span="4" align="left"></footer>
									<footer></footer>
								</foot>
							</grid>
						</div>
					</div>
				</div>
			</div>
		</div><!--end col-->
	</idspace>
</zk>