															value="@bind(vm.currentProjectCostEstimator.prjcostbreakdown)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjcostbreakdown'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Model Breakdown -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Model Breakdown" />
														<textbox tabindex="38" id="prjmodelbreakdown"
															value="@bind(vm.currentProjectCostEstimator.prjmodelbreakdown)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjmodelbreakdown'])" />
													</div>
												</div>
											</div>											<!-- Agent Breakdown -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Agent Breakdown" />
														<textbox tabindex="39" id="prjagentbreakdown"
															value="@bind(vm.currentProjectCostEstimator.prjagentbreakdown)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjagentbreakdown'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Notes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Notes" />
														<textbox tabindex="40" id="prjnotes"
															value="@bind(vm.currentProjectCostEstimator.prjnotes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjnotes'])" />
													</div>
												</div>
											</div>											<!-- Justification -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Justification" />
														<textbox tabindex="41" id="prjjustification"
															value="@bind(vm.currentProjectCostEstimator.prjjustification)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjjustification'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Includes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Includes" />
														<textbox tabindex="42" id="prjincludes"
															value="@bind(vm.currentProjectCostEstimator.prjincludes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjincludes'])" />
													</div>
												</div>
											</div>											<!-- Excludes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Excludes" />
														<textbox tabindex="43" id="prjexcludes"
															value="@bind(vm.currentProjectCostEstimator.prjexcludes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjexcludes'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="44" id="prjcreatedby"
															value="@bind(vm.currentProjectCostEstimator.prjcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['prjcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="45" id="prjupdatedby"
															value="@bind(vm.currentProjectCostEstimator.prjupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['prjupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Approvedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedby" />
														<textbox tabindex="46" id="prjapprovedby"
															value="@bind(vm.currentProjectCostEstimator.prjapprovedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['prjapprovedby'])" />
													</div>
												</div>
											</div>											<!-- Approvedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedat" />
														<textbox tabindex="47" id="prjapprovedat"
															value="@bind(vm.currentProjectCostEstimator.prjapprovedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjapprovedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="48" id="prjcreatedat"
															value="@bind(vm.currentProjectCostEstimator.prjcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['prjcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="49" id="prjupdatedat"
															value="@bind(vm.currentProjectCostEstimator.prjupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subprjbillingdetails -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subprjbillingdetails" />
														<textbox tabindex="50" id="subprjbillingdetails"
															value="@bind(vm.currentProjectCostEstimator.subprjbillingdetails)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subprjbillingdetails'])" />
													</div>
												</div>
											</div>											<!-- Subprjinvoices -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subprjinvoices" />
														<textbox tabindex="51" id="subprjinvoices"
															value="@bind(vm.currentProjectCostEstimator.subprjinvoices)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subprjinvoices'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Subprjbillingdetails" onSelect="@command('onSelectProjectBillingDetailTab')" />
												<tab label="Subprjinvoices" onSelect="@command('onSelectProjectInvoiceTab')" />
											</tabs>
											<tabpanels>
												<!-- Panel: Subprjbillingdetails -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subprjbillingdetails"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalProjectBillingDetails)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subprjbillingdetails)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subprjbillingdetails)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subprjbillingdetails registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Subprjinvoices -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subprjinvoices"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalProjectInvoices)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subprjinvoices)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subprjinvoices)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subprjinvoices registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>