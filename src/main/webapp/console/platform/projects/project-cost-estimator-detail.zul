													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Isoverbudget" />
														<textbox tabindex="35" id="prjisoverbudget"
															value="@bind(vm.currentProjectCostEstimator.prjisoverbudget)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjisoverbudget'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Budgetutilization -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Budgetutilization" />
														<textbox tabindex="36" id="prjbudgetutilization"
															value="@bind(vm.currentProjectCostEstimator.prjbudgetutilization)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjbudgetutilization'])" />
													</div>
												</div>
											</div>											<!-- Costbreakdown -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
