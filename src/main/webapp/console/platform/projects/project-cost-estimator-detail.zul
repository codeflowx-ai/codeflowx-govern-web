															value="@bind(vm.currentProjectCostEstimator.prjbudgetalertthreshold)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjbudgetalertthreshold'])" />
													</div>
												</div>
											</div>											<!-- Isoverbudget -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
