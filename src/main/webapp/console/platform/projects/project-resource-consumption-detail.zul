<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="projects"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.projects.ProjectResourceConsumptionDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-folder-open label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Project Resource Consumption" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Projectid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Projectid *" />
														<textbox tabindex="2" id="prjprojectid"
															value="@bind(vm.currentProjectResourceConsumption.prjprojectid)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['prjprojectid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Consumptiondate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Consumptiondate *" />
														<textbox tabindex="3" id="prjconsumptiondate"
															value="@bind(vm.currentProjectResourceConsumption.prjconsumptiondate)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['prjconsumptiondate'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resourcetype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resourcetype *" />
														<combobox tabindex="4" id="prjresourcetype"
															selectedItem="@bind(vm.currentProjectResourceConsumption.prjresourcetype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['prjresourcetype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Inputtokens -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Inputtokens" />
														<textbox tabindex="5" id="prjinputtokens"
															value="@bind(vm.currentProjectResourceConsumption.prjinputtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjinputtokens'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Outputtokens -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Outputtokens" />
														<textbox tabindex="6" id="prjoutputtokens"
															value="@bind(vm.currentProjectResourceConsumption.prjoutputtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjoutputtokens'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Totaltokens -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Totaltokens" />
														<textbox tabindex="7" id="prjtotaltokens"
															value="@bind(vm.currentProjectResourceConsumption.prjtotaltokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjtotaltokens'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Embeddingtokens -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Embeddingtokens" />
														<textbox tabindex="8" id="prjembeddingtokens"
															value="@bind(vm.currentProjectResourceConsumption.prjembeddingtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjembeddingtokens'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Tokencost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tokencost" />
														<textbox tabindex="9" id="prjtokencost"
															value="@bind(vm.currentProjectResourceConsumption.prjtokencost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjtokencost'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Imagesgenerated -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Imagesgenerated" />
														<textbox tabindex="10" id="prjimagesgenerated"
															value="@bind(vm.currentProjectResourceConsumption.prjimagesgenerated)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjimagesgenerated'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Imagesanalyzed -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Imagesanalyzed" />
														<textbox tabindex="11" id="prjimagesanalyzed"
															value="@bind(vm.currentProjectResourceConsumption.prjimagesanalyzed)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjimagesanalyzed'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Imagesstored -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Imagesstored" />
														<textbox tabindex="12" id="prjimagesstored"
															value="@bind(vm.currentProjectResourceConsumption.prjimagesstored)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjimagesstored'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Imagesresolution -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Imagesresolution" />
														<textbox tabindex="13" id="prjimagesresolution"
															value="@bind(vm.currentProjectResourceConsumption.prjimagesresolution)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['prjimagesresolution'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Imagescost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Imagescost" />
														<textbox tabindex="14" id="prjimagescost"
															value="@bind(vm.currentProjectResourceConsumption.prjimagescost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjimagescost'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Audiominutes -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audiominutes" />
														<textbox tabindex="15" id="prjaudiominutes"
															value="@bind(vm.currentProjectResourceConsumption.prjaudiominutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjaudiominutes'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Audiotranscribedminutes -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audiotranscribedminutes" />
														<textbox tabindex="16" id="prjaudiotranscribedminutes"
															value="@bind(vm.currentProjectResourceConsumption.prjaudiotranscribedminutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjaudiotranscribedminutes'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Audiogeneratedminutes -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audiogeneratedminutes" />
														<textbox tabindex="17" id="prjaudiogeneratedminutes"
															value="@bind(vm.currentProjectResourceConsumption.prjaudiogeneratedminutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjaudiogeneratedminutes'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Audiofilescount -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audiofilescount" />
														<textbox tabindex="18" id="prjaudiofilescount"
															value="@bind(vm.currentProjectResourceConsumption.prjaudiofilescount)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjaudiofilescount'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Audiocost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audiocost" />
														<textbox tabindex="19" id="prjaudiocost"
															value="@bind(vm.currentProjectResourceConsumption.prjaudiocost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjaudiocost'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Videominutes -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Videominutes" />
														<textbox tabindex="20" id="prjvideominutes"
															value="@bind(vm.currentProjectResourceConsumption.prjvideominutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjvideominutes'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Videoanalyzedminutes -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Videoanalyzedminutes" />
														<textbox tabindex="21" id="prjvideoanalyzedminutes"
															value="@bind(vm.currentProjectResourceConsumption.prjvideoanalyzedminutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjvideoanalyzedminutes'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Videofilescount -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Videofilescount" />
														<textbox tabindex="22" id="prjvideofilescount"
															value="@bind(vm.currentProjectResourceConsumption.prjvideofilescount)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjvideofilescount'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Videocost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Videocost" />
														<textbox tabindex="23" id="prjvideocost"
															value="@bind(vm.currentProjectResourceConsumption.prjvideocost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjvideocost'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Document Sprocessed -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Document Sprocessed" />
														<textbox tabindex="24" id="prjdocumentsprocessed"
															value="@bind(vm.currentProjectResourceConsumption.prjdocumentsprocessed)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjdocumentsprocessed'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Document Spages -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Document Spages" />
														<textbox tabindex="25" id="prjdocumentspages"
															value="@bind(vm.currentProjectResourceConsumption.prjdocumentspages)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjdocumentspages'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Document Ssizemb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Document Ssizemb" />
														<textbox tabindex="26" id="prjdocumentssizemb"
															value="@bind(vm.currentProjectResourceConsumption.prjdocumentssizemb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjdocumentssizemb'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Pdfgenerated -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Pdfgenerated" />
														<textbox tabindex="27" id="prjpdfgenerated"
															value="@bind(vm.currentProjectResourceConsumption.prjpdfgenerated)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjpdfgenerated'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Document Scost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Document Scost" />
														<textbox tabindex="28" id="prjdocumentscost"
															value="@bind(vm.currentProjectResourceConsumption.prjdocumentscost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjdocumentscost'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Storageusedgb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Storageusedgb" />
														<textbox tabindex="29" id="prjstorageusedgb"
															value="@bind(vm.currentProjectResourceConsumption.prjstorageusedgb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjstorageusedgb'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Storagemodelsgb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Storagemodelsgb" />
														<textbox tabindex="30" id="prjstoragemodelsgb"
															value="@bind(vm.currentProjectResourceConsumption.prjstoragemodelsgb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['prjstoragemodelsgb'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Storagedatasetsgb -->
