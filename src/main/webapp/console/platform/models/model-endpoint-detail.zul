															value="Updated At" />
														<textbox tabindex="36" id="modupdatedat"
															value="@bind(vm.currentModelEndpoint.modupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
