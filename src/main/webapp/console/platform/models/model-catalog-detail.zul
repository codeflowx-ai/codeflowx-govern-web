														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dataprivacycompliant" />
														<textbox tabindex="37" id="moddataprivacycompliant"
															value="@bind(vm.currentModelCatalog.moddataprivacycompliant)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['moddataprivacycompliant'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Usagecount -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
