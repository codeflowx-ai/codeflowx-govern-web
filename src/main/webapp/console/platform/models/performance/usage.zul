<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="models"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.models.ModelUsageDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-microchip label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de El Usage" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveModelUsage')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Requestid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestid" />
														<textbox tabindex="2" id="modrequestid"
															value="@bind(vm.currentModelUsage.modrequestid)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['modrequestid'])" />
													</div>
												</div>
											</div>											<!-- Userid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Userid" />
														<textbox tabindex="3" id="moduserid"
															value="@bind(vm.currentModelUsage.moduserid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['moduserid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Projectid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Projectid" />
														<textbox tabindex="4" id="modprojectid"
															value="@bind(vm.currentModelUsage.modprojectid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modprojectid'])" />
													</div>
												</div>
											</div>											<!-- Agent Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Agent Id" />
														<textbox tabindex="5" id="modagentid"
															value="@bind(vm.currentModelUsage.modagentid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modagentid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Prompt Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Prompt Id" />
														<textbox tabindex="6" id="modpromptid"
															value="@bind(vm.currentModelUsage.modpromptid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modpromptid'])" />
													</div>
												</div>
											</div>											<!-- Inputtokens -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Inputtokens" />
														<textbox tabindex="7" id="modinputtokens"
															value="@bind(vm.currentModelUsage.modinputtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modinputtokens'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Outputtokens -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Outputtokens" />
														<textbox tabindex="8" id="modoutputtokens"
															value="@bind(vm.currentModelUsage.modoutputtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modoutputtokens'])" />
													</div>
												</div>
											</div>											<!-- Totaltokens -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Totaltokens" />
														<textbox tabindex="9" id="modtotaltokens"
															value="@bind(vm.currentModelUsage.modtotaltokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtotaltokens'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Inputcost -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Inputcost" />
														<textbox tabindex="10" id="modinputcost"
															value="@bind(vm.currentModelUsage.modinputcost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modinputcost'])" />
													</div>
												</div>
											</div>											<!-- Outputcost -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Outputcost" />
														<textbox tabindex="11" id="modoutputcost"
															value="@bind(vm.currentModelUsage.modoutputcost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modoutputcost'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Totalcost -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Totalcost" />
														<textbox tabindex="12" id="modtotalcost"
															value="@bind(vm.currentModelUsage.modtotalcost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtotalcost'])" />
													</div>
												</div>
											</div>											<!-- Currency -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Currency" />
														<textbox tabindex="13" id="modcurrency"
															value="@bind(vm.currentModelUsage.modcurrency)"
															maxlength="3"
															constraint="max 3" />
														<label sclass="text-danger" value="@load(vmsgs['modcurrency'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Latencyms -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Latencyms" />
														<textbox tabindex="14" id="modlatencyms"
															value="@bind(vm.currentModelUsage.modlatencyms)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modlatencyms'])" />
													</div>
												</div>
											</div>											<!-- Time Tofirsttokenms -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Tofirsttokenms" />
														<textbox tabindex="15" id="modtimetofirsttokenms"
															value="@bind(vm.currentModelUsage.modtimetofirsttokenms)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtimetofirsttokenms'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Tokenspersecond -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tokenspersecond" />
														<textbox tabindex="16" id="modtokenspersecond"
															value="@bind(vm.currentModelUsage.modtokenspersecond)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtokenspersecond'])" />
													</div>
												</div>
											</div>											<!-- Requesttype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requesttype" />
														<combobox tabindex="17" id="modrequesttype"
															selectedItem="@bind(vm.currentModelUsage.modrequesttype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modrequesttype'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Temperature -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Temperature" />
														<textbox tabindex="18" id="modtemperature"
															value="@bind(vm.currentModelUsage.modtemperature)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtemperature'])" />
													</div>
												</div>
											</div>											<!-- Maxtokensrequested -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Maxtokensrequested" />
														<textbox tabindex="19" id="modmaxtokensrequested"
															value="@bind(vm.currentModelUsage.modmaxtokensrequested)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modmaxtokensrequested'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Model Params -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Model Params" />
														<textbox tabindex="20" id="modmodelparams"
															value="@bind(vm.currentModelUsage.modmodelparams)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modmodelparams'])" />
													</div>
												</div>
											</div>											<!-- Finishreason -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Finishreason" />
														<textbox tabindex="21" id="modfinishreason"
															value="@bind(vm.currentModelUsage.modfinishreason)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modfinishreason'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Wassuccessful -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Wassuccessful" />
														<textbox tabindex="22" id="modwassuccessful"
															value="@bind(vm.currentModelUsage.modwassuccessful)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modwassuccessful'])" />
													</div>
												</div>
											</div>											<!-- Errorcode -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Errorcode" />
														<textbox tabindex="23" id="moderrorcode"
															value="@bind(vm.currentModelUsage.moderrorcode) @save(vm.currentModelUsage.moderrorcode, before=('saveItem')) @validator(vm.unique, field='MODERRORCODE', required=false, oldValue=vm.originalModerrorcode)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['moderrorcode'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Errormessage -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Errormessage" />
														<textbox tabindex="24" id="moderrormessage"
															value="@bind(vm.currentModelUsage.moderrormessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['moderrormessage'])" />
													</div>
												</div>
											</div>											<!-- Passedcontentfilter -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Passedcontentfilter" />
														<textbox tabindex="25" id="modpassedcontentfilter"
															value="@bind(vm.currentModelUsage.modpassedcontentfilter)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modpassedcontentfilter'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Bias Score -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Bias Score" />
														<textbox tabindex="26" id="modbiasscore"
															value="@bind(vm.currentModelUsage.modbiasscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modbiasscore'])" />
													</div>
												</div>
											</div>											<!-- Toxicityscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Toxicityscore" />
														<textbox tabindex="27" id="modtoxicityscore"
															value="@bind(vm.currentModelUsage.modtoxicityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtoxicityscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Time Stamp -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Stamp *" />
														<textbox tabindex="28" id="modtimestamp"
															value="@bind(vm.currentModelUsage.modtimestamp)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['modtimestamp'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>