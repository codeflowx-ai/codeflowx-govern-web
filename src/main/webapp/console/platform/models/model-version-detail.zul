<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="models"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.models.ModelVersionDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-microchip label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de El Version" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveModelVersion')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Version -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Version *" />
														<textbox tabindex="2" id="modversion"
															value="@bind(vm.currentModelVersion.modversion)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modversion'])" />
													</div>
												</div>
											</div>											<!-- Description -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="3" id="moddescription"
															value="@bind(vm.currentModelVersion.moddescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['moddescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Performancemetrics -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Performancemetrics" />
														<textbox tabindex="4" id="modperformancemetrics"
															value="@bind(vm.currentModelVersion.modperformancemetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modperformancemetrics'])" />
													</div>
												</div>
											</div>											<!-- Training Config -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Training Config" />
														<textbox tabindex="5" id="modtrainingconfig"
															value="@bind(vm.currentModelVersion.modtrainingconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtrainingconfig'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="6" id="modstatus"
															selectedItem="@bind(vm.currentModelVersion.modstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modstatus'])" />
													</div>
												</div>
											</div>											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="7" id="modcreatedby"
															value="@bind(vm.currentModelVersion.modcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modcreatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="8" id="modupdatedby"
															value="@bind(vm.currentModelVersion.modupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="9" id="modcreatedat"
															value="@bind(vm.currentModelVersion.modcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['modcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="10" id="modupdatedat"
															value="@bind(vm.currentModelVersion.modupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedat'])" />
													</div>
												</div>
											</div>											<!-- Currentstage -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Currentstage" />
														<textbox tabindex="11" id="modcurrentstage"
															value="@bind(vm.currentModelVersion.modcurrentstage)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modcurrentstage'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Lifecyclestage -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lifecyclestage" />
														<textbox tabindex="12" id="modlifecyclestage"
															value="@bind(vm.currentModelVersion.modlifecyclestage)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modlifecyclestage'])" />
													</div>
												</div>
											</div>											<!-- Tag S -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tag S" />
														<div class="input-group">
															<textbox value="@bind(vm.newModtags)"
																placeholder="Añadir tag s"
																onOK="@command('addModtags')" />
															<button onClick="@command('addModtags')"
																iconSclass="fa-plus" />
														</div>
														<div class="mt-2">
															<forEach items="@load(vm.selectedModtagss)" var="tag">
																<span class="badge bg-primary me-1">
																	<label value="@load(tag)" />
																	<a onClick="@command('removeModtags', tag=tag)"
																		iconSclass="fa-times" class="ms-1" />
																</span>
															</forEach>
														</div>
														<label sclass="text-danger" value="@load(vmsgs['modtags'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Userid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Userid" />
														<textbox tabindex="14" id="moduserid"
															value="@bind(vm.currentModelVersion.moduserid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['moduserid'])" />
													</div>
												</div>
											</div>											<!-- Creationtimestamp -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Creationtimestamp" />
														<textbox tabindex="15" id="modcreationtimestamp"
															value="@bind(vm.currentModelVersion.modcreationtimestamp)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modcreationtimestamp'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Lastupdatedtimestamp -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lastupdatedtimestamp" />
														<textbox tabindex="16" id="modlastupdatedtimestamp"
															value="@bind(vm.currentModelVersion.modlastupdatedtimestamp)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modlastupdatedtimestamp'])" />
													</div>
												</div>
											</div>											<!-- Status Message -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status Message" />
														<textbox tabindex="17" id="modstatusmessage"
															value="@bind(vm.currentModelVersion.modstatusmessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modstatusmessage'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Source -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Source" />
														<textbox tabindex="18" id="modsource"
															value="@bind(vm.currentModelVersion.modsource)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['modsource'])" />
													</div>
												</div>
											</div>											<!-- Runid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Runid" />
														<textbox tabindex="19" id="modrunid"
															value="@bind(vm.currentModelVersion.modrunid)"
															maxlength="36"
															constraint="max 36" />
														<label sclass="text-danger" value="@load(vmsgs['modrunid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Submodmodelartifacts -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelartifacts" />
														<textbox tabindex="20" id="submodmodelartifacts"
															value="@bind(vm.currentModelVersion.submodmodelartifacts)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelartifacts'])" />
													</div>
												</div>
											</div>											<!-- Submodmodelstagetransitions -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelstagetransitions" />
														<textbox tabindex="21" id="submodmodelstagetransitions"
															value="@bind(vm.currentModelVersion.submodmodelstagetransitions)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelstagetransitions'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Submodmodelvalidations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelvalidations" />
														<textbox tabindex="22" id="submodmodelvalidations"
															value="@bind(vm.currentModelVersion.submodmodelvalidations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelvalidations'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Submodmodelartifacts" onSelect="@command('onSelectModelArtifactTab')" />
												<tab label="Submodmodelstagetransitions" onSelect="@command('onSelectModelStageTransitionTab')" />
												<tab label="Submodmodelvalidations" onSelect="@command('onSelectModelValidationTab')" />
											</tabs>
											<tabpanels>
												<!-- Panel: Submodmodelartifacts -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Submodmodelartifacts"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModelArtifacts)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.submodmodelartifacts)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.submodmodelartifacts)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay submodmodelartifacts registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Submodmodelstagetransitions -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Submodmodelstagetransitions"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModelStageTransitions)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.submodmodelstagetransitions)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.submodmodelstagetransitions)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay submodmodelstagetransitions registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Submodmodelvalidations -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Submodmodelvalidations"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModelValidations)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.submodmodelvalidations)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.submodmodelvalidations)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
