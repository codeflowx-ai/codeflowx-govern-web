<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="models"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.models.ModelCapabilityDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-microchip label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de El Capability" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveModelCapability')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Tasktype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tasktype *" />
														<combobox tabindex="2" id="modtasktype"
															selectedItem="@bind(vm.currentModelCapability.modtasktype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modtasktype'])" />
													</div>
												</div>
											</div>											<!-- Capabilityscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Capabilityscore" />
														<textbox tabindex="3" id="modcapabilityscore"
															value="@bind(vm.currentModelCapability.modcapabilityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modcapabilityscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Benchmarkname -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Benchmarkname" />
														<textbox tabindex="4" id="modbenchmarkname"
															value="@bind(vm.currentModelCapability.modbenchmarkname) @save(vm.currentModelCapability.modbenchmarkname, before=('saveItem')) @validator(vm.unique, field='MODBENCHMARKNAME', required=false, oldValue=vm.originalModbenchmarkname)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['modbenchmarkname'])" />
													</div>
												</div>
											</div>											<!-- Benchmarkscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Benchmarkscore" />
														<textbox tabindex="5" id="modbenchmarkscore"
															value="@bind(vm.currentModelCapability.modbenchmarkscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modbenchmarkscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Benchmarkdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Benchmarkdate" />
														<textbox tabindex="6" id="modbenchmarkdate"
															value="@bind(vm.currentModelCapability.modbenchmarkdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modbenchmarkdate'])" />
													</div>
												</div>
											</div>											<!-- Mincontextneeded -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Mincontextneeded" />
														<textbox tabindex="7" id="modmincontextneeded"
															value="@bind(vm.currentModelCapability.modmincontextneeded)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modmincontextneeded'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Optimalcontext -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Optimalcontext" />
														<textbox tabindex="8" id="modoptimalcontext"
															value="@bind(vm.currentModelCapability.modoptimalcontext)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modoptimalcontext'])" />
													</div>
												</div>
											</div>											<!-- Supportsfewshot -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Supportsfewshot" />
														<textbox tabindex="9" id="modsupportsfewshot"
															value="@bind(vm.currentModelCapability.modsupportsfewshot)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modsupportsfewshot'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Supportszeroshot -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Supportszeroshot" />
														<textbox tabindex="10" id="modsupportszeroshot"
															value="@bind(vm.currentModelCapability.modsupportszeroshot)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modsupportszeroshot'])" />
													</div>
												</div>
											</div>											<!-- Supportschainofthought -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Supportschainofthought" />
														<textbox tabindex="11" id="modsupportschainofthought"
															value="@bind(vm.currentModelCapability.modsupportschainofthought)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modsupportschainofthought'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Accuracyscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Accuracyscore" />
														<textbox tabindex="12" id="modaccuracyscore"
															value="@bind(vm.currentModelCapability.modaccuracyscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modaccuracyscore'])" />
													</div>
												</div>
											</div>											<!-- Latencyscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Latencyscore" />
														<textbox tabindex="13" id="modlatencyscore"
															value="@bind(vm.currentModelCapability.modlatencyscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modlatencyscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Costefficiencyscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costefficiencyscore" />
														<textbox tabindex="14" id="modcostefficiencyscore"
															value="@bind(vm.currentModelCapability.modcostefficiencyscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modcostefficiencyscore'])" />
													</div>
												</div>
											</div>											<!-- Recommendedfortask -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Recommendedfortask" />
														<textbox tabindex="15" id="modrecommendedfortask"
															value="@bind(vm.currentModelCapability.modrecommendedfortask)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modrecommendedfortask'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Notes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Notes" />
														<textbox tabindex="16" id="modnotes"
															value="@bind(vm.currentModelCapability.modnotes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modnotes'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="17" id="modcreatedat"
															value="@bind(vm.currentModelCapability.modcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['modcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="18" id="modupdatedat"
															value="@bind(vm.currentModelCapability.modupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>