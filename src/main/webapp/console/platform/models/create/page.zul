<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="models"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.models.ModelDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-microchip label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de El" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Name -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Name *" />
														<textbox tabindex="2" id="modname"
															value="@bind(vm.currentModel.modname) @save(vm.currentModel.modname, before=('saveItem')) @validator(vm.unique, field='MODNAME', required=true, oldValue=vm.originalModname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modname'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Description -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="3" id="moddescription"
															value="@bind(vm.currentModel.moddescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['moddescription'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Type -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Type *" />
														<combobox tabindex="4" id="modtype"
															selectedItem="@bind(vm.currentModel.modtype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modtype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Framework -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Framework" />
														<combobox tabindex="5" id="modframework"
															selectedItem="@bind(vm.currentModel.modframework)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modframework'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Version -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Version *" />
														<textbox tabindex="6" id="modversion"
															value="@bind(vm.currentModel.modversion)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modversion'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Status -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="7" id="modstatus"
															selectedItem="@bind(vm.currentModel.modstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Performancemetrics -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Performancemetrics" />
														<textbox tabindex="8" id="modperformancemetrics"
															value="@bind(vm.currentModel.modperformancemetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modperformancemetrics'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Training Config -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Training Config" />
														<textbox tabindex="9" id="modtrainingconfig"
															value="@bind(vm.currentModel.modtrainingconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modtrainingconfig'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Deployment Config -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Deployment Config" />
														<textbox tabindex="10" id="moddeploymentconfig"
															value="@bind(vm.currentModel.moddeploymentconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['moddeploymentconfig'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Approval Status -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approval Status" />
														<combobox tabindex="11" id="modapprovalstatus"
															selectedItem="@bind(vm.currentModel.modapprovalstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modapprovalstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Approvedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedby" />
														<textbox tabindex="12" id="modapprovedby"
															value="@bind(vm.currentModel.modapprovedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modapprovedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Approvedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedat" />
														<textbox tabindex="13" id="modapprovedat"
															value="@bind(vm.currentModel.modapprovedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modapprovedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Created By -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="14" id="modcreatedby"
															value="@bind(vm.currentModel.modcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modcreatedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Updated By -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="15" id="modupdatedby"
															value="@bind(vm.currentModel.modupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedby'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Created At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="16" id="modcreatedat"
															value="@bind(vm.currentModel.modcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['modcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Updated At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="17" id="modupdatedat"
															value="@bind(vm.currentModel.modupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Currentstage -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Currentstage" />
														<textbox tabindex="18" id="modcurrentstage"
															value="@bind(vm.currentModel.modcurrentstage)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modcurrentstage'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Lifecyclestage -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lifecyclestage" />
														<textbox tabindex="19" id="modlifecyclestage"
															value="@bind(vm.currentModel.modlifecyclestage)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['modlifecyclestage'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Tag S -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tag S" />
														<h:div class="input-group">
															<textbox value="@bind(vm.newModtags)"
																placeholder="Añadir tag s"
																onOK="@command('addModtags')" />
															<button onClick="@command('addModtags')"
																iconSclass="fa-plus" />
														</h:div>
														<h:div class="mt-2">
															<forEach items="@load(vm.selectedModtagss)" var="tag">
																<h:span class="badge bg-primary me-1">
																	<label value="@load(tag)" />
																	<a onClick="@command('removeModtags', tag=tag)"
																		iconSclass="fa-times" class="ms-1" />
																</h:span>
															</forEach>
														</h:div>
														<label sclass="text-danger" value="@load(vmsgs['modtags'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Userid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Userid" />
														<textbox tabindex="21" id="moduserid"
															value="@bind(vm.currentModel.moduserid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['moduserid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Creationtimestamp -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Creationtimestamp" />
														<textbox tabindex="22" id="modcreationtimestamp"
															value="@bind(vm.currentModel.modcreationtimestamp)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modcreationtimestamp'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Lastupdatedtimestamp -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lastupdatedtimestamp" />
														<textbox tabindex="23" id="modlastupdatedtimestamp"
															value="@bind(vm.currentModel.modlastupdatedtimestamp)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['modlastupdatedtimestamp'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Provider -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Provider" />
														<combobox tabindex="24" id="modelprovider"
															selectedItem="@bind(vm.currentModel.modelProvider)"
															readonly="true"
															>
															<template name="model">
																<comboitem label="@load(each.displayName)" value="@load(each)"/>
															</template>
															<forEach items="@load(vm.availableModelProviders)">
																<comboitem label="@load(each.displayName)" />
															</forEach>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['modelprovider'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Submodmodelartifacts -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelartifacts" />
														<textbox tabindex="25" id="submodmodelartifacts"
															value="@bind(vm.currentModel.submodmodelartifacts)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelartifacts'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Submodmodelbiasanalyses -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelbiasanalyses" />
														<textbox tabindex="26" id="submodmodelbiasanalyses"
															value="@bind(vm.currentModel.submodmodelbiasanalyses)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelbiasanalyses'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Submodmodeldependencies -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodeldependencies" />
														<textbox tabindex="27" id="submodmodeldependencies"
															value="@bind(vm.currentModel.submodmodeldependencies)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodeldependencies'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Submodmodeldependencies By Targetmodel -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodeldependencies By Targetmodel" />
														<textbox tabindex="28" id="submodmodeldependenciesbytargetmodel"
															value="@bind(vm.currentModel.submodmodeldependenciesByTargetmodel)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodeldependenciesbytargetmodel'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Submodmodelperformances -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Submodmodelperformances" />
														<textbox tabindex="29" id="submodmodelperformances"
															value="@bind(vm.currentModel.submodmodelperformances)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['submodmodelperformances'])" />
													</h:div>
