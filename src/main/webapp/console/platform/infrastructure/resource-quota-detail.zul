<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.ResourceQuotaDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Resource Quota" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Quotaclusterid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotaclusterid" />
														<textbox tabindex="2" id="infquotaclusterid"
															value="@bind(vm.currentResourceQuota.infquotaclusterid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infquotaclusterid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Quotanamespace -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotanamespace" />
														<textbox tabindex="3" id="infquotanamespace"
															value="@bind(vm.currentResourceQuota.infquotanamespace) @save(vm.currentResourceQuota.infquotanamespace, before=('saveItem')) @validator(vm.unique, field='INFQUOTANAMESPACE', required=false, oldValue=vm.originalInfquotanamespace)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infquotanamespace'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Quotacpulimit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotacpulimit" />
														<textbox tabindex="4" id="infquotacpulimit"
															value="@bind(vm.currentResourceQuota.infquotacpulimit)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infquotacpulimit'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Quotamemorygblimit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotamemorygblimit" />
														<textbox tabindex="5" id="infquotamemorygblimit"
															value="@bind(vm.currentResourceQuota.infquotamemorygblimit)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infquotamemorygblimit'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Quotastoragegblimit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotastoragegblimit" />
														<textbox tabindex="6" id="infquotastoragegblimit"
															value="@bind(vm.currentResourceQuota.infquotastoragegblimit)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infquotastoragegblimit'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Quotapodlimit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotapodlimit" />
														<textbox tabindex="7" id="infquotapodlimit"
															value="@bind(vm.currentResourceQuota.infquotapodlimit)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infquotapodlimit'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Quotacreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotacreatedat *" />
														<textbox tabindex="8" id="infquotacreatedat"
															value="@bind(vm.currentResourceQuota.infquotacreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infquotacreatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Quotaupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Quotaupdatedat *" />
														<textbox tabindex="9" id="infquotaupdatedat"
															value="@bind(vm.currentResourceQuota.infquotaupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infquotaupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>