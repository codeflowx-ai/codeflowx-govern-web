<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.InfrastructureAuditDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Rastructure Audit" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Auditresourcetype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditresourcetype *" />
														<combobox tabindex="2" id="infauditresourcetype"
															selectedItem="@bind(vm.currentInfrastructureAudit.infauditresourcetype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infauditresourcetype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditresourceid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditresourceid *" />
														<textbox tabindex="3" id="infauditresourceid"
															value="@bind(vm.currentInfrastructureAudit.infauditresourceid)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infauditresourceid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditresourcename -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditresourcename" />
														<textbox tabindex="4" id="infauditresourcename"
															value="@bind(vm.currentInfrastructureAudit.infauditresourcename) @save(vm.currentInfrastructureAudit.infauditresourcename, before=('saveItem')) @validator(vm.unique, field='INFAUDITRESOURCENAME', required=false, oldValue=vm.originalInfauditresourcename)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infauditresourcename'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditaction -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditaction *" />
														<textbox tabindex="5" id="infauditaction"
															value="@bind(vm.currentInfrastructureAudit.infauditaction)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infauditaction'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Audituserid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audituserid" />
														<textbox tabindex="6" id="infaudituserid"
															value="@bind(vm.currentInfrastructureAudit.infaudituserid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infaudituserid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditusername -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditusername" />
														<textbox tabindex="7" id="infauditusername"
															value="@bind(vm.currentInfrastructureAudit.infauditusername) @save(vm.currentInfrastructureAudit.infauditusername, before=('saveItem')) @validator(vm.unique, field='INFAUDITUSERNAME', required=false, oldValue=vm.originalInfauditusername)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infauditusername'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditipaddress -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditipaddress" />
														<textbox tabindex="8" id="infauditipaddress"
															value="@bind(vm.currentInfrastructureAudit.infauditipaddress)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infauditipaddress'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Audituseragent -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audituseragent" />
														<textbox tabindex="9" id="infaudituseragent"
															value="@bind(vm.currentInfrastructureAudit.infaudituseragent)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infaudituseragent'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditrequestid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditrequestid" />
														<textbox tabindex="10" id="infauditrequestid"
															value="@bind(vm.currentInfrastructureAudit.infauditrequestid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infauditrequestid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditchangesbefore -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditchangesbefore" />
														<textbox tabindex="11" id="infauditchangesbefore"
															value="@bind(vm.currentInfrastructureAudit.infauditchangesbefore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditchangesbefore'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditchangesafter -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditchangesafter" />
														<textbox tabindex="12" id="infauditchangesafter"
															value="@bind(vm.currentInfrastructureAudit.infauditchangesafter)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditchangesafter'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditrequestparams -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditrequestparams" />
														<textbox tabindex="13" id="infauditrequestparams"
															value="@bind(vm.currentInfrastructureAudit.infauditrequestparams)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditrequestparams'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditresponsedata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditresponsedata" />
														<textbox tabindex="14" id="infauditresponsedata"
															value="@bind(vm.currentInfrastructureAudit.infauditresponsedata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditresponsedata'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditerrormessage -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditerrormessage" />
														<textbox tabindex="15" id="infauditerrormessage"
															value="@bind(vm.currentInfrastructureAudit.infauditerrormessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditerrormessage'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditerrorstacktrace -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditerrorstacktrace" />
														<textbox tabindex="16" id="infauditerrorstacktrace"
															value="@bind(vm.currentInfrastructureAudit.infauditerrorstacktrace)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditerrorstacktrace'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditexecutiontimems -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditexecutiontimems" />
														<textbox tabindex="17" id="infauditexecutiontimems"
															value="@bind(vm.currentInfrastructureAudit.infauditexecutiontimems)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditexecutiontimems'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Auditmetadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditmetadata" />
														<textbox tabindex="18" id="infauditmetadata"
															value="@bind(vm.currentInfrastructureAudit.infauditmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infauditmetadata'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Auditcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditcreatedat *" />
														<textbox tabindex="19" id="infauditcreatedat"
															value="@bind(vm.currentInfrastructureAudit.infauditcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infauditcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>