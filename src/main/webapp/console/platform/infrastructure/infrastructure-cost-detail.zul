<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.InfrastructureCostDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Rastructure Cost" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Costproviderid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costproviderid" />
														<textbox tabindex="2" id="infcostproviderid"
															value="@bind(vm.currentInfrastructureCost.infcostproviderid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostproviderid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costresourceid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costresourceid" />
														<textbox tabindex="3" id="infcostresourceid"
															value="@bind(vm.currentInfrastructureCost.infcostresourceid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostresourceid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costresourcetype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costresourcetype" />
														<combobox tabindex="4" id="infcostresourcetype"
															selectedItem="@bind(vm.currentInfrastructureCost.infcostresourcetype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infcostresourcetype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costresourcename -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costresourcename" />
														<textbox tabindex="5" id="infcostresourcename"
															value="@bind(vm.currentInfrastructureCost.infcostresourcename) @save(vm.currentInfrastructureCost.infcostresourcename, before=('saveItem')) @validator(vm.unique, field='INFCOSTRESOURCENAME', required=false, oldValue=vm.originalInfcostresourcename)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infcostresourcename'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costperiodstart -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costperiodstart *" />
														<textbox tabindex="6" id="infcostperiodstart"
															value="@bind(vm.currentInfrastructureCost.infcostperiodstart)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcostperiodstart'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costperiodend -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costperiodend *" />
														<textbox tabindex="7" id="infcostperiodend"
															value="@bind(vm.currentInfrastructureCost.infcostperiodend)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcostperiodend'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costhourlyrate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costhourlyrate" />
														<textbox tabindex="8" id="infcosthourlyrate"
															value="@bind(vm.currentInfrastructureCost.infcosthourlyrate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcosthourlyrate'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costinvoiceid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costinvoiceid" />
														<textbox tabindex="9" id="infcostinvoiceid"
															value="@bind(vm.currentInfrastructureCost.infcostinvoiceid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infcostinvoiceid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costinvoicedate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costinvoicedate" />
														<textbox tabindex="10" id="infcostinvoicedate"
															value="@bind(vm.currentInfrastructureCost.infcostinvoicedate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostinvoicedate'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costpaymentstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costpaymentstatus" />
														<combobox tabindex="11" id="infcostpaymentstatus"
															selectedItem="@bind(vm.currentInfrastructureCost.infcostpaymentstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infcostpaymentstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costpaymentdate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costpaymentdate" />
														<textbox tabindex="12" id="infcostpaymentdate"
															value="@bind(vm.currentInfrastructureCost.infcostpaymentdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostpaymentdate'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costbreakdown -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costbreakdown" />
														<textbox tabindex="13" id="infcostbreakdown"
															value="@bind(vm.currentInfrastructureCost.infcostbreakdown)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostbreakdown'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costmetadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costmetadata" />
														<textbox tabindex="14" id="infcostmetadata"
															value="@bind(vm.currentInfrastructureCost.infcostmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostmetadata'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costtags -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costtags" />
														<textbox tabindex="15" id="infcosttags"
															value="@bind(vm.currentInfrastructureCost.infcosttags)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcosttags'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costcreatedat *" />
														<textbox tabindex="16" id="infcostcreatedat"
															value="@bind(vm.currentInfrastructureCost.infcostcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcostcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costupdatedat *" />
														<textbox tabindex="17" id="infcostupdatedat"
															value="@bind(vm.currentInfrastructureCost.infcostupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcostupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Costcreatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costcreatedby" />
														<textbox tabindex="18" id="infcostcreatedby"
															value="@bind(vm.currentInfrastructureCost.infcostcreatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostcreatedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Costupdatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costupdatedby" />
														<textbox tabindex="19" id="infcostupdatedby"
															value="@bind(vm.currentInfrastructureCost.infcostupdatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcostupdatedby'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>