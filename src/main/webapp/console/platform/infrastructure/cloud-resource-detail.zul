<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.CloudResourceDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Cloud Resource" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Resproviderid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resproviderid" />
														<textbox tabindex="2" id="infresproviderid"
															value="@bind(vm.currentCloudResource.infresproviderid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresproviderid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resclusterid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resclusterid" />
														<textbox tabindex="3" id="infresclusterid"
															value="@bind(vm.currentCloudResource.infresclusterid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresclusterid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resname *" />
														<textbox tabindex="4" id="infresname"
															value="@bind(vm.currentCloudResource.infresname) @save(vm.currentCloudResource.infresname, before=('saveItem')) @validator(vm.unique, field='INFRESNAME', required=true, oldValue=vm.originalInfresname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infresname'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resdescription -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resdescription" />
														<textbox tabindex="5" id="infresdescription"
															value="@bind(vm.currentCloudResource.infresdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresdescription'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resresourceid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resresourceid" />
														<textbox tabindex="6" id="infresresourceid"
															value="@bind(vm.currentCloudResource.infresresourceid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infresresourceid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resresourcetype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resresourcetype *" />
														<combobox tabindex="7" id="infresresourcetype"
															selectedItem="@bind(vm.currentCloudResource.infresresourcetype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infresresourcetype'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resregion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resregion" />
														<textbox tabindex="8" id="infresregion"
															value="@bind(vm.currentCloudResource.infresregion)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['infresregion'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resavailabilityzone -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resavailabilityzone" />
														<textbox tabindex="9" id="infresavailabilityzone"
															value="@bind(vm.currentCloudResource.infresavailabilityzone)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['infresavailabilityzone'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resendpointurl -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resendpointurl" />
														<textbox tabindex="10" id="infresendpointurl"
															value="@bind(vm.currentCloudResource.infresendpointurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['infresendpointurl'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Rescapacitytotal -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Rescapacitytotal" />
														<textbox tabindex="11" id="infrescapacitytotal"
															value="@bind(vm.currentCloudResource.infrescapacitytotal)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infrescapacitytotal'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Rescapacityunit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Rescapacityunit" />
														<textbox tabindex="12" id="infrescapacityunit"
															value="@bind(vm.currentCloudResource.infrescapacityunit)"
															maxlength="20"
															constraint="max 20" />
														<label sclass="text-danger" value="@load(vmsgs['infrescapacityunit'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resperformancetier -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resperformancetier" />
														<textbox tabindex="13" id="infresperformancetier"
															value="@bind(vm.currentCloudResource.infresperformancetier)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infresperformancetier'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resconfiguration -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resconfiguration" />
														<textbox tabindex="14" id="infresconfiguration"
															value="@bind(vm.currentCloudResource.infresconfiguration)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresconfiguration'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resnetworkconfig -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resnetworkconfig" />
														<textbox tabindex="15" id="infresnetworkconfig"
															value="@bind(vm.currentCloudResource.infresnetworkconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresnetworkconfig'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ressecurityconfig -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ressecurityconfig" />
														<textbox tabindex="16" id="infressecurityconfig"
															value="@bind(vm.currentCloudResource.infressecurityconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infressecurityconfig'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resbackupschedule -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resbackupschedule" />
														<textbox tabindex="17" id="infresbackupschedule"
															value="@bind(vm.currentCloudResource.infresbackupschedule)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['infresbackupschedule'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Reslastbackup -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Reslastbackup" />
														<textbox tabindex="18" id="infreslastbackup"
															value="@bind(vm.currentCloudResource.infreslastbackup)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infreslastbackup'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Reshourlycost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Reshourlycost" />
														<textbox tabindex="19" id="infreshourlycost"
															value="@bind(vm.currentCloudResource.infreshourlycost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infreshourlycost'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Reslasthealthcheck -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Reslasthealthcheck" />
														<textbox tabindex="20" id="infreslasthealthcheck"
															value="@bind(vm.currentCloudResource.infreslasthealthcheck)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infreslasthealthcheck'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Reshealthstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Reshealthstatus" />
														<combobox tabindex="21" id="infreshealthstatus"
															selectedItem="@bind(vm.currentCloudResource.infreshealthstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infreshealthstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Resmetadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resmetadata" />
														<textbox tabindex="22" id="infresmetadata"
															value="@bind(vm.currentCloudResource.infresmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresmetadata'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Restags -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Restags" />
														<textbox tabindex="23" id="infrestags"
															value="@bind(vm.currentCloudResource.infrestags)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infrestags'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Rescreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Rescreatedat *" />
														<textbox tabindex="24" id="infrescreatedat"
															value="@bind(vm.currentCloudResource.infrescreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infrescreatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resupdatedat *" />
														<textbox tabindex="25" id="infresupdatedat"
															value="@bind(vm.currentCloudResource.infresupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infresupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Rescreatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Rescreatedby" />
														<textbox tabindex="26" id="infrescreatedby"
															value="@bind(vm.currentCloudResource.infrescreatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infrescreatedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Resupdatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resupdatedby" />
														<textbox tabindex="27" id="infresupdatedby"
															value="@bind(vm.currentCloudResource.infresupdatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infresupdatedby'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>