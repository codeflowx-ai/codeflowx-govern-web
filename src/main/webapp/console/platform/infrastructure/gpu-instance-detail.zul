<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.GpuInstanceDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Gpu Instance" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Gpuproviderid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuproviderid" />
														<textbox tabindex="2" id="infgpuproviderid"
															value="@bind(vm.currentGpuInstance.infgpuproviderid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpuproviderid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuname *" />
														<textbox tabindex="3" id="infgpuname"
															value="@bind(vm.currentGpuInstance.infgpuname) @save(vm.currentGpuInstance.infgpuname, before=('saveItem')) @validator(vm.unique, field='INFGPUNAME', required=true, oldValue=vm.originalInfgpuname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuname'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpudescription -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpudescription" />
														<textbox tabindex="4" id="infgpudescription"
															value="@bind(vm.currentGpuInstance.infgpudescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpudescription'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuinstanceid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuinstanceid" />
														<textbox tabindex="5" id="infgpuinstanceid"
															value="@bind(vm.currentGpuInstance.infgpuinstanceid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuinstanceid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gputype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gputype" />
														<combobox tabindex="6" id="infgputype"
															selectedItem="@bind(vm.currentGpuInstance.infgputype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infgputype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpumemorygb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpumemorygb" />
														<textbox tabindex="7" id="infgpumemorygb"
															value="@bind(vm.currentGpuInstance.infgpumemorygb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpumemorygb'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpuvramgb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuvramgb" />
														<textbox tabindex="8" id="infgpuvramgb"
															value="@bind(vm.currentGpuInstance.infgpuvramgb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpuvramgb'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpucpucores -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpucpucores" />
														<textbox tabindex="9" id="infgpucpucores"
															value="@bind(vm.currentGpuInstance.infgpucpucores)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpucpucores'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpuramgb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuramgb" />
														<textbox tabindex="10" id="infgpuramgb"
															value="@bind(vm.currentGpuInstance.infgpuramgb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpuramgb'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpustoragegb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpustoragegb" />
														<textbox tabindex="11" id="infgpustoragegb"
															value="@bind(vm.currentGpuInstance.infgpustoragegb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpustoragegb'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpustoragetype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpustoragetype" />
														<combobox tabindex="12" id="infgpustoragetype"
															selectedItem="@bind(vm.currentGpuInstance.infgpustoragetype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infgpustoragetype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuregion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuregion" />
														<textbox tabindex="13" id="infgpuregion"
															value="@bind(vm.currentGpuInstance.infgpuregion)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuregion'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpudatacenter -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpudatacenter" />
														<textbox tabindex="14" id="infgpudatacenter"
															value="@bind(vm.currentGpuInstance.infgpudatacenter)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['infgpudatacenter'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuipaddress -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuipaddress" />
														<textbox tabindex="15" id="infgpuipaddress"
															value="@bind(vm.currentGpuInstance.infgpuipaddress)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuipaddress'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpusshport -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpusshport" />
														<textbox tabindex="16" id="infgpusshport"
															value="@bind(vm.currentGpuInstance.infgpusshport)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpusshport'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpusshkey -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpusshkey" />
														<textbox tabindex="17" id="infgpusshkey"
															value="@bind(vm.currentGpuInstance.infgpusshkey)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpusshkey'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpuendpointurl -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuendpointurl" />
														<textbox tabindex="18" id="infgpuendpointurl"
															value="@bind(vm.currentGpuInstance.infgpuendpointurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuendpointurl'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpujupyterurl -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpujupyterurl" />
														<textbox tabindex="19" id="infgpujupyterurl"
															value="@bind(vm.currentGpuInstance.infgpujupyterurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['infgpujupyterurl'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpuapiurl -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuapiurl" />
														<textbox tabindex="20" id="infgpuapiurl"
															value="@bind(vm.currentGpuInstance.infgpuapiurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['infgpuapiurl'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpucudaversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpucudaversion" />
														<textbox tabindex="21" id="infgpucudaversion"
															value="@bind(vm.currentGpuInstance.infgpucudaversion)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infgpucudaversion'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpudriverversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpudriverversion" />
														<textbox tabindex="22" id="infgpudriverversion"
															value="@bind(vm.currentGpuInstance.infgpudriverversion)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['infgpudriverversion'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuhourlycost -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuhourlycost" />
														<textbox tabindex="23" id="infgpuhourlycost"
															value="@bind(vm.currentGpuInstance.infgpuhourlycost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpuhourlycost'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpustartedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpustartedat" />
														<textbox tabindex="24" id="infgpustartedat"
															value="@bind(vm.currentGpuInstance.infgpustartedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpustartedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpustoppedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpustoppedat" />
														<textbox tabindex="25" id="infgpustoppedat"
															value="@bind(vm.currentGpuInstance.infgpustoppedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpustoppedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpulasthealthcheck -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpulasthealthcheck" />
														<textbox tabindex="26" id="infgpulasthealthcheck"
															value="@bind(vm.currentGpuInstance.infgpulasthealthcheck)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpulasthealthcheck'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpuhealthstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpuhealthstatus" />
														<combobox tabindex="27" id="infgpuhealthstatus"
															selectedItem="@bind(vm.currentGpuInstance.infgpuhealthstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infgpuhealthstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpucpuusagepercent -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpucpuusagepercent" />
														<textbox tabindex="28" id="infgpucpuusagepercent"
															value="@bind(vm.currentGpuInstance.infgpucpuusagepercent)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpucpuusagepercent'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpumemoryusagepercent -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpumemoryusagepercent" />
														<textbox tabindex="29" id="infgpumemoryusagepercent"
															value="@bind(vm.currentGpuInstance.infgpumemoryusagepercent)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infgpumemoryusagepercent'])" />
