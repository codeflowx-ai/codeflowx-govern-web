<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="infrastructure"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.infrastructure.CloudCredentialDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cloud label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Cloud Credential" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Credproviderid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credproviderid *" />
														<textbox tabindex="2" id="infcredproviderid"
															value="@bind(vm.currentCloudCredential.infcredproviderid)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcredproviderid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credname *" />
														<textbox tabindex="3" id="infcredname"
															value="@bind(vm.currentCloudCredential.infcredname) @save(vm.currentCloudCredential.infcredname, before=('saveItem')) @validator(vm.unique, field='INFCREDNAME', required=true, oldValue=vm.originalInfcredname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['infcredname'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Creddescription -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Creddescription" />
														<textbox tabindex="4" id="infcreddescription"
															value="@bind(vm.currentCloudCredential.infcreddescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcreddescription'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credtype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credtype *" />
														<combobox tabindex="5" id="infcredtype"
															selectedItem="@bind(vm.currentCloudCredential.infcredtype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['infcredtype'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credaccesskey -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credaccesskey" />
														<textbox tabindex="6" id="infcredaccesskey"
															value="@bind(vm.currentCloudCredential.infcredaccesskey)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredaccesskey'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credsecretkey -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credsecretkey" />
														<textbox tabindex="7" id="infcredsecretkey"
															value="@bind(vm.currentCloudCredential.infcredsecretkey)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredsecretkey'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credapitoken -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credapitoken" />
														<textbox tabindex="8" id="infcredapitoken"
															value="@bind(vm.currentCloudCredential.infcredapitoken)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredapitoken'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credcertificate -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credcertificate" />
														<textbox tabindex="9" id="infcredcertificate"
															value="@bind(vm.currentCloudCredential.infcredcertificate)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredcertificate'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credprivatekey -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credprivatekey" />
														<textbox tabindex="10" id="infcredprivatekey"
															value="@bind(vm.currentCloudCredential.infcredprivatekey)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredprivatekey'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credadditionaldata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credadditionaldata" />
														<textbox tabindex="11" id="infcredadditionaldata"
															value="@bind(vm.currentCloudCredential.infcredadditionaldata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredadditionaldata'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credexpiresat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credexpiresat" />
														<textbox tabindex="12" id="infcredexpiresat"
															value="@bind(vm.currentCloudCredential.infcredexpiresat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredexpiresat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credlastused -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credlastused" />
														<textbox tabindex="13" id="infcredlastused"
															value="@bind(vm.currentCloudCredential.infcredlastused)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredlastused'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credrotationdays -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credrotationdays" />
														<textbox tabindex="14" id="infcredrotationdays"
															value="@bind(vm.currentCloudCredential.infcredrotationdays)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredrotationdays'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credcreatedat *" />
														<textbox tabindex="15" id="infcredcreatedat"
															value="@bind(vm.currentCloudCredential.infcredcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcredcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Credupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credupdatedat *" />
														<textbox tabindex="16" id="infcredupdatedat"
															value="@bind(vm.currentCloudCredential.infcredupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['infcredupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Credcreatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credcreatedby" />
														<textbox tabindex="17" id="infcredcreatedby"
															value="@bind(vm.currentCloudCredential.infcredcreatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['infcredcreatedby'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>