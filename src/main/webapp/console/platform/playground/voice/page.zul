<?page title="Voice Playground - CodeflowX Govern" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/theme/console/css/console-custom.css"/>
    
    <div viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.playground.PlaygroundVoiceViewModel')"
         class="content-wrapper" style="min-height: 100vh; background: #f8f9fa;">
        
        <!-- Header -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <n:h4 class="mb-1 fw-bold">
                            <n:i class="fas fa-microphone text-info me-2"></n:i>Voice Playground
                        </n:h4>
                        <n:p class="text-muted mb-0">Convierte texto a voz y voz a texto</n:p>
                    </div>
                    <button label="Nueva Sesión" iconSclass="fas fa-plus" 
                            sclass="btn btn-info"
                            onClick="@command('newSession')"/>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Text to Speech -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info text-white p-3">
                        <n:h5 class="mb-0">
                            <n:i class="fas fa-volume-up me-2"></n:i>Text to Speech
                        </n:h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Model Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Modelo</label>
                            <combobox placeholder="Seleccionar modelo..." 
                                     model="@load(vm.availableModels)"
                                     selectedItem="@bind(vm.selectedTTSModel)"
                                     sclass="form-control"/>
                        </div>

                        <!-- Voice Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Voz</label>
                            <combobox model="@load(vm.availableVoices)"
                                     selectedItem="@bind(vm.selectedVoice)"
                                     sclass="form-control"/>
                        </div>

                        <!-- Language -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Idioma</label>
                            <combobox model="@load(vm.availableLanguages)"
                                     selectedItem="@bind(vm.selectedLanguage)"
                                     sclass="form-control"/>
                        </div>

                        <!-- Speed -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Velocidad: <label value="@load(vm.speed)"/>x
                            </label>
                            <slider value="@bind(vm.speed)" 
                                   mold="scale" maxpos="200" 
                                   sclass="form-range"/>
                            <n:small class="text-muted">0.25x - 4.0x</n:small>
                        </div>

                        <!-- Text Input -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Texto</label>
                            <textbox multiline="true" rows="6" 
                                    value="@bind(vm.textToConvert)"
                                    sclass="form-control"
                                    placeholder="Escribe el texto que quieres convertir a voz..."/>
                        </div>

                        <button label="Generar Audio" iconSclass="fas fa-play" 
                                sclass="btn btn-info w-100"
                                disabled="@load(empty vm.textToConvert)"
                                onClick="@command('generateSpeech')"/>

                        <!-- Generated Audio -->
                        <div if="${not empty vm.generatedAudioUrl}" class="mt-4 p-3 bg-light rounded">
                            <n:audio controls="" class="w-100" src="${vm.generatedAudioUrl}">
                                Tu navegador no soporta el elemento de audio.
                            </n:audio>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <n:small class="text-muted">
                                    Duración: <label value="@load(vm.audioDuration)"/>s · 
                                    Costo: $<label value="@load(vm.audioCost) @converter('formattedNumber', format='0.0000')"/>
                                </n:small>
                                <button label="Descargar" iconSclass="fas fa-download" 
                                        sclass="btn btn-sm btn-outline-info"
                                        onClick="@command('downloadAudio')"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Speech to Text -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white p-3">
                        <n:h5 class="mb-0">
                            <n:i class="fas fa-file-audio me-2"></n:i>Speech to Text
                        </n:h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Model Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Modelo</label>
                            <combobox placeholder="Seleccionar modelo..." 
                                     model="@load(vm.availableModels)"
                                     selectedItem="@bind(vm.selectedSTTModel)"
                                     sclass="form-control"/>
                        </div>

                        <!-- Language -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Idioma (Opcional)</label>
                            <combobox model="@load(vm.availableLanguages)"
                                     selectedItem="@bind(vm.transcriptionLanguage)"
                                     sclass="form-control"
                                     placeholder="Auto-detectar"/>
                        </div>

                        <!-- Audio Upload -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Archivo de Audio</label>
                            <div class="border rounded p-4 text-center bg-light">
                                <n:i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></n:i>
                                <n:p class="mb-2">Arrastra tu archivo de audio aquí</n:p>
                                <n:p class="small text-muted mb-3">o</n:p>
                                <button label="Seleccionar Archivo" iconSclass="fas fa-folder-open" 
                                        sclass="btn btn-primary"
                                        onClick="@command('selectAudioFile')"/>
                                <n:p class="small text-muted mt-3 mb-0">
                                    Formatos: MP3, WAV, M4A, FLAC (máx. 25 MB)
                                </n:p>
                            </div>
                        </div>

                        <div if="${not empty vm.selectedAudioFile}" class="mb-3 p-3 bg-light rounded">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <n:i class="fas fa-file-audio me-2"></n:i>
                                    <label value="@load(vm.selectedAudioFile)"/>
                                </div>
                                <button iconSclass="fas fa-times" 
                                        sclass="btn btn-sm btn-outline-danger"
                                        onClick="@command('clearAudioFile')"/>
                            </div>
                        </div>

                        <button label="Transcribir Audio" iconSclass="fas fa-microphone" 
                                sclass="btn btn-primary w-100"
                                disabled="@load(empty vm.selectedAudioFile)"
                                onClick="@command('transcribeAudio')"/>

                        <!-- Transcription Result -->
                        <div if="${not empty vm.transcriptionText}" class="mt-4">
                            <label class="form-label fw-semibold">Transcripción</label>
                            <div class="p-3 bg-light rounded">
                                <n:p class="mb-0">${vm.transcriptionText}</n:p>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <n:small class="text-muted">
                                    Tiempo: <label value="@load(vm.processingTime)"/>ms · 
                                    Costo: $<label value="@load(vm.transcriptionCost) @converter('formattedNumber', format='0.0000')"/>
                                </n:small>
                                <button label="Copiar" iconSclass="fas fa-copy" 
                                        sclass="btn btn-sm btn-outline-primary"
                                        onClick="@command('copyTranscription')"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- History -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white border-0 p-3">
                <n:h6 class="mb-0 fw-bold">
                    <n:i class="fas fa-history me-2"></n:i>Historial
                </n:h6>
            </div>
            <div class="card-body p-0">
                <grid model="@load(vm.voiceHistory)" emptyMessage="No hay conversiones previas"
                      sclass="table table-hover">
                    <columns>
                        <column label="Tipo" width="15%"/>
                        <column label="Contenido" width="50%"/>
                        <column label="Configuración" width="20%"/>
                        <column label="Duración" width="10%"/>
                        <column label="Fecha" width="15%"/>
                        <column label="Acciones" width="5%" align="center"/>
                    </columns>
                    <template name="model">
                        <row>
                            <label>
                                <n:span if="${each.voicetype eq 'TEXT_TO_SPEECH'}" class="badge bg-info">TTS</n:span>
                                <n:span if="${each.voicetype eq 'SPEECH_TO_TEXT'}" class="badge bg-primary">STT</n:span>
                            </label>
                            <label value="@load(each.voicetext)" style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"/>
                            <label>
                                <n:small class="text-muted">
                                    ${each.voicename} · ${each.voicelanguage}
                                </n:small>
                            </label>
                            <label value="@load(each.voiceduration)"/>s
                            <label value="@load(each.voicecreatedat) @converter('formattedDate', format='dd/MM/yyyy HH:mm')"/>
                            <div class="btn-group btn-group-sm">
                                <button iconSclass="fas fa-eye" tooltiptext="Ver"
                                        sclass="btn btn-sm btn-outline-primary"
                                        onClick="@command('viewVoice', voice=each)"/>
                                <button iconSclass="fas fa-trash" tooltiptext="Eliminar"
                                        sclass="btn btn-sm btn-outline-danger"
                                        onClick="@command('deleteVoice', voice=each)"/>
                            </div>
                        </row>
                    </template>
                </grid>
            </div>
        </div>

    </div>
</zk>
