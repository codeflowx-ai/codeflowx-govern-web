<?page title="Translation Playground - CodeflowX Govern" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/theme/console/css/console-custom.css"/>
    
    <n:div viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.playground.PlaygroundTranslationViewModel')"
         class="content-wrapper" style="min-height: 100vh; background: #f8f9fa;">
        
        <!-- Header -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body p-4">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <n:h4 class="mb-1 fw-bold">
                            <n:i class="fas fa-language text-warning me-2"></n:i>Translation Playground
                        </n:h4>
                        <n:p class="text-muted mb-0">Traduce textos entre múltiples idiomas con IA</n:p>
                    </n:div>
                    <button label="Nueva Sesión" iconSclass="fas fa-plus" 
                            sclass="btn btn-warning"
                            onClick="@command('newSession')"/>
                </n:div>
            </n:div>
        </n:div>

        <!-- Main Translation Area -->
        <n:div class="card border-0 shadow-lg mb-4">
            <n:div class="card-body p-4">
                <n:div class="row g-4">
                    <!-- Source Language -->
                    <n:div class="col-md-5">
                        <n:div class="mb-3">
                            <label class="form-label fw-semibold">Idioma Origen</label>
                            <n:div class="d-flex gap-2">
                                <combobox model="@load(vm.availableLanguages)"
                                         selectedItem="@bind(vm.sourceLanguage)"
                                         sclass="form-control"/>
                                <button iconSclass="fas fa-microphone" tooltiptext="Transcribir"
                                        sclass="btn btn-outline-primary"
                                        onClick="@command('transcribeSource')"/>
                            </n:div>
                        </n:div>
                        <textbox multiline="true" rows="12" 
                                value="@bind(vm.sourceText)"
                                sclass="form-control"
                                placeholder="Ingresa el texto a traducir..."
                                style="font-size: 1rem;"/>
                        <n:p class="mt-2 mb-0 text-muted small">
                            Caracteres: <label value="@load(vm.sourceText.length())"/>
                        </n:p>
                    </n:div>

                    <!-- Translation Controls -->
                    <n:div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                        <button iconSclass="fas fa-exchange-alt fa-2x" 
                                tooltiptext="Intercambiar idiomas"
                                sclass="btn btn-lg btn-outline-secondary rounded-circle mb-3"
                                style="width: 60px; height: 60px;"
                                onClick="@command('swapLanguages')"/>
                        
                        <button label="Traducir" iconSclass="fas fa-language" 
                                sclass="btn btn-warning btn-lg"
                                disabled="@load(empty vm.sourceText)"
                                onClick="@command('translate')"/>

                        <n:div class="mt-4 text-center">
                            <n:p class="small text-muted mb-2">Modelo</n:p>
                            <combobox placeholder="Seleccionar..." 
                                     model="@load(vm.availableModels)"
                                     selectedItem="@bind(vm.selectedModel)"
                                     sclass="form-control form-control-sm"/>
                        </n:div>
                    </n:div>

                    <!-- Target Language -->
                    <n:div class="col-md-5">
                        <n:div class="mb-3">
                            <label class="form-label fw-semibold">Idioma Destino</label>
                            <n:div class="d-flex gap-2">
                                <combobox model="@load(vm.availableLanguages)"
                                         selectedItem="@bind(vm.targetLanguage)"
                                         sclass="form-control"/>
                                <button iconSclass="fas fa-volume-up" tooltiptext="Leer en voz alta"
                                        sclass="btn btn-outline-success"
                                        disabled="@load(empty vm.targetText)"
                                        onClick="@command('speakTarget')"/>
                            </n:div>
                        </n:div>
                        <n:div class="p-3 bg-light rounded" style="min-height: 300px; max-height: 300px; overflow-y: auto;">
                            <n:p if="${empty vm.targetText}" class="text-muted text-center mt-5">
                                La traducción aparecerá aquí...
                            </n:p>
                            <n:p if="${not empty vm.targetText}" style="font-size: 1rem; white-space: pre-wrap;">
                                ${vm.targetText}
                            </n:p>
                        </n:div>
                        <n:div class="mt-2 d-flex justify-content-between align-items-center">
                            <n:p class="mb-0 text-muted small">
                                Caracteres: <label value="@load(vm.targetText.length())"/> · 
                                Confianza: <label value="@load(vm.confidence)"/>%
                            </n:p>
                            <button label="Copiar" iconSclass="fas fa-copy" 
                                    sclass="btn btn-sm btn-outline-primary"
                                    disabled="@load(empty vm.targetText)"
                                    onClick="@command('copyTranslation')"/>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Translation History -->
        <n:div class="card border-0 shadow-sm">
            <n:div class="card-header bg-white border-0 p-3">
                <n:div class="d-flex justify-content-between align-items-center">
                    <n:h6 class="mb-0 fw-bold">
                        <n:i class="fas fa-history me-2"></n:i>Historial de Traducciones
                    </n:h6>
                    <textbox placeholder="Buscar..." value="@bind(vm.searchTerm)"
                             sclass="form-control form-control-sm" style="width: 250px;"
                             onChange="@command('search')"/>
                </n:div>
            </n:div>
            <n:div class="card-body p-0">
                <grid model="@load(vm.translationHistory)" emptyMessage="No hay traducciones previas"
                      sclass="table table-hover">
                    <columns>
                        <column label="Texto Origen" width="35%"/>
                        <column label="Traducción" width="35%"/>
                        <column label="Idiomas" width="10%" align="center"/>
                        <column label="Confianza" width="8%" align="center"/>
                        <column label="Fecha" width="12%"/>
                        <column label="Acciones" width="5%" align="center"/>
                    </columns>
                    <template name="model">
                        <row>
                            <label value="@load(each.translationsourcetext)" 
                                   style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"/>
                            <label value="@load(each.translationtargettext)" 
                                   style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"/>
                            <label>
                                <n:span class="badge bg-primary">${each.translationsourcelanguage}</n:span>
                                <n:i class="fas fa-arrow-right mx-1 small"></n:i>
                                <n:span class="badge bg-success">${each.translationtargetlanguage}</n:span>
                            </label>
                            <label>
                                <n:span class="badge bg-info">
                                    <label value="@load(each.translationconfidence)"/>%
                                </n:span>
                            </label>
                            <label value="@load(each.translationcreatedat) @converter('formattedDate', format='dd/MM/yyyy HH:mm')"/>
                            <n:div class="btn-group btn-group-sm">
                                <button iconSclass="fas fa-redo" tooltiptext="Re-usar"
                                        sclass="btn btn-sm btn-outline-primary"
                                        onClick="@command('reuseTranslation', translation=each)"/>
                                <button iconSclass="fas fa-trash" tooltiptext="Eliminar"
                                        sclass="btn btn-sm btn-outline-danger"
                                        onClick="@command('deleteItem', translation=each)"/>
                            </n:div>
                        </row>
                    </template>
                </grid>
            </n:div>
            <n:div class="card-footer bg-white border-0 p-3" if="${vm.totalSize > vm.pageSize}">
                <paging pageSize="@load(vm.pageSize)" totalSize="@load(vm.totalSize)" 
                        activePage="@bind(vm.activePage)" onPaging="@command('changePage')"
                        sclass="pagination pagination-sm justify-content-end mb-0"/>
            </n:div>
        </n:div>

    </n:div>
</zk>
