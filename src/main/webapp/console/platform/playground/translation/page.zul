<?xml version="1.0" encoding="UTF-8"?>
<zk>
<window title="Playground Translation" border="normal" width="100%" height="100%" 
        apply="com.codeflowx.platform.viewmodel.playground.PlaygroundTranslationViewModel">
    
    <style src="/css/bootstrap.min.css"/>
    <style src="/css/custom.css"/>
    
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/playground/page.zul">Playground</a></li>
                        <li class="breadcrumb-item active">Translation</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-0 text-primary">
                    <i class="fas fa-language me-2"></i>AI Translation
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Translator</h5>
                            <div>
                                <select class="form-select form-select-sm d-inline-block w-auto" model="@bind(vm.translationModel)">
                                    <option value="gpt-4">GPT-4</option>
                                    <option value="gpt-3.5">GPT-3.5</option>
                                    <option value="deepl">DeepL</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Source Text -->
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label class="form-label">Source Language</label>
                                    <select class="form-select" model="@bind(vm.sourceLanguage)">
                                        <option value="en">English</option>
                                        <option value="es">Spanish</option>
                                        <option value="fr">French</option>
                                        <option value="de">German</option>
                                        <option value="it">Italian</option>
                                        <option value="pt">Portuguese</option>
                                        <option value="auto">Auto-detect</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <textarea class="form-control" rows="10" model="@bind(vm.sourceText)" 
                                              placeholder="Enter text to translate..."></textarea>
                                </div>
                                <div class="text-muted small">
                                    Characters: ${vm.sourceTextLength} | 
                                    <span visible="@bind(vm.sourceToxicityScore > 0)">
                                        Toxicity: <span class="text-${vm.sourceToxicityScore > 0.5 ? 'danger' : 'warning'}">${vm.sourceToxicityScore}</span>
                                    </span>
                                </div>
                            </div>

                            <!-- Translation Controls -->
                            <div class="col-md-2 d-flex align-items-center justify-content-center">
                                <div class="text-center">
                                    <button class="btn btn-primary rounded-circle mb-3" onClick="@command('translate')" 
                                            disabled="@bind(vm.isTranslating)">
                                        <i class="fas fa-arrow-right fa-2x"></i>
                                    </button>
                                    <div>
                                        <button class="btn btn-outline-secondary btn-sm" onClick="@command('swapLanguages')">
                                            <i class="fas fa-exchange-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Translated Text -->
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label class="form-label">Target Language</label>
                                    <select class="form-select" model="@bind(vm.targetLanguage)">
                                        <option value="en">English</option>
                                        <option value="es">Spanish</option>
                                        <option value="fr">French</option>
                                        <option value="de">German</option>
                                        <option value="it">Italian</option>
                                        <option value="pt">Portuguese</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <textarea class="form-control" rows="10" model="@bind(vm.translatedText)" 
                                              readonly="" placeholder="Translation will appear here..."></textarea>
                                </div>
                                <div class="text-muted small">
                                    Quality Score: <span class="text-success">${vm.translationQuality}</span> |
                                    Characters: ${vm.translatedTextLength}
                                </div>
                            </div>
                        </div>

                        <!-- Compliance Monitor -->
                        <div class="row mt-3" visible="@bind(vm.showComplianceMonitor)">
                            <div class="col-12">
                                <div class="alert alert-${vm.complianceAlertType}">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-shield-alt fa-2x me-3"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="alert-heading mb-1">Compliance Analysis</h6>
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <small>Content Violation:</small>
                                                    <span class="badge bg-${vm.contentViolation ? 'danger' : 'success'} ms-1">
                                                        ${vm.contentViolation ? 'YES' : 'NO'}
                                                    </span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small>PII Detected:</small>
                                                    <span class="badge bg-${vm.piiDetected ? 'danger' : 'success'} ms-1">
                                                        ${vm.piiDetected ? 'YES' : 'NO'}
                                                    </span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small>Toxicity:</small>
                                                    <span class="badge bg-${vm.toxicityScore > 0.5 ? 'danger' : 'success'} ms-1">
                                                        ${vm.toxicityScore}
                                                    </span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small>Quality:</small>
                                                    <span class="badge bg-success ms-1">${vm.translationQuality}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Translation History -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Translation History</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Source Text</th>
                                        <th>Translation</th>
                                        <th>Languages</th>
                                        <th>Quality</th>
                                        <th>Compliance</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template name="translation" var="tr">
                                        <tr>
                                            <td><small>${vm.truncate(tr.sourcetext, 50)}</small></td>
                                            <td><small>${vm.truncate(tr.translatedtext, 50)}</small></td>
                                            <td><small>${tr.sourcelanguage} → ${tr.targetlanguage}</small></td>
                                            <td><span class="badge bg-success">${tr.translationquality}</span></td>
                                            <td>
                                                <span class="badge bg-${tr.contentviol ? 'danger' : 'success'}">
                                                    ${tr.contentviol ? 'Warning' : 'Clean'}
                                                </span>
                                            </td>
                                            <td><small>${vm.formatDate(tr.translationcreatedat)}</small></td>
                                            <td>
                                                <button class="btn btn-outline-primary btn-sm" onClick="@command('viewTranslation', translation=tr)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"/>
</window>
</zk>
