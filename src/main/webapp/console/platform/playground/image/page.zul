<?xml version="1.0" encoding="UTF-8"?>
<zk>
<window title="Playground Voice" border="normal" width="100%" height="100%" 
        apply="com.codeflowx.platform.viewmodel.playground.PlaygroundVoiceViewModel">
    
    <style src="/css/bootstrap.min.css"/>
    <style src="/css/custom.css"/>
    
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/playground/page.zul">Playground</a></li>
                        <li class="breadcrumb-item active">Voice</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-0 text-primary">
                    <i class="fas fa-microphone me-2"></i>Voice Processing (TTS & STT)
                </h1>
            </div>
        </div>

        <div class="row">
            <!-- Text-to-Speech Panel -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-volume-up me-2"></i>Text-to-Speech</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Text</label>
                            <textarea class="form-control" rows="6" model="@bind(vm.ttsText)" 
                                      placeholder="Enter text to convert to speech..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Language</label>
                            <select class="form-select" model="@bind(vm.ttsLanguage)">
                                <option value="en-US">English (US)</option>
                                <option value="es-ES">Spanish (Spain)</option>
                                <option value="fr-FR">French</option>
                                <option value="de-DE">German</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Voice</label>
                            <select class="form-select" model="@bind(vm.ttsVoice)">
                                <option value="alloy">Alloy</option>
                                <option value="echo">Echo</option>
                                <option value="fable">Fable</option>
                                <option value="onyx">Onyx</option>
                            </select>
                        </div>
                        <button class="btn btn-primary w-100 mb-3" onClick="@command('generateSpeech')" 
                                disabled="@bind(vm.isGenerating)">
                            <i class="fas fa-magic me-1"></i>Generate Speech
                        </button>
                        
                        <!-- Audio Player -->
                        <div class="mb-3" visible="@bind(vm.ttsAudioUrl != null)">
                            <audio controls="" class="w-100" src="${vm.ttsAudioUrl}"></audio>
                        </div>
                        
                        <!-- Compliance Alerts -->
                        <div visible="@bind(vm.ttsContentViolation || vm.ttsToxicityScore > 0.5)">
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <span visible="@bind(vm.ttsContentViolation)">Content Warning </span>
                                <span visible="@bind(vm.ttsToxicityScore > 0.5)">High Toxicity (${vm.ttsToxicityScore})</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Speech-to-Text Panel -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-microphone me-2"></i>Speech-to-Text</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Upload Audio</label>
                            <input type="file" class="form-control" accept="audio/*" 
                                   onChange="@command('uploadAudio')"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Language</label>
                            <select class="form-select" model="@bind(vm.sttLanguage)">
                                <option value="en">English</option>
                                <option value="es">Spanish</option>
                                <option value="fr">French</option>
                                <option value="de">German</option>
                                <option value="auto">Auto-detect</option>
                            </select>
                        </div>
                        <button class="btn btn-info w-100 mb-3" onClick="@command('transcribeAudio')" 
                                disabled="@bind(vm.isTranscribing)">
                            <i class="fas fa-magic me-1"></i>Transcribe
                        </button>
                        
                        <!-- Transcription Result -->
                        <div class="mb-3" visible="@bind(vm.sttTranscription != null)">
                            <label class="form-label">Transcription</label>
                            <textarea class="form-control" rows="6" readonly="" 
                                      model="@bind(vm.sttTranscription)"></textarea>
                        </div>
                        
                        <!-- Compliance Alerts -->
                        <div visible="@bind(vm.sttContentViolation || vm.sttPiiDetected)">
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <span visible="@bind(vm.sttContentViolation)">Content Warning </span>
                                <span visible="@bind(vm.sttPiiDetected)">PII Detected</span>
                            </div>
                        </div>
                        
                        <!-- Stats -->
                        <div class="mt-3" visible="@bind(vm.sttDuration != null)">
                            <small class="text-muted">
                                Duration: ${vm.sttDuration}s | 
                                Format: ${vm.sttFormat} | 
                                Cost: $${vm.sttCost}
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generated Images History -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Generation History</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Preview</th>
                                        <th>Prompt</th>
                                        <th>Model</th>
                                        <th>Size</th>
                                        <th>Compliance</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template name="image" var="img">
                                        <tr>
                                            <td><img src="${img.imageurl}" style="width: 50px; height: 50px; object-fit: cover;" class="rounded"/></td>
                                            <td><small>${img.imageprompt}</small></td>
                                            <td><span class="badge bg-secondary">${img.imagemodel}</span></td>
                                            <td><small>${img.imagesize}</small></td>
                                            <td>
                                                <span class="badge bg-${img.nsfwdetected ? 'danger' : 'success'}">
                                                    ${img.nsfwdetected ? 'NSFW' : 'Safe'}
                                                </span>
                                            </td>
                                            <td><small>${vm.formatDate(img.imagecreatedat)}</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" onClick="@command('viewImage', image=img)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-secondary" onClick="@command('downloadImage', image=img)">
                                                        <i class="fas fa-download"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"/>
</window>
</zk>