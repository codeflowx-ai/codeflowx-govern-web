<?page title="Image Generation - CodeflowX Govern" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/theme/console/css/console-custom.css"/>
    
    <n:div viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.playground.PlaygroundImageViewModel')"
         class="content-wrapper" style="min-height: 100vh; background: #f8f9fa;">
        
        <!-- Header -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body p-4">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <n:h4 class="mb-1 fw-bold">
                            <n:i class="fas fa-image text-success me-2"></n:i>Generación de Imágenes
                        </n:h4>
                        <n:p class="text-muted mb-0">Crea imágenes únicas a partir de descripciones textuales</n:p>
                    </n:div>
                    <button label="Nueva Sesión" iconSclass="fas fa-plus" 
                            sclass="btn btn-success"
                            onClick="@command('newSession')"/>
                </n:div>
            </n:div>
        </n:div>

        <n:div class="row g-4">
            <!-- Configuration Panel -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-header bg-white border-0 p-3">
                        <n:h6 class="mb-0 fw-bold">
                            <n:i class="fas fa-cog me-2"></n:i>Configuración
                        </n:h6>
                    </n:div>
                    <n:div class="card-body p-3">
                        <!-- Model Selection -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Modelo</label>
                            <combobox placeholder="Seleccionar modelo..." 
                                     model="@load(vm.availableModels)"
                                     selectedItem="@bind(vm.selectedModel)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Image Size -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Tamaño</label>
                            <combobox model="@load(vm.availableSizes)"
                                     selectedItem="@bind(vm.selectedSize)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Quality -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Calidad</label>
                            <combobox model="@load(vm.availableQualities)"
                                     selectedItem="@bind(vm.selectedQuality)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Format -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Formato</label>
                            <combobox model="@load(vm.availableFormats)"
                                     selectedItem="@bind(vm.selectedFormat)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Style -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Estilo (Opcional)</label>
                            <textbox value="@bind(vm.style)" 
                                    sclass="form-control"
                                    placeholder="ej: realistic, cartoon"/>
                        </n:div>

                        <!-- Session Info -->
                        <n:div class="border-top pt-3 mt-3">
                            <n:p class="small text-muted mb-2">
                                <n:strong>Imágenes:</n:strong> <label value="@load(vm.imageCount)"/>
                            </n:p>
                            <n:p class="small text-muted mb-0">
                                <n:strong>Costo Total:</n:strong> $<label value="@load(vm.totalCost) @converter('formattedNumber', format='0.00')"/>
                            </n:p>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Generation Area -->
            <n:div class="col-md-9">
                <!-- Prompt Input -->
                <n:div class="card border-0 shadow-sm mb-4">
                    <n:div class="card-body p-4">
                        <label class="form-label fw-semibold">Prompt</label>
                        <textbox multiline="true" rows="3" 
                                value="@bind(vm.prompt)"
                                sclass="form-control mb-3"
                                placeholder="Describe la imagen que quieres generar en detalle..."/>
                        
                        <label class="form-label fw-semibold">Negative Prompt (Opcional)</label>
                        <textbox multiline="true" rows="2" 
                                value="@bind(vm.negativePrompt)"
                                sclass="form-control mb-3"
                                placeholder="Elementos que no quieres en la imagen..."/>
                        
                        <n:div class="d-flex justify-content-end">
                            <button label="Generar Imagen" iconSclass="fas fa-magic" 
                                    sclass="btn btn-success btn-lg"
                                    disabled="@load(empty vm.prompt)"
                                    onClick="@command('generateImage')"/>
                        </n:div>
                    </n:div>
                </n:div>

                <!-- Generated Images Grid -->
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-header bg-white border-0 p-3">
                        <n:h6 class="mb-0 fw-bold">
                            <n:i class="fas fa-images me-2"></n:i>Imágenes Generadas
                        </n:h6>
                    </n:div>
                    <n:div class="card-body p-4">
                        <n:div if="${empty vm.generatedImages}" class="text-center text-muted py-5">
                            <n:i class="fas fa-image fa-3x mb-3 opacity-25"></n:i>
                            <n:p>No hay imágenes generadas aún</n:p>
                        </n:div>
                        
                        <n:div class="row g-4">
                            <n:div forEach="${vm.generatedImages}" class="col-md-4">
                                <n:div class="card border-0 shadow-sm h-100">
                                    <n:img src="${each.imageurl}" class="card-img-top" 
                                           style="height: 250px; object-fit: cover;" alt="Generated image"/>
                                    <n:div class="card-body p-3">
                                        <n:p class="small text-muted mb-2">${each.imageprompt}</n:p>
                                        <n:div class="d-flex justify-content-between align-items-center">
                                            <n:span class="badge bg-success">${each.imagestatus}</n:span>
                                            <n:div class="btn-group btn-group-sm">
                                                <button iconSclass="fas fa-download" tooltiptext="Descargar"
                                                        sclass="btn btn-sm btn-outline-primary"
                                                        onClick="@command('downloadImage', image=each)"/>
                                                <button iconSclass="fas fa-trash" tooltiptext="Eliminar"
                                                        sclass="btn btn-sm btn-outline-danger"
                                                        onClick="@command('deleteItem', image=each)"/>
                                            </n:div>
                                        </n:div>
                                        <n:p class="mb-0 mt-2 text-muted" style="font-size: 0.75rem;">
                                            <label value="@load(each.imagegenerationtime)"/>ms · 
                                            $<label value="@load(each.imagecost) @converter('formattedNumber', format='0.0000')"/>
                                        </n:p>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

    </n:div>
</zk>
