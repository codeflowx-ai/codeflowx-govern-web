<?page title="Chat Playground - CodeflowX Govern" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/theme/console/css/console-custom.css"/>
    
    <n:div viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.playground.PlaygroundChatViewModel')"
         class="content-wrapper" style="min-height: 100vh; background: #f8f9fa;">
        
        <!-- Header -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body p-4">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <n:h4 class="mb-1 fw-bold">
                            <n:i class="fas fa-comments text-primary me-2"></n:i>Chat Playground
                        </n:h4>
                        <n:p class="text-muted mb-0">Experimenta con modelos de lenguaje conversacionales</n:p>
                    </n:div>
                    <n:div class="d-flex gap-2">
                        <button label="Nueva Conversación" iconSclass="fas fa-plus" 
                                sclass="btn btn-primary"
                                onClick="@command('newConversation')"/>
                        <button label="Configuración" iconSclass="fas fa-cog" 
                                sclass="btn btn-outline-secondary"
                                onClick="@command('showConfig')"/>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <n:div class="row g-4">
            <!-- Chat Configuration Panel -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-header bg-white border-0 p-3">
                        <n:h6 class="mb-0 fw-bold">
                            <n:i class="fas fa-sliders-h me-2"></n:i>Configuración
                        </n:h6>
                    </n:div>
                    <n:div class="card-body p-3">
                        <!-- Model Selection -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Modelo</label>
                            <combobox placeholder="Seleccionar modelo..." 
                                     model="@load(vm.availableModels)"
                                     selectedItem="@bind(vm.selectedModel)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Agent Selection -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Agente (Opcional)</label>
                            <combobox placeholder="Seleccionar agente..." 
                                     model="@load(vm.availableAgents)"
                                     selectedItem="@bind(vm.selectedAgent)"
                                     sclass="form-control"/>
                        </n:div>

                        <!-- Temperature -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Temperatura: <label value="@load(vm.temperature)"/>
                            </label>
                            <slider value="@bind(vm.temperature)" 
                                   mold="scale" maxpos="200" 
                                   sclass="form-range"/>
                            <n:small class="text-muted">Controla la creatividad (0.0 - 2.0)</n:small>
                        </n:div>

                        <!-- Max Tokens -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">Max Tokens</label>
                            <intbox value="@bind(vm.maxTokens)" 
                                   sclass="form-control"
                                   placeholder="4096"/>
                        </n:div>

                        <!-- System Prompt -->
                        <n:div class="mb-3">
                            <label class="form-label small fw-semibold">System Prompt</label>
                            <textbox multiline="true" rows="4" 
                                    value="@bind(vm.systemPrompt)"
                                    sclass="form-control"
                                    placeholder="Eres un asistente útil..."/>
                        </n:div>

                        <!-- Session Info -->
                        <n:div class="border-top pt-3 mt-3">
                            <n:p class="small text-muted mb-2">
                                <n:strong>Mensajes:</n:strong> <label value="@load(vm.messageCount)"/>
                            </n:p>
                            <n:p class="small text-muted mb-2">
                                <n:strong>Tokens:</n:strong> <label value="@load(vm.tokensUsed)"/>
                            </n:p>
                            <n:p class="small text-muted mb-0">
                                <n:strong>Costo:</n:strong> $<label value="@load(vm.sessionCost) @converter('formattedNumber', format='0.0000')"/>
                            </n:p>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Chat Area -->
            <n:div class="col-md-9">
                <n:div class="card border-0 shadow-sm" style="height: calc(100vh - 250px);">
                    <!-- Messages Container -->
                    <n:div class="card-body p-4" style="overflow-y: auto; height: calc(100% - 80px);" id="chatMessages">
                        <n:div if="${empty vm.messages}" class="text-center text-muted py-5">
                            <n:i class="fas fa-comments fa-3x mb-3 opacity-25"></n:i>
                            <n:p>No hay mensajes aún. ¡Comienza una conversación!</n:p>
                        </n:div>
                        
                        <n:div forEach="${vm.messages}" class="mb-3">
                            <n:div if="${each.chatrole eq 'USER'}" class="d-flex justify-content-end">
                                <n:div class="card bg-primary text-white border-0 shadow-sm" style="max-width: 75%;">
                                    <n:div class="card-body p-3">
                                        <n:p class="mb-0 small">${each.chatprompt}</n:p>
                                        <n:p class="mb-0 mt-2 opacity-75" style="font-size: 0.7rem;">
                                            <label value="@load(each.chatcreatedat) @converter('formattedDate', format='HH:mm')"/>
                                        </n:p>
                                    </n:div>
                                </n:div>
                            </n:div>
                            
                            <n:div if="${each.chatrole eq 'ASSISTANT'}" class="d-flex justify-content-start">
                                <n:div class="card bg-light border-0 shadow-sm" style="max-width: 75%;">
                                    <n:div class="card-body p-3">
                                        <n:p class="mb-0 small">${each.chatresponse}</n:p>
                                        <n:div class="d-flex justify-content-between align-items-center mt-2">
                                            <n:p class="mb-0 text-muted" style="font-size: 0.7rem;">
                                                <label value="@load(each.chatcreatedat) @converter('formattedDate', format='HH:mm')"/>
                                                · <label value="@load(each.chattokensused)"/> tokens
                                                · <label value="@load(each.chatlatency)"/>ms
                                            </n:p>
                                        </n:div>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>

                    <!-- Input Area -->
                    <n:div class="card-footer bg-white border-top p-3">
                        <n:div class="d-flex gap-2">
                            <textbox multiline="true" rows="2" 
                                    value="@bind(vm.currentPrompt)"
                                    sclass="form-control"
                                    placeholder="Escribe tu mensaje aquí..."
                                    style="flex: 1;"/>
                            <button label="Enviar" iconSclass="fas fa-paper-plane" 
                                    sclass="btn btn-primary"
                                    disabled="@load(empty vm.currentPrompt)"
                                    onClick="@command('sendMessage')"/>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

    </n:div>
</zk>
