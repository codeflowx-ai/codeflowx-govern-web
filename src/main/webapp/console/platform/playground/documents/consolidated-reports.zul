<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="📊 Consolidated Reports" border="normal" width="100%" height="100%"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.platform.viewmodels.playground.documents.ConsolidatedReportsViewModel')">
        
        <hlayout style="padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px; margin-bottom: 20px;">
            <vlayout hflex="1">
                <label value="@load(vm.reportTitle)" style="font-size: 32px; font-weight: bold;"/>
                <hlayout spacing="15px" style="margin-top: 10px;">
                    <label value="Generated: @load(vm.generationDate) @converter('formatedDate', format='dd/MM/yyyy HH:mm')"/>
                    <separator width="20px"/>
                    <label value="Documents: @load(vm.documentsProcessed)"/>
                    <separator width="20px"/>
                    <label value="Processing Time: @load(vm.totalProcessingTime) s"/>
                </hlayout>
            </vlayout>
            <vlayout style="text-align: right;">
                <button label="Export PDF" onClick="@command('exportAsPdf')" iconSclass="z-icon-file-pdf" 
                        style="background-color: white; color: #ef4444;"/>
                <button label="Export Word" onClick="@command('exportAsWord')" iconSclass="z-icon-file-word" 
                        style="background-color: white; color: #3b82f6; margin-top: 10px;"/>
            </vlayout>
        </hlayout>
        
        <!-- Executive Summary -->
        <groupbox closable="false">
            <caption label="Executive Summary"/>
            <textbox value="@load(vm.executiveSummary)" multiline="true" rows="10" width="100%" readonly="true"
                     style="font-size: 14px; line-height: 1.6;"/>
        </groupbox>
        
        <!-- Document Analyses -->
        <groupbox style="margin-top: 20px;" closable="false">
            <caption label="Document Analyses"/>
            <listbox model="@load(vm.documentAnalyses)" height="400px" emptyMessage="No documents in this report">
                <listhead>
                    <listheader label="Filename" width="300px"/>
                    <listheader label="Summary" hflex="1"/>
                </listhead>
                <template name="model" var="analysis">
                    <listitem>
                        <listcell label="@load(analysis.filename)" style="font-weight: bold;"/>
                        <listcell label="@load(analysis.summary)" style="font-size: 12px; color: #666;"/>
                    </listitem>
                </template>
            </listbox>
        </groupbox>
    </window>
</zk>

