<?page title="Playground - CodeflowX Govern" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <style src="/theme/console/css/console-custom.css"/>
    
    <n:div viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.playground.PlaygroundOverviewViewModel')"
         class="content-wrapper" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;">
        
        <!-- Header -->
        <n:div class="d-flex justify-content-between align-items-center mb-4" style="padding: 2rem;">
            <div>
                <n:h2 class="mb-2" style="color: white; font-weight: 700;">
                    <n:i class="fas fa-flask me-2"></n:i>AI Playground
                </n:h2>
                <n:p class="text-white-50 mb-0">Experimenta con diferentes capacidades de IA</n:p>
            </n:div>
            <button label="Nueva Sesión" iconSclass="fas fa-plus" 
                    sclass="btn btn-light btn-lg shadow-sm"
                    onClick="@command('createSession')"/>
        </n:div>

        <!-- Statistics Cards -->
        <n:div class="row g-4 mb-4" style="padding: 0 2rem;">
            <!-- Total Sessions -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-lg" style="background: rgba(255,255,255,0.95);">
                    <n:div class="card-body">
                        <n:div class="d-flex align-items-center">
                            <n:div class="flex-shrink-0 bg-primary bg-opacity-10 rounded-3 p-3">
                                <n:i class="fas fa-comments fa-2x text-primary"></n:i>
                            </n:div>
                            <n:div class="flex-grow-1 ms-3">
                                <n:h3 class="mb-0 fw-bold">
                                    <label value="@load(vm.totalSessions)"/>
                                </n:h3>
                                <n:p class="text-muted mb-0 small">Sesiones Totales</n:p>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Active Sessions -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-lg" style="background: rgba(255,255,255,0.95);">
                    <n:div class="card-body">
                        <n:div class="d-flex align-items-center">
                            <n:div class="flex-shrink-0 bg-success bg-opacity-10 rounded-3 p-3">
                                <n:i class="fas fa-play-circle fa-2x text-success"></n:i>
                            </n:div>
                            <n:div class="flex-grow-1 ms-3">
                                <n:h3 class="mb-0 fw-bold">
                                    <label value="@load(vm.activeSessions)"/>
                                </n:h3>
                                <n:p class="text-muted mb-0 small">Sesiones Activas</n:p>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Total Messages -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-lg" style="background: rgba(255,255,255,0.95);">
                    <n:div class="card-body">
                        <n:div class="d-flex align-items-center">
                            <n:div class="flex-shrink-0 bg-info bg-opacity-10 rounded-3 p-3">
                                <n:i class="fas fa-message fa-2x text-info"></n:i>
                            </n:div>
                            <n:div class="flex-grow-1 ms-3">
                                <n:h3 class="mb-0 fw-bold">
                                    <label value="@load(vm.totalMessages)"/>
                                </n:h3>
                                <n:p class="text-muted mb-0 small">Mensajes Totales</n:p>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Total Cost -->
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-lg" style="background: rgba(255,255,255,0.95);">
                    <n:div class="card-body">
                        <n:div class="d-flex align-items-center">
                            <n:div class="flex-shrink-0 bg-warning bg-opacity-10 rounded-3 p-3">
                                <n:i class="fas fa-dollar-sign fa-2x text-warning"></n:i>
                            </n:div>
                            <n:div class="flex-grow-1 ms-3">
                                <n:h3 class="mb-0 fw-bold">
                                    $<label value="@load(vm.totalCost) @converter('formattedNumber', format='###,##0.00')"/>
                                </n:h3>
                                <n:p class="text-muted mb-0 small">Costo Total</n:p>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Playground Modules -->
        <n:div class="row g-4 mb-4" style="padding: 0 2rem;">
            <!-- Chat Module -->
            <n:div class="col-md-4">
                <n:div class="card border-0 shadow-lg h-100 hover-lift" style="cursor: pointer; transition: all 0.3s;">
                    <n:div class="card-body text-center p-4" onClick="@command('openChat')">
                        <n:div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <n:i class="fas fa-comments fa-3x text-primary"></n:i>
                        </n:div>
                        <n:h4 class="mb-3 fw-bold">Chat</n:h4>
                        <n:p class="text-muted mb-3">
                            Conversa con modelos de lenguaje avanzados. Experimenta con diferentes parámetros y contextos.
                        </n:p>
                        <button label="Abrir Chat" iconSclass="fas fa-arrow-right" 
                                sclass="btn btn-primary"
                                onClick="@command('openChat')"/>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Image Module -->
            <n:div class="col-md-4">
                <n:div class="card border-0 shadow-lg h-100 hover-lift" style="cursor: pointer; transition: all 0.3s;">
                    <n:div class="card-body text-center p-4" onClick="@command('openImage')">
                        <n:div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <n:i class="fas fa-image fa-3x text-success"></n:i>
                        </n:div>
                        <n:h4 class="mb-3 fw-bold">Generación de Imágenes</n:h4>
                        <n:p class="text-muted mb-3">
                            Crea imágenes a partir de descripciones textuales. Experimenta con estilos y calidades.
                        </n:p>
                        <button label="Generar Imágenes" iconSclass="fas fa-arrow-right" 
                                sclass="btn btn-success"
                                onClick="@command('openImage')"/>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Voice Module -->
            <n:div class="col-md-4">
                <n:div class="card border-0 shadow-lg h-100 hover-lift" style="cursor: pointer; transition: all 0.3s;">
                    <n:div class="card-body text-center p-4" onClick="@command('openVoice')">
                        <n:div class="bg-info bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <n:i class="fas fa-microphone fa-3x text-info"></n:i>
                        </n:div>
                        <n:h4 class="mb-3 fw-bold">Voz</n:h4>
                        <n:p class="text-muted mb-3">
                            Convierte texto a voz y voz a texto. Experimenta con diferentes voces e idiomas.
                        </n:p>
                        <button label="Abrir Voz" iconSclass="fas fa-arrow-right" 
                                sclass="btn btn-info"
                                onClick="@command('openVoice')"/>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Translation Module -->
            <n:div class="col-md-4">
                <n:div class="card border-0 shadow-lg h-100 hover-lift" style="cursor: pointer; transition: all 0.3s;">
                    <n:div class="card-body text-center p-4" onClick="@command('openTranslation')">
                        <n:div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <n:i class="fas fa-language fa-3x text-warning"></n:i>
                        </n:div>
                        <n:h4 class="mb-3 fw-bold">Traducción</n:h4>
                        <n:p class="text-muted mb-3">
                            Traduce textos entre múltiples idiomas. Evalúa calidad y precisión de traducciones.
                        </n:p>
                        <button label="Traducir" iconSclass="fas fa-arrow-right" 
                                sclass="btn btn-warning"
                                onClick="@command('openTranslation')"/>
                    </n:div>
                </n:div>
            </n:div>

            <!-- Routing Module -->
            <n:div class="col-md-4">
                <n:div class="card border-0 shadow-lg h-100 hover-lift" style="cursor: pointer; transition: all 0.3s;">
                    <n:div class="card-body text-center p-4" onClick="@command('openRouting')">
                        <n:div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <n:i class="fas fa-route fa-3x text-danger"></n:i>
                        </n:div>
                        <n:h4 class="mb-3 fw-bold">Routing Inteligente</n:h4>
                        <n:p class="text-muted mb-3">
                            Enruta automáticamente consultas al modelo o agente más apropiado según el contexto.
                        </n:p>
                        <button label="Probar Routing" iconSclass="fas fa-arrow-right" 
                                sclass="btn btn-danger"
                                onClick="@command('openRouting')"/>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Recent Sessions -->
        <n:div class="card border-0 shadow-lg" style="margin: 0 2rem 2rem;">
            <n:div class="card-header bg-white border-0 p-4">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <n:h5 class="mb-1 fw-bold">
                            <n:i class="fas fa-history me-2"></n:i>Sesiones Recientes
                        </n:h5>
                        <n:p class="text-muted mb-0 small">Tus últimas interacciones con el playground</n:p>
                    </n:div>
                    <textbox placeholder="Buscar sesiones..." value="@bind(vm.searchTerm)"
                             sclass="form-control" style="width: 300px;"
                             onChange="@command('applyFilters')"/>
                </n:div>
            </n:div>
            <n:div class="card-body p-0">
                <grid model="@load(vm.sessionsList)" emptyMessage="No hay sesiones disponibles"
                      sclass="table table-hover">
                    <columns>
                        <column label="Nombre" width="25%"/>
                        <column label="Tipo" width="15%"/>
                        <column label="Estado" width="12%"/>
                        <column label="Mensajes" width="10%" align="center"/>
                        <column label="Tokens" width="10%" align="center"/>
                        <column label="Costo" width="10%" align="right"/>
                        <column label="Última Actividad" width="13%"/>
                        <column label="Acciones" width="5%" align="center"/>
                    </columns>
                    <template name="model">
                        <row>
                            <label value="@load(each.sessionname)" sclass="fw-semibold"/>
                            <label>
                                <n:span if="${each.sessiontype eq 'CHAT'}" class="badge bg-primary">
                                    <n:i class="fas fa-comments me-1"></n:i>Chat
                                </n:span>
                                <n:span if="${each.sessiontype eq 'IMAGE'}" class="badge bg-success">
                                    <n:i class="fas fa-image me-1"></n:i>Imagen
                                </n:span>
                                <n:span if="${each.sessiontype eq 'VOICE'}" class="badge bg-info">
                                    <n:i class="fas fa-microphone me-1"></n:i>Voz
                                </n:span>
                                <n:span if="${each.sessiontype eq 'TRANSLATION'}" class="badge bg-warning">
                                    <n:i class="fas fa-language me-1"></n:i>Traducción
                                </n:span>
                                <n:span if="${each.sessiontype eq 'ROUTING'}" class="badge bg-danger">
                                    <n:i class="fas fa-route me-1"></n:i>Routing
                                </n:span>
                            </label>
                            <label>
                                <n:span if="${each.sessionstatus eq 'ACTIVE'}" class="badge bg-success">Activo</n:span>
                                <n:span if="${each.sessionstatus eq 'INACTIVE'}" class="badge bg-secondary">Inactivo</n:span>
                                <n:span if="${each.sessionstatus eq 'COMPLETED'}" class="badge bg-primary">Completado</n:span>
                                <n:span if="${each.sessionstatus eq 'ERROR'}" class="badge bg-danger">Error</n:span>
                            </label>
                            <label value="@load(each.messagecount)" style="text-align: center;"/>
                            <label value="@load(each.tokensused) @converter('formattedNumber', format='###,###')" 
                                   style="text-align: center;"/>
                            <label value="@load(each.cost) @converter('formattedNumber', format='$###,##0.00')" 
                                   style="text-align: right;"/>
                            <label value="@load(each.sessionlastaccessat) @converter('formattedDate', format='dd/MM/yyyy HH:mm')"/>
                            <n:div class="btn-group btn-group-sm">
                                <button iconSclass="fas fa-eye" tooltiptext="Ver Detalles"
                                        sclass="btn btn-sm btn-outline-primary"
                                        onClick="@command('viewSession', session=each)"/>
                                <button iconSclass="fas fa-trash" tooltiptext="Eliminar"
                                        sclass="btn btn-sm btn-outline-danger"
                                        onClick="@command('deleteItem', session=each)"/>
                            </n:div>
                        </row>
                    </template>
                </grid>
            </n:div>
            <n:div class="card-footer bg-white border-0 p-3" if="${vm.totalSize > vm.pageSize}">
                <paging pageSize="@load(vm.pageSize)" totalSize="@load(vm.totalSize)" 
                        activePage="@bind(vm.activePage)" onPaging="@command('changePage')"
                        sclass="pagination pagination-sm justify-content-end mb-0"/>
            </n:div>
        </n:div>

    </n:div>
</zk>
