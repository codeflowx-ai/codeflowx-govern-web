<?xml version="1.0" encoding="UTF-8"?>
<zk>
<window title="Playground" border="normal" width="100%" height="100%" 
        apply="com.codeflowx.platform.viewmodel.playground.PlaygroundSessionsViewModel">
    
    <style src="/css/bootstrap.min.css"/>
    <style src="/css/custom.css"/>
    
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0 text-primary">
                            <i class="fas fa-rocket me-2"></i>AI Playground
                        </h1>
                        <p class="text-muted mb-0">Experiment with AI models in a controlled environment</p>
                    </div>
                    <div>
                        <button class="btn btn-primary" onClick="@command('createSession')">
                            <i class="fas fa-plus me-1"></i>New Session
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Playground Types Cards -->
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100" style="cursor: pointer;" onClick="@command('openChat')">
                    <div class="card-body">
                        <div class="bg-primary text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-comments fa-2x"></i>
                        </div>
                        <h6 class="card-title">Chat</h6>
                        <p class="text-muted small mb-0">Test conversational AI</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100" style="cursor: pointer;" onClick="@command('openImage')">
                    <div class="card-body">
                        <div class="bg-success text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-image fa-2x"></i>
                        </div>
                        <h6 class="card-title">Image</h6>
                        <p class="text-muted small mb-0">Generate images</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100" style="cursor: pointer;" onClick="@command('openVoice')">
                    <div class="card-body">
                        <div class="bg-info text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-microphone fa-2x"></i>
                        </div>
                        <h6 class="card-title">Voice</h6>
                        <p class="text-muted small mb-0">TTS & STT</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100" style="cursor: pointer;" onClick="@command('openTranslation')">
                    <div class="card-body">
                        <div class="bg-warning text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-language fa-2x"></i>
                        </div>
                        <h6 class="card-title">Translation</h6>
                        <p class="text-muted small mb-0">Multilingual AI</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100" style="cursor: pointer;" onClick="@command('openRouting')">
                    <div class="card-body">
                        <div class="bg-danger text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-route fa-2x"></i>
                        </div>
                        <h6 class="card-title">Routing</h6>
                        <p class="text-muted small mb-0">Agent selection</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body">
                        <div class="bg-secondary text-white rounded-circle p-3 mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-shield-alt fa-2x"></i>
                        </div>
                        <h6 class="card-title">Compliance</h6>
                        <p class="text-muted small mb-0">${vm.complianceRate}%</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-layer-group fa-2x text-primary"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="card-title text-muted mb-1">Active Sessions</h6>
                                <h4 class="mb-0 text-primary">${vm.activeSessions}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-coins fa-2x text-warning"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="card-title text-muted mb-1">Tokens Used</h6>
                                <h4 class="mb-0 text-warning">${vm.totalTokens}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-dollar-sign fa-2x text-success"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="card-title text-muted mb-1">Total Cost</h6>
                                <h4 class="mb-0 text-success">$${vm.totalCost}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="card-title text-muted mb-1">Violations</h6>
                                <h4 class="mb-0 text-danger">${vm.totalViolations}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sessions List -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">Recent Sessions</h5>
                            <div class="btn-group" role="group">
                                <button class="btn btn-outline-secondary btn-sm" onClick="@command('refreshSessions')">
                                    <i class="fas fa-sync-alt me-1"></i>Refresh
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Session</th>
                                        <th>Type</th>
                                        <th>User</th>
                                        <th>Status</th>
                                        <th>Compliance</th>
                                        <th>Risk</th>
                                        <th>Messages</th>
                                        <th>Cost</th>
                                        <th>Last Access</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template name="session" var="s">
                                        <tr>
                                            <td>
                                                <div>
                                                    <h6 class="mb-0">${s.sessionname}</h6>
                                                    <small class="text-muted">${s.sessiondescription}</small>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-secondary">${s.sessiontype}</span></td>
                                            <td><small>${s.sessioncreatedby}</small></td>
                                            <td><span class="badge bg-${vm.getStatusColor(s.sessionstatus)}">${s.sessionstatus}</span></td>
                                            <td><span class="badge bg-${vm.getComplianceColor(s.compliancestatus)}">${s.compliancestatus}</span></td>
                                            <td><span class="badge bg-${vm.getRiskColor(s.risklevel)}">${s.risklevel}</span></td>
                                            <td><span class="badge bg-info">${s.messagecount}</span></td>
                                            <td><small>$${s.cost}</small></td>
                                            <td><small>${vm.formatDate(s.sessionlastaccessat)}</small></td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" onClick="@command('openSession', session=s)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" onClick="@command('deleteSession', session=s)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"/>
</window>
</zk>
