<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="friaAssessmentPage"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.compliance.FriaAssessmentViewModel')"
		validationMessages="@id('vmsgs')">
		
		<h:div class="row">
			<!-- Header -->
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-scale-balanced label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="FRIA - Fundamental Rights Impact Assessment" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Evaluaciones de Impacto en Derechos Fundamentales según Art. 27" class="text-muted" />
					</h:p>
				</h:div>
			</div>
			
			<!-- KPIs Section -->
			<h:div class="col-lg-12 col-xlg-12 col-md-12 mb-4">
				<h:div class="row">
					<!-- KPI 1: Total FRIAs -->
					<h:div class="col-xl-3 col-md-6">
						<h:div class="card card-animate">
							<h:div class="card-body">
								<h:div class="d-flex align-items-center">
									<h:div class="flex-grow-1 overflow-hidden">
										<h:p class="text-uppercase fw-medium text-muted text-truncate mb-0">
											Total FRIAs
										</h:p>
									</h:div>
								</h:div>
								<h:div class="d-flex align-items-end justify-content-between mt-4">
									<h:div>
										<h:h4 class="fs-22 fw-semibold ff-secondary mb-4">
											<label value="@load(vm.totalFrias)" />
										</h:h4>
										<h:span class="badge bg-info me-1">Registradas</h:span>
									</h:div>
									<h:div class="avatar-sm flex-shrink-0">
										<h:span class="avatar-title bg-info-subtle rounded fs-3">
											<h:i class="fa-solid fa-file-lines text-info"></h:i>
										</h:span>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
					
					<!-- KPI 2: Art 27 Compliant -->
					<h:div class="col-xl-3 col-md-6">
						<h:div class="card card-animate">
							<h:div class="card-body">
								<h:div class="d-flex align-items-center">
									<h:div class="flex-grow-1 overflow-hidden">
										<h:p class="text-uppercase fw-medium text-muted text-truncate mb-0">
											Conformes Art. 27
										</h:p>
									</h:div>
								</h:div>
								<h:div class="d-flex align-items-end justify-content-between mt-4">
									<h:div>
										<h:h4 class="fs-22 fw-semibold ff-secondary mb-4">
											<label value="@load(vm.art27Compliant)" />
										</h:h4>
										<h:span class="badge bg-success me-1">Compliant</h:span>
									</h:div>
									<h:div class="avatar-sm flex-shrink-0">
										<h:span class="avatar-title bg-success-subtle rounded fs-3">
											<h:i class="fa-solid fa-circle-check text-success"></h:i>
										</h:span>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
					
					<!-- KPI 3: Approved -->
					<h:div class="col-xl-3 col-md-6">
						<h:div class="card card-animate">
							<h:div class="card-body">
								<h:div class="d-flex align-items-center">
									<h:div class="flex-grow-1 overflow-hidden">
										<h:p class="text-uppercase fw-medium text-muted text-truncate mb-0">
											Aprobadas
										</h:p>
									</h:div>
								</h:div>
								<h:div class="d-flex align-items-end justify-content-between mt-4">
									<h:div>
										<h:h4 class="fs-22 fw-semibold ff-secondary mb-4">
											<label value="@load(vm.approved)" />
										</h:h4>
										<h:span class="badge bg-primary me-1">Approved</h:span>
									</h:div>
									<h:div class="avatar-sm flex-shrink-0">
										<h:span class="avatar-title bg-primary-subtle rounded fs-3">
											<h:i class="fa-solid fa-thumbs-up text-primary"></h:i>
										</h:span>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
					
					<!-- KPI 4: Notified -->
					<h:div class="col-xl-3 col-md-6">
						<h:div class="card card-animate">
							<h:div class="card-body">
								<h:div class="d-flex align-items-center">
									<h:div class="flex-grow-1 overflow-hidden">
										<h:p class="text-uppercase fw-medium text-muted text-truncate mb-0">
											Notificadas Autoridad
										</h:p>
									</h:div>
								</h:div>
								<h:div class="d-flex align-items-end justify-content-between mt-4">
									<h:div>
										<h:h4 class="fs-22 fw-semibold ff-secondary mb-4">
											<label value="@load(vm.notified)" />
										</h:h4>
										<h:span class="badge bg-warning me-1">Notified</h:span>
									</h:div>
									<h:div class="avatar-sm flex-shrink-0">
										<h:span class="avatar-title bg-warning-subtle rounded fs-3">
											<h:i class="fa-solid fa-bell text-warning"></h:i>
										</h:span>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
			
			<!-- Filters and Actions -->
			<h:div class="col-lg-12 mb-3">
				<h:div class="card">
					<h:div class="card-body">
						<h:div class="row g-3">
							<!-- Impact Severity -->
							<h:div class="col-md-3">
								<label value="Severidad Impacto" class="form-label" />
								<combobox placeholder="Seleccione..."
									value="@bind(vm.filterImpactSeverity)"
									width="100%">
									<comboitem label="LOW" value="LOW" />
									<comboitem label="MEDIUM" value="MEDIUM" />
									<comboitem label="HIGH" value="HIGH" />
									<comboitem label="CRITICAL" value="CRITICAL" />
								</combobox>
							</h:div>
							
							<!-- Art 27 Compliant -->
							<h:div class="col-md-3">
								<label value="Conforme Art. 27" class="form-label" />
								<combobox placeholder="Todos..."
									value="@bind(vm.filterArt27Compliant)"
									width="100%">
									<comboitem label="Sí" value="true" />
									<comboitem label="No" value="false" />
								</combobox>
							</h:div>
							
							<!-- Approved -->
							<h:div class="col-md-2">
								<label value="Aprobada" class="form-label" />
								<combobox placeholder="Todos..."
									value="@bind(vm.filterApproved)"
									width="100%">
									<comboitem label="Sí" value="true" />
									<comboitem label="No" value="false" />
								</combobox>
							</h:div>
							
							<!-- Botones -->
							<h:div class="col-md-4 d-flex align-items-end justify-content-end">
								<button label="Buscar" iconSclass="fa fa-search"
									onClick="@command('search')"
									sclass="btn btn-primary me-2" />
								<button label="Limpiar" iconSclass="fa fa-eraser"
									onClick="@command('clearFilters')"
									sclass="btn btn-secondary me-2" />
								<button label="Nueva FRIA" iconSclass="fa fa-plus"
									onClick="@command('createNewFria')"
									sclass="btn btn-success" />
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
			
			<!-- Table -->
			<h:div class="col-lg-12">
				<h:div class="card">
					<h:div class="card-header">
						<h:h5 class="card-title mb-0">
							<h:i class="fa fa-list me-2"></h:i>
							FRIA Assessments
						</h:h5>
					</h:div>
					<h:div class="card-body">
						<listbox model="@load(vm.friaAssessments)"
							selectedItem="@bind(vm.selectedFria)"
							emptyMessage="No hay FRIAs registradas"
							mold="paging"
							pageSize="20">
							<listhead>
								<listheader label="ID" width="80px" />
								<listheader label="Proyecto" />
								<listheader label="Severidad" width="120px" />
								<listheader label="Art. 27" width="100px" />
								<listheader label="Aprobada" width="100px" />
								<listheader label="Notificada" width="100px" />
								<listheader label="DPIA" width="100px" />
								<listheader label="Acciones" width="150px" />
							</listhead>
							<template name="model">
								<listitem>
									<listcell label="@load(each.idxfriaassessment)" />
									<listcell label="@load(each.project.prjname)" />
									<listcell>
										<h:span class="@load(each.friaimpactseverity eq 'CRITICAL' ? 'badge bg-danger' : 
															  each.friaimpactseverity eq 'HIGH' ? 'badge bg-warning' : 
															  each.friaimpactseverity eq 'MEDIUM' ? 'badge bg-info' : 'badge bg-success')">
											<label value="@load(each.friaimpactseverity)" />
										</h:span>
									</listcell>
									<listcell>
										<h:span class="@load(each.friaart27compliant ? 'badge bg-success' : 'badge bg-danger')">
											<label value="@load(each.friaart27compliant ? 'SÍ' : 'NO')" />
										</h:span>
									</listcell>
									<listcell>
										<h:span class="@load(each.friaapproved ? 'badge bg-success' : 'badge bg-secondary')">
											<label value="@load(each.friaapproved ? 'SÍ' : 'NO')" />
										</h:span>
									</listcell>
									<listcell>
										<h:span class="@load(each.frianotified ? 'badge bg-primary' : 'badge bg-secondary')">
											<label value="@load(each.frianotified ? 'SÍ' : 'NO')" />
										</h:span>
									</listcell>
									<listcell>
										<h:span class="@load(each.friadpiaintegrated ? 'badge bg-info' : 'badge bg-secondary')">
											<label value="@load(each.friadpiaintegrated ? 'SÍ' : 'NO')" />
										</h:span>
									</listcell>
									<listcell>
										<button iconSclass="fa fa-eye" tooltiptext="Ver detalle"
											sclass="btn btn-sm btn-info me-1"
											onClick="@command('selectFria', fria=each)" />
										<button iconSclass="fa fa-trash" tooltiptext="Eliminar"
											sclass="btn btn-sm btn-danger"
											onClick="@command('deleteFria', fria=each)" />
									</listcell>
								</listitem>
							</template>
						</listbox>
					</h:div>
				</h:div>
			</h:div>
		</h:div>
	</idspace>
</zk>

