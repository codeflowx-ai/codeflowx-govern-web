<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="monitoring"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.monitoring.SystemAlertDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de System Alert" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveSystemAlert')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Alert Title -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Title *" />
														<textbox tabindex="2" id="alerttitle"
															value="@bind(vm.currentSystemAlert.alerttitle)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['alerttitle'])" />
													</div>
												</div>
											</div>											<!-- Alert Message -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Message *" />
														<textbox tabindex="3" id="alertmessage"
															value="@bind(vm.currentSystemAlert.alertmessage)"
															rows="4" multiline="true"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['alertmessage'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Alert Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Type *" />
														<combobox tabindex="4" id="alerttype"
															selectedItem="@bind(vm.currentSystemAlert.alerttype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['alerttype'])" />
													</div>
												</div>
											</div>											<!-- Severity -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Severity *" />
														<textbox tabindex="5" id="severity"
															value="@bind(vm.currentSystemAlert.severity)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['severity'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="6" id="status"
															selectedItem="@bind(vm.currentSystemAlert.status)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['status'])" />
													</div>
												</div>
											</div>											<!-- Componentname -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Componentname *" />
														<textbox tabindex="7" id="componentname"
															value="@bind(vm.currentSystemAlert.componentname) @save(vm.currentSystemAlert.componentname, before=('saveItem')) @validator(vm.unique, field='COMPONENTNAME', required=true, oldValue=vm.originalComponentname)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['componentname'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Metric Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Name" />
														<textbox tabindex="8" id="metricname"
															value="@bind(vm.currentSystemAlert.metricname) @save(vm.currentSystemAlert.metricname, before=('saveItem')) @validator(vm.unique, field='METRICNAME', required=false, oldValue=vm.originalMetricname)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['metricname'])" />
													</div>
												</div>
											</div>											<!-- Thresholdvalue -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Thresholdvalue" />
														<textbox tabindex="9" id="thresholdvalue"
															value="@bind(vm.currentSystemAlert.thresholdvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['thresholdvalue'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Actualvalue -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Actualvalue" />
														<textbox tabindex="10" id="actualvalue"
															value="@bind(vm.currentSystemAlert.actualvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['actualvalue'])" />
													</div>
												</div>
											</div>											<!-- Triggered At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Triggered At *" />
														<textbox tabindex="11" id="triggeredat"
															value="@bind(vm.currentSystemAlert.triggeredat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['triggeredat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Acknowledged At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged At" />
														<textbox tabindex="12" id="acknowledgedat"
															value="@bind(vm.currentSystemAlert.acknowledgedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['acknowledgedat'])" />
													</div>
												</div>
											</div>											<!-- Acknowledged By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged By" />
														<textbox tabindex="13" id="acknowledgedby"
															value="@bind(vm.currentSystemAlert.acknowledgedby)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['acknowledgedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Resolved At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resolved At" />
														<textbox tabindex="14" id="resolvedat"
															value="@bind(vm.currentSystemAlert.resolvedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['resolvedat'])" />
													</div>
												</div>
											</div>											<!-- Resolved By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resolved By" />
														<textbox tabindex="15" id="resolvedby"
															value="@bind(vm.currentSystemAlert.resolvedby)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['resolvedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="16" id="createdat"
															value="@bind(vm.currentSystemAlert.createdat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['createdat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At *" />
														<textbox tabindex="17" id="updatedat"
															value="@bind(vm.currentSystemAlert.updatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['updatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>