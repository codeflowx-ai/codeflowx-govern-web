<?page title="Configurar Web Scraping" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.domainingestion.ConfigureWebScrapingViewModel')">
        
        <n:div class="row mb-4">
            <n:div class="col-12">
                <h:h2 class="mb-1"><n:i class="fas fa-spider me-2"></n:i>Configurar Web Scraping</n:h2>
                <h:p class="text-muted">Configura scraping de sitios web</n:p>
            </n:div>
        </n:div>

        <n:div class="row">
            <n:div class="col-lg-8">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-header bg-white"><n:h5 class="mb-0">Nueva Fuente Web Scraping</n:h5></n:div>
                    <n:div class="card-body">
                        <n:div class="mb-3">
                            <label class="form-label">Dominio *</label>
                            <combobox class="form-control" value="@bind(vm.selectedDomain)" 
                                     model="@load(vm.domainsList)" buttonVisible="false">
                                <template name="model"><comboitem label="${each.dindomainname}" value="${each}"/></template>
                            </combobox>
                        </n:div>
                        <n:div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <textbox class="form-control" value="@bind(vm.dataSource.dindsname)" placeholder="Nombre de la fuente"/>
                        </n:div>
                        <n:div class="mb-3">
                            <label class="form-label">URL Base *</label>
                            <textbox class="form-control" value="@bind(vm.dataSource.dindsurl)" placeholder="https://example.com"/>
                        </n:div>
                        <n:div class="row">
                            <n:div class="col-md-6 mb-3">
                                <label class="form-label">Máximo de Páginas</label>
                                <intbox class="form-control" value="@bind(vm.dataSource.dindsmaxpages)" constraint="no negative"/>
                            </n:div>
                            <n:div class="col-md-6 mb-3">
                                <label class="form-label">Delay (ms)</label>
                                <intbox class="form-control" value="@bind(vm.dataSource.dindsdelay)" constraint="no negative"/>
                            </n:div>
                        </n:div>
                        <n:div class="mb-3">
                            <label class="form-label">Selectores (JSON)</label>
                            <textbox class="form-control" multiline="true" rows="4" value="@bind(vm.dataSource.dindsselectors)" placeholder='{"title": ".title", "content": ".content"}'/>
                        </n:div>
                        <n:div class="mb-3">
                            <checkbox checked="@bind(vm.dataSource.dindsenabled)" label="Habilitar fuente"/>
                        </n:div>
                        <n:div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-secondary" onClick="@command('cancel')">Cancelar</button>
                            <button class="btn btn-primary" onClick="@command('saveItem')"><n:i class="fas fa-save me-1"></n:i>Guardar</button>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <n:div class="row mt-4">
            <n:div class="col-12">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-header bg-white"><n:h5 class="mb-0">Fuentes Web Scraping Configuradas</n:h5></n:div>
                    <n:div class="card-body p-0">
                        <n:div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr><th>Nombre</th><th>URL</th><th>Dominio</th><th>Estado</th><th class="text-center">Acciones</th></tr>
                                </thead>
                                <tbody>
                                    <tr forEach="@load(vm.existingSources)" visible="@load(each.dindstype == 'web')">
                                        <td><strong label="@load(each.dindsname)"/></td>
                                        <td><small label="@load(each.dindsurl)"/></td>
                                        <td><label value="@load(each.domain.dindomainname)"/></td>
                                        <td><n:span class="@load(vm.getStatusBadge(each.dindsstatus))" label="@load(vm.translateStatus(each.dindsstatus))"/></td>
                                        <td class="text-center">
                                            <button class="btn btn-outline-primary btn-sm" onClick="@command('editSource', source=each)"><n:i class="fas fa-edit"></n:i></button>
                                            <button class="btn btn-outline-danger btn-sm" onClick="@command('deleteItem', source=each)"><n:i class="fas fa-trash"></n:i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>
    </n:div>
</zk>

