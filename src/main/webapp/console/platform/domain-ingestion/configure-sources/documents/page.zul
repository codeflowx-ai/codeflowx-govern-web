<?page title="Configurar Documents" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.domainingestion.ConfigureDocumentsViewModel')">
        
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="mb-1"><i class="fas fa-file-alt me-2"></i>Configurar Documentos</h2>
                <p class="text-muted">Configura carga y procesamiento de documentos</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white"><h5 class="mb-0">Nueva Fuente Documentos</h5></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Dominio *</label>
                            <combobox class="form-control" value="@bind(vm.selectedDomain)" 
                                     model="@load(vm.domainsList)" buttonVisible="false">
                                <template name="model"><comboitem label="${each.dindomainname}" value="${each}"/></template>
                            </combobox>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <textbox class="form-control" value="@bind(vm.dataSource.dindsname)" placeholder="Nombre de la fuente"/>
                        </div>
                        <div class="mb-3_client">
                            <label class="form-label">Descripción</label>
                            <textbox class="form-control" multiline="true" rows="3" value="@bind(vm.dataSource.dindsdescription)"/>
                        </div>
办法
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tipo de Archivo</label>
                                <combobox class="form-control" value="@bind(vm.dataSource.dindsfiletype)" buttonVisible="false">
                                    <comboitem label="PDF" value="pdf"/>
                                    <comboitem label="Word" value="docx"/>
                                    <comboitem label="Excel" value="xlsx"/>
                                    <comboitem label="Texto" value="txt"/>
                                </combobox>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ruta/Path</label>
                                <textbox class="form-control" value="@bind(vm.dataSource.dindsfilepath)" placeholder="/path/to/files"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Formatos Soportados (JSON Array)</label>
                            <textbox class="form-control" multiline="true" rows="2" value="@bind(vm.dataSource.dindssupportedformats)" placeholder='["pdf", "docx", "txt"]'/>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <checkbox checked="@bind(vm.dataSource.dindsextracttables)" label="Extraer Tablas"/>
                            </div>
                            <div class="col-md-4 mb-3">
                                <checkbox checked="@bind(vm.dataSource.dindsextractnumbers)" label="Extraer Números"/>
                            </div>
                            <div class="col-md-4 mb-3">
                                <checkbox checked="@bind(vm.dataSource.dindsextractentities)" label="Extraer Entidades"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <checkbox checked="@bind(vm.dataSource.dindsenabled)" label="Habilitar fuente"/>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-secondary" onClick="@command('cancel')">Cancelar</button>
                            <button class="btn btn-primary" onClick="@command('saveDataSource')"><i class="fas fa-save me-1"></i>Guardar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white"><h5 class="mb-0">Fuentes Documentos Configuradas</h5></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr><th>Nombre</th><th>Tipo</th><th>Dominio</th><th>Estado</th><th class="text-center">Acciones</th></tr>
                                </thead>
                                <tbody>
                                    <tr forEach="@load(vm.existingSources)" visible="@load(each.dindstype == 'file')">
                                        <td><strong label="@load(each.dindsname)"/></td>
                                        <td><label value="@load(each.dindsfiletype)"/></td>
                                        <td><label value="@load(each.domain.dindomainname)"/></td>
                                        <td><span class="@load(vm.getStatusBadge(each.dindsstatus))" label="@load(vm.translateStatus(each.dindsstatus))"/></td>
                                        <td class="text-center">
                                            <button class="btn btn-outline-primary btn-sm" onClick="@command('editSource', source=each)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-outline-danger btn-sm" onClick="@command('deleteSource', source=each)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</zk>

