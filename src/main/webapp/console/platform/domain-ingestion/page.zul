<?page title="Domain Ingestion" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.domainingestion.DomainIngestionDashboardViewModel')">
        
        <!-- Header -->
        <n:div class="row mb-4">
            <n:div class="col-12">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h:h2 class="mb-1">
                            <n:i class="fas fa-cloud-upload-alt me-2"></n:i>
                            Ingesta de Dominios
                        </h:h2>
                        <h:p class="text-muted">Gestión de dominios de negocio y fuentes de datos</n:p>
                    </n:div>
                    <div>
                        <button class="btn btn-primary" onClick="@command('showCreateDomainWizard')">
                            <n:i class="fas fa-plus me-1"></n:i>
                            Crear Dominio
                        </button>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Métricas Globales -->
        <n:div class="row mb-4">
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Dominios Activos</n:p>
                                <h:h3 class="mb-0" label="@load(vm.activeDomains)"/>
                            </n:div>
                            <n:div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-database text-primary fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Total Documentos</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalDocuments)"/>
                            </n:div>
                            <n:div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-file-alt text-success fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Jobs Activos</n:p>
                                <h:h3 class="mb-0" label="@load(vm.activeJobs)"/>
                            </n:div>
                            <n:div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-tasks text-warning fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Tasa de Éxito</n:p>
                                <h:h3 class="mb-0">
                                    <label value="@load(vm.successRate)"/>%
                                </h:h3>
                            </n:div>
                            <n:div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-chart-line text-info fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Filtros y búsqueda -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body">
                <n:div class="row g-3">
                    <n:div class="col-md-3">
                        <combobox class="form-control" placeholder="Industria"
                                  value="@bind(vm.filterIndustry)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todas las industrias" value=""/>
                            <comboitem label="Financial Services" value="Financial Services"/>
                            <comboitem label="Healthcare" value="Healthcare"/>
                            <comboitem label="E-commerce" value="E-commerce"/>
                            <comboitem label="Legal" value="Legal"/>
                            <comboitem label="Manufacturing" value="Manufacturing"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <combobox class="form-control" placeholder="Estado"
                                  value="@bind(vm.filterStatus)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Activo" value="active"/>
                            <comboitem label="Inactivo" value="inactive"/>
                            <comboitem label="Error" value="error"/>
                            <comboitem label="Borrador" value="draft"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-5">
                        <n:div class="input-group">
                            <n:span class="input-group-text bg-white">
                                <n:i class="fas fa-search text-muted"></n:i>
                            </n:span>
                            <textbox class="form-control" placeholder="Buscar dominio..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchDomains')"/>
                        </n:div>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100" onClick="@command('refreshDashboard')">
                            <n:i class="fas fa-sync-alt me-1"></n:i>Actualizar
                        </button>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Grid de Dominios -->
        <n:div class="row g-4 mb-4">
            <n:div class="col-md-6 col-lg-4" forEach="@load(vm.domainsList)">
                <n:div class="card border-0 shadow-sm h-100">
                    <n:div class="card-body">
                        <!-- Header del dominio -->
                        <n:div class="d-flex justify-content-between align-items-start mb-3">
                            <n:div class="d-flex align-items-center">
                                <n:div class="me-3" style="font-size: 2rem;" label="@load(each.dindomainicon)"/>
                                <div>
                                    <h:h5 class="mb-0" label="@load(each.dindomainname)"/>
                                    <small class="text-muted" label="@load(each.dinindustry)"/>
                                </n:div>
                            </n:div>
                            <n:span class="@load(vm.getStatusColor(each.dinstatus))"
                                  label="@load(vm.translateStatus(each.dinstatus))"/>
                        </n:div>
                        
                        <!-- Descripción -->
                        <h:p class="text-muted small mb-3" label="@load(vm.truncate(each.dindomaindescription, 100))"/>
                        
                        <!-- Progress bar -->
                        <n:div class="mb-3" visible="@load(each.dinprogress gt 0)">
                            <n:div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted">Progreso</small>
                                <small class="fw-bold"><label value="@load(each.dinprogress)"/>%</small>
                            </n:div>
                            <n:div class="progress" style="height: 6px;">
                                <n:div class="progress-bar" 
                                     style="@load(concat('width: ', each.dinprogress, '%'))"></n:div>
                            </n:div>
                        </n:div>
                        
                        <!-- Estadísticas -->
                        <n:div class="row g-2 mb-3">
                            <n:div class="col-4">
                                <n:div class="text-center p-2 bg-light rounded">
                                    <n:div class="fw-bold" label="@load(each.dintotaldocuments)"/>
                                    <small class="text-muted d-block">Documentos</small>
                                </n:div>
                            </n:div>
                            <n:div class="col-4">
                                <n:div class="text-center p-2 bg-light rounded">
                                    <n:div class="fw-bold" label="@load(each.dintotalwebpages)"/>
                                    <small class="text-muted d-block">Web Pages</small>
                                </n:div>
                            </n:div>
                            <n:div class="col-4">
                                <n:div class="text-center p-2 bg-light rounded">
                                    <n:div class="fw-bold" label="@load(each.dintotalapis)"/>
                                    <small class="text-muted d-block">APIs</small>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <!-- Badges -->
                        <n:div class="mb-3">
                            <n:span class="badge bg-primary me-1" visible="@load(each.dinragenabled)">
                                <n:i class="fas fa-search me-1"></n:i>RAG
                            </n:span>
                            <n:span class="badge bg-success me-1" visible="@load(each.dintrainingenabled)">
                                <n:i class="fas fa-graduation-cap me-1"></n:i>Training
                            </n:span>
                            <n:span class="badge bg-warning" visible="@load(each.dinautoingestion)">
                                <n:i class="fas fa-sync me-1"></n:i>Auto
                            </n:span>
                        </n:div>
                        
                        <!-- Última actualización -->
                        <n:div class="mb-3">
                            <small class="text-muted">
                                <n:i class="fas fa-clock me-1"></n:i>
                                Actualizado: <label value="@load(vm.formatDate(each.dinlastupdate))"/>
                            </small>
                        </n:div>
                        
                        <!-- Acciones -->
                        <n:div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary flex-fill" 
                                    onClick="@command('viewItemDetails', domain=each)">
                                <n:i class="fas fa-eye me-1"></n:i>Ver
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" 
                                    onClick="@command('editDomain', domain=each)">
                                <n:i class="fas fa-edit"></n:i>
                            </button>
                            <button class="btn btn-sm btn-outline-success" 
                                    onClick="@command('manageSources', domain=each)">
                                <n:i class="fas fa-cog"></n:i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" 
                                    onClick="@command('deleteItem', domain=each)">
                                <n:i class="fas fa-trash"></n:i>
                            </button>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Jobs Recientes -->
        <n:div class="card border-0 shadow-sm">
            <n:div class="card-header bg-white py-3">
                <n:div class="d-flex justify-content-between align-items-center">
                    <h:h5 class="mb-0">
                        <n:i class="fas fa-history me-2"></n:i>
                        Jobs Recientes
                    </h:h5>
                    <a href="javascript:void(0)" onClick="@command('viewAllJobs')">Ver todos</a>
                </n:div>
            </n:div>
            <n:div class="card-body p-0">
                <n:div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Job</th>
                                <th>Dominio</th>
                                <th>Tipo</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Progreso</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.recentJobsList)">
                                <td>
                                    <strong label="@load(each.dinjobname)"/>
                                </td>
                                <td>
                                    <label value="@load(vm.getDomainName(each.domain))"/>
                                </td>
                                <td>
                                    <n:span class="@load(vm.getJobTypeColor(each.dinjobtype))"
                                          label="@load(vm.translateJobType(each.dinjobtype))"/>
                                </td>
                                <td class="text-center">
                                    <n:span class="@load(vm.getJobStatusColor(each.dinstatus))"
                                          label="@load(vm.translateJobStatus(each.dinstatus))"/>
                                </td>
                                <td class="text-center">
                                    <n:div class="d-flex align-items-center justify-content-center">
                                        <n:div class="progress" style="width: 60px; height: 6px;">
                                            <n:div class="progress-bar" 
                                                 style="@load(concat('width: ', each.dinprogress, '%'))"></n:div>
                                        </n:div>
                                        <small class="ms-2"><label value="@load(each.dinprogress)"/>%</small>
                                    </n:div>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.dincreatedat))"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </n:div>
            </n:div>
        </n:div>

    </n:div>
</zk>


