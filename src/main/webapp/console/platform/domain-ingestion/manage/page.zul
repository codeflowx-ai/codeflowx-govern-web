<?page title="Gestión de Dominios" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.domainingestion.DomainManagementViewModel')">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1">
                            <i class="fas fa-cog me-2"></i>
                            Gestión de Dominios
                        </h2>
                        <p class="text-muted">Administra y configura tus dominios de negocio</p>
                    </div>
                    <button class="btn btn-primary" onClick="@command('createNewDomain')">
                        <i class="fas fa-plus me-1"></i>Nuevo Dominio
                    </button>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <combobox class="form-control" placeholder="Industria"
                                  value="@bind(vm.filterIndustry)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todas" value=""/>
                            <comboitem label="Financial Services" value="Financial Services"/>
                            <comboitem label="Healthcare" value="Healthcare"/>
                            <comboitem label="E-commerce" value="E-commerce"/>
                            <comboitem label="Legal" value="Legal"/>
                        </combobox>
                    </div>
                    <div class="col-md-4">
                        <combobox class="form-control" placeholder="Estado"
                                  value="@bind(vm.filterStatus)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Activo" value="active"/>
                            <comboitem label="Inactivo" value="inactive"/>
                            <comboitem label="Borrador" value="draft"/>
                        </combobox>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <textbox class="form-control" placeholder="Buscar..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchDomains')"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de dominios -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Dominios Registrados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Dominio</th>
                                <th>Industria</th>
                                <th class="text-center">Documentos</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">RAG</th>
                                <th class="text-center">Training</th>
                                <th>Última Actualización</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.domainsList)">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="me-2" style="font-size: 1.5rem;" label="@load(each.dindomainicon)"/>
                                        <div>
                                            <strong label="@load(each.dindomainname)"/>
                                            <br/>
                                            <small class="text-muted" label="@load(each.dinbusinessarea)"/>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <label value="@load(each.dinindustry)"/>
                                </td>
                                <td class="text-center">
                                    <strong label="@load(each.dintotaldocuments)"/>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getStatusColor(each.dinstatus))"
                                          label="@load(vm.translateStatus(each.dinstatus))"/>
                                </td>
                                <td class="text-center">
                                    <i class="fas fa-check-circle text-success" visible="@load(each.dinragenabled)"/>
                                    <i class="fas fa-times-circle text-secondary" visible="@load(!each.dinragenabled)"/>
                                </td>
                                <td class="text-center">
                                    <i class="fas fa-check-circle text-success" visible="@load(each.dintrainingenabled)"/>
                                    <i class="fas fa-times-circle text-secondary" visible="@load(!each.dintrainingenabled)"/>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.dinlastupdate))"/>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewDomainDetail', domain=each)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                onClick="@command('editDomain', domain=each)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" 
                                                onClick="@command('deleteDomain', domain=each)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</zk>

