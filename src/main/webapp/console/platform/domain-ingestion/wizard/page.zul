<?page title="Wizard - Crear Dominio" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.domainingestion.DomainIngestionWizardViewModel')">
        
        <!-- Header -->
        <n:div class="row mb-4">
            <n:div class="col-12">
                <n:div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h:h2 class="mb-1">
                            <n:i class="fas fa-magic me-2"></n:i>
                            Wizard de Creación de Dominio
                        </h:h2>
                        <h:p class="text-muted">Crea un nuevo dominio de negocio paso a paso</n:p>
                    </n:div>
                    <button class="btn btn-outline-secondary" onClick="@command('cancelWizard')">
                        <n:i class="fas fa-times me-1"></n:i>Cancelar
                    </button>
                </n:div>
            </n:div>
        </n:div>

        <!-- Progress Steps -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body">
                <n:div class="d-flex justify-content-between align-items-center">
                    <n:div class="step-item" forEach="@load(vm.stepsList)">
                        <n:div class="d-flex align-items-center">
                            <n:div class="step-number @load(vm.getStepNumberClass(each, vm.currentStepIndex))">
                                <n:i class="fas fa-check" visible="@load(vm.isStepCompleted(each))"/>
                                <n:span visible="@load(!vm.isStepCompleted(each))" label="@load(vm.getStepNumber(each))"/>
                            </n:div>
                            <n:div class="ms-2">
                                <n:div class="fw-bold" label="@load(each.title)"/>
                                <small class="text-muted" label="@load(each.description)"/>
                            </n:div>
                        </n:div>
                        <n:div class="step-connector" visible="@load(!each.last)">→</n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Wizard Content -->
        <n:div class="card border-0 shadow-sm">
            <n:div class="card-body p-4">
                
                <!-- Step 1: Template Selection -->
                <n:div visible="@load(vm.currentStepIndex eq 0)">
                    <h:h4 class="mb-4">Paso 1: Selección de Plantilla</n:h4>
                    <h:p class="text-muted mb-4">Selecciona una plantilla predefinida para agilizar la configuración</n:p>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-4" forEach="@load(vm.templatesList)">
                            <n:div class="card @load(vm.getTemplateCardClass(each, vm.selectedTemplateId))" 
                                 style="cursor: pointer;" onClick="@command('selectTemplate', template=each)">
                                <n:div class="card-body text-center">
                                    <n:div class="mb-3" style="font-size: 3rem;" label="@load(each.icon)"/>
                                    <h:h5 class="mb-2" label="@load(each.name)"/>
                                    <h:p class="text-muted small mb-3" label="@load(each.description)"/>
                                    <n:div class="d-flex justify-content-center gap-2 mb-3">
                                        <n:span class="badge @load(vm.getComplexityColor(each.complexity))"
                                              label="@load(each.complexity)"/>
                                        <n:span class="badge bg-secondary" label="@load(each.estimatedTime)"/>
                                    </n:div>
                                    <small class="text-muted">
                                        Características:
                                        <ul class="text-start small mt-2" style="list-style: none; padding-left: 0;">
                                            <li forEach="@load(each.features)">
                                                <n:i class="fas fa-check text-success me-1"></n:i>
                                                <label value="@load(each)"/>
                                            </li>
                                        </ul>
                                    </small>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                    
                    <n:div class="alert alert-info mt-4">
                        <n:i class="fas fa-info-circle me-2"></n:i>
                        Puedes personalizar toda la configuración después de seleccionar una plantilla
                    </n:div>
                </n:div>

                <!-- Step 2: Basic Info -->
                <n:div visible="@load(vm.currentStepIndex eq 1)">
                    <h:h4 class="mb-4">Paso 2: Información Básica</n:h4>
                    <h:p class="text-muted mb-4">Define la información fundamental del dominio</n:p>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-12">
                            <label class="form-label">Nombre del Dominio *</label>
                            <textbox class="form-control" value="@bind(vm.domainName)" 
                                     placeholder="Ej: Fintech Banking"/>
                        </n:div>
                        
                        <n:div class="col-md-12">
                            <label class="form-label">Descripción</label>
                            <textbox class="form-control" value="@bind(vm.domainDescription)" 
                                     rows="3" multiline="true"
                                     placeholder="Describe el propósito del dominio..."/>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Industria *</label>
                            <combobox class="form-control" value="@bind(vm.industry)" buttonVisible="false">
                                <comboitem label="Selecciona una industria" value=""/>
                                <comboitem label="Financial Services" value="Financial Services"/>
                                <comboitem label="Healthcare" value="Healthcare"/>
                                <comboitem label="E-commerce" value="E-commerce"/>
                                <comboitem label="Legal" value="Legal"/>
                                <comboitem label="Manufacturing" value="Manufacturing"/>
                                <comboitem label="Technology" value="Technology"/>
                                <comboitem label="Education" value="Education"/>
                            </combobox>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Área de Negocio *</label>
                            <textbox class="form-control" value="@bind(vm.businessArea)" 
                                     placeholder="Ej: Banking & Payments"/>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Icono</label>
                            <textbox class="form-control" value="@bind(vm.domainIcon)" 
                                     placeholder="Emoji o código icono"/>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Color</label>
                            <textbox class="form-control" value="@bind(vm.domainColor)" placeholder="Ej: blue"/>
                        </n:div>
                    </n:div>
                </n:div>

                <!-- Step 3: Data Sources -->
                <n:div visible="@load(vm.currentStepIndex eq 2)">
                    <h:h4 class="mb-4">Paso 3: Fuentes de Datos</n:h4>
                    <h:p class="text-muted mb-4">Selecciona los tipos de fuentes de datos que utilizarás</n:p>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-6">
                            <n:div class="card border @load(vm.getDataSourceCardClass('database', vm.selectedDataSources))"
                                 style="cursor: pointer;" onClick="@command('toggleDataSource', type='database')">
                                <n:div class="card-body">
                                    <n:div class="d-flex align-items-center">
                                        <n:i class="fas fa-database fa-2x me-3 text-primary"></n:i>
                                        <n:div class="flex-grow-1">
                                            <n:h6 class="mb-1">Base de Datos</n:h6>
                                            <small class="text-muted">Conectar bases de datos SQL/NoSQL</small>
                                        </n:div>
                                        <n:i class="fas fa-check-circle text-success" 
                                           visible="@load(vm.isDataSourceSelected('database', vm.selectedDataSources))"/>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <n:div class="card border @load(vm.getDataSourceCardClass('api', vm.selectedDataSources))"
                                 style="cursor: pointer;" onClick="@command('toggleDataSource', type='api')">
                                <n:div class="card-body">
                                    <n:div class="d-flex align-items-center">
                                        <n:i class="fas fa-plug fa-2x me-3 text-success"></n:i>
                                        <n:div class="flex-grow-1">
                                            <n:h6 class="mb-1">API Integration</n:h6>
                                            <small class="text-muted">Integrar APIs REST</small>
                                        </n:div>
                                        <n:i class="fas fa-check-circle text-success" 
                                           visible="@load(vm.isDataSourceSelected('api', vm.selectedDataSources))"/>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <n:div class="card border @load(vm.getDataSourceCardClass('file', vm.selectedDataSources))"
                                 style="cursor: pointer;" onClick="@command('toggleDataSource', type='file')">
                                <n:div class="card-body">
                                    <n:div class="d-flex align-items-center">
                                        <n:i class="fas fa-file-upload fa-2x me-3 text-info"></n:i>
                                        <n:div class="flex-grow-1">
                                            <n:h6 class="mb-1">Upload de Documentos</n:h6>
                                            <small class="text-muted">Cargar documentos PDF, Word, etc.</small>
                                        </n:div>
                                        <n:i class="fas fa-check-circle text-success" 
                                           visible="@load(vm.isDataSourceSelected('file', vm.selectedDataSources))"/>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <n:div class="card border @load(vm.getDataSourceCardClass('web', vm.selectedDataSources))"
                                 style="cursor: pointer;" onClick="@command('toggleDataSource', type='web')">
                                <n:div class="card-body">
                                    <n:div class="d-flex align-items-center">
                                        <n:i class="fas fa-spider fa-2x me-3 text-warning"></n:i>
                                        <n:div class="flex-grow-1">
                                            <n:h6 class="mb-1">Web Scraping</n:h6>
                                            <small class="text-muted">Extraer datos de páginas web</small>
                                        </n:div>
                                        <n:i class="fas fa-check-circle text-success" 
                                           visible="@load(vm.isDataSourceSelected('web', vm.selectedDataSources))"/>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                    
                    <n:div class="alert alert-warning mt-4">
                        <n:i class="fas fa-exclamation-triangle me-2"></n:i>
                        Puedes configurar las fuentes de datos después de crear el dominio
                    </n:div>
                </n:div>

                <!-- Step 4: Compliance -->
                <n:div visible="@load(vm.currentStepIndex eq 3)">
                    <h:h4 class="mb-4">Paso 4: Cumplimiento Normativo</n:h4>
                    <h:p class="text-muted mb-4">Configura los marcos de cumplimiento aplicables</n:p>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-12">
                            <label class="form-label">Marco Regulatorio</label>
                            <combobox class="form-control" value="@bind(vm.regulatoryFramework)" buttonVisible="false">
                                <comboitem label="Ninguno" value=""/>
                                <comboitem label="GDPR (UE)" value="GDPR"/>
                                <comboitem label="HIPAA (USA)" value="HIPAA"/>
                                <comboitem label="IA Act (UE)" value="IA_ACT"/>
                                <comboitem label="ISO 27001" value="ISO_27001"/>
                                <comboitem label="SOC 2" value="SOC2"/>
                            </combobox>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Nivel de Privacidad</label>
                            <combobox class="form-control" value="@bind(vm.privacyLevel)" buttonVisible="false">
                                <comboitem label="Público" value="public"/>
                                <comboitem label="Interno" value="internal"/>
                                <comboitem label="Confidencial" value="confidential"/>
                                <comboitem label="Restringido" value="restricted"/>
                            </combobox>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Retención de Datos (años)</label>
                            <intbox class="form-control" value="@bind(vm.dataRetentionYears)" 
                                    min="0" max="100"/>
                        </n:div>
                        
                        <n:div class="col-md-12">
                            <label class="form-label">Requisitos de Cumplimiento</label>
                            <n:div class="d-flex flex-wrap gap-2">
                                <label class="form-check">
                                    <checkbox checked="@bind(vm.complianceChecks)"/>
                                    Habilitar verificaciones de cumplimiento
                                </label>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>

                <!-- Step 5: Advanced Features -->
                <n:div visible="@load(vm.currentStepIndex eq 4)">
                    <h:h4 class="mb-4">Paso 5: Características Avanzadas</n:h4>
                    <h:p class="text-muted mb-4">Habilita RAG, Training y otras características</n:p>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-6">
                            <n:div class="card border">
                                <n:div class="card-body">
                                    <n:div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <n:h6 class="mb-1">
                                                <n:i class="fas fa-search me-2 text-primary"></n:i>
                                                RAG (Retrieval Augmented Generation)
                                            </n:h6>
                                            <small class="text-muted">Habilita búsqueda semántica sobre los datos</small>
                                        </n:div>
                                        <checkbox checked="@bind(vm.ragEnabled)"/>
                                    </n:div>
                                    <n:div class="form-text">Permite consultas inteligentes sobre los documentos</n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <n:div class="card border">
                                <n:div class="card-body">
                                    <n:div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <n:h6 class="mb-1">
                                                <n:i class="fas fa-graduation-cap me-2 text-success"></n:i>
                                                Training de Modelos
                                            </n:h6>
                                            <small class="text-muted">Genera datasets para fine-tuning</small>
                                        </n:div>
                                        <checkbox checked="@bind(vm.trainingEnabled)"/>
                                    </n:div>
                                    <n:div class="form-text">Prepara datos para entrenamiento de modelos IA</n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-12">
                            <n:div class="card border">
                                <n:div class="card-body">
                                    <n:div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <n:h6 class="mb-1">
                                                <n:i class="fas fa-sync me-2 text-info"></n:i>
                                                Ingesta Automática
                                            </n:h6>
                                            <small class="text-muted">Ejecuta ingestas automáticamente según cron</small>
                                        </n:div>
                                        <checkbox checked="@bind(vm.autoIngestion)"/>
                                    </n:div>
                                    <n:div class="form-text">Configura ingestas periódicas automáticas</n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Umbral de Calidad (0-100)</label>
                            <intbox class="form-control" value="@bind(vm.qualityThreshold)" 
                                    min="0" max="100"/>
                            <n:div class="form-text">Puntuación mínima para considerar datos válidos</n:div>
                        </n:div>
                        
                        <n:div class="col-md-6">
                            <label class="form-label">Retención (días)</label>
                            <intbox class="form-control" value="@bind(vm.retentionDays)" 
                                    min="1"/>
                            <n:div class="form-text">Días que se conservarán los datos ingeridos</n:div>
                        </n:div>
                    </n:div>
                </n:div>

                <!-- Step 6: Review -->
                <n:div visible="@load(vm.currentStepIndex eq 5)">
                    <h:h4 class="mb-4">Paso 6: Revisión y Confirmación</n:h4>
                    <h:p class="text-muted mb-4">Revisa la configuración antes de crear el dominio</n:p>
                    
                    <n:div class="card border">
                        <n:div class="card-body">
                            <n:div class="row mb-3">
                                <n:div class="col-4 fw-bold">Nombre:</n:div>
                                <n:div class="col-8" label="@load(vm.domainName)"/>
                            </n:div>
                            <n:div class="row mb-3">
                                <n:div class="col-4 fw-bold">Industria:</n:div>
                                <n:div class="col-8" label="@load(vm.industry)"/>
                            </n:div>
                            <n:div class="row mb-3">
                                <n:div class="col-4 fw-bold">Fuentes de Datos:</n:div>
                                <n:div class="col-8">
                                    <n:span forEach="@load(vm.selectedDataSources)" class="badge bg-primary me-1">
                                        <label value="@load(vm.translateDataSourceType(each))"/>
                                    </n:span>
                                </n:div>
                            </n:div>
                            <n:div class="row mb-3">
                                <n:div class="col-4 fw-bold">RAG:</n:div>
                                <n:div class="col-8">
                                    <n:span class="badge @load(vm.ragEnabled ? 'bg-success' : 'bg-secondary')">
                                        <label value="@load(vm.ragEnabled ? 'Habilitado' : 'Deshabilitado')"/>
                                    </n:span>
                                </n:div>
                            </n:div>
                            <n:div class="row mb-3">
                                <n:div class="col-4 fw-bold">Training:</n:div>
                                <n:div class="col-8">
                                    <n:span class="badge @load(vm.trainingEnabled ? 'bg-success' : 'bg-secondary')">
                                        <label value="@load(vm.trainingEnabled ? 'Habilitado' : 'Deshabilitado')"/>
                                    </n:span>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                    
                    <n:div class="alert alert-info mt-4">
                        <n:i class="fas fa-info-circle me-2"></n:i>
                        Puedes modificar toda esta configuración después de crear el dominio
                    </n:div>
                </n:div>

                <!-- Navigation Buttons -->
                <n:div class="d-flex justify-content-between mt-4">
                    <button class="btn btn-secondary" 
                            onClick="@command('previousStep')"
                            disabled="@load(vm.currentStepIndex eq 0)">
                        <n:i class="fas fa-arrow-left me-1"></n:i>Anterior
                    </button>
                    
                    <button class="btn btn-primary" 
                            onClick="@command('nextStep')"
                            visible="@load(vm.currentStepIndex lt 5)">
                        Siguiente<n:i class="fas fa-arrow-right ms-1"></n:i>
                    </button>
                    
                    <button class="btn btn-success" 
                            onClick="@command('createDomain')"
                            visible="@load(vm.currentStepIndex eq 5)">
                        <n:i class="fas fa-check me-1"></n:i>Crear Dominio
                    </button>
                </n:div>
                
            </n:div>
        </n:div>

    </n:div>
</zk>

