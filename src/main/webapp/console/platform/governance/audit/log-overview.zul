<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.governance.PolicyAuditLogOverviewViewModel')"
		validationMessages="@id('vmsgs')">

		<h:div class="row" style="background-color:;">
			<div><!-- Titulo pantalla -->
				<h:div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-shield-check me-2"></h:i>
						<label value="Policy Audit Log" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión de Policy Audit Log" />
					</h:p>
				</h:div>
			</h:div>
			<h:div class="col-lg-12 s-bot ">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1"></h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a
										iconSclass="fa-duotone fa-solid fa-plus label-icon align-middle fs-16 me-2"
										class="waves-effect waves-light"
										onClick="@command('registerItem')"
										label="Registrar Policy Audit Log">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
				<!--end col-->
			</h:div>
			<h:div class="col-lg-12 s-bot ">
				<!-- Métricas Resumen -->
				<h:div class="row g-3 mb-4">
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total</h:p>
								<fragment exps="@load(vm.totalItems)">
					<![CDATA[ <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h:h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Activos</h:p>
								<fragment exps="@load(vm.activeItems)">
					<![CDATA[ <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h:h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Pendientes</h:p>
								<fragment exps="@load(vm.pendingApproval)">
					<![CDATA[ <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h:h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Inactivos</h:p>
								<fragment exps="@load(vm.inactiveItems)">
					<![CDATA[ <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h:h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
			<h:div class="section filters">
				<h:div class="search-bar">
					<!-- Búsqueda por texto -->
					<textbox value="@bind(vm.searchTerm)"
						placeholder="Buscar..."
						class="form-control" onOK="@command('applyFilters')" />
				</h:div>
				<h:div class="filter-icons">
					<a tooltiptext="Buscar"
						iconSclass="fa-duotone fa-magnifying-glass-waveform"
						onClick="@command('applyFilters')" />
					<a tooltiptext="Limpiar"
						iconSclass="fa-duotone fa-broom-wide"
						onClick="@command('clearFilters')" />
				</h:div>
			</h:div>
			<h:div class="col-xxl-12 s-bot">
				<h:div class="card">
					<h:div class="card-body">
						<h:div id="divTemplate" sclass="col-lg-12">
							<!-- listado -->
							<grid model="@load(vm.filteredItems)"
								style="overflow:auto;">
								<columns sizable="true"
									columnsgroup="false" columnshide="false">
									<column
										label="ID" align="center"
										sort="auto" width="5%" />

									<column sclass=" text-capitalize "
										label="Action" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Userid" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Details" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Ipaddress" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Useragent" align="center"
										width="15%" />

									<column
										label="Acciones"
										align="center" />
								</columns>

								<template name="model" var="governance">
									<row
										style="text-align:right;cursor:pointer;"
										onClick="@command('viewItemDetails', itemId=governance.idxpolicyauditlog)">
										<label
											value="@load(governance.idxpolicyauditlog) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(governance.action) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(governance.userid) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(governance.details) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(governance.ipaddress) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(governance.useragent) @converter(vm.fieldConverter)">
										</label>
										<cell align="center"
											class="d-flex">
											<h:div class="edit">
												<a
													onClick="@command('viewItemDetails', itemId=governance.idxpolicyauditlog)"
													iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"
													tooltiptext="Ver detalles" />
											</h:div>
											<h:div class="delete">
												<a
													onClick="@command('deleteItem', itemId=governance.idxpolicyauditlog)"
													iconSclass="fa-light fa-nfc-trash fa-xl"
													sclass="waves-effect waves-danger"
													tooltiptext="Eliminar" />
											</h:div>
										</cell>
									</row>
								</template>
								<foot>
									<footer span="3" align="right">
										<paging id="topagin"
											pageSize="@load(vm.pageParams.maxRows)" 
											totalSize="@load(vm.pageResult.totalRows)"
											activePage="@load(vm.pageParams.pageActual - 1)"
											onPaging="@command('onPaging', event=event)"
											mold="os" width="100%" />
									</footer>
									<footer span="4" align="left"></footer>
									<footer></footer>
								</foot>
							</grid>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
		</h:div><!--end col-->
	</idspace>
</zk>