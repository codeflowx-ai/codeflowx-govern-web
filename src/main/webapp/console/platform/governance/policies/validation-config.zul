<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="governance"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.governance.PolicyValidationConfigDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-shield-check label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Policy Validation Config" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('savePolicyValidationConfig')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Llmmodel -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Llmmodel *" />
														<textbox tabindex="2" id="llmmodel"
															value="@bind(vm.currentPolicyValidationConfig.llmmodel)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['llmmodel'])" />
													</div>
												</div>
											</div>											<!-- Validationprompt -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Validationprompt *" />
														<textbox tabindex="3" id="validationprompt"
															value="@bind(vm.currentPolicyValidationConfig.validationprompt)"
															rows="4" multiline="true"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['validationprompt'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Expectedschema -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Expectedschema *" />
														<textbox tabindex="4" id="expectedschema"
															value="@bind(vm.currentPolicyValidationConfig.expectedschema)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['expectedschema'])" />
													</div>
												</div>
											</div>											<!-- Temperature -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Temperature" />
														<textbox tabindex="5" id="temperature"
															value="@bind(vm.currentPolicyValidationConfig.temperature)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['temperature'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Maxtokens -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Maxtokens" />
														<textbox tabindex="6" id="maxtokens"
															value="@bind(vm.currentPolicyValidationConfig.maxtokens)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['maxtokens'])" />
													</div>
												</div>
											</div>											<!-- Confidencethreshold -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Confidencethreshold" />
														<textbox tabindex="7" id="confidencethreshold"
															value="@bind(vm.currentPolicyValidationConfig.confidencethreshold)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['confidencethreshold'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Maxretries -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Maxretries" />
														<textbox tabindex="8" id="maxretries"
															value="@bind(vm.currentPolicyValidationConfig.maxretries)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['maxretries'])" />
													</div>
												</div>
											</div>											<!-- Time Outseconds -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Outseconds" />
														<textbox tabindex="9" id="timeoutseconds"
															value="@bind(vm.currentPolicyValidationConfig.timeoutseconds)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['timeoutseconds'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="10" id="createdat"
															value="@bind(vm.currentPolicyValidationConfig.createdat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['createdat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At *" />
														<textbox tabindex="11" id="updatedat"
															value="@bind(vm.currentPolicyValidationConfig.updatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['updatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>