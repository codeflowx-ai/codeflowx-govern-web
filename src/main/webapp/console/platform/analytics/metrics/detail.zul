<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="analytics"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.analytics.AnalyticsMetricDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Lytics Metric" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Anlmetricname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlmetricname *" />
														<textbox tabindex="2" id="anlmetricname"
															value="@bind(vm.currentAnalyticsMetric.anlmetricname) @save(vm.currentAnalyticsMetric.anlmetricname, before=('saveItem')) @validator(vm.unique, field='ANLMETRICNAME', required=true, oldValue=vm.originalAnlmetricname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['anlmetricname'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlmetrictype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlmetrictype *" />
														<combobox tabindex="3" id="anlmetrictype"
															selectedItem="@bind(vm.currentAnalyticsMetric.anlmetrictype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['anlmetrictype'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlmetricvalue -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlmetricvalue *" />
														<textbox tabindex="4" id="anlmetricvalue"
															value="@bind(vm.currentAnalyticsMetric.anlmetricvalue)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['anlmetricvalue'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlmetricunit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlmetricunit" />
														<textbox tabindex="5" id="anlmetricunit"
															value="@bind(vm.currentAnalyticsMetric.anlmetricunit)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['anlmetricunit'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlthresholdmin -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlthresholdmin" />
														<textbox tabindex="6" id="anlthresholdmin"
															value="@bind(vm.currentAnalyticsMetric.anlthresholdmin)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['anlthresholdmin'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlthresholdmax -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlthresholdmax" />
														<textbox tabindex="7" id="anlthresholdmax"
															value="@bind(vm.currentAnalyticsMetric.anlthresholdmax)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['anlthresholdmax'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlstatus" />
														<combobox tabindex="8" id="anlstatus"
															selectedItem="@bind(vm.currentAnalyticsMetric.anlstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['anlstatus'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlcontext -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlcontext" />
														<textbox tabindex="9" id="anlcontext"
															value="@bind(vm.currentAnalyticsMetric.anlcontext)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['anlcontext'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlmetadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlmetadata" />
														<textbox tabindex="10" id="anlmetadata"
															value="@bind(vm.currentAnalyticsMetric.anlmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['anlmetadata'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlcreatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlcreatedby *" />
														<textbox tabindex="11" id="anlcreatedby"
															value="@bind(vm.currentAnalyticsMetric.anlcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['anlcreatedby'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlupdatedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlupdatedby" />
														<textbox tabindex="12" id="anlupdatedby"
															value="@bind(vm.currentAnalyticsMetric.anlupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['anlupdatedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Anlcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlcreatedat *" />
														<textbox tabindex="13" id="anlcreatedat"
															value="@bind(vm.currentAnalyticsMetric.anlcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['anlcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Anlupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Anlupdatedat" />
														<textbox tabindex="14" id="anlupdatedat"
															value="@bind(vm.currentAnalyticsMetric.anlupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['anlupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>