<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.DeploymentMetricDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Deployment Metric" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveDeploymentMetric')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Deployment Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Deployment Id" />
														<textbox tabindex="2" id="deploymentid"
															value="@bind(vm.currentDeploymentMetric.deploymentid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['deploymentid'])" />
													</div>
												</div>
											</div>											<!-- Instanceid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Instanceid" />
														<textbox tabindex="3" id="instanceid"
															value="@bind(vm.currentDeploymentMetric.instanceid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['instanceid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Metric Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Name *" />
														<textbox tabindex="4" id="metricname"
															value="@bind(vm.currentDeploymentMetric.metricname) @save(vm.currentDeploymentMetric.metricname, before=('saveItem')) @validator(vm.unique, field='METRICNAME', required=true, oldValue=vm.originalMetricname)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['metricname'])" />
													</div>
												</div>
											</div>											<!-- Metric Value -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Value" />
														<textbox tabindex="5" id="metricvalue"
															value="@bind(vm.currentDeploymentMetric.metricvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['metricvalue'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Metric Unit -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Unit" />
														<textbox tabindex="6" id="metricunit"
															value="@bind(vm.currentDeploymentMetric.metricunit)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['metricunit'])" />
													</div>
												</div>
											</div>											<!-- Metric Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Type *" />
														<combobox tabindex="7" id="metrictype"
															selectedItem="@bind(vm.currentDeploymentMetric.metrictype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['metrictype'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Time Stamp -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Stamp *" />
														<textbox tabindex="8" id="timestamp"
															value="@bind(vm.currentDeploymentMetric.timestamp)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['timestamp'])" />
													</div>
												</div>
											</div>											<!-- Labels -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Labels" />
														<textbox tabindex="9" id="labels"
															value="@bind(vm.currentDeploymentMetric.labels)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['labels'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Metadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata" />
														<textbox tabindex="10" id="metadata"
															value="@bind(vm.currentDeploymentMetric.metadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['metadata'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>