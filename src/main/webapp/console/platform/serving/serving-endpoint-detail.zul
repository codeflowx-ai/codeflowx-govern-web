<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.ServingEndpointDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Ving Endpoint" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveServingEndpoint')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Deployment Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Deployment Id" />
														<textbox tabindex="2" id="deploymentid"
															value="@bind(vm.currentServingEndpoint.deploymentid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['deploymentid'])" />
													</div>
												</div>
											</div>											<!-- Endpoint Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endpoint Name *" />
														<textbox tabindex="3" id="endpointname"
															value="@bind(vm.currentServingEndpoint.endpointname) @save(vm.currentServingEndpoint.endpointname, before=('saveItem')) @validator(vm.unique, field='ENDPOINTNAME', required=true, oldValue=vm.originalEndpointname)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['endpointname'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Endpoint Path -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endpoint Path *" />
														<textbox tabindex="4" id="endpointpath"
															value="@bind(vm.currentServingEndpoint.endpointpath)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['endpointpath'])" />
													</div>
												</div>
											</div>											<!-- Httpmethod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Httpmethod *" />
														<textbox tabindex="5" id="httpmethod"
															value="@bind(vm.currentServingEndpoint.httpmethod)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['httpmethod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Endpoint Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endpoint Type *" />
														<combobox tabindex="6" id="endpointtype"
															selectedItem="@bind(vm.currentServingEndpoint.endpointtype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['endpointtype'])" />
													</div>
												</div>
											</div>											<!-- Requestschema -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestschema" />
														<textbox tabindex="7" id="requestschema"
															value="@bind(vm.currentServingEndpoint.requestschema)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['requestschema'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Responseschema -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Responseschema" />
														<textbox tabindex="8" id="responseschema"
															value="@bind(vm.currentServingEndpoint.responseschema)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['responseschema'])" />
													</div>
												</div>
											</div>											<!-- Ratelimit -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ratelimit" />
														<textbox tabindex="9" id="ratelimit"
															value="@bind(vm.currentServingEndpoint.ratelimit)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ratelimit'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Time Outseconds -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Outseconds" />
														<textbox tabindex="10" id="timeoutseconds"
															value="@bind(vm.currentServingEndpoint.timeoutseconds)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['timeoutseconds'])" />
													</div>
												</div>
											</div>											<!-- Authenticationrequired -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Authenticationrequired" />
														<textbox tabindex="11" id="authenticationrequired"
															value="@bind(vm.currentServingEndpoint.authenticationrequired)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['authenticationrequired'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Authorizationroles -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Authorizationroles" />
														<div class="input-group">
															<textbox value="@bind(vm.newAuthorizationroles)"
																placeholder="Añadir authorizationroles"
																onOK="@command('addAuthorizationroles')" />
															<button onClick="@command('addAuthorizationroles')"
																iconSclass="fa-plus" />
														</div>
														<div class="mt-2">
															<forEach items="@load(vm.selectedAuthorizationroless)" var="tag">
																<span class="badge bg-primary me-1">
																	<label value="@load(tag)" />
																	<a onClick="@command('removeAuthorizationroles', tag=tag)"
																		iconSclass="fa-times" class="ms-1" />
																</span>
															</forEach>
														</div>
														<label sclass="text-danger" value="@load(vmsgs['authorizationroles'])" />
													</div>
												</div>
											</div>											<!-- Isactive -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Isactive" />
														<textbox tabindex="13" id="isactive"
															value="@bind(vm.currentServingEndpoint.isactive)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['isactive'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="14" id="createdat"
															value="@bind(vm.currentServingEndpoint.createdat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['createdat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At *" />
														<textbox tabindex="15" id="updatedat"
															value="@bind(vm.currentServingEndpoint.updatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['updatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>