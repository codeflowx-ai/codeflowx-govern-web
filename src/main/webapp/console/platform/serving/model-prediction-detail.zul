<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.ModelPredictionDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Model Prediction" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveModelPrediction')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Srvpredictionsessionid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionsessionid" />
														<textbox tabindex="2" id="srvpredictionsessionid"
															value="@bind(vm.currentModelPrediction.srvpredictionsessionid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionsessionid'])" />
													</div>
												</div>
											</div>											<!-- Srvpredictioninput -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictioninput" />
														<textbox tabindex="3" id="srvpredictioninput"
															value="@bind(vm.currentModelPrediction.srvpredictioninput)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictioninput'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Srvpredictionoutput -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionoutput" />
														<textbox tabindex="4" id="srvpredictionoutput"
															value="@bind(vm.currentModelPrediction.srvpredictionoutput)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionoutput'])" />
													</div>
												</div>
											</div>											<!-- Srvpredictionconfidence -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionconfidence" />
														<textbox tabindex="5" id="srvpredictionconfidence"
															value="@bind(vm.currentModelPrediction.srvpredictionconfidence)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionconfidence'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Srvpredictionprocessingtime -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionprocessingtime" />
														<textbox tabindex="6" id="srvpredictionprocessingtime"
															value="@bind(vm.currentModelPrediction.srvpredictionprocessingtime)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionprocessingtime'])" />
													</div>
												</div>
											</div>											<!-- Srvpredictionstatus -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionstatus *" />
														<combobox tabindex="7" id="srvpredictionstatus"
															selectedItem="@bind(vm.currentModelPrediction.srvpredictionstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Srvpredictionerrormessage -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionerrormessage" />
														<textbox tabindex="8" id="srvpredictionerrormessage"
															value="@bind(vm.currentModelPrediction.srvpredictionerrormessage)"
															maxlength="1000"
															constraint="max 1000" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionerrormessage'])" />
													</div>
												</div>
											</div>											<!-- Srvpredictionmetadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictionmetadata" />
														<textbox tabindex="9" id="srvpredictionmetadata"
															value="@bind(vm.currentModelPrediction.srvpredictionmetadata)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictionmetadata'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Srvpredictioncreatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvpredictioncreatedat *" />
														<textbox tabindex="10" id="srvpredictioncreatedat"
															value="@bind(vm.currentModelPrediction.srvpredictioncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['srvpredictioncreatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>