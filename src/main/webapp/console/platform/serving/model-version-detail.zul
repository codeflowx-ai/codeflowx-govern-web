<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.ModelVersionDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Model Version" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Srvversionnumber -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionnumber *" />
														<textbox tabindex="2" id="srvversionnumber"
															value="@bind(vm.currentModelVersion.srvversionnumber)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['srvversionnumber'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvversiondescription -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversiondescription" />
														<textbox tabindex="3" id="srvversiondescription"
															value="@bind(vm.currentModelVersion.srvversiondescription)"
															maxlength="1000"
															constraint="max 1000" />
														<label sclass="text-danger" value="@load(vmsgs['srvversiondescription'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvversionpath -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionpath" />
														<textbox tabindex="4" id="srvversionpath"
															value="@bind(vm.currentModelVersion.srvversionpath)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['srvversionpath'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvversionsize -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionsize" />
														<textbox tabindex="5" id="srvversionsize"
															value="@bind(vm.currentModelVersion.srvversionsize)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvversionsize'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvversionchecksum -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionchecksum" />
														<textbox tabindex="6" id="srvversionchecksum"
															value="@bind(vm.currentModelVersion.srvversionchecksum)"
															maxlength="64"
															constraint="max 64" />
														<label sclass="text-danger" value="@load(vmsgs['srvversionchecksum'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvversioncurrent -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversioncurrent" />
														<textbox tabindex="7" id="srvversioncurrent"
															value="@bind(vm.currentModelVersion.srvversioncurrent)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvversioncurrent'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvversionactive -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionactive" />
														<textbox tabindex="8" id="srvversionactive"
															value="@bind(vm.currentModelVersion.srvversionactive)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvversionactive'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvversioncreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversioncreatedat *" />
														<textbox tabindex="9" id="srvversioncreatedat"
															value="@bind(vm.currentModelVersion.srvversioncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['srvversioncreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvversionupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvversionupdatedat" />
														<textbox tabindex="10" id="srvversionupdatedat"
															value="@bind(vm.currentModelVersion.srvversionupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvversionupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>