<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.ModelDeploymentDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Model Deployment" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Srvdeploymentname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentname *" />
														<textbox tabindex="2" id="srvdeploymentname"
															value="@bind(vm.currentModelDeployment.srvdeploymentname) @save(vm.currentModelDeployment.srvdeploymentname, before=('saveItem')) @validator(vm.unique, field='SRVDEPLOYMENTNAME', required=true, oldValue=vm.originalSrvdeploymentname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentname'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentstatus *" />
														<combobox tabindex="3" id="srvdeploymentstatus"
															selectedItem="@bind(vm.currentModelDeployment.srvdeploymentstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvdeploymentendpoint -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentendpoint" />
														<textbox tabindex="4" id="srvdeploymentendpoint"
															value="@bind(vm.currentModelDeployment.srvdeploymentendpoint)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentendpoint'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentport -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentport" />
														<textbox tabindex="5" id="srvdeploymentport"
															value="@bind(vm.currentModelDeployment.srvdeploymentport)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentport'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvdeploymentreplicas -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentreplicas" />
														<textbox tabindex="6" id="srvdeploymentreplicas"
															value="@bind(vm.currentModelDeployment.srvdeploymentreplicas)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentreplicas'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentresources -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentresources" />
														<textbox tabindex="7" id="srvdeploymentresources"
															value="@bind(vm.currentModelDeployment.srvdeploymentresources)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentresources'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvdeploymentconfig -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentconfig" />
														<textbox tabindex="8" id="srvdeploymentconfig"
															value="@bind(vm.currentModelDeployment.srvdeploymentconfig)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentconfig'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentenvvars -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentenvvars" />
														<textbox tabindex="9" id="srvdeploymentenvvars"
															value="@bind(vm.currentModelDeployment.srvdeploymentenvvars)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentenvvars'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvdeploymentlabels -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentlabels" />
														<textbox tabindex="10" id="srvdeploymentlabels"
															value="@bind(vm.currentModelDeployment.srvdeploymentlabels)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentlabels'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentactive -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentactive" />
														<textbox tabindex="11" id="srvdeploymentactive"
															value="@bind(vm.currentModelDeployment.srvdeploymentactive)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentactive'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Srvdeploymentcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentcreatedat *" />
														<textbox tabindex="12" id="srvdeploymentcreatedat"
															value="@bind(vm.currentModelDeployment.srvdeploymentcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Srvdeploymentupdatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Srvdeploymentupdatedat" />
														<textbox tabindex="13" id="srvdeploymentupdatedat"
															value="@bind(vm.currentModelDeployment.srvdeploymentupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['srvdeploymentupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Subsrvmodelmetrics -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subsrvmodelmetrics" />
														<textbox tabindex="14" id="subsrvmodelmetrics"
															value="@bind(vm.currentModelDeployment.subsrvmodelmetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subsrvmodelmetrics'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Subsrvpredictions -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subsrvpredictions" />
														<textbox tabindex="15" id="subsrvpredictions"
															value="@bind(vm.currentModelDeployment.subsrvpredictions)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subsrvpredictions'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

							<!-- Tabs de Información Descendente -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Subsrvmodelmetrics" onSelect="@command('onSelectModelMetricsTab')" />
												<tab label="Subsrvpredictions" onSelect="@command('onSelectModelPredictionTab')" />
											</tabs>
											<tabpanels>
												<!-- Panel: Subsrvmodelmetrics -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subsrvmodelmetrics"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModelMetricss)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subsrvmodelmetrics)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subsrvmodelmetrics)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subsrvmodelmetrics registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Subsrvpredictions -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subsrvpredictions"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalModelPredictions)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subsrvpredictions)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subsrvpredictions)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subsrvpredictions registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
											</tabpanels>
										</tabbox>
									</h:div>
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>