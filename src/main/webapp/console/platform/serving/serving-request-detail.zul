<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="serving"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.serving.ServingRequestDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Ving Request" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveServingRequest')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Deployment Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Deployment Id" />
														<textbox tabindex="2" id="deploymentid"
															value="@bind(vm.currentServingRequest.deploymentid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['deploymentid'])" />
													</div>
												</div>
											</div>											<!-- Endpoint Id -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endpoint Id" />
														<textbox tabindex="3" id="endpointid"
															value="@bind(vm.currentServingRequest.endpointid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['endpointid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Requestid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestid *" />
														<textbox tabindex="4" id="requestid"
															value="@bind(vm.currentServingRequest.requestid)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['requestid'])" />
													</div>
												</div>
											</div>											<!-- Userid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Userid" />
														<textbox tabindex="5" id="userid"
															value="@bind(vm.currentServingRequest.userid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['userid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Sessionid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Sessionid" />
														<textbox tabindex="6" id="sessionid"
															value="@bind(vm.currentServingRequest.sessionid)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['sessionid'])" />
													</div>
												</div>
											</div>											<!-- Ipaddress -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ipaddress" />
														<textbox tabindex="7" id="ipaddress"
															value="@bind(vm.currentServingRequest.ipaddress)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['ipaddress'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Useragent -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Useragent" />
														<textbox tabindex="8" id="useragent"
															value="@bind(vm.currentServingRequest.useragent)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['useragent'])" />
													</div>
												</div>
											</div>											<!-- Requestmethod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestmethod *" />
														<textbox tabindex="9" id="requestmethod"
															value="@bind(vm.currentServingRequest.requestmethod)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['requestmethod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Requesturl -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requesturl *" />
														<textbox tabindex="10" id="requesturl"
															value="@bind(vm.currentServingRequest.requesturl)"
															rows="4" multiline="true"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['requesturl'])" />
													</div>
												</div>
											</div>											<!-- Requestheaders -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestheaders" />
														<textbox tabindex="11" id="requestheaders"
															value="@bind(vm.currentServingRequest.requestheaders)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['requestheaders'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Requestbody -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestbody" />
														<textbox tabindex="12" id="requestbody"
															value="@bind(vm.currentServingRequest.requestbody)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['requestbody'])" />
													</div>
												</div>
											</div>											<!-- Requestsizebytes -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requestsizebytes" />
														<textbox tabindex="13" id="requestsizebytes"
															value="@bind(vm.currentServingRequest.requestsizebytes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['requestsizebytes'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Responsestatus -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Responsestatus" />
														<textbox tabindex="14" id="responsestatus"
															value="@bind(vm.currentServingRequest.responsestatus)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['responsestatus'])" />
													</div>
												</div>
											</div>											<!-- Responsebody -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Responsebody" />
														<textbox tabindex="15" id="responsebody"
															value="@bind(vm.currentServingRequest.responsebody)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['responsebody'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Responsesizebytes -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Responsesizebytes" />
														<textbox tabindex="16" id="responsesizebytes"
															value="@bind(vm.currentServingRequest.responsesizebytes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['responsesizebytes'])" />
													</div>
												</div>
											</div>											<!-- Execution Time Ms -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Execution Time Ms" />
														<textbox tabindex="17" id="executiontimems"
															value="@bind(vm.currentServingRequest.executiontimems)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['executiontimems'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Errormessage -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Errormessage" />
														<textbox tabindex="18" id="errormessage"
															value="@bind(vm.currentServingRequest.errormessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['errormessage'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="19" id="createdat"
															value="@bind(vm.currentServingRequest.createdat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['createdat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Completed At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Completed At" />
														<textbox tabindex="20" id="completedat"
															value="@bind(vm.currentServingRequest.completedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['completedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>