<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.TrainingAlertDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Training Alert" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveTrainingAlert')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Alert Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Type *" />
														<combobox tabindex="2" id="trnalerttype"
															selectedItem="@bind(vm.currentTrainingAlert.trnalerttype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnalerttype'])" />
													</div>
												</div>
											</div>											<!-- Severity -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Severity *" />
														<textbox tabindex="3" id="trnseverity"
															value="@bind(vm.currentTrainingAlert.trnseverity)"
															maxlength="20"
															constraint="no empty: max 20" />
														<label sclass="text-danger" value="@load(vmsgs['trnseverity'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Message -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Message *" />
														<textbox tabindex="4" id="trnmessage"
															value="@bind(vm.currentTrainingAlert.trnmessage)"
															rows="4" multiline="true"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trnmessage'])" />
													</div>
												</div>
											</div>											<!-- Metric Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Name" />
														<textbox tabindex="5" id="trnmetricname"
															value="@bind(vm.currentTrainingAlert.trnmetricname) @save(vm.currentTrainingAlert.trnmetricname, before=('saveItem')) @validator(vm.unique, field='TRNMETRICNAME', required=false, oldValue=vm.originalTrnmetricname)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnmetricname'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Metric Value -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Value" />
														<textbox tabindex="6" id="trnmetricvalue"
															value="@bind(vm.currentTrainingAlert.trnmetricvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnmetricvalue'])" />
													</div>
												</div>
											</div>											<!-- Threshold -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Threshold" />
														<textbox tabindex="7" id="trnthreshold"
															value="@bind(vm.currentTrainingAlert.trnthreshold)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnthreshold'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Epoch -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Epoch" />
														<textbox tabindex="8" id="trnepoch"
															value="@bind(vm.currentTrainingAlert.trnepoch)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnepoch'])" />
													</div>
												</div>
											</div>											<!-- Step -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Step" />
														<textbox tabindex="9" id="trnstep"
															value="@bind(vm.currentTrainingAlert.trnstep)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnstep'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Recommendation -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Recommendation" />
														<textbox tabindex="10" id="trnrecommendation"
															value="@bind(vm.currentTrainingAlert.trnrecommendation)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnrecommendation'])" />
													</div>
												</div>
											</div>											<!-- Autoaction -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Autoaction" />
														<textbox tabindex="11" id="trnautoaction"
															value="@bind(vm.currentTrainingAlert.trnautoaction)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trnautoaction'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Actiontaken -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Actiontaken" />
														<textbox tabindex="12" id="trnactiontaken"
															value="@bind(vm.currentTrainingAlert.trnactiontaken)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnactiontaken'])" />
													</div>
												</div>
											</div>											<!-- Actionresult -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Actionresult" />
														<textbox tabindex="13" id="trnactionresult"
															value="@bind(vm.currentTrainingAlert.trnactionresult)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnactionresult'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Acknowledged -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged" />
														<textbox tabindex="14" id="trnacknowledged"
															value="@bind(vm.currentTrainingAlert.trnacknowledged)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnacknowledged'])" />
													</div>
												</div>
											</div>											<!-- Acknowledged By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged By" />
														<textbox tabindex="15" id="trnacknowledgedby"
															value="@bind(vm.currentTrainingAlert.trnacknowledgedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnacknowledgedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Acknowledged At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged At" />
														<textbox tabindex="16" id="trnacknowledgedat"
															value="@bind(vm.currentTrainingAlert.trnacknowledgedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnacknowledgedat'])" />
													</div>
												</div>
											</div>											<!-- Detectedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Detectedat *" />
														<textbox tabindex="17" id="trndetectedat"
															value="@bind(vm.currentTrainingAlert.trndetectedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trndetectedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>