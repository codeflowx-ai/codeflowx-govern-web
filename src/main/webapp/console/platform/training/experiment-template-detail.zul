<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.ExperimentTemplateDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Experiment Template" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveExperimentTemplate')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Name *" />
														<textbox tabindex="2" id="trnname"
															value="@bind(vm.currentExperimentTemplate.trnname) @save(vm.currentExperimentTemplate.trnname, before=('saveItem')) @validator(vm.unique, field='TRNNAME', required=true, oldValue=vm.originalTrnname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnname'])" />
													</div>
												</div>
											</div>											<!-- Description -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="3" id="trndescription"
															value="@bind(vm.currentExperimentTemplate.trndescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trndescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Templatetype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Templatetype *" />
														<combobox tabindex="4" id="trntemplatetype"
															selectedItem="@bind(vm.currentExperimentTemplate.trntemplatetype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trntemplatetype'])" />
													</div>
												</div>
											</div>											<!-- Usecase -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Usecase" />
														<textbox tabindex="5" id="trnusecase"
															value="@bind(vm.currentExperimentTemplate.trnusecase)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnusecase'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Defaultparams -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Defaultparams" />
														<textbox tabindex="6" id="trndefaultparams"
															value="@bind(vm.currentExperimentTemplate.trndefaultparams)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trndefaultparams'])" />
													</div>
												</div>
											</div>											<!-- Recommendedmetrics -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Recommendedmetrics" />
														<textbox tabindex="7" id="trnrecommendedmetrics"
															value="@bind(vm.currentExperimentTemplate.trnrecommendedmetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnrecommendedmetrics'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Governance Rules -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Governance Rules" />
														<textbox tabindex="8" id="trngovernancerules"
															value="@bind(vm.currentExperimentTemplate.trngovernancerules)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trngovernancerules'])" />
													</div>
												</div>
											</div>											<!-- Bestpractices -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Bestpractices" />
														<textbox tabindex="9" id="trnbestpractices"
															value="@bind(vm.currentExperimentTemplate.trnbestpractices)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnbestpractices'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Hposearchspace -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Hposearchspace" />
														<textbox tabindex="10" id="trnhposearchspace"
															value="@bind(vm.currentExperimentTemplate.trnhposearchspace)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnhposearchspace'])" />
													</div>
												</div>
											</div>											<!-- Successthreshold -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Successthreshold" />
														<textbox tabindex="11" id="trnsuccessthreshold"
															value="@bind(vm.currentExperimentTemplate.trnsuccessthreshold)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnsuccessthreshold'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Earlystoppingconfig -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Earlystoppingconfig" />
														<textbox tabindex="12" id="trnearlystoppingconfig"
															value="@bind(vm.currentExperimentTemplate.trnearlystoppingconfig)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnearlystoppingconfig'])" />
													</div>
												</div>
											</div>											<!-- Usagecount -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Usagecount" />
														<textbox tabindex="13" id="trnusagecount"
															value="@bind(vm.currentExperimentTemplate.trnusagecount)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnusagecount'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Avgscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Avgscore" />
														<textbox tabindex="14" id="trnavgscore"
															value="@bind(vm.currentExperimentTemplate.trnavgscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnavgscore'])" />
													</div>
												</div>
											</div>											<!-- Successrate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Successrate" />
														<textbox tabindex="15" id="trnsuccessrate"
															value="@bind(vm.currentExperimentTemplate.trnsuccessrate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnsuccessrate'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ispublic -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ispublic" />
														<textbox tabindex="16" id="trnispublic"
															value="@bind(vm.currentExperimentTemplate.trnispublic)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnispublic'])" />
													</div>
												</div>
											</div>											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="17" id="trncreatedby"
															value="@bind(vm.currentExperimentTemplate.trncreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="18" id="trnupdatedby"
															value="@bind(vm.currentExperimentTemplate.trnupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="19" id="trncreatedat"
															value="@bind(vm.currentExperimentTemplate.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="20" id="trnupdatedat"
															value="@bind(vm.currentExperimentTemplate.trnupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>