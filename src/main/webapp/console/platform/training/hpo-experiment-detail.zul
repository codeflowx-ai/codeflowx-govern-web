<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.HPOExperimentDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Hpo Experiment" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveHPOExperiment')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Name *" />
														<textbox tabindex="2" id="trnname"
															value="@bind(vm.currentHPOExperiment.trnname) @save(vm.currentHPOExperiment.trnname, before=('saveItem')) @validator(vm.unique, field='TRNNAME', required=true, oldValue=vm.originalTrnname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnname'])" />
													</div>
												</div>
											</div>											<!-- Hpomethod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Hpomethod *" />
														<textbox tabindex="3" id="trnhpomethod"
															value="@bind(vm.currentHPOExperiment.trnhpomethod)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trnhpomethod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Searchspace -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Searchspace *" />
														<textbox tabindex="4" id="trnsearchspace"
															value="@bind(vm.currentHPOExperiment.trnsearchspace)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trnsearchspace'])" />
													</div>
												</div>
											</div>											<!-- Objectivemetric -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Objectivemetric *" />
														<textbox tabindex="5" id="trnobjectivemetric"
															value="@bind(vm.currentHPOExperiment.trnobjectivemetric)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnobjectivemetric'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Optimizationdirection -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Optimizationdirection *" />
														<textbox tabindex="6" id="trnoptimizationdirection"
															value="@bind(vm.currentHPOExperiment.trnoptimizationdirection)"
															maxlength="20"
															constraint="no empty: max 20" />
														<label sclass="text-danger" value="@load(vmsgs['trnoptimizationdirection'])" />
													</div>
												</div>
											</div>											<!-- Totaltrials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Totaltrials *" />
														<textbox tabindex="7" id="trntotaltrials"
															value="@bind(vm.currentHPOExperiment.trntotaltrials)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trntotaltrials'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Completed Trials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Completed Trials" />
														<textbox tabindex="8" id="trncompletedtrials"
															value="@bind(vm.currentHPOExperiment.trncompletedtrials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncompletedtrials'])" />
													</div>
												</div>
											</div>											<!-- Failedtrials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Failedtrials" />
														<textbox tabindex="9" id="trnfailedtrials"
															value="@bind(vm.currentHPOExperiment.trnfailedtrials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnfailedtrials'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Prunedtrials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Prunedtrials" />
														<textbox tabindex="10" id="trnprunedtrials"
															value="@bind(vm.currentHPOExperiment.trnprunedtrials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnprunedtrials'])" />
													</div>
												</div>
											</div>											<!-- Besttrialid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Besttrialid" />
														<textbox tabindex="11" id="trnbesttrialid"
															value="@bind(vm.currentHPOExperiment.trnbesttrialid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnbesttrialid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Bestparams -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Bestparams" />
														<textbox tabindex="12" id="trnbestparams"
															value="@bind(vm.currentHPOExperiment.trnbestparams)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnbestparams'])" />
													</div>
												</div>
											</div>											<!-- Bestscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Bestscore" />
														<textbox tabindex="13" id="trnbestscore"
															value="@bind(vm.currentHPOExperiment.trnbestscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnbestscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Convergencecurve -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Convergencecurve" />
														<textbox tabindex="14" id="trnconvergencecurve"
															value="@bind(vm.currentHPOExperiment.trnconvergencecurve)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnconvergencecurve'])" />
													</div>
												</div>
											</div>											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="15" id="trnstatus"
															selectedItem="@bind(vm.currentHPOExperiment.trnstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Startedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Startedat" />
														<textbox tabindex="16" id="trnstartedat"
															value="@bind(vm.currentHPOExperiment.trnstartedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnstartedat'])" />
													</div>
												</div>
											</div>											<!-- Completed At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Completed At" />
														<textbox tabindex="17" id="trncompletedat"
															value="@bind(vm.currentHPOExperiment.trncompletedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncompletedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Durationminutes -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Durationminutes" />
														<textbox tabindex="18" id="trndurationminutes"
															value="@bind(vm.currentHPOExperiment.trndurationminutes)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trndurationminutes'])" />
													</div>
												</div>
											</div>											<!-- Estimatedtimeremaining -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Estimatedtimeremaining" />
														<textbox tabindex="19" id="trnestimatedtimeremaining"
															value="@bind(vm.currentHPOExperiment.trnestimatedtimeremaining)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnestimatedtimeremaining'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="20" id="trncreatedby"
															value="@bind(vm.currentHPOExperiment.trncreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="21" id="trncreatedat"
															value="@bind(vm.currentHPOExperiment.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="22" id="trnupdatedat"
															value="@bind(vm.currentHPOExperiment.trnupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedat'])" />
													</div>
												</div>
											</div>											<!-- Subtrnhpotrials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subtrnhpotrials" />
														<textbox tabindex="23" id="subtrnhpotrials"
															value="@bind(vm.currentHPOExperiment.subtrnhpotrials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subtrnhpotrials'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Subtrnhpotrials" onSelect="@command('onSelectHPOTrialTab')" />
											</tabs>
											<tabpanels>
												<!-- Panel: Subtrnhpotrials -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subtrnhpotrials"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalHPOTrials)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subtrnhpotrials)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subtrnhpotrials)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subtrnhpotrials registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>