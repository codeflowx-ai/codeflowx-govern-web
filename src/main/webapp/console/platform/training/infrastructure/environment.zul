<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.EnvironmentDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Environment" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Pythonversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Pythonversion *" />
														<textbox tabindex="2" id="trnpythonversion"
															value="@bind(vm.currentEnvironment.trnpythonversion)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trnpythonversion'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Packages -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Packages" />
														<textbox tabindex="3" id="trnpackages"
															value="@bind(vm.currentEnvironment.trnpackages)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnpackages'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Pipfreeze -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Pipfreeze" />
														<textbox tabindex="4" id="trnpipfreeze"
															value="@bind(vm.currentEnvironment.trnpipfreeze)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnpipfreeze'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Condaenv -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Condaenv" />
														<textbox tabindex="5" id="trncondaenv"
															value="@bind(vm.currentEnvironment.trncondaenv)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncondaenv'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Cputype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Cputype" />
														<combobox tabindex="6" id="trncputype"
															selectedItem="@bind(vm.currentEnvironment.trncputype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trncputype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Cpucores -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Cpucores" />
														<textbox tabindex="7" id="trncpucores"
															value="@bind(vm.currentEnvironment.trncpucores)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncpucores'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ramgb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ramgb" />
														<textbox tabindex="8" id="trnramgb"
															value="@bind(vm.currentEnvironment.trnramgb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnramgb'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gputype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gputype" />
														<combobox tabindex="9" id="trngputype"
															selectedItem="@bind(vm.currentEnvironment.trngputype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trngputype'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gpucount -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpucount" />
														<textbox tabindex="10" id="trngpucount"
															value="@bind(vm.currentEnvironment.trngpucount)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trngpucount'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gpumemorygb -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gpumemorygb" />
														<textbox tabindex="11" id="trngpumemorygb"
															value="@bind(vm.currentEnvironment.trngpumemorygb)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trngpumemorygb'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Cudaversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Cudaversion" />
														<textbox tabindex="12" id="trncudaversion"
															value="@bind(vm.currentEnvironment.trncudaversion)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trncudaversion'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Cudnnversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Cudnnversion" />
														<textbox tabindex="13" id="trncudnnversion"
															value="@bind(vm.currentEnvironment.trncudnnversion)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trncudnnversion'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Os -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Os" />
														<textbox tabindex="14" id="trnos"
															value="@bind(vm.currentEnvironment.trnos)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnos'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Kernelversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Kernelversion" />
														<textbox tabindex="15" id="trnkernelversion"
															value="@bind(vm.currentEnvironment.trnkernelversion)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnkernelversion'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Dockerimage -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dockerimage" />
														<textbox tabindex="16" id="trndockerimage"
															value="@bind(vm.currentEnvironment.trndockerimage)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['trndockerimage'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Dockerfile -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Dockerfile" />
														<textbox tabindex="17" id="trndockerfile"
															value="@bind(vm.currentEnvironment.trndockerfile)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trndockerfile'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Containerid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Containerid" />
														<textbox tabindex="18" id="trncontainerid"
															value="@bind(vm.currentEnvironment.trncontainerid)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trncontainerid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gitrepo -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitrepo" />
														<textbox tabindex="19" id="trngitrepo"
															value="@bind(vm.currentEnvironment.trngitrepo)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['trngitrepo'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gitcommit -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitcommit" />
														<textbox tabindex="20" id="trngitcommit"
															value="@bind(vm.currentEnvironment.trngitcommit)"
															maxlength="40"
															constraint="max 40" />
														<label sclass="text-danger" value="@load(vmsgs['trngitcommit'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gitbranch -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitbranch" />
														<textbox tabindex="21" id="trngitbranch"
															value="@bind(vm.currentEnvironment.trngitbranch)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trngitbranch'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gitdirty -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitdirty" />
														<textbox tabindex="22" id="trngitdirty"
															value="@bind(vm.currentEnvironment.trngitdirty)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trngitdirty'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gitdiff -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitdiff" />
														<textbox tabindex="23" id="trngitdiff"
															value="@bind(vm.currentEnvironment.trngitdiff)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trngitdiff'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Framework -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Framework" />
														<combobox tabindex="24" id="trnframework"
															selectedItem="@bind(vm.currentEnvironment.trnframework)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnframework'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Frameworkversion -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Frameworkversion" />
														<combobox tabindex="25" id="trnframeworkversion"
															selectedItem="@bind(vm.currentEnvironment.trnframeworkversion)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnframeworkversion'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Frameworkbackend -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Frameworkbackend" />
														<combobox tabindex="26" id="trnframeworkbackend"
															selectedItem="@bind(vm.currentEnvironment.trnframeworkbackend)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnframeworkbackend'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Envvars -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Envvars" />
														<textbox tabindex="27" id="trnenvvars"
															value="@bind(vm.currentEnvironment.trnenvvars)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnenvvars'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Reprohash -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Reprohash" />
														<textbox tabindex="28" id="trnreprohash"
															value="@bind(vm.currentEnvironment.trnreprohash)"
															maxlength="64"
															constraint="max 64" />
														<label sclass="text-danger" value="@load(vmsgs['trnreprohash'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Isreproducible -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Isreproducible" />
														<textbox tabindex="29" id="trnisreproducible"
															value="@bind(vm.currentEnvironment.trnisreproducible)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnisreproducible'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Created At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="30" id="trncreatedat"
															value="@bind(vm.currentEnvironment.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
