<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.MetricSeriesDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Metric Series" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Metric Name -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric Name *" />
														<textbox tabindex="2" id="trnmetricname"
															value="@bind(vm.currentMetricSeries.trnmetricname) @save(vm.currentMetricSeries.trnmetricname, before=('saveItem')) @validator(vm.unique, field='TRNMETRICNAME', required=true, oldValue=vm.originalTrnmetricname)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['trnmetricname'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Value S -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Value S" />
														<textbox tabindex="3" id="trnvalues"
															value="@bind(vm.currentMetricSeries.trnvalues)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnvalues'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Steps -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Steps" />
														<textbox tabindex="4" id="trnsteps"
															value="@bind(vm.currentMetricSeries.trnsteps)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnsteps'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Time Stamps -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Time Stamps" />
														<textbox tabindex="5" id="trntimestamps"
															value="@bind(vm.currentMetricSeries.trntimestamps)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trntimestamps'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Minvalue -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Minvalue" />
														<textbox tabindex="6" id="trnminvalue"
															value="@bind(vm.currentMetricSeries.trnminvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnminvalue'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Maxvalue -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Maxvalue" />
														<textbox tabindex="7" id="trnmaxvalue"
															value="@bind(vm.currentMetricSeries.trnmaxvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnmaxvalue'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Avgvalue -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Avgvalue" />
														<textbox tabindex="8" id="trnavgvalue"
															value="@bind(vm.currentMetricSeries.trnavgvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnavgvalue'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Lastvalue -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lastvalue" />
														<textbox tabindex="9" id="trnlastvalue"
															value="@bind(vm.currentMetricSeries.trnlastvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnlastvalue'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Trend -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Trend" />
														<textbox tabindex="10" id="trntrend"
															value="@bind(vm.currentMetricSeries.trntrend)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trntrend'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Totalpoints -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Totalpoints" />
														<textbox tabindex="11" id="trntotalpoints"
															value="@bind(vm.currentMetricSeries.trntotalpoints)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trntotalpoints'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Samplingrate -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Samplingrate" />
														<textbox tabindex="12" id="trnsamplingrate"
															value="@bind(vm.currentMetricSeries.trnsamplingrate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnsamplingrate'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Created At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="13" id="trncreatedat"
															value="@bind(vm.currentMetricSeries.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Updated At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="14" id="trnupdatedat"
															value="@bind(vm.currentMetricSeries.trnupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>