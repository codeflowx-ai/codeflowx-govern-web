<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.RunDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Run" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Runuuid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Runuuid *" />
														<textbox tabindex="2" id="trnrunuuid"
															value="@bind(vm.currentRun.trnrunuuid)"
															maxlength="64"
															constraint="no empty: max 64" />
														<label sclass="text-danger" value="@load(vmsgs['trnrunuuid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Runname -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Runname" />
														<textbox tabindex="3" id="trnrunname"
															value="@bind(vm.currentRun.trnrunname) @save(vm.currentRun.trnrunname, before=('saveItem')) @validator(vm.unique, field='TRNRUNNAME', required=false, oldValue=vm.originalTrnrunname)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnrunname'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Userid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Userid" />
														<textbox tabindex="4" id="trnuserid"
															value="@bind(vm.currentRun.trnuserid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnuserid'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Status -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="5" id="trnstatus"
															selectedItem="@bind(vm.currentRun.trnstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Starttime -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Starttime *" />
														<textbox tabindex="6" id="trnstarttime"
															value="@bind(vm.currentRun.trnstarttime)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trnstarttime'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Endtime -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endtime" />
														<textbox tabindex="7" id="trnendtime"
															value="@bind(vm.currentRun.trnendtime)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnendtime'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Artifact Uri -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Artifact Uri" />
														<textbox tabindex="8" id="trnartifacturi"
															value="@bind(vm.currentRun.trnartifacturi)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['trnartifacturi'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Lifecyclestage -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lifecyclestage *" />
														<textbox tabindex="9" id="trnlifecyclestage"
															value="@bind(vm.currentRun.trnlifecyclestage)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['trnlifecyclestage'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Tag S -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tag S" />
														<h:div class="input-group">
															<textbox value="@bind(vm.newTrntags)"
																placeholder="Añadir tag s"
																onOK="@command('addTrntags')" />
															<button onClick="@command('addTrntags')"
																iconSclass="fa-plus" />
														</h:div>
														<h:div class="mt-2">
															<forEach items="@load(vm.selectedTrntagss)" var="tag">
																<h:span class="badge bg-primary me-1">
																	<label value="@load(tag)" />
																	<a onClick="@command('removeTrntags', tag=tag)"
																		iconSclass="fa-times" class="ms-1" />
																</h:span>
															</forEach>
														</h:div>
														<label sclass="text-danger" value="@load(vmsgs['trntags'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Metadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata" />
														<textbox tabindex="11" id="trnmetadata"
															value="@bind(vm.currentRun.trnmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnmetadata'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Governance Status -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Governance Status" />
														<combobox tabindex="12" id="trngovernancestatus"
															selectedItem="@bind(vm.currentRun.trngovernancestatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trngovernancestatus'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Approval Date -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approval Date" />
														<textbox tabindex="13" id="trnapprovaldate"
															value="@bind(vm.currentRun.trnapprovaldate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnapprovaldate'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Approvedby -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedby" />
														<textbox tabindex="14" id="trnapprovedby"
															value="@bind(vm.currentRun.trnapprovedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnapprovedby'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Rejectionreason -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Rejectionreason" />
														<textbox tabindex="15" id="trnrejectionreason"
															value="@bind(vm.currentRun.trnrejectionreason)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnrejectionreason'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Compliance Checks -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Compliance Checks" />
														<textbox tabindex="16" id="trncompliancechecks"
															value="@bind(vm.currentRun.trncompliancechecks)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncompliancechecks'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Bias Score -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Bias Score" />
														<textbox tabindex="17" id="trnbiasscore"
															value="@bind(vm.currentRun.trnbiasscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnbiasscore'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Securityscore -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Securityscore" />
														<textbox tabindex="18" id="trnsecurityscore"
															value="@bind(vm.currentRun.trnsecurityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnsecurityscore'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gitrepo -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitrepo" />
														<textbox tabindex="19" id="trngitrepo"
															value="@bind(vm.currentRun.trngitrepo)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['trngitrepo'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Gitcommithash -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitcommithash" />
														<textbox tabindex="20" id="trngitcommithash"
															value="@bind(vm.currentRun.trngitcommithash)"
															maxlength="40"
															constraint="max 40" />
														<label sclass="text-danger" value="@load(vmsgs['trngitcommithash'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Gitbranch -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Gitbranch" />
														<textbox tabindex="21" id="trngitbranch"
															value="@bind(vm.currentRun.trngitbranch)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trngitbranch'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Runtype -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Runtype" />
														<combobox tabindex="22" id="trnruntype"
															selectedItem="@bind(vm.currentRun.trnruntype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnruntype'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Hierarchylevel -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Hierarchylevel" />
														<textbox tabindex="23" id="trnhierarchylevel"
															value="@bind(vm.currentRun.trnhierarchylevel)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnhierarchylevel'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Hierarchypath -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Hierarchypath" />
														<textbox tabindex="24" id="trnhierarchypath"
															value="@bind(vm.currentRun.trnhierarchypath)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['trnhierarchypath'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Created At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="25" id="trncreatedat"
															value="@bind(vm.currentRun.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Updated At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At *" />
														<textbox tabindex="26" id="trnupdatedat"
															value="@bind(vm.currentRun.trnupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Subtrncheckpoints -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subtrncheckpoints" />
														<textbox tabindex="27" id="subtrncheckpoints"
															value="@bind(vm.currentRun.subtrncheckpoints)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subtrncheckpoints'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Subtrnenvironments -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subtrnenvironments" />
														<textbox tabindex="28" id="subtrnenvironments"
															value="@bind(vm.currentRun.subtrnenvironments)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subtrnenvironments'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Subtrnhpotrials -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subtrnhpotrials" />
														<textbox tabindex="29" id="subtrnhpotrials"
															value="@bind(vm.currentRun.subtrnhpotrials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subtrnhpotrials'])" />
													</h:div>
												</h:div>
											</h:div>
