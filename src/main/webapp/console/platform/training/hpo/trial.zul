<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="training"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.training.HPOTrialDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-graduation-cap label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Hpo Trial" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Trialnumber -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Trialnumber *" />
														<textbox tabindex="2" id="trntrialnumber"
															value="@bind(vm.currentHPOTrial.trntrialnumber)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trntrialnumber'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Params -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Params *" />
														<textbox tabindex="3" id="trnparams"
															value="@bind(vm.currentHPOTrial.trnparams)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trnparams'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Score -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Score" />
														<textbox tabindex="4" id="trnscore"
															value="@bind(vm.currentHPOTrial.trnscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnscore'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Allmetrics -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Allmetrics" />
														<textbox tabindex="5" id="trnallmetrics"
															value="@bind(vm.currentHPOTrial.trnallmetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnallmetrics'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Durationseconds -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Durationseconds" />
														<textbox tabindex="6" id="trndurationseconds"
															value="@bind(vm.currentHPOTrial.trndurationseconds)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trndurationseconds'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Improvement -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Improvement" />
														<textbox tabindex="7" id="trnimprovement"
															value="@bind(vm.currentHPOTrial.trnimprovement)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnimprovement'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Isbest -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Isbest" />
														<textbox tabindex="8" id="trnisbest"
															value="@bind(vm.currentHPOTrial.trnisbest)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnisbest'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Waspruned -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Waspruned" />
														<textbox tabindex="9" id="trnwaspruned"
															value="@bind(vm.currentHPOTrial.trnwaspruned)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnwaspruned'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Prunereason -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Prunereason" />
														<textbox tabindex="10" id="trnprunereason"
															value="@bind(vm.currentHPOTrial.trnprunereason)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['trnprunereason'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Status -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="11" id="trnstatus"
															selectedItem="@bind(vm.currentHPOTrial.trnstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['trnstatus'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Errormessage -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Errormessage" />
														<textbox tabindex="12" id="trnerrormessage"
															value="@bind(vm.currentHPOTrial.trnerrormessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnerrormessage'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Startedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Startedat" />
														<textbox tabindex="13" id="trnstartedat"
															value="@bind(vm.currentHPOTrial.trnstartedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnstartedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Completed At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Completed At" />
														<textbox tabindex="14" id="trncompletedat"
															value="@bind(vm.currentHPOTrial.trncompletedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trncompletedat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Created At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="15" id="trncreatedat"
															value="@bind(vm.currentHPOTrial.trncreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['trncreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Updated At -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="16" id="trnupdatedat"
															value="@bind(vm.currentHPOTrial.trnupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['trnupdatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>