<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="notifications"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.notifications.NotificationPreferenceDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Notification Preference" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveNotificationPreference')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Ntfpreferenceuserid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferenceuserid *" />
														<textbox tabindex="2" id="ntfpreferenceuserid"
															value="@bind(vm.currentNotificationPreference.ntfpreferenceuserid)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferenceuserid'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferencecategory -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencecategory *" />
														<textbox tabindex="3" id="ntfpreferencecategory"
															value="@bind(vm.currentNotificationPreference.ntfpreferencecategory)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencecategory'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferenceemailenabled -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferenceemailenabled" />
														<textbox tabindex="4" id="ntfpreferenceemailenabled"
															value="@bind(vm.currentNotificationPreference.ntfpreferenceemailenabled) @save(vm.currentNotificationPreference.ntfpreferenceemailenabled, before=('saveItem')) @validator(vm.unique, field='NTFPREFERENCEEMAILENABLED', required=false, oldValue=vm.originalNtfpreferenceemailenabled)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferenceemailenabled'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferencesmsenabled -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencesmsenabled" />
														<textbox tabindex="5" id="ntfpreferencesmsenabled"
															value="@bind(vm.currentNotificationPreference.ntfpreferencesmsenabled)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencesmsenabled'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferencepushenabled -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencepushenabled" />
														<textbox tabindex="6" id="ntfpreferencepushenabled"
															value="@bind(vm.currentNotificationPreference.ntfpreferencepushenabled)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencepushenabled'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferenceinappenabled -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferenceinappenabled" />
														<textbox tabindex="7" id="ntfpreferenceinappenabled"
															value="@bind(vm.currentNotificationPreference.ntfpreferenceinappenabled)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferenceinappenabled'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferencedndstart -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencedndstart" />
														<textbox tabindex="8" id="ntfpreferencedndstart"
															value="@bind(vm.currentNotificationPreference.ntfpreferencedndstart)"
															maxlength="5"
															constraint="max 5" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencedndstart'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferencedndend -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencedndend" />
														<textbox tabindex="9" id="ntfpreferencedndend"
															value="@bind(vm.currentNotificationPreference.ntfpreferencedndend)"
															maxlength="5"
															constraint="max 5" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencedndend'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferencednddays -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencednddays" />
														<textbox tabindex="10" id="ntfpreferencednddays"
															value="@bind(vm.currentNotificationPreference.ntfpreferencednddays)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencednddays'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferencedigestfrequency -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencedigestfrequency" />
														<textbox tabindex="11" id="ntfpreferencedigestfrequency"
															value="@bind(vm.currentNotificationPreference.ntfpreferencedigestfrequency)"
															maxlength="20"
															constraint="max 20" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencedigestfrequency'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferenceactive -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferenceactive" />
														<textbox tabindex="12" id="ntfpreferenceactive"
															value="@bind(vm.currentNotificationPreference.ntfpreferenceactive)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferenceactive'])" />
													</div>
												</div>
											</div>											<!-- Ntfpreferencecreatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferencecreatedat *" />
														<textbox tabindex="13" id="ntfpreferencecreatedat"
															value="@bind(vm.currentNotificationPreference.ntfpreferencecreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferencecreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Ntfpreferenceupdatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntfpreferenceupdatedat" />
														<textbox tabindex="14" id="ntfpreferenceupdatedat"
															value="@bind(vm.currentNotificationPreference.ntfpreferenceupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntfpreferenceupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>