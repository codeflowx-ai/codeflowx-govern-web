<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="notifications"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.notifications.NotificationLogDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<h:div class="row">
			<div>
				<h:div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Notification Log" class="text-muted" />
					</h:p>
				</h:div>
			</h:div>
			
			<h:div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</h:div>
							</h:div>
						</h:div>
					</h:div><!--header-->
					
					<h:div class="card-body">
						<h:div class="row">
							<!-- Formulario Principal -->
							<h:div class="col-lg-12 col-xlg-12 col-md-12">
								<h:div class="card default shadow-xl">
									<h:div class="card-body">

										<h:div class="form-group row">
											<!-- Ntflogstatus -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogstatus *" />
														<combobox tabindex="2" id="ntflogstatus"
															selectedItem="@bind(vm.currentNotificationLog.ntflogstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['ntflogstatus'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogerrormessage -->
											<h:div class="default col-lg-12 col-xlg-12 col-md-12">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogerrormessage" />
														<textbox tabindex="3" id="ntflogerrormessage"
															value="@bind(vm.currentNotificationLog.ntflogerrormessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntflogerrormessage'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogerrorcode -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogerrorcode" />
														<textbox tabindex="4" id="ntflogerrorcode"
															value="@bind(vm.currentNotificationLog.ntflogerrorcode) @save(vm.currentNotificationLog.ntflogerrorcode, before=('saveItem')) @validator(vm.unique, field='NTFLOGERRORCODE', required=false, oldValue=vm.originalNtflogerrorcode)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogerrorcode'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogattempts -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogattempts *" />
														<textbox tabindex="5" id="ntflogattempts"
															value="@bind(vm.currentNotificationLog.ntflogattempts)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogattempts'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogprocessingtime -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogprocessingtime" />
														<textbox tabindex="6" id="ntflogprocessingtime"
															value="@bind(vm.currentNotificationLog.ntflogprocessingtime)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntflogprocessingtime'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogrecipientid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogrecipientid *" />
														<textbox tabindex="7" id="ntflogrecipientid"
															value="@bind(vm.currentNotificationLog.ntflogrecipientid)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogrecipientid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogrecipientaddress -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogrecipientaddress" />
														<textbox tabindex="8" id="ntflogrecipientaddress"
															value="@bind(vm.currentNotificationLog.ntflogrecipientaddress)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogrecipientaddress'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogproviderid -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogproviderid" />
														<textbox tabindex="9" id="ntflogproviderid"
															value="@bind(vm.currentNotificationLog.ntflogproviderid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogproviderid'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogproviderresponse -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogproviderresponse" />
														<textbox tabindex="10" id="ntflogproviderresponse"
															value="@bind(vm.currentNotificationLog.ntflogproviderresponse)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogproviderresponse'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogmetadata -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogmetadata" />
														<textbox tabindex="11" id="ntflogmetadata"
															value="@bind(vm.currentNotificationLog.ntflogmetadata)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogmetadata'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogsentat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogsentat" />
														<textbox tabindex="12" id="ntflogsentat"
															value="@bind(vm.currentNotificationLog.ntflogsentat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntflogsentat'])" />
													</h:div>
												</h:div>
											</h:div>											<!-- Ntflogdeliveredat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogdeliveredat" />
														<textbox tabindex="13" id="ntflogdeliveredat"
															value="@bind(vm.currentNotificationLog.ntflogdeliveredat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['ntflogdeliveredat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
										<h:div class="form-group row">
											<!-- Ntflogcreatedat -->
											<h:div class="default col-lg-6 col-xlg-6 col-md-6">
												<h:div class="row">
													<h:div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Ntflogcreatedat *" />
														<textbox tabindex="14" id="ntflogcreatedat"
															value="@bind(vm.currentNotificationLog.ntflogcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['ntflogcreatedat'])" />
													</h:div>
												</h:div>
											</h:div>
										</h:div>
									</h:div>
								</h:div>
							</h:div>

						</h:div>
					</h:div>
				</h:div><!--card-->
			</h:div><!--lg-->
		</h:div><!--row-->
	</idspace>
</zk>