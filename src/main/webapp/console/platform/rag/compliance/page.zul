<?page title="RAG Compliance" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagComplianceViewModel')">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="mb-1">
                    <i class="fas fa-shield-alt me-2"></i>
                    Cumplimiento Normativo RAG
                </h2>
                <p class="text-muted">Monitoreo de cumplimiento y políticas de gobierno para sistemas RAG</p>
            </div>
        </div>

        <!-- Métricas de Cumplimiento -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Sistemas Monitorizados</p>
                                <h3 class="mb-0" label="@load(vm.totalSystems)"/>
                            </div>
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-server text-primary fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Conformes</p>
                                <h3 class="mb-0 text-success" label="@load(vm.compliantSystems)"/>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-check-circle text-success fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Alertas Activas</p>
                                <h3 class="mb-0 text-danger" label="@load(vm.activeAlerts)"/>
                            </div>
                            <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-exclamation-triangle text-danger fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Score Global</p>
                                <h3 class="mb-0">
                                    <label value="@load(vm.globalComplianceScore)"/>%
                                </h3>
                            </div>
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-percentage text-info fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <combobox class="form-control" placeholder="Estado de Cumplimiento"
                                  value="@bind(vm.filterCompliance)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Conforme" value="COMPLIANT"/>
                            <comboitem label="No Conforme" value="NON_COMPLIANT"/>
                            <comboitem label="En Revisión" value="UNDER_REVIEW"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Nivel de Riesgo"
                                  value="@bind(vm.filterRiskLevel)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Crítico" value="CRITICAL"/>
                            <comboitem label="Alto" value="HIGH"/>
                            <comboitem label="Medio" value="MEDIUM"/>
                            <comboitem label="Bajo" value="LOW"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Categoría"
                                  value="@bind(vm.filterCategory)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todas" value=""/>
                            <comboitem label="Privacidad" value="PRIVACY"/>
                            <comboitem label="Seguridad" value="SECURITY"/>
                            <comboitem label="Calidad" value="QUALITY"/>
                            <comboitem label="Ética" value="ETHICS"/>
                            <comboitem label="Legal" value="LEGAL"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <textbox class="form-control" placeholder="Buscar sistema..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchSystems')"/>
                        </div>
                    </div>
                    
                    <div class="col-md-2">
                        <button class="btn btn-outline-primary w-100" onClick="@command('viewGovernanceDashboard')">
                            <i class="fas fa-external-link-alt me-1"></i>Ver Gobierno
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Compliance -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Estado de Cumplimiento por Sistema</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-2" onClick="@command('exportComplianceReport')">
                            <i class="fas fa-file-download me-1"></i>Exportar
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onClick="@command('refreshCompliance')">
                            <i class="fas fa-sync-alt me-1"></i>Actualizar
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sistema RAG</th>
                                <th class="text-center">Score</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Riesgo</th>
                                <th class="text-center">Alertas</th>
                                <th>Última Auditoría</th>
                                <th>Responsable</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.systemsList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragsystemname)"/>
                                        <br/>
                                        <small class="text-muted">v<label value="@load(each.ragversion)"/></small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <div class="progress" style="width: 70px; height: 8px;">
                                            <div class="progress-bar @load(vm.getComplianceProgressColor(each.ragcompliancescore))" 
                                                 style="@load(concat('width: ', each.ragcompliancescore, '%'))"></div>
                                        </div>
                                        <span class="ms-2 fw-bold" label="@load(each.ragcompliancescore)"/>%
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getComplianceStatusColor(each.ragcompliancestatus))"
                                          label="@load(vm.translateStatus(each.ragcompliancestatus))"/>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getRiskLevelColor(each.ragrisklevel))"
                                          label="@load(each.ragrisklevel)"/>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger" visible="@load(vm.hasActiveAlerts(each))">
                                        <label value="@load(vm.getAlertCount(each))"/>
                                    </span>
                                    <span class="text-muted" visible="@load(!vm.hasActiveAlerts(each))">-</span>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.raglastaudited))"/>
                                </td>
                                <td>
                                    <small label="@load(each.ragowner)"/>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewSystemCompliance', system=each)"
                                                title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-success btn-sm" 
                                                onClick="@command('runComplianceCheck', system=each)"
                                                title="Verificar cumplimiento">
                                            <i class="fas fa-check"></i>
                                        </button>
                                        <button class="btn btn-outline-warning btn-sm" 
                                                onClick="@command('viewAuditHistory', system=each)"
                                                title="Historial de auditoría">
                                            <i class="fas fa-history"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Panel de Políticas de Gobierno -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-gavel me-2"></i>
                    Políticas de Gobierno Activas
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6" forEach="@load(vm.governancePolicies)">
                        <div class="card border @load(vm.getPolicyBorderColor(each))">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="mb-0">
                                        <i class="@load(vm.getPolicyIcon(each.category)) me-2"></i>
                                        <label value="@load(each.policyName)"/>
                                    </h6>
                                    <span class="@load(vm.getPolicyStatusColor(each.status))"
                                          label="@load(each.status)"/>
                                </div>
                                <p class="text-muted small mb-2" label="@load(each.description)"/>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        Categoría: <strong label="@load(each.category)"/>
                                    </small>
                                    <button class="btn btn-sm btn-outline-secondary" 
                                            onClick="@command('viewPolicyDetails', policy=each)">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-3" visible="@load(vm.governancePolicies.size() eq 0)">
                    <p class="text-muted">
                        <i class="fas fa-info-circle me-2"></i>
                        No hay políticas de gobierno configuradas. 
                        Configure políticas desde el módulo de Gobierno.
                    </p>
                </div>
            </div>
        </div>

        <!-- Alertas Críticas -->
        <div class="alert alert-danger" visible="@load(vm.activeAlerts gt 0)">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle fa-2x me-3"></i>
                <div class="flex-grow-1">
                    <h5 class="mb-1">Alertas Críticas de Cumplimiento</h5>
                    <p class="mb-2">
                        Hay <strong label="@load(vm.activeAlerts)"/> sistemas con alertas activas que requieren atención inmediata.
                    </p>
                </div>
                <button class="btn btn-light" onClick="@command('viewAllAlerts')">
                    <i class="fas fa-bell me-1"></i>
                    Ver Todas las Alertas
                </button>
            </div>
        </div>

    </div>
</zk>

