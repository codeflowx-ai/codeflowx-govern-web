<?page title="RAG Compliance" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagComplianceViewModel')">
        
        <!-- Header -->
        <n:div class="row mb-4">
            <n:div class="col-12">
                <h:h2 class="mb-1">
                    <n:i class="fas fa-shield-alt me-2"></n:i>
                    Cumplimiento Normativo RAG
                </h:h2>
                <h:p class="text-muted">Monitoreo de cumplimiento y políticas de gobierno para sistemas RAG</n:p>
            </n:div>
        </n:div>

        <!-- Métricas de Cumplimiento -->
        <n:div class="row mb-4">
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Sistemas Monitorizados</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalSystems)"/>
                            </n:div>
                            <n:div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-server text-primary fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Conformes</n:p>
                                <h:h3 class="mb-0 text-success" label="@load(vm.compliantSystems)"/>
                            </n:div>
                            <n:div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-check-circle text-success fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Alertas Activas</n:p>
                                <h:h3 class="mb-0 text-danger" label="@load(vm.activeAlerts)"/>
                            </n:div>
                            <n:div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-exclamation-triangle text-danger fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Score Global</n:p>
                                <h:h3 class="mb-0">
                                    <label value="@load(vm.globalComplianceScore)"/>%
                                </h:h3>
                            </n:div>
                            <n:div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-percentage text-info fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Filtros -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body">
                <n:div class="row g-3">
                    <n:div class="col-md-3">
                        <combobox class="form-control" placeholder="Estado de Cumplimiento"
                                  value="@bind(vm.filterCompliance)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Conforme" value="COMPLIANT"/>
                            <comboitem label="No Conforme" value="NON_COMPLIANT"/>
                            <comboitem label="En Revisión" value="UNDER_REVIEW"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <combobox class="form-control" placeholder="Nivel de Riesgo"
                                  value="@bind(vm.filterRiskLevel)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Crítico" value="CRITICAL"/>
                            <comboitem label="Alto" value="HIGH"/>
                            <comboitem label="Medio" value="MEDIUM"/>
                            <comboitem label="Bajo" value="LOW"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <combobox class="form-control" placeholder="Categoría"
                                  value="@bind(vm.filterCategory)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todas" value=""/>
                            <comboitem label="Privacidad" value="PRIVACY"/>
                            <comboitem label="Seguridad" value="SECURITY"/>
                            <comboitem label="Calidad" value="QUALITY"/>
                            <comboitem label="Ética" value="ETHICS"/>
                            <comboitem label="Legal" value="LEGAL"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-3">
                        <n:div class="input-group">
                            <n:span class="input-group-text bg-white">
                                <n:i class="fas fa-search text-muted"></n:i>
                            </n:span>
                            <textbox class="form-control" placeholder="Buscar sistema..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchSystems')"/>
                        </n:div>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <button class="btn btn-outline-primary w-100" onClick="@command('viewGovernanceDashboard')">
                            <n:i class="fas fa-external-link-alt me-1"></n:i>Ver Gobierno
                        </button>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Tabla de Compliance -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-header bg-white py-3">
                <n:div class="d-flex justify-content-between align-items-center">
                    <h:h5 class="mb-0">Estado de Cumplimiento por Sistema</n:h5>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-2" onClick="@command('exportComplianceReport')">
                            <n:i class="fas fa-file-download me-1"></n:i>Exportar
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onClick="@command('refreshCompliance')">
                            <n:i class="fas fa-sync-alt me-1"></n:i>Actualizar
                        </button>
                    </n:div>
                </n:div>
            </n:div>
            <n:div class="card-body p-0">
                <n:div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sistema RAG</th>
                                <th class="text-center">Score</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Riesgo</th>
                                <th class="text-center">Alertas</th>
                                <th>Última Auditoría</th>
                                <th>Responsable</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.systemsList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragsystemname)"/>
                                        <br/>
                                        <small class="text-muted">v<label value="@load(each.ragversion)"/></small>
                                    </n:div>
                                </td>
                                <td class="text-center">
                                    <n:div class="d-flex align-items-center justify-content-center">
                                        <n:div class="progress" style="width: 70px; height: 8px;">
                                            <n:div class="progress-bar @load(vm.getComplianceProgressColor(each.ragcompliancescore))" 
                                                 style="@load(concat('width: ', each.ragcompliancescore, '%'))"></n:div>
                                        </n:div>
                                        <n:span class="ms-2 fw-bold" label="@load(each.ragcompliancescore)"/>%
                                    </n:div>
                                </td>
                                <td class="text-center">
                                    <n:span class="@load(vm.getComplianceStatusColor(each.ragcompliancestatus))"
                                          label="@load(vm.translateStatus(each.ragcompliancestatus))"/>
                                </td>
                                <td class="text-center">
                                    <n:span class="@load(vm.getRiskLevelColor(each.ragrisklevel))"
                                          label="@load(each.ragrisklevel)"/>
                                </td>
                                <td class="text-center">
                                    <n:span class="badge bg-danger" visible="@load(vm.hasActiveAlerts(each))">
                                        <label value="@load(vm.getAlertCount(each))"/>
                                    </n:span>
                                    <n:span class="text-muted" visible="@load(!vm.hasActiveAlerts(each))">-</n:span>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.raglastaudited))"/>
                                </td>
                                <td>
                                    <small label="@load(each.ragowner)"/>
                                </td>
                                <td class="text-center">
                                    <n:div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewSystemCompliance', system=each)"
                                                title="Ver detalles">
                                            <n:i class="fas fa-eye"></n:i>
                                        </button>
                                        <button class="btn btn-outline-success btn-sm" 
                                                onClick="@command('runComplianceCheck', system=each)"
                                                title="Verificar cumplimiento">
                                            <n:i class="fas fa-check"></n:i>
                                        </button>
                                        <button class="btn btn-outline-warning btn-sm" 
                                                onClick="@command('viewAuditHistory', system=each)"
                                                title="Historial de auditoría">
                                            <n:i class="fas fa-history"></n:i>
                                        </button>
                                    </n:div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </n:div>
            </n:div>
        </n:div>

        <!-- Panel de Políticas de Gobierno -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-header bg-white py-3">
                <h:h5 class="mb-0">
                    <n:i class="fas fa-gavel me-2"></n:i>
                    Políticas de Gobierno Activas
                </h:h5>
            </n:div>
            <n:div class="card-body">
                <n:div class="row g-3">
                    <n:div class="col-md-6" forEach="@load(vm.governancePolicies)">
                        <n:div class="card border @load(vm.getPolicyBorderColor(each))">
                            <n:div class="card-body">
                                <n:div class="d-flex justify-content-between align-items-start mb-2">
                                    <n:h6 class="mb-0">
                                        <n:i class="@load(vm.getPolicyIcon(each.category)) me-2"></n:i>
                                        <label value="@load(each.policyName)"/>
                                    </n:h6>
                                    <n:span class="@load(vm.getPolicyStatusColor(each.status))"
                                          label="@load(each.status)"/>
                                </n:div>
                                <h:p class="text-muted small mb-2" label="@load(each.description)"/>
                                <n:div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        Categoría: <strong label="@load(each.category)"/>
                                    </small>
                                    <button class="btn btn-sm btn-outline-secondary" 
                                            onClick="@command('viewItemDetails', policy=each)">
                                        <n:i class="fas fa-info-circle"></n:i>
                                    </button>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
                
                <n:div class="text-center mt-3" visible="@load(vm.governancePolicies.size() eq 0)">
                    <h:p class="text-muted">
                        <n:i class="fas fa-info-circle me-2"></n:i>
                        No hay políticas de gobierno configuradas. 
                        Configure políticas desde el módulo de Gobierno.
                    </h:p>
                </n:div>
            </n:div>
        </n:div>

        <!-- Alertas Críticas -->
        <n:div class="alert alert-danger" visible="@load(vm.activeAlerts gt 0)">
            <n:div class="d-flex align-items-center">
                <n:i class="fas fa-exclamation-circle fa-2x me-3"></n:i>
                <n:div class="flex-grow-1">
                    <h:h5 class="mb-1">Alertas Críticas de Cumplimiento</n:h5>
                    <h:p class="mb-2">
                        Hay <strong label="@load(vm.activeAlerts)"/> sistemas con alertas activas que requieren atención inmediata.
                    </h:p>
                </n:div>
                <button class="btn btn-light" onClick="@command('viewAllAlerts')">
                    <n:i class="fas fa-bell me-1"></n:i>
                    Ver Todas las Alertas
                </button>
            </n:div>
        </n:div>

    </n:div>
</zk>

