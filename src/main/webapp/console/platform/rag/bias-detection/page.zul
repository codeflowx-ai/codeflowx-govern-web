<?page title="RAG Bias Detection" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagBiasDetectionViewModel')">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="mb-1">
                    <i class="fas fa-balance-scale me-2"></i>
                    Detección de Sesgos en RAG
                </h2>
                <p class="text-muted">Análisis y monitoreo de sesgos en fuentes de datos y respuestas</p>
            </div>
        </div>

        <!-- Métricas -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Fuentes Analizadas</p>
                                <h3 class="mb-0" label="@load(vm.totalSources)"/>
                            </div>
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-database text-primary fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Score Promedio</p>
                                <h3 class="mb-0">
                                    <label value="@load(vm.averageBiasScore)"/>
                                    <small class="text-muted">/100</small>
                                </h3>
                            </div>
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-chart-line text-info fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Alto Riesgo</p>
                                <h3 class="mb-0 text-danger" label="@load(vm.highRiskSources)"/>
                            </div>
                            <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-exclamation-triangle text-danger fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Conformidad</p>
                                <h3 class="mb-0 text-success">
                                    <label value="@load(vm.complianceRate)"/>%
                                </h3>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-shield-alt text-success fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <combobox class="form-control" placeholder="Sistema RAG"
                                  value="@bind(vm.filterRagSystem)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los sistemas" value=""/>
                            <comboitem forEach="@load(vm.ragSystemsList)" 
                                       label="@load(each.ragsystemname)" 
                                       value="@load(each.idxragsystem)"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Nivel de Riesgo"
                                  value="@bind(vm.filterRiskLevel)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Alto (>70)" value="HIGH"/>
                            <comboitem label="Medio (30-70)" value="MEDIUM"/>
                            <comboitem label="Bajo (<30)" value="LOW"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Estado Cumplimiento"
                                  value="@bind(vm.filterCompliance)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Conforme" value="COMPLIANT"/>
                            <comboitem label="No Conforme" value="NON_COMPLIANT"/>
                            <comboitem label="Revisión" value="UNDER_REVIEW"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <textbox class="form-control" placeholder="Buscar fuente..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchSources')"/>
                        </div>
                    </div>
                    
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" onClick="@command('runBiasAnalysis')">
                            <i class="fas fa-play me-1"></i>Analizar Todo
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de análisis -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Análisis de Sesgos por Fuente</h5>
                    <button class="btn btn-sm btn-outline-secondary" onClick="@command('refreshAnalysis')">
                        <i class="fas fa-sync-alt me-1"></i>Actualizar
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fuente de Datos</th>
                                <th>Sistema RAG</th>
                                <th class="text-center">Score de Sesgo</th>
                                <th class="text-center">Nivel de Riesgo</th>
                                <th class="text-center">Documentos</th>
                                <th class="text-center">Cumplimiento</th>
                                <th>Última Análisis</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.sourcesList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragdssourcename)"/>
                                        <br/>
                                        <small class="text-muted" label="@load(each.ragdssourcetype)"/>
                                    </div>
                                </td>
                                <td>
                                    <label value="@load(vm.getRagSystemName(each.ragSystem))"/>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <div class="progress" style="width: 80px; height: 10px;">
                                            <div class="progress-bar @load(vm.getBiasProgressColor(each.ragdsbiasscore))" 
                                                 style="@load(concat('width: ', each.ragdsbiasscore, '%'))"></div>
                                        </div>
                                        <span class="ms-2 fw-bold @load(vm.getBiasScoreColor(each.ragdsbiasscore))" 
                                              label="@load(each.ragdsbiasscore)"/>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getRiskLevelColor(vm.getRiskLevel(each.ragdsbiasscore)))"
                                          label="@load(vm.getRiskLevel(each.ragdsbiasscore))"/>
                                </td>
                                <td class="text-center">
                                    <strong label="@load(each.ragdsdocumentcount)"/>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getComplianceColor(vm.getComplianceStatus(each.ragdsbiasscore)))"
                                          label="@load(vm.getComplianceStatus(each.ragdsbiasscore))"/>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.ragdslastindexed))"/>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewDetails', source=each)"
                                                title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-success btn-sm" 
                                                onClick="@command('analyzeSource', source=each)"
                                                title="Re-analizar">
                                            <i class="fas fa-sync"></i>
                                        </button>
                                        <button class="btn btn-outline-warning btn-sm" 
                                                onClick="@command('reportToGovernance', source=each)"
                                                visible="@load(vm.getRiskLevel(each.ragdsbiasscore) eq 'HIGH')"
                                                title="Reportar a Gobierno">
                                            <i class="fas fa-flag"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Leyenda -->
            <div class="card-footer bg-light">
                <div class="row">
                    <div class="col-12">
                        <small class="text-muted">
                            <strong>Interpretación del Score:</strong>
                            <span class="badge bg-success ms-2">0-30: Bajo Riesgo</span>
                            <span class="badge bg-warning ms-2">30-70: Medio Riesgo</span>
                            <span class="badge bg-danger ms-2">70-100: Alto Riesgo</span>
                            <span class="ms-3">
                                <i class="fas fa-info-circle"></i>
                                Scores altos indican mayor presencia de sesgos en el contenido
                            </span>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerta de Alto Riesgo -->
        <div class="alert alert-danger mt-4" visible="@load(vm.highRiskSources gt 0)">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                <div>
                    <h5 class="mb-1">Fuentes de Alto Riesgo Detectadas</h5>
                    <p class="mb-2">
                        Se han identificado <strong label="@load(vm.highRiskSources)"/> fuentes con alto nivel de sesgo.
                        Estas requieren revisión inmediata y pueden afectar el cumplimiento normativo.
                    </p>
                    <button class="btn btn-sm btn-light" onClick="@command('exportHighRiskReport')">
                        <i class="fas fa-file-download me-1"></i>
                        Exportar Reporte de Alto Riesgo
                    </button>
                </div>
            </div>
        </div>

    </div>
</zk>


