<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.DatasourceStatisticsOverviewViewModel')"
		validationMessages="@id('vmsgs')">

		<h:div class="row" style="background-color:;">
			<div><!-- Titulo pantalla -->
				<h:div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-books me-2"></h:i>
						<label value="Datasource Statistics" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión de Datasource Statistics" />
					</h:p>
				</h:div>
			</h:div>
			<h:div class="col-lg-12 s-bot ">
				<h:div class="card">
					<h:div class="card-header">
						<h:div class="d-flex align-items-center flex-wrap gap-2">
							<h:div class="flex-grow-1"></h:div>
							<h:div class="flex-shrink-0">
								<h:div class="hstack text-nowrap gap-2 d-flex">
								</h:div>
							</h:div>
						</h:div>
					</h:div>
				</h:div>
				<!--end col-->
			</h:div>

			<h:div class="section filters">
				<h:div class="search-bar">
					<!-- Búsqueda por texto -->
					<textbox value="@bind(vm.searchTerm)"
						placeholder="Buscar..."
						class="form-control" onOK="@command('applyFilters')" />
				</h:div>
				<h:div class="filter-icons">
					<a tooltiptext="Buscar"
						iconSclass="fa-duotone fa-magnifying-glass-waveform"
						onClick="@command('applyFilters')" />
					<a tooltiptext="Limpiar"
						iconSclass="fa-duotone fa-broom-wide"
						onClick="@command('clearFilters')" />
				</h:div>
			</h:div>
			<h:div class="col-xxl-12 s-bot">
				<h:div class="card">
					<h:div class="card-body">
						<h:div id="divTemplate" sclass="col-lg-12">
							<!-- listado -->
							<grid model="@load(vm.filteredItems)"
								style="overflow:auto;">
								<columns sizable="true"
									columnsgroup="false" columnshide="false">
									<column
										label="ID" align="center"
										sort="auto" width="5%" />

									<column sclass=" text-capitalize "
										label="Active Items" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Deployed Items" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Training Items" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Offline Items" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Avg Score" align="center"
										width="15%" />

									<column
										label="Acciones"
										align="center" />
								</columns>

								<template name="model" var="rag">
									<row
										style="text-align:right;cursor:pointer;"
										onClick="@command('viewItemDetails', itemId=rag.totalItems)">
										<label
											value="@load(rag.totalItems) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(rag.activeItems) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(rag.deployedItems) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(rag.trainingItems) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(rag.offlineItems) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(rag.avgScore) @converter(vm.fieldConverter)">
										</label>
										<cell align="center"
											class="d-flex">
											<h:div class="edit">
												<a
													onClick="@command('viewItemDetails', itemId=rag.totalItems)"
													iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"
													tooltiptext="Ver detalles" />
											</h:div>
										</cell>
									</row>
								</template>
								<foot>
									<footer span="3" align="right">
										<paging id="topagin"
											pageSize="@load(vm.pageParams.maxRows)" 
											totalSize="@load(vm.pageResult.totalRows)"
											activePage="@load(vm.pageParams.pageActual - 1)"
											onPaging="@command('onPaging', event=event)"
											mold="os" width="100%" />
									</footer>
									<footer span="4" align="left"></footer>
									<footer></footer>
								</foot>
							</grid>
						</h:div>
					</h:div>
				</h:div>
			</h:div>
		</h:div><!--end col-->
	</idspace>
</zk>