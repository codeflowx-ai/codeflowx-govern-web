<?page title="RAG Data Sources" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagDataSourceViewModel')">
        
        <!-- Header -->
        <n:div class="row mb-4">
            <n:div class="col-12">
                <h:h2 class="mb-1">
                    <n:i class="fas fa-database me-2"></n:i>
                    Fuentes de Datos RAG
                </h:h2>
                <h:p class="text-muted">Gestión de fuentes de datos e indexación</n:p>
            </n:div>
        </n:div>

        <!-- Métricas -->
        <n:div class="row mb-4">
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Total Fuentes</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalSources)"/>
                            </n:div>
                            <n:div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-folder text-primary fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Indexadas</n:p>
                                <h:h3 class="mb-0" label="@load(vm.indexedSources)"/>
                            </n:div>
                            <n:div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-check-circle text-success fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">En Proceso</n:p>
                                <h:h3 class="mb-0" label="@load(vm.indexingSources)"/>
                            </n:div>
                            <n:div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-sync text-warning fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Total Documentos</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalDocuments)"/>
                            </n:div>
                            <n:div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-file-alt text-info fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Filtros -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-body">
                <n:div class="row g-3">
                    <n:div class="col-md-3">
                        <combobox class="form-control" placeholder="Sistema RAG"
                                  value="@bind(vm.filterRagSystem)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los sistemas" value=""/>
                            <comboitem forEach="@load(vm.ragSystemsList)" 
                                       label="@load(each.ragsystemname)" 
                                       value="@load(each.idxragsystem)"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <combobox class="form-control" placeholder="Tipo"
                                  value="@bind(vm.filterType)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los tipos" value=""/>
                            <comboitem label="Sistema de Archivos" value="FILE_SYSTEM"/>
                            <comboitem label="API" value="API"/>
                            <comboitem label="Base de Datos" value="DATABASE"/>
                            <comboitem label="Web Scraping" value="WEB_SCRAPING"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <combobox class="form-control" placeholder="Estado"
                                  value="@bind(vm.filterStatus)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los estados" value=""/>
                            <comboitem label="Completado" value="COMPLETED"/>
                            <comboitem label="En Proceso" value="IN_PROGRESS"/>
                            <comboitem label="Pendiente" value="PENDING"/>
                            <comboitem label="Fallido" value="FAILED"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-3">
                        <n:div class="input-group">
                            <n:span class="input-group-text bg-white">
                                <n:i class="fas fa-search text-muted"></n:i>
                            </n:span>
                            <textbox class="form-control" placeholder="Buscar fuente..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchSources')"/>
                        </n:div>
                    </n:div>
                    
                    <n:div class="col-md-2">
                        <button class="btn btn-primary w-100" onClick="@command('showCreateModal')">
                            <n:i class="fas fa-plus me-1"></n:i>Nueva Fuente
                        </button>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Tabla de fuentes -->
        <n:div class="card border-0 shadow-sm">
            <n:div class="card-header bg-white py-3">
                <n:div class="d-flex justify-content-between align-items-center">
                    <h:h5 class="mb-0">Fuentes de Datos</n:h5>
                    <button class="btn btn-sm btn-outline-secondary" onClick="@command('refreshSources')">
                        <n:i class="fas fa-sync-alt me-1"></n:i>Actualizar
                    </button>
                </n:div>
            </n:div>
            <n:div class="card-body p-0">
                <n:div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fuente</th>
                                <th>Sistema RAG</th>
                                <th>Tipo</th>
                                <th class="text-center">Documentos</th>
                                <th class="text-center">Clasificación</th>
                                <th class="text-center">Calidad</th>
                                <th class="text-center">Estado</th>
                                <th>Última Indexación</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.sourcesList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragdssourcename)"/>
                                        <br/>
                                        <small class="text-muted" label="@load(each.ragdssourceurl)"/>
                                    </n:div>
                                </td>
                                <td>
                                    <label value="@load(vm.getRagSystemName(each.ragSystem))"/>
                                </td>
                                <td>
                                    <n:span class="badge bg-info" label="@load(each.ragdssourcetype)"/>
                                </td>
                                <td class="text-center">
                                    <strong label="@load(each.ragdsdocumentcount)"/>
                                </td>
                                <td class="text-center">
                                    <n:span class="@load(vm.getClassificationColor(each.ragdsdataclass))"
                                          label="@load(each.ragdsdataclass)"/>
                                </td>
                                <td class="text-center">
                                    <n:div class="d-flex align-items-center justify-content-center">
                                        <n:div class="progress" style="width: 60px; height: 8px;">
                                            <n:div class="progress-bar bg-success" 
                                                 style="@load(concat('width: ', each.ragdsqualityscore, '%'))"></n:div>
                                        </n:div>
                                        <n:span class="ms-2 small" label="@load(each.ragdsqualityscore)"/>
                                    </n:div>
                                </td>
                                <td class="text-center">
                                    <n:span class="@load(vm.getStatusColor(each.ragdsindexstatus))"
                                          label="@load(each.ragdsindexstatus)"/>
                                </td>
                                <td>
                                    <small label="@load(vm.formatDate(each.ragdslastindexed))"/>
                                </td>
                                <td class="text-center">
                                    <n:div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-success btn-sm" 
                                                onClick="@command('reindexSource', source=each)"
                                                title="Reindexar">
                                            <n:i class="fas fa-sync"></n:i>
                                        </button>
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewSource', source=each)"
                                                title="Ver">
                                            <n:i class="fas fa-eye"></n:i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                onClick="@command('editSource', source=each)"
                                                title="Editar">
                                            <n:i class="fas fa-edit"></n:i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" 
                                                onClick="@command('deleteItem', source=each)"
                                                title="Eliminar">
                                            <n:i class="fas fa-trash"></n:i>
                                        </button>
                                    </n:div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </n:div>
            </n:div>
        </n:div>

        <!-- Modal de Creación/Edición -->
        <window id="createEditModal" title="@load(vm.isEditMode ? 'Editar Fuente' : 'Nueva Fuente')"
                border="normal" width="700px" mode="modal" 
                visible="@load(vm.showModal)" onClose="@command('closeModal')">
            <n:div class="p-3">
                <n:div class="row g-3">
                    <!-- Sistema RAG -->
                    <n:div class="col-12">
                        <label class="form-label">Sistema RAG *</label>
                        <combobox class="form-control" value="@bind(vm.sourceRagSystemId)" buttonVisible="false">
                            <comboitem forEach="@load(vm.ragSystemsList)" 
                                       label="@load(each.ragsystemname)" 
                                       value="@load(each.idxragsystem)"/>
                        </combobox>
                    </n:div>
                    
                    <!-- Nombre -->
                    <n:div class="col-12">
                        <label class="form-label">Nombre de la Fuente *</label>
                        <textbox class="form-control" value="@bind(vm.sourceName)" 
                                 placeholder="Ej: Technical Documentation"/>
                    </n:div>
                    
                    <!-- Tipo y URL -->
                    <n:div class="col-md-6">
                        <label class="form-label">Tipo *</label>
                        <combobox class="form-control" value="@bind(vm.sourceType)" buttonVisible="false">
                            <comboitem label="Sistema de Archivos" value="FILE_SYSTEM"/>
                            <comboitem label="API" value="API"/>
                            <comboitem label="Base de Datos" value="DATABASE"/>
                            <comboitem label="Web Scraping" value="WEB_SCRAPING"/>
                        </combobox>
                    </n:div>
                    
                    <n:div class="col-md-6">
                        <label class="form-label">Clasificación de Datos *</label>
                        <combobox class="form-control" value="@bind(vm.sourceDataClass)" buttonVisible="false">
                            <comboitem label="Público" value="PUBLIC"/>
                            <comboitem label="Interno" value="INTERNAL"/>
                            <comboitem label="Confidencial" value="CONFIDENTIAL"/>
                            <comboitem label="Restringido" value="RESTRICTED"/>
                        </combobox>
                    </n:div>
                    
                    <!-- URL -->
                    <n:div class="col-12">
                        <label class="form-label">URL/Ruta</label>
                        <textbox class="form-control" value="@bind(vm.sourceUrl)" 
                                 placeholder="https:// o /path/to/files"/>
                    </n:div>
                    
                    <!-- Estado -->
                    <n:div class="col-12">
                        <label class="form-label">Estado de Indexación</label>
                        <combobox class="form-control" value="@bind(vm.sourceIndexStatus)" buttonVisible="false">
                            <comboitem label="Pendiente" value="PENDING"/>
                            <comboitem label="En Proceso" value="IN_PROGRESS"/>
                            <comboitem label="Completado" value="COMPLETED"/>
                            <comboitem label="Fallido" value="FAILED"/>
                        </combobox>
                    </n:div>
                </n:div>
                
                <!-- Botones -->
                <n:div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-secondary" onClick="@command('closeModal')">
                        Cancelar
                    </button>
                    <button class="btn btn-primary" onClick="@command('saveItem')">
                        <n:i class="fas fa-save me-1"></n:i>
                        Guardar
                    </button>
                </n:div>
            </n:div>
        </window>

    </n:div>
</zk>
