<?page title="RAG Access Control" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <n:div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagAccessControlViewModel')">
        
        <!-- Header -->
        <n:div class="row mb-4">
            <n:div class="col-12">
                <h:h2 class="mb-1">
                    <n:i class="fas fa-user-lock me-2"></n:i>
                    Control de Acceso RAG
                </h:h2>
                <h:p class="text-muted">Gestión de permisos y control de acceso a sistemas RAG</n:p>
            </n:div>
        </n:div>

        <!-- Métricas -->
        <n:div class="row mb-4">
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Usuarios Autorizados</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalUsers)"/>
                            </n:div>
                            <n:div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-users text-primary fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Roles Activos</n:p>
                                <h:h3 class="mb-0" label="@load(vm.totalRoles)"/>
                            </n:div>
                            <n:div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-user-tag text-success fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Intentos Bloqueados</n:p>
                                <h:h3 class="mb-0 text-danger" label="@load(vm.blockedAttempts)"/>
                            </n:div>
                            <n:div class="bg-danger bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-ban text-danger fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
            
            <n:div class="col-md-3">
                <n:div class="card border-0 shadow-sm">
                    <n:div class="card-body">
                        <n:div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h:p class="text-muted mb-1 small">Accesos Hoy</n:p>
                                <h:h3 class="mb-0" label="@load(vm.todayAccess)"/>
                            </n:div>
                            <n:div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <n:i class="fas fa-sign-in-alt text-info fa-lg"></n:i>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
            </n:div>
        </n:div>

        <!-- Tabs -->
        <n:div class="card border-0 shadow-sm mb-4">
            <n:div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link @load(vm.activeTab eq 'systems' ? 'active' : '')" 
                           onClick="@command('changeTab', tab='systems')">
                            <n:i class="fas fa-server me-1"></n:i>Sistemas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @load(vm.activeTab eq 'users' ? 'active' : '')" 
                           onClick="@command('changeTab', tab='users')">
                            <n:i class="fas fa-users me-1"></n:i>Usuarios
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @load(vm.activeTab eq 'roles' ? 'active' : '')" 
                           onClick="@command('changeTab', tab='roles')">
                            <n:i class="fas fa-user-tag me-1"></n:i>Roles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @load(vm.activeTab eq 'audit' ? 'active' : '')" 
                           onClick="@command('changeTab', tab='audit')">
                            <n:i class="fas fa-history me-1"></n:i>Auditoría
                        </a>
                    </li>
                </ul>
            </n:div>
            <n:div class="card-body">
                
                <!-- Tab: Sistemas -->
                <n:div visible="@load(vm.activeTab eq 'systems')">
                    <n:div class="row mb-3">
                        <n:div class="col-md-10">
                            <n:div class="input-group">
                                <n:span class="input-group-text bg-white">
                                    <n:i class="fas fa-search text-muted"></n:i>
                                </n:span>
                                <textbox class="form-control" placeholder="Buscar sistema..."
                                         value="@bind(vm.searchText)" instant="true"
                                         onChange="@command('searchSystems')"/>
                            </n:div>
                        </n:div>
                        <n:div class="col-md-2">
                            <button class="btn btn-primary w-100" onClick="@command('showAddAccessModal')">
                                <n:i class="fas fa-plus me-1"></n:i>Agregar Acceso
                            </button>
                        </n:div>
                    </n:div>
                    
                    <n:div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Sistema RAG</th>
                                    <th>Nivel de Acceso</th>
                                    <th class="text-center">Usuarios</th>
                                    <th class="text-center">Estado</th>
                                    <th>Última Modificación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr forEach="@load(vm.systemsList)">
                                    <td>
                                        <strong label="@load(each.ragsystemname)"/>
                                        <br/>
                                        <small class="text-muted" label="@load(each.ragdescription)"/>
                                    </td>
                                    <td>
                                        <n:span class="@load(vm.getAccessLevelColor(each.ragaccesslevel))"
                                              label="@load(vm.translateAccessLevel(each.ragaccesslevel))"/>
                                    </td>
                                    <td class="text-center">
                                        <n:span class="badge bg-secondary" label="@load(vm.getUserCount(each))"/>
                                    </td>
                                    <td class="text-center">
                                        <n:span class="@load(vm.getStatusColor(each.ragstatus))"
                                              label="@load(each.ragstatus)"/>
                                    </td>
                                    <td>
                                        <small label="@load(vm.formatDate(each.ragupdatedat))"/>
                                    </td>
                                    <td class="text-center">
                                        <n:div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    onClick="@command('manageAccess', system=each)"
                                                    title="Gestionar acceso">
                                                <n:i class="fas fa-key"></n:i>
                                            </button>
                                            <button class="btn btn-outline-info btn-sm" 
                                                    onClick="@command('viewPermissions', system=each)"
                                                    title="Ver permisos">
                                                <n:i class="fas fa-list"></n:i>
                                            </button>
                                        </n:div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </n:div>
                </n:div>
                
                <!-- Tab: Usuarios -->
                <n:div visible="@load(vm.activeTab eq 'users')">
                    <n:div class="row mb-3">
                        <n:div class="col-md-10">
                            <n:div class="input-group">
                                <n:span class="input-group-text bg-white">
                                    <n:i class="fas fa-search text-muted"></n:i>
                                </n:span>
                                <textbox class="form-control" placeholder="Buscar usuario..."
                                         value="@bind(vm.searchUserText)" instant="true"
                                         onChange="@command('searchUsers')"/>
                            </n:div>
                        </n:div>
                        <n:div class="col-md-2">
                            <button class="btn btn-outline-secondary w-100" onClick="@command('exportUserAccess')">
                                <n:i class="fas fa-file-download me-1"></n:i>Exportar
                            </button>
                        </n:div>
                    </n:div>
                    
                    <n:div class="alert alert-info">
                        <n:i class="fas fa-info-circle me-2"></n:i>
                        <strong>Integración con SSO:</strong> Los usuarios se gestionan desde el módulo de administración. 
                        Aquí solo se asignan permisos específicos para sistemas RAG.
                    </n:div>
                    
                    <n:div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Usuario</th>
                                    <th>Email</th>
                                    <th>Rol Principal</th>
                                    <th class="text-center">Sistemas Asignados</th>
                                    <th class="text-center">Estado</th>
                                    <th>Último Acceso</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr forEach="@load(vm.usersList)">
                                    <td>
                                        <n:i class="fas fa-user-circle me-2"></n:i>
                                        <strong label="@load(each.userName)"/>
                                    </td>
                                    <td>
                                        <small label="@load(each.userEmail)"/>
                                    </td>
                                    <td>
                                        <n:span class="badge bg-primary" label="@load(each.userRole)"/>
                                    </td>
                                    <td class="text-center">
                                        <n:span class="badge bg-info" label="@load(each.systemsCount)"/>
                                    </td>
                                    <td class="text-center">
                                        <n:span class="@load(vm.getUserStatusColor(each.userStatus))"
                                              label="@load(each.userStatus)"/>
                                    </td>
                                    <td>
                                        <small label="@load(vm.formatDate(each.lastAccess))"/>
                                    </td>
                                    <td class="text-center">
                                        <n:div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    onClick="@command('editUserAccess', user=each)"
                                                    title="Editar acceso">
                                                <n:i class="fas fa-edit"></n:i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" 
                                                    onClick="@command('revokeUserAccess', user=each)"
                                                    title="Revocar acceso">
                                                <n:i class="fas fa-ban"></n:i>
                                            </button>
                                        </n:div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </n:div>
                </n:div>
                
                <!-- Tab: Roles -->
                <n:div visible="@load(vm.activeTab eq 'roles')">
                    <n:div class="row mb-3">
                        <n:div class="col-12">
                            <button class="btn btn-primary" onClick="@command('createRole')">
                                <n:i class="fas fa-plus me-1"></n:i>Crear Rol
                            </button>
                        </n:div>
                    </n:div>
                    
                    <n:div class="row g-3">
                        <n:div class="col-md-4" forEach="@load(vm.rolesList)">
                            <n:div class="card">
                                <n:div class="card-body">
                                    <n:div class="d-flex justify-content-between align-items-start mb-3">
                                        <h:h5 class="mb-0">
                                            <n:i class="@load(vm.getRoleIcon(each.roleName)) me-2"></n:i>
                                            <label value="@load(each.roleName)"/>
                                        </h:h5>
                                        <n:span class="@load(vm.getRoleStatusColor(each.roleStatus))"
                                              label="@load(each.roleStatus)"/>
                                    </n:div>
                                    <h:p class="text-muted small mb-3" label="@load(each.roleDescription)"/>
                                    <n:div class="mb-2">
                                        <strong>Permisos:</strong>
                                        <ul class="small mb-0">
                                            <li forEach="@load(each.permissions)">
                                                <label value="@load(each)"/>
                                            </li>
                                        </ul>
                                    </n:div>
                                    <n:div class="d-flex justify-content-between align-items-center mt-3">
                                        <small class="text-muted">
                                            <label value="@load(each.usersCount)"/> usuarios
                                        </small>
                                        <n:div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    onClick="@command('editRole', role=each)">
                                                <n:i class="fas fa-edit"></n:i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" 
                                                    onClick="@command('deleteItem', role=each)"
                                                    disabled="@load(each.isSystemRole)">
                                                <n:i class="fas fa-trash"></n:i>
                                            </button>
                                        </n:div>
                                    </n:div>
                                </n:div>
                            </n:div>
                        </n:div>
                    </n:div>
                </n:div>
                
                <!-- Tab: Auditoría -->
                <n:div visible="@load(vm.activeTab eq 'audit')">
                    <n:div class="row mb-3">
                        <n:div class="col-md-3">
                            <combobox class="form-control" placeholder="Tipo de Evento"
                                      value="@bind(vm.filterEventType)" buttonVisible="false"
                                      onChange="@command('applyAuditFilters')">
                                <comboitem label="Todos" value=""/>
                                <comboitem label="Acceso Permitido" value="ACCESS_GRANTED"/>
                                <comboitem label="Acceso Denegado" value="ACCESS_DENIED"/>
                                <comboitem label="Cambio Permisos" value="PERMISSION_CHANGE"/>
                                <comboitem label="Rol Asignado" value="ROLE_ASSIGNED"/>
                            </combobox>
                        </n:div>
                        <n:div class="col-md-7">
                            <n:div class="input-group">
                                <n:span class="input-group-text bg-white">
                                    <n:i class="fas fa-search text-muted"></n:i>
                                </n:span>
                                <textbox class="form-control" placeholder="Buscar en auditoría..."
                                         value="@bind(vm.searchAuditText)" instant="true"
                                         onChange="@command('searchAudit')"/>
                            </n:div>
                        </n:div>
                        <n:div class="col-md-2">
                            <button class="btn btn-outline-secondary w-100" onClick="@command('exportAuditLog')">
                                <n:i class="fas fa-file-download me-1"></n:i>Exportar
                            </button>
                        </n:div>
                    </n:div>
                    
                    <n:div class="alert alert-warning">
                        <n:i class="fas fa-link me-2"></n:i>
                        <strong>Integración con Gobierno:</strong> Todos los eventos de acceso se registran en el sistema de auditoría centralizado.
                        <a href="javascript:void(0)" onClick="@command('viewGovernanceAudit')">Ver auditoría completa</a>
                    </n:div>
                    
                    <n:div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha/Hora</th>
                                    <th>Usuario</th>
                                    <th>Evento</th>
                                    <th>Sistema</th>
                                    <th>Detalles</th>
                                    <th class="text-center">Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr forEach="@load(vm.auditLogsList)">
                                    <td>
                                        <small label="@load(vm.formatDateTime(each.timestamp))"/>
                                    </td>
                                    <td>
                                        <small label="@load(each.userName)"/>
                                    </td>
                                    <td>
                                        <n:span class="@load(vm.getEventTypeColor(each.eventType))"
                                              label="@load(vm.translateEventType(each.eventType))"/>
                                    </td>
                                    <td>
                                        <small label="@load(each.systemName)"/>
                                    </td>
                                    <td>
                                        <small label="@load(vm.truncate(each.details, 60))"/>
                                    </td>
                                    <td class="text-center">
                                        <n:i class="@load(vm.getResultIcon(each.result))"></n:i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </n:div>
                </n:div>
                
            </n:div>
        </n:div>

    </n:div>
</zk>

