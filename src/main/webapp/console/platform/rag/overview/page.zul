<?page title="RAG Knowledge Base - Overview" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagSystemOverviewViewModel')">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="mb-1">
                    <i class="fas fa-brain me-2"></i>
                    RAG Knowledge Base
                </h2>
                <p class="text-muted">Sistemas de Retrieval-Augmented Generation</p>
				</div>
			</div>

        <!-- Métricas principales -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Total Sistemas</p>
                                <h3 class="mb-0" label="@load(vm.totalSystems)"/>
                            </div>
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-database text-primary fa-lg"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Sistemas Activos</p>
                                <h3 class="mb-0" label="@load(vm.activeSystems)"/>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-check-circle text-success fa-lg"></i>
			</div>
			</div>
				</div>
				</div>
			</div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
					<div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Documentos Totales</p>
                                <h3 class="mb-0" label="@load(vm.totalDocuments)"/>
                            </div>
                            <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-file-alt text-info fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1 small">Cumplimiento</p>
                                <h3 class="mb-0">
                                    <label value="@load(vm.complianceRate)"/>%
                                </h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                <i class="fas fa-shield-alt text-warning fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros y búsqueda -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <textbox class="form-control" placeholder="Buscar sistema RAG..."
                                     value="@bind(vm.searchText)" instant="true"
                                     onChange="@command('searchSystems')"/>
                        </div>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Tipo"
                                  value="@bind(vm.filterType)" buttonVisible="false">
                            <comboitem label="Todos los tipos" value=""/>
                            <comboitem label="Knowledge Base" value="KNOWLEDGE_BASE"/>
                            <comboitem label="Legal Assistant" value="LEGAL_ASSISTANT"/>
                            <comboitem label="Code Assistant" value="CODE_ASSISTANT"/>
                            <comboitem label="Support" value="SUPPORT"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Estado"
                                  value="@bind(vm.filterStatus)" buttonVisible="false">
                            <comboitem label="Todos los estados" value=""/>
                            <comboitem label="Activo" value="ACTIVE"/>
                            <comboitem label="Inactivo" value="INACTIVE"/>
                            <comboitem label="Borrador" value="DRAFT"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <combobox class="form-control" placeholder="Cumplimiento"
                                  value="@bind(vm.filterCompliance)" buttonVisible="false">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Cumple" value="COMPLIANT"/>
                            <comboitem label="No cumple" value="NON_COMPLIANT"/>
                            <comboitem label="Revisión pendiente" value="PENDING_REVIEW"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-2">
                        <div class="btn-group w-100">
                            <button class="btn btn-outline-secondary" onClick="@command('clearFilters')">
                                <i class="fas fa-times me-1"></i>Limpiar
                            </button>
                            <button class="btn btn-primary" onClick="@command('createSystem')">
                                <i class="fas fa-plus me-1"></i>Nuevo
                            </button>
											</div>
						</div>
					</div>
				</div>
			</div>

        <!-- Tabla de sistemas RAG -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Sistemas RAG</h5>
                    <button class="btn btn-sm btn-outline-secondary" onClick="@command('refreshSystems')">
                        <i class="fas fa-sync-alt me-1"></i>Actualizar
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sistema</th>
                                <th>Tipo</th>
                                <th class="text-center">Fuentes</th>
                                <th class="text-center">Documentos</th>
                                <th class="text-center">Score Global</th>
                                <th class="text-center">Cumplimiento</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.systemsList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragsystemname)"/>
                                        <br/>
                                        <small class="text-muted" label="@load(each.ragdescription)"/>
                                        <br/>
                                        <span class="badge bg-secondary" label="@load(each.ragversion)"/>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info" label="@load(each.ragtype)"/>
                                </td>
                                <td class="text-center">
                                    <strong label="@load(each.ragdatasources)"/>
                                </td>
                                <td class="text-center">
                                    <label value="@load(each.ragdocuments) @converter('formattedNumber')"/>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <div class="progress" style="width: 60px; height: 8px;">
                                            <div class="progress-bar bg-success" 
                                                 style="@load(concat('width: ', each.ragoverallscore, '%'))"></div>
                                        </div>
                                        <span class="ms-2" label="@load(each.ragoverallscore)"/>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getComplianceColor(each.ragcompliance))"
                                          label="@load(each.ragcompliance)"/>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getStatusColor(each.ragstatus))"
                                          label="@load(each.ragstatus)"/>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewSystem', system=each)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                onClick="@command('editSystem', system=each)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" 
                                                onClick="@command('deleteSystem', system=each)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</zk>
