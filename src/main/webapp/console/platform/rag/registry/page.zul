<?page title="RAG Registry" contentType="text/html;charset=UTF-8"?>
<zk xmlns:n="native">
    <div class="container-fluid p-4" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.rag.RagRegistryViewModel')">
        
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="mb-1">
                    <i class="fas fa-folder-open me-2"></i>
                    Registro de Sistemas RAG
                </h2>
                <p class="text-muted">Gestión y configuración de sistemas RAG</p>
            </div>
        </div>

        <!-- Barra de acciones -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <textbox class="form-control" placeholder="Buscar por nombre, descripción o tags..."
                             value="@bind(vm.searchText)" instant="true"
                             onChange="@command('searchRegistry')"/>
                </div>
            </div>
            <div class="col-md-6 text-end">
                <div class="btn-group">
                    <button class="btn btn-outline-secondary" 
                            onClick="@command('toggleView', view='grid')"
                            disabled="@load(vm.viewMode eq 'grid')">
                        <i class="fas fa-th"></i>
                    </button>
                    <button class="btn btn-outline-secondary" 
                            onClick="@command('toggleView', view='list')"
                            disabled="@load(vm.viewMode eq 'list')">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
                <button class="btn btn-primary ms-2" onClick="@command('showCreateModal')">
                    <i class="fas fa-plus me-1"></i>Nuevo Sistema RAG
                </button>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <combobox class="form-control" placeholder="Estado"
                                  value="@bind(vm.filterStatus)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los estados" value=""/>
                            <comboitem label="Activo" value="active"/>
                            <comboitem label="Inactivo" value="inactive"/>
                            <comboitem label="Borrador" value="draft"/>
                        </combobox>
                    </div>
                    <div class="col-md-3">
                        <combobox class="form-control" placeholder="Tipo"
                                  value="@bind(vm.filterType)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos los tipos" value=""/>
                            <comboitem label="Knowledge Base" value="KNOWLEDGE_BASE"/>
                            <comboitem label="Legal Assistant" value="LEGAL_ASSISTANT"/>
                            <comboitem label="Code Assistant" value="CODE_ASSISTANT"/>
                            <comboitem label="Support" value="SUPPORT"/>
                        </combobox>
                    </div>
                    <div class="col-md-3">
                        <combobox class="form-control" placeholder="Rendimiento"
                                  value="@bind(vm.filterPerformance)" buttonVisible="false"
                                  onChange="@command('applyFilters')">
                            <comboitem label="Todos" value=""/>
                            <comboitem label="Excelente (>90%)" value="excellent"/>
                            <comboitem label="Bueno (70-90%)" value="good"/>
                            <comboitem label="Regular (<70%)" value="poor"/>
                        </combobox>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-secondary w-100" onClick="@command('clearFilters')">
                            <i class="fas fa-times me-1"></i>Limpiar Filtros
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vista Grid -->
        <div class="row g-4" visible="@load(vm.viewMode eq 'grid')">
            <div class="col-md-4" forEach="@load(vm.registryList)">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="mb-1" label="@load(each.ragsystemname)"/>
                                <small class="text-muted" label="@load(concat('v', each.ragversion))"/>
                            </div>
                            <span class="@load(vm.getStatusColor(each.ragstatus))"
                                  label="@load(each.ragstatus)"/>
                        </div>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3" label="@load(each.ragdescription)"/>
                        
                        <!-- Métricas -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="text-center p-2 bg-light rounded">
                                    <div class="small text-muted">Rendimiento</div>
                                    <strong label="@load(each.ragoverallscore)"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-2 bg-light rounded">
                                    <div class="small text-muted">Precisión</div>
                                    <strong label="@load(each.ragaccuracyscore)"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-2 bg-light rounded">
                                    <div class="small text-muted">Fuentes</div>
                                    <strong label="@load(each.ragdatasources)"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-2 bg-light rounded">
                                    <div class="small text-muted">Documentos</div>
                                    <strong label="@load(each.ragdocuments)"/>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Tags -->
                        <div class="mb-3" visible="@load(not empty each.ragtags)">
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge bg-secondary" forEach="@load(vm.getTags(each.ragtags))">
                                    <label value="@load(each)"/>
                                </span>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-user me-1"></i>
                                <label value="@load(each.ragcreatedby)"/>
                            </small>
                            <small class="text-muted" label="@load(vm.formatDate(each.ragcreatedat))"/>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <div class="btn-group w-100">
                            <button class="btn btn-sm btn-outline-primary" 
                                    onClick="@command('viewSystem', system=each)">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" 
                                    onClick="@command('editSystem', system=each)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" 
                                    onClick="@command('deleteSystem', system=each)">
                                <i class="fas fa-trash"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-info" 
                                    onClick="@command('downloadConfig', system=each)">
                                <i class="fas fa-download"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vista List -->
        <div class="card border-0 shadow-sm" visible="@load(vm.viewMode eq 'list')">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sistema</th>
                                <th>Tipo</th>
                                <th class="text-center">Rendimiento</th>
                                <th class="text-center">Precisión</th>
                                <th class="text-center">Fuentes/Docs</th>
                                <th class="text-center">Estado</th>
                                <th>Creado por</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr forEach="@load(vm.registryList)">
                                <td>
                                    <div>
                                        <strong label="@load(each.ragsystemname)"/>
                                        <br/>
                                        <small class="text-muted" label="@load(each.ragversion)"/>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info" label="@load(each.ragtype)"/>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <div class="progress" style="width: 60px; height: 8px;">
                                            <div class="progress-bar bg-success" 
                                                 style="@load(concat('width: ', each.ragoverallscore, '%'))"></div>
                                        </div>
                                        <span class="ms-2 small" label="@load(each.ragoverallscore)"/>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="small" label="@load(each.ragaccuracyscore)"/>
                                </td>
                                <td class="text-center">
                                    <span label="@load(concat(each.ragdatasources, ' / ', each.ragdocuments))"/>
                                </td>
                                <td class="text-center">
                                    <span class="@load(vm.getStatusColor(each.ragstatus))"
                                          label="@load(each.ragstatus)"/>
                                </td>
                                <td>
                                    <small label="@load(each.ragcreatedby)"/>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-sm" 
                                                onClick="@command('viewSystem', system=each)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" 
                                                onClick="@command('editSystem', system=each)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" 
                                                onClick="@command('deleteSystem', system=each)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modal de Creación/Edición -->
        <window id="createEditModal" title="@load(vm.isEditMode ? 'Editar Sistema RAG' : 'Crear Sistema RAG')"
                border="normal" width="800px" mode="modal" 
                visible="@load(vm.showModal)" onClose="@command('closeModal')">
            <div class="p-3">
                <div class="row g-3">
                    <!-- Nombre -->
                    <div class="col-12">
                        <label class="form-label">Nombre del Sistema *</label>
                        <textbox class="form-control" value="@bind(vm.systemName)" 
                                 placeholder="Ej: Knowledge Base RAG"/>
                    </div>
                    
                    <!-- Descripción -->
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textbox class="form-control" value="@bind(vm.systemDescription)" 
                                 rows="3" multiline="true"
                                 placeholder="Descripción del sistema RAG"/>
                    </div>
                    
                    <!-- Versión y Tipo -->
                    <div class="col-md-6">
                        <label class="form-label">Versión *</label>
                        <textbox class="form-control" value="@bind(vm.systemVersion)" 
                                 placeholder="1.0.0"/>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label">Tipo *</label>
                        <combobox class="form-control" value="@bind(vm.systemType)" buttonVisible="false">
                            <comboitem label="Knowledge Base" value="KNOWLEDGE_BASE"/>
                            <comboitem label="Legal Assistant" value="LEGAL_ASSISTANT"/>
                            <comboitem label="Code Assistant" value="CODE_ASSISTANT"/>
                            <comboitem label="Support" value="SUPPORT"/>
                        </combobox>
                    </div>
                    
                    <!-- Estado y Nivel de Riesgo -->
                    <div class="col-md-6">
                        <label class="form-label">Estado *</label>
                        <combobox class="form-control" value="@bind(vm.systemStatus)" buttonVisible="false">
                            <comboitem label="Activo" value="ACTIVE"/>
                            <comboitem label="Inactivo" value="INACTIVE"/>
                            <comboitem label="Borrador" value="DRAFT"/>
                        </combobox>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label">Nivel de Riesgo</label>
                        <combobox class="form-control" value="@bind(vm.systemRiskLevel)" buttonVisible="false">
                            <comboitem label="Bajo" value="LOW"/>
                            <comboitem label="Medio" value="MEDIUM"/>
                            <comboitem label="Alto" value="HIGH"/>
                            <comboitem label="Crítico" value="CRITICAL"/>
                        </combobox>
                    </div>
                    
                    <!-- Tags -->
                    <div class="col-12">
                        <label class="form-label">Tags (separados por comas)</label>
                        <textbox class="form-control" value="@bind(vm.systemTags)" 
                                 placeholder="knowledge-base, documentation, technical"/>
                    </div>
                </div>
                
                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-secondary" onClick="@command('closeModal')">
                        Cancelar
                    </button>
                    <button class="btn btn-primary" onClick="@command('saveSystem')">
                        <i class="fas fa-save me-1"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </window>

    </div>
</zk>
