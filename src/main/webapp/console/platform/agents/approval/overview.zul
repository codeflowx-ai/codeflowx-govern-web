<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentApprovalOverviewViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row" style="background-color:;">
			<div><!-- Titulo pantalla -->
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-robot me-2"></h:i>
						<label value="Agent Approval" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión de Agent Approval" />
					</h:p>
				</div>
			</div>
			<div class="col-lg-12 s-bot ">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1"></div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a
										iconSclass="fa-duotone fa-solid fa-plus label-icon align-middle fs-16 me-2"
										class="waves-effect waves-light"
										onClick="@command('registerItem')"
										label="Registrar Agent Approval">
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!--end col-->
			</div>
			<div class="col-lg-12 s-bot ">
				<!-- Métricas Resumen -->
				<h:div class="row g-3 mb-4">
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total</p>
								<fragment exps="@load(vm.totalItems)">
					<![CDATA[ <h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Activos</p>
								<fragment exps="@load(vm.activeItems)">
					<![CDATA[ <h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<h:div class="col-md-3">
						<h:div class="card shadow-sm border-0"
							style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white; border-radius: 12px;">
							<h:div class="card-body p-4">
							    <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Pendientes</p>
								<fragment exps="@load(vm.pendingApproval)">
					<![CDATA[ <h2 class="mb-1" style="font-size: 42px; font-weight: bold;" textContent='@load(exps)'></h2> ]]>
				</fragment>
							</h:div>
						</h:div>
					</h:div>
					<!-- KPI "Inactivos" eliminado - propiedad inactiveItems no existe en ViewModel -->
				</h:div>
			</div>
			<div class="section filters">
				<div class="search-bar">
					<!-- Búsqueda por texto -->
					<textbox value="@bind(vm.searchTerm)"
						placeholder="Buscar..."
						class="form-control" onOK="@command('applyFilters')" />
					<!-- Filtro por Approval Type -->
					<combobox
						placeholder="Filtrar por Approval Type"
						selectedItem="@bind(vm.agtapprovaltypeFilter)"
						onChange="@command('applyFilters')">
						<comboitem label="TODOS" value="ALL" />
						<comboitem label="TIPO 1" value="TYPE1" />
						<comboitem label="TIPO 2" value="TYPE2" />
					</combobox>
					<!-- Filtro por Approval Status -->
					<combobox
						placeholder="Filtrar por Approval Status"
						selectedItem="@bind(vm.agtapprovalstatusFilter)"
						onChange="@command('applyFilters')">
						<comboitem label="TODOS" value="ALL" />
					</combobox>
					<!-- Filtro por Approval Level -->
					<combobox
						placeholder="Filtrar por Approval Level"
						selectedItem="@bind(vm.agtapprovallevelFilter)"
						onChange="@command('applyFilters')">
						<comboitem label="TODOS" value="ALL" />
					</combobox>
					<!-- Filtro por Approverrole -->
					<combobox
						placeholder="Filtrar por Approverrole"
						selectedItem="@bind(vm.agtapproverroleFilter)"
						onChange="@command('applyFilters')">
						<comboitem label="TODOS" value="ALL" />
					</combobox>
				</div>
				<div class="filter-icons">
					<a tooltiptext="Buscar"
						iconSclass="fa-duotone fa-magnifying-glass-waveform"
						onClick="@command('applyFilters')" />
					<a tooltiptext="Limpiar"
						iconSclass="fa-duotone fa-broom-wide"
						onClick="@command('clearFilters')" />
				</div>
			</div>
			<div class="col-xxl-12 s-bot">
				<div class="card">
					<div class="card-body">
						<div id="divTemplate" sclass="col-lg-12">
							<!-- listado -->
							<grid model="@load(vm.filteredItems)"
								style="overflow:auto;">
								<columns sizable="true"
									columnsgroup="false" columnshide="false">
									<column
										label="ID" align="center"
										sort="auto" width="5%" />

									<column sclass=" text-capitalize "
										label="Approval Type" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Approval Status" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Requestreason" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Requestdetails" align="center"
										width="15%" />

									<column sclass=" text-capitalize "
										label="Approval Criteria" align="center"
										width="15%" />

									<column
										label="Acciones"
										align="center" />
								</columns>

								<template name="model" var="agents">
									<row
										style="text-align:right;cursor:pointer;"
										onClick="@command('viewItemDetails', itemId=agents.idxagentapproval)">
										<label
											value="@load(agents.idxagentapproval) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(agents.agtapprovaltype)"
											sclass="badge ${agents.agtapprovaltype eq 'ACTIVE' ? 'bg-success' : (agents.agtapprovaltype eq 'INACTIVE' ? 'bg-secondary' : 'bg-warning')}" />

										<label
											value="@load(agents.agtapprovalstatus)"
											sclass="badge ${agents.agtapprovalstatus eq 'ACTIVE' ? 'bg-success' : (agents.agtapprovalstatus eq 'INACTIVE' ? 'bg-secondary' : 'bg-warning')}" />

										<label
											value="@load(agents.agtrequestreason) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(agents.agtrequestdetails) @converter(vm.fieldConverter)">
										</label>

										<label
											value="@load(agents.agtapprovalcriteria) @converter(vm.fieldConverter)">
										</label>
										<cell align="center"
											class="d-flex">
											<div class="edit">
												<a
													onClick="@command('viewItemDetails', itemId=agents.idxagentapproval)"
													iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"
													tooltiptext="Ver detalles" />
											</div>
											<div class="delete">
												<a
													onClick="@command('deleteItem', itemId=agents.idxagentapproval)"
													iconSclass="fa-light fa-nfc-trash fa-xl"
													sclass="waves-effect waves-danger"
													tooltiptext="Eliminar" />
											</div>
										</cell>
									</row>
								</template>
								<foot>
									<footer span="3" align="right">
										<paging id="topagin"
											pageSize="@load(vm.pageParams.maxRows)" 
											totalSize="@load(vm.pageResult.totalRows)"
											activePage="@load(vm.pageParams.pageActual - 1)"
											onPaging="@command('onPaging', event=event)"
											mold="os" width="100%" />
									</footer>
									<footer span="4" align="left"></footer>
									<footer></footer>
								</foot>
							</grid>
						</div>
					</div>
				</div>
			</div>
		</div><!--end col-->
	</idspace>
</zk>