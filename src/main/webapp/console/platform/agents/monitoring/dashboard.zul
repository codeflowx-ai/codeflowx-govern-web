<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<!-- ViewModel binding - DASHBOARD (métricas y KPIs) -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.agents.AgentsDashboardViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row" style="background-color:;">
			<div><!-- Titulo pantalla -->
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-robot me-2"></h:i>
						<label value="Dashboard de Agentes" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Métricas y estado general de agentes AI" />
					</h:p>
				</div>
				<div class="right">
					<button label="Refrescar" iconSclass="fa-duotone fa-arrows-rotate"
						onClick="@command('refreshDashboard')" class="btn btn-primary" />
				</div>
			</div>
			
			<!-- KPIs Cards -->
			<div class="row mt-3">
				<div class="col-lg-3 col-md-6">
					<div class="card">
						<div class="card-body">
							<div class="d-flex align-items-center">
								<div class="flex-grow-1">
									<h:p class="text truncate font-size-15">Total Agentes</h:p>
									<h:h4 class="mb-0">${vm.totalAgents}</h:h4>
								</div>
								<div class="flex-shrink-0">
									<h:i class="fa-duotone fa-users text-primary" style="font-size: 2rem;"></h:i>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-md-6">
					<div class="card">
						<div class="card-body">
							<div class="d-flex align-items-center">
								<div class="flex-grow-1">
									<h:p class="text truncate font-size-15">Agentes Activos</h:p>
									<h:h4 class="mb-0">${vm.activeAgents}</h:h4>
								</div>
								<div class="flex-shrink-0">
									<h:i class="fa-duotone fa-circle-check text-success" style="font-size: 2rem;"></h:i>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-md-6">
					<div class="card">
						<div class="card-body">
							<div class="d-flex align-items-center">
								<div class="flex-grow-1">
									<h:p class="text truncate font-size-15">Agentes Desplegados</h:p>
									<h:h4 class="mb-0">${vm.deployedAgents}</h:h4>
								</div>
								<div class="flex-shrink-0">
									<h:i class="fa-duotone fa-rocket text-info" style="font-size: 2rem;"></h:i>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-md-6">
					<div class="card">
						<div class="card-body">
							<div class="d-flex align-items-center">
								<div class="flex-grow-1">
									<h:p class="text truncate font-size-15">Health Score</h:p>
									<h:h4 class="mb-0">${vm.healthScore}%</h:h4>
								</div>
								<div class="flex-shrink-0">
									<h:i class="fa-duotone fa-heart-pulse text-danger" style="font-size: 2rem;"></h:i>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<!-- Métricas Adicionales -->
			<div class="row mt-3">
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<h:h5 class="card-title mb-0">Agentes Recientes</h:h5>
						</div>
						<div class="card-body">
							<listbox model="@load(vm.recentAgents)" height="300px">
								<listhead>
									<listheader label="Nombre" />
									<listheader label="Estado" />
									<listheader label="Versión" />
								</listhead>
								<template name="model" var="agent">
									<listitem onClick="@command('viewAgentDetail', agentId=agent.idxagent)">
										<listcell label="@load(agent.agtname)" />
										<listcell label="@load(agent.agtstatus)" />
										<listcell label="@load(agent.agtversion)" />
									</listitem>
								</template>
							</listbox>
						</div>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<h:h5 class="card-title mb-0">Métricas de Rendimiento</h:h5>
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="font-weight-bold">Score Promedio: </label>
								<label value="@load(vm.avgPerformanceScore)" />
							</div>
							<div class="mb-3">
								<label class="font-weight-bold">Agentes Offline: </label>
								<label value="@load(vm.offlineAgents)" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div><!--end col-->
	</idspace>
</zk>
