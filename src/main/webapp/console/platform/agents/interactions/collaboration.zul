<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentCollaborationDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent Collaboration" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveAgentCollaboration')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Collaboration Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Collaboration Type *" />
														<combobox tabindex="2" id="agtcollaborationtype"
															selectedItem="@bind(vm.currentAgentCollaboration.agtcollaborationtype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcollaborationtype'])" />
													</div>
												</div>
											</div>											<!-- Purpose -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Purpose" />
														<textbox tabindex="3" id="agtpurpose"
															value="@bind(vm.currentAgentCollaboration.agtpurpose)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtpurpose'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Context -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Context" />
														<textbox tabindex="4" id="agtcontext"
															value="@bind(vm.currentAgentCollaboration.agtcontext)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcontext'])" />
													</div>
												</div>
											</div>											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="5" id="agtstatus"
															selectedItem="@bind(vm.currentAgentCollaboration.agtstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Effectiveness Score -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Effectiveness Score" />
														<textbox tabindex="6" id="agteffectivenessscore"
															value="@bind(vm.currentAgentCollaboration.agteffectivenessscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agteffectivenessscore'])" />
													</div>
												</div>
											</div>											<!-- Knowledgetransferred -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Knowledgetransferred" />
														<textbox tabindex="7" id="agtknowledgetransferred"
															value="@bind(vm.currentAgentCollaboration.agtknowledgetransferred)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtknowledgetransferred'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Communication Log -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Communication Log" />
														<textbox tabindex="8" id="agtcommunicationlog"
															value="@bind(vm.currentAgentCollaboration.agtcommunicationlog)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcommunicationlog'])" />
													</div>
												</div>
											</div>											<!-- Metric S -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metric S" />
														<textbox tabindex="9" id="agtmetrics"
															value="@bind(vm.currentAgentCollaboration.agtmetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmetrics'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Startedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Startedat" />
														<textbox tabindex="10" id="agtstartedat"
															value="@bind(vm.currentAgentCollaboration.agtstartedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtstartedat'])" />
													</div>
												</div>
											</div>											<!-- Completed At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Completed At" />
														<textbox tabindex="11" id="agtcompletedat"
															value="@bind(vm.currentAgentCollaboration.agtcompletedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcompletedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Durationseconds -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Durationseconds" />
														<textbox tabindex="12" id="agtdurationseconds"
															value="@bind(vm.currentAgentCollaboration.agtdurationseconds)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdurationseconds'])" />
													</div>
												</div>
											</div>											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="13" id="agtcreatedby"
															value="@bind(vm.currentAgentCollaboration.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="14" id="agtupdatedby"
															value="@bind(vm.currentAgentCollaboration.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="15" id="agtcreatedat"
															value="@bind(vm.currentAgentCollaboration.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="16" id="agtupdatedat"
															value="@bind(vm.currentAgentCollaboration.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>