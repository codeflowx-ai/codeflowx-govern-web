<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentComplianceDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent Compliance" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveAgentCompliance')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Compliance Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Compliance Type *" />
														<combobox tabindex="2" id="agtcompliancetype"
															selectedItem="@bind(vm.currentAgentCompliance.agtcompliancetype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcompliancetype'])" />
													</div>
												</div>
											</div>											<!-- Compliance Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Compliance Status *" />
														<combobox tabindex="3" id="agtcompliancestatus"
															selectedItem="@bind(vm.currentAgentCompliance.agtcompliancestatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcompliancestatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Compliance Score -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Compliance Score" />
														<textbox tabindex="4" id="agtcompliancescore"
															value="@bind(vm.currentAgentCompliance.agtcompliancescore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcompliancescore'])" />
													</div>
												</div>
											</div>											<!-- Risklevel -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Risklevel" />
														<combobox tabindex="5" id="agtrisklevel"
															selectedItem="@bind(vm.currentAgentCompliance.agtrisklevel)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtrisklevel'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Requirements -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Requirements" />
														<textbox tabindex="6" id="agtrequirements"
															value="@bind(vm.currentAgentCompliance.agtrequirements)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtrequirements'])" />
													</div>
												</div>
											</div>											<!-- Assessment Results -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Assessment Results" />
														<textbox tabindex="7" id="agtassessmentresults"
															value="@bind(vm.currentAgentCompliance.agtassessmentresults)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtassessmentresults'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Violations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Violations" />
														<textbox tabindex="8" id="agtviolations"
															value="@bind(vm.currentAgentCompliance.agtviolations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtviolations'])" />
													</div>
												</div>
											</div>											<!-- Remediationplan -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Remediationplan" />
														<textbox tabindex="9" id="agtremediationplan"
															value="@bind(vm.currentAgentCompliance.agtremediationplan)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtremediationplan'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Evidence -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Evidence" />
														<textbox tabindex="10" id="agtevidence"
															value="@bind(vm.currentAgentCompliance.agtevidence)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtevidence'])" />
													</div>
												</div>
											</div>											<!-- Audittrail -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audittrail" />
														<textbox tabindex="11" id="agtaudittrail"
															value="@bind(vm.currentAgentCompliance.agtaudittrail)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtaudittrail'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Lastassessmentat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lastassessmentat" />
														<textbox tabindex="12" id="agtlastassessmentat"
															value="@bind(vm.currentAgentCompliance.agtlastassessmentat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtlastassessmentat'])" />
													</div>
												</div>
											</div>											<!-- Nextassessmentat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nextassessmentat" />
														<textbox tabindex="13" id="agtnextassessmentat"
															value="@bind(vm.currentAgentCompliance.agtnextassessmentat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtnextassessmentat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Assessment Frequency -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Assessment Frequency" />
														<textbox tabindex="14" id="agtassessmentfrequency"
															value="@bind(vm.currentAgentCompliance.agtassessmentfrequency)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtassessmentfrequency'])" />
													</div>
												</div>
											</div>											<!-- Assessorid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Assessorid" />
														<textbox tabindex="15" id="agtassessorid"
															value="@bind(vm.currentAgentCompliance.agtassessorid)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtassessorid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Assessorname -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Assessorname" />
														<textbox tabindex="16" id="agtassessorname"
															value="@bind(vm.currentAgentCompliance.agtassessorname) @save(vm.currentAgentCompliance.agtassessorname, before=('saveItem')) @validator(vm.unique, field='AGTASSESSORNAME', required=false, oldValue=vm.originalAgtassessorname)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtassessorname'])" />
													</div>
												</div>
											</div>											<!-- Assessment Method -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Assessment Method" />
														<textbox tabindex="17" id="agtassessmentmethod"
															value="@bind(vm.currentAgentCompliance.agtassessmentmethod)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtassessmentmethod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Certificationstatus -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationstatus" />
														<combobox tabindex="18" id="agtcertificationstatus"
															selectedItem="@bind(vm.currentAgentCompliance.agtcertificationstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationstatus'])" />
													</div>
												</div>
											</div>											<!-- Certificationdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationdate" />
														<textbox tabindex="19" id="agtcertificationdate"
															value="@bind(vm.currentAgentCompliance.agtcertificationdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationdate'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Certificationexpiry -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationexpiry" />
														<textbox tabindex="20" id="agtcertificationexpiry"
															value="@bind(vm.currentAgentCompliance.agtcertificationexpiry)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationexpiry'])" />
													</div>
												</div>
											</div>											<!-- Certificationauthority -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationauthority" />
														<textbox tabindex="21" id="agtcertificationauthority"
															value="@bind(vm.currentAgentCompliance.agtcertificationauthority)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationauthority'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Notes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Notes" />
														<textbox tabindex="22" id="agtnotes"
															value="@bind(vm.currentAgentCompliance.agtnotes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtnotes'])" />
													</div>
												</div>
											</div>											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="23" id="agtcreatedby"
															value="@bind(vm.currentAgentCompliance.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="24" id="agtupdatedby"
															value="@bind(vm.currentAgentCompliance.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="25" id="agtcreatedat"
															value="@bind(vm.currentAgentCompliance.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="26" id="agtupdatedat"
															value="@bind(vm.currentAgentCompliance.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>