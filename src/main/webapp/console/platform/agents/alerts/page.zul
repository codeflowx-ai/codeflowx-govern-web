<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentAlertDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent Alert" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Alert Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Type *" />
														<combobox tabindex="2" id="agtalerttype"
															selectedItem="@bind(vm.currentAgentAlert.agtalerttype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtalerttype'])" />
													</div>
												</div>
											</div>											<!-- Alert Category -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Alert Category" />
														<textbox tabindex="3" id="agtalertcategory"
															value="@bind(vm.currentAgentAlert.agtalertcategory)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtalertcategory'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Severity -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Severity *" />
														<textbox tabindex="4" id="agtseverity"
															value="@bind(vm.currentAgentAlert.agtseverity)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtseverity'])" />
													</div>
												</div>
											</div>											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="5" id="agtstatus"
															selectedItem="@bind(vm.currentAgentAlert.agtstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Title -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Title *" />
														<textbox tabindex="6" id="agttitle"
															value="@bind(vm.currentAgentAlert.agttitle)"
															maxlength="500"
															constraint="no empty: max 500" />
														<label sclass="text-danger" value="@load(vmsgs['agttitle'])" />
													</div>
												</div>
											</div>											<!-- Description -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="7" id="agtdescription"
															value="@bind(vm.currentAgentAlert.agtdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Message -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Message" />
														<textbox tabindex="8" id="agtmessage"
															value="@bind(vm.currentAgentAlert.agtmessage)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmessage'])" />
													</div>
												</div>
											</div>											<!-- Triggercondition -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Triggercondition" />
														<textbox tabindex="9" id="agttriggercondition"
															value="@bind(vm.currentAgentAlert.agttriggercondition)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agttriggercondition'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Triggervalue -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Triggervalue" />
														<textbox tabindex="10" id="agttriggervalue"
															value="@bind(vm.currentAgentAlert.agttriggervalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agttriggervalue'])" />
													</div>
												</div>
											</div>											<!-- Thresholdvalue -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Thresholdvalue" />
														<textbox tabindex="11" id="agtthresholdvalue"
															value="@bind(vm.currentAgentAlert.agtthresholdvalue)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtthresholdvalue'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Triggered At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Triggered At *" />
														<textbox tabindex="12" id="agttriggeredat"
															value="@bind(vm.currentAgentAlert.agttriggeredat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agttriggeredat'])" />
													</div>
												</div>
											</div>											<!-- Acknowledged At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged At" />
														<textbox tabindex="13" id="agtacknowledgedat"
															value="@bind(vm.currentAgentAlert.agtacknowledgedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtacknowledgedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Acknowledged By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Acknowledged By" />
														<textbox tabindex="14" id="agtacknowledgedby"
															value="@bind(vm.currentAgentAlert.agtacknowledgedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtacknowledgedby'])" />
													</div>
												</div>
											</div>											<!-- Resolved At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resolved At" />
														<textbox tabindex="15" id="agtresolvedat"
															value="@bind(vm.currentAgentAlert.agtresolvedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtresolvedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Resolved By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resolved By" />
														<textbox tabindex="16" id="agtresolvedby"
															value="@bind(vm.currentAgentAlert.agtresolvedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtresolvedby'])" />
													</div>
												</div>
											</div>											<!-- Resolutionnotes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Resolutionnotes" />
														<textbox tabindex="17" id="agtresolutionnotes"
															value="@bind(vm.currentAgentAlert.agtresolutionnotes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtresolutionnotes'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Escalatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Escalatedat" />
														<textbox tabindex="18" id="agtescalatedat"
															value="@bind(vm.currentAgentAlert.agtescalatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtescalatedat'])" />
													</div>
												</div>
											</div>											<!-- Escalatedto -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Escalatedto" />
														<textbox tabindex="19" id="agtescalatedto"
															value="@bind(vm.currentAgentAlert.agtescalatedto)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtescalatedto'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Escalationreason -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Escalationreason" />
														<textbox tabindex="20" id="agtescalationreason"
															value="@bind(vm.currentAgentAlert.agtescalationreason)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtescalationreason'])" />
													</div>
												</div>
											</div>											<!-- Autoresolutionreason -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Autoresolutionreason" />
														<textbox tabindex="21" id="agtautoresolutionreason"
															value="@bind(vm.currentAgentAlert.agtautoresolutionreason)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtautoresolutionreason'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Suppresseduntil -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Suppresseduntil" />
														<textbox tabindex="22" id="agtsuppresseduntil"
															value="@bind(vm.currentAgentAlert.agtsuppresseduntil)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtsuppresseduntil'])" />
													</div>
												</div>
											</div>											<!-- Suppressionreason -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Suppressionreason" />
														<textbox tabindex="23" id="agtsuppressionreason"
															value="@bind(vm.currentAgentAlert.agtsuppressionreason)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtsuppressionreason'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Context -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Context" />
														<textbox tabindex="24" id="agtcontext"
															value="@bind(vm.currentAgentAlert.agtcontext)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcontext'])" />
													</div>
												</div>
											</div>											<!-- Metadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata" />
														<textbox tabindex="25" id="agtmetadata"
															value="@bind(vm.currentAgentAlert.agtmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmetadata'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Relatedalerts -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Relatedalerts" />
														<textbox tabindex="26" id="agtrelatedalerts"
															value="@bind(vm.currentAgentAlert.agtrelatedalerts)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtrelatedalerts'])" />
													</div>
												</div>
											</div>											<!-- Actionstaken -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Actionstaken" />
														<textbox tabindex="27" id="agtactionstaken"
															value="@bind(vm.currentAgentAlert.agtactionstaken)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtactionstaken'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Recommendations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Recommendations" />
														<textbox tabindex="28" id="agtrecommendations"
															value="@bind(vm.currentAgentAlert.agtrecommendations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtrecommendations'])" />
													</div>
												</div>
											</div>											<!-- Notificationchannels -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Notificationchannels" />
														<textbox tabindex="29" id="agtnotificationchannels"
															value="@bind(vm.currentAgentAlert.agtnotificationchannels)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtnotificationchannels'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Notificationrecipients -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Notificationrecipients" />
														<textbox tabindex="30" id="agtnotificationrecipients"
															value="@bind(vm.currentAgentAlert.agtnotificationrecipients)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtnotificationrecipients'])" />
													</div>
												</div>
											</div>											<!-- Priority -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Priority" />
														<combobox tabindex="31" id="agtpriority"
															selectedItem="@bind(vm.currentAgentAlert.agtpriority)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtpriority'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Impactlevel -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Impactlevel" />
														<combobox tabindex="32" id="agtimpactlevel"
															selectedItem="@bind(vm.currentAgentAlert.agtimpactlevel)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtimpactlevel'])" />
													</div>
												</div>
											</div>											<!-- Urgencylevel -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Urgencylevel" />
														<combobox tabindex="33" id="agturgencylevel"
															selectedItem="@bind(vm.currentAgentAlert.agturgencylevel)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agturgencylevel'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="34" id="agtcreatedby"
															value="@bind(vm.currentAgentAlert.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="35" id="agtupdatedby"
															value="@bind(vm.currentAgentAlert.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="36" id="agtcreatedat"
															value="@bind(vm.currentAgentAlert.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="37" id="agtupdatedat"
															value="@bind(vm.currentAgentAlert.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>