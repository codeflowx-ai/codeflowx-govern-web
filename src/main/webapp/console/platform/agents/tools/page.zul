<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentToolDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent Tool" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveAgentTool')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Tool Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tool Name *" />
														<textbox tabindex="2" id="agttoolname"
															value="@bind(vm.currentAgentTool.agttoolname) @save(vm.currentAgentTool.agttoolname, before=('saveItem')) @validator(vm.unique, field='AGTTOOLNAME', required=true, oldValue=vm.originalAgttoolname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agttoolname'])" />
													</div>
												</div>
											</div>											<!-- Tool Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tool Type *" />
														<combobox tabindex="3" id="agttooltype"
															selectedItem="@bind(vm.currentAgentTool.agttooltype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agttooltype'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Category -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Category *" />
														<textbox tabindex="4" id="agtcategory"
															value="@bind(vm.currentAgentTool.agtcategory)"
															maxlength="100"
															constraint="no empty: max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtcategory'])" />
													</div>
												</div>
											</div>											<!-- Description -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="5" id="agtdescription"
															value="@bind(vm.currentAgentTool.agtdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Version -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Version" />
														<textbox tabindex="6" id="agtversion"
															value="@bind(vm.currentAgentTool.agtversion)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtversion'])" />
													</div>
												</div>
											</div>											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="7" id="agtstatus"
															selectedItem="@bind(vm.currentAgentTool.agtstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Endpoint Url -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Endpoint Url" />
														<textbox tabindex="8" id="agtendpointurl"
															value="@bind(vm.currentAgentTool.agtendpointurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['agtendpointurl'])" />
													</div>
												</div>
											</div>											<!-- Authenticationtype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Authenticationtype" />
														<combobox tabindex="9" id="agtauthenticationtype"
															selectedItem="@bind(vm.currentAgentTool.agtauthenticationtype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtauthenticationtype'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Credentials -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Credentials" />
														<textbox tabindex="10" id="agtcredentials"
															value="@bind(vm.currentAgentTool.agtcredentials)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcredentials'])" />
													</div>
												</div>
											</div>											<!-- Parameter S -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Parameter S" />
														<textbox tabindex="11" id="agtparameters"
															value="@bind(vm.currentAgentTool.agtparameters)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtparameters'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Capabilities -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Capabilities" />
														<textbox tabindex="12" id="agtcapabilities"
															value="@bind(vm.currentAgentTool.agtcapabilities)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcapabilities'])" />
													</div>
												</div>
											</div>											<!-- Limitations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Limitations" />
														<textbox tabindex="13" id="agtlimitations"
															value="@bind(vm.currentAgentTool.agtlimitations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtlimitations'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Usagemetrics -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Usagemetrics" />
														<textbox tabindex="14" id="agtusagemetrics"
															value="@bind(vm.currentAgentTool.agtusagemetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtusagemetrics'])" />
													</div>
												</div>
											</div>											<!-- Performancemetrics -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Performancemetrics" />
														<textbox tabindex="15" id="agtperformancemetrics"
															value="@bind(vm.currentAgentTool.agtperformancemetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtperformancemetrics'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Errorrate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Errorrate" />
														<textbox tabindex="16" id="agterrorrate"
															value="@bind(vm.currentAgentTool.agterrorrate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agterrorrate'])" />
													</div>
												</div>
											</div>											<!-- Responsetimems -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Responsetimems" />
														<textbox tabindex="17" id="agtresponsetimems"
															value="@bind(vm.currentAgentTool.agtresponsetimems)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtresponsetimems'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Availability -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Availability" />
														<textbox tabindex="18" id="agtavailability"
															value="@bind(vm.currentAgentTool.agtavailability)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtavailability'])" />
													</div>
												</div>
											</div>											<!-- Lastused -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Lastused" />
														<textbox tabindex="19" id="agtlastused"
															value="@bind(vm.currentAgentTool.agtlastused)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtlastused'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Priority -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Priority" />
														<combobox tabindex="20" id="agtpriority"
															selectedItem="@bind(vm.currentAgentTool.agtpriority)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtpriority'])" />
													</div>
												</div>
											</div>											<!-- Deprecationdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Deprecationdate" />
														<textbox tabindex="21" id="agtdeprecationdate"
															value="@bind(vm.currentAgentTool.agtdeprecationdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdeprecationdate'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Replacementtoolid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Replacementtoolid" />
														<textbox tabindex="22" id="agtreplacementtoolid"
															value="@bind(vm.currentAgentTool.agtreplacementtoolid)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtreplacementtoolid'])" />
													</div>
												</div>
											</div>											<!-- Migrationnotes -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Migrationnotes" />
														<textbox tabindex="23" id="agtmigrationnotes"
															value="@bind(vm.currentAgentTool.agtmigrationnotes)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmigrationnotes'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Document At Ionurl -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Document At Ionurl" />
														<textbox tabindex="24" id="agtdocumentationurl"
															value="@bind(vm.currentAgentTool.agtdocumentationurl)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['agtdocumentationurl'])" />
													</div>
												</div>
											</div>											<!-- Supportcontact -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Supportcontact" />
														<textbox tabindex="25" id="agtsupportcontact"
															value="@bind(vm.currentAgentTool.agtsupportcontact)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtsupportcontact'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Licensetype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Licensetype" />
														<combobox tabindex="26" id="agtlicensetype"
															selectedItem="@bind(vm.currentAgentTool.agtlicensetype)"
															readonly="true"
															>
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtlicensetype'])" />
													</div>
												</div>
											</div>											<!-- Licenseexpiry -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Licenseexpiry" />
														<textbox tabindex="27" id="agtlicenseexpiry"
															value="@bind(vm.currentAgentTool.agtlicenseexpiry)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtlicenseexpiry'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Costperuse -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Costperuse" />
														<textbox tabindex="28" id="agtcostperuse"
															value="@bind(vm.currentAgentTool.agtcostperuse)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcostperuse'])" />
													</div>
												</div>
											</div>											<!-- Monthlycost -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Monthlycost" />
														<textbox tabindex="29" id="agtmonthlycost"
															value="@bind(vm.currentAgentTool.agtmonthlycost)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmonthlycost'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="30" id="agtcreatedby"
															value="@bind(vm.currentAgentTool.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="31" id="agtupdatedby"
															value="@bind(vm.currentAgentTool.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="32" id="agtcreatedat"
															value="@bind(vm.currentAgentTool.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="33" id="agtupdatedat"
															value="@bind(vm.currentAgentTool.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>