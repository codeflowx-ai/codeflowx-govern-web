<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentTransparencyDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent Transparency" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveAgentTransparency')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Transparency Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Transparency Type *" />
														<combobox tabindex="2" id="agttransparencytype"
															selectedItem="@bind(vm.currentAgentTransparency.agttransparencytype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agttransparencytype'])" />
													</div>
												</div>
											</div>											<!-- Transparency Score -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Transparency Score" />
														<textbox tabindex="3" id="agttransparencyscore"
															value="@bind(vm.currentAgentTransparency.agttransparencyscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agttransparencyscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Explainabilityscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Explainabilityscore" />
														<textbox tabindex="4" id="agtexplainabilityscore"
															value="@bind(vm.currentAgentTransparency.agtexplainabilityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtexplainabilityscore'])" />
													</div>
												</div>
											</div>											<!-- Interpretabilityscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Interpretabilityscore" />
														<textbox tabindex="5" id="agtinterpretabilityscore"
															value="@bind(vm.currentAgentTransparency.agtinterpretabilityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtinterpretabilityscore'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Auditabilityscore -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditabilityscore" />
														<textbox tabindex="6" id="agtauditabilityscore"
															value="@bind(vm.currentAgentTransparency.agtauditabilityscore)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtauditabilityscore'])" />
													</div>
												</div>
											</div>											<!-- Algorithmdisclosure -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Algorithmdisclosure" />
														<textbox tabindex="7" id="agtalgorithmdisclosure"
															value="@bind(vm.currentAgentTransparency.agtalgorithmdisclosure)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtalgorithmdisclosure'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Datadisclosure -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Datadisclosure" />
														<textbox tabindex="8" id="agtdatadisclosure"
															value="@bind(vm.currentAgentTransparency.agtdatadisclosure)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtdatadisclosure'])" />
													</div>
												</div>
											</div>											<!-- Decision Explainability -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Decision Explainability" />
														<textbox tabindex="9" id="agtdecisionexplainability"
															value="@bind(vm.currentAgentTransparency.agtdecisionexplainability)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtdecisionexplainability'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Explanationquality -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Explanationquality" />
														<textbox tabindex="10" id="agtexplanationquality"
															value="@bind(vm.currentAgentTransparency.agtexplanationquality)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtexplanationquality'])" />
													</div>
												</div>
											</div>											<!-- Explanationmethod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Explanationmethod" />
														<textbox tabindex="11" id="agtexplanationmethod"
															value="@bind(vm.currentAgentTransparency.agtexplanationmethod)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtexplanationmethod'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Interpretabilitytools -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Interpretabilitytools" />
														<textbox tabindex="12" id="agtinterpretabilitytools"
															value="@bind(vm.currentAgentTransparency.agtinterpretabilitytools)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtinterpretabilitytools'])" />
													</div>
												</div>
											</div>											<!-- Audittrail -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Audittrail" />
														<textbox tabindex="13" id="agtaudittrail"
															value="@bind(vm.currentAgentTransparency.agtaudittrail)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtaudittrail'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Decision Log -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Decision Log" />
														<textbox tabindex="14" id="agtdecisionlog"
															value="@bind(vm.currentAgentTransparency.agtdecisionlog)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdecisionlog'])" />
													</div>
												</div>
											</div>											<!-- Explanationexamples -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Explanationexamples" />
														<textbox tabindex="15" id="agtexplanationexamples"
															value="@bind(vm.currentAgentTransparency.agtexplanationexamples)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtexplanationexamples'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Transparency Metric S -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Transparency Metric S" />
														<textbox tabindex="16" id="agttransparencymetrics"
															value="@bind(vm.currentAgentTransparency.agttransparencymetrics)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agttransparencymetrics'])" />
													</div>
												</div>
											</div>											<!-- Limitations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Limitations" />
														<textbox tabindex="17" id="agtlimitations"
															value="@bind(vm.currentAgentTransparency.agtlimitations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtlimitations'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Uncertaintyhandling -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Uncertaintyhandling" />
														<textbox tabindex="18" id="agtuncertaintyhandling"
															value="@bind(vm.currentAgentTransparency.agtuncertaintyhandling)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtuncertaintyhandling'])" />
													</div>
												</div>
											</div>											<!-- Confidencecalibration -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Confidencecalibration" />
														<textbox tabindex="19" id="agtconfidencecalibration"
															value="@bind(vm.currentAgentTransparency.agtconfidencecalibration)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtconfidencecalibration'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Validationmethod -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Validationmethod" />
														<textbox tabindex="20" id="agtvalidationmethod"
															value="@bind(vm.currentAgentTransparency.agtvalidationmethod)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtvalidationmethod'])" />
													</div>
												</div>
											</div>											<!-- Validationresults -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Validationresults" />
														<textbox tabindex="21" id="agtvalidationresults"
															value="@bind(vm.currentAgentTransparency.agtvalidationresults)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtvalidationresults'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Benchmarkcomparison -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Benchmarkcomparison" />
														<textbox tabindex="22" id="agtbenchmarkcomparison"
															value="@bind(vm.currentAgentTransparency.agtbenchmarkcomparison)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtbenchmarkcomparison'])" />
													</div>
												</div>
											</div>											<!-- Thirdpartyaudit -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Thirdpartyaudit" />
														<textbox tabindex="23" id="agtthirdpartyaudit"
															value="@bind(vm.currentAgentTransparency.agtthirdpartyaudit)"
															maxlength="50"
															constraint="max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtthirdpartyaudit'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Auditreport -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditreport" />
														<textbox tabindex="24" id="agtauditreport"
															value="@bind(vm.currentAgentTransparency.agtauditreport)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtauditreport'])" />
													</div>
												</div>
											</div>											<!-- Auditdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditdate" />
														<textbox tabindex="25" id="agtauditdate"
															value="@bind(vm.currentAgentTransparency.agtauditdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtauditdate'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Auditor -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Auditor" />
														<textbox tabindex="26" id="agtauditor"
															value="@bind(vm.currentAgentTransparency.agtauditor)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtauditor'])" />
													</div>
												</div>
											</div>											<!-- Certificationstatus -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationstatus" />
														<combobox tabindex="27" id="agtcertificationstatus"
															selectedItem="@bind(vm.currentAgentTransparency.agtcertificationstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationstatus'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Certificationstandard -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Certificationstandard" />
														<textbox tabindex="28" id="agtcertificationstandard"
															value="@bind(vm.currentAgentTransparency.agtcertificationstandard)"
															maxlength="100"
															constraint="max 100" />
														<label sclass="text-danger" value="@load(vmsgs['agtcertificationstandard'])" />
													</div>
												</div>
											</div>											<!-- Compliance Level -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Compliance Level" />
														<combobox tabindex="29" id="agtcompliancelevel"
															selectedItem="@bind(vm.currentAgentTransparency.agtcompliancelevel)"
															readonly="true"
															>
															<comboitem label="Opción 1" value="OPTION1"/>
															<comboitem label="Opción 2" value="OPTION2"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtcompliancelevel'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Improvementplan -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Improvementplan" />
														<textbox tabindex="30" id="agtimprovementplan"
															value="@bind(vm.currentAgentTransparency.agtimprovementplan)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtimprovementplan'])" />
													</div>
												</div>
											</div>											<!-- Nextreviewdate -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nextreviewdate" />
														<textbox tabindex="31" id="agtnextreviewdate"
															value="@bind(vm.currentAgentTransparency.agtnextreviewdate)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtnextreviewdate'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="32" id="agtcreatedby"
															value="@bind(vm.currentAgentTransparency.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="33" id="agtupdatedby"
															value="@bind(vm.currentAgentTransparency.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="34" id="agtcreatedat"
															value="@bind(vm.currentAgentTransparency.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="35" id="agtupdatedat"
															value="@bind(vm.currentAgentTransparency.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>