<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="agents"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.agents.AgentDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-robot label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Agent" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveItem')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Name -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Name *" />
														<textbox tabindex="2" id="agtname"
															value="@bind(vm.currentAgent.agtname) @save(vm.currentAgent.agtname, before=('saveItem')) @validator(vm.unique, field='AGTNAME', required=true, oldValue=vm.originalAgtname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtname'])" />
													</div>
												</div>
											</div>											<!-- Description -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Description" />
														<textbox tabindex="3" id="agtdescription"
															value="@bind(vm.currentAgent.agtdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtdescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Type -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Type *" />
														<combobox tabindex="4" id="agttype"
															selectedItem="@bind(vm.currentAgent.agttype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agttype'])" />
													</div>
												</div>
											</div>											<!-- Version -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Version *" />
														<textbox tabindex="5" id="agtversion"
															value="@bind(vm.currentAgent.agtversion)"
															maxlength="50"
															constraint="no empty: max 50" />
														<label sclass="text-danger" value="@load(vmsgs['agtversion'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Status *" />
														<combobox tabindex="6" id="agtstatus"
															selectedItem="@bind(vm.currentAgent.agtstatus)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtstatus'])" />
													</div>
												</div>
											</div>											<!-- Capabilities -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Capabilities" />
														<textbox tabindex="7" id="agtcapabilities"
															value="@bind(vm.currentAgent.agtcapabilities)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtcapabilities'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Configuration -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Configuration" />
														<textbox tabindex="8" id="agtconfiguration"
															value="@bind(vm.currentAgent.agtconfiguration)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtconfiguration'])" />
													</div>
												</div>
											</div>											<!-- Metadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata" />
														<textbox tabindex="9" id="agtmetadata"
															value="@bind(vm.currentAgent.agtmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtmetadata'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Approval Status -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approval Status" />
														<combobox tabindex="10" id="agtapprovalstatus"
															selectedItem="@bind(vm.currentAgent.agtapprovalstatus)"
															readonly="true"
															>
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['agtapprovalstatus'])" />
													</div>
												</div>
											</div>											<!-- Approvedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedby" />
														<textbox tabindex="11" id="agtapprovedby"
															value="@bind(vm.currentAgent.agtapprovedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtapprovedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Approvedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Approvedat" />
														<textbox tabindex="12" id="agtapprovedat"
															value="@bind(vm.currentAgent.agtapprovedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtapprovedat'])" />
													</div>
												</div>
											</div>											<!-- Created By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created By *" />
														<textbox tabindex="13" id="agtcreatedby"
															value="@bind(vm.currentAgent.agtcreatedby)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated By -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated By" />
														<textbox tabindex="14" id="agtupdatedby"
															value="@bind(vm.currentAgent.agtupdatedby)"
															maxlength="255"
															constraint="max 255" />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedby'])" />
													</div>
												</div>
											</div>											<!-- Created At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Created At *" />
														<textbox tabindex="15" id="agtcreatedat"
															value="@bind(vm.currentAgent.agtcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['agtcreatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Updated At -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Updated At" />
														<textbox tabindex="16" id="agtupdatedat"
															value="@bind(vm.currentAgent.agtupdatedat)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['agtupdatedat'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentalerts -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentalerts" />
														<textbox tabindex="17" id="subagtagentalerts"
															value="@bind(vm.currentAgent.subagtagentalerts)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentalerts'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentapprovals -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentapprovals" />
														<textbox tabindex="18" id="subagtagentapprovals"
															value="@bind(vm.currentAgent.subagtagentapprovals)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentapprovals'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentbiasdetections -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentbiasdetections" />
														<textbox tabindex="19" id="subagtagentbiasdetections"
															value="@bind(vm.currentAgent.subagtagentbiasdetections)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentbiasdetections'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentcollaborations -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentcollaborations" />
														<textbox tabindex="20" id="subagtagentcollaborations"
															value="@bind(vm.currentAgent.subagtagentcollaborations)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentcollaborations'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentcollaborations By Agent -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentcollaborations By Agent" />
														<textbox tabindex="21" id="subagtagentcollaborationsbyagent2"
															value="@bind(vm.currentAgent.subagtagentcollaborationsByAgent2)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentcollaborationsbyagent2'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentcommunications -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentcommunications" />
														<textbox tabindex="22" id="subagtagentcommunications"
															value="@bind(vm.currentAgent.subagtagentcommunications)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentcommunications'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentcommunications By Receiveragent -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentcommunications By Receiveragent" />
														<textbox tabindex="23" id="subagtagentcommunicationsbyreceiveragent"
															value="@bind(vm.currentAgent.subagtagentcommunicationsByReceiveragent)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentcommunicationsbyreceiveragent'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentcompliance -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentcompliance" />
														<textbox tabindex="24" id="subagtagentcompliance"
															value="@bind(vm.currentAgent.subagtagentcompliance)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentcompliance'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentdecisions -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentdecisions" />
														<textbox tabindex="25" id="subagtagentdecisions"
															value="@bind(vm.currentAgent.subagtagentdecisions)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentdecisions'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentdeployments -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentdeployments" />
														<textbox tabindex="26" id="subagtagentdeployments"
															value="@bind(vm.currentAgent.subagtagentdeployments)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentdeployments'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentethicsassessments -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentethicsassessments" />
														<textbox tabindex="27" id="subagtagentethicsassessments"
															value="@bind(vm.currentAgent.subagtagentethicsassessments)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentethicsassessments'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentexpertise -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentexpertise" />
														<textbox tabindex="28" id="subagtagentexpertise"
															value="@bind(vm.currentAgent.subagtagentexpertise)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentexpertise'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentgovernance -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentgovernance" />
														<textbox tabindex="29" id="subagtagentgovernance"
															value="@bind(vm.currentAgent.subagtagentgovernance)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentgovernance'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagenthealth -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagenthealth" />
														<textbox tabindex="30" id="subagtagenthealth"
															value="@bind(vm.currentAgent.subagtagenthealth)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagenthealth'])" />
													</div>
												</div>
											</div>											<!-- Subagtagentinteractions -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subagtagentinteractions" />
														<textbox tabindex="31" id="subagtagentinteractions"
															value="@bind(vm.currentAgent.subagtagentinteractions)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subagtagentinteractions'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subagtagentmonitoring -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
