<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="artefacto"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.artefacto.BaseArtifactDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Base Artifact" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveBaseArtifact')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Catartname -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartname *" />
														<textbox tabindex="2" id="catartname"
															value="@bind(vm.currentBaseArtifact.catartname) @save(vm.currentBaseArtifact.catartname, before=('saveItem')) @validator(vm.unique, field='CATARTNAME', required=true, oldValue=vm.originalCatartname)"
															maxlength="255"
															constraint="no empty: max 255" />
														<label sclass="text-danger" value="@load(vmsgs['catartname'])" />
													</div>
												</div>
											</div>											<!-- Catartdescription -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartdescription" />
														<textbox tabindex="3" id="catartdescription"
															value="@bind(vm.currentBaseArtifact.catartdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catartdescription'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catarttype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catarttype *" />
														<combobox tabindex="4" id="catarttype"
															selectedItem="@bind(vm.currentBaseArtifact.catarttype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['catarttype'])" />
													</div>
												</div>
											</div>											<!-- Catarturi -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catarturi" />
														<textbox tabindex="5" id="catarturi"
															value="@bind(vm.currentBaseArtifact.catarturi)"
															maxlength="500"
															constraint="max 500" />
														<label sclass="text-danger" value="@load(vmsgs['catarturi'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catartmetadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartmetadata" />
														<textbox tabindex="6" id="catartmetadata"
															value="@bind(vm.currentBaseArtifact.catartmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catartmetadata'])" />
													</div>
												</div>
											</div>											<!-- Catartcurrentversion -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartcurrentversion" />
														<textbox tabindex="7" id="catartcurrentversion"
															value="@bind(vm.currentBaseArtifact.catartcurrentversion)"
															maxlength="20"
															constraint="max 20" />
														<label sclass="text-danger" value="@load(vmsgs['catartcurrentversion'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catartcreatedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartcreatedby" />
														<textbox tabindex="8" id="catartcreatedby"
															value="@bind(vm.currentBaseArtifact.catartcreatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catartcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Catartupdatedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartupdatedby" />
														<textbox tabindex="9" id="catartupdatedby"
															value="@bind(vm.currentBaseArtifact.catartupdatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catartupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catartcreatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartcreatedat *" />
														<textbox tabindex="10" id="catartcreatedat"
															value="@bind(vm.currentBaseArtifact.catartcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catartcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Catartupdatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catartupdatedat *" />
														<textbox tabindex="11" id="catartupdatedat"
															value="@bind(vm.currentBaseArtifact.catartupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catartupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subcatartifactdependencies -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subcatartifactdependencies" />
														<textbox tabindex="12" id="subcatartifactdependencies"
															value="@bind(vm.currentBaseArtifact.subcatartifactdependencies)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subcatartifactdependencies'])" />
													</div>
												</div>
											</div>											<!-- Subcatartifactdependencies By Targetartifact -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subcatartifactdependencies By Targetartifact" />
														<textbox tabindex="13" id="subcatartifactdependenciesbytargetartifact"
															value="@bind(vm.currentBaseArtifact.subcatartifactdependenciesByTargetartifact)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subcatartifactdependenciesbytargetartifact'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Subcatartifactversions -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Subcatartifactversions" />
														<textbox tabindex="14" id="subcatartifactversions"
															value="@bind(vm.currentBaseArtifact.subcatartifactversions)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['subcatartifactversions'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Subcatartifactdependencies" onSelect="@command('onSelectArtifactDependencyTab')" />
												<tab label="Subcatartifactdependencies By Targetartifact" onSelect="@command('onSelectArtifactDependencyTab')" />
												<tab label="Subcatartifactversions" onSelect="@command('onSelectArtifactVersionTab')" />
											</tabs>
											<tabpanels>
												<!-- Panel: Subcatartifactdependencies -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subcatartifactdependencies"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalArtifactDependencys)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subcatartifactdependencies)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subcatartifactdependencies)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subcatartifactdependencies registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Subcatartifactdependencies By Targetartifact -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subcatartifactdependencies By Targetartifact"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalArtifactDependencys)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subcatartifactdependenciesByTargetartifact)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subcatartifactdependenciesByTargetartifact)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subcatartifactdependencies by targetartifact registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
												<!-- Panel: Subcatartifactversions -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Subcatartifactversions"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalArtifactVersions)"/> 
															<label value="registros"/>
														</h:span>
													</h:div>
													
													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Nombre"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.subcatartifactversions)" var="item">
																	<h:tr>
																		<h:td><label value="@load(item.id)"/></h:td>
																		<h:td><label value="@load(item.name)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-success">
																				<label value="@load(item.status)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(item.createdAt)"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>
													
													<h:div class="text-center text-muted py-3" visible="@load(empty vm.subcatartifactversions)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay subcatartifactversions registrados"/>
														</h:p>
													</h:div>
												</tabpanel>
											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>