<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="artefacto"
		viewModel="@id('vm') @init('com.codeflowx.platform.viewmodel.artefacto.ArtifactDependencyDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-cube label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de Artifact Dependency" class="text-muted" />
					</h:p>
				</div>
			</div>
			
			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light" 
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('saveArtifactDependency')"
										tooltiptext="Guardar">
									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					
					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">

										<div class="form-group row">
											<!-- Catdepsourceartifactid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepsourceartifactid *" />
														<textbox tabindex="2" id="catdepsourceartifactid"
															value="@bind(vm.currentArtifactDependency.catdepsourceartifactid)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catdepsourceartifactid'])" />
													</div>
												</div>
											</div>											<!-- Catdeptargetartifactid -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdeptargetartifactid *" />
														<textbox tabindex="3" id="catdeptargetartifactid"
															value="@bind(vm.currentArtifactDependency.catdeptargetartifactid)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catdeptargetartifactid'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catdeptype -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdeptype *" />
														<combobox tabindex="4" id="catdeptype"
															selectedItem="@bind(vm.currentArtifactDependency.catdeptype)"
															readonly="true"
															constraint="no empty">
															<comboitem label="Tipo 1" value="TYPE1"/>
															<comboitem label="Tipo 2" value="TYPE2"/>
															<comboitem label="Tipo 3" value="TYPE3"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['catdeptype'])" />
													</div>
												</div>
											</div>											<!-- Catdeprequiredversion -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdeprequiredversion" />
														<textbox tabindex="5" id="catdeprequiredversion"
															value="@bind(vm.currentArtifactDependency.catdeprequiredversion)"
															maxlength="20"
															constraint="max 20" />
														<label sclass="text-danger" value="@load(vmsgs['catdeprequiredversion'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catdepdescription -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepdescription" />
														<textbox tabindex="6" id="catdepdescription"
															value="@bind(vm.currentArtifactDependency.catdepdescription)"
															rows="4" multiline="true"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catdepdescription'])" />
													</div>
												</div>
											</div>											<!-- Catdepmetadata -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepmetadata" />
														<textbox tabindex="7" id="catdepmetadata"
															value="@bind(vm.currentArtifactDependency.catdepmetadata)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catdepmetadata'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catdepcreatedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepcreatedby" />
														<textbox tabindex="8" id="catdepcreatedby"
															value="@bind(vm.currentArtifactDependency.catdepcreatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catdepcreatedby'])" />
													</div>
												</div>
											</div>											<!-- Catdepupdatedby -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepupdatedby" />
														<textbox tabindex="9" id="catdepupdatedby"
															value="@bind(vm.currentArtifactDependency.catdepupdatedby)"
															maxlength="255"
															 />
														<label sclass="text-danger" value="@load(vmsgs['catdepupdatedby'])" />
													</div>
												</div>
											</div>
										</div>
										<div class="form-group row">
											<!-- Catdepcreatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepcreatedat *" />
														<textbox tabindex="10" id="catdepcreatedat"
															value="@bind(vm.currentArtifactDependency.catdepcreatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catdepcreatedat'])" />
													</div>
												</div>
											</div>											<!-- Catdepupdatedat -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Catdepupdatedat *" />
														<textbox tabindex="11" id="catdepupdatedat"
															value="@bind(vm.currentArtifactDependency.catdepupdatedat)"
															maxlength="255"
															constraint="no empty" />
														<label sclass="text-danger" value="@load(vmsgs['catdepupdatedat'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>