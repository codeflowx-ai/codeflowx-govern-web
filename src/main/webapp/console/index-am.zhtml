<!doctype html>
<html class="h-100" lang="en" xmlns="http://www.w3.org/1999/xhtml"
	xmlns:zk="zk" xmlns:z="zul" xmlns:c="client"
	>
	<head>
		<meta charset="utf-8">
			<meta name="viewport"
				content="width=device-width, initial-scale=1">
				<meta name="description" content="">
					<title>Suinsit</title>
					<!-- Favicon -->
					<link href="img/favicon.png" rel="icon">
						<link rel="canonical" href="">
							<!-- CSS Bootstrap -->
							<link href="css/bootstrap.min.css"
								rel="stylesheet">
								<link
									href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
									rel="stylesheet">
									<!-- Font Awesome -->
									<link rel="stylesheet"
										href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
										<!-- Kid Font Awesome -->
										<link rel="stylesheet"
											href="https://kit.fontawesome.com/5b0fb4f6f9.css"
											crossorigin="anonymous">
											<!-- Estilos personalizados -->
											<link href="css/styles.css" rel="stylesheet">

	</head>
	<body class="bd-back"
		style="background: url('img/fondo-4.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">
		<z:div
			viewModel="@id('ds') @init('com.suinsit.webapp.nocode.DashboardUI')">
			<zk:custom-attributes dashboard="misProyectos.zul" />
			<z:include src="header.zul"></z:include>
			<div class="d-flex">
			   <z:include id="menuLeft" src="menuLeft.zul"></z:include>
				<section class="w-100">
<!-- 				<z:include id="menuHeader" src="menuHeader.zul"></z:include> -->
				  <br/><br/>
					
                        
				</section>
			</div>
			
			
			<div class="d-flex mt-5"> 
        
   
        
	<div class="section-suinsit d-section" id="contenedor" style="padding:15px;">
	    
	    
	    <div class="bread-mkt">Inicio &gt; Sección &gt; Sub-Sección</div>
    	<z:label class="ttl-mkt">Título de la Página</z:label>




		<div class="row">
			<div class="col-8 mb-4">
				<div class="card cards-mkt-sf">
					<z:hlayout spacing="10px" style="margin-bottom:20px;">
				        <z:vlayout class="mkt" style="padding:20px;">
				            <z:label class="subtt-mkt">Modelos </z:label>
				            <z:label class="txt-mkt">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In lacinia tristique lacus, vitae sollicitudin nunc pulvinar venenatis. Vestibulum eu risus quis leo venenatis sollicitudin ac ut ante.</z:label>
				            <z:grid  >
				                <z:rows>
				                    <z:row>
				                        <z:hlayout class="card-modelos">
				                            <z:image src="img/news/semantic.png" class="img-bdr" width="50px" height="50px" />
				                            <z:vlayout spacing="5px">
				                                <z:label class="modelos-ttl">Título Card</z:label>
				                                <z:label class="modelos-txt">Por Autor</z:label>
				                            </z:vlayout>
				                        </z:hlayout>
				                        <z:hlayout class="card-modelos">
				                            <z:image src="img/news/bpmn-bussines.png" class="img-bdr" width="50px" height="50px" />
				                            <z:vlayout spacing="5px">
				                                <z:label class="modelos-ttl">Título Card</z:label>
				                                <z:label class="modelos-txt">Por Autor</z:label>
				                            </z:vlayout>
				                        </z:hlayout>
				                        <z:hlayout class="card-modelos">
				                            <z:image src="img/news/api.png" class="img-bdr" width="50px" height="50px" />
				                            <z:vlayout spacing="5px">
				                                <z:label class="modelos-ttl">Título Card</z:label>
				                                <z:label class="modelos-txt">Por Autor</z:label>
				                            </z:vlayout>
				                        </z:hlayout>
				                         <z:hlayout class="card-modelos">
				                            <z:image src="/img/bot.png" class="img-bdr" width="50px" height="50px" />
				                            <z:vlayout spacing="5px">
				                                <z:label class="modelos-ttl">Título Card</z:label>
				                                <z:label class="modelos-txt">Por Autor</z:label>
				                            </z:vlayout>
				                        </z:hlayout>
				                    </z:row>
				                </z:rows>
				            </z:grid>
				        </z:vlayout>
				    </z:hlayout>
			    </div>
		    </div>
		    
		    <div class="col-4 mb-4">
			    <div class="card cards-mkt-sf">
			    	<z:div class="mkt-dp">
			            <z:label class="subtt-mkt">Destacados</z:label>
			            <z:label multiline="true" class="txt-mkt">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In lacinia tristique lacus, vitae sollicitudin nunc pulvinar venenatis. Vestibulum eu risus quis leo venenatis sollicitudin ac ut ante.</z:label>
			            <z:a href="#" class="link-mkt">Ver ejemplos</z:a>
			        </z:div>
	    		</div>
    		</div>
    	</div>
    
    <div class="row">
			<div class="col-8 mb-4">
				<div class="card cards-mkt-sf">
				    <z:hlayout spacing="10px" class="mkt-dp">
				        <z:vlayout>
				            <z:label class="subtt-mkt">Areas</z:label>
				            <br><br>
				            <div class="card cards-mkt" style="background: url('img/bannerfd.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">
					            <div class="mkt-dp">
					            	<z:label class="subtt-mkt">Chat/Text</z:label>
					                <z:label multiline="true" class="txt-mkt">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In lacinia tristique lacus, vitae sollicitudin nunc pulvinar venenatis. Vestibulum eu risus quis leo venenatis sollicitudin ac ut ante.</z:label>
					                <z:a href="#" class="link-mkt">Abrir chat</z:a>
					            </div>
				            </div>
				        </z:vlayout>
				    </z:hlayout>
			    </div>
			</div>
			
			<div class="col-4 mb-4" >
				<div class="card cards-mkt-sf" >
			        <z:div class="mkt-dp">
			            <z:label class="subtt-mkt">Información Adicional</z:label>
			            <z:label multiline="true" class="txt-mkt">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In lacinia tristique lacus, vitae sollicitudin nunc pulvinar venenatis. Vestibulum eu risus quis leo venenatis sollicitudin ac ut ante.</z:label>
			            <z:a href="#" class="link-mkt">Ver ejemplos</z:a>
