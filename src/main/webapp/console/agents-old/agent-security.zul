<?page title="Agent Security & Compliance" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.agent.security.AgentSecurityVM')">
        
        <!-- Security Overview -->
        <hlayout sclass="security-header">
            <div sclass="metric-box">
                <label value="Security Score"/>
                <label value="@load(vm.securityScore)%" 
                       sclass="@load(vm.securityScoreStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Active Policies"/>
                <label value="@load(vm.activePolicies)"/>
            </div>
            <div sclass="metric-box">
                <label value="Security Incidents"/>
                <label value="@load(vm.securityIncidents)"/>
            </div>
            <div sclass="metric-box">
                <label value="Compliance Status"/>
                <label value="@load(vm.complianceStatus)" 
                       sclass="@load(vm.complianceStatusStyle)"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Access Control"/>
                <tab label="Security Policies"/>
                <tab label="Activity Logs"/>
                <tab label="Compliance"/>
            </tabs>
            <tabpanels>
                <!-- Access Control Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Permission Matrix -->
                        <grid model="@load(vm.permissionMatrix)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Agent"/>
                                <column label="Role"/>
                                <column label="Permissions"/>
                                <column label="Restrictions"/>
                                <column label="Last Modified"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="perm">
                                <row>
                                    <label value="@load(perm.agentName)"/>
                                    <label value="@load(perm.role)"/>
                                    <cell>
                                        <forEach items="@load(perm.permissions)" 
                                                 var="permission">
                                            <label value="@load(permission)" 
                                                   sclass="permission-tag"/>
                                        </forEach>
                                    </cell>
                                    <cell>
                                        <forEach items="@load(perm.restrictions)" 
                                                 var="restriction">
                                            <label value="@load(restriction)" 
                                                   sclass="restriction-tag"/>
                                        </forEach>
                                    </cell>
                                    <label value="@load(perm.lastModified)"/>
                                    <hlayout>
                                        <button label="Edit" 
                                                onClick="@command('editPermissions', perm=perm)"/>
                                        <button label="Audit" 
                                                onClick="@command('auditPermissions', perm=perm)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Security Policies Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Policy Management -->
                        <listbox model="@load(vm.securityPolicies)" 
                                mold="paging" pageSize="10">
                            <listhead>
                                <listheader label="Policy Name"/>
                                <listheader label="Type"/>
                                <listheader label="Status"/>
                                <listheader label="Applied To"/>
                                <listheader label="Last Updated"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="policy">
                                <listitem>
                                    <listcell label="@load(policy.name)"/>
                                    <listcell label="@load(policy.type)"/>
                                    <listcell>
                                        <label value="@load(policy.status)" 
                                               sclass="@load(policy.statusStyle)"/>
                                    </listcell>
                                    <listcell label="@load(policy.appliedTo)"/>
                                    <listcell label="@load(policy.lastUpdated)"/>
                                    <listcell>
                                        <hlayout>
                                            <button label="Edit" 
                                                    onClick="@command('editPolicy', policy=policy)"/>
                                            <button label="Enable/Disable" 
                                                    onClick="@command('togglePolicy', policy=policy)"/>
                                            <button label="History" 
                                                    onClick="@command('viewPolicyHistory', policy=policy)"/>
                                        </hlayout>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>

                <!-- Activity Logs Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Log Filters -->
                        <hlayout sclass="log-filters">
                            <datebox value="@bind(vm.startDate)" 
                                    format="yyyy-MM-dd" 
                                    placeholder="Start Date"/>
                            <datebox value="@bind(vm.endDate)" 
                                    format="yyyy-MM-dd" 
                                    placeholder="End Date"/>
                            <combobox model="@load(vm.logTypes)" 
                                     selectedItem="@bind(vm.selectedLogType)"/>
                            <textbox value="@bind(vm.searchTerm)" 
                                    placeholder="Search logs..."/>
                            <button label="Search" 
                                    onClick="@command('searchLogs')"/>
                            <button label="Export" 
                                    onClick="@command('exportLogs')"/>
                        </hlayout>

                        <!-- Activity Log Grid -->
                        <grid model="@load(vm.activityLogs)" 
                              mold="paging" pageSize="15">
                            <columns>
                                <column label="Timestamp"/>
                                <column label="Agent"/>
                                <column label="Action"/>
                                <column label="Details"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="log">
                                <row sclass="@load(log.severityStyle)">
                                    <label value="@load(log.timestamp)"/>
                                    <label value="@load(log.agentName)"/>
                                    <label value="@load(log.action)"/>
                                    <label value="@load(log.details)"/>
                                    <label value="@load(log.status)" 
                                           sclass="@load(log.statusStyle)"/>
                                    <hlayout>
                                        <button label="View" 
                                                onClick="@command('viewLogDetails', log=log)"/>
                                        <button label="Investigate" 
                                                onClick="@command('investigateLog', log=log)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Compliance Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Compliance Overview -->
                        <grid model="@load(vm.complianceChecks)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Requirement"/>
                                <column label="Status"/>
                                <column label="Last Check"/>
                                <column label="Next Check"/>
                                <column label="Risk Level"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="check">
                                <row>
                                    <label value="@load(check.requirement)"/>
                                    <label value="@load(check.status)" 
                                           sclass="@load(check.statusStyle)"/>
                                    <label value="@load(check.lastCheck)"/>
                                    <label value="@load(check.nextCheck)"/>
                                    <label value="@load(check.riskLevel)" 
                                           sclass="@load(check.riskLevelStyle)"/>
                                    <hlayout>
                                        <button label="Details" 
                                                onClick="@command('viewComplianceDetails', check=check)"/>
                                        <button label="Run Check" 
                                                onClick="@command('runComplianceCheck', check=check)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Compliance Charts -->
                        <hlayout>
                            <charts id="complianceTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Compliance Trends"
                                   model="@load(vm.complianceTrendsData)"/>
                            
                            <charts id="riskDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="Risk Distribution"
                                   model="@load(vm.riskDistributionData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="permissionEditorWindow" 
                title="Permission Editor" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Permission Editor Content -->
        </window>

        <window id="policyEditorWindow" 
                title="Policy Editor" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Policy Editor Content -->
        </window>

        <window id="logDetailsWindow" 
                title="Log Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Log Details Content -->
        </window>
    </div>
</zk>