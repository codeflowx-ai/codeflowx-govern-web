<?page title="Load Balancer" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.routing.loadbalancer.LoadBalancerVM')">
        
        <hlayout>
            <!-- Load Distribution Overview -->
            <groupbox title="Current Load Distribution" width="60%">
                <charts id="loadDistChart" 
                       type="pie"
                       model="@load(vm.loadDistribution)"
                       height="300px"/>
                
                <listbox model="@load(vm.modelLoads)" 
                        mold="paging" 
                        pageSize="5">
                    <listhead>
                        <listheader label="Model"/>
                        <listheader label="Current Load"/>
                        <listheader label="Response Time"/>
                        <listheader label="Health"/>
                        <listheader label="Actions"/>
                    </listhead>
                    <template name="model">
                        <listitem>
                            <listcell label="@load(each.modelName)"/>
                            <listcell>
                                <progressmeter value="@load(each.currentLoad)"/>
                                <label value="@load(each.currentLoad)%"/>
                            </listcell>
                            <listcell label="@load(each.responseTime)ms"/>
                            <listcell>
                                <label value="@load(each.health)" 
                                       sclass="@load(each.healthStyle)"/>
                            </listcell>
                            <listcell>
                                <button label="Adjust Weight" 
                                        onClick="@command('adjustWeight', model=each)"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </groupbox>

            <!-- Load Balancer Configuration -->
            <groupbox title="Load Balancer Settings" width="40%">
                <grid>
                    <rows>
                        <row>
                            <label value="Algorithm"/>
                            <combobox model="@load(vm.algorithms)"
                                     selectedItem="@bind(vm.selectedAlgorithm)"
                                     onChange="@command('updateAlgorithm')">
                                <template name="model">
                                    <comboitem label="@load(each.name)"
                                              description="@load(each.description)"/>
                                </template>
                            </combobox>
                        </row>
                        <row>
                            <label value="Health Check Interval (s)"/>
                            <intbox value="@bind(vm.healthCheckInterval)"
                                   onChange="@command('updateSettings')"/>
                        </row>
                        <row>
                            <label value="Max Load Threshold (%)"/>
                            <intbox value="@bind(vm.maxLoadThreshold)"
                                   onChange="@command('updateSettings')"/>
                        </row>
                    </rows>
                </grid>

                <!-- Advanced Settings -->
                <groupbox title="Advanced Settings">
                    <grid>
                        <rows>
                            <row>
                                <label value="Session Affinity"/>
                                <checkbox checked="@bind(vm.sessionAffinity)"
                                         onCheck="@command('updateSettings')"/>
                            </row>
                            <row>
                                <label value="Auto-scaling"/>
                                <checkbox checked="@bind(vm.autoScaling)"
                                         onCheck="@command('updateSettings')"/>
                            </row>
                            <row>
                                <label value="Failover Strategy"/>
                                <combobox model="@load(vm.failoverStrategies)"
                                         selectedItem="@bind(vm.selectedFailoverStrategy)"
                                         onChange="@command('updateSettings')"/>
                            </row>
                        </rows>
                    </grid>
                </groupbox>
            </groupbox>
        </hlayout>

        <!-- Performance Metrics -->
        <groupbox title="Performance Metrics">
            <hlayout>
                <charts id="responseTimeChart" 
                       type="line"
                       model="@load(vm.responseTimeHistory)"
                       height="250px"
                       width="50%"
                       title="Response Time Trends"/>
                
                <charts id="throughputChart" 
                       type="line"
                       model="@load(vm.throughputHistory)"
                       height="250px"
                       width="50%"
                       title="Throughput Trends"/>
            </hlayout>
        </groupbox>

        <!-- Health Checks -->
        <groupbox title="Health Check Status">
            <listbox model="@load(vm.healthChecks)"
                     mold="paging"
                     pageSize="5">
                <listhead>
                    <listheader label="Timestamp"/>
                    <listheader label="Model"/>
                    <listheader label="Status"/>
                    <listheader label="Response Time"/>
                    <listheader label="Details"/>
                </listhead>
                <template name="model">
                    <listitem>
                        <listcell label="@load(each.timestamp)"/>
                        <listcell label="@load(each.modelName)"/>
                        <listcell>
                            <label value="@load(each.status)" 
                                   sclass="@load(each.statusStyle)"/>
                        </listcell>
                        <listcell label="@load(each.responseTime)ms"/>
                        <listcell>
                            <button label="View Details" 
                                    onClick="@command('showHealthDetails', check=each)"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </groupbox>
    </div>
</zk>