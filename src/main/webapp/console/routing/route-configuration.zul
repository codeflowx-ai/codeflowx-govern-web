<?page title="Route Configuration" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.routing.config.RouteConfigurationVM')">
        
        <hlayout>
            <!-- Route Editor -->
            <groupbox title="Route Editor" width="60%">
                <vlayout>
                    <hlayout>
                        <button label="New Route" 
                                iconSclass="z-icon-plus"
                                onClick="@command('newRoute')"/>
                        <button label="Import Routes" 
                                iconSclass="z-icon-upload"
                                onClick="@command('importRoutes')"/>
                        <button label="Export Routes" 
                                iconSclass="z-icon-download"
                                onClick="@command('exportRoutes')"/>
                    </hlayout>

                    <listbox model="@load(vm.routes)" 
                            selectedItem="@bind(vm.selectedRoute)"
                            onSelect="@command('selectRoute')">
                        <listhead>
                            <listheader label="Name"/>
                            <listheader label="Pattern"/>
                            <listheader label="Models"/>
                            <listheader label="Priority"/>
                            <listheader label="Status"/>
                            <listheader label="Actions"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell label="@load(each.name)"/>
                                <listcell label="@load(each.pattern)"/>
                                <listcell>
                                    <forEach items="@load(each.targetModels)" var="model">
                                        <label value="@load(model)"/>
                                    </forEach>
                                </listcell>
                                <listcell label="@load(each.priority)"/>
                                <listcell>
                                    <label value="@load(each.status)" 
                                           sclass="@load(each.statusStyle)"/>
                                </listcell>
                                <listcell>
                                    <button iconSclass="z-icon-edit" 
                                            tooltiptext="Edit"
                                            onClick="@command('editRoute', route=each)"/>
                                    <button iconSclass="z-icon-trash" 
                                            tooltiptext="Delete"
                                            onClick="@command('deleteRoute', route=each)"/>
                                    <button iconSclass="z-icon-play" 
                                            tooltiptext="Test"
                                            onClick="@command('testRoute', route=each)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                </vlayout>
            </groupbox>

            <!-- Route Details -->
            <groupbox title="Route Details" width="40%"
                      visible="@load(not empty vm.selectedRoute)">
                <grid>
                    <rows>
                        <row>
                            <label value="Name"/>
                            <textbox value="@bind(vm.selectedRoute.name)" width="100%"/>
                        </row>
                        <row>
                            <label value="Pattern"/>
                            <textbox value="@bind(vm.selectedRoute.pattern)" width="100%"/>
                        </row>
                        <row>
                            <label value="Models"/>
                            <selectbox model="@load(vm.availableModels)"
                                      selectedItems="@bind(vm.selectedRoute.targetModels)"
                                      multiple="true"/>
                        </row>
                        <row>
                            <label value="Priority"/>
                            <intbox value="@bind(vm.selectedRoute.priority)"/>
                        </row>
                        <row>
                            <label value="Status"/>
                            <combobox value="@bind(vm.selectedRoute.status)"
                                     model="@load(vm.statusOptions)"/>
                        </row>
                        <row>
                            <label value="Advanced Settings"/>
                            <button label="Configure" 
                                    onClick="@command('showAdvancedSettings')"/>
                        </row>
                    </rows>
                </grid>

                <hlayout>
                    <button label="Save" 
                            onClick="@command('saveRoute')"
                            sclass="primary"/>
                    <button label="Cancel" 
                            onClick="@command('cancelEdit')"/>
                </hlayout>
            </groupbox>
        </hlayout>

        <!-- Route Rules -->
        <groupbox title="Routing Rules">
            <listbox model="@load(vm.routingRules)"
                     mold="paging" pageSize="5">
                <listhead>
                    <listheader label="Rule Type"/>
                    <listheader label="Condition"/>
                    <listheader label="Action"/>
                    <listheader label="Priority"/>
                    <listheader label="Status"/>
                    <listheader label="Actions"/>
                </listhead>
                <template name="model">
                    <listitem>
                        <listcell label="@load(each.type)"/>
                        <listcell label="@load(each.condition)"/>
                        <listcell label="@load(each.action)"/>
                        <listcell label="@load(each.priority)"/>
                        <listcell>
                            <label value="@load(each.status)" 
                                   sclass="@load(each.statusStyle)"/>
                        </listcell>
                        <listcell>
                            <button iconSclass="z-icon-edit" 
                                    tooltiptext="Edit"
                                    onClick="@command('editRule', rule=each)"/>
                            <button iconSclass="z-icon-toggle-on" 
                                    tooltiptext="Toggle"
                                    onClick="@command('toggleRule', rule=each)"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </groupbox>

        <!-- Advanced Settings Window -->
        <window id="advancedSettingsWindow" 
                title="Advanced Route Settings"
                mode="modal" 
                visible="false">
            <vlayout>
                <groupbox title="Retry Configuration">
                    <grid>
                        <rows>
                            <row>
                                <label value="Max Retries"/>
                                <intbox value="@bind(vm.selectedRoute.maxRetries)"/>
                            </row>
                            <row>
                                <label value="Retry Delay (ms)"/>
                                <intbox value="@bind(vm.selectedRoute.retryDelay)"/>
                            </row>
                            <row>
                                <label value="Retry Strategy"/>
                                <combobox value="@bind(vm.selectedRoute.retryStrategy)"
                                         model="@load(vm.retryStrategies)"/>
                            </row>
                        </rows>
                    </grid>
                </groupbox>

                <groupbox title="Timeout Settings">
                    <grid>
                        <rows>
                            <row>
                                <label value="Request Timeout (ms)"/>
                                <intbox value="@bind(vm.selectedRoute.requestTimeout)"/>
                            </row>
                            <row>
                                <label value="Circuit Breaker Threshold"/>
                                <intbox value="@bind(vm.selectedRoute.circuitBreakerThreshold)"/>
                            </row>
                        </rows>
                    </grid>
                </groupbox>

                <groupbox title="Rate Limiting">
                    <grid>
                        <rows>
                            <row>
                                <label value="Requests per Second"/>
                                <intbox value="@bind(vm.selectedRoute.rateLimit)"/>
                            </row>
                            <row>
                                <label value="Burst Size"/>
                                <intbox value="@bind(vm.selectedRoute.burstSize)"/>
                            </row>
                        </rows>
                    </grid>
                </groupbox>

                <hlayout>
                    <button label="Save" onClick="@command('saveAdvancedSettings')"/>
                    <button label="Cancel" onClick="@command('closeAdvancedSettings')"/>
                </hlayout>
            </vlayout>
        </window>
    </div>
</zk>