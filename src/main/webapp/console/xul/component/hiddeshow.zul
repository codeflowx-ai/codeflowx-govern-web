<?component name="stepbar" templateURI="/console/stepApp/shadow_elements/step_bar/stepbar.zul"?>
<?component name="dual-listbox" extends="div" class="com.enartsystems.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute"
	xmlns:w="client">
	<window title="Configurar Eventos" border="normal" closable="true"
		mode="modal" width="60%" height="500px" position="center,center"
		action="show: slideDown;hide: slideUp">
		<div
			viewModel="@id('vm') @init('com.enartsystems.designer.commons.EventsHideShowUI')">
			<div class="row">
				<button class="btn btn-success" label="Save"
					onClick="@command('doStore')">
				</button>
			</div>
			<div class="row">
				Campo:
				<textbox value="@bind(vm.field)"></textbox>
			</div>
			<div class="row">
                <button label="Añadir Evento" onClick="@command('append')"></button> 
				<grid model="@bind(vm.pb.hideshow)">
					<columns>
						<column label="Operador" />
						<column label="valor" />
						<column label="Ocultar Areas" />
						<column label="Mostrar Areas" />
						<column label="" />
					</columns>
					<rows>
						<template name="model" var="item">
							<row>
								<combobox
									selectedItem="@bind(item.comparator)"
									value="@bind(item.comparator)">
									<comboitem label="Igual" />
									<comboitem label="Distinto" />
								</combobox>
								<textbox value="@bind(item.value)"></textbox>
								<textbox value="@bind(item.hiddeAreas)" multiline="true" rows="3" placeholder="introduzca las areas separadas por ,"></textbox>
								<textbox value="@bind(item.showAreas)" multiline="true" rows="3" placeholder="introduzca las areas separadas por ,"></textbox>
								<button label="remove" onClick="@command('remove',item=item)"></button>
							</row>
						</template>

					</rows>
				</grid>
			</div>
		</div>

	</window>
</zk>