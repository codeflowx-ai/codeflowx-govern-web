<?component name="dual-listbox" extends="div" class="com.enartsystems.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute"
	xmlns:w="client">
	<window title="Crear Campo" border="normal"
		closable="true" mode="modal" width="400px" height="200px"
		position="center,center" action="show: slideDown;hide: slideUp">
		<div
			viewModel="@id('vm') @init('com.enartsystems.designer.commons.CreateFieldUI')">
			<div class="row">
			<hbox spacing="15px">
			 	<button class="btn btn-outline-secondary" label="Crear Campo"
					onClick="@command('doCreateField')" tooltiptext="Crear el campo en la base de datos">
				</button>
				<button class="btn btn-outline-secondary" label="Crear Componente grafico"
					onClick="@command('doCreate')" tooltiptext="Crear solo campo en la pantalla">
				</button>
			</hbox>
			</div>
			<div class="row">
				<h:div class="col-md-12">
					<label sclass="form-label" value="Nombre del campo" />
					<textbox id="name" sclass="form-control from-control-sm" maxlength="40" value="@bind(vm.nameField)"></textbox>
				</h:div>
			</div>
		</div>
	</window>
</zk>