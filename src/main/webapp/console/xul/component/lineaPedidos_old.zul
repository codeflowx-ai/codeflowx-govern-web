<?component name="dual-listbox" extends="div" class="com.enartsystems.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute"
	xmlns:w="client">
	<window title="Pedidos" closable="true" mode="modal" width="60%"
		height="500px" position="center,center"
		action="show: slideDown;hide: slideUp">

		<div
			viewModel="@id('vm') @init('com.enartsystems.designer.commons.datagrid.LineaPedidosUI')">
			<div class="row">
				<button class="btn btn-success"
					iconSclass="icon wb-check" label="Save"
					onClick="@command('doStore')">
				</button>
			</div>
			<div class="row">
				<div class="col-md-4">
					<vlayout spacing="3px">
						<label sclass="form-label"
							value="Seleccione Tabla Producto" />
						<combobox model="@load(vm.foreings)"
							onSelect="@command('selectProducto',item=self.selectedItem.value)">
							<template name="model" var="item">
								<comboitem
									value="${item.entity.namesql}" label="${item.entity.namesql}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione Campo Producto" />
						<combobox model="@load(vm.fieldsProducto)"
							>
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione Campo Precio" />
						<combobox model="@load(vm.fdProdPrecio)"
							>
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione Campo Descripción" />
						<combobox model="@load(vm.fdProdDescripcion)"
							>
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione Campo Tasas" />
						<combobox model="@load(vm.fdProdTasas)"
							>
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>

					</vlayout>

				</div>
				<div class="col-md-4">
					<vlayout spacing="3px">
						<label sclass="form-label"
							value="Seleccione DataGrid Columna Producto" />
						<combobox model="@load(vm.foreings)"
							onSelect="@command('selectProducto',item=self.selectedItem.value)">
							<template name="model" var="item">
								<comboitem
									value="${item.entity.namesql}" label="${item.entity.namesql}" />
							</template>
						</combobox>

						<label sclass="form-label"
							value="Seleccione DataGrid Columna Precio" />
						<combobox model="@load(vm.fdProdPrecio)"
							onSelect="@command('selectProducto',item=self.selectedItem.value)">
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione DataGrid Columna Descripción" />
						<combobox model="@load(vm.fdProdDescripcion)"
							onSelect="@command('selectProducto',item=self.selectedItem.value)">
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>
						<label sclass="form-label"
							value="Seleccione DataGrid Columna Tasas" />
						<combobox model="@load(vm.fdProdTasas)"
							onSelect="@command('selectProducto',item=self.selectedItem.value)">
							<template name="model" var="item">
								<comboitem value="${item}"
									label="${item}" />
							</template>
						</combobox>

					</vlayout>
				</div>
				<div class="col-md-4">
				<vlayout spacing="3px">
					<label sclass="form-label"
						value="Seleccione Entidad Columna Total" />
					<combobox model="@load(vm.foreings)"
						onSelect="@command('selectProducto',item=self.selectedItem.value)">
						<template name="model" var="item">
							<comboitem value="${item.entity.namesql}"
								label="${item.entity.namesql}" />
						</template>
					</combobox>

					<label sclass="form-label"
						value="Seleccione Entidad Columna Subtotal" />
					<combobox model="@load(vm.fdProdPrecio)"
						onSelect="@command('selectProducto',item=self.selectedItem.value)">
						<template name="model" var="item">
							<comboitem value="${item}" label="${item}" />
						</template>
					</combobox>
					<label sclass="form-label"
						value="Seleccione Entidad Columna Tasas" />
					<combobox model="@load(vm.fdProdDescripcion)"
						onSelect="@command('selectProducto',item=self.selectedItem.value)">
						<template name="model" var="item">
							<comboitem value="${item}" label="${item}" />
						</template>
					</combobox>
					</vlayout>
				</div>

			</div>
		</div>
	</window>
</zk>