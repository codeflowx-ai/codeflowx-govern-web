<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native" 
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute" xmlns:w="client">
	<window title="HTML Fragment" border="normal" closable="true"
		mode="modal" width="80%" height="500px" position="center,center"
		action="show: slideDown;hide: slideUp">
		<div viewModel="@id('vm') @init('com.enartsystems.designer.commons.HtmlFragment')">
		     <div class="row">
		     <button class="btn "  label="Save" onClick="@command('doStore')">
								</button>
		     </div>
		     <ckeditor value="@bind(vm.content)"/>     
		</div>
		

</window>
    
	
</zk>