<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<div class="row">
		<div class="col-12">
			<div
				class="page-title-box d-sm-flex align-items-center justify-content-between">
				<include src="@load(ds.menuArquitectura)">
				</include>
			</div>
		</div>
	</div>
	 <space></space>
	 <include src="../includes/breadcrumbs.zul"></include>
	 <space></space>	
	 <idspace
		viewModel="@id('vm') @init('com.suinsit.webapp.mapping.ui.nocode.FindEntityData')"	>
		<div id="notificacion"></div>
		<div class="row">
			<h:div class="col-lg-9 ">
			<div class="card">
					<div class="card-header bg-white header-elements-inline">
					<h:h6 class="panel-title">
						 <h:i class="fa fa-2x s-icon s-icon-computadora"></h:i>
						${labels.MddMentity.searchentities}</h:h6>
						<h:div class="header-elements">
						  <h:div class="list-icons">
						  </h:div>
						</h:div>
					</div>
						<h:div class="card-body" style="overflow:auto;">
							<grid id="gr" model="@bind(vm.beans)"
								style="align:center" width="98%" height="500px"
								emptyMessage="${labels.paging.nodata}" mold="paging" pageSize="25" pagingPosition="both" autopaging="true">
							
								<columns columnsgroup="false"
									menupopup="auto" columnshide="false" sizable="true">
									<column
										label="${labels.MddMentity.txnamesql}" sort="auto(name)" />
									<column
										label="${labels.MddMentity.coentityname}"/>
									<column
										label="${labels.MddMentity.tipo}" sort="auto(entitype)" />
									<column
										label="${labels.MddMentity.fxalta}" sort="auto(lastModif)" />
									<column label="" />
								</columns>
								<rows >
						
									<template name="model" var="item">
										<row value="@bind(item)">
									
											<label
												value="@load(item.namesql)" />
											<label
												value="@load(item.className)" />
											<label
												value="@load(item.entitype)" />
											<label
												value="@load(item.lastModif)" />
											<cell align="center">
												<button
													onClick="@command('design',item=item)"
													tooltiptext="${labels.MddMentity.edit}"
													iconSclass="icon-pencil7" sclass="btn btn-outline bg-primary text-primary-800 btn-icon ml-2 legitRipple" />
											</cell>
										</row>
									</template>
								</rows>
							
							</grid>
						</h:div>
					
				</div>
			</h:div>

			<h:div class="col-lg-3 col-xlg-3 col-md-5">
				<includeHTML src="xspresso.zhtml"/>
			</h:div>
		</div>
	</idspace>
<!-- 	</div> -->
</zk>