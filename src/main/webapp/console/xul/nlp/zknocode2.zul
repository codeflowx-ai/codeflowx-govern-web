<zk xmlns:h="xhtml">
	<include src="include/breadcrumbs2.zul"></include>

	<div class="row">

		<div class="col-md-4 col-xl-4">
			<div class="card "
				onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA Generativa')">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid"
							src="/console/img/news/INFORMES.png" width="30%" height="30%">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Consultas SQL
					</h:h6>
					<h:span class="d-block opacity-75 text-teal-800">
						Activado
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Defina mediante IA consultas para su utilización
						en Gráficos e Informes
					</h:span>
				</div>
			</div>
		</div>
		<div class="col-md-4 col-xl-4">
			<div class="card"
				onClick="@global-command('selectDataPage',page='/console/wizzarTablasIA.zul',title='Reglas Base datos',menu='IA Generativa')">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid"
							src="/console/img/news/base-de-datos.png" width="30%"
							height="30%">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Reglas Base de datos
					</h:h6>
					<h:span class="d-block opacity-75 text-teal-800">
						Activado
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Aplique reglas en las actualizaciones de
						información en las tablas
					</h:span>
				</div>
			</div>
		</div>




		<div class="col-md-4 col-xl-4">
			<div class="card "
				onClick="@global-command('selectDataPage',page='/console/wizzarSQL.zul',title='Consultas SQL',menu='IA Generativa')">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid "
							src="/console/img/news/disenadores.png" width="30%" height="30%"
							onClick="@command('selectPage',action='xul/screens/screens.zul')">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Reglas y Eventos en pantallas
					</h:h6>
					<h:span class="d-block opacity-75 text-teal-800">
						Activado
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Defina reglas y eventos en las pantallas de la
						aplicación
					</h:span>
				</div>
			</div>
		</div>



		<div class="col-md-4 col-xl-4"
			onClick="@global-command('selectDataPage',page='/console/wizzarImportDocument.zul',title='Importar Requisitos',menu='IA Generativa')">
			<div class="card ">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid "
							src="/console/img/news/semantic.png" width="30%" height="30%">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Analisis de requisitos
					</h:h6>
					<h:span class="d-block opacity-75 text-teal-800">
						Activado
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Importe los requistos mediante nuestras
						plantillas en word para crear pantallas y/o
						micro servicios.
					</h:span>
				</div>
			</div>
		</div>

		<div class="col-md-4 col-xl-4"
			onClick="@global-command('selectDataPage',page='/console/wizzarImportDocument.zul',title='Importar Requisitos',menu='IA Generativa')">
			<div class="card ">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid"
							src="/console/img/news/api.png" width="30%" height="30%">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Reglas en Micros
					</h:h6>
					<h:span class="d-block opacity-75 text-teal-800">
						Activado
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Cree reglas con lenguaje natural en los micro
						servicios
					</h:span>
				</div>
			</div>
		</div>
		<div class="col-md-4 col-xl-4">
			<div class="card ">
				<div
					class="card-body bg-white text-center card-img-top">
					<div class="card-img-actions mx-1 mt-1">
						<image class="card-img img-fluid"
							src="/console/img/news/bpmn-bussines.png" width="30%"
							height="30%">
						</image>
					</div>
					<h:h6 class="font-weight-semibold mb-0">
						Reglas BPMN y BRMS
					</h:h6>
					<h:span
						class="d-block opacity-75 text-indigo-800">
						Proximamente
					</h:span>
				</div>
				<div class="card-body border-top-0">
					<h:span
						class="font-weight-semibold text-justify ">
						Diseñe sus procesos de negocio e integrelos en
						sus aplicaciones mediante api o bandeja de
						tareas.
					</h:span>
				</div>
			</div>
		</div>

	</div>
</zk>