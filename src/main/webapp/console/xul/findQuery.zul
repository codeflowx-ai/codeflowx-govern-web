<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="row">
		<div class="col-12">
			
		</div>
	</div>
	 <space></space>
	 <include src="include/breadcrumbs.zul"></include>
	 <space></space>
	<div id="editDeskop">
	 <idspace viewModel="@id('vm') @init('com.enartsystems.webapp.mapping.database.ui.FindQueryUI')"	>
	
		<div id="notificacion"></div>
		<space></space>
		<div class="row">
			<h:div class="col-lg-9 ">
			<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<button
									iconSclass="bx bx-add-to-queue label-icon align-middle fs-16 me-2"
									onClick="@command('addData')"
									sclass="btn btn-label btn-success waves-effect waves-light"
									tooltiptext="Nueva vista / Consulta">
									Nueva Vista
								</button>
							</div>
							<div class="flex-shrink-0">
								
							</div>
						</div>
					</div>
						<h:div class="card-body" style="overflow:auto;">
							<grid id="gr" model="@bind(vm.beans)"
								style="align:center" width="98%" height="500px"
								emptyMessage="${labels.paging.nodata}" mold="paging" pageSize="25" pagingPosition="both" autopaging="true">
								<columns columnsgroup="false"
									menupopup="auto" columnshide="false" sizable="true">
									<column
										label="${labels.MddMentity.namesql}" sort="auto(name)" />
									<column
										label="${labels.MddMentity.coentityname}"/>
									<column
										label="${labels.MddMentity.tipo}" />
									<column
										label="${labels.MddMentity.fxalta}" sort="auto(lastModif)" />
									<column label="" />
								</columns>
								<rows>
									<template name="model" var="item">
										<row value="@bind(item)">
											<label
												value="@load(item.namesql)" />
											<label
												value="@load(item.className)" />
											<label
												value="@load(item.entitype)" />
											<label
												value="@load(item.lastModif)" />
											<cell align="center">
												<button
												onClick="@command('editData',item=item)"
												tooltiptext="${labels.MddMentity.edit}"
												iconSclass="bx bx-pencil fs-2x"
												sclass="btn btn-outline-success waves-effect waves-light shadow-none" />
											<space></space>
											<button
												onClick="@command('removeData',item=item)"
												tooltiptext="${labels.MddMentity.remove}"
												iconSclass="bx bx-trash fs-2x"
												sclass="btn btn-outline-danger waves-effect waves-light shadow-none" />
											</cell>
										</row>
									</template>
								</rows>
								
							</grid>
						</h:div>
		
				</div>
			</h:div>

			<h:div class="col-lg-3 col-xlg-3 col-md-5">
				<h:div class="card border-1 border-success">
					<h:div class="card-header alpha-success border-success d-flex justify-content-between">
						<h:h4 class="m-b-0 text-indigo">
							${labels.MddMentity.help}
						</h:h4>
					</h:div>
					<h:div class="card-body">
						<h:p class="m-b-0">
							Las consultas o vistas que diseñe en este modulo, se utilizaran como criterios de busqueda para las pantallas de su aplicacion, tambien podrá utilizarla para prestentar informacion por pantalla que no podrá ser editada.
						</h:p>
						<html>
							<p style="color:#ed4845">
								${labels.MddMentity.text2}
							</p>
						</html>
					</h:div>
				</h:div>
			</h:div>
		</div>
	</idspace>
	
	</div>
	
</zk>