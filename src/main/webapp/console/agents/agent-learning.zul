<?page title="Agent Learning & Evolution" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.agent.AgentLearningVM')">
        
        <!-- Learning Overview -->
        <hlayout sclass="learning-header">
            <div sclass="metric-box">
                <label value="Learning Progress"/>
                <label value="@load(vm.learningProgress)%" 
                       sclass="@load(vm.learningProgressStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Model Iterations"/>
                <label value="@load(vm.modelIterations)"/>
            </div>
            <div sclass="metric-box">
                <label value="Adaptation Score"/>
                <label value="@load(vm.adaptationScore)"/>
            </div>
            <div sclass="metric-box">
                <label value="Knowledge Base Size"/>
                <label value="@load(vm.knowledgeBaseSize)"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Learning Progress"/>
                <tab label="Model Evolution"/>
                <tab label="Knowledge Management"/>
                <tab label="Adaptation Metrics"/>
            </tabs>
            <tabpanels>
                <!-- Learning Progress Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Learning Sessions -->
                        <grid model="@load(vm.learningSessions)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Session ID"/>
                                <column label="Agent"/>
                                <column label="Learning Type"/>
                                <column label="Start Time"/>
                                <column label="Duration"/>
                                <column label="Progress"/>
                                <column label="Performance Gain"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="session">
                                <row>
                                    <label value="@load(session.id)"/>
                                    <label value="@load(session.agentName)"/>
                                    <label value="@load(session.learningType)"/>
                                    <label value="@load(session.startTime)"/>
                                    <label value="@load(session.duration)"/>
                                    <progressmeter value="@load(session.progress)"/>
                                    <label value="@load(session.performanceGain)%" 
                                           sclass="@load(session.performanceStyle)"/>
                                    <hlayout>
                                        <button label="Monitor" 
                                                onClick="@command('monitorSession', session=session)"/>
                                        <button label="Adjust" 
                                                onClick="@command('adjustSession', session=session)"/>
                                        <button label="Stop" 
                                                visible="@load(session.canStop)"
                                                onClick="@command('stopSession', session=session)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Learning Analytics -->
                        <hlayout>
                            <charts id="learningProgressChart" 
                                   type="line"
                                   height="300px"
                                   title="Learning Progress Over Time"
                                   model="@load(vm.learningProgressData)"/>
                            
                            <charts id="performanceGainChart" 
                                   type="bar"
                                   height="300px"
                                   title="Performance Gains by Category"
                                   model="@load(vm.performanceGainData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Model Evolution Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Model Versions -->
                        <listbox model="@load(vm.modelVersions)" 
                                mold="paging" pageSize="10">
                            <listhead>
                                <listheader label="Version"/>
                                <listheader label="Release Date"/>
                                <listheader label="Changes"/>
                                <listheader label="Performance"/>
                                <listheader label="Stability"/>
                                <listheader label="Status"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="version">
                                <listitem>
                                    <listcell label="@load(version.versionNumber)"/>
                                    <listcell label="@load(version.releaseDate)"/>
                                    <listcell>
                                        <html content="@load(version.changesSummary)"/>
                                    </listcell>
                                    <listcell>
                                        <label value="@load(version.performance)%" 
                                               sclass="@load(version.performanceStyle)"/>
                                    </listcell>
                                    <listcell>
                                        <label value="@load(version.stability)%" 
                                               sclass="@load(version.stabilityStyle)"/>
                                    </listcell>
                                    <listcell>
                                        <label value="@load(version.status)" 
                                               sclass="@load(version.statusStyle)"/>
                                    </listcell>
                                    <listcell>
                                        <button label="Compare" 
                                                onClick="@command('compareVersions', version=version)"/>
                                        <button label="Rollback" 
                                                onClick="@command('rollbackVersion', version=version)"/>
                                        <button label="Deploy" 
                                                onClick="@command('deployVersion', version=version)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>

                        <!-- Evolution Analytics -->
                        <hlayout>
                            <charts id="modelEvolutionChart" 
                                   type="line"
                                   height="300px"
                                   title="Model Evolution Trends"
                                   model="@load(vm.modelEvolutionData)"/>
                            
                            <charts id="stabilityTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Stability Trends"
                                   model="@load(vm.stabilityTrendsData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Knowledge Management Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Knowledge Base -->
                        <grid model="@load(vm.knowledgeBase)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Topic"/>
                                <column label="Source"/>
                                <column label="Last Updated"/>
                                <column label="Confidence"/>
                                <column label="Usage Count"/>
                                <column label="Quality Score"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="knowledge">
                                <row>
                                    <label value="@load(knowledge.topic)"/>
                                    <label value="@load(knowledge.source)"/>
                                    <label value="@load(knowledge.lastUpdated)"/>
                                    <progressmeter value="@load(knowledge.confidence)"/>
                                    <label value="@load(knowledge.usageCount)"/>
                                    <label value="@load(knowledge.qualityScore)%" 
                                           sclass="@load(knowledge.qualityStyle)"/>
                                    <hlayout>
                                        <button label="Update" 
                                                onClick="@command('updateKnowledge', knowledge=knowledge)"/>
                                        <button label="Validate" 
                                                onClick="@command('validateKnowledge', knowledge=knowledge)"/>
                                        <button label="Archive" 
                                                onClick="@command('archiveKnowledge', knowledge=knowledge)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Knowledge Analytics -->
                        <hlayout>
                            <charts id="knowledgeGrowthChart" 
                                   type="line"
                                   height="300px"
                                   title="Knowledge Base Growth"
                                   model="@load(vm.knowledgeGrowthData)"/>
                            
                            <charts id="knowledgeQualityChart" 
                                   type="radar"
                                   height="300px"
                                   title="Knowledge Quality Matrix"
                                   model="@load(vm.knowledgeQualityData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Adaptation Metrics Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Adaptation Overview -->
                        <hlayout>
                            <div sclass="metric-box" width="25%">
                                <label value="Adaptation Rate"/>
                                <label value="@load(vm.adaptationRate)%"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Learning Efficiency"/>
                                <label value="@load(vm.learningEfficiency)%"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Knowledge Retention"/>
                                <label value="@load(vm.knowledgeRetention)%"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Innovation Score"/>
                                <label value="@load(vm.innovationScore)"/>
                            </div>
                        </hlayout>

                        <!-- Adaptation Analytics -->
                        <hlayout>
                            <charts id="adaptationTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Adaptation Trends"
                                   model="@load(vm.adaptationTrendsData)"/>
                            
                            <charts id="learningEfficiencyChart" 
                                   type="bubble"
                                   height="300px"
                                   title="Learning Efficiency Matrix"
                                   model="@load(vm.learningEfficiencyData)"/>
                        </hlayout>

                        <!-- Detailed Metrics -->
                        <grid model="@load(vm.adaptationMetrics)">
                            <columns>
                                <column label="Metric"/>
                                <column label="Current Value"/>
                                <column label="Target"/>
                                <column label="Trend"/>
                                <column label="Impact"/>
                            </columns>
                            <template name="model" var="metric">
                                <row>
                                    <label value="@load(metric.name)"/>
                                    <label value="@load(metric.currentValue)"/>
                                    <label value="@load(metric.target)"/>
                                    <label value="@load(metric.trend)" 
                                           sclass="@load(metric.trendStyle)"/>
                                    <label value="@load(metric.impact)" 
                                           sclass="@load(metric.impactStyle)"/>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="sessionMonitorWindow" 
                title="Learning Session Monitor" 
                visible="false" 
                mode="modal"
                width="90%"
                height="80%">
            <!-- Session Monitor Content -->
        </window>

        <window id="versionCompareWindow" 
                title="Version Comparison" 
                visible="false" 
                mode="modal"
                width="90%"
                height="80%">
            <!-- Version Comparison Content -->
        </window>

        <window id="knowledgeEditorWindow" 
                title="Knowledge Editor" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Knowledge Editor Content -->
        </window>
    </div>
</zk>