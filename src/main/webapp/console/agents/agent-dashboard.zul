<?page title="Agent Control Panel" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.agent.AgentDashboardVM')">
        
        <!-- Agent Overview -->
        <hlayout sclass="agent-header">
            <div sclass="metric-box">
                <label value="Active Agents"/>
                <label value="@load(vm.activeAgents)"/>
            </div>
            <div sclass="metric-box">
                <label value="Success Rate"/>
                <label value="@load(vm.successRate)%" 
                       sclass="@load(vm.successRateStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Tasks Completed"/>
                <label value="@load(vm.tasksCompleted)"/>
            </div>
            <div sclass="metric-box">
                <label value="Average Response Time"/>
                <label value="@load(vm.avgResponseTime)ms"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Agent Control"/>
                <tab label="Agent Configuration"/>
                <tab label="Task Management"/>
                <tab label="Performance Metrics"/>
            </tabs>
            <tabpanels>
                <!-- Agent Control Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Agent Status Grid -->
                        <grid model="@load(vm.agents)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Agent Name"/>
                                <column label="Type"/>
                                <column label="Status"/>
                                <column label="Current Task"/>
                                <column label="Load"/>
                                <column label="Health"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="agent">
                                <row>
                                    <label value="@load(agent.name)"/>
                                    <label value="@load(agent.type)"/>
                                    <label value="@load(agent.status)" 
                                           sclass="@load(agent.statusStyle)"/>
                                    <label value="@load(agent.currentTask)"/>
                                    <progressmeter value="@load(agent.load)"/>
                                    <label value="@load(agent.health)%" 
                                           sclass="@load(agent.healthStyle)"/>
                                    <hlayout>
                                        <button label="Start" 
                                                visible="@load(agent.canStart)"
                                                onClick="@command('startAgent', agent=agent)"/>
                                        <button label="Stop" 
                                                visible="@load(agent.canStop)"
                                                onClick="@command('stopAgent', agent=agent)"/>
                                        <button label="Configure" 
                                                onClick="@command('configureAgent', agent=agent)"/>
                                        <button label="Logs" 
                                                onClick="@command('viewAgentLogs', agent=agent)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Agent Performance Charts -->
                        <hlayout>
                            <charts id="agentLoadChart" 
                                   type="line"
                                   height="300px"
                                   title="Agent Load Distribution"
                                   model="@load(vm.agentLoadData)"/>
                            
                            <charts id="agentHealthChart" 
                                   type="pie"
                                   height="300px"
                                   title="Agent Health Status"
                                   model="@load(vm.agentHealthData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Agent Configuration Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Agent Type Selection -->
                        <hlayout>
                            <combobox model="@load(vm.agentTypes)" 
                                     selectedItem="@bind(vm.selectedAgentType)"
                                     onChange="@command('loadAgentTemplate')"/>
                            <button label="Create New Agent" 
                                    onClick="@command('createNewAgent')"/>
                            <button label="Import Configuration" 
                                    onClick="@command('importConfig')"/>
                        </hlayout>

                        <!-- Agent Configuration Grid -->
                        <grid model="@load(vm.agentConfigurations)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Configuration Name"/>
                                <column label="Agent Type"/>
                                <column label="Capabilities"/>
                                <column label="Models"/>
                                <column label="Last Modified"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="config">
                                <row>
                                    <label value="@load(config.name)"/>
                                    <label value="@load(config.type)"/>
                                    <label value="@load(config.capabilities)"/>
                                    <label value="@load(config.models)"/>
                                    <label value="@load(config.lastModified)"/>
                                    <label value="@load(config.status)" 
                                           sclass="@load(config.statusStyle)"/>
                                    <hlayout>
                                        <button label="Edit" 
                                                onClick="@command('editConfig', config=config)"/>
                                        <button label="Clone" 
                                                onClick="@command('cloneConfig', config=config)"/>
                                        <button label="Deploy" 
                                                onClick="@command('deployConfig', config=config)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Task Management Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Task Queue -->
                        <groupbox title="Task Queue">
                            <listbox model="@load(vm.agentTasks)" 
                                    mold="paging" pageSize="10">
                                <listhead>
                                    <listheader label="Task ID"/>
                                    <listheader label="Type"/>
                                    <listheader label="Priority"/>
                                    <listheader label="Assigned Agent"/>
                                    <listheader label="Status"/>
                                    <listheader label="Progress"/>
                                    <listheader label="Actions"/>
                                </listhead>
                                <template name="model" var="task">
                                    <listitem>
                                        <listcell label="@load(task.id)"/>
                                        <listcell label="@load(task.type)"/>
                                        <listcell>
                                            <label value="@load(task.priority)" 
                                                   sclass="@load(task.priorityStyle)"/>
                                        </listcell>
                                        <listcell label="@load(task.assignedAgent)"/>
                                        <listcell>
                                            <label value="@load(task.status)" 
                                                   sclass="@load(task.statusStyle)"/>
                                        </listcell>
                                        <listcell>
                                            <progressmeter value="@load(task.progress)"/>
                                        </listcell>
                                        <listcell>
                                            <button label="Details" 
                                                    onClick="@command('viewTaskDetails', task=task)"/>
                                            <button label="Reassign" 
                                                    onClick="@command('reassignTask', task=task)"/>
                                            <button label="Cancel" 
                                                    onClick="@command('cancelTask', task=task)"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>

                        <!-- Task Distribution Charts -->
                        <hlayout>
                            <charts id="taskDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="Task Distribution by Type"
                                   model="@load(vm.taskDistributionData)"/>
                            
                            <charts id="taskCompletionChart" 
                                   type="line"
                                   height="300px"
                                   title="Task Completion Trends"
                                   model="@load(vm.taskCompletionData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Performance Metrics Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Performance Overview -->
                        <hlayout>
                            <div sclass="metric-box" width="25%">
                                <label value="Average Response Time"/>
                                <label value="@load(vm.avgResponseTime)ms"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Task Success Rate"/>
                                <label value="@load(vm.taskSuccessRate)%"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Resource Utilization"/>
                                <label value="@load(vm.resourceUtilization)%"/>
                            </div>
                            <div sclass="metric-box" width="25%">
                                <label value="Error Rate"/>
                                <label value="@load(vm.errorRate)%"/>
                            </div>
                        </hlayout>

                        <!-- Performance Charts -->
                        <hlayout>
                            <charts id="performanceTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Performance Trends"
                                   model="@load(vm.performanceTrendsData)"/>
                            
                            <charts id="errorDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="Error Distribution"
                                   model="@load(vm.errorDistributionData)"/>
                        </hlayout>

                        <!-- Detailed Metrics -->
                        <grid model="@load(vm.detailedMetrics)">
                            <columns>
                                <column label="Metric"/>
                                <column label="Value"/>
                                <column label="Threshold"/>
                                <column label="Status"/>
                                <column label="Trend"/>
                            </columns>
                            <template name="model" var="metric">
                                <row>
                                    <label value="@load(metric.name)"/>
                                    <label value="@load(metric.value)"/>
                                    <label value="@load(metric.threshold)"/>
                                    <label value="@load(metric.status)" 
                                           sclass="@load(metric.statusStyle)"/>
                                    <label value="@load(metric.trend)" 
                                           sclass="@load(metric.trendStyle)"/>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="agentConfigWindow" 
                title="Agent Configuration" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Agent Configuration Content -->
        </window>

        <window id="taskDetailsWindow" 
                title="Task Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Task Details Content -->
        </window>
    </div>
</zk>