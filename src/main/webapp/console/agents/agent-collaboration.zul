<?page title="Agent Collaboration" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
	<div self="@define(content)"
		viewModel="@id('vm') @init('org.suinsit.apps.agent.AgentCollaborationVM')">

		<!-- Collaboration Overview -->
		<hlayout sclass="collaboration-header">
			<div sclass="metric-box">
				<label value="Active Teams" />
				<label value="@load(vm.activeTeams)" />
			</div>
			<div sclass="metric-box">
				<label value="Collaborative Tasks" />
				<label value="@load(vm.collaborativeTasks)" />
			</div>
			<div sclass="metric-box">
				<label value="Team Efficiency" />
				<label value="@load(vm.teamEfficiency)%"
					sclass="@load(vm.teamEfficiencyStyle)" />
			</div>
			<div sclass="metric-box">
				<label value="Synergy Score" />
				<label value="@load(vm.synergyScore)" />
			</div>
		</hlayout>

		<tabbox>
			<tabs>
				<tab label="Team Management" />
				<tab label="Task Coordination" />
				<tab label="Communication Hub" />
				<tab label="Performance Analytics" />
			</tabs>
			<tabpanels>
				<!-- Team Management Panel -->
				<tabpanel>
					<vlayout>
						<!-- Team Creation and Management -->
						<hlayout>
							<button label="Create Team"
								onClick="@command('createTeam')" />
							<button label="Import Team Template"
								onClick="@command('importTeamTemplate')" />
						</hlayout>

						<!-- Teams Grid -->
						<grid model="@load(vm.agentTeams)" mold="paging"
							pageSize="10">
							<columns>
								<column label="Team Name" />
								<column label="Members" />
								<column label="Specialization" />
								<column label="Active Tasks" />
								<column label="Performance" />
								<column label="Status" />
								<column label="Actions" />
							</columns>
							<template name="model" var="team">
								<row>
									<label value="@load(team.name)" />
									<label
										value="@load(team.memberCount)" />
									<label
										value="@load(team.specialization)" />
									<label
										value="@load(team.activeTasks)" />
									<progressmeter
										value="@load(team.performance)" />
									<label value="@load(team.status)"
										sclass="@load(team.statusStyle)" />
									<hlayout>
										<button label="Manage"
											onClick="@command('manageTeam', team=team)" />
										<button label="Optimize"
											onClick="@command('optimizeTeam', team=team)" />
										<button label="Dissolve"
											onClick="@command('dissolveTeam', team=team)" />
									</hlayout>
								</row>
							</template>
						</grid>

						<!-- Team Analytics -->
						<hlayout>
							<charts id="teamPerformanceChart"
								type="line" height="300px" title="Team Performance Trends"
								model="@load(vm.teamPerformanceData)" />

							<charts id="teamCompositionChart" type="pie"
								height="300px" title="Team Composition Analysis"
								model="@load(vm.teamCompositionData)" />
						</hlayout>
					</vlayout>
				</tabpanel>

				<!-- Task Coordination Panel -->
				<tabpanel>
					<vlayout>
						<!-- Task Assignment -->
						<groupbox title="Collaborative Tasks">
							<listbox
								model="@load(vm.collaborativeTaskList)" mold="paging"
								pageSize="10">
								<listhead>
									<listheader label="Task ID" />
									<listheader label="Description" />
									<listheader label="Assigned Team" />
									<listheader label="Required Skills" />
									<listheader label="Progress" />
									<listheader
										label="Coordination Level" />
									<listheader label="Actions" />
								</listhead>
								<template name="model" var="task">
									<listitem>
										<listcell
											label="@load(task.id)" />
										<listcell
											label="@load(task.description)" />
										<listcell
											label="@load(task.teamName)" />
										<listcell
											label="@load(task.requiredSkills)" />
										<listcell>
											<progressmeter
												value="@load(task.progress)" />
										</listcell>
										<listcell>
											<label
												value="@load(task.coordinationLevel)"
												sclass="@load(task.coordinationStyle)" />
										</listcell>
										<listcell>
											<button label="View Details"
												onClick="@command('viewTaskDetails', task=task)" />
											<button label="Reassign"
												onClick="@command('reassignTask', task=task)" />
											<button label="Optimize"
												onClick="@command('optimizeTaskAllocation', task=task)" />
										</listcell>
									</listitem>
								</template>
							</listbox>
						</groupbox>

						<!-- Task Coordination Analytics -->
						<hlayout>
							<charts id="taskDistributionChart"
								type="bar" height="300px" title="Task Distribution by Team"
								model="@load(vm.taskDistributionData)" />

							<charts id="coordinationEfficiencyChart"
								type="line" height="300px" title="Coordination Efficiency"
								model="@load(vm.coordinationEfficiencyData)" />
							
							<charts id="synergyMatrixChart"
								type="column" height="300px" title="Team Synergy Matrix"
								model="@load(vm.synergyMatrixData)" />
						</hlayout>
					</vlayout>
				</tabpanel>

				<!-- Communication Hub Panel -->
				<tabpanel>
					<vlayout>
						<!-- Communication Channels -->
						<grid model="@load(vm.communicationChannels)"
							mold="paging" pageSize="10">
							<columns>
								<column label="Channel Name" />
								<column label="Type" />
								<column label="Connected Teams" />
								<column label="Message Volume" />
								<column label="Response Time" />
								<column label="Status" />
								<column label="Actions" />
							</columns>
							<template name="model" var="channel">
								<row>
									<label value="@load(channel.name)" />
									<label value="@load(channel.type)" />
									<label
										value="@load(channel.connectedTeams)" />
									<label
										value="@load(channel.messageVolume)" />
									<label
										value="@load(channel.responseTime)ms" />
									<label value="@load(channel.status)"
										sclass="@load(channel.statusStyle)" />
									<hlayout>
										<button label="Monitor"
											onClick="@command('monitorChannel', channel=channel)" />
										<button label="Configure"
											onClick="@command('configureChannel', channel=channel)" />
										<button label="Archive"
											onClick="@command('archiveChannel', channel=channel)" />
									</hlayout>
								</row>
							</template>
						</grid>

						<!-- Communication Analytics -->
						<hlayout>
							<charts id="communicationVolumeChart"
								type="line" height="300px" title="Communication Volume Trends"
								model="@load(vm.communicationVolumeData)" />

							<charts id="responseTimeChart" type="line"
								height="300px" title="Response Time Analysis"
								model="@load(vm.responseTimeData)" />
						</hlayout>
					</vlayout>
				</tabpanel>

				<!-- Performance Analytics Panel -->
				<tabpanel>
					<vlayout>
						<!-- Performance Metrics -->
						<hlayout>
							<div sclass="metric-box" width="25%">
								<label value="Collaboration Score" />
								<label
									value="@load(vm.collaborationScore)%" />
							</div>
							<div sclass="metric-box" width="25%">
								<label value="Task Completion Rate" />
								<label
									value="@load(vm.taskCompletionRate)%" />
							</div>
							<div sclass="metric-box" width="25%">
								<label value="Resource Utilization" />
								<label
									value="@load(vm.resourceUtilization)%" />
							</div>
							<div sclass="metric-box" width="25%">
								<label value="Team Synergy" />
								<label value="@load(vm.teamSynergy)" />
							</div>
						</hlayout>

						<!-- Performance Charts -->
						<hlayout>
							<charts id="performanceTrendsChart"
								type="line" height="300px" title="Overall Performance Trends"
								model="@load(vm.performanceTrendsData)" />

							
						</hlayout>

						<!-- Detailed Metrics -->
						<grid model="@load(vm.performanceMetrics)">
							<columns>
								<column label="Metric" />
								<column label="Value" />
								<column label="Target" />
								<column label="Trend" />
								<column label="Analysis" />
							</columns>
							<template name="model" var="metric">
								<row>
									<label value="@load(metric.name)" />
									<label value="@load(metric.value)" />
									<label value="@load(metric.target)" />
									<label value="@load(metric.trend)"
										sclass="@load(metric.trendStyle)" />
									<label
										value="@load(metric.analysis)" />
								</row>
							</template>
						</grid>
					</vlayout>
				</tabpanel>
			</tabpanels>
		</tabbox>

		<!-- Modal Windows -->
		<window id="teamManagementWindow" title="Team Management"
			visible="false" mode="modal" width="80%" height="80%">
			<!-- Team Management Content -->
		</window>

		<window id="taskDetailsWindow" title="Task Details"
			visible="false" mode="modal" width="800px">
			<!-- Task Details Content -->
		</window>

		<window id="channelConfigWindow" title="Channel Configuration"
			visible="false" mode="modal" width="600px">
			<!-- Channel Configuration Content -->
		</window>
	</div>
</zk>