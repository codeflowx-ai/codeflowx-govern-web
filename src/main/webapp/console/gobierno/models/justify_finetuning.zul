<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd">
    <idspace viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.models.JustifyFineTuningViewModel')">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">Justificación Fine-Tuning (Restrictivo)</h3>
            </div>
            <div class="card-body">
                <grid sclass="grid-form">
                    <rows>
                        <row>
                            <label value="Justificación" />
                            <textarea value="@bind(vm.justification)" rows="6"
                                placeholder="Explica por qué un adapter no es suficiente..." />
                        </row>
                        <row>
                            <label value="Motivos adicionales" />
                            <hlayout spacing="8px">
                                <checkbox label="Cambio arquitectura" checked="@bind(vm.architectureChange)" />
                                <checkbox label="Performance crítico" checked="@bind(vm.performanceCritical)" />
                                <checkbox label="Preocupación CO2" checked="@bind(vm.co2Concern)" />
                            </hlayout>
                        </row>
                    </rows>
                </grid>
                <div class="mt-3 d-flex gap-2">
                    <button label="Enviar" sclass="btn btn-primary" onClick="@command('submitJustification')" />
                </div>
            </div>
        </div>
    </idspace>
</zk>

