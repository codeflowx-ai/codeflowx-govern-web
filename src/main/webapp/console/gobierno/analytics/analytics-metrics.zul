<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="native"
    xmlns:x="xhtml">
    
    <div viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.analytics.AnalyticsMetricViewModel')">
        
        <h:div class="container-fluid p-4">
            
            <!-- Header -->
            <h:div class="row mb-4">
                <h:div class="col-12 col-md-6">
                    <h:h1 class="h2 fw-bold mb-1">
                        <h:i class="bi bi-graph-up me-2"></h:i>
                        <label value="${labels.analytics.metrics.title}" />
                    </h:h1>
                    <h:p class="text-muted mb-0">${labels.analytics.metrics.subtitle}</h:p>
                </h:div>
                <h:div class="col-12 col-md-6 text-end">
                    <button class="btn btn-primary" onClick="@command('newMetric')">
                        <h:i class="bi bi-plus-circle me-2"></h:i>
                        <label value="${labels.analytics.metrics.create}" />
                    </button>
                </h:div>
            </h:div>
            
            <!-- Búsqueda y Filtros -->
            <h:div class="row mb-3">
                <h:div class="col-12 col-md-6">
                    <h:div class="input-group">
                        <h:span class="input-group-text"><h:i class="bi bi-search"></h:i></h:span>
                        <textbox class="form-control" placeholder="${labels.analytics.metrics.search}..." 
                                 value="@bind(vm.searchTerm)" 
                                 onOK="@command('search')"/>
                        <button class="btn btn-outline-secondary" onClick="@command('search')">
                            ${labels.common.search}
                        </button>
                    </h:div>
                </h:div>
                <h:div class="col-12 col-md-3">
                    <h:select class="form-select" value="@bind(vm.filterType)" onChange="@command('search')">
                        <h:option value="all">${labels.common.allTypes}</h:option>
                        <h:option value="performance">Performance</h:option>
                        <h:option value="usage">Usage</h:option>
                        <h:option value="error">Error</h:option>
                        <h:option value="latency">Latency</h:option>
                    </h:select>
                </h:div>
                <h:div class="col-12 col-md-3">
                    <h:select class="form-select" value="@bind(vm.filterStatus)" onChange="@command('search')">
                        <h:option value="all">${labels.common.allStatus}</h:option>
                        <h:option value="active">Active</h:option>
                        <h:option value="warning">Warning</h:option>
                        <h:option value="critical">Critical</h:option>
                    </h:select>
                </h:div>
            </h:div>
            
            <!-- Botones de acción -->
            <h:div class="row mb-3">
                <h:div class="col-12 text-end">
                    <button class="btn btn-outline-secondary me-2" onClick="@command('clearSearch')">
                        <h:i class="bi bi-x-circle me-2"></h:i>
                        <label value="${labels.common.clear}" />
                    </button>
                    <button class="btn btn-outline-secondary" onClick="@command('refresh')">
                        <h:i class="bi bi-arrow-clockwise me-2"></h:i>
                        <label value="${labels.common.refresh}" />
                    </button>
                </h:div>
            </h:div>
            
            <!-- Tabla -->
            <h:div class="row">
                <h:div class="col-12">
                    <h:div class="card border-0 shadow-sm">
                        <h:div class="card-body p-0">
                            <h:div class="table-responsive">
                                <h:table class="table table-hover mb-0">
                                    <h:thead class="table-light">
                                        <h:tr>
                                            <h:th>${labels.analytics.metrics.name}</h:th>
                                            <h:th>${labels.analytics.metrics.type}</h:th>
                                            <h:th class="text-end">${labels.analytics.metrics.value}</h:th>
                                            <h:th class="text-center">${labels.analytics.metrics.thresholds}</h:th>
                                            <h:th class="text-center">${labels.common.status}</h:th>
                                            <h:th class="text-end">${labels.common.actions}</h:th>
                                        </h:tr>
                                    </h:thead>
                                    <h:tbody>
                                        <forEach items="@load(vm.pageResult.content)" var="metric">
                                            <h:tr>
                                                <h:td>
                                                    <label value="@load(metric.anlmetricname)" class="fw-bold"/>
                                                </h:td>
                                                <h:td>
                                                    <h:span class="badge bg-secondary">
                                                        <label value="@load(metric.anlmetrictype)"/>
                                                    </h:span>
                                                </h:td>
                                                <h:td class="text-end">
                                                    <label value="@load(metric.anlmetricvalue)"/>
                                                    <h:small class="text-muted ms-1">
                                                        <label value="@load(metric.anlmetricunit)"/>
                                                    </h:small>
                                                </h:td>
                                                <h:td class="text-center">
                                                    <h:small class="text-muted">
                                                        <label value="@load(metric.anlthresholdmin)"/> - 
                                                        <label value="@load(metric.anlthresholdmax)"/>
                                                    </h:small>
                                                </h:td>
                                                <h:td class="text-center">
                                                    <h:span class="@load(c:cat('badge bg-', vm.getMetricStatusBadge(metric.anlstatus)))">
                                                        <label value="@load(metric.anlstatus)"/>
                                                    </h:span>
                                                </h:td>
                                                <h:td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary me-1" 
                                                            onClick="@command('editMetric', item=metric)">
                                                        <h:i class="bi bi-pencil"></h:i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            onClick="@command('deleteMetric', item=metric)">
                                                        <h:i class="bi bi-trash"></h:i>
                                                    </button>
                                                </h:td>
                                            </h:tr>
                                        </forEach>
                                    </h:tbody>
                                </h:table>
                            </h:div>
                        </h:div>
                        
                        <!-- Paginación -->
                        <h:div class="card-footer bg-light">
                            <h:div class="d-flex justify-content-between align-items-center">
                                <h:div>
                                    <h:small class="text-muted">
                                        ${labels.common.page} <label value="@load(vm.pageParams.pageActual)"/> 
                                        ${labels.common.of} <label value="@load(vm.pageResult.totalPages)"/> 
                                        (<label value="@load(vm.pageResult.totalRows)"/> ${labels.common.records})
                                    </h:small>
                                </h:div>
                                <h:div>
                                    <button class="btn btn-sm btn-outline-secondary me-2"
                                            onClick="@command('previousPage')"
                                            disabled="@load(vm.pageParams.pageActual eq 1)">
                                        <h:i class="bi bi-chevron-left"></h:i>
                        <label value="${labels.common.previous}" />
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            onClick="@command('nextPage')"
                                            disabled="@load(vm.pageResult.nextRow eq 0)">
                                        ${labels.common.next} <h:i class="bi bi-chevron-right"></h:i>
                                    </button>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
            </h:div>
            
        </h:div>
    </div>
    
    <!-- Modal de Edición -->
    <window visible="@load(vm.showDialog)" mode="modal" 
            border="normal" width="700px" closable="true"
            onClose="@command('cancelEdit')">
        <h:div class="p-4">
            <h:h5 class="mb-4">
                <label value="@load(vm.isEditing ? labels.analytics.metrics.edit : labels.analytics.metrics.create)"/>
            </h:h5>
            
            <h:div class="row">
                <h:div class="col-12 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.name} *</h:label>
                    <textbox class="form-control" 
                             value="@bind(vm.selectedMetric.anlmetricname)"
                             placeholder="${labels.analytics.metrics.name.placeholder}"/>
                </h:div>
                
                <h:div class="col-12 col-md-6 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.type} *</h:label>
                    <textbox class="form-control" 
                             value="@bind(vm.selectedMetric.anlmetrictype)"
                             placeholder="performance, usage, error..."/>
                </h:div>
                
                <h:div class="col-12 col-md-6 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.status} *</h:label>
                    <textbox class="form-control" 
                             value="@bind(vm.selectedMetric.anlstatus)"
                             placeholder="active, warning, critical..."/>
                </h:div>
                
                <h:div class="col-12 col-md-4 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.value} *</h:label>
                    <decimalbox class="form-control" 
                               value="@bind(vm.selectedMetric.anlmetricvalue)"
                               format="#,##0.00"/>
                </h:div>
                
                <h:div class="col-12 col-md-8 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.unit}</h:label>
                    <textbox class="form-control" 
                             value="@bind(vm.selectedMetric.anlmetricunit)"
                             placeholder="ms, %, requests/s..."/>
                </h:div>
                
                <h:div class="col-12 col-md-6 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.thresholdMin}</h:label>
                    <decimalbox class="form-control" 
                               value="@bind(vm.selectedMetric.anlthresholdmin)"
                               format="#,##0.00"/>
                </h:div>
                
                <h:div class="col-12 col-md-6 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.thresholdMax}</h:label>
                    <decimalbox class="form-control" 
                               value="@bind(vm.selectedMetric.anlthresholdmax)"
                               format="#,##0.00"/>
                </h:div>
                
                <h:div class="col-12 mb-3">
                    <h:label class="form-label">${labels.analytics.metrics.context}</h:label>
                    <textbox class="form-control" rows="3" 
                             value="@bind(vm.selectedMetric.anlcontext)"
                             placeholder='{"key": "value"}'/>
                </h:div>
            </h:div>
            
            <h:div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-secondary" onClick="@command('cancelEdit')">
                    ${labels.common.cancel}
                </button>
                <button class="btn btn-primary" onClick="@command('saveMetric')">
                    <h:i class="bi bi-check-circle me-2"></h:i>
                        <label value="${labels.common.save}" />
                </button>
            </h:div>
        </h:div>
    </window>
</zk>

