<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    <!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
    <idspace
        viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.training.CheckpointOverviewViewModel')"
        validationMessages="@id('vmsgs')">

        <div class="row" style="background-color:;">
            <div><!-- Titulo pantalla -->
                <div class="left tittle-principal">
                    <h:h2 class="mb-sm-0">
                        <h:i class="fa-sharp-duotone fa-solid fa-graduation-cap me-2"></h:i>
                        <label value="Gestión de Checkpoint" />
                    </h:h2>
                    <h:p class="text-muted">
                        <label value="Listado y búsqueda de training" />
                    </h:p>
                </div>
            </div>
            
            <div class="col-lg-12 s-bot">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="flex-grow-1">
                            </div>
                            <div class="flex-shrink-0">
                                <div class="hstack text-nowrap gap-2 d-flex">
                                    <a iconSclass="fa-duotone fa-solid fa-plus label-icon align-middle fs-16 me-2" class="waves-effect waves-light" onClick="@command('registerCheckpoint')" label="Nuevo Checkpoint">
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="section filters">
                <div class="search-bar">
                    <!-- Búsqueda por texto -->
                    <textbox value="@bind(vm.searchTerm)"
                        placeholder="Buscar..."
                        class="form-control" onOK="@command('applyFilters')" />
                    

                    
                </div>
                <div class="filter-icons">
                    <a tooltiptext="Buscar"
                        iconSclass="fa-duotone fa-magnifying-glass-waveform"
                        onClick="@command('applyFilters')" />
                    <a tooltiptext="Limpiar"
                        iconSclass="fa-duotone fa-broom-wide"
                        onClick="@command('clearFilters')" />
                </div>
            </div>
            
            <div class="col-xxl-12 s-bot">
                <div class="card">
                    <div class="card-body">
                        <div id="divTemplate" sclass="col-lg-12">
                            <!-- listado -->
                            <grid model="@load(vm.filteredCheckpoints)" style="overflow:auto;">
                                <columns sizable="true" columnsgroup="false" columnshide="false">
                                    <column
                                        label="I D X C H E C K P O I N T" align="center"
                                        width="15%" />
                                    <column
                                        label="C H E C K P O I N T N A M E" align="center"
                                        width="20%" />
                                    <column
                                        label="E P O C H" align="center"
                                        width="20%" />
                                    <column
                                        label="S T E P" align="center"
                                        width="20%" />
                                    <column
                                        label="C H E C K P O I N T T Y P E" align="center"
                                        width="20%" />
                                    <column
                                        label="P A T H" align="center"
                                        width="20%" />
                                    <column
                                        label="F I L E S I Z E" align="center"
                                        width="20%" />
                                    <column
                                        label="S T O R A G E L O C A T I O N" align="center"
                                        width="20%" />
                                    <column
                                        label="Acciones"
                                        align="center" />
                                </columns>

                                <template name="model" var="training">
                                    <row style="text-align:right;cursor:pointer;"
                                        onClick="@command('viewCheckpointDetails', trainingId=training.idxcheckpoint)">
                                        <label
                                            value="@load(training.idxcheckpoint) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(training.trncheckpointname) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(training.trnepoch) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(training.trnstep) @converter(vm.fieldConverter)">
                                        </label>
                                        <h:span class="badge bg-secondary">
                                            <label value="@load(training.trncheckpointtype)" />
                                        </h:span>
                                        <label
                                            value="@load(training.trnpath) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(training.trnfilesize) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(training.trnstoragelocation) @converter(vm.fieldConverter)">
                                        </label>
                                        <cell align="center" class="d-flex">
                                            <div class="edit">
                                                <a
                                                    onClick="@command('viewCheckpointDetails', trainingId=training.idxcheckpoint)"
                                                    iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
                                                    sclass="waves-effect waves-success"
                                                    tooltiptext="Ver detalles" />
                                            </div>
                                            <div class="delete">
                                                <a
                                                    onClick="@command('deleteCheckpoint', trainingId=training.idxcheckpoint)"
                                                    iconSclass="fa-light fa-nfc-trash fa-xl"
                                                    sclass="waves-effect waves-danger"
                                                    tooltiptext="Eliminar" />
                                            </div>
                                        </cell>
                                    </row>
                                </template>
                                
                                <foot>
                                    <footer span="3" align="right">
                                        <paging id="topagin"
                                            pageSize="@load(vm.pageParams.maxRows)" 
                                            totalSize="@load(vm.pageResult.totalRows)"
                                            activePage="@load(vm.pageParams.pageActual - 1)"
                                            onPaging="@command('onPaging', event=event)"
                                            mold="os" width="100%" />
                                    </footer>
                                    <footer span="4" align="left">
                                    </footer>
                                    <footer></footer>
                                </foot>
                            </grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </idspace>
</zk>