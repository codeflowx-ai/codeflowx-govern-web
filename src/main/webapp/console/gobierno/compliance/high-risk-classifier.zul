<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.compliance.HighRiskClassifierViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-triangle-exclamation me-2"></h:i>
						High-Risk AI Systems Classifier - Annex III
					</h:h2>
					<h:p class="text-muted">
						Clasificador de sistemas de IA de alto riesgo según EU AI Act Anexo III (8 categorías, 25 subcategorías)
					</h:p>
				</div>
			</div>

			<!-- Información del Proyecto -->
			<div class="col-lg-12 s-bot">
				<div class="card border-primary">
					<div class="card-header bg-soft-primary">
						<h:h5 class="card-title mb-0">
							<h:i class="fa-duotone fa-solid fa-info-circle me-2"></h:i>
							Project Information
						</h:h5>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<h:p class="mb-2"><strong>Project:</strong> <label value="@load(vm.projectName)" /></h:p>
								<h:p class="mb-0"><strong>ID:</strong> <label value="@load(vm.projectId)" /></h:p>
							</div>
							<div class="col-md-6">
								<h:p class="mb-2"><strong>Description:</strong></h:p>
								<h:p class="mb-0 text-muted"><label value="@load(vm.projectDescription)" multiline="true" /></h:p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Sugerencia Automática IA -->
			<div class="col-lg-12 s-bot">
				<div class="card border-success">
					<div class="card-header bg-soft-success">
						<div class="d-flex align-items-center gap-2">
							<div class="flex-grow-1">
								<h:h5 class="card-title mb-0">
									<h:i class="fa-duotone fa-solid fa-robot me-2"></h:i>
									AI-Powered Classification Suggestion
								</h:h5>
							</div>
							<button
								iconSclass="fa-duotone fa-solid fa-wand-magic-sparkles"
								label="Regenerate"
								onClick="@command('suggestCategoryWithAI')"
								class="btn btn-sm btn-soft-success"
								disabled="@load(vm.loading)" />
						</div>
					</div>
					<div class="card-body">
						<div class="alert alert-success mb-0" visible="@load(vm.aiSuggestionAvailable)">
							<h:p class="mb-2">
								<h:i class="fa-duotone fa-solid fa-lightbulb me-2"></h:i>
								<strong><label value="@load(vm.aiSuggestion)" /></strong>
							</h:p>
							<button
								label="Apply Suggestion"
								onClick="@command('applySuggestion')"
								class="btn btn-sm btn-success mt-2"
								iconSclass="fa-duotone fa-solid fa-check" />
						</div>
						<div class="alert alert-info mb-0" visible="@load(not vm.aiSuggestionAvailable)">
							<h:p class="mb-0">
								<h:i class="fa-duotone fa-solid fa-info-circle me-2"></h:i>
								<label value="@load(vm.aiSuggestion)" />
							</h:p>
						</div>
					</div>
				</div>
			</div>

			<!-- Selección de Categoría Principal -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">
							<h:i class="fa-duotone fa-solid fa-layer-group me-2"></h:i>
							Step 1: Select Annex III Category *
						</h:h5>
					</div>
					<div class="card-body">
						<div class="mb-3">
							<label class="form-label">Main Category (8 categories)</label>
							<listbox
								model="@load(vm.annexIIICategories)"
								selectedItem="@bind(vm.selectedCategory)"
								onSelect="@command('onCategorySelected')"
								rows="8"
								class="w-100"
								mold="select">
								<listhead>
									<listheader label="Code" width="15%" />
									<listheader label="Category Name" width="45%" />
									<listheader label="Description" width="40%" />
								</listhead>
								<template name="model" var="category">
									<listitem value="@load(category.code)">
										<listcell>
											<h:span class="badge bg-primary">
												<label value="@load(category.code)" />
											</h:span>
										</listcell>
										<listcell>
											<label value="@load(category.name)" />
										</listcell>
										<listcell>
											<label value="@load(category.description)" style="font-size: 0.9em; color: #666;" />
										</listcell>
									</listitem>
								</template>
							</listbox>
						</div>
						
						<!-- Información de categoría seleccionada -->
						<div class="alert alert-primary mb-0" visible="@load(not empty vm.selectedCategoryData)">
							<h:p class="mb-1"><strong>Selected:</strong></h:p>
							<h:p class="mb-1">
								<h:span class="badge bg-primary me-2">
									<label value="@load(vm.selectedCategoryData.code)" />
								</h:span>
								<label value="@load(vm.selectedCategoryData.name)" />
							</h:p>
							<h:p class="mb-0 text-muted" style="font-size: 0.9em;">
								<label value="@load(vm.selectedCategoryData.description)" />
							</h:p>
						</div>
					</div>
				</div>
			</div>

			<!-- Selección de Subcategorías -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">
							<h:i class="fa-duotone fa-solid fa-list-check me-2"></h:i>
							Step 2: Select Specific Subcategories *
						</h:h5>
					</div>
					<div class="card-body">
						<div class="mb-3">
							<label class="form-label">Specific Subcategories (multiple selection allowed)</label>
							<listbox
								model="@load(vm.subcategories)"
								selectedItems="@bind(vm.selectedSubcategories)"
								rows="8"
								multiple="true"
								checkmark="true"
								class="w-100"
								emptyMessage="Select a main category first">
								<listhead>
									<listheader label="Code" width="20%" />
									<listheader label="Description" width="80%" />
								</listhead>
								<template name="model" var="subcat">
									<listitem value="@load(subcat.code)">
										<listcell>
											<h:span class="badge bg-info">
												<label value="@load(subcat.code)" />
											</h:span>
										</listcell>
										<listcell>
											<label value="@load(subcat.description)" />
										</listcell>
									</listitem>
								</template>
							</listbox>
						</div>
						
						<div class="alert alert-info mb-0" visible="@load(vm.selectedSubcategories.size() gt 0)">
							<h:p class="mb-0">
								<h:i class="fa-duotone fa-solid fa-check-circle me-2"></h:i>
								<strong><label value="@load(vm.selectedSubcategories.size())" /> subcategories selected</strong>
							</h:p>
						</div>
						
						<div class="alert alert-warning mb-0" visible="@load(vm.selectedSubcategories.size() eq 0 and not empty vm.subcategories)">
							<h:p class="mb-0">
								<h:i class="fa-duotone fa-solid fa-exclamation-triangle me-2"></h:i>
								Please select at least one subcategory
							</h:p>
						</div>
					</div>
				</div>
			</div>

			<!-- Justificación -->
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">
							<h:i class="fa-duotone fa-solid fa-pen-to-square me-2"></h:i>
							Step 3: Classification Justification * (min. 50 characters)
						</h:h5>
					</div>
					<div class="card-body">
						<div class="mb-3">
							<textbox
								value="@bind(vm.justification)"
								rows="6"
								class="form-control"
								placeholder="Explain in detail why this AI system falls into the selected high-risk category according to Annex III. Include specific information about:&#10;&#10;- The system's intended purpose&#10;- How it affects individuals or groups&#10;- Specific risks to fundamental rights&#10;- Relevant context and use cases&#10;&#10;This justification is mandatory and will be part of the official classification record."
								maxlength="2000" />
						</div>
						
						<div class="d-flex justify-content-between align-items-center">
							<h:span>
								<label value="@load(vm.justification.length())" />
								/ 2000 characters
							</h:span>
							<h:span class="text-muted">
								<label value="@load(vm.justification.length() ge 50 ? 'Valid ✓' : 'Minimum 50 characters required')" 
									style="@load(vm.justification.length() ge 50 ? 'color: green; font-weight: bold;' : 'color: orange;')" />
							</h:span>
						</div>
					</div>
				</div>
			</div>

			<!-- Botones de Acción -->
			<div class="col-lg-12 s-bot">
				<div class="card bg-soft-danger border-danger">
					<div class="card-body">
						<div class="row align-items-center">
							<div class="col-md-8">
								<h:h6 class="text-danger mb-2">
									<h:i class="fa-duotone fa-solid fa-shield-exclamation me-2"></h:i>
									<strong>Warning: High-Risk Classification</strong>
								</h:h6>
								<h:p class="mb-0 text-muted">
									Classifying this project as HIGH-RISK will trigger the full EU AI Act compliance workflow including:
									conformity assessment, FRIA, QMS documentation, and EU database registration requirements.
									This is a critical decision that cannot be easily reversed.
								</h:p>
							</div>
							<div class="col-md-4 text-end">
								<button
									iconSclass="fa-duotone fa-solid fa-times me-2"
									label="Cancel"
									onClick="@command('cancel')"
									class="btn btn-secondary me-2" />
								<button
									iconSclass="fa-duotone fa-solid fa-shield-exclamation me-2"
									label="Classify as HIGH RISK"
									onClick="@command('classifyAsHighRisk')"
									class="btn btn-danger"
									disabled="@load(vm.classifying or empty vm.selectedCategory or vm.selectedSubcategories.size() eq 0 or vm.justification.length() lt 50)" />
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</idspace>
</zk>

