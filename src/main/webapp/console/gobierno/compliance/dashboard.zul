<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

	<!-- ViewModel binding -->
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.compliance.ComplianceDashboardViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row" style="background-color:;">
			<div>
				<!-- Título pantalla -->
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-shield-check me-2"></h:i>
						Dashboard Consolidado Compliance
					</h:h2>
					<h:p class="text-muted">
						Vista consolidada del estado de compliance según EU AI Act
					</h:p>
				</div>
			</div>

			<!-- Botón refrescar -->
			<div class="col-lg-12 s-bot">
				<div class="hstack gap-2">
					<button
						label="Refrescar"
						onClick="@command('refresh')"
						class="btn btn-outline-primary" />
				</div>
			</div>

			<!-- KPIs Principales -->
			<div class="col-lg-12 s-bot">
				<div class="row g-3">
					<!-- % Completitud Compliance -->
					<div class="col-md-3">
						<div class="card border-primary">
							<div class="card-body">
								<div class="d-flex align-items-center">
									<div class="flex-grow-1">
										<h:h5 class="text-muted mb-0">% Completitud</h:h5>
										<h:h2 class="mt-2 mb-0">@load(vm.completionRate, converter='decimalFormat')%</h:h2>
										<h:small class="text-muted">
											@load(vm.completedAssessments) de @load(vm.totalAssessments) completados
										</h:small>
									</div>
									<div class="flex-shrink-0">
										<h:i class="fa-solid fa-check-circle fa-2x text-primary"></h:i>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- FRIA Aprobadas -->
					<div class="col-md-3">
						<div class="card border-success">
							<div class="card-body">
								<div class="d-flex align-items-center">
									<div class="flex-grow-1">
										<h:h5 class="text-muted mb-0">FRIA Aprobadas</h:h5>
										<h:h2 class="mt-2 mb-0">@load(vm.friaApprovalRate, converter='decimalFormat')%</h:h2>
										<h:small class="text-muted">
											@load(vm.approvedFria) de @load(vm.totalFria) aprobadas
										</h:small>
									</div>
									<div class="flex-shrink-0">
										<h:i class="fa-solid fa-file-shield fa-2x text-success"></h:i>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Registros EU -->
					<div class="col-md-3">
						<div class="card border-info">
							<div class="card-body">
								<div class="d-flex align-items-center">
									<div class="flex-grow-1">
										<h:h5 class="text-muted mb-0">Registros EU</h:h5>
										<h:h2 class="mt-2 mb-0">@load(vm.euSubmissionRate, converter='decimalFormat')%</h:h2>
										<h:small class="text-muted">
											@load(vm.submittedEuRegistrations) de @load(vm.totalEuRegistrations) enviados
										</h:small>
									</div>
									<div class="flex-shrink-0">
										<h:i class="fa-solid fa-database fa-2x text-info"></h:i>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Score Promedio -->
					<div class="col-md-3">
						<div class="card border-warning">
							<div class="card-body">
								<div class="d-flex align-items-center">
									<div class="flex-grow-1">
										<h:h5 class="text-muted mb-0">Score Promedio</h:h5>
										<h:h2 class="mt-2 mb-0">@load(vm.averageComplianceScore, converter='decimalFormat')</h:h2>
										<h:small class="text-muted">
											Estado: @load(vm.complianceStatus)
										</h:small>
									</div>
									<div class="flex-shrink-0">
										<h:i class="fa-solid fa-chart-line fa-2x text-warning"></h:i>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Estado de Clasificación -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">Estado de Clasificación</h:h5>
					</div>
					<div class="card-body">
						<div class="row g-3">
							<div class="col-md-6">
								<div class="d-flex align-items-center">
									<h:i class="fa-solid fa-exclamation-triangle fa-2x text-warning me-3"></h:i>
									<div>
										<h:h6 class="mb-0">Alto Riesgo</h:h6>
										<h:h4 class="mb-0">@load(vm.totalAssessments)</h:h4>
										<h:small class="text-muted">Sistemas clasificados</h:small>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="d-flex align-items-center">
									<h:i class="fa-solid fa-check-double fa-2x text-success me-3"></h:i>
									<div>
										<h:h6 class="mb-0">Completados</h:h6>
										<h:h4 class="mb-0">@load(vm.completedAssessments)</h:h4>
										<h:small class="text-muted">Evaluaciones finalizadas</h:small>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Estado de FRIA -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">Estado de FRIA</h:h5>
					</div>
					<div class="card-body">
						<div class="row g-3">
							<div class="col-md-6">
								<div class="d-flex align-items-center">
									<h:i class="fa-solid fa-file-shield fa-2x text-primary me-3"></h:i>
									<div>
										<h:h6 class="mb-0">Total FRIA</h:h6>
										<h:h4 class="mb-0">@load(vm.totalFria)</h:h4>
										<h:small class="text-muted">Evaluaciones FRIA</h:small>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="d-flex align-items-center">
									<h:i class="fa-solid fa-check-circle fa-2x text-success me-3"></h:i>
									<div>
										<h:h6 class="mb-0">Aprobadas</h:h6>
										<h:h4 class="mb-0">@load(vm.approvedFria)</h:h4>
										<h:small class="text-muted">@load(vm.friaApprovalRate, converter='decimalFormat')% aprobación</h:small>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Evaluaciones Técnicas Pendientes -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">Evaluaciones Técnicas Pendientes</h:h5>
					</div>
					<div class="card-body">
						<div class="d-flex align-items-center">
							<h:i class="fa-solid fa-clock fa-2x text-warning me-3"></h:i>
							<div class="flex-grow-1">
								<h:h4 class="mb-0">@load(vm.pendingAssessments)</h:h4>
								<h:small class="text-muted">Evaluaciones pendientes de completar</h:small>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Alertas y Acciones Requeridas -->
			<div class="col-lg-6 s-bot">
				<div class="card">
					<div class="card-header">
						<h:h5 class="card-title mb-0">Alertas y Acciones Requeridas</h:h5>
					</div>
					<div class="card-body">
						<div class="row g-3">
							<div class="col-md-6">
								<div class="alert alert-warning mb-0">
									<h:h6 class="mb-1">FRIA Pendientes</h:h6>
									<h:h4 class="mb-0">@load(vm.pendingFria)</h:h4>
								</div>
							</div>
							<div class="col-md-6">
								<div class="alert alert-info mb-0">
									<h:h6 class="mb-1">Registros EU Pendientes</h:h6>
									<h:h4 class="mb-0">@load(vm.pendingEuRegistrations)</h:h4>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</idspace>
</zk>
