<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="native" xmlns:zk="http://www.zkoss.org/2005/zul">

    <!-- ViewModel binding -->
    <window viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.serving.ServingDashboardViewModel')"
            border="none" width="100%" height="100%">

        <h:div class="container-fluid p-4">

            <!-- Header -->
            <h:div class="row mb-4">
                <h:div class="col-12">
                    <h:h2 class="mb-1" style="font-weight: bold;">🚀 Serving Dashboard</h:h2>
                    <h:p class="text-muted">Monitoreo de endpoints y performance en producción</h:p>
                </h:div>
            </h:div>

            <!-- Botón de refrescar -->
            <h:div class="row mb-4">
                <h:div class="col-12 text-end">
                    <button label="🔄 Refrescar"
                            class="btn btn-primary"
                            onClick="@command('refreshDashboard')" />
                </h:div>
            </h:div>

            <!-- KPIs Principales -->
            <h:div class="row g-3 mb-4">

                <!-- Total Endpoints -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Endpoints</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalEndpoints)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">disponibles</h:p>
                        </h:div>
                    </h:div>
                </h:div>

                <!-- Active Endpoints -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Endpoints Activos</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.activeEndpoints)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">operativos</h:p>
                        </h:div>
                    </h:div>
                </h:div>

                <!-- Avg Latency -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Latencia Promedio</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.avgLatency) @converter('formatedNumber', format='###,##0')"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">ms</h:p>
                        </h:div>
                    </h:div>
                </h:div>

                <!-- Total Requests -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Requests</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalRequests) @converter('formatedNumber', format='###,###')"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">total</h:p>
                        </h:div>
                    </h:div>
                </h:div>

            </h:div>

            <!-- Performance Dashboard -->
            <h:div class="row mb-4">
                <h:div class="col-12">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-primary text-white">
                            <h:h5 class="mb-0">📊 Performance Metrics</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div if="@load(vm.performanceDashboard ne null)">
                                <grid model="@load(vm.endpointAnalytics)">
                                    <columns>
                                        <column label="Endpoint" width="200px"/>
                                        <column label="Status" width="100px"/>
                                        <column label="Requests/hr" width="120px"/>
                                        <column label="Avg Latency" width="120px"/>
                                        <column label="Error Rate" width="120px"/>
                                        <column label="Last Request" width="180px"/>
                                    </columns>
                                    <template name="model">
                                        <row>
                                            <label value="@load(each.endpointname)"/>
                                            <label value="@load(each.status)"
                                                   style="@load(each.status eq 'ACTIVE' ? 'color: green; font-weight: bold;' : 'color: red;')"/>
                                            <label value="@load(each.requestsperhour) @converter('formatedNumber', format='###,###')"/>
                                            <label value="@load(each.avglatency) @converter('formatedNumber', format='###,##0')"/>
                                            <label value="@load(each.errorrate) @converter('formatedNumber', format='###,##0.00')"/>
                                            <label value="@load(each.lastrequest) @converter('formatedDate', format='dd/MM/yyyy HH:mm')"/>
                                        </row>
                                    </template>
                                </grid>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
            </h:div>

            <!-- Deployment Status & SLA Compliance -->
            <h:div class="row mb-4">
                <h:div class="col-md-6">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-success text-white">
                            <h:h5 class="mb-0">🚀 Deployment Status</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <grid model="@load(vm.deploymentStatuses)">
                                <columns>
                                    <column label="Model" width="150px"/>
                                    <column label="Version" width="80px"/>
                                    <column label="Status" width="100px"/>
                                    <column label="Instances" width="80px"/>
                                </columns>
                                <template name="model">
                                    <row>
                                        <label value="@load(each.modelname)"/>
                                        <label value="@load(each.version)"/>
                                        <label value="@load(each.status)"
                                               style="@load(each.status eq 'DEPLOYED' ? 'color: green; font-weight: bold;' : 'color: orange;')"/>
                                        <label value="@load(each.instances)"/>
                                    </row>
                                </template>
                            </grid>
                        </h:div>
                    </h:div>
                </h:div>

                <h:div class="col-md-6">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-warning text-dark">
                            <h:h5 class="mb-0">📋 SLA Compliance</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <grid model="@load(vm.slaCompliances)">
                                <columns>
                                    <column label="Endpoint" width="180px"/>
                                    <column label="SLA Target" width="100px"/>
                                    <column label="Current" width="100px"/>
                                    <column label="Status" width="100px"/>
                                </columns>
                                <template name="model">
                                    <row>
                                        <label value="@load(each.endpointname)"/>
                                        <label value="@load(each.slatarget) @converter('formatedNumber', format='###,##0.0')"/>
                                        <label value="@load(each.currentvalue) @converter('formatedNumber', format='###,##0.0')"/>
                                        <label value="@load(each.status)"
                                               style="@load(each.status eq 'COMPLIANT' ? 'color: green; font-weight: bold;' : 'color: red;')"/>
                                    </row>
                                </template>
                            </grid>
                        </h:div>
                    </h:div>
                </h:div>
            </h:div>

        </h:div>

    </window>

</zk>
