<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    <!-- ViewModel binding - OVERVIEW (solo búsqueda/listado) -->
    <idspace
        viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.serving.ModelOverviewViewModel')"
        validationMessages="@id('vmsgs')">

        <div class="row" style="background-color:;">
            <div><!-- Titulo pantalla -->
                <div class="left tittle-principal">
                    <h:h2 class="mb-sm-0">
                        <h:i class="fa-sharp-duotone fa-solid fa-rocket me-2"></h:i>
                        <label value="Gestión de Model" />
                    </h:h2>
                    <h:p class="text-muted">
                        <label value="Listado y búsqueda de serving" />
                    </h:p>
                </div>
            </div>
            
            <div class="col-lg-12 s-bot">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <div class="flex-grow-1">
                            </div>
                            <div class="flex-shrink-0">
                                <div class="hstack text-nowrap gap-2 d-flex">
                                    <a iconSclass="fa-duotone fa-solid fa-plus label-icon align-middle fs-16 me-2" class="waves-effect waves-light" onClick="@command('registerModel')" label="Nuevo Model">
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="section filters">
                <div class="search-bar">
                    <!-- Búsqueda por texto -->
                    <textbox value="@bind(vm.searchTerm)"
                        placeholder="Buscar..."
                        class="form-control" onOK="@command('applyFilters')" />
                    
                    <!-- Filtro por S R V M O D E L T Y P E -->
                    <combobox
                        placeholder="Filtrar por S R V M O D E L T Y P E"
                        selectedItem="@bind(vm.srvmodeltypeFilter)"
                        onChange="@command('applyFilters')">
                        <comboitem label="TODOS" value="ALL" />
                        <comboitem label="LLM" value="LLM" />
                        <comboitem label="VISION" value="VISION" />
                        <comboitem label="AUDIO" value="AUDIO" />
                        <comboitem label="EMBEDDING" value="EMBEDDING" />
                    </combobox>
                    
                </div>
                <div class="filter-icons">
                    <a tooltiptext="Buscar"
                        iconSclass="fa-duotone fa-magnifying-glass-waveform"
                        onClick="@command('applyFilters')" />
                    <a tooltiptext="Limpiar"
                        iconSclass="fa-duotone fa-broom-wide"
                        onClick="@command('clearFilters')" />
                </div>
            </div>
            
            <div class="col-xxl-12 s-bot">
                <div class="card">
                    <div class="card-body">
                        <div id="divTemplate" sclass="col-lg-12">
                            <!-- listado -->
                            <grid model="@load(vm.filteredModels)" style="overflow:auto;">
                                <columns sizable="true" columnsgroup="false" columnshide="false">
                                    <column
                                        label="I D X M O D E L" align="center"
                                        width="15%" />
                                    <column
                                        label="S R V M O D E L N A M E" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L V E R S I O N" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L T Y P E" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L F R A M E W O R K" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L S T A T U S" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L D E S C R I P T I O N" align="center"
                                        width="20%" />
                                    <column
                                        label="S R V M O D E L P A T H" align="center"
                                        width="20%" />
                                    <column
                                        label="Acciones"
                                        align="center" />
                                </columns>

                                <template name="model" var="serving">
                                    <row style="text-align:right;cursor:pointer;"
                                        onClick="@command('viewModelDetails', servingId=serving.idxmodel)">
                                        <label
                                            value="@load(serving.idxmodel) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(serving.srvmodelname) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(serving.srvmodelversion) @converter(vm.fieldConverter)">
                                        </label>
                                        <h:span class="badge bg-secondary">
                                            <label value="@load(serving.srvmodeltype)" />
                                        </h:span>
                                        <h:span class="badge bg-secondary">
                                            <label value="@load(serving.srvmodelframework)" />
                                        </h:span>
                                        <h:span class="badge bg-secondary">
                                            <label value="@load(serving.srvmodelstatus)" />
                                        </h:span>
                                        <label
                                            value="@load(serving.srvmodeldescription) @converter(vm.fieldConverter)">
                                        </label>
                                        <label
                                            value="@load(serving.srvmodelpath) @converter(vm.fieldConverter)">
                                        </label>
                                        <cell align="center" class="d-flex">
                                            <div class="edit">
                                                <a
                                                    onClick="@command('viewModelDetails', servingId=serving.idxmodel)"
                                                    iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
                                                    sclass="waves-effect waves-success"
                                                    tooltiptext="Ver detalles" />
                                            </div>
                                            <div class="delete">
                                                <a
                                                    onClick="@command('deleteModel', servingId=serving.idxmodel)"
                                                    iconSclass="fa-light fa-nfc-trash fa-xl"
                                                    sclass="waves-effect waves-danger"
                                                    tooltiptext="Eliminar" />
                                            </div>
                                        </cell>
                                    </row>
                                </template>
                                
                                <foot>
                                    <footer span="3" align="right">
                                        <paging id="topagin"
                                            pageSize="@load(vm.pageParams.maxRows)" 
                                            totalSize="@load(vm.pageResult.totalRows)"
                                            activePage="@load(vm.pageParams.pageActual - 1)"
                                            onPaging="@command('onPaging', event=event)"
                                            mold="os" width="100%" />
                                    </footer>
                                    <footer span="4" align="left">
                                    </footer>
                                    <footer></footer>
                                </foot>
                            </grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </idspace>
</zk>