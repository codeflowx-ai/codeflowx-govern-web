<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace id="prompts"
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.prompts.PromptsDetailViewModel')"
		validationMessages="@id('vmsgs')">
		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-1" style="font-weight: bold;">
						<h:i class="fa-sharp-duotone fa-solid fa-message-quote label-icon align-middle fs-16 me-2"></h:i>
						<label class="mb-1" value="@load(vm.pageTitle)" style="font-weight: bold;" />
					</h:h2>
					<h:p class="text-muted">
						<label value="Gestión y configuración de prompts de AI" class="text-muted" />
					</h:p>
				</div>
			</div>

			<div class="col-lg-12 col-xlg-12 col-md-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
								<a iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('cancelEdit')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('savePrompt')"
										tooltiptext="Guardar prompt">
									</a>

									<a class="waves-effect waves-light"
										onClick="@command('validatePrompt')"
										iconSclass="fa-sharp-duotone fa-solid fa-badge-check label-icon align-middle fs-16 me-2"
										tooltiptext="Validar prompt"
										visible="@load(vm.editing)"/>

									<a class="waves-effect waves-light"
										iconSclass="fa-sharp-duotone fa-solid fa-code-branch label-icon align-middle fs-16 me-2"
										onClick="@command('createNewVersion')"
										tooltiptext="Crear nueva versión"
										visible="@load(vm.editing)"/>
								</div>
							</div>
						</div>
					</div><!--header-->

					<div class="card-body">
						<div class="row">
							<!-- Formulario Principal -->
							<div class="col-lg-12 col-xlg-12 col-md-12">
								<div class="card default shadow-xl">
									<div class="card-body">
										<div class="form-group row">
											<!-- Nombre -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Nombre del Prompt" />
														<textbox tabindex="1" id="prmname"
															value="@bind(vm.currentPrompt.prmname)"
															sclass="border-danger" maxlength="255" />
														<label sclass="text-danger" value="@load(vmsgs['prmname'])" />
													</div>
												</div>
											</div>

											<!-- Versión -->
											<div class="default col-lg-3 col-xlg-3 col-md-3">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Versión" />
														<textbox tabindex="2" id="prmversion"
															value="@bind(vm.currentPrompt.prmversion)"
															maxlength="50" />
														<label sclass="text-danger" value="@load(vmsgs['prmversion'])" />
													</div>
												</div>
											</div>

											<!-- Tipo -->
											<div class="default col-lg-3 col-xlg-3 col-md-3">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Tipo" />
														<combobox tabindex="3" id="prmtype"
															selectedItem="@bind(vm.currentPrompt.prmtype)"
															readonly="true">
															<comboitem label="Sistema" value="SYSTEM"/>
															<comboitem label="Usuario" value="USER"/>
															<comboitem label="Asistente" value="ASSISTANT"/>
															<comboitem label="Función" value="FUNCTION"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['prmtype'])" />
													</div>
												</div>
											</div>
										</div>

										<div class="form-group row">
											<!-- Categoría -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Categoría" />
														<textbox tabindex="4" id="prmcategory"
															value="@bind(vm.currentPrompt.prmcategory)"
															maxlength="100" />
														<label sclass="text-danger" value="@load(vmsgs['prmcategory'])" />
													</div>
												</div>
											</div>

											<!-- Estado -->
											<div class="default col-lg-3 col-xlg-3 col-md-3">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Estado" />
														<combobox tabindex="5" id="prmstatus"
															selectedItem="@bind(vm.currentPrompt.prmstatus)"
															readonly="true">
															<comboitem label="Activo" value="ACTIVE"/>
															<comboitem label="Inactivo" value="INACTIVE"/>
															<comboitem label="Borrador" value="DRAFT"/>
															<comboitem label="Archivado" value="ARCHIVED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['prmstatus'])" />
													</div>
												</div>
											</div>

											<!-- Estado de Aprobación -->
											<div class="default col-lg-3 col-xlg-3 col-md-3">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Aprobación" />
														<combobox tabindex="6" id="prmapprovalstatus"
															selectedItem="@bind(vm.currentPrompt.prmapprovalstatus)"
															readonly="true">
															<comboitem label="Pendiente" value="PENDING"/>
															<comboitem label="Aprobado" value="APPROVED"/>
															<comboitem label="Rechazado" value="REJECTED"/>
														</combobox>
														<label sclass="text-danger" value="@load(vmsgs['prmapprovalstatus'])" />
													</div>
												</div>
											</div>
										</div>

										<div class="form-group row">
											<!-- Descripción -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Descripción" />
														<textbox tabindex="7" id="prmdescription"
															value="@bind(vm.currentPrompt.prmdescription)"
															rows="3" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['prmdescription'])" />
													</div>
												</div>
											</div>
										</div>

										<div class="form-group row">
											<!-- Contenido del Prompt -->
											<div class="default col-lg-12 col-xlg-12 col-md-12">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Contenido del Prompt" />
														<textbox tabindex="8" id="prmcontent"
															value="@bind(vm.currentPrompt.prmcontent)"
															rows="8" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['prmcontent'])" />
													</div>
												</div>
											</div>
										</div>

										<div class="form-group row">
											<!-- Parámetros JSON -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Parámetros (JSON)" />
														<textbox tabindex="9" id="prmparameters"
															value="@bind(vm.currentPrompt.prmparameters)"
															rows="4" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['prmparameters'])" />
													</div>
												</div>
											</div>

											<!-- Metadata JSON -->
											<div class="default col-lg-6 col-xlg-6 col-md-6">
												<div class="row">
													<div class="col-md-12 input-group">
														<label sclass="text form-label text-capitalize font-weight-normal align-text-middle"
															value="Metadata (JSON)" />
														<textbox tabindex="10" id="prmmetadata"
															value="@bind(vm.currentPrompt.prmmetadata)"
															rows="4" multiline="true" />
														<label sclass="text-danger" value="@load(vmsgs['prmmetadata'])" />
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Tabs de Información Descendente -->
							<div class="col-lg-12 col-xlg-12 col-md-12" visible="@load(vm.editing)">
								<div class="card default shadow-xl">
									<div class="card-body">
										<tabbox>
											<tabs>
												<tab label="Versiones" />
												<tab label="Validaciones" />
												<tab label="Estadísticas" />
											</tabs>
											<tabpanels>

												<!-- Panel 1: Versiones -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Historial de Versiones"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalVersions)"/>
															<label value="versiones"/>
														</h:span>
													</h:div>

													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Versión"/></h:th>
																	<h:th><label value="Descripción"/></h:th>
																	<h:th><label value="Creado"/></h:th>
																	<h:th><label value="Estado"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.promptVersions)" var="version">
																	<h:tr>
																		<h:td><label value="@load(version.idxpromptversion)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-info">
																				v<label value="@load(version.prmversionnumber)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(version.prmchangelog)"/></h:td>
																		<h:td><label value="@load(version.prmcreatedat)"/></h:td>
																		<h:td>
																			<h:span class="badge ${version.prmstatus eq 'ACTIVE' ? 'bg-success' : 'bg-secondary'}">
																				<label value="@load(version.prmstatus)"/>
																			</h:span>
																		</h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>

													<h:div class="text-center text-muted py-3" visible="@load(empty vm.promptVersions)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay versiones registradas"/>
														</h:p>
													</h:div>
												</tabpanel>

												<!-- Panel 2: Validaciones -->
												<tabpanel>
													<h:div class="d-flex justify-content-between align-items-center mb-3">
														<h:h5 class="mb-0">
															<label value="Validaciones del Prompt"/>
														</h:h5>
														<h:span class="badge bg-primary">
															<label value="@load(vm.totalValidations)"/>
															<label value="validaciones"/>
														</h:span>
													</h:div>

													<h:div class="table-responsive">
														<h:table class="table table-hover table-sm">
															<h:thead class="table-light">
																<h:tr>
																	<h:th><label value="ID"/></h:th>
																	<h:th><label value="Fecha"/></h:th>
																	<h:th><label value="Tipo"/></h:th>
																	<h:th><label value="Resultado"/></h:th>
																	<h:th><label value="Score"/></h:th>
																	<h:th><label value="Feedback"/></h:th>
																</h:tr>
															</h:thead>
															<h:tbody>
																<forEach items="@load(vm.promptValidations)" var="validation">
																	<h:tr>
																		<h:td><label value="@load(validation.idxpromptvalidation)"/></h:td>
																		<h:td><label value="@load(validation.prmvalidationdate)"/></h:td>
																		<h:td>
																			<h:span class="badge bg-secondary">
																				<label value="@load(validation.prmvalidationtype)"/>
																			</h:span>
																		</h:td>
																		<h:td>
																			<h:span class="badge ${validation.prmresult eq 'PASS' ? 'bg-success' : 'bg-danger'}">
																				<label value="@load(validation.prmresult)"/>
																			</h:span>
																		</h:td>
																		<h:td>
																			<h:span class="badge bg-primary">
																				<label value="@load(validation.prmvalidationscore)"/>
																			</h:span>
																		</h:td>
																		<h:td><label value="@load(validation.prmfeedback)" maxlength="50"/></h:td>
																	</h:tr>
																</forEach>
															</h:tbody>
														</h:table>
													</h:div>

													<h:div class="text-center text-muted py-3" visible="@load(empty vm.promptValidations)">
														<h:i class="fas fa-inbox" style="font-size: 48px;"></h:i>
														<h:p class="mt-2">
															<label value="No hay validaciones registradas"/>
														</h:p>
													</h:div>
												</tabpanel>

												<!-- Panel 3: Estadísticas -->
												<tabpanel>
													<h:div class="row g-3">
														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-code-branch" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalVersions)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Versiones"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>

														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-clipboard-check" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.totalValidations)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Validaciones"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>

														<h:div class="col-md-4">
															<h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
																<h:div class="card-body text-center p-4">
																	<h:i class="fas fa-star" style="font-size: 36px;"></h:i>
																	<h:h3 class="mt-3 mb-1">
																		<label value="@load(vm.effectivenessScore)"/>
																	</h:h3>
																	<h:p class="mb-0">
																		<label value="Rating Promedio"/>
																	</h:p>
																</h:div>
															</h:div>
														</h:div>

														<h:div class="col-md-12">
															<h:div class="card shadow-sm border-0">
																<h:div class="card-body">
																	<h:h5 class="mb-3">
																		<label value="Información del Prompt"/>
																	</h:h5>
																	<h:div class="row">
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Creado por"/>:</h:strong>
																				<label value="@load(vm.currentPrompt.prmcreatedby)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Fecha de creación"/>:</h:strong>
																				<label value="@load(vm.currentPrompt.prmcreatedat)"/>
																			</h:p>
																		</h:div>
																		<h:div class="col-md-6">
																			<h:p>
																				<h:strong><label value="Actualizado por"/>:</h:strong>
																				<label value="@load(vm.currentPrompt.prmupdatedby)"/>
																			</h:p>
																			<h:p>
																				<h:strong><label value="Última actualización"/>:</h:strong>
																				<label value="@load(vm.currentPrompt.prmupdatedat)"/>
																			</h:p>
																		</h:div>
																	</h:div>
																</h:div>
															</h:div>
														</h:div>
													</h:div>
												</tabpanel>

											</tabpanels>
										</tabbox>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div><!--card-->
			</div><!--lg-->
		</div><!--row-->
	</idspace>
</zk>
