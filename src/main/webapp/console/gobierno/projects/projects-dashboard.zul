<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="native" xmlns:zk="http://www.zkoss.org/2005/zul">
    
    <!-- ViewModel binding -->
    <window viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.projects.ProjectsDashboardViewModel')"
            border="none" width="100%" height="100%">
        
        <h:div class="container-fluid p-4">
            
            <!-- Header -->
            <h:div class="row mb-4">
                <h:div class="col-12">
                    <h:h2 class="mb-1" style="font-weight: bold;">📋 Projects Dashboard</h:h2>
                    <h:p class="text-muted">Gestión y monitoreo de proyectos</h:p>
                </h:div>
            </h:div>
            
            <!-- Botones de acción -->
            <h:div class="row mb-4">
                <h:div class="col-12 text-end">
                    <button label="➕ Nuevo Proyecto" 
                            class="btn btn-success me-2"
                            onClick="@command('createProject')" />
                    <button label="🔄 Refrescar" 
                            class="btn btn-primary"
                            onClick="@command('refreshDashboard')" />
                </h:div>
            </h:div>
            
            <!-- KPIs Principales -->
            <h:div class="row g-3 mb-4">
                
                <!-- Total Proyectos -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Proyectos</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalProjects)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">registrados</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Proyectos Activos -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Proyectos Activos</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.activeProjects)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">en curso</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Presupuesto Total -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Presupuesto Total</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                $<label value="@load(vm.totalBudget) @converter('formatedNumber', format='###,##0')"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">planificado</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Costo Total -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Costo Actual</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                $<label value="@load(vm.totalCost) @converter('formatedNumber', format='###,##0')"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">gastado</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Project Portfolio -->
            <h:div class="row mb-4">
                <h:div class="col-12">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-primary text-white">
                            <h:h5 class="mb-0">📊 Project Portfolio</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div if="@load(vm.portfolioDashboard ne null)">
                                <grid model="@load(vm.financialSummaries)">
                                    <columns>
                                        <column label="Project" width="200px"/>
                                        <column label="Status" width="100px"/>
                                        <column label="Budget" width="120px"/>
                                        <column label="Cost" width="120px"/>
                                        <column label="Progress" width="100px"/>
                                        <column label="Start Date" width="120px"/>
                                        <column label="End Date" width="120px"/>
                                    </columns>
                                    <template name="model">
                                        <row>
                                            <label value="@load(each.prjname)"/>
                                            <label value="@load(each.prjstatus)" 
                                                   style="@load(each.prjstatus eq 'ACTIVE' ? 'color: green; font-weight: bold;' : 'color: gray;')"/>
                                            <label value="@load(each.totalbudget) @converter('formatedNumber', format='###,##0.00')"/>
                                            <label value="@load(each.totalcost) @converter('formatedNumber', format='###,##0.00')"/>
                                            <label value="@load(each.completionpercentage) @converter('formatedNumber', format='###,##0')"/>
                                            <label value="@load(each.prjstartdate) @converter('formatedDate', format='dd/MM/yyyy')"/>
                                            <label value="@load(each.prjenddate) @converter('formatedDate', format='dd/MM/yyyy')"/>
                                        </row>
                                    </template>
                                </grid>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
            </h:div>
            
            <!-- Resource Allocation & Risk Assessment -->
            <h:div class="row mb-4">
                <h:div class="col-md-6">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-success text-white">
                            <h:h5 class="mb-0">👥 Resource Allocation</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <grid model="@load(vm.resourceAllocations)">
                                <columns>
                                    <column label="Project" width="200px"/>
                                    <column label="Team Size" width="100px"/>
                                    <column label="Utilization" width="120px"/>
                                </columns>
                                <template name="model">
                                    <row>
                                        <label value="@load(each.prjname)"/>
                                        <label value="@load(each.teamsize)"/>
                                        <label value="@load(each.utilization) @converter('formatedNumber', format='###,##0.0')"/>
                                    </row>
                                </template>
                            </grid>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-md-6">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-warning text-dark">
                            <h:h5 class="mb-0">⚠️ Risk Assessment</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <grid model="@load(vm.riskAssessments)">
                                <columns>
                                    <column label="Project" width="200px"/>
                                    <column label="Risk Level" width="100px"/>
                                    <column label="Risk Score" width="120px"/>
                                </columns>
                                <template name="model">
                                    <row>
                                        <label value="@load(each.prjname)"/>
                                        <label value="@load(each.risklevel)" 
                                               style="@load(each.risklevel eq 'HIGH' ? 'color: red; font-weight: bold;' : 'color: green;')"/>
                                        <label value="@load(each.riskscore) @converter('formatedNumber', format='###,##0.0')"/>
                                    </row>
                                </template>
                            </grid>
                        </h:div>
                    </h:div>
                </h:div>
            </h:div>
            
        </h:div>
        
    </window>
    
</zk>

