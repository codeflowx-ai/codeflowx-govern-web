<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="native"
    xmlns:x="xhtml">
    
    <div viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.core.SystemHealthViewModel')">
        
        <h:div class="container-fluid p-4">
            
            <!-- Header con estado de salud -->
            <h:div class="row mb-4">
                <h:div class="col-12 col-md-8">
                    <h:h1 class="h2 fw-bold mb-1">
                        <h:i class="bi bi-heart-pulse me-2"></h:i>Salud del Sistema
                    </h:h1>
                    <h:p class="text-muted mb-0">Monitoreo de estado general</h:p>
                </h:div>
                <h:div class="col-12 col-md-4 text-end">
                    <h:div class="mb-2">
                        <h:span class="@load(concat('badge bg-', vm.healthStatusColor))" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            <label value="@load(vm.healthStatus)" />
                        </h:span>
                    </h:div>
                    <button class="btn btn-primary" onClick="@command('refresh')">
                        <h:i class="bi bi-arrow-clockwise me-2"></h:i>Actualizar
                    </button>
                </h:div>
            </h:div>
            <!-- Métricas -->
            <h:div class="row g-3">
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        Total Components
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0" style="font-size: 2.5rem;">
                                        <label value="@load(vm.totalItems)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(13, 110, 253, 0.1);">
                                        <h:i class="bi bi-server text-primary" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        Healthy
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0 text-success" style="font-size: 2.5rem;">
                                        <label value="@load(vm.activeItems)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(25, 135, 84, 0.1);">
                                        <h:i class="bi bi-shield-check text-success" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        Deployed
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0 text-info" style="font-size: 2.5rem;">
                                        <label value="@load(vm.deployedItems)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(13, 202, 240, 0.1);">
                                        <h:i class="bi bi-cloud-check text-info" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        In Training
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0 text-warning" style="font-size: 2.5rem;">
                                        <label value="@load(vm.trainingItems)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(255, 193, 7, 0.1);">
                                        <h:i class="bi bi-arrow-repeat text-warning" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        Offline
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0 text-danger" style="font-size: 2.5rem;">
                                        <label value="@load(vm.offlineItems)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(220, 53, 69, 0.1);">
                                        <h:i class="bi bi-exclamation-triangle text-danger" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
                <h:div class="col-12 col-sm-6 col-lg-4">
                    <h:div class="card h-100 border-0 shadow-sm">
                        <h:div class="card-body">
                            <h:div class="d-flex justify-content-between align-items-start">
                                <h:div class="flex-grow-1">
                                    <h:p class="text-muted text-uppercase mb-2" style="font-size: 0.75rem; font-weight: 600;">
                                        Health Score
                                    </h:p>
                                    <h:h2 class="fw-bold mb-0 text-primary" style="font-size: 2.5rem;">
                                        <label value="@load(vm.avgScore)" />
                                    </h:h2>
                                </h:div>
                                <h:div class="ms-3">
                                    <h:div class="rounded-circle d-flex align-items-center justify-content-center" 
                                           style="width: 48px; height: 48px; background-color: rgba(13, 110, 253, 0.1);">
                                        <h:i class="bi bi-activity text-primary" style="font-size: 1.5rem;"></h:i>
                                    </h:div>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
        </h:div>
    </div>
</zk>

