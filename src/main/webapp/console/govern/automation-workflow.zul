<?page title="Automation & Workflow" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.automation.AutomationWorkflowVM')">
        
        <!-- Workflow Overview -->
        <hlayout sclass="workflow-header">
            <div sclass="metric-box">
                <label value="Active Workflows"/>
                <label value="@load(vm.activeWorkflows)"/>
            </div>
            <div sclass="metric-box">
                <label value="Success Rate"/>
                <label value="@load(vm.successRate)%" 
                       sclass="@load(vm.successRateStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Tasks Pending"/>
                <label value="@load(vm.pendingTasks)"/>
            </div>
            <div sclass="metric-box">
                <label value="Automation Level"/>
                <label value="@load(vm.automationLevel)%"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Workflow Designer"/>
                <tab label="Business Rules"/>
                <tab label="Task Management"/>
                <tab label="Automation Metrics"/>
            </tabs>
            <tabpanels>
                <!-- Workflow Designer Panel -->
                <tabpanel>
                    <hlayout>
                        <!-- Workflow List -->
                        <vlayout width="30%">
                            <listbox model="@load(vm.workflows)" 
                                    selectedItem="@bind(vm.selectedWorkflow)"
                                    mold="paging" pageSize="10">
                                <listhead>
                                    <listheader label="Workflow Name"/>
                                    <listheader label="Status"/>
                                    <listheader label="Actions"/>
                                </listhead>
                                <template name="model" var="workflow">
                                    <listitem>
                                        <listcell label="@load(workflow.name)"/>
                                        <listcell>
                                            <label value="@load(workflow.status)" 
                                                   sclass="@load(workflow.statusStyle)"/>
                                        </listcell>
                                        <listcell>
                                            <button label="Edit" 
                                                    onClick="@command('editWorkflow', workflow=workflow)"/>
                                            <button label="Clone" 
                                                    onClick="@command('cloneWorkflow', workflow=workflow)"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                            <button label="New Workflow" 
                                    onClick="@command('createWorkflow')"/>
                        </vlayout>

                        <!-- Workflow Designer -->
                        <vlayout width="70%" visible="@load(not empty vm.selectedWorkflow)">
                            <div sclass="workflow-canvas" 
                                 height="500px"
                                 style="border: 1px solid #ccc;">
                                <!-- Workflow Designer Canvas -->
                                <include src="@load(vm.workflowDesignerUrl)"/>
                            </div>
                            <hlayout>
                                <button label="Save" onClick="@command('saveWorkflow')"/>
                                <button label="Test" onClick="@command('testWorkflow')"/>
                                <button label="Deploy" onClick="@command('deployWorkflow')"/>
                            </hlayout>
                        </vlayout>
                    </hlayout>
                </tabpanel>

                <!-- Business Rules Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Rule Categories -->
                        <hlayout>
                            <combobox model="@load(vm.ruleCategories)" 
                                     selectedItem="@bind(vm.selectedCategory)"
                                     onChange="@command('filterRules')"/>
                            <button label="New Rule" 
                                    onClick="@command('createRule')"/>
                        </hlayout>

                        <!-- Rules Grid -->
                        <grid model="@load(vm.businessRules)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Rule Name"/>
                                <column label="Category"/>
                                <column label="Condition"/>
                                <column label="Action"/>
                                <column label="Priority"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="rule">
                                <row>
                                    <label value="@load(rule.name)"/>
                                    <label value="@load(rule.category)"/>
                                    <label value="@load(rule.condition)"/>
                                    <label value="@load(rule.action)"/>
                                    <label value="@load(rule.priority)"/>
                                    <label value="@load(rule.status)" 
                                           sclass="@load(rule.statusStyle)"/>
                                    <hlayout>
                                        <button label="Edit" 
                                                onClick="@command('editRule', rule=rule)"/>
                                        <button label="Toggle" 
                                                onClick="@command('toggleRule', rule=rule)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Task Management Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Task Filters -->
                        <hlayout sclass="task-filters">
                            <textbox value="@bind(vm.taskSearchTerm)" 
                                    placeholder="Search tasks..."/>
                            <combobox model="@load(vm.taskStatuses)" 
                                     selectedItem="@bind(vm.selectedTaskStatus)"/>
                            <combobox model="@load(vm.taskPriorities)" 
                                     selectedItem="@bind(vm.selectedTaskPriority)"/>
                            <button label="Search" onClick="@command('searchTasks')"/>
                        </hlayout>

                        <!-- Tasks Grid -->
                        <grid model="@load(vm.tasks)" 
                              mold="paging" pageSize="15">
                            <columns>
                                <column label="Task ID"/>
                                <column label="Name"/>
                                <column label="Workflow"/>
                                <column label="Status"/>
                                <column label="Priority"/>
                                <column label="Due Date"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="task">
                                <row>
                                    <label value="@load(task.id)"/>
                                    <label value="@load(task.name)"/>
                                    <label value="@load(task.workflowName)"/>
                                    <label value="@load(task.status)" 
                                           sclass="@load(task.statusStyle)"/>
                                    <label value="@load(task.priority)" 
                                           sclass="@load(task.priorityStyle)"/>
                                    <label value="@load(task.dueDate)"/>
                                    <hlayout>
                                        <button label="Execute" 
                                                onClick="@command('executeTask', task=task)"/>
                                        <button label="Details" 
                                                onClick="@command('showTaskDetails', task=task)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Automation Metrics Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Metrics Overview -->
                        <hlayout>
                            <charts id="automationTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Automation Trends"
                                   model="@load(vm.automationTrendsData)"/>
                            
                            <charts id="taskDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="Task Distribution"
                                   model="@load(vm.taskDistributionData)"/>
                        </hlayout>

                        <!-- Detailed Metrics -->
                        <grid model="@load(vm.automationMetrics)">
                            <columns>
                                <column label="Metric"/>
                                <column label="Value"/>
                                <column label="Trend"/>
                                <column label="Target"/>
                                <column label="Status"/>
                            </columns>
                            <template name="model" var="metric">
                                <row>
                                    <label value="@load(metric.name)"/>
                                    <label value="@load(metric.value)"/>
                                    <label value="@load(metric.trend)" 
                                           sclass="@load(metric.trendStyle)"/>
                                    <label value="@load(metric.target)"/>
                                    <label value="@load(metric.status)" 
                                           sclass="@load(metric.statusStyle)"/>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="workflowEditorWindow" 
                title="Workflow Editor" 
                visible="false" 
                mode="modal"
                width="80%"
                height="80%">
            <!-- Workflow Editor Content -->
        </window>

        <window id="ruleEditorWindow" 
                title="Rule Editor" 
                visible="false" 
                mode="modal"
                width="600px">
            <!-- Rule Editor Content -->
        </window>

        <window id="taskDetailsWindow" 
                title="Task Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Task Details Content -->
        </window>
    </div>
</zk>