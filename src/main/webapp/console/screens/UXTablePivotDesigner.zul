<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="dual-listbox" extends="div" class="com.suinsit.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div sclass="col-lg-12">
		<hbox id="toolbar2" spacing="5px" align="start"
			style="margin-top: 7px;margin-bottom: 5px;">
		</hbox>
		<nodom
			viewModel="@id('vm') @init('com.enartsystems.designer.TablePivotDesigner')">
			<tabbox>
				<tabs>
					<tab id="ids" label="Designer"
						image="img/icons/svg/web-design.svg" />
					<tab id="tbpreview" label="Preview"
						onClick="@command('onPreview')" image="img/icons/svg/preview.svg" />
					<tab id="tblogs" label="logs"
						onSelect="@command('onLoadLogs')" image="img/icons/svg/log.svg" />
				</tabs>
				<tabpanels>
					<tabpanel>
						<div sclass="row">

							<div sclass="col-lg-8 col-xlg-8 col-md-8">
								<tabbox>
									<tabs>
										<tab
											label="Configure Data Model"
											iconSclass="icon glyphicon glyphicon-cog" />
										<tab id="pageprops"
											label="Configure Pivot"
											iconSclass="icon glyphicon glyphicon-cog" />
									</tabs>
									<tabpanels>
										<tabpanel>
											<div class="row">
												
												<h:div
													class="col-md-6">
													<label
														sclass="form-label" value="Seleccione modelo" />
													<combobox
														model="@load(vm.beans)" value="@bind(vm.nameEntidad)"
														onSelect="@command('selectEntity',item=self.selectedItem.value)">
														<template
															name="model" var="item">
															<comboitem
																value="${item.namesql}" label="${item.namesql}" />
														</template>
													</combobox>
												</h:div>
												

												<h:div
													class="col-md-10">

													<tabbox>
														<tabs>
															<tab
																label="Row Fields" />
															<tab
																label="Columns Fields" />
															<tab
																label="Data Fields" />
														</tabs>
														<tabpanels>
															<tabpanel>
																<dual-listbox
																	id="dualLBoxRow" />
															</tabpanel>
															<tabpanel>
																<dual-listbox
																	id="dualLBoxCols" />
															</tabpanel>
															<tabpanel>
																<dual-listbox
																	id="dualLBoxData" />
															</tabpanel>
														</tabpanels>
													</tabbox>
												</h:div>
											</div>
										</tabpanel>
										<tabpanel>
											<grid style="align:top"
												id="propiedadesPage" width="70%" height="750px">
												<columns>
													<column
														label="Property" width="25%" />
													<column
														label="Value" width="75%" />
												</columns>
												<rows>
													<row></row>
													<row></row>
													<row></row>
												</rows>
											</grid>
										</tabpanel>

									</tabpanels>
								</tabbox>
							</div>
							<div sclass="col-lg-3">

							</div>

						</div>


					</tabpanel>

					<tabpanel id="tbprevio">
						<iframe id="include" src="" width="100%"
							height="900px" scrolling="auto" />

					</tabpanel>

					<tabpanel>
						<div sclass="col-lg-12 col-xlg-12 col-md-12">
							<grid model="@load(vm.logVersion)"
								height="900px" width="100%">
								<columns>
									<column label="logs" width="100%" />
								</columns>
								<rows>
									<template name="model">
										<row>
											<label value="@load(each)" />
										</row>
									</template>
								</rows>
							</grid>
						</div>
					</tabpanel>
				</tabpanels>
			</tabbox>
		</nodom>
	</div>
</zk>