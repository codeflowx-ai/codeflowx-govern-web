<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<div sclass="row"  style="height : 100vh;overflow:auto;">
              <!-- Creates a container for the sidebar -->
						<h:div id="toolbarContainer"
							style="position:absolute;white-space:nowrap;overflow:hidden;top:0px;left:0px;max-height:38px;height:38px;right:0px;padding:6px;);">
							<image
								src="img/iconos-micro/30x30/save30x30.png"
								xmlns:w="http://www.zkoss.org/2005/zk/client"
								w:onClick="evalXML();" style="cursor: pointer;"
								tooltiptext="Save Data Model">
							</image>
						</h:div>

						<!-- Creates a container for the toolboox -->
						<h:div id="sidebarContainer"
							class="col-lg-1 col-xlg-1 col-md-1"
							style="position:absolute;overflow:hidden;top:36px;left:0px;bottom:36px;max-width:52px;width:56px;padding-top:10px;padding-left:4px;">

						</h:div>

						<!-- Creates a container for the graph -->
						<h:div id="graphContainer"
							class="col-lg-12 col-xlg-12 col-md-12"
							style="position:absolute;overflow:hidden;top:36px;left:60px;bottom:36px;right:0px;background-image:url('img/artfacto-grid-1024x768.jpg');">

						</h:div>


						<!-- Creates a container for the outline -->
						<h:div id="outlineContainer"
							style="position:absolute;overflow:hidden;top:36px;right:30px;width:200px;height:140px;background:transparent;border-style:solid;border-color:black;">

						</h:div>

						<!-- Creates a container for the sidebar -->
						<h:div id="statusContainer"
							style="text-align:right;position:absolute;overflow:hidden;bottom:0px;left:0px;max-height:24px;height:36px;right:0px;color:white;padding:6px;background-image:url('images/toolbar_bg.gif');">

						</h:div>
              
            
            </div>
            	<textbox visible="false" id="expXml"></textbox>
	</zk>