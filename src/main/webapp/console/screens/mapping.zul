<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<label  id="labelDrop" value="Arrastra el campo aquí"
		onDrop="@global-command('dragFields',dragged=event)" droppable="true">
	</label>
	<grid id="gridMapping" droppable="true">
		<columns>
			<column label="Campo Destino" />
			<column label="Valor Defecto" />
			<column label="Variable" />
			<column label="Asignar valor de.." />
			<column label="En Búsqueda" width="100px"/>
			<column label="En nuevo" width="100px"/>
			<column label="Al Actualizar" width="100px"/>
			<column label="En Carga" width="100px"/>
			<column label="Al cambiar" width="100px"/>
			<column label="" width="100px"/>
		</columns>
		<rows>
			

		</rows>
	</grid>
</zk>
