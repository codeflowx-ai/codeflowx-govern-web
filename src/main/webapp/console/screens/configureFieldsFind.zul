<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div sclass="col-lg-10">
		<hbox spacing="2px" align="center" width="85%">
			
			<listbox id ="listMapping" 	width="95%" droppable="true" >
				<listhead>
					<listheader label="${labels.EntityMaster.name}" />
					<listheader label="Ordenar" />
					<listheader label="" width="15%" />
				</listhead>
				<template name="model" var="item" status="s">
					<listitem>
						<listcell>
							<label class="text-primary font-weight-bold"
								value="@load(item.label ne null?item.label:item.columnname)" />
						</listcell>
						<listcell>
							<combobox selectedItem="@load(item.order)"
								value="@bind(item.order)">
								<comboitem label="Asc" />
								<comboitem label="Desc" />
							</combobox>
						</listcell>
						<listcell>
							<hbox>
								<button
									onClick="@command('removeField',item=item,list='list')"
									tooltiptext="Delete" iconSclass="bx bx-trash fs-2x"
									sclass="btn btn-outline-danger waves-effect waves-light shadow-none"
									visible="@load(item.pk eq false) ">
								</button>
							</hbox>
						</listcell>
					</listitem>
				</template>
			</listbox>
			<vbox spacing="10px" width="24px" align="center">
				<a iconSclass="bx bx-up-arrow-alt " id="upBtn"
					tooltiptext="move up field">
				</a>
				<a iconSclass="bx bx-down-arrow-alt " id="downBtn"
					tooltiptext="move down field">
				</a>
			</vbox>
		</hbox>
	</div>

	<div sclass="col-lg-2">
		<!-- 													<includeHTML -->
		<!-- 														src="viewdesigner_listscreen.zhtml" /> -->
	</div>
</zk>