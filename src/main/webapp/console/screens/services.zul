<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<hbox spacing="25px">
	Seleccione el servicio
	<combobox id="cbservicios" >
	<template name="model" >
	<comboitem label="${each.name }" value="${each}"/>
	</template>
	</combobox>
	</hbox>
	
	<grid id="gridServices" droppable="true">
		<columns>
		 <column width="40px" />
            <column hflex="1" label="Servicio" sort="auto" />
<!--             <column width="150px" label="Price" sort="auto" align="center"/> -->
<!--             <column width="150px" label="Rating" sort="auto" align="center"/> -->
<!-- 		    <column label="Servicio" /> -->
<!-- 			<column label="Campo Destino" /> -->
<!-- 			<column label="Valor Defecto" /> -->
<!-- 			<column label="Variable" /> -->
<!-- 			<column label="Asignar valor de.." /> -->
<!-- 			<column label="En Búsqueda" width="100px"/> -->
<!-- 			<column label="En nuevo" width="100px"/> -->
            <column label="Eventos" width="200px"/>
			<column label="Descripción" width="200px"/>
			<column label="" width="100px"/>
		</columns>
		<rows>
			

		</rows>
	</grid>
</zk>
