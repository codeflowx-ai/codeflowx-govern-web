<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<div class="row">
	<div class="col-lg-12 " apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm1') @init('com.enartsystems.designer.ConfigurationUI')">
			<custom-attributes queue="design" />
			<custom-attributes scopeView="VIEWMODEL" />	
	<tabbox>
		<tabs >
			<tab id="tbconfig" label="Configuration" />
			<tab  id="tbdesigner1" label="Designer" disabled="true"/>
		</tabs>
		<tabpanels>
			<tabpanel>
			  <apply id="tpl" templateURI="screens/confModel.zul"></apply>
			</tabpanel>
			<tabpanel>
                 <div id="uxds" class="row" width="" height="">

				</div>
			</tabpanel>
		</tabpanels>
	</tabbox>
</div>
</div>	
</zk>