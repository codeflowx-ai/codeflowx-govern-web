<?page title="Compliance Audit Trail" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.compliance.ComplianceAuditTrailVM')">
        
        <hlayout sclass="audit-header">
            <div sclass="metric-box">
                <label value="Total Audit Records"/>
                <label value="@load(vm.totalAuditRecords)"/>
            </div>
            <div sclass="metric-box">
                <label value="Critical Events"/>
                <label value="@load(vm.criticalEvents)" 
                       sclass="@load(vm.criticalEventsStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Pending Reviews"/>
                <label value="@load(vm.pendingReviews)"/>
            </div>
            <div sclass="actions-box">
                <button label="Export Audit Log" 
                        onClick="@command('exportAuditLog')"/>
                <button label="Generate Report" 
                        onClick="@command('generateAuditReport')"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Audit Log"/>
                <tab label="Change History"/>
                <tab label="Access Log"/>
                <tab label="Compliance Events"/>
            </tabs>
            <tabpanels>
                <!-- Audit Log Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Filters -->
                        <hlayout sclass="filter-container">
                            <datebox value="@bind(vm.startDate)" 
                                    placeholder="Start Date"/>
                            <datebox value="@bind(vm.endDate)" 
                                    placeholder="End Date"/>
                            <combobox model="@load(vm.eventTypes)" 
                                     selectedItem="@bind(vm.selectedEventType)"
                                     placeholder="Event Type"/>
                            <combobox model="@load(vm.severityLevels)" 
                                     selectedItem="@bind(vm.selectedSeverity)"
                                     placeholder="Severity"/>
                            <textbox value="@bind(vm.searchTerm)" 
                                    placeholder="Search..."/>
                            <button label="Apply Filters" 
                                    onClick="@command('applyFilters')"/>
                        </hlayout>

                        <!-- Audit Log Grid -->
                        <grid model="@load(vm.auditRecords)" 
                              mold="paging" pageSize="20">
                            <columns>
                                <column label="Timestamp" sort="auto"/>
                                <column label="Event Type"/>
                                <column label="Model/Component"/>
                                <column label="User"/>
                                <column label="Action"/>
                                <column label="Details"/>
                                <column label="Severity"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="record">
                                <row>
                                    <label value="@load(record.timestamp)"/>
                                    <label value="@load(record.eventType)"/>
                                    <label value="@load(record.component)"/>
                                    <label value="@load(record.user)"/>
                                    <label value="@load(record.action)"/>
                                    <label value="@load(record.details)"/>
                                    <label value="@load(record.severity)" 
                                           sclass="@load(record.severityStyle)"/>
                                    <label value="@load(record.status)" 
                                           sclass="@load(record.statusStyle)"/>
                                    <hlayout>
                                        <button label="View" 
                                                onClick="@command('viewAuditDetails', record=record)"/>
                                        <button label="Review" visible="@load(record.needsReview)"
                                                onClick="@command('reviewAuditRecord', record=record)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Change History Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Component Selection -->
                        <hlayout>
                            <combobox model="@load(vm.components)" 
                                     selectedItem="@bind(vm.selectedComponent)"
                                     onSelect="@command('loadChangeHistory')"
                                     placeholder="Select Component"/>
                        </hlayout>

                        <!-- Change History Timeline -->
                        <grid model="@load(vm.changeHistory)" 
                              mold="paging" pageSize="15">
                            <columns>
                                <column label="Date"/>
                                <column label="Change Type"/>
                                <column label="Changed By"/>
                                <column label="Previous Value"/>
                                <column label="New Value"/>
                                <column label="Reason"/>
                                <column label="Impact"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="change">
                                <row>
                                    <label value="@load(change.date)"/>
                                    <label value="@load(change.type)"/>
                                    <label value="@load(change.user)"/>
                                    <label value="@load(change.previousValue)"/>
                                    <label value="@load(change.newValue)"/>
                                    <label value="@load(change.reason)"/>
                                    <label value="@load(change.impact)" 
                                           sclass="@load(change.impactStyle)"/>
                                    <hlayout>
                                        <button label="Details" 
                                                onClick="@command('viewChangeDetails', change=change)"/>
                                        <button label="Revert" visible="@load(change.canRevert)"
                                                onClick="@command('revertChange', change=change)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Access Log Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Access Log Grid -->
                        <grid model="@load(vm.accessLogs)" 
                              mold="paging" pageSize="20">
                            <columns>
                                <column label="Timestamp"/>
                                <column label="User"/>
                                <column label="Resource"/>
                                <column label="Action"/>
                                <column label="IP Address"/>
                                <column label="Status"/>
                                <column label="Duration"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="access">
                                <row>
                                    <label value="@load(access.timestamp)"/>
                                    <label value="@load(access.user)"/>
                                    <label value="@load(access.resource)"/>
                                    <label value="@load(access.action)"/>
                                    <label value="@load(access.ipAddress)"/>
                                    <label value="@load(access.status)" 
                                           sclass="@load(access.statusStyle)"/>
                                    <label value="@load(access.duration)ms"/>
                                    <hlayout>
                                        <button label="Details" 
                                                onClick="@command('viewAccessDetails', access=access)"/>
                                        <button label="Flag" visible="@load(access.canFlag)"
                                                onClick="@command('flagAccess', access=access)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Compliance Events Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Compliance Events Grid -->
                        <grid model="@load(vm.complianceEvents)" 
                              mold="paging" pageSize="15">
                            <columns>
                                <column label="Date"/>
                                <column label="Event Type"/>
                                <column label="Component"/>
                                <column label="Description"/>
                                <column label="Impact Level"/>
                                <column label="Resolution Status"/>
                                <column label="Due Date"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="event">
                                <row>
                                    <label value="@load(event.date)"/>
                                    <label value="@load(event.type)"/>
                                    <label value="@load(event.component)"/>
                                    <label value="@load(event.description)"/>
                                    <label value="@load(event.impactLevel)" 
                                           sclass="@load(event.impactStyle)"/>
                                    <label value="@load(event.status)" 
                                           sclass="@load(event.statusStyle)"/>
                                    <label value="@load(event.dueDate)"/>
                                    <hlayout>
                                        <button label="View" 
                                                onClick="@command('viewEventDetails', event=event)"/>
                                        <button label="Update" 
                                                onClick="@command('updateEvent', event=event)"/>
                                        <button label="Resolve" visible="@load(event.canResolve)"
                                                onClick="@command('resolveEvent', event=event)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Detail Windows -->
        <window id="auditDetailWindow" 
                title="Audit Record Details" 
                visible="false" 
                mode="modal"
                width="80%"
                height="600px">
            <!-- Audit Detail Content -->
        </window>

        <window id="changeDetailWindow" 
                title="Change Details" 
                visible="false" 
                mode="modal"
                width="70%"
                height="500px">
            <!-- Change Detail Content -->
        </window>
    </div>
</zk>