<?page title="Compliance Manager" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.compliance.ComplianceManagerVM')">
        
        <!-- Compliance Overview -->
        <hlayout sclass="compliance-header">
            <div sclass="compliance-status">
                <label value="Overall Compliance Status"/>
                <label value="@load(vm.complianceScore)%" 
                       sclass="@load(vm.complianceScoreStyle)"/>
            </div>
            <div sclass="risk-level">
                <label value="Current Risk Level"/>
                <label value="@load(vm.riskLevel)" 
                       sclass="@load(vm.riskLevelStyle)"/>
            </div>
            <div sclass="last-audit">
                <label value="Last Audit"/>
                <label value="@load(vm.lastAuditDate)"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Compliance Dashboard"/>
                <tab label="Risk Assessment"/>
                <tab label="Audit Trail"/>
                <tab label="Reports"/>
            </tabs>
            <tabpanels>
                <!-- Compliance Dashboard -->
                <tabpanel>
                    <vlayout>
                        <!-- Regulatory Compliance Status -->
                        <listbox model="@load(vm.regulatoryStatus)" 
                                mold="paging" pageSize="5">
                            <listhead>
                                <listheader label="Regulation"/>
                                <listheader label="Status"/>
                                <listheader label="Last Check"/>
                                <listheader label="Next Review"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="reg">
                                <listitem>
                                    <listcell label="@load(reg.name)"/>
                                    <listcell>
                                        <label value="@load(reg.status)" 
                                               sclass="@load(reg.statusStyle)"/>
                                    </listcell>
                                    <listcell label="@load(reg.lastCheck)"/>
                                    <listcell label="@load(reg.nextReview)"/>
                                    <listcell>
                                        <button label="View Details" 
                                                onClick="@command('showRegulationDetails', regulation=reg)"/>
                                        <button label="Run Check" 
                                                onClick="@command('runComplianceCheck', regulation=reg)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>

                        <!-- Compliance Issues -->
                        <groupbox title="Active Compliance Issues">
                            <listbox model="@load(vm.activeIssues)" 
                                    emptyMessage="No active compliance issues">
                                <listhead>
                                    <listheader label="Issue"/>
                                    <listheader label="Severity"/>
                                    <listheader label="Detected"/>
                                    <listheader label="Status"/>
                                    <listheader label="Actions"/>
                                </listhead>
                                <template name="model" var="issue">
                                    <listitem>
                                        <listcell label="@load(issue.description)"/>
                                        <listcell>
                                            <label value="@load(issue.severity)" 
                                                   sclass="@load(issue.severityStyle)"/>
                                        </listcell>
                                        <listcell label="@load(issue.detectedDate)"/>
                                        <listcell label="@load(issue.status)"/>
                                        <listcell>
                                            <button label="Resolve" 
                                                    onClick="@command('resolveIssue', issue=issue)"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>
                    </vlayout>
                </tabpanel>

                <!-- Risk Assessment Panel -->
                <tabpanel>
                    <vlayout>
                        <charts id="riskTrends" 
                               type="line"
                               title="Risk Trends"
                               model="@load(vm.riskTrendsData)"/>
                        
                        <listbox model="@load(vm.riskAssessments)">
                            <listhead>
                                <listheader label="Risk Area"/>
                                <listheader label="Risk Level"/>
                                <listheader label="Impact"/>
                                <listheader label="Mitigation Status"/>
                                <listheader label="Actions"/>
                            </listhead>
                            <template name="model" var="risk">
                                <listitem>
                                    <listcell label="@load(risk.area)"/>
                                    <listcell>
                                        <label value="@load(risk.level)" 
                                               sclass="@load(risk.levelStyle)"/>
                                    </listcell>
                                    <listcell label="@load(risk.impact)"/>
                                    <listcell label="@load(risk.mitigationStatus)"/>
                                    <listcell>
                                        <button label="Update" 
                                                onClick="@command('updateRiskAssessment', risk=risk)"/>
                                    </listcell>
                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>
    </div>
</zk>