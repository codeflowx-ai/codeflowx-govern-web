<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    
    <idspace viewModel="@id('vm') @init('com.suinsit.compliance.web.ComplianceDashboardUI')">
        <custom-attributes namespace="compliance" />
        
        <div class="container-fluid">
            <!-- Filtros -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="form-group">
                        <h:label>Sector</h:label>
                        <combobox model="@load(vm.sectors)" 
                                 selectedItem="@bind(vm.selectedSector)"
                                 onSelect="@command('refreshData')"
                                 class="form-control">
                            <template name="model">
                                <comboitem label="@load(each.sectorName)" />
                            </template>
                        </combobox>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <h:label>Período</h:label>
                        <combobox model="@load(vm.periods)"
                                 selectedItem="@bind(vm.selectedPeriod)"
                                 onSelect="@command('refreshData')"
                                 class="form-control">
                            <template name="model">
                                <comboitem label="@load(each)" />
                            </template>
                        </combobox>
                    </div>
                </div>
                <div class="col-md-3">
                    <h:button class="btn btn-primary mt-4" onClick="@command('downloadReport')">
                        <i class="fas fa-download"></i> Exportar
                    </h:button>
                </div>
            </div>

            <!-- KPIs -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Cumplimiento General</h5>
                            <h2 class="card-text">@load(vm.avgScore)%</h2>
                            <div class="trend @load(vm.scoreTrend)">
                                <span class="@load(vm.scoreTrendIcon)"></span>
                                <span>@load(vm.scoreVariation)%</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Empresas Evaluadas</h5>
                            <h2 class="card-text">@load(vm.totalCompanies)</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h5 class="card-title">Respuestas Pendientes</h5>
                            <h2 class="card-text">@load(vm.pendingAnswers)</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Evidencias Aprobadas</h5>
                            <h2 class="card-text">@load(vm.approvedEvidences)%</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráficos -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tendencia de Cumplimiento</h5>
                            <charts id="trendChart" 
                                   type="line"
                                   model="@load(vm.trendModel)"
                                   height="300px"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Distribución por Sector</h5>
                            <charts id="sectorChart" 
                                   type="column"
                                   model="@load(vm.sectorModel)"
                                   height="300px"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sectores que Requieren Atención -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Sectores que Requieren Atención</h5>
                            <grid model="@load(vm.sectorsNeedingAttention)" 
                                  emptyMessage="No hay sectores que requieran atención"
                                  mold="paging" 
                                  pageSize="5">
                                <columns>
                                    <column label="Sector" />
                                    <column label="Nivel Riesgo" align="center"/>
                                    <column label="Cumplimiento" align="center"/>
                                    <column label="Variación" align="center"/>
                                    <column label="Acciones" align="center"/>
                                </columns>
                                <template name="model">
                                    <row>
                                        <cell>${each.sectorName}</cell>
                                        <cell>
                                            <label sclass="badge badge-${each.riskLevel == 'CRITICAL' ? 'danger' : 
                                                                       each.riskLevel == 'HIGH' ? 'warning' : 
                                                                       'info'}">
                                                ${each.riskLevel}
                                            </label>
                                        </cell>
                                        <cell>
                                            <label sclass="badge badge-${each.avgScore >= 70 ? 'success' : 
                                                                       each.avgScore >= 50 ? 'warning' : 
                                                                       'danger'}">
                                                ${each.avgScore}%
                                            </label>
                                        </cell>
                                        <cell>
                                            <label sclass="badge badge-${each.scoreVariation > 0 ? 'success' : 'danger'}">
                                                ${each.scoreVariation}%
                                            </label>
                                        </cell>
                                        <cell>
                                            <h:button class="btn btn-sm btn-info" 
                                                     onClick="@command('viewSectorDetail', sector=each)">
                                                Ver Detalle
                                            </h:button>
                                        </cell>
                                    </row>
                                </template>
                            </grid>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </idspace>
</zk>