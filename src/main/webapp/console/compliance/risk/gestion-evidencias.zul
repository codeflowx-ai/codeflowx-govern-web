<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

	<idspace
		viewModel="@id('vm') @init('com.suinsit.compliance.web.EvidenceManagementUI')">
		<custom-attributes namespace="compliance" />
<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="#" onClick="@command('navigateToForms')">Formularios</a>
                </li>
                <li class="breadcrumb-item active" if="${vm.initialFormId != null}">
                    ${vm.formCode}
                </li>
                <li class="breadcrumb-item active">Evidencias</li>
            </ol>
        </nav>
    </div>
</div>
		<div class="container-fluid">
			<!-- Header -->
			<div class="row mb-3">
				<div class="col-12">
					<h:h2 class="text-primary">
						Gestión de Evidencias
					</h:h2>
				</div>
			</div>

			<!-- Filtros -->
			<div class="row mb-4">
				<div class="col-md-3">
					<div class="form-group">
						<h:label>Respuesta</h:label>
						<combobox model="@load(vm.answers)"
							selectedItem="@bind(vm.selectedAnswer)"
							onSelect="@command('onAnswerSelect')" class="form-control">
							<template name="model">
								<comboitem>
									<div class="d-flex flex-column">
										<span>
											${each.questionText}
										</span>
										<small class="text-muted">
											Estado: ${each.status}
										</small>
									</div>
								</comboitem>
							</template>
						</combobox>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<h:label>Estado</h:label>
						<combobox model="@load(vm.statuses)"
							selectedItem="@bind(vm.selectedStatus)"
							onSelect="@command('onStatusSelect')" class="form-control">
							<template name="model">
								<comboitem label="@load(each)" />
							</template>
						</combobox>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<h:label>Tipo</h:label>
						<combobox model="@load(vm.fileTypes)"
							selectedItem="@bind(vm.selectedFileType)"
							onSelect="@command('onFileTypeSelect')" class="form-control">
							<template name="model">
								<comboitem label="@load(each)" />
							</template>
						</combobox>
					</div>
				</div>
				<div class="col-md-3 d-flex align-items-end">
					<h:button class="btn btn-primary"
						onClick="@command('uploadEvidence')">
						<i class="fas fa-upload"></i>
						Subir Evidencia
					</h:button>
				</div>
			</div>

			<!-- Lista de Evidencias -->
			<div class="row">
				<div class="col-12">
					<div class="card">
						<div class="card-body">
							<grid model="@load(vm.evidences)"
								mold="paging" pageSize="10"
								emptyMessage="No se encontraron evidencias">
								<columns>
									<column label="Código"
										width="120px" />
									<column label="Archivo" />
									<column label="Descripción" />
									<column label="Tipo" width="100px" />
									<column label="Tamaño"
										width="100px" />
									<column label="Estado"
										width="120px" />
									<column label="Fecha" width="150px" />
									<column label="Acciones"
										width="200px" align="center" />
								</columns>
								<template name="model">
									<row>
										<cell>
											${each.evidenceCode}
										</cell>
										<cell>${each.fileName}</cell>
										<cell>${each.description}</cell>
										<cell>
											<label
												sclass="${each.fileType == 'PDF' ? 'badge badge-danger' : 
                              each.fileType == 'IMAGE' ? 'badge badge-info' : 
                              'badge badge-secondary'}">
												${each.fileType}
											</label>
										</cell>
										<cell>
											${each.formattedSize}
										</cell>
										<cell>
											<label
												sclass="${each.validationStatus == 'APPROVED' ? 'badge badge-success' : 
                              each.validationStatus == 'REJECTED' ? 'badge badge-danger' : 
                              each.validationStatus == 'PENDING' ? 'badge badge-warning' : 
                              'badge badge-info'}">
												${each.validationStatus}
											</label>
										</cell>
										<cell>
											${each.formattedDate}
										</cell>
										<cell>
											<div class="btn-group">
												<h:button
													class="btn btn-sm btn-info"
													onClick="@command('viewEvidence', evidence=each)"
													tooltiptext="Ver" disabled="@load(empty each.fileName)">
													<i
														class="fas fa-eye">
													</i>
												</h:button>
												<h:button
													class="btn btn-sm btn-success"
													onClick="@command('downloadEvidence', evidence=each)"
													tooltiptext="Descargar"
													disabled="@load(empty each.fileName)">
													<i
														class="fas fa-download">
													</i>
												</h:button>
												<h:button
													class="btn btn-sm btn-warning"
													onClick="@command('validateEvidence', evidence=each)"
													visible="${each.validationStatus == 'PENDING'}"
													tooltiptext="Validar">
													<i
														class="fas fa-check">
													</i>
												</h:button>
											</div>
										</cell>
									</row>
								</template>
							</grid>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal Upload -->
		<window id="uploadModal" title="Subir Evidencia" mode="modal"
			visible="@load(vm.showUploadModal)" position="center" closable="true"
			onClose="@command('closeUploadModal')" width="500px">
			<div class="modal-body">
				<div class="form-group">
					<h:label>Nombre del archivo</h:label>
					<textbox value="@bind(vm.newEvidence.fileName)"
						class="form-control" />
				</div>
				<div class="form-group">
					<h:label>Descripción</h:label>
					<textbox value="@bind(vm.newEvidence.description)"
						class="form-control" rows="3" />
				</div>
				<div class="form-group">
					<h:label>Respuesta asociada</h:label>
					<longbox
						value="@bind(vm.newEvidence.idxcmpformanswer)"
						class="form-control" />
				</div>
				<div class="form-group">
					<h:label>Archivo</h:label>
					<button upload="true"
						onUpload="@command('onFileUpload', upEvent=event)"
						class="btn btn-outline-primary btn-block">
						<i class="fas fa-cloud-upload-alt"></i>
						Seleccionar Archivo
					</button>
				</div>
			</div>
		</window>

		<!-- Modal Validación -->
		<window id="validateModal" title="Validar Evidencia"
			mode="modal" visible="@load(vm.showValidateModal)" position="center"
			closable="true" onClose="@command('closeValidateModal')"
			width="500px">
			<div class="modal-body">
				<div class="form-group">
					<h:label>Estado</h:label>
					<radiogroup
						selectedItem="@bind(vm.validationStatus)">
						<radio label="Aprobar" value="APPROVED" />
						<radio label="Rechazar" value="REJECTED" />
					</radiogroup>
				</div>
				<div class="form-group">
					<h:label>Comentario</h:label>
					<textbox value="@bind(vm.validationComment)"
						class="form-control" rows="3" />
				</div>
				<div class="text-right mt-3">
					<button class="btn btn-secondary"
						onClick="@command('closeValidateModal')">
						Cancelar
					</button>
					<button class="btn btn-primary"
						onClick="@command('saveValidation')">
						Guardar
					</button>
				</div>
			</div>
		</window>
	</idspace>
</zk>