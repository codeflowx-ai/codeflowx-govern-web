<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    
    <div viewModel="@id('vm') @init('com.suinsit.compliance.web.MetricExplorerVM')"
         class="metric-explorer-container">
        
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h:h2>Explorador de Métricas</h:h2>
            <div class="d-flex gap-3">
                <button class="btn btn-outline-primary" 
                        onClick="@command('refreshData')">
                    <i class="fas fa-sync"></i> Actualizar
                </button>
            </div>
        </div>

        <!-- Critical Metrics Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h:h5 class="mb-0">Métricas Críticas</h:h5>
                    </div>
                    <div class="card-body">
                        <grid model="@load(vm.criticalMetrics)" 
                              emptyMessage="No hay métricas críticas"
                              class="table table-hover">
                            <columns>
                                <column label="Nombre" />
                                <column label="Valor" />
                                <column label="Estado" />
                                <column label="Última Actualización" />
                                <column label="Acciones" />
                            </columns>
                            <template name="model">
                                <row>
                                    <label value="@load(each.metricName)" />
                                    <label value="@load(each.currentValue)" />
                                    <label value="@load(each.metricStatus)" 
                                           sclass="@load(vm.getStatusClass(each.metricStatus))" />
                                    <label value="@load(vm.formatDateTime(each.lastCalculation))" />
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-primary"
                                                onClick="@command('showDetail', metric=each)">
                                            <i class="fas fa-chart-line"></i>
                                        </button>
                                    </div>
                                </row>
                            </template>
                        </grid>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Detail Modal -->
        <window id="metricDetailModal" visible="@load(vm.showingDetail)"
                position="center" mode="modal" class="metric-detail-modal">
            <div class="modal-header">
                <h:h5>Detalle de Métrica: @load(vm.selectedMetric.metricName)</h:h5>
                <button class="btn-close" onClick="@command('closeDetail')" />
            </div>
            <div class="modal-body">
                <!-- Metric Chart -->
                <div class="mb-4">
                    <charts id="metricChart" 
                           type="line" 
                           model="@load(vm.chartModel)"
                           width="100%" 
                           height="300px"/>
                </div>

                <!-- Metric Info -->
                <div class="row">
                    <div class="col-md-6">
                        <h:h6>Información General</h:h6>
                        <div class="mb-3">
                            <label>Valor Actual:</label>
                            <span class="ms-2">@load(vm.selectedMetric.currentValue)</span>
                        </div>
                        <div class="mb-3">
                            <label>Estado:</label>
                            <span class="ms-2 @load(vm.getStatusClass(vm.selectedMetric.metricStatus))">
                                @load(vm.selectedMetric.metricStatus)
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h:h6>Análisis</h:h6>
                        <div class="mb-3">
                            <label>Tendencia:</label>
                            <span class="ms-2">@load(vm.selectedMetric.trendIndicator)</span>
                        </div>
                        <div class="mb-3">
                            <label>Predicción:</label>
                            <span class="ms-2">@load(vm.selectedMetric.shortTermPrediction)</span>
                        </div>
                    </div>
                </div>
            </div>
        </window>
    </div>
</zk>