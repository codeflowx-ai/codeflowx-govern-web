<!-- /src/main/resources/web/views/compliance/dashboard-main.zul -->
<?page title="Dashboard de Monitorización" contentType="text/html;charset=UTF-8"?>
<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    
    <div viewModel="@id('vm') @init('com.suinsit.compliance.web.DashboardMainVM')"
         class="dashboard-container">
        
        <!-- Header con filtros y controles -->
        <div class="dashboard-header d-flex justify-content-between align-items-center p-3">
            <div class="dashboard-title">
                <h:h2 class="mb-0">Dashboard de Monitorización</h:h2>
                <h:p class="text-muted">Última actualización: @load(vm.lastUpdateFormatted)</h:p>
            </div>
            
            <div class="dashboard-controls d-flex gap-3">
                <button iconSclass="fas fa-sync" 
                        class="btn btn-primary"
                        onClick="@command('refreshDashboard')"
                        disabled="@load(vm.loading)">
                    Actualizar
                </button>
            </div>
        </div>

        <!-- Loader -->
        <div class="loading-overlay" visible="@load(vm.loading)">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
        
        <!-- Métricas Críticas -->
        <div class="row g-3 mb-4">
            <forEach items="@load(vm.criticalMetrics)">
                <div class="col-md-3">
                    <div class="card metric-card ${each.status}">
                        <div class="card-body">
                            <h:h5 class="card-title">${each.name}</h:h5>
                            <h:h3 class="metric-value">${each.value}</h:h3>
                            <h:p class="metric-status ${each.status}">
                                <i class="fas ${each.statusIcon}"></i>
                                ${each.status}
                            </h:p>
                        </div>
                    </div>
                </div>
            </forEach>
        </div>

        <!-- Alertas Activas -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h:h5 class="mb-0">Alertas Activas</h:h5>
                        <span class="badge bg-danger">@load(vm.activeAlertsCount)</span>
                    </div>
                    <div class="card-body">
                        <grid model="@load(vm.activeAlerts)" 
                              emptyMessage="No hay alertas activas"
                              class="table table-hover">
                            <columns>
                                <column label="Severidad" width="120px"/>
                                <column label="Título"/>
                                <column label="Estado" width="150px"/>
                                <column label="Tiempo" width="200px"/>
                                <column label="Acciones" width="150px"/>
                            </columns>
                            <template name="model">
                                <row>
                                    <label value="@load(each.severity)" 
                                           sclass="severity-badge ${each.severityClass}"/>
                                    <label value="@load(each.title)"/>
                                    <label value="@load(each.status)"
                                           sclass="status-badge ${each.statusClass}"/>
                                    <label value="@load(each.createdAt)"/>
                                    <div class="btn-group">
                                        <button iconSclass="fas fa-check"
                                                tooltiptext="Reconocer"
                                                onClick="@command('acknowledgeAlert', alert=each)"
                                                class="btn btn-sm btn-outline-success"
                                                disabled="@load(each.acknowledged)"/>
                                    </div>
                                </row>
                            </template>
                        </grid>
                    </div>
                </div>
            </div>
        </div>
    </div>
</zk>