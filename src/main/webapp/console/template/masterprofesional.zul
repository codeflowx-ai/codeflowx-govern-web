<idspace  id="profesional" viewModel="@id('vm') @init('org.suinsit.nocode.web.ProptotipeMasterUI',pagina='profesional')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="profesional" />
	<custom-attributes clase="org.suinsit.apps.inmobiliaria.Profesional" />
	   <custom-attributes namespace="inmobiliaria" />
	    <custom-attributes enviroment="preview" />
	     <custom-attributes uid="129688242" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
			<div class="row">
			<div class="col-12">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between  tab-border">
					<vbox spacing="3px">
					<fragment
						exps="profesional">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									Menú 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								profesional
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
			<div class="row">
					<div class="col-lg-12 prof-sh">
				<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							<button onClick="@command('toSearch')"
							iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
										class="btn btn-primary btn-light" >
										Volver
									</button>	
							</div>
							<div class="flex-shrink-0">
							<div class="hstack d-flex text-nowrap gap-2">
								
								    <button class="btn btn-secondary"
										iconSclass="fa-duotone fa-paintbrush-fine" >
										Limpiar
									</button>
									<button class="btn btn-primary"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" >
										Guardar
									</button>
									<button
										class="btn btn-success" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" >
										Guardar y Nuevo
									</button>
								
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<h:div class="col-lg-12">
						<h:div >
							<h:div >
		     <div class="row">


