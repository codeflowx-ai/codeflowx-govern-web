<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml">

	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.ExecuteCorrectiveActionViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-tasks me-2"></h:i>
						Execute Corrective Action
					</h:h2>
					<h:p class="text-muted">
						Execute and document corrective action progress
					</h:p>
				</div>
			</div>

			<!-- Action Info -->
			<div class="col-lg-12 s-bot">
				<div class="card border-primary">
					<div class="card-header bg-primary text-white">
						<h:h5 class="card-title mb-0">Action #{label value="@load(vm.correctiveActionIndex + 1)" /></h:h5>
					</div>
					<div class="card-body">
						<h:p class="mb-2"><strong>Type:</strong>
							<h:span class="badge bg-secondary"><label value="@load(vm.actionType)" /></h:span>
						</h:p>
						<h:p class="mb-0"><strong>Description:</strong> <label value="@load(vm.correctiveActionDescription)" /></h:p>
					</div>
				</div>
			</div>

			<!-- Action Completed Checkbox -->
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header bg-success text-white">
						<h:h5 class="card-title mb-0">Completion Status</h:h5>
					</div>
					<div class="card-body">
						<div class="form-check">
							<checkbox id="actionCompleted" checked="@bind(vm.actionCompleted)" />
							<label for="actionCompleted" class="form-check-label ms-2">
								<strong>✓ Action COMPLETED</strong> - This corrective action has been fully executed
							</label>
						</div>
					</div>
				</div>
			</div>

			<!-- Action Evidence -->
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Execution Evidence *</h:h5>
						<textbox rows="4" width="100%" value="@bind(vm.actionEvidence)"
						         placeholder="Provide evidence of action execution (code changes, tests performed, deployments, etc.)..." />
					</div>
				</div>
			</div>

			<!-- Action Notes -->
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Additional Notes</h:h5>
						<textbox rows="3" width="100%" value="@bind(vm.actionNotes)"
						         placeholder="Any additional notes about the execution process, challenges faced, etc..." />
					</div>
				</div>
			</div>

			<!-- Submit Button -->
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<button label="Complete Action"
						        iconSclass="fa fa-check-circle"
						        zclass="btn btn-success btn-lg"
						        onClick="@command('completeAction')" />
					</div>
				</div>
			</div>

		</div>
	</idspace>
</zk>
