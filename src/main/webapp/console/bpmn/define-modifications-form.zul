<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml">
	
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.fria.DefineModificationsViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-screwdriver-wrench me-2"></h:i>
						Define System Modifications
					</h:h2>
					<h:p class="text-muted">
						Enhanced review requires system modifications before deployment
					</h:p>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Required System Modifications *</h:h5>
						<textbox rows="5" width="100%" value="@bind(vm.modificationsRequired)" 
						         placeholder="Describe technical, procedural, or design modifications required..." />
					</div>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Mitigation Measures</h:h5>
						<textbox rows="4" width="100%" value="@bind(vm.mitigationMeasures)" 
						         placeholder="Additional safeguards and mitigation measures..." />
					</div>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Implementation Plan</h:h5>
						<textbox rows="4" width="100%" value="@bind(vm.implementationPlan)" 
						         placeholder="Timeline and plan for implementing modifications..." />
					</div>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<button label="Submit Modifications" 
						        iconSclass="fa fa-check"
						        zclass="btn btn-primary btn-lg"
						        onClick="@command('submitModifications')" />
					</div>
				</div>
			</div>
		</div>
	</idspace>
</zk>

