<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Implementar acción correctiva"
            width="70%"
            height="60%"
            border="normal"
            closable="true"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.CorrectiveActionImplementationViewModel')">

        <vlayout sclass="p-4" spacing="14px">
            <groupbox mold="3d" width="100%">
                <caption label="Implementación"/>
                <grid width="100%">
                    <rows>
                        <row>
                            <label value="Descripción implementación" sclass="font-weight-bold"/>
                            <textbox value="@bind(vm.implementationSummary)"
                                     width="100%"
                                     rows="5"
                                     multiline="true"
                                     placeholder="Explica acciones realizadas, recursos y controles aplicados"/>
                        </row>
                        <row>
                            <label value="Fecha finalización" sclass="font-weight-bold"/>
                            <datebox value="@bind(vm.completionDate)"
                                     format="yyyy-MM-dd"
                                     width="200px"/>
                        </row>
                        <row>
                            <label value="Evidencia" sclass="font-weight-bold"/>
                            <textbox value="@bind(vm.evidenceLink)"
                                     width="100%"
                                     placeholder="URL o referencia de evidencia"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <hlayout hflex="1" pack="end" spacing="12px">
                <button label="Cancelar" onClick="@command('doCancel')" width="120px"/>
                <button label="Registrar implementación"
                        onClick="@command('doSubmit')"
                        width="190px"
                        sclass="btn-primary"/>
            </hlayout>
        </vlayout>
    </window>
</zk>


