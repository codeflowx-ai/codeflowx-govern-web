<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Aprobar plan de capacitación"
            width="75%"
            height="65%"
            border="normal"
            closable="true"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.CompetenceGapApprovalViewModel')">

        <vlayout sclass="p-4" spacing="16px">
            <groupbox mold="3d" width="100%">
                <caption label="Plan generado"/>
                <textbox value="@load(vm.trainingPlan != null ? vm.trainingPlan.toString() : 'Plan no disponible')"
                         width="100%"
                         rows="10"
                         multiline="true"
                         readonly="true"/>
            </groupbox>

            <groupbox mold="3d" width="100%">
                <caption label="Decisión"/>
                <grid width="100%">
                    <rows>
                        <row>
                            <label value="Resultado" sclass="font-weight-bold"/>
                            <radiogroup selectedItem="@bind(vm.approved)">
                                <radio label="Aprobar" value="true"/>
                                <radio label="Solicitar ajustes" value="false"/>
                            </radiogroup>
                        </row>
                        <row>
                            <label value="Notas" sclass="font-weight-bold"/>
                            <textbox value="@bind(vm.approvalNotes)"
                                     width="100%"
                                     rows="4"
                                     multiline="true"
                                     placeholder="Condiciones, ajustes o comentarios"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>
        </vlayout>

        <hlayout hflex="1" pack="end" spacing="12px" style="padding: 16px;">
            <button label="Cancelar" width="120px" onClick="@command('doCancel')"/>
            <button label="Registrar decisión" width="170px" sclass="btn-primary" onClick="@command('doSubmit')"/>
        </hlayout>
    </window>
</zk>


