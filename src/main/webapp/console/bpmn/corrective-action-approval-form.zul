<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Aprobar acción correctiva"
            width="70%"
            height="60%"
            border="normal"
            closable="true"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.CorrectiveActionApprovalViewModel')">

        <vlayout sclass="p-4" spacing="14px">
            <groupbox mold="3d" width="100%">
                <caption label="Plan propuesto"/>
                <textbox value="@bind(vm.correctiveActionPlan)"
                         width="100%"
                         rows="8"
                         readonly="true"/>
            </groupbox>

            <groupbox mold="3d" width="100%">
                <caption label="Decisión"/>
                <grid width="100%">
                    <rows>
                        <row>
                            <label value="Resultado" sclass="font-weight-bold"/>
                            <combobox selectedItem="@bind(vm.approvalDecision)" width="200px">
                                <comboitem label="APPROVED"/>
                                <comboitem label="REJECTED"/>
                                <comboitem label="REVISE"/>
                            </combobox>
                        </row>
                        <row>
                            <label value="Observaciones" sclass="font-weight-bold"/>
                            <textbox value="@bind(vm.approvalNotes)"
                                     width="100%"
                                     rows="4"
                                     multiline="true"
                                     placeholder="Comentarios o requisitos adicionales"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <hlayout hflex="1" pack="end" spacing="12px">
                <button label="Cancelar" onClick="@command('doCancel')" width="120px"/>
                <button label="Registrar decisión"
                        onClick="@command('doSubmit')"
                        width="170px"
                        sclass="btn-primary"/>
            </hlayout>
        </vlayout>
    </window>
</zk>


