<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window title="Plan de retención y anonimización"
            width="70%"
            height="60%"
            border="normal"
            closable="true"
            apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('com.codeflowx.govern.workflow.viewmodels.AIDecommissionRetentionViewModel')">

        <vlayout sclass="p-4" spacing="14px">
            <groupbox mold="3d" width="100%">
                <caption label="Estrategia de retención"/>
                <textbox value="@bind(vm.retentionStrategy)"
                         width="100%"
                         rows="6"
                         multiline="true"
                         placeholder="Definir periodos de retención, ubicaciones y controles de acceso"/>
            </groupbox>

            <groupbox mold="3d" width="100%">
                <caption label="Datos adicionales"/>
                <grid width="100%">
                    <rows>
                        <row>
                            <label value="Fin retención" sclass="font-weight-bold"/>
                            <datebox value="@bind(vm.retentionEndDate)"
                                     format="yyyy-MM-dd"
                                     width="200px"/>
                        </row>
                        <row>
                            <label value="Anonimización / eliminación" sclass="font-weight-bold"/>
                            <textbox value="@bind(vm.anonymizationDetails)"
                                     width="100%"
                                     rows="4"
                                     multiline="true"
                                     placeholder="Procedimientos de anonimización, tokens o hashing aplicado"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <hlayout hflex="1" pack="end" spacing="12px">
                <button label="Cancelar" onClick="@command('doCancel')" width="120px"/>
                <button label="Guardar plan"
                        onClick="@command('doSubmit')"
                        width="150px"
                        sclass="btn-primary"
                        disabled="@load(vm.retentionStrategy == null || vm.retentionStrategy.isEmpty())"/>
            </hlayout>
        </vlayout>
    </window>
</zk>


