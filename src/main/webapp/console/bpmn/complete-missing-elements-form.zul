<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml">
	
	<idspace
		viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.fria.CompleteMissingElementsViewModel')"
		validationMessages="@id('vmsgs')">

		<div class="row">
			<div>
				<div class="left tittle-principal">
					<h:h2 class="mb-sm-0">
						<h:i class="fa-sharp-duotone fa-solid fa-clipboard-list me-2"></h:i>
						Complete Missing FRIA Elements (Art. 27)
					</h:h2>
					<h:p class="text-muted">
						FRIA incomplete - please complete missing elements
					</h:p>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card border-warning">
					<div class="card-header bg-warning">
						<h:h5 class="card-title mb-0">⚠️ FRIA Incomplete</h:h5>
					</div>
					<div class="card-body">
						<h:p class="mb-2"><strong>FRIA Score:</strong> <label value="@load(vm.friaScore)" />%</h:p>
						<h:p class="mb-0"><strong>Missing Elements:</strong></h:p>
						<h:pre class="mt-2"><label value="@load(vm.missingElements)" /></h:pre>
					</div>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<h:h5 class="mb-2">Completion Notes</h:h5>
						<textbox rows="5" width="100%" value="@bind(vm.completionNotes)" 
						         placeholder="Describe what elements have been completed..." />
					</div>
				</div>
			</div>

			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-body">
						<button label="Retry FRIA Generation" 
						        iconSclass="fa fa-rotate-right"
						        zclass="btn btn-primary btn-lg"
						        onClick="@command('retryFria')" />
					</div>
				</div>
			</div>
		</div>
	</idspace>
</zk>

