<?page title="Model Comparison" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.marketplace.comparison.ModelComparisonVM')">
        
        <!-- Model Selection -->
        <hlayout sclass="comparison-header">
            <combobox model="@load(vm.availableModels)" 
                     selectedItem="@bind(vm.selectedModel1)"
                     placeholder="Select first model"/>
            <combobox model="@load(vm.availableModels)" 
                     selectedItem="@bind(vm.selectedModel2)"
                     placeholder="Select second model"/>
            <button label="Compare" 
                    onClick="@command('compareModels')"
                    disabled="@load(empty vm.selectedModel1 or empty vm.selectedModel2)"/>
            <button label="Clear" 
                    onClick="@command('clearComparison')"/>
        </hlayout>

        <!-- Comparison Results -->
        <div visible="@load(vm.comparisonActive)">
            <!-- Performance Metrics -->
            <groupbox title="Performance Comparison">
                <grid model="@load(vm.performanceMetrics)">
                    <columns>
                        <column label="Metric"/>
                        <column label="@load(vm.selectedModel1.name)"/>
                        <column label="Difference"/>
                        <column label="@load(vm.selectedModel2.name)"/>
                    </columns>
                    <template name="model" var="metric">
                        <row>
                            <label value="@load(metric.name)"/>
                            <label value="@load(metric.value1)" 
                                   sclass="@load(metric.value1Style)"/>
                            <label value="@load(metric.difference)" 
                                   sclass="@load(metric.differenceStyle)"/>
                            <label value="@load(metric.value2)" 
                                   sclass="@load(metric.value2Style)"/>
                        </row>
                    </template>
                </grid>
            </groupbox>

            <!-- Feature Comparison -->
            <groupbox title="Feature Comparison">
                <grid model="@load(vm.featureComparison)">
                    <columns>
                        <column label="Feature"/>
                        <column label="@load(vm.selectedModel1.name)"/>
                        <column label="@load(vm.selectedModel2.name)"/>
                    </columns>
                    <template name="model" var="feature">
                        <row>
                            <label value="@load(feature.name)"/>
                            <div>
                                <label value="@load(feature.value1)"/>
                                <image src="@load(feature.supported1 ? '/images/check.png' : '/images/cross.png')"/>
                            </div>
                            <div>
                                <label value="@load(feature.value2)"/>
                                <image src="@load(feature.supported2 ? '/images/check.png' : '/images/cross.png')"/>
                            </div>
                        </row>
                    </template>
                </grid>
            </groupbox>

            <!-- Cost Analysis -->
            <groupbox title="Cost Analysis">
                <hlayout>
                    <charts id="costComparisonChart" 
                           type="column"
                           height="300px"
                           title="Cost Comparison"
                           model="@load(vm.costComparisonData)"/>
                    
                    <grid model="@load(vm.costAnalysis)">
                        <columns>
                            <column label="Scenario"/>
                            <column label="@load(vm.selectedModel1.name)"/>
                            <column label="@load(vm.selectedModel2.name)"/>
                            <column label="Savings"/>
                        </columns>
                        <template name="model" var="cost">
                            <row>
                                <label value="@load(cost.scenario)"/>
                                <label value="$@load(cost.cost1)"/>
                                <label value="$@load(cost.cost2)"/>
                                <label value="@load(cost.savings)" 
                                       sclass="@load(cost.savingsStyle)"/>
                            </row>
                        </template>
                    </grid>
                </hlayout>
            </groupbox>

            <!-- Use Case Analysis -->
            <groupbox title="Use Case Suitability">
                <grid model="@load(vm.useCaseAnalysis)">
                    <columns>
                        <column label="Use Case"/>
                        <column label="@load(vm.selectedModel1.name)"/>
                        <column label="@load(vm.selectedModel2.name)"/>
                        <column label="Recommendation"/>
                    </columns>
                    <template name="model" var="useCase">
                        <row>
                            <label value="@load(useCase.name)"/>
                            <progressmeter value="@load(useCase.suitability1)"/>
                            <progressmeter value="@load(useCase.suitability2)"/>
                            <label value="@load(useCase.recommendation)" 
                                   sclass="@load(useCase.recommendationStyle)"/>
                        </row>
                    </template>
                </grid>
            </groupbox>

            <!-- Community Feedback -->
            <groupbox title="Community Feedback">
                <hlayout>
                    <charts id="ratingComparisonChart" 
                           type="radar"
                           height="300px"
                           title="Rating Comparison"
                           model="@load(vm.ratingComparisonData)"/>
                    
                    <grid model="@load(vm.communityFeedback)">
                        <columns>
                            <column label="Aspect"/>
                            <column label="@load(vm.selectedModel1.name)"/>
                            <column label="@load(vm.selectedModel2.name)"/>
                        </columns>
                        <template name="model" var="feedback">
                            <row>
                                <label value="@load(feedback.aspect)"/>
                                <vlayout>
                                    <rating value="@load(feedback.rating1)" 
                                           readonly="true"/>
                                    <label value="@load(feedback.comments1)"/>
                                </vlayout>
                                <vlayout>
                                    <rating value="@load(feedback.rating2)" 
                                           readonly="true"/>
                                    <label value="@load(feedback.comments2)"/>
                                </vlayout>
                            </row>
                        </template>
                    </grid>
                </hlayout>
            </groupbox>

            <!-- Final Recommendation -->
            <groupbox title="Final Recommendation">
                <vlayout>
                    <label value="@load(vm.recommendation.summary)" 
                           style="font-size: 16px; font-weight: bold"/>
                    <grid model="@load(vm.recommendation.details)">
                        <columns>
                            <column label="Factor"/>
                            <column label="Recommendation"/>
                            <column label="Reasoning"/>
                        </columns>
                        <template name="model" var="detail">
                            <row>
                                <label value="@load(detail.factor)"/>
                                <label value="@load(detail.recommendation)" 
                                       sclass="@load(detail.recommendationStyle)"/>
                                <label value="@load(detail.reasoning)"/>
                            </row>
                        </template>
                    </grid>
                </vlayout>
            </groupbox>
        </div>
    </div>
</zk>