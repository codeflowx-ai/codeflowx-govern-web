<?page title="Advanced Marketplace" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.marketplace.MarketplaceVM')">
        
        <!-- Marketplace Overview -->
        <hlayout sclass="marketplace-header">
            <div sclass="metric-box">
                <label value="Available Models"/>
                <label value="@load(vm.availableModels)"/>
            </div>
            <div sclass="metric-box">
                <label value="Active Users"/>
                <label value="@load(vm.activeUsers)"/>
            </div>
            <div sclass="metric-box">
                <label value="Total Revenue"/>
                <label value="$@load(vm.totalRevenue)"/>
            </div>
            <div sclass="metric-box">
                <label value="Avg Rating"/>
                <label value="@load(vm.avgRating)/5"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Model Catalog"/>
                <tab label="Prompt Library"/>
                <tab label="Recommendations"/>
                <tab label="Reviews & Ratings"/>
                <tab label="Licensing"/>
            </tabs>
            <tabpanels>
                <!-- Model Catalog Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Search and Filters -->
                        <hlayout sclass="search-container">
                            <textbox value="@bind(vm.searchTerm)" 
                                    placeholder="Search models..."
                                    onOK="@command('search')"/>
                            <combobox model="@load(vm.categories)" 
                                     selectedItem="@bind(vm.selectedCategory)"
                                     placeholder="Category"/>
                            <combobox model="@load(vm.providers)" 
                                     selectedItem="@bind(vm.selectedProvider)"
                                     placeholder="Provider"/>
                            <button label="Search" 
                                    onClick="@command('search')"/>
                            <button label="Advanced Filters" 
                                    onClick="@command('showAdvancedFilters')"/>
                        </hlayout>

                        <!-- Featured Models Carousel -->
                        <carousel id="featuredModels" 
                                 model="@load(vm.featuredModels)"
                                 selectedItem="@bind(vm.selectedModel)">
                            <template name="model" var="model">
                                <div sclass="featured-model-card">
                                    <image src="@load(model.imageUrl)"/>
                                    <label value="@load(model.name)" 
                                           sclass="model-name"/>
                                    <label value="@load(model.description)" 
                                           sclass="model-description"/>
                                    <rating value="@load(model.rating)"/>
                                </div>
                            </template>
                        </carousel>

                        <!-- Models Grid -->
                        <grid model="@load(vm.models)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Model"/>
                                <column label="Provider"/>
                                <column label="Category"/>
                                <column label="Rating"/>
                                <column label="Price"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="model">
                                <row>
                                    <vlayout>
                                        <label value="@load(model.name)" 
                                               style="font-weight: bold"/>
                                        <label value="@load(model.shortDescription)"/>
                                    </vlayout>
                                    <label value="@load(model.provider)"/>
                                    <label value="@load(model.category)"/>
                                    <hlayout>
                                        <rating value="@load(model.rating)" 
                                               readonly="true"/>
                                        <label value="(@load(model.reviewCount))"/>
                                    </hlayout>
                                    <label value="@load(model.priceDisplay)"/>
                                    <label value="@load(model.status)" 
                                           sclass="@load(model.statusStyle)"/>
                                    <hlayout>
                                        <button label="Details" 
                                                onClick="@command('showModelDetails', model=model)"/>
                                        <button label="Compare" 
                                                onClick="@command('addToComparison', model=model)"/>
                                        <button label="Try" 
                                                onClick="@command('tryModel', model=model)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Prompt Library Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Prompt Categories -->
                        <hlayout>
                            <forEach items="@load(vm.promptCategories)" 
                                    var="category">
                                <button label="@load(category.name)" 
                                        onClick="@command('filterPrompts', category=category)"
                                        sclass="@load(category.selected ? 'selected' : '')"/>
                            </forEach>
                        </hlayout>

                        <!-- Prompts Grid -->
                        <grid model="@load(vm.prompts)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Prompt"/>
                                <column label="Purpose"/>
                                <column label="Model Compatibility"/>
                                <column label="Rating"/>
                                <column label="Usage Count"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="prompt">
                                <row>
                                    <vlayout>
                                        <label value="@load(prompt.name)" 
                                               style="font-weight: bold"/>
                                        <label value="@load(prompt.description)"/>
                                    </vlayout>
                                    <label value="@load(prompt.purpose)"/>
                                    <div>
                                        <forEach items="@load(prompt.compatibleModels)" 
                                                var="model">
                                            <label value="@load(model)" 
                                                   sclass="model-tag"/>
                                        </forEach>
                                    </div>
                                    <hlayout>
                                        <rating value="@load(prompt.rating)" 
                                               readonly="true"/>
                                        <label value="(@load(prompt.reviewCount))"/>
                                    </hlayout>
                                    <label value="@load(prompt.usageCount)"/>
                                    <hlayout>
                                        <button label="Use" 
                                                onClick="@command('usePrompt', prompt=prompt)"/>
                                        <button label="Customize" 
                                                onClick="@command('customizePrompt', prompt=prompt)"/>
                                        <button label="Save" 
                                                onClick="@command('savePrompt', prompt=prompt)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Recommendations Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Personalized Recommendations -->
                        <groupbox title="Recommended for You">
                            <grid model="@load(vm.personalizedRecommendations)">
                                <columns>
                                    <column label="Model/Prompt"/>
                                    <column label="Why Recommended"/>
                                    <column label="Match Score"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="rec">
                                    <row>
                                        <vlayout>
                                            <label value="@load(rec.name)" 
                                                   style="font-weight: bold"/>
                                            <label value="@load(rec.description)"/>
                                        </vlayout>
                                        <label value="@load(rec.reason)"/>
                                        <progressmeter value="@load(rec.matchScore)"/>
                                        <hlayout>
                                            <button label="View" 
                                                    onClick="@command('viewRecommendation', rec=rec)"/>
                                            <button label="Hide" 
                                                    onClick="@command('hideRecommendation', rec=rec)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>

                        <!-- Popular Items -->
                        <groupbox title="Trending Now">
                            <listbox model="@load(vm.trendingItems)" 
                                    rows="5">
                                <template name="model" var="item">
                                    <listitem>
                                        <listcell>
                                            <hlayout>
                                                <image src="@load(item.icon)"/>
                                                <vlayout>
                                                    <label value="@load(item.name)" 
                                                           style="font-weight: bold"/>
                                                    <label value="@load(item.trend)"/>
                                                </vlayout>
                                                <space/>
                                                <button label="Explore" 
                                                        onClick="@command('exploreTrending', item=item)"/>
                                            </hlayout>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>
                    </vlayout>
                </tabpanel>

                <!-- Reviews & Ratings Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Reviews Summary -->
                        <hlayout>
                            <div width="30%">
                                <vlayout>
                                    <label value="Overall Rating" 
                                           style="font-size: 20px"/>
                                    <label value="@load(vm.overallRating)" 
                                           style="font-size: 48px"/>
                                    <rating value="@load(vm.overallRating)" 
                                           readonly="true"/>
                                    <label value="@load(vm.totalReviews) reviews"/>
                                </vlayout>
                                <!-- Rating Distribution -->
                                <grid model="@load(vm.ratingDistribution)">
                                    <template name="model" var="dist">
                                        <row>
                                            <label value="@load(dist.stars) stars"/>
                                            <progressmeter value="@load(dist.percentage)"/>
                                            <label value="@load(dist.count)"/>
                                        </row>
                                    </template>
                                </grid>
                            </div>

                            <!-- Reviews List -->
                            <div width="70%">
                                <listbox model="@load(vm.reviews)" 
                                        mold="paging" pageSize="5">
                                    <template name="model" var="review">
                                        <listitem>
                                            <listcell>
                                                <vlayout>
                                                    <hlayout>
                                                        <rating value="@load(review.rating)" 
                                                               readonly="true"/>
                                                        <label value="@load(review.title)" 
                                                               style="font-weight: bold"/>
                                                    </hlayout>
                                                    <label value="@load(review.comment)"/>
                                                    <hlayout>
                                                        <label value="By @load(review.author)"/>
                                                        <label value="on @load(review.date)"/>
                                                    </hlayout>
                                                    <hlayout>
                                                        <button label="Helpful (@load(review.helpfulCount))" 
                                                                onClick="@command('markHelpful', review=review)"/>
                                                        <button label="Report" 
                                                                onClick="@command('reportReview', review=review)"/>
                                                    </hlayout>
                                                </vlayout>
                                            </listcell>
                                        </listitem>
                                    </template>
                                </listbox>
                            </div>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Licensing Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- License Types -->
                        <grid model="@load(vm.licenseTypes)">
                            <columns>
                                <column label="License Type"/>
                                <column label="Features"/>
                                <column label="Restrictions"/>
                                <column label="Price"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="license">
                                <row>
                                    <label value="@load(license.name)" 
                                           style="font-weight: bold"/>
                                    <vlayout>
                                        <forEach items="@load(license.features)" 
                                                var="feature">
                                            <hlayout>
                                                <image src="/images/check.png"/>
                                                <label value="@load(feature)"/>
                                            </hlayout>
                                        </forEach>
                                    </vlayout>
                                    <vlayout>
                                        <forEach items="@load(license.restrictions)" 
                                                var="restriction">
                                            <label value="@load(restriction)"/>
                                        </forEach>
                                    </vlayout>
                                    <label value="@load(license.priceDisplay)"/>
                                    <hlayout>
                                        <button label="Select" 
                                                onClick="@command('selectLicense', license=license)"/>
                                        <button label="Details" 
                                                onClick="@command('showLicenseDetails', license=license)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Active Licenses -->
                        <groupbox title="Your Active Licenses">
                            <grid model="@load(vm.activeLicenses)">
                                <columns>
                                    <column label="Model/Prompt"/>
                                    <column label="License Type"/>
                                    <column label="Valid Until"/>
                                    <column label="Usage"/>
                                    <column label="Status"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="license">
                                    <row>
                                        <label value="@load(license.itemName)"/>
                                        <label value="@load(license.type)"/>
                                        <label value="@load(license.validUntil)"/>
                                        <vlayout>
                                            <progressmeter value="@load(license.usagePercentage)"/>
                                            <label value="@load(license.usageDisplay)"/>
                                        </vlayout>
                                        <label value="@load(license.status)" 
                                               sclass="@load(license.statusStyle)"/>
                                        <hlayout>
                                            <button label="Renew" 
                                                    onClick="@command('renewLicense', license=license)"/>
                                            <button label="Upgrade" 
                                                    onClick="@command('upgradeLicense', license=license)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="modelDetailsWindow" 
                title="Model Details" 
                visible="false" 
                mode="modal"
                width="80%"
                height="80%">
            <!-- Model Details Content -->
        </window>

        <window id="compareModelsWindow" 
                title="Compare Models" 
                visible="false" 
                mode="modal"
                width="90%"
                height="80%">
            <!-- Model Comparison Content -->
        </window>

        <window id="licenseDetailsWindow" 
                title="License Details" 
                visible="false" 
                mode="modal"
                width="600px">
            <!-- License Details Content -->
        </window>
    </div>
</zk>