<?page title="License & Pricing Management" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.marketplace.license.LicensePricingVM')">
        
        <!-- Overview Dashboard -->
        <hlayout sclass="license-header">
            <div sclass="metric-box">
                <label value="Active Licenses"/>
                <label value="@load(vm.activeLicenses)"/>
            </div>
            <div sclass="metric-box">
                <label value="Monthly Revenue"/>
                <label value="$@load(vm.monthlyRevenue)"/>
            </div>
            <div sclass="metric-box">
                <label value="Avg. License Value"/>
                <label value="$@load(vm.avgLicenseValue)"/>
            </div>
            <div sclass="metric-box">
                <label value="Renewal Rate"/>
                <label value="@load(vm.renewalRate)%"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="License Plans"/>
                <tab label="Dynamic Pricing"/>
                <tab label="Usage Analytics"/>
                <tab label="License Management"/>
            </tabs>
            <tabpanels>
                <!-- License Plans Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Plan Management -->
                        <hlayout>
                            <button label="Create New Plan" 
                                    onClick="@command('createPlan')"/>
                            <button label="Import Plans" 
                                    onClick="@command('importPlans')"/>
                            <button label="Export Plans" 
                                    onClick="@command('exportPlans')"/>
                        </hlayout>

                        <!-- License Plans Grid -->
                        <grid model="@load(vm.licensePlans)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Plan Name"/>
                                <column label="Type"/>
                                <column label="Features"/>
                                <column label="Base Price"/>
                                <column label="Dynamic Pricing"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="plan">
                                <row>
                                    <label value="@load(plan.name)"/>
                                    <label value="@load(plan.type)"/>
                                    <vlayout>
                                        <forEach items="@load(plan.features)" 
                                                var="feature">
                                            <hlayout>
                                                <image src="/images/check.png"/>
                                                <label value="@load(feature)"/>
                                            </hlayout>
                                        </forEach>
                                    </vlayout>
                                    <label value="@load(plan.basePrice)"/>
                                    <vlayout>
                                        <label value="@load(plan.dynamicPricingStatus)"/>
                                        <progressmeter value="@load(plan.utilizationRate)"/>
                                    </vlayout>
                                    <label value="@load(plan.status)" 
                                           sclass="@load(plan.statusStyle)"/>
                                    <hlayout>
                                        <button label="Edit" 
                                                onClick="@command('editPlan', plan=plan)"/>
                                        <button label="Configure Pricing" 
                                                onClick="@command('configurePricing', plan=plan)"/>
                                        <button label="Analytics" 
                                                onClick="@command('showAnalytics', plan=plan)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Dynamic Pricing Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Pricing Rules -->
                        <groupbox title="Pricing Rules">
                            <grid model="@load(vm.pricingRules)">
                                <columns>
                                    <column label="Rule Type"/>
                                    <column label="Condition"/>
                                    <column label="Adjustment"/>
                                    <column label="Status"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="rule">
                                    <row>
                                        <label value="@load(rule.type)"/>
                                        <label value="@load(rule.condition)"/>
                                        <label value="@load(rule.adjustment)"/>
                                        <label value="@load(rule.status)" 
                                               sclass="@load(rule.statusStyle)"/>
                                        <hlayout>
                                            <button label="Edit" 
                                                    onClick="@command('editRule', rule=rule)"/>
                                            <button label="Toggle" 
                                                    onClick="@command('toggleRule', rule=rule)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>

                        <!-- Price Optimization -->
                        <groupbox title="Price Optimization">
                            <hlayout>
                                <charts id="priceOptimizationChart" 
                                       type="line"
                                       height="300px"
                                       title="Price vs Demand"
                                       model="@load(vm.priceOptimizationData)"/>
                                
                                <charts id="revenueImpactChart" 
                                       type="column"
                                       height="300px"
                                       title="Revenue Impact"
                                       model="@load(vm.revenueImpactData)"/>
                            </hlayout>
                        </groupbox>
                    </vlayout>
                </tabpanel>

                <!-- Usage Analytics Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Usage Metrics -->
                        <hlayout>
                            <charts id="usageTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Usage Trends"
                                   model="@load(vm.usageTrendsData)"/>
                            
                            <charts id="licenseDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="License Distribution"
                                   model="@load(vm.licenseDistributionData)"/>
                        </hlayout>

                        <!-- Usage Details -->
                        <grid model="@load(vm.usageMetrics)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Metric"/>
                                <column label="Current Value"/>
                                <column label="Trend"/>
                                <column label="Change"/>
                                <column label="Forecast"/>
                            </columns>
                            <template name="model" var="metric">
                                <row>
                                    <label value="@load(metric.name)"/>
                                    <label value="@load(metric.currentValue)"/>
                                    <label value="@load(metric.trend)" 
                                           sclass="@load(metric.trendStyle)"/>
                                    <label value="@load(metric.change)" 
                                           sclass="@load(metric.changeStyle)"/>
                                    <label value="@load(metric.forecast)"/>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- License Management Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Active Licenses -->
                        <groupbox title="Active Licenses">
                            <grid model="@load(vm.activeLicensesList)" 
                                  mold="paging" pageSize="10">
                                <columns>
                                    <column label="License ID"/>
                                    <column label="Customer"/>
                                    <column label="Plan"/>
                                    <column label="Usage"/>
                                    <column label="Expiration"/>
                                    <column label="Status"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="license">
                                    <row>
                                        <label value="@load(license.id)"/>
                                        <label value="@load(license.customerName)"/>
                                        <label value="@load(license.planName)"/>
                                        <vlayout>
                                            <progressmeter value="@load(license.usagePercentage)"/>
                                            <label value="@load(license.usageDetails)"/>
                                        </vlayout>
                                        <label value="@load(license.expirationDate)"/>
                                        <label value="@load(license.status)" 
                                               sclass="@load(license.statusStyle)"/>
                                        <hlayout>
                                            <button label="Renew" 
                                                    onClick="@command('renewLicense', license=license)"/>
                                            <button label="Modify" 
                                                    onClick="@command('modifyLicense', license=license)"/>
                                            <button label="History" 
                                                    onClick="@command('showHistory', license=license)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>

                        <!-- License Alerts -->
                        <groupbox title="License Alerts">
                            <listbox model="@load(vm.licenseAlerts)" 
                                    mold="paging" pageSize="5">
                                <template name="model" var="alert">
                                    <listitem>
                                        <listcell>
                                            <hlayout>
                                                <image src="@load(alert.iconUrl)"/>
                                                <vlayout>
                                                    <label value="@load(alert.title)" 
                                                           style="font-weight: bold"/>
                                                    <label value="@load(alert.description)"/>
                                                </vlayout>
                                                <button label="Action" 
                                                        onClick="@command('handleAlert', alert=alert)"/>
                                            </hlayout>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="planEditorWindow" 
                title="License Plan Editor" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Plan Editor Content -->
        </window>

        <window id="pricingConfigWindow" 
                title="Dynamic Pricing Configuration" 
                visible="false" 
                mode="modal"
                width="900px">
            <!-- Pricing Configuration Content -->
        </window>

        <window id="licenseHistoryWindow" 
                title="License History" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- License History Content -->
        </window>
    </div>
</zk>