<?page title="AI Model Recommendation Engine" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.marketplace.recommendation.RecommendationEngineVM')">
        
        <!-- Recommendation Wizard -->
        <vlayout>
            <!-- Step 1: Use Case Definition -->
            <groupbox visible="@load(vm.currentStep eq 1)" 
                      title="Step 1: Define Your Use Case">
                <vlayout>
                    <grid>
                        <rows>
                            <row>
                                <label value="Primary Use Case"/>
                                <combobox model="@load(vm.useCases)" 
                                         selectedItem="@bind(vm.selectedUseCase)"
                                         width="300px"/>
                            </row>
                            <row>
                                <label value="Industry"/>
                                <combobox model="@load(vm.industries)" 
                                         selectedItem="@bind(vm.selectedIndustry)"
                                         width="300px"/>
                            </row>
                            <row>
                                <label value="Scale of Operation"/>
                                <radiogroup selectedItem="@bind(vm.operationScale)">
                                    <radio label="Small" value="SMALL"/>
                                    <radio label="Medium" value="MEDIUM"/>
                                    <radio label="Large" value="LARGE"/>
                                    <radio label="Enterprise" value="ENTERPRISE"/>
                                </radiogroup>
                            </row>
                        </rows>
                    </grid>

                    <!-- Requirements Checklist -->
                    <groupbox title="Specific Requirements">
                        <grid model="@load(vm.requirements)">
                            <columns>
                                <column label="Requirement"/>
                                <column label="Priority"/>
                                <column label="Details"/>
                            </columns>
                            <template name="model" var="req">
                                <row>
                                    <checkbox checked="@bind(req.selected)" 
                                             label="@load(req.name)"/>
                                    <combobox selectedItem="@bind(req.priority)"
                                             model="@load(vm.priorityLevels)"/>
                                    <textbox value="@bind(req.details)" 
                                            width="100%"/>
                                </row>
                            </template>
                        </grid>
                    </groupbox>
                </vlayout>
            </groupbox>

            <!-- Step 2: Technical Requirements -->
            <groupbox visible="@load(vm.currentStep eq 2)" 
                      title="Step 2: Technical Specifications">
                <vlayout>
                    <grid>
                        <rows>
                            <row>
                                <label value="Expected Daily Requests"/>
                                <intbox value="@bind(vm.dailyRequests)"/>
                            </row>
                            <row>
                                <label value="Maximum Response Time (ms)"/>
                                <intbox value="@bind(vm.maxResponseTime)"/>
                            </row>
                            <row>
                                <label value="Budget Constraints"/>
                                <decimalbox value="@bind(vm.budget)" 
                                          format="$#,##0.00"/>
                            </row>
                        </rows>
                    </grid>

                    <!-- Technical Features -->
                    <groupbox title="Required Features">
                        <grid model="@load(vm.technicalFeatures)">
                            <template name="model" var="feature">
                                <row>
                                    <checkbox checked="@bind(feature.required)" 
                                             label="@load(feature.name)"/>
                                    <label value="@load(feature.description)"/>
                                </row>
                            </template>
                        </grid>
                    </groupbox>

                    <!-- Integration Requirements -->
                    <groupbox title="Integration Requirements">
                        <grid model="@load(vm.integrationRequirements)">
                            <template name="model" var="integration">
                                <row>
                                    <checkbox checked="@bind(integration.required)" 
                                             label="@load(integration.name)"/>
                                    <combobox selectedItem="@bind(integration.type)"
                                             model="@load(vm.integrationTypes)"/>
                                </row>
                            </template>
                        </grid>
                    </groupbox>
                </vlayout>
            </groupbox>

            <!-- Step 3: Compliance Requirements -->
            <groupbox visible="@load(vm.currentStep eq 3)" 
                      title="Step 3: Compliance & Security">
                <vlayout>
                    <!-- Regulatory Requirements -->
                    <grid model="@load(vm.regulations)">
                        <columns>
                            <column label="Regulation"/>
                            <column label="Required"/>
                            <column label="Details"/>
                        </columns>
                        <template name="model" var="reg">
                            <row>
                                <label value="@load(reg.name)"/>
                                <checkbox checked="@bind(reg.required)"/>
                                <label value="@load(reg.description)"/>
                            </row>
                        </template>
                    </grid>

                    <!-- Security Requirements -->
                    <groupbox title="Security Requirements">
                        <grid model="@load(vm.securityRequirements)">
                            <template name="model" var="security">
                                <row>
                                    <checkbox checked="@bind(security.required)" 
                                             label="@load(security.name)"/>
                                    <label value="@load(security.description)"/>
                                </row>
                            </template>
                        </grid>
                    </groupbox>
                </vlayout>
            </groupbox>

            <!-- Step 4: Recommendations -->
            <groupbox visible="@load(vm.currentStep eq 4)" 
                      title="Recommendations">
                <vlayout>
                    <!-- Top Recommendations -->
                    <grid model="@load(vm.recommendations)" 
                          emptyMessage="No recommendations available">
                        <columns>
                            <column label="Model"/>
                            <column label="Match Score"/>
                            <column label="Strengths"/>
                            <column label="Considerations"/>
                            <column label="Estimated Cost"/>
                            <column label="Actions"/>
                        </columns>
                        <template name="model" var="rec">
                            <row>
                                <vlayout>
                                    <label value="@load(rec.modelName)" 
                                           style="font-weight: bold"/>
                                    <label value="@load(rec.modelDescription)"/>
                                </vlayout>
                                <vlayout>
                                    <label value="@load(rec.matchScore)%" 
                                           sclass="@load(rec.matchScoreStyle)"/>
                                    <progressmeter value="@load(rec.matchScore)"/>
                                </vlayout>
                                <vlayout>
                                    <forEach items="@load(rec.strengths)" var="strength">
                                        <hlayout>
                                            <image src="/images/check.png"/>
                                            <label value="@load(strength)"/>
                                        </hlayout>
                                    </forEach>
                                </vlayout>
                                <vlayout>
                                    <forEach items="@load(rec.considerations)" 
                                            var="consideration">
                                        <hlayout>
                                            <image src="/images/warning.png"/>
                                            <label value="@load(consideration)"/>
                                        </hlayout>
                                    </forEach>
                                </vlayout>
                                <label value="@load(rec.estimatedCost)"/>
                                <hlayout>
                                    <button label="Details" 
                                            onClick="@command('showModelDetails', model=rec)"/>
                                    <button label="Compare" 
                                            onClick="@command('compareModel', model=rec)"/>
                                    <button label="Try Now" 
                                            onClick="@command('tryModel', model=rec)"/>
                                </hlayout>
                            </row>
                        </template>
                    </grid>

                    <!-- Recommendation Analysis -->
                    <hlayout>
                        <charts id="recommendationChart" 
                               type="radar"
                               height="400px"
                               title="Requirements Match Analysis"
                               model="@load(vm.recommendationAnalysisData)"/>
                        
                        <charts id="costAnalysisChart" 
                               type="column"
                               height="400px"
                               title="Cost Analysis"
                               model="@load(vm.costAnalysisData)"/>
                    </hlayout>
                </vlayout>
            </groupbox>

            <!-- Navigation Buttons -->
            <hlayout>
                <button label="Previous" 
                        onClick="@command('previousStep')"
                        visible="@load(vm.currentStep gt 1)"/>
                <button label="Next" 
                        onClick="@command('nextStep')"
                        visible="@load(vm.currentStep lt 4)"/>
                <button label="Get Recommendations" 
                        onClick="@command('generateRecommendations')"
                        visible="@load(vm.currentStep eq 3)"/>
                <button label="Start Over" 
                        onClick="@command('resetWizard')"
                        visible="@load(vm.currentStep eq 4)"/>
            </hlayout>
        </vlayout>
    </div>
</zk>