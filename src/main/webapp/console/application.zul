<zk xmlns:h="native">
	<nodom
		viewModel="@id('vm') @init('com.suinsit.webapp.desktop.ApplicationUI')"
		validationMessages="@id('vmsgs')">
		<space></space>
		<div class="content">
			<div class="row">
				<div class="col-sm-12 col-xl-12">
					<apply templateURI="@load(vm.currentPage)" />
				</div>
			</div>
		</div>
	</nodom>
</zk>