<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="stepbar" templateURI="stepApp/shadow_elements/step_bar/stepbar.zul"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<style src="stepApp/shadow_elements/step_bar/stepbar.css" />
<!-- 		<div class="col-12"> -->
<!-- 			<div -->
<!-- 				class="page-title-box d-sm-flex align-items-center justify-content-between"> -->
<!-- 				<include src="@load(ds.menuArquitectura)"></include> -->
<!-- 			</div> -->
<!-- 		</div> -->
	<include src="include/breadcrumbs2.zul"></include>
	<div class="container-edit">
	<nodom
		viewModel="@id('vm') @init('com.suinsit.nocode.semantic.ui.WizzarImportReport')"	validationMessages="@id('vmsgs')" >
<!-- 		<custom-attributes queue="9b02e7fd-8254-445d-b4a9-5b2e7e7ee795"/> -->
		<custom-attributes chatbotassistant="requisitosesp"/>
		<div id="rootDiv" class="col-xl-12 prof-sh">
			<div class="card border border-opacity-75">
				<div class="card-body">
					<stepbar stepBarModel="@init(vm.stepBarModel)" gotoStepCommand="gotoStep" />
					
					<div style="margin-top: 16px;">
<!-- 						<label sclass="page-title" -->
<!-- 							value="@load(vm.stepBarModel.current.label)" /> -->
						<div sclass="stepbar-content">
							<!--  aqui inserta -->
							<apply
								templateURI="@load(vm.stepBarModel.current.uri)"
								step="@load(vm.stepBarModel.current)" />
						</div>
					</div>
				</div>

			</div>
		</div>
	</nodom>
	</div>


	
</zk>