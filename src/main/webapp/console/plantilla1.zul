<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
    xmlns:h="xhtml"
    xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
    <idspace viewModel="@id('vm') @init('com.enartsystems.webapp.mapping.database.ui.FindEntitys')">
        <div id="notificacion"></div>

        <div class="d-flex btn-mov">
           <label id="toggleBtn" class="visible "  style="font-size: 24px; color: #000; cursor: pointer; margin-top: -25px; margin-right: 15px; border-right: 1px solid var(--card-border);" 
       onClick="toggleSidebar()">☰</label>
       
       
	<div id="sidebar"  class="menu-sidebar sidebar-menu" visible="false">
	
	
		<div class="sidebar-content">
		<label id="closeBtn" class="hidden close-btn" style="" 
           onClick="toggleSidebar()">✖</label>
	        <vbox >
		      <label value="@load(ds.projecto.name)" class="sidebar-title" />
		      <label value="@load(ds.projectBase.txname)"  />
		      <separator bar="true" />
	          <tree width="230px">
	              <treechildren >
	                  	<treeitem open="false">
					        <treerow sclass="item-first" >
				                <treecell label="Modulos"/>
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Modulos" onClick="@global-command('selectDataPage',page='/console/misAplicaciones.zul',title='Modulos',menu='Modulos')" />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
				        
				        
	                  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell  label="Modelo de datos"  />
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Importar Base Datos" onClick="@global-command('selectDataPage',page='/console/xul/datamodel/import.zul',title='Importar Base Datos',menu='Modelo de datos')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem >
				                    <treerow >
				                        <treecell  label="Tablas" onClick="@global-command('selectDataPage',page='/console/xul/entidades.zul',title='Tablas',menu='Modelo de datos')" />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Consultas y Vistas" onClick="@global-command('selectDataPage',page='/console/xul/findQuery.zul',title='Consultas y Vistas',menu='Modelo de datos')"/>
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Importar CSV" onClick="@global-command('selectDataPage',page='/console/xul/datamodel/importData.zul',title='Importar CSV',menu='Modelo de datos')"  />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
		        
	                  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell label="Informes y Gráficos"/>
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Informes" onClick="@global-command('selectDataPage',page='/console/xul/screens/autoreport.zul',title='Informes',menu='Informes y Gráficos')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Graficos" onClick="@global-command('selectDataPage',page='/console/xul/charts.zul',title='Graficos',menu='Informes y Gráficos')" />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
				        
	                  
	                  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell label="Diseñadores"/>
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Pantallas" onClick="@global-command('selectDataPage',page='/console/xul/screens/screens.zul',title='Pantallas',menu='Diseñadores')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="XSpress" onClick="@global-command('selectDataPage',page='/console/xul/screens/autoscreen.zul',title='XSpress',menu='Diseñadores')" />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
				        
	                  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell label="IA LEKA"/>
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Pequisitos Pantallas - Modelo" onClick="@global-command('selectDataPage',page='/console/wizzarImportDocument.zul',title='Requisitos Pantallas - Modelo',menu='IA Importar Requisitos')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Proceso de negocio" onClick="@global-command('selectDataPage',page='/console/wizzarImportBpmn.zul',title='Proceso de negocio',menu='IA Importar Requisitos')" />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Informes Gráficos" onClick="@global-command('selectDataPage',page='/console/wizzarReports.zul',title='Informes Gráficos',menu='IA Importar Requisitos')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="APIS - Micro servicios" onClick="@global-command('selectDataPage',page='/console/wizzarReports.zul',title='APIS - Micro servicios',menu='IA Importar Requisitos')" />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
				        
	                  <treeitem open="false">
					        <treerow sclass="item-first">
				                <treecell label="Traductor"/>
				            </treerow>
				            <treechildren>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Etiquetas Pantallas" onClick="@global-command('selectDataPage',page='/console/traslate/wizzarTraslateFields.zul',title='Etiquetas Pantallas',menu='Traductor')"  />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Contenidos" onClick="@global-command('selectDataPage',page='/console/traslate/contenidos.zul',title='Contenidos',menu='Traductor')" />
				                    </treerow>
				                </treeitem>
				                <treeitem>
				                    <treerow>
				                        <treecell label="Texto" onClick="@global-command('selectDataPage',page='/console/traslate/texto.zul',title='Texto',menu='Traductor')" />
				                    </treerow>
				                </treeitem>
				            </treechildren>
				        </treeitem>
				        
				        
				        
	              </treechildren>
	          </tree>
	      </vbox>
		</div>
	</div>
        
	<div class="section-suinsit d-section" id="contenedor">
	    
	    
