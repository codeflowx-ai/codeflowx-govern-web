<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace
		viewModel="@id('vm') @init('org.suinsit.nocode.web.FindEntityUI')">
		<custom-attributes pagina="proyectos" />
		<custom-attributes clase="org.suinsit.apps.myalm.Almproject" />
		<custom-attributes namespace="myalm" />
		<custom-attributes uid="60426" />
		<custom-attributes tipo="SEARCH" />
		<custom-attributes paginaIndex="indexproyectos.zul" />
		<custom-attributes templateView="cardproyectosSelect.zul" />
		
		<div class="container-fluid product-table">

			
			
			<!-- Segunda Sección -->
			<div class="section filters">
				<div class="search-bar">
					<textbox placeholder="Buscar por: productos"
						sclass="form-control search" width="20vw" />
				</div>
				
				<div class="filter-icons right">
				
					<div class="ic-hiden icon-item">
						<a class="mov-icon-hide"
						onClick="@global-command('createProyecto')"
						iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
						 />
					</div>
						 
					<div class="ic-hiden icon-item">
					 	<a class="mov-icon-hide"
						onClick="@global-command('createProyectoExpress')"
						iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
						/>
					</div>
						
						 
				<div class="ic-hiden icon-item">
					<div class="dropdown">
						<h:i class="fa-duotone fa-file-export"
							aria-hidden="true">
						</h:i>
						<div class="dropdown-content">
							<a class="dropdown-item"
								onClick="@command('changeView',view='cardproyectosSelect.zul')">
								Card
							</a>
							<a class="dropdown-item"
								onClick="@command('changeView',view='gridproyectosSelect.zul')">
								List
							</a>
						</div>
					</div>
				</div>
				
				
					<a class="icon-item" iconSclass="fa-duotone fa-line-columns"></a>
					<a onClick="@command('search')"
					class="icon-item"
						iconSclass="fa-duotone fa-magnifying-glass-waveform">
					</a>
					<a onClick="@command('clear')"
					class="icon-item"
						iconSclass="fa-duotone fa-broom-wide">
					</a>
				</div>
			</div>
			<!-- Tercera Sección -->
			<div class="section table-section">
				<div id="divTemplate" sclass="col-lg-12"></div>
			</div>
			<!-- Cuarta Sección -->
			<div class="section footer-prd">
				<div class="pagination">
					<paging id="topagin"
						pageSize="@load(vm.scroll.maxRows)"
						totalSize="@load(vm.scroll.totalRows)" mold="os" width="100%"
						style="background-color:#FFF;" />
				</div>

				<div class="records">
					<combobox selectedItem="@bind(vm.scroll.maxRows)"
						value="@bind(vm.scroll.maxRows)" width="75px">
						<comboitem label="30" value="30" />
						<comboitem label="50" value="50" />
						<comboitem label="100" value="100" />
					</combobox>
				</div>
			</div>
		</div>
	</idspace>
</zk>