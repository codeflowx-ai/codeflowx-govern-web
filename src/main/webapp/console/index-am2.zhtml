<!doctype html>
<html class="h-100" lang="en" xmlns="http://www.w3.org/1999/xhtml"
	xmlns:zk="zk" xmlns:z="zul" xmlns:c="client"
	>
	<head>
		<meta charset="utf-8">
			<meta name="viewport"
				content="width=device-width, initial-scale=1">
				<meta name="description" content="">
					<title>Suinsit</title>
					<!-- Favicon -->
					<link href="img/favicon.png" rel="icon">
						<link rel="canonical" href="">
							<!-- CSS Bootstrap -->
							<link href="css/bootstrap.min.css"
								rel="stylesheet">
								<link
									href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
									rel="stylesheet">
									<!-- Font Awesome -->
									<link rel="stylesheet"
										href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
										<!-- Kid Font Awesome -->
										<link rel="stylesheet"
											href="https://kit.fontawesome.com/5b0fb4f6f9.css"
											crossorigin="anonymous">
											<!-- Estilos personalizados -->
											<link href="css/styles.css" rel="stylesheet">

	</head>
	<body class="bd-back"
		style="background: url('img/fondo-4.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">
		<z:div
			viewModel="@id('ds') @init('com.suinsit.webapp.nocode.DashboardUI')">
			<zk:custom-attributes dashboard="misProyectos.zul" />
			<z:include src="header.zul"></z:include>
			<div class="d-flex">
			   <z:include id="menuLeft" src="menuLeft.zul"></z:include>
				<section class="w-100">
<!-- 				<z:include id="menuHeader" src="menuHeader.zul"></z:include> -->
				  <br/><br/>
					
                        
				</section>
			</div>
			
			
<div class="d-flex mt-5"> 
        
	<div class="section-suinsit d-section" id="contenedor" style="padding:15px;">
	    
	    <z:tabbox mold="default" width="100%" class="b-conocimiento">
        <!-- Pestañas -->
	        <z:tabs>
	            <z:tab label="Bases de conocimientos" />
	            <z:tab label="Chatear con el documento" />
	        </z:tabs>
	        
		    
		    
		    
		    
		    <z:tabpanels>
            <!-- Panel para Bases de conocimientos -->
	            <z:tabpanel>
	            
	            	<div class="bread-mkt">Inicio &gt; Sección &gt; Sub-Sección</div>
			    	<z:label class="ttl-mkt">Bases de conocimientos</z:label>
		
		
		
		
					<div class="row">
						<div class="col-12 mb-4">
							<div class="card cards-mkt-sf">
								<z:hlayout spacing="10px" style="margin-bottom:20px;">
							        <z:vlayout class="mkt high-bases" style="padding:20px;">
							            <z:label class="subtt-mkt">Cómo funciona </z:label>
							            <z:grid>
							                <z:rows>
							                    <z:row>
							                        <z:hlayout class="bases-cards">
							                        	<z:label class="bases-ttl">Cargar y chatear</z:label>
							                            <z:image src="img/news/doc-pl.png" />
							                            <z:vlayout spacing="5px">
							                                
							                                <z:label class="bases-txt">Consulte rápidamente los modelos fundacionales con el contexto proporcionado por un conjunto de datos ad hoc.</z:label>
							                            </z:vlayout>
							                        </z:hlayout>
							                        <z:hlayout class="bases-cards">
							                        	<z:label class="bases-ttl">Crear una base de conocimientos</z:label>
							                            <z:image src="img/news/doc-pl.png" />
							                            <z:vlayout spacing="5px">
							                                
							                                <z:label class="bases-txt">Para crear una base de conocimientos, especifique la ubicación de sus datos, seleccione un modelo de incrustación y configure un almacén de vectores para que Bedrock almacene y actualice sus incrustaciones.</z:label>
							                            </z:vlayout>
							                        </z:hlayout>
							                        <z:hlayout class="bases-cards">
							                        	<z:label class="bases-ttl">Probar la base de conocimientos</z:label>
							                            <z:image src="img/news/doc-pl.png" />
							                            <z:vlayout spacing="5px">
							                                
							                                <z:label class="bases-txt">Consulte su base de conocimientos en la ventana de prueba. Puede obtener fragmentos del texto original o puede usarlos para obtener respuestas de un modelo fundacional.</z:label>
							                            </z:vlayout>
							                        </z:hlayout>
							                         <z:hlayout class="bases-cards">
							                        	<z:label class="bases-ttl">Utilizar la base de conocimientos</z:label>
							                            <z:image src="img/news/doc-pl.png" />
							                            <z:vlayout spacing="5px">
							                                
							                                <z:label class="bases-txt">Integre su base de conocimientos en su aplicación tal cual o agréguela a los agentes.</z:label>
							                            </z:vlayout>
							                        </z:hlayout>
							                    </z:row>
							                </z:rows>
							            </z:grid>
							        </z:vlayout>
							    </z:hlayout>
						    </div>
					    </div>
					    
			    	</div>
			    	
			    	
			    	
			    	<div class="row">
					    <div class="col-12 mb-4">
					        <div class="card cards-mkt-sf">
					            <!-- Sección del título con botones -->
					            
						            <z:vlayout class="mkt high-bases" style="padding:20px;">
							            
							                <z:label class="subtt-mkt">Cómo funciona</z:label>
						                
						                
							                <z:vlayout spacing="5px" class="btn-mkt">
			<!-- 				                    <z:button label="Editar" sclass="btn-primary" /> -->
			<!-- 				                    <z:button label="Eliminar" sclass="btn-danger" /> -->
			<!-- 				                    <z:button label="Probar una base de conocimientos" sclass="btn-success" /> -->
			<!-- 				                    <z:button label="Crear una base de conocimientos" sclass="btn-info" /> -->
			
										<z:a
											iconSclass="fa-duotone fa-solid fa-pen-to-square align-middle fs-16 me-2"
											onClick=" "
											sclass="mov-icon-hide waves-effect waves-light"
											tooltiptext="Save">
										</z:a>
										<z:a
											iconSclass="fa-duotone fa-solid fa-trash align-middle fs-16 me-2"
											onClick=" "
											sclass="mov-icon-hide waves-effect waves-light"
											tooltiptext="Save and Publish">
										</z:a>
										<z:a tooltiptext="Duplicate Screen"
											iconSclass="fa-duotone fa-solid fa-book-open-cover align-middle fs-16 me-2"
											onClick=" "
											sclass="mov-icon-hide waves-effect waves-light">
											
										</z:a>
										<z:a tooltiptext="Duplicate Screen"
											iconSclass="fa-duotone fa-solid fa-books-medical align-middle fs-16 me-2"
											onClick=" "
											sclass="mov-icon-hide waves-effect waves-light">
											
										</z:a>
										
							                </z:vlayout>
							           
						            </z:vlayout>
					            
					
					            <!-- Buscador -->
					            <z:hlayout class="mkt high-bases mkt-search" style="padding:20px;">
					                <z:textbox placeholder="Buscar base de conocimientos" width="100%" />
					            </z:hlayout>
					
					            <!-- Grid -->
					            <z:grid class="mkt high-bases" style="padding:20px;">
					                <z:columns>
					                    <z:column label="Nombre" />
					                    <z:column label="Estado" />
					                    <z:column label="Descripción" />
					                    <z:column label="Archivos de origen" />
					                    <z:column label="Hora de creación" />
					                    <z:column label="Avisos de última sincronización" />
					                    <z:column label="Última sincronización" />
					                </z:columns>
					                <z:rows>
					                    <z:row>
					                        <z:label value="Base 1" />
					                        <z:label value="Activo" />
					                        <z:label value="Lorem ipsum dolor sit amet" />
					                        <z:label value="Archivo1.pdf" />
					                        <z:label value="08:30 AM" />
					                        <z:label value="Sin avisos" />
					                        <z:label value="Hoy, 10:00 AM" />
					                    </z:row>
					                    <z:row>
					                        <z:label value="Base 2" />
					                        <z:label value="Inactivo" />
					                        <z:label value="Descripción de ejemplo" />
					                        <z:label value="Archivo2.docx" />
					                        <z:label value="10:45 AM" />
					                        <z:label value="Error en sincronización" />
					                        <z:label value="Ayer, 3:00 PM" />
					                    </z:row>
					                    <z:row>
					                        <z:label value="Base 3" />
					                        <z:label value="En Proceso" />
					                        <z:label value="Texto genérico de prueba" />
					                        <z:label value="Archivo3.csv" />
					                        <z:label value="07:15 AM" />
					                        <z:label value="Sin avisos" />
					                        <z:label value="Hoy, 9:00 AM" />
					                    </z:row>
					                </z:rows>
					            </z:grid>
					        </div>
					    </div>
					</div>
				</z:tabpanel>
    
    
   				 <!-- Chatear con el documento -->
	            <z:tabpanel>
	                <div class="row">
	                    <!-- Columna izquierda (col-8) -->
	                    <div class="col-8">
	                        <div class="card cards-mkt-sf" style="border: 1px solid #ccc; border-radius: 12px; padding: 15px;">
	                            <h5>Modelo</h5>
	                            <z:button class="btn btn-primary" label="Seleccionar modelo" />
	                        </div>
	                        <div class="card mt-3 cards-mkt-sf" style="border: 1px solid #ccc; border-radius: 12px; padding: 15px;">
	                            <h5>Plantilla de petición</h5>
	                            <p>Especifique los parámetros necesarios para realizar la petición al modelo.</p>
	                        </div>
	                    </div>
	                    <!-- Columna derecha (col-4) -->
	                    <div class="col-4">
	                        <div class="card cards-mkt-sf" style="border: 1px solid #ccc; border-radius: 12px; padding: 15px;">
	                            <h5>Chatear con el documento</h5>
	                            <!-- Sección de chat -->
	                            <div style="height: 200px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; border-radius: 8px;">
	                                <p>Mensajes del chat...</p>
	                            </div>
	                            <!-- Selección de modelo y botón -->
	                            <div class="mt-3">
	                                <z:label value="Seleccione un modelo" />
	                                <z:button class="btn btn-primary" label="Ejecutar" />
	                            </div>
	                        </div>
	                    </div>
	                </div>
	            </z:tabpanel>
	        </z:tabpanels>
	    </z:tabbox>
    
    
    
    
    
	</div>
	</div>





<zscript>
         void toggleSidebar() {
            boolean isVisible = sidebar.isVisible();
            sidebar.setVisible(!isVisible);
            
            // Alternar visibilidad de los botones
                     
            
	            if (!isVisible) {
				    toggleBtn.setSclass("hidden");
				    closeBtn.setSclass("visible close-btn");
				} else {
				    toggleBtn.setSclass("visible");
				    closeBtn.setSclass("hidden"); 
				}

        }
    </zscript>

			
			
			
			
			
			
			
			
			
			<footer class="container-fluid footer">
				<div class="row">
					<div class="col-12 text-center">
						© 2024 Todos los derechos reservados |
						<span>
							<a href="https://www.suinsit.com">
								www.suinsit.com
							</a>
						</span>
					</div>
				</div>
			</footer>



		</z:div>
	</body>

</html>
