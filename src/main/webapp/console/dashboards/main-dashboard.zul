<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="native" xmlns:zk="http://www.zkoss.org/2005/zul">
    
    <!-- ViewModel binding -->
    <window viewModel="@id('vm') @init('com.codeflowx.govern.viewmodel.dashboard.MainDashboardViewModel')"
            border="none" width="100%" height="100%">
        
        <h:div class="container-fluid p-4">
            
            <!-- Header -->
            <h:div class="row mb-4">
                <h:div class="col-12">
                    <h:h2 class="mb-1" style="font-weight: bold;">Dashboard Principal</h:h2>
                    <h:p class="text-muted">Resumen general del sistema CodeFlowX Govern</h:p>
                </h:div>
            </h:div>
            
            <!-- Botón de refrescar -->
            <h:div class="row mb-4">
                <h:div class="col-12 text-end">
                    <button label="🔄 Refrescar Dashboard" 
                            class="btn btn-primary"
                            onClick="@command('refreshDashboard')" />
                </h:div>
            </h:div>
            
            <!-- KPIs Principales -->
            <h:div class="row g-3 mb-4">
                
                <!-- Total Proyectos -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Proyectos</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalProjects)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">en el sistema</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Total Modelos -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Modelos</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalModels)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">disponibles</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Total Agentes -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Total Agentes</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.totalAgents)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">activos</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Deployments Activos -->
                <h:div class="col-md-3">
                    <h:div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; border-radius: 12px;">
                        <h:div class="card-body p-4">
                            <h:p class="mb-2" style="font-size: 14px; opacity: 0.9;">Deployments</h:p>
                            <h:h2 class="mb-1" style="font-size: 42px; font-weight: bold;">
                                <label value="@load(vm.activeDeployments)"/>
                            </h:h2>
                            <h:p class="mb-0" style="font-size: 12px; opacity: 0.8;">activos</h:p>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Métricas de Costos y Tokens -->
            <h:div class="row g-3 mb-4">
                
                <!-- Costos Hoy -->
                <h:div class="col-md-4">
                    <h:div class="card shadow-sm">
                        <h:div class="card-body">
                            <h:h6 class="text-muted mb-2">Costos Hoy</h:h6>
                            <h:h3 class="mb-0">
                                $<label value="@load(vm.totalCostToday) @converter('formatedNumber', format='###,##0.00')"/>
                            </h:h3>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Tokens Hoy -->
                <h:div class="col-md-4">
                    <h:div class="card shadow-sm">
                        <h:div class="card-body">
                            <h:h6 class="text-muted mb-2">Tokens Procesados Hoy</h:h6>
                            <h:h3 class="mb-0">
                                <label value="@load(vm.totalTokensToday) @converter('formatedNumber', format='###,###')"/>
                            </h:h3>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- System Health Score -->
                <h:div class="col-md-4">
                    <h:div class="card shadow-sm">
                        <h:div class="card-body">
                            <h:h6 class="text-muted mb-2">System Health Score</h:h6>
                            <h:h3 class="mb-0">
                                <label value="@load(vm.systemHealthScore)"/> / 100
                            </h:h3>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Dashboards de Módulos Específicos -->
            <h:div class="row g-3 mb-4">
                
                <!-- Resumen Dashboard General -->
                <h:div class="col-md-12" visible="@load(vm.dashboardSummary ne null)">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-white">
                            <h:h5 class="mb-0">Resumen General del Sistema</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div class="row">
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Total Items</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.totalItems)"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Items Activos</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.activeItems)"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Desplegados</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.deployedItems)"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">En Training</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.trainingItems)"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Offline</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.offlineItems)"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Avg Score</h:p>
                                    <h:h4><label value="@load(vm.dashboardSummary.avgScore) @converter('formatedNumber', format='###,##0.00')"/></h:h4>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Estadísticas por Módulo y Acciones Rápidas -->
            <h:div class="row g-3 mb-4">
                
                <!-- Estadísticas de Módulos -->
                <h:div class="col-md-8">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-white">
                            <h:h5 class="mb-0">Estadísticas por Módulo</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:table class="table table-hover">
                                <h:thead>
                                    <h:tr>
                                        <h:th>Módulo</h:th>
                                        <h:th>Total</h:th>
                                        <h:th>Activos</h:th>
                                        <h:th>Score</h:th>
                                        <h:th>Estado</h:th>
                                    </h:tr>
                                </h:thead>
                                <h:tbody>
                                    <forEach items="@load(vm.moduleStats)" var="stat">
                                        <h:tr>
                                            <h:td>
                                                <label value="@load(stat.dshmodulename)"/>
                                            </h:td>
                                            <h:td>
                                                <label value="@load(stat.dshtotalitems)"/>
                                            </h:td>
                                            <h:td>
                                                <label value="@load(stat.dshactiveitems)"/>
                                            </h:td>
                                            <h:td>
                                                <label value="@load(stat.dshavgscore) @converter('formatedNumber', format='###,##0.00')"/>
                                            </h:td>
                                            <h:td>
                                                <h:span class="badge bg-success" visible="@load(stat.dshstatus eq 'HEALTHY')">
                                                    <label value="@load(stat.dshstatus)"/>
                                                </h:span>
                                                <h:span class="badge bg-warning" visible="@load(stat.dshstatus eq 'DEGRADED')">
                                                    <label value="@load(stat.dshstatus)"/>
                                                </h:span>
                                                <h:span class="badge bg-danger" visible="@load(stat.dshstatus eq 'UNHEALTHY')">
                                                    <label value="@load(stat.dshstatus)"/>
                                                </h:span>
                                            </h:td>
                                        </h:tr>
                                    </forEach>
                                </h:tbody>
                            </h:table>
                        </h:div>
                    </h:div>
                </h:div>
                
                <!-- Acciones Rápidas -->
                <h:div class="col-md-4">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-white">
                            <h:h5 class="mb-0">Acciones Rápidas</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div class="d-grid gap-2">
                                <forEach items="@load(vm.quickActions)" var="action">
                                    <button label="@load(action.dshactionname)" 
                                            class="btn btn-outline-primary text-start"
                                            onClick="@command('executeQuickAction', actionId=action.idxquickaction)"
                                            disabled="@load(!action.dshenabled)"/>
                                </forEach>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Métricas de Costos Detalladas -->
            <h:div class="row g-3 mb-4" visible="@load(vm.costMetrics ne null)">
                
                <h:div class="col-md-12">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-white">
                            <h:h5 class="mb-0">Métricas de Costos</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div class="row">
                                <h:div class="col-md-3">
                                    <h:p class="text-muted mb-1">Costo Total</h:p>
                                    <h:h4>$<label value="@load(vm.costMetrics.dshtotalcost) @converter('formatedNumber', format='###,##0.00')"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Hoy</h:p>
                                    <h:h5>$<label value="@load(vm.costMetrics.dshcosttoday) @converter('formatedNumber', format='###,##0.00')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Semana</h:p>
                                    <h:h5>$<label value="@load(vm.costMetrics.dshcostweek) @converter('formatedNumber', format='###,##0.00')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Mes</h:p>
                                    <h:h5>$<label value="@load(vm.costMetrics.dshcostmonth) @converter('formatedNumber', format='###,##0.00')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-3">
                                    <h:p class="text-muted mb-1">Budget Usado</h:p>
                                    <h:h5><label value="@load(vm.costMetrics.dshbudgetusedpct) @converter('formatedNumber', format='###,##0.00')"/>%</h:h5>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
            <!-- Métricas de Tokens Detalladas -->
            <h:div class="row g-3" visible="@load(vm.tokenMetrics ne null)">
                
                <h:div class="col-md-12">
                    <h:div class="card shadow-sm">
                        <h:div class="card-header bg-white">
                            <h:h5 class="mb-0">Métricas de Tokens</h:h5>
                        </h:div>
                        <h:div class="card-body">
                            <h:div class="row">
                                <h:div class="col-md-3">
                                    <h:p class="text-muted mb-1">Total Tokens</h:p>
                                    <h:h4><label value="@load(vm.tokenMetrics.dshtotaltokens) @converter('formatedNumber', format='###,###')"/></h:h4>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Hoy</h:p>
                                    <h:h5><label value="@load(vm.tokenMetrics.dshtokenstoday) @converter('formatedNumber', format='###,###')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Semana</h:p>
                                    <h:h5><label value="@load(vm.tokenMetrics.dshtokensweek) @converter('formatedNumber', format='###,###')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-2">
                                    <h:p class="text-muted mb-1">Mes</h:p>
                                    <h:h5><label value="@load(vm.tokenMetrics.dshtokensmonth) @converter('formatedNumber', format='###,###')"/></h:h5>
                                </h:div>
                                <h:div class="col-md-3">
                                    <h:p class="text-muted mb-1">Modelo/Provider</h:p>
                                    <h:h5><label value="@load(vm.tokenMetrics.dshmodelname)"/> / <label value="@load(vm.tokenMetrics.dshprovider)"/></h:h5>
                                </h:div>
                            </h:div>
                        </h:div>
                    </h:div>
                </h:div>
                
            </h:div>
            
        </h:div>
        
    </window>
    
</zk>

