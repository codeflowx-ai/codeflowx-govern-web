<?xml version="1.0" encoding="UTF-8"?>
<zk>
    <style src="/css/style.css"/>
    
    <!-- Template Structure -->
    <borderlayout sclass="main-layout">
        <!-- Header -->
        <north size="70px" border="none" sclass="header">
            <hlayout>
                <div sclass="logo">
                    <image src="/images/logo.png" width="150px"/>
                </div>
                <div sclass="header-content">
                    <hlayout>
                        <div sclass="user-info">
                            <label value="${sessionScope.userName}"/>
                            <button label="Logout" 
                                    onClick='execution.sendRedirect("/logout")'/>
                        </div>
                    </hlayout>
                </div>
            </hlayout>
        </north>
        
        <!-- Left Sidebar -->
        <west width="250px" border="none" collapsible="true" 
              splittable="true" minsize="200" maxsize="300">
            <vlayout spacing="0" sclass="sidebar">
                <!-- Navigation Menu -->
                <tree id="navigationTree" sclass="nav-tree">
                    <treechildren>
                        <treeitem>
                            <treerow>
                                <treecell label="Dashboard" 
                                         onClick='navigation.navigateTo("dashboard")'/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="Models" 
                                         onClick='navigation.navigateTo("models")'/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="Integrations" 
                                         onClick='navigation.navigateTo("integrations")'/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="Analytics" 
                                         onClick='navigation.navigateTo("analytics")'/>
                            </treerow>
                        </treeitem>
                        <treeitem>
                            <treerow>
                                <treecell label="Settings" 
                                         onClick='navigation.navigateTo("settings")'/>
                            </treerow>
                        </treeitem>
                    </treechildren>
                </tree>
            </vlayout>
        </west>
        
        <!-- Main Content -->
        <center id="mainContent" autoscroll="true" border="none">
            <div self="@{insert(content)}"/>
        </center>
        
        <!-- Footer -->
        <south size="30px" border="none" sclass="footer">
            <div>
                <label value="© 2024 AI Governance Platform"/>
                <label value="Version 1.0.0"/>
            </div>
        </south>
    </borderlayout>

    <!-- Global Notification Area -->
    <div id="notificationArea" sclass="notification-area"/>

    <!-- Style Definitions -->
    <style>
        .main-layout {
            background: #f5f5f5;
        }
        
        .header {
            background: #2c3e50;
            color: white;
            padding: 10px 20px;
        }
        
        .sidebar {
            background: #34495e;
            color: white;
            height: 100%;
        }
        
        .nav-tree {
            border: none;
            background: transparent;
        }
        
        .nav-tree .z-treecell-content {
            color: white;
            padding: 10px 15px;
        }
        
        .nav-tree .z-treecell-content:hover {
            background: #2c3e50;
        }
        
        .footer {
            background: #2c3e50;
            color: white;
            text-align: center;
            padding: 5px;
        }
        
        .notification-area {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }
        
        /* Component Styles */
        .metric-box {
            background: white;
            padding: 15px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin: 10px;
            min-width: 200px;
        }
        
        .action-button {
            background: #3498db;
            color: white;
            padding: 5px 15px;
            border-radius: 3px;
        }
        
        .status-active { color: #27ae60; }
        .status-inactive { color: #7f8c8d; }
        .status-error { color: #c0392b; }
        .status-warning { color: #f39c12; }
        
        .health-good { background: #2ecc71; }
        .health-warning { background: #f1c40f; }
        .health-critical { background: #e74c3c; }
    </style>
</zk>