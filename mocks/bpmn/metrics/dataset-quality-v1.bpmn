<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://codeflowx.com/govern/dataset-quality">
  <process id="dataset-quality-v1" name="Dataset Quality Governance V1" isExecutable="true" version="1.0">
    <startEvent id="startEvent" name="Start Dataset Quality Check"></startEvent>
    <serviceTask id="validateFormat" name="Validate Dataset Format" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.ValidateDatasetFormatDelegate"></serviceTask>
    <exclusiveGateway id="formatGateway" name="Format Valid?"></exclusiveGateway>
    <serviceTask id="datasetProfiling" name="Data Profiling" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.DataProfilingDelegate"></serviceTask>
    <parallelGateway id="parallelGatewayFork" name="Parallel Analysis"></parallelGateway>
    <serviceTask id="detectBias" name="Detect Dataset Bias" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.DetectDatasetBiasDelegate"></serviceTask>
    <serviceTask id="validateCompliance" name="Validate Compliance (PII)" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.ValidateDatasetComplianceDelegate"></serviceTask>
    <parallelGateway id="parallelGatewayJoin" name="Join Analysis"></parallelGateway>
    <businessRuleTask id="calculateScore" name="Calculate Dataset Score" activiti:ruleVariablesInput="${datasetQualityFact}" activiti:resultVariable="datasetQualityResult"></businessRuleTask>
    <exclusiveGateway id="decisionGateway" name="Quality Decision"></exclusiveGateway>
    <userTask id="humanReview" name="Human Review - Dataset Quality" activiti:assignee="${initiator}" activiti:formKey="dataset-quality-review-form" activiti:priority="50">
      <documentation>Review dataset quality evaluation results and make final decision.</documentation>
    </userTask>
    <exclusiveGateway id="humanDecisionGateway" name="Human Decision"></exclusiveGateway>
    <serviceTask id="notifyApproval" name="Notify Dataset Approved" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.NotifyDatasetApprovedDelegate"></serviceTask>
    <serviceTask id="notifyRejection" name="Notify Dataset Rejected" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.NotifyDatasetRejectedDelegate"></serviceTask>
    <endEvent id="endApproved" name="Dataset Approved"></endEvent>
    <endEvent id="endRejected" name="Dataset Rejected"></endEvent>
    <boundaryEvent id="datasetReviewTimer" name="7 Day Reminder" attachedToRef="humanReview" cancelActivity="false">
      <timerEventDefinition>
        <timeDuration>P7D</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="datasetReviewReminder" name="Dataset Review Reminder" activiti:candidateGroups="data-engineers,governance-admins" activiti:formKey="dataset-review-reminder-form" activiti:priority="80">
      <documentation>Dataset en cuarentena hace 7 días. Decisión: Aprobar, Solicitar Correcciones, o Rechazar.</documentation>
    </userTask>
    <exclusiveGateway id="datasetReminderGateway" name="Reminder Action"></exclusiveGateway>
    <boundaryEvent id="errorEvent" name="Quality Error" attachedToRef="calculateScore">
      <errorEventDefinition errorRef="datasetQualityError"></errorEventDefinition>
    </boundaryEvent>
    <serviceTask id="handleError" name="Handle Quality Error" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.HandleDatasetQualityErrorDelegate"></serviceTask>
    <endEvent id="endError" name="Error End"></endEvent>
    <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="validateFormat"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="validateFormat" targetRef="formatGateway"></sequenceFlow>
    <sequenceFlow id="formatInvalid" name="Invalid" sourceRef="formatGateway" targetRef="endRejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!formatValid}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="formatValid" name="Valid" sourceRef="formatGateway" targetRef="datasetProfiling">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${formatValid}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow3" sourceRef="datasetProfiling" targetRef="parallelGatewayFork"></sequenceFlow>
    <sequenceFlow id="flowToBias" sourceRef="parallelGatewayFork" targetRef="detectBias"></sequenceFlow>
    <sequenceFlow id="flowToPII" sourceRef="parallelGatewayFork" targetRef="validateCompliance"></sequenceFlow>
    <sequenceFlow id="flowFromBias" sourceRef="detectBias" targetRef="parallelGatewayJoin"></sequenceFlow>
    <sequenceFlow id="flowFromPII" sourceRef="validateCompliance" targetRef="parallelGatewayJoin"></sequenceFlow>
    <sequenceFlow id="flow4" sourceRef="parallelGatewayJoin" targetRef="calculateScore"></sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="calculateScore" targetRef="decisionGateway"></sequenceFlow>
    <sequenceFlow id="flowApproved" name="Approved" sourceRef="decisionGateway" targetRef="notifyApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${datasetQualityResult.decision == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowRejected" name="Rejected" sourceRef="decisionGateway" targetRef="notifyRejection">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${datasetQualityResult.decision == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowReview" name="Review Required" sourceRef="decisionGateway" targetRef="humanReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${datasetQualityResult.decision == 'REVIEW_REQUIRED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow6" sourceRef="humanReview" targetRef="humanDecisionGateway"></sequenceFlow>
    <sequenceFlow id="humanApproved" name="Approved by Human" sourceRef="humanDecisionGateway" targetRef="notifyApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${humanDecision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="humanRejected" name="Rejected by Human" sourceRef="humanDecisionGateway" targetRef="notifyRejection">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${humanDecision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowToApprovedEnd" sourceRef="notifyApproval" targetRef="endApproved"></sequenceFlow>
    <sequenceFlow id="flowToRejectedEnd" sourceRef="notifyRejection" targetRef="endRejected"></sequenceFlow>
    <sequenceFlow id="flowTimerToReminder" sourceRef="datasetReviewTimer" targetRef="datasetReviewReminder"></sequenceFlow>
    <sequenceFlow id="flowReminderToGateway" sourceRef="datasetReviewReminder" targetRef="datasetReminderGateway"></sequenceFlow>
    <sequenceFlow id="flowApproveReminder" name="Approve" sourceRef="datasetReminderGateway" targetRef="humanDecisionGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reminderDecision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowRejectReminder" name="Reject" sourceRef="datasetReminderGateway" targetRef="humanDecisionGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${reminderDecision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowErrorToHandle" sourceRef="errorEvent" targetRef="handleError"></sequenceFlow>
    <sequenceFlow id="flowErrorToEnd" sourceRef="handleError" targetRef="endError"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dataset-quality-v1">
    <bpmndi:BPMNPlane bpmnElement="dataset-quality-v1" id="BPMNPlane_dataset-quality-v1">
      <bpmndi:BPMNShape bpmnElement="startEvent" id="BPMNShape_startEvent">
        <omgdc:Bounds height="35.0" width="35.0" x="50.0" y="250.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="validateFormat" id="BPMNShape_validateFormat">
