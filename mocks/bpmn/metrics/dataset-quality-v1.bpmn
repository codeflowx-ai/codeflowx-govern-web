      <bpmndi:BPMNEdge bpmnElement="flowErrorToHandle" id="BPMNEdge_flowErrorToHandle">
        <omgdi:waypoint x="965.0" y="320.0"></omgdi:waypoint>
        <omgdi:waypoint x="1100.0" y="400.0"></omgdi:waypoint>
