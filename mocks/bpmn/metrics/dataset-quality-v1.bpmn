        <omgdi:waypoint x="1150.0" y="440.0"></omgdi:waypoint>
        <omgdi:waypoint x="1200.0" y="439.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>