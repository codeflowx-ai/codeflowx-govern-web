<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://codeflowx.com/govern/dataset-privacy">
  <process id="dataset-privacy-assessment-v1" name="Dataset Privacy Assessment V1" isExecutable="true" version="1.0" activiti:candidateStarterGroups="data-engineers,compliance-officers">
    <startEvent id="startPrivacyAssessment" name="Start Privacy Assessment">
      <outgoing>flow1</outgoing>
    </startEvent>
    
    <!-- Detección automática de PII -->
    <serviceTask id="detectPII" name="Detect PII" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.DetectPIIDelegate">
      <incoming>flow1</incoming>
      <outgoing>flow2</outgoing>
    </serviceTask>
    
    <!-- Gateway: ¿PII presente? -->
    <exclusiveGateway id="piiGateway" name="PII Present?">
      <incoming>flow2</incoming>
      <outgoing>flow3</outgoing>
      <outgoing>flow4</outgoing>
    </exclusiveGateway>
    
    <!-- Sin PII: Aprobación automática -->
    <serviceTask id="autoApproveNoPII" name="Auto Approve No PII" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.ApproveDatasetPrivacyDelegate">
      <incoming>flow3</incoming>
      <outgoing>flow5</outgoing>
    </serviceTask>
    
    <!-- Con PII: Continuar evaluación -->
    <!-- Verificar base legal (GDPR Art. 6) -->
    <serviceTask id="verifyLegalBasis" name="Verify Legal Basis (GDPR Art. 6)" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.VerifyLegalBasisDelegate">
      <incoming>flow4</incoming>
      <outgoing>flow6</outgoing>
    </serviceTask>
    
    <!-- Gateway: ¿Base legal válida? -->
    <exclusiveGateway id="legalBasisGateway" name="Legal Basis Valid?">
      <incoming>flow6</incoming>
      <outgoing>flow7</outgoing>
      <outgoing>flow8</outgoing>
    </exclusiveGateway>
    
    <!-- Base legal inválida: Rechazar -->
    <serviceTask id="rejectInvalidLegalBasis" name="Reject Invalid Legal Basis" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.RejectDatasetPrivacyDelegate">
      <incoming>flow7</incoming>
      <outgoing>flow9</outgoing>
    </serviceTask>
    
    <!-- Base legal válida: Verificar consentimiento (GDPR Art. 7) -->
    <serviceTask id="verifyConsent" name="Verify Consent (GDPR Art. 7)" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.VerifyConsentDelegate">
      <incoming>flow8</incoming>
      <outgoing>flow10</outgoing>
    </serviceTask>
    
    <!-- Gateway: ¿Consentimiento requerido? -->
    <exclusiveGateway id="consentRequiredGateway" name="Consent Required?">
      <incoming>flow10</incoming>
      <outgoing>flow11</outgoing>
      <outgoing>flow12</outgoing>
    </exclusiveGateway>
    
    <!-- Consentimiento no requerido: Evaluar DPIA -->
    <serviceTask id="assessDPIA" name="Assess DPIA Requirement (GDPR Art. 35)" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.AssessDPIADelegate">
      <incoming>flow11</incoming>
      <outgoing>flow13</outgoing>
    </serviceTask>
    
    <!-- Consentimiento requerido: Verificar si está obtenido -->
    <exclusiveGateway id="consentObtainedGateway" name="Consent Obtained?">
      <incoming>flow12</incoming>
      <outgoing>flow14</outgoing>
      <outgoing>flow15</outgoing>
    </exclusiveGateway>
    
    <!-- Consentimiento no obtenido: Solicitar -->
    <userTask id="requestConsent" name="Request Consent" activiti:candidateGroups="compliance-officers,data-subjects" activiti:formKey="dataset-request-consent-form" activiti:priority="70">
      <incoming>flow14</incoming>
      <outgoing>flow16</outgoing>
      <documentation>Solicitar consentimiento del interesado según GDPR Art. 7</documentation>
    </userTask>
    
    <!-- Gateway: ¿Consentimiento obtenido? -->
    <exclusiveGateway id="consentDecisionGateway" name="Consent Decision">
      <incoming>flow16</incoming>
      <outgoing>flow17</outgoing>
      <outgoing>flow18</outgoing>
    </exclusiveGateway>
    
    <!-- Consentimiento denegado: Rechazar -->
    <serviceTask id="rejectNoConsent" name="Reject No Consent" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.RejectDatasetPrivacyDelegate">
      <incoming>flow17</incoming>
      <outgoing>flow9</outgoing>
    </serviceTask>
    
    <!-- Consentimiento obtenido: Evaluar DPIA -->
    <serviceTask id="assessDPIAWithConsent" name="Assess DPIA Requirement" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.AssessDPIADelegate">
      <incoming>flow15</incoming>
      <outgoing>flow13</outgoing>
    </serviceTask>
    
    <serviceTask id="assessDPIAAfterConsent" name="Assess DPIA After Consent" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.AssessDPIADelegate">
      <incoming>flow18</incoming>
      <outgoing>flow13</outgoing>
    </serviceTask>
    
    <!-- Gateway: ¿DPIA requerido? -->
    <exclusiveGateway id="dpiaRequiredGateway" name="DPIA Required?">
      <incoming>flow13</incoming>
      <outgoing>flow19</outgoing>
      <outgoing>flow20</outgoing>
    </exclusiveGateway>
    
    <!-- DPIA no requerido: Aprobar -->
    <serviceTask id="approveNoDPIA" name="Approve No DPIA Required" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.ApproveDatasetPrivacyDelegate">
      <incoming>flow19</incoming>
      <outgoing>flow5</outgoing>
    </serviceTask>
    
    <!-- DPIA requerido: Generar DPIA -->
    <serviceTask id="generateDPIA" name="Generate DPIA Document" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.GenerateDPIADelegate">
      <incoming>flow20</incoming>
      <outgoing>flow21</outgoing>
    </serviceTask>
    
    <!-- Revisión humana de DPIA -->
    <userTask id="reviewDPIA" name="Review DPIA" activiti:candidateGroups="compliance-officers,data-protection-officers" activiti:formKey="dataset-dpia-review-form" activiti:priority="80">
      <incoming>flow21</incoming>
      <outgoing>flow22</outgoing>
      <documentation>Revisar DPIA generado según GDPR Art. 35</documentation>
    </userTask>
    
    <!-- Gateway: ¿DPIA aprobado? -->
    <exclusiveGateway id="dpiaDecisionGateway" name="DPIA Decision">
      <incoming>flow22</incoming>
      <outgoing>flow23</outgoing>
      <outgoing>flow24</outgoing>
    </exclusiveGateway>
    
    <!-- DPIA aprobado: Aprobar -->
    <serviceTask id="approveDPIA" name="Approve DPIA" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.ApproveDatasetPrivacyDelegate">
      <incoming>flow23</incoming>
      <outgoing>flow5</outgoing>
    </serviceTask>
    
    <!-- DPIA rechazado: Solicitar correcciones -->
    <userTask id="requestDPIACorrections" name="Request DPIA Corrections" activiti:candidateGroups="data-engineers,compliance-officers" activiti:formKey="dataset-dpia-corrections-form" activiti:priority="60">
      <incoming>flow24</incoming>
      <outgoing>flow25</outgoing>
      <documentation>Solicitar correcciones al DPIA</documentation>
    </userTask>
    
    <!-- Volver a generar DPIA con correcciones -->
    <sequenceFlow id="flow25" sourceRef="requestDPIACorrections" targetRef="generateDPIA"></sequenceFlow>
    
    <!-- Guardar evaluación de privacidad -->
    <serviceTask id="storePrivacyAssessment" name="Store Privacy Assessment" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.StoreDatasetPrivacyAssessmentDelegate">
      <incoming>flow5</incoming>
      <outgoing>flow26</outgoing>
    </serviceTask>
    
    <!-- Notificar resultado -->
    <serviceTask id="notifyPrivacyAssessment" name="Notify Privacy Assessment Result" activiti:class="com.codeflowx.govern.workflow.delegates.dataset.NotifyDatasetPrivacyAssessmentDelegate">
      <incoming>flow26</incoming>
      <incoming>flow9</incoming>
      <outgoing>flow27</outgoing>
    </serviceTask>
    
    <endEvent id="endPrivacyAssessment" name="Privacy Assessment Completed">
      <incoming>flow27</incoming>
    </endEvent>
    
    <!-- Sequence Flows -->
    <sequenceFlow id="flow1" sourceRef="startPrivacyAssessment" targetRef="detectPII"></sequenceFlow>
    <sequenceFlow id="flow2" sourceRef="detectPII" targetRef="piiGateway"></sequenceFlow>
    <sequenceFlow id="flow3" name="No PII" sourceRef="piiGateway" targetRef="autoApproveNoPII">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!piiPresent}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow4" name="PII Present" sourceRef="piiGateway" targetRef="verifyLegalBasis">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${piiPresent}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow5" sourceRef="autoApproveNoPII" targetRef="storePrivacyAssessment"></sequenceFlow>
    <sequenceFlow id="flow6" sourceRef="verifyLegalBasis" targetRef="legalBasisGateway"></sequenceFlow>
    <sequenceFlow id="flow7" name="Invalid" sourceRef="legalBasisGateway" targetRef="rejectInvalidLegalBasis">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!legalBasisValid}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow8" name="Valid" sourceRef="legalBasisGateway" targetRef="verifyConsent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${legalBasisValid}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow9" sourceRef="rejectInvalidLegalBasis" targetRef="notifyPrivacyAssessment"></sequenceFlow>
    <sequenceFlow id="flow10" sourceRef="verifyConsent" targetRef="consentRequiredGateway"></sequenceFlow>
    <sequenceFlow id="flow11" name="Not Required" sourceRef="consentRequiredGateway" targetRef="assessDPIA">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!consentRequired}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow12" name="Required" sourceRef="consentRequiredGateway" targetRef="consentObtainedGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${consentRequired}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow13" sourceRef="assessDPIA" targetRef="dpiaRequiredGateway"></sequenceFlow>
    <sequenceFlow id="flow14" name="Not Obtained" sourceRef="consentObtainedGateway" targetRef="requestConsent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!consentObtained}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow15" name="Obtained" sourceRef="consentObtainedGateway" targetRef="assessDPIAWithConsent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${consentObtained}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow16" sourceRef="requestConsent" targetRef="consentDecisionGateway"></sequenceFlow>
    <sequenceFlow id="flow17" name="Denied" sourceRef="consentDecisionGateway" targetRef="rejectNoConsent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${consentDecision == 'DENIED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow18" name="Granted" sourceRef="consentDecisionGateway" targetRef="assessDPIAAfterConsent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${consentDecision == 'GRANTED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow19" name="Not Required" sourceRef="dpiaRequiredGateway" targetRef="approveNoDPIA">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!dpiaRequired}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow20" name="Required" sourceRef="dpiaRequiredGateway" targetRef="generateDPIA">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${dpiaRequired}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow21" sourceRef="generateDPIA" targetRef="reviewDPIA"></sequenceFlow>
    <sequenceFlow id="flow22" sourceRef="reviewDPIA" targetRef="dpiaDecisionGateway"></sequenceFlow>
    <sequenceFlow id="flow23" name="Approved" sourceRef="dpiaDecisionGateway" targetRef="approveDPIA">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${dpiaDecision == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow24" name="Rejected" sourceRef="dpiaDecisionGateway" targetRef="requestDPIACorrections">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${dpiaDecision == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow26" sourceRef="storePrivacyAssessment" targetRef="notifyPrivacyAssessment"></sequenceFlow>
    <sequenceFlow id="flow27" sourceRef="notifyPrivacyAssessment" targetRef="endPrivacyAssessment"></sequenceFlow>
  </process>
  
  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_dataset-privacy-assessment-v1">
    <bpmndi:BPMNPlane bpmnElement="dataset-privacy-assessment-v1" id="BPMNPlane_dataset-privacy-assessment-v1">
      <!-- Diagram elements would go here -->
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>

