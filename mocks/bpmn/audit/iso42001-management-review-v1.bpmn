<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://codeflowx.com/govern/iso42001/management-review"
             expressionLanguage="http://www.w3.org/1999/XPath"
             typeLanguage="http://www.w3.org/2001/XMLSchema">

  <process id="iso42001ManagementReviewV1"
           name="ISO 42001 Management Review"
           isExecutable="true"
           versionTag="1.0">

    <startEvent id="managementReviewTimer" name="Trimestral">
      <timerEventDefinition>
        <timeCycle>R/PT2160H</timeCycle>
      </timerEventDefinition>
      <outgoing>flowPreparePerformance</outgoing>
    </startEvent>

    <serviceTask id="preparePerformanceData"
                 name="Preparar datos de desempeño"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.PreparePerformanceDataDelegate">
      <incoming>flowPreparePerformance</incoming>
      <outgoing>flowGenerateReport</outgoing>
    </serviceTask>

    <serviceTask id="generateManagementReviewReport"
                 name="Generar informe de revisión"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.GenerateManagementReviewReportDelegate">
      <incoming>flowGenerateReport</incoming>
      <outgoing>flowScheduleMeeting</outgoing>
    </serviceTask>

    <userTask id="scheduleManagementReviewMeeting"
              name="Planificar reunión"
              flowable:formKey="console/bpmn/management-review-schedule-form.zul"
              flowable:candidateGroups="compliance-coordinators">
      <incoming>flowScheduleMeeting</incoming>
      <outgoing>flowConductReview</outgoing>
    </userTask>

    <userTask id="conductManagementReview"
              name="Realizar revisión"
              flowable:formKey="console/bpmn/management-review-form.zul"
              flowable:candidateGroups="top-management">
      <incoming>flowConductReview</incoming>
      <outgoing>flowRecordDecisions</outgoing>
    </userTask>

    <serviceTask id="recordManagementDecisions"
                 name="Registrar decisiones"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.RecordManagementDecisionsDelegate">
      <incoming>flowRecordDecisions</incoming>
      <outgoing>flowSplitActions</outgoing>
    </serviceTask>

    <parallelGateway id="actionsGateway">
      <incoming>flowSplitActions</incoming>
      <outgoing>flowAssignActionItems</outgoing>
      <outgoing>flowNotifyStakeholders</outgoing>
    </parallelGateway>

    <userTask id="assignActionItems"
              name="Asignar acciones"
              flowable:formKey="console/bpmn/management-review-actions-form.zul"
              flowable:candidateGroups="compliance-coordinators">
      <incoming>flowAssignActionItems</incoming>
      <outgoing>flowJoinActions</outgoing>
    </userTask>

    <serviceTask id="notifyStakeholders"
                 name="Notificar stakeholders"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.NotifyManagementStakeholdersDelegate">
      <incoming>flowNotifyStakeholders</incoming>
      <outgoing>flowJoinNotifications</outgoing>
    </serviceTask>

    <parallelGateway id="joinGateway">
      <incoming>flowJoinActions</incoming>
      <incoming>flowJoinNotifications</incoming>
      <outgoing>flowArchive</outgoing>
    </parallelGateway>

    <serviceTask id="archiveReview"
                 name="Archivar revisión"
                 flowable:class="com.codeflowx.govern.workflow.delegates.iso42001.ArchiveManagementReviewDelegate">
      <incoming>flowArchive</incoming>
      <outgoing>flowEnd</outgoing>
    </serviceTask>

    <endEvent id="endManagementReview" name="Completado">
      <incoming>flowEnd</incoming>
    </endEvent>

    <sequenceFlow id="flowPreparePerformance" sourceRef="managementReviewTimer" targetRef="preparePerformanceData"/>
    <sequenceFlow id="flowGenerateReport" sourceRef="preparePerformanceData" targetRef="generateManagementReviewReport"/>
    <sequenceFlow id="flowScheduleMeeting" sourceRef="generateManagementReviewReport" targetRef="scheduleManagementReviewMeeting"/>
    <sequenceFlow id="flowConductReview" sourceRef="scheduleManagementReviewMeeting" targetRef="conductManagementReview"/>
    <sequenceFlow id="flowRecordDecisions" sourceRef="conductManagementReview" targetRef="recordManagementDecisions"/>
    <sequenceFlow id="flowSplitActions" sourceRef="recordManagementDecisions" targetRef="actionsGateway"/>
    <sequenceFlow id="flowAssignActionItems" sourceRef="actionsGateway" targetRef="assignActionItems"/>
    <sequenceFlow id="flowNotifyStakeholders" sourceRef="actionsGateway" targetRef="notifyStakeholders"/>
    <sequenceFlow id="flowJoinActions" sourceRef="assignActionItems" targetRef="joinGateway"/>
    <sequenceFlow id="flowJoinNotifications" sourceRef="notifyStakeholders" targetRef="joinGateway"/>
    <sequenceFlow id="flowArchive" sourceRef="joinGateway" targetRef="archiveReview"/>
    <sequenceFlow id="flowEnd" sourceRef="archiveReview" targetRef="endManagementReview"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_iso42001ManagementReview">
    <bpmndi:BPMNPlane id="BPMNPlane_iso42001ManagementReview" bpmnElement="iso42001ManagementReviewV1"/>
  </bpmndi:BPMNDiagram>
</definitions>


