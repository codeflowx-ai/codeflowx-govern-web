        <omgdi:waypoint x="1300.0" y="317.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowApprove" id="BPMNEdge_flowApprove">
        <omgdi:waypoint x="1320.0" y="297.0"></omgdi:waypoint>
        <omgdi:waypoint x="1320.0" y="180.0"></omgdi:waypoint>
        <omgdi:waypoint x="1490.0" y="177.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="100.0" x="1330.0" y="221.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowApprove2" id="BPMNEdge_flowApprove2">
        <omgdi:waypoint x="1621.0" y="177.0"></omgdi:waypoint>
        <omgdi:waypoint x="1660.0" y="179.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowApprove3" id="BPMNEdge_flowApprove3">
        <omgdi:waypoint x="1790.0" y="179.0"></omgdi:waypoint>
        <omgdi:waypoint x="1830.0" y="179.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowConditional" id="BPMNEdge_flowConditional">
        <omgdi:waypoint x="1340.0" y="317.0"></omgdi:waypoint>
        <omgdi:waypoint x="1489.0" y="317.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="100.0" x="1340.0" y="317.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowConditional2" id="BPMNEdge_flowConditional2">
        <omgdi:waypoint x="1622.0" y="317.0"></omgdi:waypoint>
