package com.codeflowx.govern.workflow.drools.dataset

import com.codeflowx.govern.workflow.drools.facts.DatasetQualityFact

// ============================================================================
// Reglas Drools para Dataset Quality Governance
// ============================================================================

// ----------------------------------------------------------------------------
// REGLA 1: Dataset de Alta Calidad - Auto-aprobar
// ----------------------------------------------------------------------------
rule "High Quality Dataset - Auto Approve"
    salience 100
    when
        $fact: DatasetQualityFact(
            overallQualityScore >= 90.0,
            validityScore >= 0.90,
            completenessScore >= 0.90,
            piiFound == false,
            biasScore >= 80.0,
            gdprCompliant == true
        )
    then
        $fact.setDecision("APPROVED");
        $fact.setRequiresHumanReview(false);
        $fact.setJustification("High quality dataset - All metrics passed");
        $fact.setConfidenceLevel(95);
        System.out.println("✅ Rule fired: High Quality Dataset - Auto Approve");
end

// ----------------------------------------------------------------------------
// REGLA 2: PII Crítico Detectado - Requiere Revisión Humana
// ----------------------------------------------------------------------------
rule "Critical PII Detected - Require Human Review"
    salience 200  // Alta prioridad
    when
        $fact: DatasetQualityFact(
            piiFound == true,
            (piiSeverity == "HIGH" || piiSeverity == "CRITICAL"),
            totalPiiDetected > 100
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("Critical: PII detected in " + $fact.getTotalPiiDetected() + " records");
        $fact.setConfidenceLevel(30);
        System.out.println("⚠️ Rule fired: Critical PII Detected - Require Human Review");
end

// ----------------------------------------------------------------------------
// REGLA 3: No cumple GDPR - Auto-rechazar
// ----------------------------------------------------------------------------
rule "GDPR Non-Compliant - Auto Reject"
    salience 250  // Máxima prioridad
    when
        $fact: DatasetQualityFact(
            gdprCompliant == false
        )
    then
        $fact.setDecision("REJECTED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("REJECTED: Dataset does not comply with GDPR regulations");
        $fact.setConfidenceLevel(10);
        System.out.println("❌ Rule fired: GDPR Non-Compliant - Auto Reject");
end

// ----------------------------------------------------------------------------
// REGLA 4: Bias Crítico - Rechazar
// ----------------------------------------------------------------------------
rule "Critical Bias Detected - Reject"
    salience 240
    when
        $fact: DatasetQualityFact(
            biasSeverity == "CRITICAL",
            biasScore < 40.0
        )
    then
        $fact.setDecision("REJECTED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("REJECTED: Critical bias detected (fairness score: " + $fact.getBiasScore() + "%)");
        $fact.setConfidenceLevel(15);
        System.out.println("❌ Rule fired: Critical Bias Detected - Reject");
end

// ----------------------------------------------------------------------------
// REGLA 5: Bias Alto - Requiere Revisión
// ----------------------------------------------------------------------------
rule "High Bias Detected - Require Review"
    salience 180
    when
        $fact: DatasetQualityFact(
            biasSeverity == "HIGH",
            biasScore < 60.0,
            decision == null
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("High bias detected - Manual fairness review required");
        $fact.setConfidenceLevel(40);
        System.out.println("⚠️ Rule fired: High Bias Detected - Require Review");
end

// ----------------------------------------------------------------------------
// REGLA 6: Calidad Media - Requiere Revisión
// ----------------------------------------------------------------------------
rule "Medium Quality Dataset - Require Review"
    salience 90
    when
        $fact: DatasetQualityFact(
            overallQualityScore >= 75.0,
            overallQualityScore < 90.0,
            piiFound == false || piiSeverity == "LOW",
            decision == null
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("Quality score: " + $fact.getOverallQualityScore() + "% - Manual review recommended");
        $fact.setConfidenceLevel(60);
        System.out.println("⚠️ Rule fired: Medium Quality Dataset - Require Review");
end

// ----------------------------------------------------------------------------
// REGLA 7: Calidad Baja - Rechazar
// ----------------------------------------------------------------------------
rule "Low Quality Dataset - Reject"
    salience 150
    when
        $fact: DatasetQualityFact(
            overallQualityScore < 75.0,
            decision == null
        )
    then
        $fact.setDecision("REJECTED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("REJECTED: Quality score below minimum threshold (" + $fact.getOverallQualityScore() + "% < 75%)");
        $fact.setConfidenceLevel(20);
        System.out.println("❌ Rule fired: Low Quality Dataset - Reject");
end

// ----------------------------------------------------------------------------
// REGLA 8: Dataset Pequeño con Problemas - Revisión
// ----------------------------------------------------------------------------
rule "Small Dataset with Issues - Require Review"
    salience 120
    when
        $fact: DatasetQualityFact(
            totalRows < 1000,
            (validityScore < 0.85 || completenessScore < 0.85),
            decision == null
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("Small dataset (" + $fact.getTotalRows() + " rows) with quality issues - Manual review required");
        $fact.setConfidenceLevel(50);
        System.out.println("⚠️ Rule fired: Small Dataset with Issues - Require Review");
end

// ----------------------------------------------------------------------------
// REGLA 9: Muchos Missing Values - Revisión
// ----------------------------------------------------------------------------
rule "High Missing Values - Require Review"
    salience 130
    when
        $fact: DatasetQualityFact(
            missingPercentage > 15.0,
            decision == null
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("High percentage of missing values (" + $fact.getMissingPercentage() + "%) - Imputation strategy needed");
        $fact.setConfidenceLevel(45);
        System.out.println("⚠️ Rule fired: High Missing Values - Require Review");
end

// ----------------------------------------------------------------------------
// REGLA 10: Default - Si ninguna regla aplicó
// ----------------------------------------------------------------------------
rule "Default Decision - Require Review"
    salience 10  // Baja prioridad (última opción)
    when
        $fact: DatasetQualityFact(
            decision == null
        )
    then
        $fact.setDecision("REVIEW_REQUIRED");
        $fact.setRequiresHumanReview(true);
        $fact.setJustification("Edge case - Manual review recommended for safety");
        $fact.setConfidenceLevel(50);
        System.out.println("⚠️ Rule fired: Default Decision - Require Review");
end
