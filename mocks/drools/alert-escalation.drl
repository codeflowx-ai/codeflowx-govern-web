package com.codeflowx.govern.workflow.drools.alert;

import com.codeflowx.govern.workflow.drools.facts.AlertClassificationFact;

global org.slf4j.Logger logger;

// ============================================
// REGLA 1: CRITICAL ALERT - Production + High Impact
// ============================================
rule "Critical Alert - Production Service Down"
    salience 200
    when
        $fact : AlertClassificationFact(
            isProduction == true,
            (alertType == "DRIFT_DETECTED" && degradationPercentage > 40) ||
            (alertType == "PERFORMANCE_DEGRADATION" && metricValue > metricThreshold * 2) ||
            alertType == "SERVICE_DOWN"
        )
    then
        logger.error("🚨 DROOLS: CRITICAL ALERT - Production impact");

        $fact.setSeverity("CRITICAL");
        $fact.setPriority("P1");
        $fact.setSlaMinutes(15);
        $fact.setEscalationChannel("PAGERDUTY");
        $fact.setAssignedTeam("mlops-engineers");
        $fact.setRequiresImmediateAction(true);

        update($fact);
end

// ============================================
// REGLA 2: HIGH ALERT - Performance Issues
// ============================================
rule "High Alert - Performance Degradation"
    salience 100
    when
        $fact : AlertClassificationFact(
            alertCategory == "MODEL_MONITORING" || alertCategory == "INFRASTRUCTURE",
            degradationPercentage > 20,
            degradationPercentage <= 40,
            severity == null
        )
    then
        logger.warn("🔴 DROOLS: HIGH Alert - Performance degradation");

        $fact.setSeverity("HIGH");
        $fact.setPriority("P2");
        $fact.setSlaMinutes(120);  // 2 hours
        $fact.setEscalationChannel("SLACK");
        $fact.setAssignedTeam("ml-engineers");
        $fact.setRequiresImmediateAction(false);

        update($fact);
end

// ============================================
// REGLA 3: MEDIUM ALERT - Warnings
// ============================================
rule "Medium Alert - Warning Level"
    salience 90
    when
        $fact : AlertClassificationFact(
            degradationPercentage > 10,
            degradationPercentage <= 20,
            severity == null
        )
    then
        logger.info("🟡 DROOLS: MEDIUM Alert - Warning");

        $fact.setSeverity("MEDIUM");
        $fact.setPriority("P3");
        $fact.setSlaMinutes(1440);  // 24 hours
        $fact.setEscalationChannel("SLACK");
        $fact.setAssignedTeam("ml-engineers");
        $fact.setRequiresImmediateAction(false);

        update($fact);
end

// ============================================
// REGLA 4: LOW ALERT - Informational
// ============================================
rule "Low Alert - Informational"
    salience 80
    when
        $fact : AlertClassificationFact(
            degradationPercentage <= 10,
            severity == null
        )
    then
        logger.info("🟢 DROOLS: LOW Alert - Informational");

        $fact.setSeverity("LOW");
        $fact.setPriority("P4");
        $fact.setSlaMinutes(10080);  // 7 days
        $fact.setEscalationChannel("EMAIL");
        $fact.setAssignedTeam("ml-engineers");
        $fact.setRequiresImmediateAction(false);

        update($fact);
end

// ============================================
// REGLA 5: COMPLIANCE VIOLATION - Always HIGH
// ============================================
rule "Compliance Violation - Always High Priority"
    salience 150
    when
        $fact : AlertClassificationFact(
            alertCategory == "COMPLIANCE" || alertCategory == "SECURITY"
        )
    then
        logger.error("🚨 DROOLS: COMPLIANCE/SECURITY Alert - High priority");

        $fact.setSeverity("HIGH");
        $fact.setPriority("P2");
        $fact.setSlaMinutes(60);  // 1 hour
        $fact.setEscalationChannel("SLACK");
        $fact.setAssignedTeam("governance-admins");
        $fact.setRequiresImmediateAction(true);

        update($fact);
end
