'use client';

import React, { useState, useEffect } from 'react';
import { Card, CardBody, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { 
    Settings, 
    CheckCircle, 
    AlertTriangle, 
    Clock,
    TrendingUp,
    BarChart3,
    RefreshCw,
    Plus,
    Edit,
    Trash2,
    Eye,
    Shield,
    Lock,
    Activity,
    FileText
} from 'lucide-react';
import { governanceService } from '../services/governanceService';
import { Policy } from '../types/governance';

import UmamiTracker from "@/components/analytics/UmamiTracker";
export default function PoliciesPage() {
    const [policies, setPolicies] = useState<Policy[]>([]);
    const [loading, setLoading] = useState(true);
    const [selectedCategory, setSelectedCategory] = useState<string>('all');
    const [showAddPolicyModal, setShowAddPolicyModal] = useState(false);

    useEffect(() => {
        loadData();
    }, []);

    const loadData = async () => {
        try {
            setLoading(true);
            const response = await governanceService.getPolicies();
            if (response.success) {
                setPolicies(response.policies);
            }
        } catch (error) {
            console.error('Error loading policies data:', error);
        } finally {
            setLoading(false);
        }
    };

    const handleUpdatePolicy = async (policyId: string, status: 'active' | 'inactive', enforcementLevel: 'strict' | 'moderate' | 'flexible') => {
        try {
            await governanceService.updatePolicy({ policyId, status, enforcementLevel });
            await loadData(); // Reload data
        } catch (error) {
            console.error('Error updating policy:', error);
        }
    };

    const getStatusColor = (status: string) => {
        switch (status) {
            case 'active': return 'bg-green-100 text-green-800';
            case 'inactive': return 'bg-gray-100 text-gray-800';
            case 'draft': return 'bg-yellow-100 text-yellow-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    };

    const getStatusText = (status: string) => {
        switch (status) {
            case 'active': return 'Activa';
            case 'inactive': return 'Inactiva';
            case 'draft': return 'Borrador';
            default: return 'Desconocido';
        }
    };

    const getEnforcementColor = (level: string) => {
        switch (level) {
            case 'strict': return 'bg-red-100 text-red-800';
            case 'moderate': return 'bg-yellow-100 text-yellow-800';
            case 'flexible': return 'bg-green-100 text-green-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    };

    const getEnforcementText = (level: string) => {
        switch (level) {
            case 'strict': return 'Estricto';
            case 'moderate': return 'Moderado';
            case 'flexible': return 'Flexible';
            default: return 'Desconocido';
        }
    };

    const getCategoryIcon = (category: string) => {
        switch (category) {
            case 'security': return <Shield className="h-4 w-4" />;
            case 'compliance': return <CheckCircle className="h-4 w-4" />;
            case 'performance': return <Activity className="h-4 w-4" />;
            case 'ethical': return <Lock className="h-4 w-4" />;
            default: return <Settings className="h-4 w-4" />;
        }
    };

    const getCategoryColor = (category: string) => {
        switch (category) {
            case 'security': return 'bg-red-100 text-red-800';
            case 'compliance': return 'bg-blue-100 text-blue-800';
            case 'performance': return 'bg-green-100 text-green-800';
            case 'ethical': return 'bg-purple-100 text-purple-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    };

    const getCategoryText = (category: string) => {
        switch (category) {
            case 'security': return 'Seguridad';
            case 'compliance': return 'Compliance';
            case 'performance': return 'Rendimiento';
            case 'ethical': return 'Ética';
            default: return 'Otro';
        }
    };

    const filteredPolicies = selectedCategory === 'all' 
        ? policies 
        : policies.filter(policy => policy.category === selectedCategory);

    const activePolicies = policies.filter(p => p.status === 'active').length;
    const totalPolicies = policies.length;

    if (loading) {
        return (
            <div className="flex items-center justify-center h-64">
      <UmamiTracker />
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            </div>
        );
    }

    return (
        <div className="space-y-6">
            {/* Header */}
            <div className="flex items-center justify-between">
                <div>
                    <h1 className="text-3xl font-bold text-gray-900">Gestión de Políticas</h1>
                    <p className="text-gray-600">Configura y gestiona las políticas de gobierno de IA</p>
                </div>
                <div className="flex items-center gap-2">
                    <Button onClick={loadData} variant="outline" className="flex items-center gap-1">
                        <RefreshCw className="h-4 w-4" />
                        Actualizar
                    </Button>
                    <Button 
                        className="flex items-center gap-1"
                        onClick={() => setShowAddPolicyModal(true)}
                    >
                        <Plus className="h-4 w-4" />
                        Nueva Política
                    </Button>
                </div>
            </div>

            {/* Métricas de Políticas */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Total Políticas</p>
                                <p className="text-2xl font-bold text-gray-900">
                                    {totalPolicies}
                                </p>
                            </div>
                            <Settings className="h-8 w-8 text-blue-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingUp className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">+3 vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>

                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Políticas Activas</p>
                                <p className="text-2xl font-bold text-gray-900">
                                    {activePolicies}
                                </p>
                            </div>
                            <CheckCircle className="h-8 w-8 text-green-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingUp className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">+2 vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>

                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Tasa de Aplicación</p>
                                <p className="text-2xl font-bold text-gray-900">
                                    {totalPolicies > 0 ? Math.round((activePolicies / totalPolicies) * 100) : 0}%
                                </p>
                            </div>
                            <BarChart3 className="h-8 w-8 text-purple-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingUp className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">+5.2% vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>

                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Reglas Totales</p>
                                <p className="text-2xl font-bold text-gray-900">
                                    {policies.reduce((acc, policy) => acc + policy.rules.length, 0)}
                                </p>
                            </div>
                            <FileText className="h-8 w-8 text-orange-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingUp className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">+12 vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </div>

            {/* Filtros de Categoría */}
            <Card>
                <CardBody className="p-4">
                    <div className="flex flex-wrap gap-2">
                        <Button
                            variant={selectedCategory === 'all' ? 'primary' : 'outline'}
                            size="sm"
                            onClick={() => setSelectedCategory('all')}
                        >
                            Todas ({totalPolicies})
                        </Button>
                        <Button
                            variant={selectedCategory === 'security' ? 'primary' : 'outline'}
                            size="sm"
                            onClick={() => setSelectedCategory('security')}
                            className="flex items-center gap-1"
                        >
                            <Shield className="h-3 w-3" />
                            Seguridad ({policies.filter(p => p.category === 'security').length})
                        </Button>
                        <Button
                            variant={selectedCategory === 'compliance' ? 'primary' : 'outline'}
                            size="sm"
                            onClick={() => setSelectedCategory('compliance')}
                            className="flex items-center gap-1"
                        >
                            <CheckCircle className="h-3 w-3" />
                            Compliance ({policies.filter(p => p.category === 'compliance').length})
                        </Button>
                        <Button
                            variant={selectedCategory === 'performance' ? 'primary' : 'outline'}
                            size="sm"
                            onClick={() => setSelectedCategory('performance')}
                            className="flex items-center gap-1"
                        >
                            <Activity className="h-3 w-3" />
                            Rendimiento ({policies.filter(p => p.category === 'performance').length})
                        </Button>
                        <Button
                            variant={selectedCategory === 'ethical' ? 'primary' : 'outline'}
                            size="sm"
                            onClick={() => setSelectedCategory('ethical')}
                            className="flex items-center gap-1"
                        >
                            <Lock className="h-3 w-3" />
                            Ética ({policies.filter(p => p.category === 'ethical').length})
                        </Button>
                    </div>
                </CardBody>
            </Card>

            {/* Lista de Políticas */}
            <Card>
                <CardHeader>
                    <div className="flex items-center justify-between">
                        <CardTitle className="flex items-center gap-2">
                            <Settings className="h-5 w-5" />
                            Políticas ({filteredPolicies.length})
                        </CardTitle>
                        <Button 
                            className="flex items-center gap-2"
                            onClick={() => setShowAddPolicyModal(true)}
                        >
                            <Plus className="h-4 w-4" />
                            Añadir Nueva Política
                        </Button>
                    </div>
                </CardHeader>
                <CardBody>
                    <div className="space-y-4">
                        {filteredPolicies.length === 0 ? (
                            <div className="text-center py-8">
                                <Settings className="h-12 w-12 text-gray-400 mx-auto mb-4" />
                                <h3 className="text-lg font-medium text-gray-900 mb-2">No hay políticas</h3>
                                <p className="text-gray-600">No se encontraron políticas en esta categoría</p>
                            </div>
                        ) : (
                            filteredPolicies.map((policy) => (
                                <div key={policy.id} className="border rounded-lg p-6 hover:bg-gray-50 transition-colors">
                                    <div className="flex items-start justify-between mb-4">
                                        <div className="flex items-start gap-3">
                                            {getCategoryIcon(policy.category)}
                                            <div className="flex-1">
                                                <div className="flex items-center gap-2 mb-2">
                                                    <h4 className="font-semibold text-gray-900">{policy.name}</h4>
                                                    <Badge className={getCategoryColor(policy.category)}>
                                                        {getCategoryText(policy.category)}
                                                    </Badge>
                                                </div>
                                                <p className="text-sm text-gray-600 mb-3">{policy.description}</p>
                                                <div className="flex items-center gap-4 text-sm">
                                                    <span className="text-gray-500">
                                                        Creada: {new Date(policy.createdAt).toLocaleDateString('es-ES')}
                                                    </span>
                                                    <span className="text-gray-500">
                                                        Actualizada: {new Date(policy.updatedAt).toLocaleDateString('es-ES')}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div className="flex items-center gap-2">
                                            <Badge className={getStatusColor(policy.status)}>
                                                {getStatusText(policy.status)}
                                            </Badge>
                                            <Badge className={getEnforcementColor(policy.enforcementLevel)}>
                                                {getEnforcementText(policy.enforcementLevel)}
                                            </Badge>
                                        </div>
                                    </div>

                                    {/* Reglas de la Política */}
                                    <div className="mb-4">
                                        <h5 className="font-medium text-gray-900 mb-2">Reglas ({policy.rules.length})</h5>
                                        <div className="space-y-2">
                                            {policy.rules.map((rule) => (
                                                <div key={rule.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                                    <div className="flex-1">
                                                        <div className="flex items-center gap-2 mb-1">
                                                            <span className="font-medium text-sm">{rule.name}</span>
                                                            <Badge className="text-xs bg-gray-100 text-gray-800">
                                                                Prioridad {rule.priority}
                                                            </Badge>
                                                        </div>
                                                        <div className="text-xs text-gray-600 space-y-1">
                                                            <div><strong>Condición:</strong> {rule.condition}</div>
                                                            <div><strong>Acción:</strong> {rule.action}</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>

                                    {/* Acciones */}
                                    <div className="flex items-center justify-between">
                                        <div className="flex items-center gap-2">
                                            <Button
                                                size="sm"
                                                variant="outline"
                                                onClick={() => handleUpdatePolicy(
                                                    policy.id, 
                                                    policy.status === 'active' ? 'inactive' : 'active',
                                                    policy.enforcementLevel
                                                )}
                                            >
                                                {policy.status === 'active' ? 'Desactivar' : 'Activar'}
                                            </Button>
                                            <Button size="sm" variant="outline" className="flex items-center gap-1">
                                                <Edit className="h-3 w-3" />
                                                Editar
                                            </Button>
                                            <Button size="sm" variant="outline" className="flex items-center gap-1">
                                                <Eye className="h-3 w-3" />
                                                Ver Detalles
                                            </Button>
                                        </div>
                                        <Button size="sm" variant="danger" className="text-red-600 hover:text-red-700">
                                            <Trash2 className="h-3 w-3" />
                                        </Button>
                                    </div>
                                </div>
                            ))
                        )}
                    </div>
                </CardBody>
            </Card>

            {/* Configuración de Políticas */}
            <Card>
                <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                        <Settings className="h-5 w-5" />
                        Configuración de Políticas
                    </CardTitle>
                </CardHeader>
                <CardBody>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h4 className="font-semibold mb-3">Configuración General</h4>
                            <div className="space-y-3">
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Aplicación automática:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Validación en tiempo real:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Notificaciones de violación:</span>
                                    <Badge className="bg-green-100 text-green-800">Activas</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Auditoría automática:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h4 className="font-semibold mb-3">Configuración de Escalación</h4>
                            <div className="space-y-3">
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Escalación automática:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Nivel de aprobación:</span>
                                    <span className="font-medium">Manager</span>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Tiempo de respuesta:</span>
                                    <span className="font-medium">24 horas</span>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Auto-bloqueo:</span>
                                    <Badge className="bg-green-100 text-green-800">Activo</Badge>
                                </div>
                            </div>
                        </div>
                    </div>
                </CardBody>
            </Card>

            {/* Modal para Añadir Nueva Política */}
            {showAddPolicyModal && (
                <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div className="bg-white rounded-lg p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
                        <div className="flex items-center justify-between mb-4">
                            <h3 className="text-lg font-semibold">Añadir Nueva Política</h3>
                            <Button 
                                variant="ghost" 
                                size="sm"
                                onClick={() => setShowAddPolicyModal(false)}
                            >
                                ✕
                            </Button>
                        </div>
                        
                        <div className="space-y-4">
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">
                                    Nombre de la Política
                                </label>
                                <input 
                                    type="text" 
                                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    placeholder="Ej: Política de Seguridad de Datos"
                                />
                            </div>
                            
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">
                                    Descripción
                                </label>
                                <textarea 
                                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    rows={3}
                                    placeholder="Describe el propósito y alcance de esta política"
                                />
                            </div>
                            
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">
                                    Categoría
                                </label>
                                <select className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="security">Seguridad</option>
                                    <option value="compliance">Compliance</option>
                                    <option value="performance">Rendimiento</option>
                                    <option value="ethical">Ética</option>
                                </select>
                            </div>
                            
                            <div>
                                <label className="block text-sm font-medium text-gray-700 mb-1">
                                    Nivel de Aplicación
                                </label>
                                <select className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="strict">Estricto</option>
                                    <option value="moderate">Moderado</option>
                                    <option value="flexible">Flexible</option>
                                </select>
                            </div>
                        </div>
                        
                        <div className="flex justify-end gap-2 mt-6">
                            <Button 
                                variant="outline"
                                onClick={() => setShowAddPolicyModal(false)}
                            >
                                Cancelar
                            </Button>
                            <Button 
                                onClick={() => {
                                    // Aquí iría la lógica para guardar la política
                                    setShowAddPolicyModal(false);
                                }}
                            >
                                Crear Política
                            </Button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
} 
