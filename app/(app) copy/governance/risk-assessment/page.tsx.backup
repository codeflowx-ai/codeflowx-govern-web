'use client';

import React, { useState, useEffect } from 'react';
import { Card, CardBody, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { 
    AlertTriangle, 
    CheckCircle, 
    Clock, 
    TrendingDown,
    BarChart3,
    RefreshCw,
    Settings,
    Eye,
    Shield,
    Activity,
    Target
} from 'lucide-react';
import { governanceService } from '../services/governanceService';
import { RiskAssessmentData } from '../types/governance';

import UmamiTracker from "@/components/analytics/UmamiTracker";
export default function RiskAssessmentPage() {
    const [riskData, setRiskData] = useState<RiskAssessmentData | null>(null);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        loadData();
    }, []);

    const loadData = async () => {
        try {
            setLoading(true);
            const response = await governanceService.getRiskAssessment();
            if (response.success) {
                setRiskData(response.data);
            }
        } catch (error) {
            console.error('Error loading risk assessment data:', error);
        } finally {
            setLoading(false);
        }
    };

    const getRiskLevelColor = (level: string) => {
        switch (level) {
            case 'LOW': return 'bg-green-100 text-green-800';
            case 'MEDIUM': return 'bg-yellow-100 text-yellow-800';
            case 'HIGH': return 'bg-red-100 text-red-800';
            case 'CRITICAL': return 'bg-purple-100 text-purple-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    };

    const getRiskLevelIcon = (level: string) => {
        switch (level) {
            case 'LOW': return <CheckCircle className="h-4 w-4 text-green-500" />;
            case 'MEDIUM': return <AlertTriangle className="h-4 w-4 text-yellow-500" />;
            case 'HIGH': return <AlertTriangle className="h-4 w-4 text-red-500" />;
            case 'CRITICAL': return <Shield className="h-4 w-4 text-purple-500" />;
            default: return <Clock className="h-4 w-4 text-gray-500" />;
        }
    };

    const getRiskScoreColor = (score: number) => {
        if (score <= 30) return 'text-green-600';
        if (score <= 60) return 'text-yellow-600';
        if (score <= 80) return 'text-red-600';
        return 'text-purple-600';
    };

    const getRiskScoreIcon = (score: number) => {
        if (score <= 30) return <CheckCircle className="h-4 w-4 text-green-500" />;
        if (score <= 60) return <AlertTriangle className="h-4 w-4 text-yellow-500" />;
        if (score <= 80) return <AlertTriangle className="h-4 w-4 text-red-500" />;
        return <Shield className="h-4 w-4 text-purple-500" />;
    };

    if (loading) {
        return (
            <div className="flex items-center justify-center h-64">
      <UmamiTracker />
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            </div>
        );
    }

    return (
        <div className="space-y-6">
            {/* Header */}
            <div className="flex items-center justify-between">
                <div>
                    <h1 className="text-3xl font-bold text-gray-900">Evaluación de Riesgos</h1>
                    <p className="text-gray-600">Analiza y monitorea los riesgos de los modelos de IA</p>
                </div>
                <Button onClick={loadData} variant="outline" className="flex items-center gap-1">
                    <RefreshCw className="h-4 w-4" />
                    Actualizar
                </Button>
            </div>

            {/* Métricas de Riesgo */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Nivel de Riesgo General</p>
                                <div className="flex items-center gap-2">
                                    <p className={`text-2xl font-bold ${getRiskScoreColor(riskData?.riskScore || 0)}`}>
                                        {riskData?.riskLevel}
                                    </p>
                                    {getRiskLevelIcon(riskData?.riskLevel || 'UNKNOWN')}
                                </div>
                            </div>
                            <AlertTriangle className="h-8 w-8 text-purple-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingDown className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">-10.5% vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>

                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Risk Score</p>
                                <div className="flex items-center gap-2">
                                    <p className={`text-2xl font-bold ${getRiskScoreColor(riskData?.riskScore || 0)}`}>
                                        {riskData?.riskScore.toFixed(1)}
                                    </p>
                                    {getRiskScoreIcon(riskData?.riskScore || 0)}
                                </div>
                            </div>
                            <Target className="h-8 w-8 text-blue-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingDown className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">-8.2% vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>

                <Card>
                    <CardBody className="p-6">
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm font-medium text-gray-600">Factores de Riesgo</p>
                                <p className="text-2xl font-bold text-gray-900">
                                    {riskData?.riskFactors.length || 0}
                                </p>
                            </div>
                            <Activity className="h-8 w-8 text-orange-600" />
                        </div>
                        <div className="mt-4">
                            <div className="flex items-center text-sm">
                                <TrendingDown className="h-4 w-4 text-green-500 mr-1" />
                                <span className="text-green-600">-2 factores vs mes anterior</span>
                            </div>
                        </div>
                    </CardBody>
                </Card>
            </div>

            {/* Factores de Riesgo */}
            <Card>
                <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                        <AlertTriangle className="h-5 w-5" />
                        Factores de Riesgo Identificados
                    </CardTitle>
                </CardHeader>
                <CardBody>
                    <div className="space-y-4">
                        {riskData?.riskFactors.map((factor, index) => (
                            <div key={index} className="border rounded-lg p-4 hover:bg-gray-50 transition-colors">
                                <div className="flex items-center justify-between mb-3">
                                    <div className="flex items-center gap-3">
                                        {getRiskScoreIcon(factor.score)}
                                        <div>
                                            <h4 className="font-semibold text-gray-900">{factor.name}</h4>
                                            <p className="text-sm text-gray-600">Factor de riesgo identificado</p>
                                        </div>
                                    </div>
                                    <div className="text-right">
                                        <div className={`text-2xl font-bold ${getRiskScoreColor(factor.score)}`}>
                                            {factor.score}
                                        </div>
                                        <div className="text-sm text-gray-600">Score</div>
                                    </div>
                                </div>

                                <div className="mb-3">
                                    <div className="flex justify-between items-center mb-1">
                                        <span className="text-sm text-gray-600">Peso del factor</span>
                                        <span className="text-sm font-medium">{(factor.weight * 100).toFixed(1)}%</span>
                                    </div>
                                    <div className="w-full bg-gray-200 rounded-full h-2">
                                        <div 
                                            className="bg-blue-500 h-2 rounded-full transition-all duration-300"
                                            style={{ width: `${factor.weight * 100}%` }}
                                        />
                                    </div>
                                </div>

                                <div className="flex items-center justify-between text-sm text-gray-500">
                                    <span>Impacto: {factor.score * factor.weight}</span>
                                    <span>Prioridad: {index + 1}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                </CardBody>
            </Card>

            {/* Gráfico de Distribución de Riesgos */}
            <Card>
                <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                        <BarChart3 className="h-5 w-5" />
                        Distribución de Riesgos (Últimos 7 días)
                    </CardTitle>
                </CardHeader>
                <CardBody>
                    <div className="h-64 flex items-end justify-between gap-1">
                        {riskData?.chartData.map((day, index) => {
                            const total = day.low + day.medium + day.high + day.critical;
                            const lowHeight = total > 0 ? (day.low / total) * 100 : 0;
                            const mediumHeight = total > 0 ? (day.medium / total) * 100 : 0;
                            const highHeight = total > 0 ? (day.high / total) * 100 : 0;
                            const criticalHeight = total > 0 ? (day.critical / total) * 100 : 0;
                            
                            return (
                                <div key={index} className="flex flex-col items-center flex-1">
                                    <div className="flex flex-col-reverse w-full h-full gap-1">
                                        <div 
                                            className="w-full bg-green-500 rounded-t transition-all duration-300 hover:bg-green-600"
                                            style={{ height: `${lowHeight}%` }}
                                            title={`${day.date}: ${day.low} bajo`}
                                        />
                                        <div 
                                            className="w-full bg-yellow-500 rounded-t transition-all duration-300 hover:bg-yellow-600"
                                            style={{ height: `${mediumHeight}%` }}
                                            title={`${day.date}: ${day.medium} medio`}
                                        />
                                        <div 
                                            className="w-full bg-red-500 rounded-t transition-all duration-300 hover:bg-red-600"
                                            style={{ height: `${highHeight}%` }}
                                            title={`${day.date}: ${day.high} alto`}
                                        />
                                        <div 
                                            className="w-full bg-purple-500 rounded-t transition-all duration-300 hover:bg-purple-600"
                                            style={{ height: `${criticalHeight}%` }}
                                            title={`${day.date}: ${day.critical} crítico`}
                                        />
                                    </div>
                                    <span className="text-xs text-gray-500 mt-1">
                                        {new Date(day.date).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' })}
                                    </span>
                                </div>
                            );
                        })}
                    </div>
                    <div className="mt-4 flex justify-center gap-6 text-sm">
                        <div className="flex items-center gap-2">
                            <div className="w-3 h-3 bg-green-500 rounded"></div>
                            <span>Bajo</span>
                        </div>
                        <div className="flex items-center gap-2">
                            <div className="w-3 h-3 bg-yellow-500 rounded"></div>
                            <span>Medio</span>
                        </div>
                        <div className="flex items-center gap-2">
                            <div className="w-3 h-3 bg-red-500 rounded"></div>
                            <span>Alto</span>
                        </div>
                        <div className="flex items-center gap-2">
                            <div className="w-3 h-3 bg-purple-500 rounded"></div>
                            <span>Crítico</span>
                        </div>
                    </div>
                </CardBody>
            </Card>

            {/* Recomendaciones de Mitigación */}
            <Card>
                <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                        <Shield className="h-5 w-5" />
                        Recomendaciones de Mitigación
                    </CardTitle>
                </CardHeader>
                <CardBody>
                    <div className="space-y-4">
                        {riskData?.mitigationRecommendations.map((recommendation, index) => (
                            <div key={index} className="flex items-start gap-3 p-4 bg-blue-50 rounded-lg border border-blue-200">
                                <div className="flex-shrink-0 mt-1">
                                    <div className="w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center text-sm font-bold">
                                        {index + 1}
                                    </div>
                                </div>
                                <div className="flex-1">
                                    <p className="text-gray-900 font-medium">{recommendation}</p>
                                    <div className="mt-2 flex gap-2">
                                        <Badge variant="outline" className="text-xs">
                                            Prioridad Alta
                                        </Badge>
                                        <Badge variant="outline" className="text-xs">
                                            Automático
                                        </Badge>
                                    </div>
                                </div>
                                <Button size="sm" variant="outline" className="flex-shrink-0">
                                    <Eye className="h-3 w-3 mr-1" />
                                    Ver Detalles
                                </Button>
                            </div>
                        ))}
                    </div>
                </CardBody>
            </Card>

            {/* Configuración de Evaluación de Riesgos */}
            <Card>
                <CardHeader>
                    <CardTitle className="flex items-center gap-2">
                        <Settings className="h-5 w-5" />
                        Configuración de Evaluación de Riesgos
                    </CardTitle>
                </CardHeader>
                <CardBody>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h4 className="font-semibold mb-3">Umbrales de Riesgo</h4>
                            <div className="space-y-3">
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Riesgo bajo (0-30):</span>
                                    <Badge className="bg-green-100 text-green-800">Aceptable</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Riesgo medio (31-60):</span>
                                    <Badge className="bg-yellow-100 text-yellow-800">Monitorear</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Riesgo alto (61-80):</span>
                                    <Badge className="bg-red-100 text-red-800">Mitigar</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Riesgo crítico (81-100):</span>
                                    <Badge className="bg-purple-100 text-purple-800">Bloquear</Badge>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h4 className="font-semibold mb-3">Configuración de Evaluación</h4>
                            <div className="space-y-3">
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Evaluación automática:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Frecuencia de evaluación:</span>
                                    <span className="font-medium">Cada 6 horas</span>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Alertas automáticas:</span>
                                    <Badge className="bg-green-100 text-green-800">Activas</Badge>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-sm text-gray-600">Auto-mitigación:</span>
                                    <Badge className="bg-green-100 text-green-800">Activa</Badge>
                                </div>
                            </div>
                        </div>
                    </div>
                </CardBody>
            </Card>
        </div>
    );
} 
