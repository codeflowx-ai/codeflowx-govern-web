interface KubernetesCluster {
  id: string;
  name: string;
  status: "active" | "scaling" | "maintenance" | "error";
  type: "production" | "staging" | "development";
  version: string;
  nodes: number;
  color: string;
  specs: {
    cpu: string;
    memory: string;
    storage: string;
    network: string;
  };
  metrics: {
    cpuUsage: string;
    memoryUsage: string;
    storageUsage: string;
    podCount: string;
  };
  services: string[];
  lastDeployment: string;
  uptime: string;
  cost: string;
  region: string;
  tags: string[];
  metadata: {
    created: string;
    owner: string;
    team: string;
    environment: string;
  };
}

