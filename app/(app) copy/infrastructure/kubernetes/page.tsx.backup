  {
    title: "Monitor Health",
    description: "Check cluster status",
    icon: Monitor,
    action: () => console.log("Monitor health"),
    color: "#f59e0b",
  },
];

const getStatusColor = (status: string) => {
  switch (status) {
    case "active":
      return "bg-green-500";
    case "scaling":
      return "bg-blue-500";
    case "maintenance":
      return "bg-yellow-500";
    case "error":
      return "bg-red-500";
    default:
      return "bg-gray-500";
  }
};

const getStatusText = (status: string) => {
  switch (status) {
    case "active":
      return "Active";
    case "scaling":
      return "Scaling";
    case "maintenance":
      return "Maintenance";
    case "error":
      return "Error";
    default:
      return "Unknown";
  }
};

const getTypeColor = (type: string) => {
  switch (type) {
    case "production":
      return "bg-red-500";
    case "staging":
      return "bg-blue-500";
    case "development":
      return "bg-purple-500";
    default:
      return "bg-gray-500";
  }
};

