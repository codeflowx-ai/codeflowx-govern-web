                        <span className="text-foreground">
                          {cluster.metadata.created}
                        </span>
                      </div>
                      <div className="flex items-center gap-2">
                        <span className="text-muted-foreground">
                          Last Deploy:
                        </span>
                        <span className="text-foreground">
                          {cluster.lastDeployment}
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Acciones del cluster */}
                  <div className="flex items-center justify-between pt-4 border-t border-border/50">
                    <div className="flex items-center gap-2">
                      <Badge variant="outline" className="text-xs">
                        {cluster.uptime}
                      </Badge>
                      <Badge variant="outline" className="text-xs">
                        {cluster.cost}
                      </Badge>
                    </div>
                    <div className="flex items-center gap-2">
                      <Button
                        size="sm"
                        variant="outline"
                        onClick={() => handleEditCluster(cluster)}
                      >
                        <Settings className="w-3 h-3 mr-1" />
                        Configure
                      </Button>
                      <Button size="sm">
                        <Monitor className="w-3 h-3 mr-1" />
                        Monitor
                      </Button>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          ))}
        </div>
      </div>

      {/* Footer con estadísticas adicionales */}
      <div className="relative z-10 pt-8 border-t border-border/50">
        <div className="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
          <div>
            <p className="text-sm text-muted-foreground">Scaling Clusters</p>
            <p className="text-lg font-semibold text-foreground">
              {systemStats.scalingClusters}
            </p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Total Pods</p>
            <p className="text-lg font-semibold text-foreground">
              {systemStats.totalPods}
            </p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Average Uptime</p>
            <p className="text-lg font-semibold text-foreground">
              {systemStats.averageUptime}
            </p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Last Updated</p>
            <p className="text-lg font-semibold text-foreground">Just now</p>
          </div>
        </div>
      </div>

      {/* Modal para agregar cluster */}
      <SimpleModal
        isOpen={isAddModalOpen}
        onClose={() => setIsAddModalOpen(false)}
        title="Add Kubernetes Cluster"
        maxWidth="max-w-4xl"
      >
        <div className="space-y-4">
          <p className="text-muted-foreground">
            Configure a new Kubernetes cluster with your preferred
            specifications.
          </p>
          {/* Aquí irían los campos del formulario */}
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setIsAddModalOpen(false)}>
              Cancel
            </Button>
            <Button onClick={() => setIsAddModalOpen(false)}>
              Create Cluster
            </Button>
          </div>
        </div>
      </SimpleModal>

      {/* Modal para editar cluster */}
      <SimpleModal
        isOpen={isEditModalOpen}
        onClose={() => setIsEditModalOpen(false)}
        title={`Edit Cluster: ${selectedCluster?.name}`}
        maxWidth="max-w-4xl"
      >
        <div className="space-y-4">
          <p className="text-muted-foreground">
            Modify the configuration of your Kubernetes cluster.
          </p>
          {/* Aquí irían los campos del formulario */}
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setIsEditModalOpen(false)}>
              Cancel
            </Button>
            <Button onClick={() => setIsEditModalOpen(false)}>
              Save Changes
            </Button>
          </div>
        </div>
      </SimpleModal>
    </div>
  );
}
