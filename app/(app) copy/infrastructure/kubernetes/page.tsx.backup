const systemStats = {
  totalClusters: kubernetesClusters.length,
  activeClusters: kubernetesClusters.filter(
    (cluster) => cluster.status === "active"
  ).length,
  scalingClusters: kubernetesClusters.filter(
    (cluster) => cluster.status === "scaling"
  ).length,
  totalNodes: kubernetesClusters.reduce(
    (sum, cluster) => sum + cluster.nodes,
    0
  ),
  totalCost: "$5,050/month",
  averageUptime: "96.6%",
  totalPods: "354",
  lastDeployment: "2 hours ago",
};

const quickActions = [
  {
    title: "Add Cluster",
    description: "Create new Kubernetes cluster",
