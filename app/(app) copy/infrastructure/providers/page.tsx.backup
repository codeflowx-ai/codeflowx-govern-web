    switch (status) {
      case "active":
        return "bg-green-500";
      case "inactive":
        return "bg-red-500";
      case "maintenance":
        return "bg-yellow-500";
      case "suspended":
        return "bg-gray-500";
      default:
        return "bg-gray-500";
    }
  };

  const handleMonitorProvider = (provider: any) => {
    setSelectedProvider(provider);
    setShowMonitorModal(true);
  };

  const handleManageProvider = (provider: any) => {
    setSelectedProvider(provider);
    setShowManageModal(true);
  };

  const getStatusText = (status: string) => {
    switch (status) {
      case "active":
        return "Active";
      case "inactive":
        return "Inactive";
      case "maintenance":
        return "Maintenance";
      case "suspended":
        return "Suspended";
      default:
        return "Unknown";
    }
  };

  const getTypeColor = (type: string) => {
    switch (type) {
      case "cloud":
        return "bg-blue-500";
      case "datacenter":
        return "bg-green-500";
      case "hybrid":
        return "bg-purple-500";
      case "edge":
        return "bg-orange-500";
      default:
        return "bg-gray-500";
    }
  };

  return (
