{
  "templates": [
    {
      "id": "generic-search",
      "name": "Generic Search & Preview",
      "type": "SEARCH_LIST",
      "toolkit": "enterprise-forms",
      "description": "Pantalla de búsqueda y maestro detalle",
      "version": "1.2.2",
      "licenses": ["FREE", "PERSONAL", "PROFESSIONAL", "TEAMS"],
      "icon": "lucide:search",
      "preview": "/templates/previews/generic-search.png",
      "sections": ["search", "grid", "preview"],
      "events": ["onCreate", "onLoad", "onSearch", "onSelect"],
      "properties": [
        {
          "id": "title",
          "name": "Title",
          "type": "input",
          "required": true,
          "label": "Screen Title",
          "default": "Search Screen",
          "validation": { "range": "5,100" }
        },
        {
          "id": "entity",
          "name": "entity",
          "type": "combo",
          "list": "$tables",
          "required": true,
          "label": "Main Entity"
        },
        {
          "id": "searchFields",
          "name": "searchFields",
          "type": "multiselect",
          "list": "$fields",
          "label": "Search Fields"
        },
        {
          "id": "gridColumns",
          "name": "gridColumns",
          "type": "multiselect",
          "list": "$fields",
          "label": "Grid Columns"
        },
        {
          "id": "actions",
          "name": "actions",
          "type": "combo",
          "default": "All",
          "label": "Allowed Actions",
          "options": [
            { "value": "All", "label": "All Actions" },
            { "value": "New", "label": "New Only" },
            { "value": "Update", "label": "Update Only" },
            { "value": "Delete", "label": "Delete Only" },
            { "value": "View", "label": "View Only" }
          ]
        },
        {
          "id": "popup",
          "name": "popup",
          "type": "boolean",
          "default": false,
          "label": "Open in Popup"
        },
        {
          "id": "theme",
          "name": "theme",
          "type": "combo",
          "default": "default",
          "label": "Theme",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "dark", "label": "Dark" },
            { "value": "corporate", "label": "Corporate" },
            { "value": "modern", "label": "Modern" }
          ]
        }
      ],
      "automappings": [
        {
          "mold": "nocode",
          "className": "SearchPreviewComponent",
          "sections": ["search", "grid", "preview"]
        }
      ],
      "builders": [
        {
          "type": "search",
          "ratio": 100,
          "estimatedTime": 180,
          "generator": "React",
          "key": "search-panel",
          "template": "search-panel.ftl",
          "builder": "SearchPanelBuilder",
          "extension": ".tsx",
          "outputFile": "SearchPanel.tsx"
        },
        {
          "type": "grid",
          "ratio": 100,
          "estimatedTime": 240,
          "generator": "React",
          "key": "data-grid",
          "template": "data-grid.ftl",
          "builder": "DataGridBuilder",
          "extension": ".tsx",
          "outputFile": "DataGrid.tsx"
        },
        {
          "type": "preview",
          "ratio": 100,
          "estimatedTime": 120,
          "generator": "React",
          "key": "detail-preview",
          "template": "detail-preview.ftl",
          "builder": "PreviewBuilder",
          "extension": ".tsx",
          "outputFile": "DetailPreview.tsx"
        }
      ],
      "metadata": {
        "tags": ["search", "grid", "preview", "crud"],
        "category": "Data Management",
        "complexity": "MEDIUM",
        "estimatedTime": 540
      }
    },
    {
      "id": "crud-form",
      "name": "CRUD Form",
      "type": "BASIC_FORM",
      "toolkit": "enterprise-forms",
      "description": "Formulario CRUD básico",
      "version": "1.0.0",
      "licenses": ["FREE", "PERSONAL", "PROFESSIONAL", "TEAMS"],
      "icon": "lucide:edit",
      "sections": ["form", "actions"],
      "events": ["onCreate", "onLoad", "onSave", "onDelete", "onCancel"],
      "properties": [
        {
          "id": "title",
          "name": "Title",
          "type": "input",
          "required": true,
          "label": "Form Title",
          "default": "Entity Form"
        },
        {
          "id": "entity",
          "name": "entity",
          "type": "combo",
          "list": "$tables",
          "required": true,
          "label": "Entity"
        },
        {
          "id": "formFields",
          "name": "formFields",
          "type": "multiselect",
          "list": "$fields",
          "label": "Form Fields"
        },
        {
          "id": "layout",
          "name": "layout",
          "type": "combo",
          "default": "2-column",
          "label": "Form Layout",
          "options": [
            { "value": "1-column", "label": "1 Column" },
            { "value": "2-column", "label": "2 Columns" },
            { "value": "3-column", "label": "3 Columns" },
            { "value": "tabs", "label": "Tabbed Layout" }
          ]
        },
        {
          "id": "validation",
          "name": "validation",
          "type": "boolean",
          "default": true,
          "label": "Enable Validation"
        }
