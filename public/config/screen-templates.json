      "automappings": [
        {
          "mold": "nocode",
          "className": "CRUDFormComponent",
          "sections": ["form", "actions"]
        }
      ],
      "builders": [
        {
          "type": "form",
          "ratio": 100,
          "estimatedTime": 300,
          "generator": "React",
          "key": "crud-form",
          "template": "crud-form.ftl",
          "builder": "CRUDFormBuilder",
          "extension": ".tsx",
          "outputFile": "CRUDForm.tsx"
        }
      ],
      "metadata": {
        "tags": ["form", "crud", "basic"],
        "category": "Forms",
        "complexity": "SIMPLE",
        "estimatedTime": 300
      }
    },
    {
      "id": "dashboard",
      "name": "Dashboard",
      "type": "DASHBOARD",
      "toolkit": "enterprise-forms",
      "description": "Dashboard empresarial",
      "version": "1.0.0",
      "licenses": ["PROFESSIONAL", "TEAMS"],
      "icon": "lucide:layout-dashboard",
      "sections": ["header", "widgets", "footer"],
      "events": ["onLoad", "onRefresh"],
      "properties": [
        {
          "id": "title",
          "name": "Title",
          "type": "input",
          "required": true,
          "label": "Dashboard Title",
          "default": "Dashboard"
        },
        {
          "id": "widgets",
          "name": "widgets",
          "type": "multiselect",
          "label": "Dashboard Widgets",
          "options": [
            { "value": "chart", "label": "Charts" },
            { "value": "table", "label": "Data Tables" },
            { "value": "metric", "label": "Metrics" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "news", "label": "News Feed" }
          ]
        },
        {
          "id": "refreshInterval",
          "name": "refreshInterval",
          "type": "number",
          "default": 30,
          "label": "Refresh Interval (seconds)",
          "validation": { "min": 10, "max": 3600 }
        },
        {
          "id": "layout",
          "name": "layout",
          "type": "combo",
          "default": "grid",
          "label": "Layout Type",
          "options": [
            { "value": "grid", "label": "Grid Layout" },
            { "value": "flex", "label": "Flex Layout" },
            { "value": "masonry", "label": "Masonry Layout" }
          ]
        }
      ],
      "automappings": [
        {
          "mold": "lowcode",
          "className": "DashboardComponent",
          "sections": ["header", "widgets", "footer"]
        }
      ],
      "builders": [
        {
          "type": "dashboard",
          "ratio": 100,
          "estimatedTime": 600,
          "generator": "React",
          "key": "dashboard",
          "template": "dashboard.ftl",
          "builder": "DashboardBuilder",
          "extension": ".tsx",
          "outputFile": "Dashboard.tsx"
        }
      ],
      "metadata": {
        "tags": ["dashboard", "widgets", "analytics"],
        "category": "Analytics",
        "complexity": "COMPLEX",
        "estimatedTime": 600
      }
    },
    {
