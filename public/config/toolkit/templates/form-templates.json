                    "justifyContent": "space-between",
                    "alignItems": "center",
                    "marginBottom": 24
                  }
                },
                {
                  "id": "stats_row",
                  "type": "container",
                  "properties": {
                    "layoutType": "flex",
                    "flexDirection": "row",
                    "gap": 16,
                    "marginBottom": 24
                  }
                },
                {
                  "id": "charts_section",
                  "type": "container",
                  "properties": {
                    "layoutType": "flex",
                    "flexDirection": "row",
                    "gap": 16,
                    "flexGrow": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}