{
  "components": {
    "date": {
      "definition": {
        "name": "Date Picker",
        "type": "COMPONENT",
        "sqlType": ["DATE"],
        "inputType": "DATE",
        "docType": ["DATE"],
        "version": "1.0.0",
        "cols": "4",
        "icon": "lucide:calendar",
        "tooltip": "Date selection component",
        "class": "DatePicker",
        "component": "date",
        "defaultSize": { "width": 200, "height": 40 }
      },
      "propertyTabs": [
        {
          "id": "properties",
          "name": "Properties",
          "icon": "lucide:settings",
          "order": 1
        },
        {
          "id": "database",
          "name": "Database",
          "icon": "lucide:database",
          "order": 2
        },
        {
          "id": "validation",
          "name": "Validation",
          "icon": "lucide:shield-check",
          "order": 3
        }
      ],
      "properties": [
        {
          "name": "label",
          "type": "input",
          "label": "Label",
          "default": "Date",
          "order": 1,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "placeholder",
          "type": "input",
          "label": "Placeholder",
          "default": "Select date...",
          "order": 2,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "format",
          "type": "combo",
          "label": "Date Format",
          "default": "YYYY-MM-DD",
          "options": [
            {"value": "YYYY-MM-DD", "label": "YYYY-MM-DD"},
            {"value": "DD/MM/YYYY", "label": "DD/MM/YYYY"},
            {"value": "MM/DD/YYYY", "label": "MM/DD/YYYY"},
            {"value": "DD-MM-YYYY", "label": "DD-MM-YYYY"}
          ],
          "order": 3,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "showCalendar",
          "type": "boolean",
          "label": "Show Calendar",
          "default": true,
          "order": 4,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "fieldMapping",
          "type": "input",
          "label": "Database Field",
          "default": "",
          "placeholder": "table.column",
          "order": 1,
          "group": "Database",
          "tab": "database"
        },
        {
          "name": "minDate",
          "type": "input",
          "label": "Minimum Date",
          "default": "",
          "placeholder": "YYYY-MM-DD or 'today'",
          "order": 1,
          "group": "Validation",
          "tab": "validation"
        },
        {
          "name": "maxDate",
          "type": "input",
          "label": "Maximum Date",
          "default": "",
          "placeholder": "YYYY-MM-DD or 'today'",
          "order": 2,
          "group": "Validation",
          "tab": "validation"
        }
      ]
    },
