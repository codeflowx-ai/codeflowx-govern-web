          "tab": "properties"
        },
        {
          "name": "showFooter",
          "type": "boolean",
          "label": "Show Footer",
          "default": false,
          "order": 5,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "backgroundColor",
