{
  "components": {
    "table": {
      "definition": {
        "name": "Data Table",
        "type": "COMPONENT",
        "sqlType": [],
        "inputType": "TABLE",
        "docType": ["TABLE"],
        "version": "1.0.0",
        "icon": "lucide:table",
        "tooltip": "Data table with sorting and pagination",
        "class": "DataTable",
        "component": "table",
        "defaultSize": { "width": 600, "height": 300 }
      },
      "propertyTabs": [
        {
          "id": "properties",
          "name": "Properties",
          "icon": "lucide:settings",
          "order": 1
        },
        {
          "id": "data",
          "name": "Data",
          "icon": "lucide:database",
          "order": 2
        },
        {
          "id": "features",
          "name": "Features",
          "icon": "lucide:zap",
          "order": 3
        }
      ],
      "properties": [
        {
          "name": "title",
          "type": "input",
          "label": "Table Title",
          "default": "Data Table",
          "order": 1,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "striped",
          "type": "boolean",
          "label": "Striped Rows",
          "default": true,
          "order": 2,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "bordered",
          "type": "boolean",
          "label": "Bordered",
          "default": true,
          "order": 3,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "hover",
          "type": "boolean",
          "label": "Hover Effect",
          "default": true,
          "order": 4,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "dataSource",
          "type": "combo",
          "label": "Data Source",
          "default": "api",
          "options": [
            {"value": "static", "label": "Static Data"},
            {"value": "api", "label": "API Endpoint"},
            {"value": "database", "label": "Database Query"}
          ],
          "order": 1,
          "group": "Data",
          "tab": "data"
        },
        {
          "name": "apiEndpoint",
          "type": "input",
          "label": "API Endpoint",
          "default": "/api/data",
          "placeholder": "/api/users",
          "order": 2,
          "group": "Data",
          "tab": "data"
        },
        {
          "name": "columns",
          "type": "textarea",
          "label": "Columns (JSON)",
          "default": "[\n  {\"key\": \"id\", \"title\": \"ID\", \"sortable\": true},\n  {\"key\": \"name\", \"title\": \"Name\", \"sortable\": true},\n  {\"key\": \"email\", \"title\": \"Email\", \"sortable\": false}\n]",
          "order": 3,
          "group": "Data",
          "tab": "data"
        },
        {
          "name": "sortable",
          "type": "boolean",
          "label": "Enable Sorting",
          "default": true,
          "order": 1,
          "group": "Features",
          "tab": "features"
        },
        {
          "name": "filterable",
          "type": "boolean",
          "label": "Enable Filtering",
          "default": true,
          "order": 2,
          "group": "Features",
          "tab": "features"
        },
        {
          "name": "pagination",
          "type": "boolean",
          "label": "Enable Pagination",
          "default": true,
          "order": 3,
          "group": "Features",
          "tab": "features"
        },
        {
          "name": "pageSize",
          "type": "number",
          "label": "Page Size",
          "default": 10,
          "min": 5,
          "max": 100,
          "order": 4,
          "group": "Features",
          "tab": "features"
        },
        {
          "name": "selectable",
          "type": "boolean",
          "label": "Row Selection",
          "default": false,
          "order": 5,
          "group": "Features",
          "tab": "features"
        }
      ]
    },
    "list": {
      "definition": {
        "name": "List View",
        "type": "COMPONENT",
        "sqlType": [],
        "inputType": "LIST",
        "docType": ["LIST"],
        "version": "1.0.0",
        "icon": "lucide:list",
        "tooltip": "Vertical list component",
        "class": "ListView",
        "component": "list",
        "defaultSize": { "width": 300, "height": 200 }
      },
      "propertyTabs": [
        {
          "id": "properties",
          "name": "Properties",
          "icon": "lucide:settings",
          "order": 1
        },
        {
          "id": "data",
          "name": "Data",
          "icon": "lucide:database",
          "order": 2
        }
      ],
      "properties": [
        {
          "name": "title",
          "type": "input",
          "label": "List Title",
          "default": "List",
          "order": 1,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "itemHeight",
          "type": "number",
          "label": "Item Height",
          "default": 40,
          "min": 20,
          "max": 100,
          "order": 2,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "showBorder",
          "type": "boolean",
          "label": "Show Item Borders",
          "default": true,
          "order": 3,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "dataSource",
          "type": "combo",
          "label": "Data Source",
          "default": "static",
          "options": [
            {"value": "static", "label": "Static Data"},
            {"value": "api", "label": "API Endpoint"},
            {"value": "database", "label": "Database Query"}
          ],
          "order": 1,
          "group": "Data",
          "tab": "data"
        },
        {
          "name": "items",
          "type": "textarea",
          "label": "List Items (JSON)",
          "default": "[\n  {\"id\": 1, \"text\": \"Item 1\", \"value\": \"item1\"},\n  {\"id\": 2, \"text\": \"Item 2\", \"value\": \"item2\"}\n]",
          "order": 2,
          "group": "Data",
          "tab": "data"
        }
      ]
    },
    "card": {
      "definition": {
        "name": "Card",
        "type": "COMPONENT",
        "sqlType": [],
        "inputType": "CARD",
