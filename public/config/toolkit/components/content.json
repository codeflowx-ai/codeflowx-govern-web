          "default": true,
          "order": 1,
          "group": "Player",
          "tab": "player"
        },
        {
          "name": "autoplay",
          "type": "boolean",
          "label": "Autoplay",
          "default": false,
          "order": 2,
          "group": "Player",
          "tab": "player"
        },
        {
          "name": "loop",
          "type": "boolean",
          "label": "Loop",
          "default": false,
          "order": 3,
          "group": "Player",
          "tab": "player"
        },
        {
          "name": "muted",
          "type": "boolean",
          "label": "Muted",
          "default": false,
          "order": 4,
          "group": "Player",
          "tab": "player"
        }
      ]
    },
