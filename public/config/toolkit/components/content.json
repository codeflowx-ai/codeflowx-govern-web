{
  "components": {
    "html": {
      "definition": {
        "name": "HTML Content",
        "type": "COMPONENT",
        "sqlType": ["TEXT", "LONGTEXT"],
        "inputType": "HTML",
        "docType": ["HTML"],
        "cols": "6",
        "version": "1.0.0",
        "icon": "lucide:code",
        "tooltip": "HTML content with editor",
        "class": "HtmlContent",
        "component": "html",
        "defaultSize": { "width": 400, "height": 200 }
      },
      "propertyTabs": [
        {
          "id": "properties",
          "name": "Properties",
          "icon": "lucide:settings",
          "order": 1
        },
        {
          "id": "editor",
          "name": "Editor",
          "icon": "lucide:code",
          "order": 2
        },
        {
          "id": "database",
          "name": "Database",
          "icon": "lucide:database",
          "order": 3
        }
      ],
      "properties": [
        {
          "name": "content",
          "type": "htmlEditor",
          "label": "HTML Content",
          "default": "<p>Enter your HTML content here...</p>",
          "order": 1,
          "group": "Content",
          "tab": "editor"
        },
        {
          "name": "sanitize",
          "type": "boolean",
          "label": "Sanitize HTML",
          "default": true,
          "order": 2,
          "group": "Security",
          "tab": "editor"
        },
        {
          "name": "allowedTags",
          "type": "textarea",
          "label": "Allowed HTML Tags",
          "default": "p,div,span,h1,h2,h3,h4,h5,h6,strong,em,ul,ol,li,a,img,br",
          "order": 3,
          "group": "Security",
          "tab": "editor"
        },
        {
          "name": "editable",
          "type": "boolean",
          "label": "Editable in Runtime",
          "default": false,
          "order": 1,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "showBorder",
          "type": "boolean",
          "label": "Show Border",
          "default": false,
          "order": 2,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "fieldMapping",
          "type": "input",
          "label": "Database Field",
          "default": "",
          "placeholder": "table.column",
          "order": 1,
          "group": "Database",
          "tab": "database"
        },
        {
          "name": "sqlType",
          "type": "combo",
          "label": "SQL Type",
          "default": "TEXT",
          "options": [
            {"value": "TEXT", "label": "TEXT"},
            {"value": "LONGTEXT", "label": "LONGTEXT"},
            {"value": "MEDIUMTEXT", "label": "MEDIUMTEXT"}
          ],
          "order": 2,
          "group": "Database",
          "tab": "database"
        }
      ]
    },
    "simage": {
      "definition": {
        "name": "Static Image",
        "type": "COMPONENT",
        "sqlType": ["VARCHAR", "BLOB"],
        "inputType": "STATIC_IMAGE",
        "docType": ["IMAGE"],
        "version": "1.0.0",
        "cols": "6",
        "icon": "lucide:image",
        "tooltip": "Static image display",
        "class": "StaticImage",
        "component": "simage",
        "defaultSize": { "width": 200, "height": 150 }
      },
      "propertyTabs": [
        {
          "id": "properties",
          "name": "Properties",
          "icon": "lucide:settings",
          "order": 1
        },
        {
          "id": "styles",
          "name": "Styles",
          "icon": "lucide:palette",
          "order": 2
        }
      ],
      "properties": [
        {
          "name": "src",
          "type": "input",
          "label": "Image URL",
          "default": "https://via.placeholder.com/200x150",
          "placeholder": "https://example.com/image.jpg",
          "order": 1,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "alt",
          "type": "input",
          "label": "Alt Text",
          "default": "Static Image",
          "order": 2,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "title",
          "type": "input",
          "label": "Title",
          "default": "",
          "order": 3,
          "group": "Basic",
          "tab": "properties"
        },
        {
          "name": "objectFit",
          "type": "combo",
          "label": "Object Fit",
          "default": "cover",
          "options": [
            {"value": "cover", "label": "Cover"},
            {"value": "contain", "label": "Contain"},
            {"value": "fill", "label": "Fill"},
            {"value": "scale-down", "label": "Scale Down"},
            {"value": "none", "label": "None"}
          ],
          "order": 1,
          "group": "Display",
          "tab": "styles"
        },
        {
          "name": "borderRadius",
          "type": "number",
          "label": "Border Radius (px)",
          "default": 0,
          "min": 0,
          "max": 50,
          "order": 2,
          "group": "Display",
          "tab": "styles"
        },
        {
          "name": "shadow",
          "type": "boolean",
          "label": "Drop Shadow",
          "default": false,
          "order": 3,
          "group": "Display",
          "tab": "styles"
        }
      ]
    },
