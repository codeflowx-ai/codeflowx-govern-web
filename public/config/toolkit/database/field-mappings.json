{
  "sqlTypeMapping": {
    "VARCHAR": {
      "component": "input",
      "maxLength": 255,
      "validation": ["maxLength"],
      "description": "Variable character string"
    },
    "TEXT": {
      "component": "textarea",
      "maxLength": 65535,
      "validation": ["maxLength"],
      "description": "Long text field"
    },
    "CLOB": {
      "component": "richtext",
      "maxLength": -1,
      "validation": [],
      "description": "Character Large Object for rich text"
    },
    "LONGTEXT": {
      "component": "richtext",
      "maxLength": -1,
      "validation": [],
      "description": "MySQL long text field"
    },
    "INT": {
      "component": "number",
      "min": -2147483648,
      "max": 2147483647,
      "validation": ["min", "max"],
      "description": "32-bit integer"
    },
    "BIGINT": {
      "component": "number",
      "min": -9223372036854775808,
      "max": 9223372036854775807,
      "validation": ["min", "max"],
      "description": "64-bit integer"
    },
    "DECIMAL": {
      "component": "currency",
      "precision": 10,
      "scale": 2,
      "validation": ["precision", "scale"],
      "description": "Fixed-point decimal number"
    },
    "FLOAT": {
      "component": "number",
      "validation": ["numeric"],
      "description": "Floating-point number"
    },
    "BOOLEAN": {
      "component": "checkbox",
      "validation": [],
      "description": "True/false value"
    },
    "TINYINT": {
      "component": "toggle",
      "min": 0,
      "max": 255,
      "validation": ["min", "max"],
      "description": "Small integer (often used for boolean)"
    },
    "DATE": {
      "component": "date",
      "format": "YYYY-MM-DD",
      "validation": ["dateFormat"],
      "description": "Date value"
    },
    "DATETIME": {
      "component": "datetime",
      "format": "YYYY-MM-DD HH:MM:SS",
      "validation": ["dateFormat"],
      "description": "Date and time value"
    },
    "TIMESTAMP": {
      "component": "datetime",
      "format": "YYYY-MM-DD HH:MM:SS",
      "validation": ["dateFormat"],
      "description": "Timestamp with timezone"
    },
    "TIME": {
      "component": "time",
      "format": "HH:MM:SS",
      "validation": ["timeFormat"],
      "description": "Time value"
    },
    "ENUM": {
      "component": "select",
      "validation": ["enumValues"],
      "description": "Enumerated list of values"
    },
    "JSON": {
      "component": "map",
      "validation": ["jsonFormat"],
      "description": "JSON object"
    },
    "JSONB": {
      "component": "map",
      "validation": ["jsonFormat"],
      "description": "Binary JSON (PostgreSQL)"
    },
    "BLOB": {
      "component": "file",
      "maxSize": "10MB",
      "validation": ["fileSize", "fileType"],
      "description": "Binary Large Object for files"
    },
    "LONGBLOB": {
      "component": "file",
      "maxSize": "100MB",
      "validation": ["fileSize", "fileType"],
      "description": "Large binary object"
    },
    "BYTEA": {
      "component": "file",
      "maxSize": "50MB",
      "validation": ["fileSize", "fileType"],
      "description": "PostgreSQL binary data"
    },
    "TSVECTOR": {
      "component": "tsvector",
      "validation": ["textSearch"],
      "description": "PostgreSQL text search vector"
    },
    "MAP": {
      "component": "map",
      "validation": ["keyValuePairs"],
      "description": "Key-value map structure"
    }
  },
  "fieldConstraints": {
    "PRIMARY_KEY": {
      "readonly": true,
      "required": true,
      "unique": true,
      "autoGenerated": true,
      "description": "Primary key field - auto-generated, read-only"
    },
    "AUTO_INCREMENT": {
      "readonly": true,
      "autoGenerated": true,
      "showInForm": false,
      "description": "Auto-increment field - hidden from forms"
    },
    "UNIQUE": {
      "unique": true,
      "validation": ["uniqueValue"],
      "description": "Must be unique across all records"
    },
    "NOT_NULL": {
      "required": true,
      "validation": ["required"],
      "description": "Cannot be empty or null"
    },
    "FOREIGN_KEY": {
      "component": "select",
      "dataSource": "relatedTable",
      "validation": ["foreignKeyExists"],
      "description": "References another table"
    }
  }
}