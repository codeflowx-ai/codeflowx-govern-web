{
  "propertyTypes": {
    "input": {
      "component": "TextInput",
      "validation": ["required", "range", "pattern"],
      "description": "Single-line text input"
    },
    "textarea": {
      "component": "TextArea",
      "validation": ["required", "range"],
      "description": "Multi-line text input"
    },
    "colSpan": {
      "type": "range",
      "label": "Column Width",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "description": "Width in Bootstrap columns (1-12)"
    },
    "boolean": {
      "component": "Checkbox",
      "validation": [],
      "description": "True/false checkbox"
    },
    "combo": {
      "component": "Select",
      "validation": ["required"],
      "requiresOptions": true,
      "description": "Dropdown selection"
    },
    "colorPicker": {
      "component": "ColorPicker",
      "validation": ["pattern"],
      "description": "Color selection input"
    },
    "number": {
      "component": "NumberInput",
      "validation": ["required", "range", "min", "max"],
      "description": "Numeric input with validation"
    },
    "range": {
      "component": "RangeSlider",
      "validation": ["min", "max", "step"],
      "description": "Slider for numeric ranges"
    },
    "event": {
      "component": "EventEditor",
      "validation": [],
      "description": "Event configuration editor",
      "structure": {
        "enabled": "boolean",
        "action": "string",
        "parameters": "object"
      }
    }
  }
}