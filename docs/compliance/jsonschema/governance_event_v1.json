{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflowx.io/schemas/governance_event_v1.json",
  "title": "GovernanceEvent",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "sector_code",
    "use_case_code",
    "regulation_refs",
    "timestamp",
    "tenant_id",
    "geo_scope",
    "sla_profile"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "sector_code": {
      "type": "string",
      "pattern": "^[A-Z_]{3,40}$"
    },
    "use_case_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{5,60}$"
    },
    "regulation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 36
    },
    "geo_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,10}$"
      },
      "uniqueItems": true
    },
    "sla_profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "metadata": {
      "type": "object",
      "description": "Metadatos adicionales validados a través del catálogo sectorial.",
      "additionalProperties": true
    }
  }
}
