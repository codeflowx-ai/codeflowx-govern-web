<!-- questions.zul -->
<?page title="Gestión de Preguntas" contentType="text/html;charset=UTF-8"?>
<zk>
    <div sclass="container-fluid" viewModel="@id('vm') @init('org.suinsit.compliance.web.FormQuestionsVM')">
        <!-- Header -->
        <div sclass="row mb-3">
            <div sclass="col">
                <div sclass="d-flex justify-content-between align-items-center">
                    <div>
                        <button sclass="btn btn-outline-secondary me-2" 
                                onClick="@command('goBack')">
                            <i sclass="fas fa-arrow-left"></i>
                        </button>
                        <span sclass="h4">Preguntas: @load(vm.form.title)</span>
                    </div>
                    <div>
                        <button sclass="btn btn-primary me-2" 
                                onClick="@command('showNewQuestionDialog')"
                                visible="@load(vm.form.status eq 'DRAFT')">
                            <i sclass="fas fa-plus"></i> Nueva Pregunta
                        </button>
                        <button sclass="btn btn-success" 
                                onClick="@command('importQuestions')"
                                visible="@load(vm.form.status eq 'DRAFT')">
                            <i sclass="fas fa-file-import"></i> Importar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories Tabs -->
        <div sclass="row mb-3">
            <div sclass="col">
                <tabbox>
                    <tabs>
                        <tab label="Todas (@load(vm.totalQuestions))" 
                             onClick="@command('filterByCategory', category=null)"/>
                        <forEach items="@load(vm.categories)" var="cat">
                            <tab label="@load(cat.name) (@load(cat.count))" 
                                 onClick="@command('filterByCategory', category=cat.code)"/>
                        </forEach>
                    </tabs>
                </tabbox>
            </div>
        </div>

        <!-- Questions List -->
        <div sclass="row">
            <div sclass="col">
                <grid model="@load(vm.questions)" 
                      emptyMessage="No hay preguntas definidas"
                      sclass="table table-striped">
                    <columns>
                        <column width="50px" label="#" align="center"/>
                        <column hflex="6" label="Pregunta"/>
                        <column hflex="2" label="Categoría" align="center"/>
                        <column hflex="2" label="Peso" align="center"/>
                        <column hflex="1" label="Evidencia" align="center"/>
                        <column width="120px" label="Acciones" align="center"/>
                    </columns>
                    <template name="model">
                        <row draggable="@load(vm.form.status eq 'DRAFT')" 
                             droppable="@load(vm.form.status eq 'DRAFT')"
                             onDrop="@command('reorderQuestion', item=each)">
                            <label value="@load(each.orderNum)"/>
                            <div>
                                <label value="@load(each.questionText)" sclass="fw-bold"/>
                                <label value="@load(each.description)" 
                                       sclass="text-muted d-block small"/>
                            </div>
                            <label value="@load(each.category)" 
                                   sclass="@load(vm.getCategoryClass(each.category))"/>
                            <label value="@load(each.weight)" 
                                   sclass="@load(vm.getWeightClass(each.weight))"/>
                            <checkbox checked="@load(each.evidenceRequired)" 
                                     disabled="true"/>
                            <div sclass="btn-group">
                                <button sclass="btn btn-sm btn-info" 
                                        onClick="@command('editQuestion', question=each)"
                                        visible="@load(vm.form.status eq 'DRAFT')"
                                        tooltiptext="Editar">
                                    <i sclass="fas fa-edit"></i>
                                </button>
                                <button sclass="btn btn-sm btn-danger" 
                                        onClick="@command('deleteQuestion', question=each)"
                                        visible="@load(vm.form.status eq 'DRAFT')"
                                        tooltiptext="Eliminar">
                                    <i sclass="fas fa-trash"></i>
                                </button>
                            </div>
                        </row>
                    </template>
                </grid>
            </div>
        </div>

        <!-- Question Dialog -->
        <window id="questionDialog" visible="false" mode="modal" 
                title="@load(vm.editingQuestion.idxcmpformquestion eq null ? 'Nueva Pregunta' : 'Editar Pregunta')"
                width="600px" closable="true">
            <div sclass="modal-body">
                <div sclass="form-group mb-3">
                    <label>Pregunta</label>
                    <textbox value="@bind(vm.editingQuestion.questionText)" 
                            rows="2" sclass="form-control"/>
                </div>
                <div sclass="form-group mb-3">
                    <label>Descripción</label>
                    <textbox value="@bind(vm.editingQuestion.description)" 
                            rows="3" sclass="form-control"/>
                </div>
                <div sclass="row mb-3">
                    <div sclass="col-md-6">
                        <label>Categoría</label>
                        <combobox model="@load(vm.availableCategories)" 
                                 selectedItem="@bind(vm.editingQuestion.category)"
                                 sclass="form-control">
                            <template name="model">
                                <comboitem label="@load(each.name)"/>
                            </template>
                        </combobox>
                    </div>
                    <div sclass="col-md-6">
                        <label>Peso</label>
                        <combobox model="@load(vm.availableWeights)" 
                                 selectedItem="@bind(vm.editingQuestion.weight)"
                                 sclass="form-control">
                            <template name="model">
                                <comboitem label="@load(each.name)"/>
                            </template>
                        </combobox>
                    </div>
                </div>
                <div sclass="form-group mb-3">
                    <checkbox checked="@bind(vm.editingQuestion.evidenceRequired)" 
                             label="Requiere evidencia"/>
                </div>
            </div>
            <div sclass="modal-footer">
                <button sclass="btn btn-secondary" 
                        onClick="@command('closeQuestionDialog')">Cancelar</button>
                <button sclass="btn btn-primary" 
                        onClick="@command('saveQuestion')">Guardar</button>
            </div>
        </window>

        <!-- Import Dialog -->
        <window id="importDialog" visible="false" mode="modal" 
                title="Importar Preguntas" width="500px" closable="true">
            <div sclass="modal-body">
                <div sclass="mb-3">
                    <a href="@load(vm.templateUrl)" 
                       sclass="btn btn-outline-primary btn-sm">
                        Descargar plantilla
                    </a>
                </div>
                <div sclass="form-group">
                    <label>Archivo Excel</label>
                    <button upload="true,maxsize=5120" 
                            onUpload="@command('handleFileUpload', event=event)"
                            sclass="btn btn-outline-secondary w-100">
                        Seleccionar archivo
                    </button>
                </div>
            </div>
            <div sclass="modal-footer">
                <button sclass="btn btn-secondary" 
                        onClick="@command('closeImportDialog')">Cancelar</button>
                <button sclass="btn btn-primary" 
                        onClick="@command('processImport')"
                        disabled="@load(empty vm.importFile)">Importar</button>
            </div>
        </window>
    </div>
</zk>