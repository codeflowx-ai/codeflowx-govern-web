<!-- answer.zul -->
<?page title="Responder Evaluación" contentType="text/html;charset=UTF-8"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd">
    <div sclass="container-fluid" 
         viewModel="@id('vm') @init('org.suinsit.compliance.web.FormAnswerVM')">
        
        <!-- Header -->
        <div sclass="row mb-3">
            <div sclass="col">
                <div sclass="d-flex justify-content-between align-items-center">
                    <div>
                        <button sclass="btn btn-outline-secondary me-2" 
                                onClick="@command('goBack')">
                            <i sclass="fas fa-arrow-left"></i>
                        </button>
                        <span sclass="h4">@load(vm.form.title)</span>
                    </div>
                    <div>
                        <span sclass="badge bg-primary me-2">
                            Sector: @load(vm.form.sectorName)
                        </span>
                        <span sclass="@load(vm.getProgressClass())">
                            Progreso: @load(vm.completionPercentage)%
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Indicators -->
        <div sclass="row mb-4">
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body text-center">
                        <h6>Total Preguntas</h6>
                        <h3>@load(vm.totalQuestions)</h3>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body text-center">
                        <h6>Respondidas</h6>
                        <h3>@load(vm.answeredQuestions)</h3>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body text-center">
                        <h6>Pendientes</h6>
                        <h3>@load(vm.pendingQuestions)</h3>
                    </div>
                </div>
            </div>
            <div sclass="col-md-3">
                <div sclass="card">
                    <div sclass="card-body text-center">
                        <h6>Puntuación Actual</h6>
                        <h3>@load(vm.currentScore)%</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Category Tabs -->
        <div sclass="row">
            <div sclass="col">
                <tabbox>
                    <tabs>
                        <tab label="Todas" 
                             onClick="@command('filterByCategory', category=null)"/>
                        <forEach items="@load(vm.categories)" var="cat">
                            <tab label="@load(cat.name)" 
                                 onClick="@command('filterByCategory', category=cat.code)"
                                 sclass="@load(vm.getCategoryCompletionClass(cat.code))"/>
                        </forEach>
                    </tabs>
                </tabbox>
            </div>
        </div>

        <!-- Questions Grid -->
        <div sclass="row mt-3">
            <div sclass="col">
                <grid model="@load(vm.filteredQuestions)" mold="default"
                      emptyMessage="No hay preguntas en esta categoría">
                    <columns>
                        <column width="50px" label="#"/>
                        <column hflex="5" label="Pregunta"/>
                        <column hflex="2" label="Respuesta"/>
                        <column hflex="2" label="Evidencia"/>
                        <column label="Acciones" align="center"/>
                        <column width="100px" label="Estado"/>
                    </columns>
                    <template name="model">
                        <row sclass="@load(vm.getRowClass(each))">
                            <label value="@load(each.orderNum)"/>
                            <div>
                                <label value="@load(each.questionText)" sclass="fw-bold"/>
                                <label value="@load(each.description)" 
                                       sclass="text-muted d-block small"/>
                                <label value="@load(vm.getWeightLabel(each))" 
                                       sclass="@load(vm.getWeightClass(each.weight))"/>
                            </div>
                            <div>
                                <radiogroup selectedItem="@bind(each.answerValue)"
                                          onCheck="@command('saveAnswer', question=each)">
                                    <radio label="1 - No implementado" value="1"/>
                                    <radio label="2 - Implementación básica" value="2"/>
                                    <radio label="3 - Implementación parcial" value="3"/>
                                    <radio label="4 - Implementación robusta" value="4"/>
                                    <radio label="5 - Implementación completa" value="5"/>
                                </radiogroup>
                                <textbox value="@bind(each.answerText)" 
                                        rows="2" width="100%"
                                        placeholder="Comentarios adicionales..."
                                        onChange="@command('saveAnswer', question=each)"/>
                            </div>
                            <div>
                                <button sclass="btn btn-sm btn-outline-primary"
                                        onClick="@command('manageEvidence', question=each)"
                                        tooltiptext="Gestionar evidencias">
                                    <i sclass="fas fa-file-upload"></i>
                                    (@load(vm.getEvidenceCount(each)))
                                </button>
                            </div>
                            
                            <div>
                                <label sclass="@load(vm.getAnswerStatusClass(each))"
                                       value="@load(vm.getAnswerStatusLabel(each))"/>
                            </div>
                        </row>
                    </template>
                </grid>
            </div>
        </div>

        <!-- Submit Button -->
        <div sclass="row mt-4 mb-4">
            <div sclass="col text-center">
                <button sclass="btn btn-primary"
                        disabled="@load(!vm.canSubmit)"
                        onClick="@command('submitEvaluation')">
                    Enviar Evaluación
                </button>
            </div>
        </div>

        <!-- Evidence Dialog -->
        <window id="evidenceDialog" visible="false" 
                title="Gestión de Evidencias" 
                width="700px" mode="modal"
                closable="true">
            <div sclass="modal-body">
                <div sclass="mb-3">
                    <label>Pregunta:</label>
                    <label value="@load(vm.selectedQuestion.questionText)" 
                           sclass="fw-bold"/>
                </div>
                
                <!-- Evidence List -->
                <div sclass="mb-3">
                    <grid model="@load(vm.currentEvidences)" 
                          emptyMessage="No hay evidencias adjuntas">
                        <columns>
                            <column hflex="1" label="Archivo"/>
                            <column hflex="2" label="Descripción"/>
                            <column width="100px" label="Acciones"/>
                        </columns>
                        <template name="model">
                            <row>
                                <label value="@load(each.fileName)"/>
                                <textbox value="@bind(each.description)" 
                                        onChange="@command('updateEvidence', evidence=each)"/>
                                <div>
                                    <button sclass="btn btn-sm btn-info"
                                            onClick="@command('downloadEvidence', evidence=each)"
                                            tooltiptext="Descargar">
                                        <i sclass="fas fa-download"></i>
                                    </button>
                                    <button sclass="btn btn-sm btn-danger"
                                            onClick="@command('deleteEvidence', evidence=each)"
                                            tooltiptext="Eliminar">
                                        <i sclass="fas fa-trash"></i>
                                    </button>
                                </div>
                            </row>
                        </template>
                    </grid>
                </div>
                
                <!-- Upload New Evidence -->
                <div sclass="mb-3">
                    <button upload="true,maxsize=10240" 
                            onUpload="@command('uploadEvidence', event=event)"
                            sclass="btn btn-outline-primary">
                        <i sclass="fas fa-upload"></i> Subir Nueva Evidencia
                    </button>
                </div>
            </div>
            <div sclass="modal-footer">
                <button sclass="btn btn-secondary" 
                        onClick="@command('closeEvidenceDialog')">Cerrar</button>
            </div>
        </window>
    </div>
</zk>