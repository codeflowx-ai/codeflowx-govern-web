<?page title="Governance Reports" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.governance.GovernanceReportsVM')">
        
        <!-- Governance Overview -->
        <hlayout sclass="governance-header">
            <div sclass="metric-box">
                <label value="Compliance Score"/>
                <label value="@load(vm.complianceScore)%" 
                       sclass="@load(vm.complianceScoreStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Risk Level"/>
                <label value="@load(vm.riskLevel)" 
                       sclass="@load(vm.riskLevelStyle)"/>
            </div>
            <div sclass="metric-box">
                <label value="Pending Audits"/>
                <label value="@load(vm.pendingAudits)"/>
            </div>
            <div sclass="metric-box">
                <label value="Last Report"/>
                <label value="@load(vm.lastReportDate)"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Regulatory Reports"/>
                <tab label="Audit Reports"/>
                <tab label="Risk Reports"/>
                <tab label="Performance Reports"/>
            </tabs>
            <tabpanels>
                <!-- Regulatory Reports Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Report Filters -->
                        <hlayout sclass="report-filters">
                            <datebox value="@bind(vm.startDate)" 
                                    format="yyyy-MM-dd" 
                                    placeholder="Start Date"/>
                            <datebox value="@bind(vm.endDate)" 
                                    format="yyyy-MM-dd" 
                                    placeholder="End Date"/>
                            <combobox model="@load(vm.regulationTypes)" 
                                     selectedItem="@bind(vm.selectedRegulation)"/>
                            <button label="Generate Report" 
                                    onClick="@command('generateRegulatoryReport')"/>
                            <button label="Export" 
                                    onClick="@command('exportReport')"/>
                        </hlayout>

                        <!-- Regulatory Compliance Summary -->
                        <grid model="@load(vm.regulatoryCompliance)">
                            <columns>
                                <column label="Regulation"/>
                                <column label="Status"/>
                                <column label="Compliance Level"/>
                                <column label="Last Check"/>
                                <column label="Next Review"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="compliance">
                                <row>
                                    <label value="@load(compliance.regulation)"/>
                                    <label value="@load(compliance.status)" 
                                           sclass="@load(compliance.statusStyle)"/>
                                    <progressmeter value="@load(compliance.level)"/>
                                    <label value="@load(compliance.lastCheck)"/>
                                    <label value="@load(compliance.nextReview)"/>
                                    <hlayout>
                                        <button label="Details" 
                                                onClick="@command('showComplianceDetails', compliance=compliance)"/>
                                        <button label="Review" 
                                                onClick="@command('reviewCompliance', compliance=compliance)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Compliance Trends -->
                        <hlayout>
                            <charts id="complianceTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Compliance Trends"
                                   model="@load(vm.complianceTrendsData)"/>
                            
                            <charts id="regulationStatusChart" 
                                   type="pie"
                                   height="300px"
                                   title="Regulation Status Distribution"
                                   model="@load(vm.regulationStatusData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Audit Reports Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Audit Summary -->
                        <hlayout>
                            <charts id="auditFindingsChart" 
                                   type="column"
                                   height="300px"
                                   title="Audit Findings"
                                   model="@load(vm.auditFindingsData)"/>
                            
                            <charts id="auditTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Audit Trends"
                                   model="@load(vm.auditTrendsData)"/>
                        </hlayout>

                        <!-- Audit Logs -->
                        <grid model="@load(vm.auditLogs)" 
                              mold="paging" pageSize="15">
                            <columns>
                                <column label="Timestamp"/>
                                <column label="Action"/>
                                <column label="User"/>
                                <column label="Model/Component"/>
                                <column label="Details"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="audit">
                                <row>
                                    <label value="@load(audit.timestamp)"/>
                                    <label value="@load(audit.action)"/>
                                    <label value="@load(audit.user)"/>
                                    <label value="@load(audit.component)"/>
                                    <label value="@load(audit.details)"/>
                                    <label value="@load(audit.status)" 
                                           sclass="@load(audit.statusStyle)"/>
                                    <hlayout>
                                        <button label="View" 
                                                onClick="@command('viewAuditDetails', audit=audit)"/>
                                        <button label="Export" 
                                                onClick="@command('exportAudit', audit=audit)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>
                    </vlayout>
                </tabpanel>

                <!-- Risk Reports Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Risk Matrix -->
                        <groupbox title="Risk Matrix">
                            <grid model="@load(vm.riskMatrix)" 
                                  sclass="risk-matrix">
                                <columns>
                                    <column label="Risk Category"/>
                                    <column label="Likelihood"/>
                                    <column label="Impact"/>
                                    <column label="Risk Score"/>
                                    <column label="Mitigation Status"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="risk">
                                    <row sclass="@load(risk.riskLevelStyle)">
                                        <label value="@load(risk.category)"/>
                                        <label value="@load(risk.likelihood)"/>
                                        <label value="@load(risk.impact)"/>
                                        <label value="@load(risk.score)"/>
                                        <progressmeter value="@load(risk.mitigationProgress)"/>
                                        <hlayout>
                                            <button label="Details" 
                                                    onClick="@command('showRiskDetails', risk=risk)"/>
                                            <button label="Update" 
                                                    onClick="@command('updateRisk', risk=risk)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>

                        <!-- Risk Trends -->
                        <hlayout>
                            <charts id="riskTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Risk Trends"
                                   model="@load(vm.riskTrendsData)"/>
                            
                            <charts id="riskDistributionChart" 
                                   type="pie"
                                   height="300px"
                                   title="Risk Distribution"
                                   model="@load(vm.riskDistributionData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Performance Reports Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- KPI Dashboard -->
                        <hlayout>
                            <div sclass="kpi-box" width="25%">
                                <label value="Model Performance"/>
                                <label value="@load(vm.modelPerformance)%"/>
                            </div>
                            <div sclass="kpi-box" width="25%">
                                <label value="Resource Utilization"/>
                                <label value="@load(vm.resourceUtilization)%"/>
                            </div>
                            <div sclass="kpi-box" width="25%">
                                <label value="Response Time"/>
                                <label value="@load(vm.responseTime)ms"/>
                            </div>
                            <div sclass="kpi-box" width="25%">
                                <label value="Cost Efficiency"/>
                                <label value="@load(vm.costEfficiency)%"/>
                            </div>
                        </hlayout>

                        <!-- Performance Metrics -->
                        <grid model="@load(vm.performanceMetrics)">
                            <columns>
                                <column label="Metric"/>
                                <column label="Current Value"/>
                                <column label="Target"/>
                                <column label="Trend"/>
                                <column label="Status"/>
                            </columns>
                            <template name="model" var="metric">
                                <row>
                                    <label value="@load(metric.name)"/>
                                    <label value="@load(metric.currentValue)"/>
                                    <label value="@load(metric.target)"/>
                                    <label value="@load(metric.trend)" 
                                           sclass="@load(metric.trendStyle)"/>
                                    <label value="@load(metric.status)" 
                                           sclass="@load(metric.statusStyle)"/>
                                </row>
                            </template>
                        </grid>

                        <!-- Performance Charts -->
                        <hlayout>
                            <charts id="performanceTrendsChart" 
                                   type="line"
                                   height="300px"
                                   title="Performance Trends"
                                   model="@load(vm.performanceTrendsData)"/>
                            
                            <charts id="resourceUsageChart" 
                                   type="column"
                                   height="300px"
                                   title="Resource Usage"
                                   model="@load(vm.resourceUsageData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="complianceDetailsWindow" 
                title="Compliance Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Compliance Details Content -->
        </window>

        <window id="auditDetailsWindow" 
                title="Audit Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Audit Details Content -->
        </window>

        <window id="riskDetailsWindow" 
                title="Risk Details" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Risk Details Content -->
        </window>
    </div>
</zk>