							</div>
						</div>

					</div>
				</div>

	
				<div class="col-4 mb-4">

					<div class="card cards-mkt-sf">
						<div class="mkt-dp leka">
							<div class="row">
								<div class="chatbot"  apply="org.zkoss.bind.BindComposer" 
            viewModel="@id('vm') @init('com.suinsit.nocode.suinless.ui.ChatbotUI')">
            <custom-attributes chatbotassistant="consultaria"/>
									<div class="chatbot-header">
										<h:img src="../img/leka-1.png"
											alt="Chat Icon" />
										<h:h5>LEKA</h:h5>
									</div>
									<div class="chatbot-body">
										<h:h6>
											¿Tienes dudas sobre que IA
											Usar? Pregúntanos.
										</h:h6>
										<hlayout class="b-bot">
											<div id="areaMsg" class="area-msgchat" vflex="1">
												<forEach
													items="@bind(vm.chatmsgs)" var="item">
													<choose>
														<when
															test="${item.usuario}">
															<div
																sclass="col-12 col-md-12 col-lg-12 stl-chat">
																<if
																	test="${item.user ne null}">
																	<label
																		value="${item.user}" sclass="${item.sclass}">
																	</label>
																</if>
																<if
																	test="${item.message ne null}">
																	<label
																		value="${item.message}" sclass="${item.sclass}"
																		multiline="true">
																	</label>
																</if>
															</div>

														</when>
														<when
															test="${item.assistan}">
															<if
																test="${item.icon ne null}">
																<h:icon
																	sclass="${item.icon}">
																</h:icon>
															</if>
															<if
																test="${item.message ne null}">
																<label
																	value="${item.message}" sclass="${item.sclass}"
																	multiline="true">
																</label>
															</if>
														</when>
														<otherwise>
														</otherwise>
													</choose>
												</forEach>
											</div>

										</hlayout>
										<textbox id="tbmessage"
											multiline="true"  class="form-control"
											placeholder="Escribe tu mensaje..."
											value="@bind(vm.chatmsg)" />

										<button class="btn btn-primary"
											onClick="@command('sendChatMessage')">
											Enviar Mensaje
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


</zk>