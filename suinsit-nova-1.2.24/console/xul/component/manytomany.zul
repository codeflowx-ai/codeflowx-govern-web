<?component name="dual-listbox" extends="div" class="com.enartsystems.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute"
	xmlns:w="client">
	<window title="Configure Many to Many" border="normal"
		closable="true" mode="modal" width="60%" height="700px"
		position="center,center" class="bg-dark text-white" style="">
		<div
			viewModel="@id('vm') @init('com.enartsystems.designer.commons.ManyToManyUI')">
			<div class="row">
				<button class="btn"
					 label="Save"
					onClick="@command('doStore')">
				</button>
			</div>
			<div class="row">
				<h:div class="col-md-6">
					<label sclass="form-label"
						value="Seleccione aplicación........." />
					<combobox model="@load(vm.applications)"   disabled="@load(vm.disabled)" value="@bind(vm.bean.application)" onSelect="@command('selectApp',item=event.data)">
						 <template name="model" var="item">
						   <comboitem value="${item.projectBase.txname}" label="${item.projectBase.txname}"/>
						 </template>
					</combobox>
				</h:div>
				<h:div class="col-md-6">
					<label sclass="form-label"
						value="Seleccione modelo" />
					<combobox model="@load(vm.subtables)"  value="@bind(vm.entidad)" onSelect="@command('selectEntity')">
						<template name="model" var="item">
						   <comboitem value="${item.namesql}" label="${item.namesql}"/>
						 </template>
					</combobox>
				</h:div>
				<h:div class="col-md-10">
						<dual-listbox id="dualLBox" />
				</h:div>
				
				
			</div>
		</div>
	</window>
</zk>