<!-- View of customized component DualListbox -->
<hlayout height="400px" style="padding:10px">
	<listbox id="candidateLb" hflex="1" vflex="true" multiple="true" >
		<listhead>
			<listheader label="Field"></listheader>
			<listheader label="Foreing"></listheader>
		</listhead>
		<template name="model">
			<listitem>
				<listcell label="${each.columnname }" />
				<listcell label="${each.fktablename }" />
			</listitem>
		</template>
	</listbox>
	<zscript><![CDATA[
	String imgPath = "xul/component/icons";
]]></zscript>
	<vbox spacing="10px" width="24px">
		<image style="cursor:pointer" id="chooseAllBtn"
			src="${imgPath}/fast-forward-double-right-arrows-symbol.png" />
		<image style="cursor:pointer" id="chooseBtn"
			src="${imgPath}/arrow-point-to-right(1).png" />
		<image style="cursor:pointer" id="removeBtn"
			src="${imgPath}/arrowhead-thin-outline-to-the-left.png" />
		<image style="cursor:pointer" id="removeAllBtn"
			src="${imgPath}/double-left-arrows-symbol.png" />
	</vbox>
	<listbox id="chosenLb" hflex="1" vflex="true" multiple="true">
		<listhead>
			<listheader label="Field"></listheader>
			<listheader label="Foreing"></listheader>
			<listheader label="Show List"></listheader>
			<listheader label="is ComboList"></listheader>
		</listhead>
		<template name="model" >
				<listitem value="${each}">
					<listcell label="${each.columnname }" />
					<listcell label="${each.fktablename }" />
					<listcell>
					  <checkbox value="${each.showList}" onCheck="@command('onCheck',item=self.parent.parent.value,evento=event,field='showList')"  checked="${each.showList}"></checkbox>
					</listcell>
					<listcell>
					  <checkbox value="${each.combo}" onCheck="@command('onCheck',item=self.parent.parent.value,evento=event,field='combo')" checked="${each.combo}"></checkbox>
					</listcell>
				</listitem>

		</template>
	</listbox>

	<vbox spacing="10px" width="24px">
		<image style="cursor:pointer" id="topBtn"
			src="${imgPath}/double-up-arrow.png" />
		<image style="cursor:pointer" id="upBtn"
			src="${imgPath}/navigate-up-arrow.png" />
		<image style="cursor:pointer" id="downBtn"
			src="${imgPath}/arrow-down-sign-to-navigate.png" />
		<image style="cursor:pointer" id="bottomBtn"
			src="${imgPath}/double-down-arrows.png" />
	</vbox>
</hlayout>