<?component name="dual-listbox" extends="div" class="com.enartsystems.designer.commons.listbox.FieldsDualListBox"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml" xmlns:n="native"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute"
	xmlns:w="client">
	<window title="Configure Many to One" border="normal"
		closable="true" mode="modal" width="60%" height="500px"
		position="center,center" action="show: slideDown;hide: slideUp">
		<div
			viewModel="@id('vm') @init('com.enartsystems.designer.commons.OneToManyUI')">
			22222
			<div class="row">
				<button class="btn btn-success"
					iconSclass="icon wb-check" label="Save"
					onClick="@command('doStore')">
				</button>
			</div>
			<div class="row">
				<h:div class="col-md-6">
					<label sclass="form-label"
						value="Seleccione aplicación" />
					<combobox model="@load(vm.applications)"
						disabled="@load(vm.disabled)" value="@bind(vm.bean.application)"
						onSelect="@command('selectApp',item=event.data)">
						<template name="model" var="item">
							<comboitem
								value="${item.projectBase.txname}"
								label="${item.projectBase.txname}" />
						</template>
					</combobox>
				</h:div>
				<h:div class="col-md-6">
					<label sclass="form-label"
						value="Seleccione modelo" />
					<combobox model="@load(vm.beans)"
						disabled="@load(vm.disabled)" value="@bind(vm.entidad)"
						onSelect="@command('selectEntity')">
						<template name="model" var="item">
							<comboitem value="${item.namesql}"
								label="${item.namesql}" />
						</template>
					</combobox>
				</h:div>
				</div>
				<div class="row">
				<h:div class="col-md-4">
					<label sclass="form-label"
						value="Seleccione Tipo Componente" />
					<combobox onSelect=" @command('onChanging',event=event)" 
					id="tipoCompo" value="@bind(vm.bean.tipoComponenteSelect)" 
					selectedItem="@load(vm.bean.tipoComponente)" model="@load(vm.tipoRelation)" >
						<template name="model" var="item">
						  <comboitem label="${item.label}" value="${item.tipo}" />
						</template>
					</combobox>
				</h:div>
                <h:div class="col-md-4">
					<label sclass="form-label"
						value="Seleccione una Pantalla popup" />
					<combobox  
					id="screen" value="@bind(vm.bean.dialog)" 
					selectedItem="@load(vm.bean.dialog)" model="@load(vm.screens)" >
						<template name="model" var="item">
						  <comboitem label="${item.nameScreen}"
									value="${item.pageName}" />
						</template>
					</combobox>
				</h:div>
                </div>
                <div class="row">
				<h:div class="col-md-10">

					<tabbox>
						<tabs>
							<tab label="Campos a Visualizar" />
							<tab label="Campos de busqueda" />
						</tabs>
						<tabpanels>
							<tabpanel>
								<dual-listbox id="dualLBox" />
							</tabpanel>
							<tabpanel>
								<dual-listbox id="dualLBoxFind" />
							</tabpanel>
						</tabpanels>
					</tabbox>

					

				</h:div>


			</div>
		</div>
	</window>
</zk>