<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
	<div id="editDeskop">
		<idspace
			viewModel="@id('vm') @init('com.suinsit.webapp.wizzars.charts.FindChartsUI')">
			
			<div id="notificacion"></div>

			<div class="row">
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<div
								class="d-flex align-items-center flex-wrap gap-2">
								<div class="flex-grow-1">
									<button
										iconSclass="mdi mdi-chart-line-stacked label-icon align-middle fs-16 me-2"
										onClick="@command('addData')"
										sclass="btn btn-label btn-success waves-effect waves-light"
										tooltiptext="New Chart">
										New Chart
									</button>
								</div>
								<div class="flex-shrink-0">

								</div>
							</div>
						</div>
					</div>
				</div><!--end col-->

				<div class="col-xxl-12">
					<div class="card">
						<div class="card-header">
							<div class="row g-2">
								<div class="col-md-3">
									<div class="search-box">
									</div>
								</div>
								<div class="col-md-3">

								</div>
							</div>
						</div>
						<h:div class="card-body"
							style="overflow:auto;">
							<grid id="gr" model="@bind(vm.charts)"
								style="align:center" width="98%" height="550px"
								emptyMessage="${labels.paging.nodata}" mold="paging"
								pagingPosition="top" pageSize="25">
								<columns columnsgroup="false"
									menupopup="auto" columnshide="false" sizable="true">
									<column label="" />
									<column label="chart"
										sort="auto(alias)" />
									<column label="type"
										sort="auto(type)" />
									<column
										label="${labels.MddMentity.fxalta}" sort="auto(lastModif)" />
									<column label="" />
								</columns>
								<rows>
									<template name="model" var="item">
										<row value="@bind(item)">
											<image src="${item.image}"
												style="object-fit: cover;" width="90px" height="47px" />
											<label
												value="@load(item.alias)" />
											<label
												value="@load(item.type)" />
											<label
												value="@load(item.lastModif)" />
											<cell align="center">
											<button
												onClick="@command('editData',item=item)"
												tooltiptext="${labels.MddMentity.edit}"
												iconSclass="mdi mdi-desktop-mac-dashboard fs-2x"
												sclass="btn btn-outline-success waves-effect waves-light shadow-none" />
											<space></space>
											<button
												onClick="@command('removeData',item=item)"
												tooltiptext="${labels.MddMentity.remove}"
												iconSclass="bx bx-trash fs-2x"
												sclass="btn btn-outline-danger waves-effect waves-light shadow-none" />
												
											</cell>
										</row>
									</template>
								</rows>

							</grid>
						</h:div>

					</div>
				</div>


			</div>
		</idspace>

	</div>

</zk>