<?page title="Agent Capabilities" contentType="text/html;charset=UTF-8"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/WEB-INF/templates/template.zul"?>
<zk>
    <div self="@define(content)" 
         viewModel="@id('vm') @init('org.suinsit.apps.agent.AgentCapabilitiesVM')">
        
        <!-- Capabilities Overview -->
        <hlayout sclass="capabilities-header">
            <div sclass="metric-box">
                <label value="Total Capabilities"/>
                <label value="@load(vm.totalCapabilities)"/>
            </div>
            <div sclass="metric-box">
                <label value="Active Skills"/>
                <label value="@load(vm.activeSkills)"/>
            </div>
            <div sclass="metric-box">
                <label value="Learning Progress"/>
                <label value="@load(vm.learningProgress)%"/>
            </div>
            <div sclass="metric-box">
                <label value="Skill Success Rate"/>
                <label value="@load(vm.skillSuccessRate)%"/>
            </div>
        </hlayout>

        <tabbox>
            <tabs>
                <tab label="Skill Management"/>
                <tab label="Learning & Training"/>
                <tab label="Capability Testing"/>
                <tab label="Integration Hub"/>
            </tabs>
            <tabpanels>
                <!-- Skill Management Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Skill Categories -->
                        <hlayout>
                            <combobox model="@load(vm.skillCategories)" 
                                     selectedItem="@bind(vm.selectedCategory)"
                                     onChange="@command('filterSkills')"/>
                            <button label="Add Skill" 
                                    onClick="@command('addSkill')"/>
                            <button label="Import Skills" 
                                    onClick="@command('importSkills')"/>
                        </hlayout>

                        <!-- Skills Grid -->
                        <grid model="@load(vm.agentSkills)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Skill Name"/>
                                <column label="Category"/>
                                <column label="Proficiency Level"/>
                                <column label="Usage Count"/>
                                <column label="Success Rate"/>
                                <column label="Status"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="skill">
                                <row>
                                    <label value="@load(skill.name)"/>
                                    <label value="@load(skill.category)"/>
                                    <progressmeter value="@load(skill.proficiencyLevel)"/>
                                    <label value="@load(skill.usageCount)"/>
                                    <label value="@load(skill.successRate)%"/>
                                    <label value="@load(skill.status)" 
                                           sclass="@load(skill.statusStyle)"/>
                                    <hlayout>
                                        <button label="Train" 
                                                onClick="@command('trainSkill', skill=skill)"/>
                                        <button label="Test" 
                                                onClick="@command('testSkill', skill=skill)"/>
                                        <button label="Disable" 
                                                onClick="@command('toggleSkill', skill=skill)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Skill Performance Charts -->
                        <hlayout>
                            <charts id="skillUsageChart" 
                                   type="bar"
                                   height="300px"
                                   title="Skill Usage Distribution"
                                   model="@load(vm.skillUsageData)"/>
                            
                            <charts id="skillSuccessChart" 
                                   type="line"
                                   height="300px"
                                   title="Skill Success Trends"
                                   model="@load(vm.skillSuccessData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Learning & Training Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Training Sessions -->
                        <groupbox title="Training Sessions">
                            <listbox model="@load(vm.trainingSessions)" 
                                    mold="paging" pageSize="10">
                                <listhead>
                                    <listheader label="Session ID"/>
                                    <listheader label="Skill"/>
                                    <listheader label="Start Time"/>
                                    <listheader label="Duration"/>
                                    <listheader label="Progress"/>
                                    <listheader label="Performance"/>
                                    <listheader label="Actions"/>
                                </listhead>
                                <template name="model" var="session">
                                    <listitem>
                                        <listcell label="@load(session.id)"/>
                                        <listcell label="@load(session.skillName)"/>
                                        <listcell label="@load(session.startTime)"/>
                                        <listcell label="@load(session.duration)"/>
                                        <listcell>
                                            <progressmeter value="@load(session.progress)"/>
                                        </listcell>
                                        <listcell>
                                            <label value="@load(session.performance)%" 
                                                   sclass="@load(session.performanceStyle)"/>
                                        </listcell>
                                        <listcell>
                                            <button label="View" 
                                                    onClick="@command('viewSession', session=session)"/>
                                            <button label="Stop" 
                                                    visible="@load(session.canStop)"
                                                    onClick="@command('stopSession', session=session)"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>

                        <!-- Learning Progress -->
                        <hlayout>
                            <charts id="learningProgressChart" 
                                   type="line"
                                   height="300px"
                                   title="Learning Progress Over Time"
                                   model="@load(vm.learningProgressData)"/>
                            
                            <charts id="skillImprovementChart" 
                                   type="column"
                                   height="300px"
                                   title="Skill Improvement Metrics"
                                   model="@load(vm.skillImprovementData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Capability Testing Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Test Scenarios -->
                        <groupbox title="Test Scenarios">
                            <grid model="@load(vm.testScenarios)" 
                                  mold="paging" pageSize="10">
                                <columns>
                                    <column label="Scenario Name"/>
                                    <column label="Skills Tested"/>
                                    <column label="Complexity"/>
                                    <column label="Last Run"/>
                                    <column label="Success Rate"/>
                                    <column label="Status"/>
                                    <column label="Actions"/>
                                </columns>
                                <template name="model" var="scenario">
                                    <row>
                                        <label value="@load(scenario.name)"/>
                                        <label value="@load(scenario.skillsTested)"/>
                                        <label value="@load(scenario.complexity)" 
                                               sclass="@load(scenario.complexityStyle)"/>
                                        <label value="@load(scenario.lastRun)"/>
                                        <label value="@load(scenario.successRate)%"/>
                                        <label value="@load(scenario.status)" 
                                               sclass="@load(scenario.statusStyle)"/>
                                        <hlayout>
                                            <button label="Run Test" 
                                                    onClick="@command('runTest', scenario=scenario)"/>
                                            <button label="View Results" 
                                                    onClick="@command('viewResults', scenario=scenario)"/>
                                            <button label="Edit" 
                                                    onClick="@command('editScenario', scenario=scenario)"/>
                                        </hlayout>
                                    </row>
                                </template>
                            </grid>
                        </groupbox>

                        <!-- Test Results -->
                        <hlayout>
                            <charts id="testResultsChart" 
                                   type="line"
                                   height="300px"
                                   title="Test Results Trends"
                                   model="@load(vm.testResultsData)"/>
                            
                            <charts id="capabilityMatrixChart" 
                                   type="radar"
                                   height="300px"
                                   title="Capability Matrix"
                                   model="@load(vm.capabilityMatrixData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>

                <!-- Integration Hub Panel -->
                <tabpanel>
                    <vlayout>
                        <!-- Integration Points -->
                        <grid model="@load(vm.integrationPoints)" 
                              mold="paging" pageSize="10">
                            <columns>
                                <column label="Integration Name"/>
                                <column label="Type"/>
                                <column label="Connected Skills"/>
                                <column label="Status"/>
                                <column label="Last Sync"/>
                                <column label="Health"/>
                                <column label="Actions"/>
                            </columns>
                            <template name="model" var="integration">
                                <row>
                                    <label value="@load(integration.name)"/>
                                    <label value="@load(integration.type)"/>
                                    <label value="@load(integration.connectedSkills)"/>
                                    <label value="@load(integration.status)" 
                                           sclass="@load(integration.statusStyle)"/>
                                    <label value="@load(integration.lastSync)"/>
                                    <progressmeter value="@load(integration.health)"/>
                                    <hlayout>
                                        <button label="Configure" 
                                                onClick="@command('configureIntegration', integration=integration)"/>
                                        <button label="Test Connection" 
                                                onClick="@command('testConnection', integration=integration)"/>
                                        <button label="Sync Now" 
                                                onClick="@command('syncIntegration', integration=integration)"/>
                                    </hlayout>
                                </row>
                            </template>
                        </grid>

                        <!-- Integration Analytics -->
                        <hlayout>
                            <charts id="integrationPerformanceChart" 
                                   type="line"
                                   height="300px"
                                   title="Integration Performance"
                                   model="@load(vm.integrationPerformanceData)"/>
                            
                            <charts id="dataFlowChart" 
                                   type="column"
                                   height="300px"
                                   title="Data Flow Analysis"
                                   model="@load(vm.dataFlowData)"/>
                        </hlayout>
                    </vlayout>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Modal Windows -->
        <window id="skillEditorWindow" 
                title="Skill Editor" 
                visible="false" 
                mode="modal"
                width="800px">
            <!-- Skill Editor Content -->
        </window>

        <window id="trainingSessionWindow" 
                title="Training Session Details" 
                visible="false" 
                mode="modal"
                width="90%"
                height="80%">
            <!-- Training Session Content -->
        </window>

        <window id="testResultsWindow" 
                title="Test Results" 
                visible="false" 
                mode="modal"
                width="90%"
                height="80%">
            <!-- Test Results Content -->
        </window>
    </div>
</zk>