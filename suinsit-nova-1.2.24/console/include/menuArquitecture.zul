		<menu label="Modelo de datos" iconSclass="mdi mdi-database">
			<menupopup>
				<menuitem label="Importar Base Datos"
					onClick="@global-command('selectDataPage',page='/console/xul/datamodel/import.zul',title='Importar Base Datos',menu='Modelo de datos')" iconSclass="mdi mdi-database-import-outline"/>
