<zk xmlns:h="native">
	<div sclass="row">
		<h:div class="col-md-3 ">
			<hbox spacing="3px">
				<label
					sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
					style="  " value="Proyecto" />
			</hbox>
			<label
				sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
				style="  " value="@bind(vm.almproject.proyectoalm)" />
		</h:div>
		<h:div class="col-md-3 ">
			<!-- sclass="margin-field" -->
			<hbox spacing="3px">
				<label
					sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
					style="  " value="Namespace" />
			</hbox>
			<label
				sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
				style="  " value="@bind(vm.almproject.namespace)" />

		</h:div>
		<h:div class="col-md-3 ">
			<!-- sclass="margin-field" -->
			<hbox spacing="10px">
				<label
					sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
					style="  " value="Solution Clone " />

			</hbox>
			<label
				sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
				style="  " value="@load(vm.solution.solucion)" />

		</h:div>
		<h:div class="col-md-3 ">
			<!-- sclass="margin-field" -->
			<hbox spacing="10px">
				<label
					sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
					style="  " value="Project Clone " />

			</hbox>
			<label
				sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
				style="  " value="@load(vm.almprojectClone.proyectoalm)" />

		</h:div>
	</div>
	<div sclass="row">
		<div sclass="col-lg-3">
			<vbox spacing="10px">
				<label
					sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
					style="  " value="Schema a Importar" />
				<listbox model="@load(vm.schemas)" checkmark="true"
					height="500px" pagingPosition="top" autopaging="true"
					mold="paging">
					<listhead>
						<listheader label="Solucion" sort="auto" />
						<listheader label="Tipo" sort="auto" />
					</listhead>
					<template name="model" var="item">
						<listitem value="${item}">
							<listcell label="${item.namesql}"></listcell>
							<listcell label="${item.entitype}"></listcell>
						</listitem>
					</template>
				</listbox>
			</vbox>


		</div>

		<div sclass="col-lg-3">
			<vbox spacing="10px">
				<label
					sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
					style="  " value="Datos a Importar " />
				<listbox model="@load(vm.importar)" checkmark="true"
					height="500px" pagingPosition="top" autopaging="true"
					mold="paging">
					<listhead>
						<listheader label="Tabla / Entidad "
							sort="auto" />
					</listhead>
					<template name="model" var="item">
						<listitem value="${item}">
							<listcell label="${item.namesql}"></listcell>
						</listitem>
					</template>
				</listbox>
			</vbox>
		</div>
		<div sclass="col-lg-6">
			<div sclass="row">
				<h:div class="col-md-4 ">
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Nombre Base datos" />
					</hbox>
					<textbox tabindex="2" id="zLeutSzIUw"
						placeholder="Base de datos"
						value="@bind(vm.basedatos) @save(vm.basedatos, before=('nextScm')) @validator(vm.unique, required=true)"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['zLeutSzIUw'])" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Usuario" />
					</hbox>
					<textbox tabindex="3" id="341366"
						placeholder="usuario..."
						value="@bind(vm.almproject.usuariodatabase) @save(vm.almproject.usuariodatabase, before=('nextScm')) @validator(vm.unique, required=true)"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['341366'])" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Password" />
					</hbox>
					<textbox tabindex="3" id="341367"
						placeholder="password..."
						value="@bind(vm.almproject.passbasedatos) @save(vm.almproject.passbasedatos, before=('nextScm')) @validator(vm.unique, required=true)"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['341367'])" />
				</h:div>



				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Datos" />
					</hbox>
					<checkbox value="@bind(vm.importData)"
						checked="@bind(vm.importData)" />

				</h:div>
				<!-- otro servidor -->
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="URL Servidor Pre/Pro" />
					</hbox>
					<textbox tabindex="3" id="3413661"
						placeholder="URL Servidor Pre/Pro"
						value="@bind(vm.otherBBDD.url) @save(vm.otherBBDD.url, before=('nextScm'))"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['3413661'])" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Usuario ROOT/DBA" />
					</hbox>
					<textbox tabindex="3" id="3413671"
						placeholder="Usuario ROOT/DBA"
						value="@bind(vm.otherBBDD.user) @save(vm.otherBBDD.user, before=('nextScm'))"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['3413671'])" />
				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Password" />
					</hbox>
					<textbox tabindex="3" id="3413675"
						placeholder="password..."
						value="@bind(vm.otherBBDD.password) @save(vm.otherBBDD.password, before=('nextScm')) "
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['3413675'])" />
				</h:div>

				<!--  fin otro  -->
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Schema..." />
					</hbox>
					<checkbox value="@bind(vm.importSchema)"
						checked="@bind(vm.importSchema)" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Datos..." />
					</hbox>
					<checkbox value="@bind(vm.importData)"
						checked="@bind(vm.importData)" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Imagenes/Videos..." />
					</hbox>
					<checkbox value="@bind(vm.importMedia)"
						checked="@bind(vm.importMedia)" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Documentos..." />
					</hbox>
					<checkbox value="@bind(vm.importDocuments)"
						checked="@bind(vm.importDocuments)" />

				</h:div>

				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Micro Servicios (API)" />
					</hbox>
					<checkbox value="@bind(vm.importMicros)"
						checked="@bind(vm.importMicros)" />

				</h:div>
				<h:div class="col-md-4 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px">
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  " value="Importar Pantallas" />
					</hbox>
					<checkbox value="@bind(vm.importFront)"
						checked="@bind(vm.importFront)" />

				</h:div>





			</div>
		</div>

	</div>
	<div class="card-footer">
		<button zclass="pull-left"
			sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
			onClick="@command('back')"
			iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			label="Anterior" />
		<button zclass="pull-right"
			sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
			iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			onClick="@command('nextScm')" label="Siguiente" />
	</div>
</zk>