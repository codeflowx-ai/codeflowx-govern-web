<zk xmlns:h="native">

	<div class="row s-bot">
		<h:div class="col-lg-12 ">
			<div class="card">
				<div class="card-body">
					<div class="row">

						<div
							class="col-12 col-md-8 col-lg-8 full-height">
							<!--  componente standar de chatbot -->

							<div class="chatbot">
								<div class="chatbot-header">
									<h:img src="../img/leka-1.png"
										alt="Chat Icon" />
									<h:h5>LEKA</h:h5>
								</div>
								<div class="chatbot-body">
									<h:h6>
										¿Tienes dudas sobre como
										elaborar el documento?
										Pregúntanos.
									</h:h6>
									<hlayout class="b-bot">
										<div id="areaMsg"
											class="area-msgchat" vflex="1">
											<forEach
												items="@bind(vm.chatmsgs)" var="item">
												<choose>
													<when
														test="${item.usuario}">
														<div
															sclass="col-12 col-md-12 col-lg-12 stl-chat">
															<if
																test="${item.user ne null}">
																<label
																	value="${item.user}" sclass="${item.sclass}">
																</label>
															</if>
															<if
																test="${item.message ne null}">
																<label
																	value="${item.message}" sclass="${item.sclass}"
																	multiline="true">
																</label>
															</if>
														</div>

													</when>
													<when
														test="${item.assistan}">
														<if
															test="${item.icon ne null}">
															<h:icon
																sclass="${item.icon}">
															</h:icon>
														</if>
														<if
															test="${item.message ne null}">
															<label
																value="${item.message}" sclass="${item.sclass}"
																multiline="true">
															</label>
														</if>
													</when>
													<otherwise>
													</otherwise>
												</choose>
											</forEach>
										</div>

									</hlayout>
									<textbox id="tbmessage"
										multiline="true" rows="3" class="form-control"
										placeholder="Escribe tu mensaje..." value="@bind(vm.chatmsg)" />

									<button class="btn btn-primary"
										onClick="@command('sendChatMessage')">
										Enviar Mensaje
									</button>
								</div>
							</div>
						</div>
						<div class="col-12 col-md-4 col-lg-4">
							<div class="chatbot">
								<div
									class="chatbot-header justify-content-center">
									<h:h5>Definir nuevo dominio</h:h5>
								</div>
								<div class="chatbot-body">
									<div class="row">
										<div class="card "
											style="overflow:auto;">
											<div
												class="card-body entity-pl">
												<div
													class="form-group row ">
													<h:div
														class="col-md-3 border-field">

														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Nombre del Dominio" />

														<textbox
															value="@bind(vm.userRequest.domainName) @save(vm.userRequest.domainName, before={'next','sendFirst'}) @validator(vm.validator,maxl=100,minl=10,required=true)"
															placeholder="introduzca el dominio de negocio"
															id="coentityname1" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" />
														<label
															sclass="text-danger" value="@load(vmsgs['coentityname1'])">
														</label>
													</h:div>
													<h:div
														class="col-md-6 border-field">

														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Regulaciones" />

														<textbox
															value="@bind(vm.userRequest.regulaciones) @save(vm.userRequest.regulaciones, before={'next','sendFirst'}) @validator(vm.validator,maxl=500)"
															placeholder="GDPR (Art. 35, 36), ISO/IEC 42001, ISO 29134..."
															id="regulaciones" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" multiline="true" rows="10"/>
														<label
															sclass="text-danger" value="@load(vmsgs['regulaciones'])">
														</label>
													</h:div>
													<h:div 	class="col-md-6 border-field">
														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Contexto funcional" />
														<textbox
															value="@bind(vm.userRequest.additionalContext) @save(vm.userRequest.additionalContext, before={'next','sendFirst'}) @validator(vm.validator,maxl=2000,minl=10,required=true)"
															placeholder="Evaluación de impacto automatizada para sistemas de IA según AI Act ..."
															id="additionalContext" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" multiline="true" rows="10"/>
														<label
															sclass="text-danger" value="@load(vmsgs['additionalContext'])">
														</label>
													</h:div>
													<h:div
														class="col-md-6 border-field">
														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Descripcion Funcional" />
														<textbox
															value="@bind(vm.userRequest.functionalDescription) @save(vm.userRequest.functionalDescription, before={'next','sendFirst'}) @validator(vm.validator,maxl=2000)"
															placeholder=" Sistema integral de evaluación de impacto (DPIA) específico para IA"
															id="functionalDescription" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" multiline="true" rows="10"/>
														<label
															sclass="text-danger" value="@load(vmsgs['functionalDescription'])">
														</label>
													</h:div>
													<h:div 	class="col-md-6 border-field">
														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Reglas de negocio especiales" />
														<textbox
															value="@bind(vm.userRequest.businessRules) @save(vm.userRequest.businessRules, before={'next','sendFirst'}) @validator(vm.validator,maxl=2000)"
															placeholder=" calculos o evaluaciones"
															id="businessRules" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" multiline="true" rows="10"/>
														<label
															sclass="text-danger" value="@load(vmsgs['businessRules'])">
														</label>
													</h:div>
													<h:div 	class="col-md-6 border-field">
														<label
															sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
															style="  " value="Detalles tecnicos adicionales" />

														<textbox
															value="@bind(vm.userRequest.technicalDetails) @save(vm.userRequest.technicalDetails, before={'next','sendFirst'}) @validator(vm.validator,maxl=2000)"
															placeholder=" calculos o evaluaciones"
															id="technicalDetails" width="85%"
															sclass="margin-field form-control border-danger"
															onChange="@command('onchangeTable',evento=event)" multiline="true" rows="10"/>
														<label
															sclass="text-danger" value="@load(vmsgs['technicalDetails'])">
														</label>
													</h:div>
												</div>
											</div>
										</div>
									</div>





									
									<div
										class="d-flex align-items-center flex-wrap gap-2">
										<div
											class="flex-grow-1 w-100">
											<button
												tooltiptext="Descargar Plantilla"
												iconSclass="fa-duotone fa-solid fa-download"
												onClick="@command('uploadDoc')"
												sclass="btn btn-label btn-info waves-effect waves-light w-100">
												Descargar Plantilla
											</button>
										</div>
										<div
											class="flex-shrink-0 w-100">

											<div
												class="hstack text-nowrap w-100 gap-2">
												<button
													tooltiptext="Subir Fichero"
													iconSclass="fa-duotone fa-solid fa-upload"
													onUpload="@command('doUploadFiles', files=event.medias,progress=progress,messages=messages)"
													upload="true,maxsize=10000"
													sclass="btn btn-label btn-primary waves-effect waves-light w-100">
													Subir Documento
												</button>
											</div>
										</div>
									</div>
									<div
										class="d-flex align-items-center flex-wrap gap-2">
										<div class="flex-grow-1">
											<groupbox
												title="Attachments: " open="true" sclass="attachments">
												<div id="target"
													sclass="dropzone" children="@load(vm.attachments)">
													<template
														name="children" var="attachment">
														<span
															sclass="attachment">
															<a
																iconSclass="z-icon-paperclip" label="@load(attachment)" />
														</span>
													</template>
												</div>
												<dropupload
													maxsize="1024" detection="browser" anchor="${target}"
													onUpload="@command('doUploadFiles', files=event.medias)"
													content="Drag your files here (max. 1MB) multiple allowed" />
											</groupbox>

										</div>
									</div>


								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card-footer">

					<button zclass="pull-right"
						sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
						iconSclass="fa-duotone fa-solid fa-arrow-right align-middle rounded-pill fs-16 me-2"
						onClick="@command('sendFirst',form=fx)" label="Siguiente" />

				</div>
			</div>
		</h:div>

	</div>
</zk>