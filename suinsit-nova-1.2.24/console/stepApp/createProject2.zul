<zk xmlns:h="native">

	<div sclass="row">
		<div sclass="col-lg-4">
			<listbox model="@load(vm.solutions)"
				selectedItem="@bind(vm.solution)" checkmark="true" height="400px" onSelect="@command('selectSolution',item=self.selectedItem.value)">
				<listhead>
					<listheader label="Solucion" sort="auto" />
					<listheader label="Descripcion" sort="auto" />
				</listhead>
				<template name="model" var="item">
					<listitem value="${item}">
						<listcell label="${item.solucion}"></listcell>
						<listcell label="${item.descorta}"></listcell>
					</listitem>
				</template>
			</listbox>

		</div>
		<div sclass="col-lg-4">
			<listbox model="@load(vm.projects)"
				selectedItem="@bind(vm.almprojectClone)" checkmark="true"
				height="400px" onSelect="@command('selectProject',item=self.selectedItem.value)">
				<listhead>
					<listheader label="Projecto" sort="auto" />
					<listheader label="Descripcion" sort="auto" />
				</listhead>
				<template name="model" var="item">
					<listitem value="${item}">
						<listcell label="${item.proyectoalm}"></listcell>
						<listcell label="${item.descbreve}"></listcell>
					</listitem>

				</template>
			</listbox>

		</div>
		<div sclass="col-lg-4">
			<div sclass="row">
				<h:div class="col-md-8 ">
					<hbox spacing="3px">
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  " value="Proyecto" />
					</hbox>
					<textbox tabindex="2" id="zLeutSzIUw"
						placeholder="Proyecto..."
						value="@bind(vm.almproject.proyectoalm) @save(vm.almproject.proyectoalm, before=('nextDataBase')) @validator(vm.unique, field='PROYECTOALM',required=true)"
						sclass="margin-field form-control  form-control border border-warning" />
					<label sclass="text-danger"
						value="@load(vmsgs['zLeutSzIUw'])" />

				</h:div>
				<h:div class="col-md-8 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="3px"
						>
						<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  "
							value="Namespace" />
					</hbox>
					<textbox tabindex="3" id="341366"
						placeholder="Namespace..."
						value="@bind(vm.almproject.namespace) @save(vm.almproject.namespace, before=('nextDataBase')) @validator(vm.unique, field='NAMESPACE',required=true )"
						sclass="margin-field form-control  form-control border border-warning"
						 />
					<label sclass="text-danger"
						value="@load(vmsgs['341366'])" />

				</h:div>
				<h:div class="col-md-8 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px"
						>
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  "
							value="Solution Clone :" />
							<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  "
							value="@load(vm.solution.solucion)" />
					</hbox>
					    

				</h:div>
				<h:div class="col-md-8 ">
					<!-- sclass="margin-field" -->
					<hbox spacing="10px"
						>
						<label
							sclass="text form-label  text-capitalize  font-weight-bold align-text-middle"
							style="  "
							value="Project Clone :" />
							<label
							sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
							style="  "
							value="@load(vm.almprojectClone.proyectoalm)" />
					</hbox>
					    

				</h:div>
				
				 <h:div class="col-md-8 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px"  >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="Descripción Breve"  />
	   </hbox>
	    <textbox   tabindex="5" id="SlCKrcdfpb" 
	   placeholder="Descripción Breve" 
	   value="@bind(vm.almproject.descbreve) @save(vm.almproject.descbreve, before=('nextDataBase')) "   multiline="true"  rows="5"  
	   sclass="margin-field form-control  form-control border" 
	   />
       <label sclass="text-danger" value="@load(vmsgs['SlCKrcdfpb'])"/>
	   
    </h:div>   
				
			</div>

		</div>
	</div>
	<div class="card-footer">
		<button zclass="pull-left"
			sclass="btn btn-secondary btn-label waves-effect waves-light rounded-pill"
			onClick="@command('back')"
			iconSclass="bx bx-left-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			label="Anterior" />
		<button zclass="pull-right"
			sclass="btn btn-primary btn-label waves-effect waves-light rounded-pill"
			iconSclass="bx bx-right-arrow-alt label-icon align-middle rounded-pill fs-16 me-2"
			onClick="@command('nextDataBase')" label="Siguiente" />
	</div>
</zk>