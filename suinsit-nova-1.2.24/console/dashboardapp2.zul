<zk xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="d-flex">
		<div class="col-md-2 menu-sidebar">
			<vbox>
				<label value="@load(s.item.name)"
					class="sidebar-title" />
				<separator bar="true" />
				
			</vbox>
		</div>
		<div class="col-md-10" id="contenedor"></div>

		<div class="row g-4">
			<div
				class="page-title-box d-sm-flex align-items-center justify-content-between">
				<h:h4 class="mb-sm-0">${ds.item.name}</h:h4>
			</div>
		</div>
		<space height="30px"></space>
		<div class="row g-4">
			<div class="col-xl-12">
				<div class="row g-2">
					<forEach items="@load(ds.items)" varStatus="st">
						<div class="col-xl-2">
							<div class="card shadow-sm">
								<div class="card-header bg-primary">
									<h:h5
										class="card-title text-white">
										${each.name}
									</h:h5>
								</div>
								<div class="card-body">
									<div class="row">
										<div class="col-xl-3">

											<a
												iconSclass="@load(each.iconClass)">
											</a>

										</div>
										<div class="col-xl-9">
											<forEach
												items="${each.items}" var="item" varStatus="su">
												<h:a href="#"
													class="dropdown-item"
													onClick="@command('selectItem',item=item,main=each.name)">
													<div
														class="d-flex align-items-center">
														<div
															class="ms-2">
															<h:small>
																${item.name}
															</h:small>
														</div>
													</div>
												</h:a>
												<h:hr
													class="dropdown-divider" />
											</forEach>
										</div>
									</div>


								</div>

							</div>
						</div>
					</forEach>


				</div>
			</div>
		</div>
</zk>