<!doctype html>
<html class="h-100" lang="en" xmlns="http://www.w3.org/1999/xhtml"
	xmlns:zk="zk" xmlns:z="zul" xmlns:c="client"
	xmlns:b='http://www.google.com/2005/gml/b'
	xmlns:data='http://www.google.com/2005/gml/data'
	xmlns:expr='http://www.google.com/2005/gml/expr'
	xmlns:og='http://opengraphprotocol.org/schema/'>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <title>Nova</title>

    <!-- Favicon -->
    <link href="img/logo_white.png" rel="icon">
    <link rel="canonical" href="">
  

    <!-- CSS Bootstrap -->
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <!-- Estilos personalizados -->
    <link href="css/nova-styles.css?v=1.1" rel="stylesheet">

    <!-- Fuente personalizada -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	
	<!-- Estilos slick -->
		<link rel="stylesheet" type="text/css"
			href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
</head>
  
  <body class="bd-back" style="background: url('img/log/fn-suinsit.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">

    
    	
    
<z:div class="container-fluid h-login">
	<z:div class="row login-file">
		 <z:div class="col-12 col-md-4 col-lg-4 mod-left" style="background: url('img/log/bg-v1.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">
		 
			<a href="index.html">
			<img src="img/log/nova.png" class="log-img" width="50%" alt="Logo" />
<!-- 				<img src="img/log/leka-logow.png" class="log-img" width="50%" alt="Logo" /> -->
			</a>
<!-- 			<z:div class="carousel"> -->
<!-- 				<z:div class="carousel-slide"> -->
<!-- 					<p class="fs-15 fst-italic">Plataforma de desarrollo de -->
<!-- 						módulos y aplicaciones</p> -->
<!-- 					<img src="img/log/slide1.png" alt="" /> -->
<!-- 				</z:div> -->
<!-- 				<z:div class="carousel-slide"> -->
<!-- 					<p class="fs-15 fst-italic">Acceso permitido a personal -->
<!-- 						de desarrollo</p> -->
<!-- 					<img src="img/log/slide2.png" alt="" /> -->
<!-- 				</z:div> -->
<!-- 				<z:div class="carousel-slide"> -->
