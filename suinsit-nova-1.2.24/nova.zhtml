<!-- 						de desarrollo</p> -->
<!-- 					<img src="img/log/slide3.png" alt="" /> -->
<!-- 				</z:div> -->
<!-- 			</z:div> -->
		
		</z:div>
		
		<z:div class="col-12 col-md-8 col-lg-8 mod-right"> 
		<z:div class="tab-right" style="background: url('img/log/bg-v1.jpg') center center no-repeat;  background-size: cover; background-position-y: center;">
			<h4>Bienvenido de nuevo</h4>
		</z:div>
		
			<z:div class="p-content-r">
				<form class="login-form" class="btn-office">
				<img src="img/log/leka-1.png" class="log-img" width="25%"
					alt="Leka" />
				      <z:div class="login-is"> 
						<h2>Desarrollo y Gestión de IA</h2>
					 </z:div>
			          <p>Autentifícate para acceder</p>
			          <z:div class="input-group">
						<!-- <input type="email" id="email" placeholder="Ingrese su correo"> -->
			              <z:textbox
							id="email1"
							placeholder="Ingrese su correo"
							class="form-control" />
			          </z:div>
			          <z:div class="input-group">
					<!--<input type="password" id="password" placeholder="Ingrese su contraseña"> -->
			              <z:textbox
							type="password"
							placeholder="Ingrese su contraseña"
							class="form-control pe-5" />
			          </z:div>
			          <z:div class="forgot-password">
			              <z:a href="#">¿Olvidó su contraseña?</z:a>
			          </z:div>
			          <z:button type="submit">Iniciar Sesión</z:button>
			      </form>
			      
			      <!-- Formulario de recuperación de contraseña -->
			      <form class="recover-password-form" style="display:none;">
			          <h2>Recuperar Contraseña</h2>
			          <z:div class="input-group">
<!-- 			              <label for="recover-email">Correo electrónico</label> -->
<!-- 			              <input type="email" id="recover-email" placeholder="Ingrese su correo para recuperar la contraseña"> -->

							<z:textbox
								id="recover-email"
								placeholder="Ingrese su correo para recuperar la contraseña"
								class="form-control" />
							<z:label
								sclass="text-danger"/>
			          </z:div>
			          
			          	  <z:button type="submit">Recuperar Contraseña</z:button>
			       
			          
			      </form>
			</z:div>
		</z:div>
		
	</z:div>
</z:div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
		<script type="text/javascript"
			src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
		<script>
			$(document).ready(function(){
			$('.carousel').slick({
			autoplay: true,
			autoplaySpeed: 2000, 
			dots: true, 
			arrows: false, 
			infinite: true,
			speed: 500,
			fade: true,
			cssEase: 'linear'
			});
			});
		</script>


</body>

</html>
