{
  "name": "videcodeweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev -p 3003",
    "dev:fast": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev -p 3003 --turbo",
    "dev:mock": "cross-env MOCK_MODE=true NEXT_PUBLIC_ENV=development next dev -p 3003",
    "dev:backend": "cross-env BACKEND_URL=http://localhost:8080 NEXT_PUBLIC_ENV=development next dev -p 3003",
    "dev:staging": "cross-env NEXT_PUBLIC_ENV=staging next dev -p 3003",
    "dev:cache": "pnpm dev --turbo -p 3003",
    "build": "next build",
    "build:fast": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:staging": "cross-env NEXT_PUBLIC_ENV=staging next build",
    "build:production": "cross-env NEXT_PUBLIC_ENV=production next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "copy:bpmn": "node scripts/copy-bpmn-processes.js",
    "validate:bpmn": "node scripts/validate-bpmn-xml.js",
    "replace:activiti": "node scripts/replace-activiti-to-flowable.js",
    "bpmn:add-di": "node scripts/add-di-to-bpmn.js",
    "bpmn:add-di:missing": "node scripts/add-di-to-bpmn-missing.js",
    "clean": "cross-env-shell \"rm -rf .next && rm -rf node_modules/.cache\" || rmdir /s /q .next 2>nul & rmdir /s /q node_modules\\.cache 2>nul",
    "clean:all": "cross-env-shell \"rm -rf .next && rm -rf node_modules && rm -rf .pnpm-store\" || rmdir /s /q .next 2>nul & rmdir /s /q node_modules 2>nul"
  },
  "dependencies": {
