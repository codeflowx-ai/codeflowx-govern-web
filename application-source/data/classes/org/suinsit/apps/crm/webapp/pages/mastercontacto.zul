 <button label="Nueva Tarea" tooltiptext="añadir nuevo registro" iconSclass="fa-duotone fa-pen-to-square" 
		onClick="@command('appendSubtable',alias='subcrmtarea',body='body_xyisLqGXCs',page='popuptarea.zul',close='btn_xyisLqGXCs',win=WIN_xyisLqGXCs)" 
		disabled="@load(!vm.appendSubtable)" class="btn"/>
