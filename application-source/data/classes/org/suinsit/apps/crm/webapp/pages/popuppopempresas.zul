<idspace id="popempresas" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='popempresas')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popempresas" />
	  
			<panel >
			<panelchildren>
			<div class="row">
