<div id="zKKmucmTzo"   visible="true"  class="col-lg-6 col-xlg-6 col-md-6">
  <div id="zKKmucmTzo-card" class="card  shadow-sm" style="overflow:auto;" >
       <div id="zKKmucmTzo-body" class="card-body ">
        <div id="zKKmucmTzo-row" class="form-group row ">



<h:div class="col-md-12 border-field">

   <hbox spacing="3px">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('TIPOEMP.label', 'Tipo Cliente'))"/>
 </hbox>

 <combobox mold="rounded" sclass="" id="TIPOEMP" model="@load(vm.getEnums('TIPOEMP'))" 
selectedItem="@load(vm.beanData.tipoemp)"  value="@load(vm.beanData.tipoemp) @save(vm.beanData.tipoemp, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['TIPOEMP'])"/>
</h:div>




<h:div class="col-md-12 border-field">
   <hbox spacing="3px" sclass="margin-field">
    <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idmactividad.label', 'Actividad'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_dUwiSPYFrL" />
   </hbox>
<h:div class="col-md-12">
<div >
<button  iconSclass="fa-duotone fa-magnifying-glass-waveform" sclass="btn btn-icon"   onClick="searchdUwiSPYFrL.visible=true"></button>
<a sclass="" tooltiptext="add" iconSclass="fa-duotone fa-arrow-up-right-from-square"  onClick="@command('appendForeingPopup',alias='idmactividad',win=WIN_dUwiSPYFrL,body='body_dUwiSPYFrL',page='popuppopactividad.zul')"></a>

<window id="WIN_dUwiSPYFrL" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title" id="staticActividadLabel"> Crear Actividad</h:h5>
</div>
<div class="modal-body" id="body_dUwiSPYFrL"></div>
<div class="modal-footer"></div>
</div>
</window>
</div>
</h:div>
<h:div class="mb-2">
<textbox id="tboxdUwiSPYFrL"  placeholder="" value="@bind(vm.beanData.idmactividad.actividad) @save(vm.beanData.idmactividad.actividad, before=('grabar'))  " 
 onChange="@command('onChangeFindTextForeing',alias='idmactividad',att='actividad',event=event,idcp='cbdUwiSPYFrL')"  sclass="form-control  bg-light border-0" />
<combobox id="cbdUwiSPYFrL" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idmactividad'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,alias='idmactividad',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.actividad}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxdUwiSPYFrL'])"/></h:div>
<window id="searchdUwiSPYFrL" mode="modal" visible="false">
<div class="modal-dialog modal-dialog-centered modal-lg">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title" id="examplesdUwiSPYFrL">Actividad</h:h5>
<button id="btn_SdUwiSPYFrL" class="btn-close"  onClick="searchdUwiSPYFrL.visible=false" ></button>
</div><div class="modal-body">
<div sclass="mb-2">
<textbox sclass="form-control  bg-light border-0" placeholder="introduzca criterios..." onOK="@command('onChangeFindForeing',alias='idmactividad',att='actividad,cnae,iae,',input=self)" onChange="@command('onChangeFindForeing',alias='idmactividad',att='actividad,cnae,iae,',event=event)"/>
</div><div sclass="mb-2">
<listbox height="400px" mold="paging" pageSize="20" pagingPosition="bottom" model="@bind(vm.foreings['idmactividad'])" onSelect="@command('onSelectForeingPopup', alias='idmactividad',item=self.selectedItem.value,hidde=searchdUwiSPYFrL )">
<listhead>
<listheader label="@load(vm.lang.getProperty('ACTIVIDAD.label','actividad'))"  />
<listheader label="@load(vm.lang.getProperty('CNAE.label','cnae'))"  />
<listheader label="@load(vm.lang.getProperty('IAE.label','iae'))"  />
</listhead>
<template name="model" var="item">
<listitem value="@load(item)">
<listcell label="@load(item.actividad)" />
<listcell label="@load(item.cnae)" />
<listcell label="@load(item.iae)" />
</listitem></template></listbox>
</div></div></div></div></window>

   <popup id="pop_dUwiSPYFrL" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idmactividad.helptext', 'Actividad'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>







   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('TELEFONO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TELEFONO.label', 'Teléfono'))"  />
	   </hbox>
	   <textbox   tabindex="3" id="479683" 
	   placeholder="@load(vm.lang.getProperty('TELEFONO.label', 'Teléfono'))" 
	   value="@bind(vm.beanData.telefono) @save(vm.beanData.telefono, before=('grabar')) "  sclass="margin-field form-control text-dark" 
	   visible="@load(vm.isVisible('TELEFONO'))" disabled="@load(vm.isEditable('TELEFONO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['479683'])"/>
    </h:div>   









   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('CORREO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CORREO.label', 'Correo / Notificaciones'))"  />
	   </hbox>
	   <textbox   tabindex="4" id="718516" 
	   placeholder="@load(vm.lang.getProperty('CORREO.label', 'Correo / Notificaciones'))" 
	   value="@bind(vm.beanData.correo) @save(vm.beanData.correo, before=('grabar')) @validator(vm.validator,required=true ,type='EMAIL' ,oldValue=vm.beanDataCpy.correo)"  sclass="margin-field form-control  form-control    border-danger" 
	   visible="@load(vm.isVisible('CORREO'))" disabled="@load(vm.isEditable('CORREO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['718516'])"/>
    </h:div>   




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['popempresas.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 






                  
                 





                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popempresas');
  binder.command('doLoad');
});
function loadpopempresas(){
  var binder = zkbind.$('$popempresas');
  binder.command('doLoadBean');

}
</script>	
</zk>