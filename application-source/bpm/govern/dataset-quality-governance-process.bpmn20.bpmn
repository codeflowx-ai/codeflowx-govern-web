      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="parallelGatewayFork" id="BPMNShape_parallelGatewayFork">
        <omgdc:Bounds height="40.0" width="40.0" x="500.0" y="226.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="detectBias" id="BPMNShape_detectBias">
        <omgdc:Bounds height="101.0" width="105.0" x="611.0" y="319.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="validateCompliance" id="BPMNShape_validateCompliance">
        <omgdc:Bounds height="91.0" width="105.0" x="570.0" y="30.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="parallelGatewayJoin" id="BPMNShape_parallelGatewayJoin">
        <omgdc:Bounds height="40.0" width="40.0" x="740.0" y="222.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="calculateScore" id="BPMNShape_calculateScore">
        <omgdc:Bounds height="76.0" width="105.0" x="820.0" y="213.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="decisionGateway" id="BPMNShape_decisionGateway">
        <omgdc:Bounds height="40.0" width="40.0" x="980.0" y="200.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="humanReview" id="BPMNShape_humanReview">
        <omgdc:Bounds height="85.0" width="130.0" x="1080.0" y="273.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="humanDecisionGateway" id="BPMNShape_humanDecisionGateway">
        <omgdc:Bounds height="40.0" width="40.0" x="1250.0" y="295.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="notifyApproval" id="BPMNShape_notifyApproval">
        <omgdc:Bounds height="60.0" width="100.0" x="1472.0" y="289.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="notifyRejection" id="BPMNShape_notifyRejection">
        <omgdc:Bounds height="60.0" width="100.0" x="1410.0" y="135.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endApproved" id="BPMNShape_endApproved">
        <omgdc:Bounds height="35.0" width="35.0" x="1630.0" y="308.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endRejected" id="BPMNShape_endRejected">
        <omgdc:Bounds height="35.0" width="35.0" x="1700.0" y="470.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flow1" id="BPMNEdge_flow1">
        <omgdi:waypoint x="76.0" y="318.0"></omgdi:waypoint>
        <omgdi:waypoint x="110.0" y="311.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow2" id="BPMNEdge_flow2">
        <omgdi:waypoint x="215.0" y="311.0"></omgdi:waypoint>
