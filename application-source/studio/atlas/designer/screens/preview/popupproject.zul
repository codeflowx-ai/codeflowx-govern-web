        <h:td>
            
                   <a d:data-bs-toggle="modal" d:data-bs-target="#staticLeNTErTJNa" 
						onClick="@command('editSubtable',alias='subatlrproject',body='body_LeNTErTJNa',namespace='atlas',page='popupcomponentproject.zul',close='btn_LeNTErTJNa',item=item,win=WIN_LeNTErTJNa)"
