<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="versioncomponent" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='versioncomponent')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="versioncomponent" />
	<custom-attributes clase="org.suinsit.apps.atlas.Atlrcomponver" />
	   <custom-attributes namespace="atlas" />
	    <custom-attributes enviroment="preview" />
	     <custom-attributes uid="89456" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
			<div class="row">
			<div class="col-12">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
					<fragment
						exps="@load(vm.lang.getProperty('versioncomponent.screen', 'Version de componentes'))">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu} 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								Version de componentes
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
			<div class="row">
					<div class="col-lg-12">
				<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							<button onClick="@command('toSearch')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Volver
									</button>	
							</div>
							<div class="flex-shrink-0">
							<div class="hstack text-nowrap gap-2">
								
								    <button class="btn btn-secondary"
										iconSclass="fa-duotone fa-paintbrush-fine" onClick="@command('clear')">
										Limpiar
									</button>
									<button class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='continuar')">
										Guardar
									</button>
									<button
										class="btn" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='nuevo')">
										Guardar y Nuevo
									</button>
								
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<h:div class="col-lg-12">
						<h:div >
							<h:div >
		     <div class="row">


<div id="GlCkbAvsMY"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="GlCkbAvsMY-card" class="card  float-start shadow-lg" style="overflow:auto;" >
       <div id="GlCkbAvsMY-body" class="card-body ">
        <div id="GlCkbAvsMY-row" class="form-group row ">


				


    <h:div class="col-md-6 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('VERSION'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VERSION.label', 'Versión'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="wJJqIrHVHE" 
	   placeholder="@load(vm.lang.getProperty('VERSION.label', 'Versión'))" 
	   value="@bind(vm.beanData.version) @save(vm.beanData.version, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.version)"     sclass="margin-field form-control  form-control border-warning" 
	   visible="@load(vm.isVisible('VERSION'))" disabled="@load(vm.isEditable('VERSION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['wJJqIrHVHE'])"/>
	   
    </h:div>   






				


    <h:div class="col-md-6 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('FECHA'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('FECHA.label', 'Fecha'))"/>
	   </hbox>
	      <label sclass=" font-weight-normal align-text-middle" style="" value="@bind(vm.beanData.fecha) @save(vm.beanData.fecha, before=('grabar')) @converter(vm.fieldConverter,type='DATE')"/>
    
      </h:div>






				


    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('IMAGEN'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IMAGEN.label', 'Imagen Docker'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="VjCUImKKcl" 
	   placeholder="@load(vm.lang.getProperty('IMAGEN.label', 'Imagen Docker'))" 
	   value="@bind(vm.beanData.imagen) @save(vm.beanData.imagen, before=('grabar')) "     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('IMAGEN'))" disabled="@load(vm.isEditable('IMAGEN')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['VjCUImKKcl'])"/>
	   
    </h:div>   





<h:div class="col-md-12 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlcomponent.label', 'Componente'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idatlcomponent" placeholder="@load(vm.lang.getProperty('idatlcomponent').label,'Componente')" model="@bind(vm.foreings['idatlcomponent'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idatlcomponent',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idatlcomponent)"  onCreate="@command('onCreateCombo',component=self,alias='idatlcomponent')" value="@bind(vm.beanData.idatlcomponent .componente)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.componente)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlcomponent'])"/>

  
</h:div>


         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="VLQYMJMGJC"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="VLQYMJMGJC-card" class="card  shadow-lg" style="overflow:auto;" >
       <div id="VLQYMJMGJC-body" class="card-body ">
        <div id="VLQYMJMGJC-row" class="form-group row ">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('RELEASE.label', 'Info Release'))"/>
	   </hbox>
	  <tbeditor id="muanyxknta" value="@bind(vm.beanData.release) @save(vm.beanData.release, before=('grabar')) " />
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="MCIVNxgpCP"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="MCIVNxgpCP-card" class="card  shadow-lg" style="overflow:auto;" >
       <div id="MCIVNxgpCP-body" class="card-body ">
        <div id="MCIVNxgpCP-row" class="form-group row ">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DEPLOYMENTYML.label', 'Deployment'))"/>
	   </hbox>
	      <textbox rows="16" cols="80" id="XFEwgfjPDM" multiline="true" placeholder="@load(vm.lang.getProperty('DEPLOYMENTYML.label', 'Deployment'))" value="@bind(vm.beanData.deploymentyml) @save(vm.beanData.deploymentyml, before=('grabar')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('DEPLOYMENTYML'))" disabled="@load(vm.isEditable('DEPLOYMENTYML')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['XFEwgfjPDM'])"/>
	     
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        






<div id="OUnuxhbUVl" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="OUnuxhbUVl-row" class="row">
</div>
</div>  


             </div>      
            </h:div>
            
           </h:div>
          </h:div>
         </div>   
            <fragment exps="@load(vm.lang['versioncomponent.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>

                 





                  
                 


                  
                 


                  
                 

                  
<window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script type="text/javascript" >
zk.afterMount(function() {
 var binder = zkbind.$('$versioncomponent');
  binder.command('doLoad');
});
</script>
</zk>