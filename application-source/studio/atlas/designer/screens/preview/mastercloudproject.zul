<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="cloudproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='cloudproject')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="cloudproject" />
	<custom-attributes clase="org.suinsit.apps.atlas.Atlcloudproject" />
	   <custom-attributes namespace="atlas" />
	    <custom-attributes enviroment="preview" />
	     <custom-attributes uid="61958" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
			<div class="row">
			<div class="col-12">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
					<fragment
						exps="@load(vm.lang.getProperty('cloudproject.screen', 'Proyecto Cloud'))">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu} 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								Proyecto Cloud
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
			<div class="row">
					<div class="col-lg-12">
				<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							<button onClick="@command('toSearch')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Volver
									</button>	
							</div>
							<div class="flex-shrink-0">
							<div class="hstack text-nowrap gap-2">
								
								    <button class="btn btn-secondary"
										iconSclass="fa-duotone fa-paintbrush-fine" onClick="@command('clear')">
										Limpiar
									</button>
									<button class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='continuar')">
										Guardar
									</button>
									<button
										class="btn" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='nuevo')">
										Guardar y Nuevo
									</button>
								
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<h:div class="col-lg-12">
						<h:div >
							<h:div >
		     <div class="row">


<div id="UJcJZtoDGn"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="UJcJZtoDGn-card" class="card  shadow-xl" style="overflow:auto;" >
       <div id="UJcJZtoDGn-body" class="card-body ">
        <div id="UJcJZtoDGn-row" class="form-group row ">

<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Proyecto" />      
                                  <tab label="Clusters"  onSelect="@command('loadSubtableOnDemand',alias='subatlkubecloud')"/>      
                                  <tab label="Almacenamiento"  onSelect="@command('loadSubtableOnDemand',alias='subatlstorage')"/>      
                                  <tab label="Proyectos"  onSelect="@command('loadSubtableOnDemand',alias='subatlproject')"/>      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">





<h:div class=" col-lg-12 col-xlg-12 col-md-12">
  <h:div class="card " style="overflow:auto;" >
       <h:div class="card-body">
        <h:div class="form-group row">


				


  <!-- sclass="margin-field" -->
     <h:div class="col-md-4 ">
    <hbox spacing="3px" visible="@load(vm.isVisible('REFPROJECT'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('REFPROJECT.label', 'Ref. proyecto'))"/>
	   </hbox>
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.refproject)"  />
    </h:div>






				


    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('PROYECTO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="719508" 
	   placeholder="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))" 
	   value="@bind(vm.beanData.proyecto) @save(vm.beanData.proyecto, before=('grabar')) "     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('PROYECTO'))" disabled="@load(vm.isEditable('PROYECTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['719508'])"/>
	   
    </h:div>   






				


    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('REFEXTERNA'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REFEXTERNA.label', 'ID Externo'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="ybrJBEIpqJ" 
	   placeholder="@load(vm.lang.getProperty('REFEXTERNA.label', 'ID Externo'))" 
	   value="@bind(vm.beanData.refexterna) @save(vm.beanData.refexterna, before=('grabar')) "     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('REFEXTERNA'))" disabled="@load(vm.isEditable('REFEXTERNA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['ybrJBEIpqJ'])"/>
	   
    </h:div>   





   <h:div class="col-md-8">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripcion'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="nWTFOOjPEh" multiline="true" placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', 'Ninguno'))" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['nWTFOOjPEh'])"/>
	     
</h:div>




<h:div class="col-md-4 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlproveedor.label', 'Proveedor'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idatlproveedor" placeholder="@load(vm.lang.getProperty('idatlproveedor').label,'Proveedor')" model="@bind(vm.foreings['idatlproveedor'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idatlproveedor',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idatlproveedor)"  onCreate="@command('onCreateCombo',component=self,alias='idatlproveedor')" value="@bind(vm.beanData.idatlproveedor .proveedor)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.proveedor)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlproveedor'])"/>
<a sclass="" tooltiptext="add" iconSclass="fa-duotone fa-arrow-up-right-from-square" d:data-bs-toggle="modal"  d:data-bs-target="#staticATLPROVEEDOR" onClick="@command('appendForeing',win=WIN_GaowPzUwvS,alias='idatlproveedor',body='body_GaowPzUwvS',page='popupproveedor.zul',close='btn_idatlproveedor')"></a>

