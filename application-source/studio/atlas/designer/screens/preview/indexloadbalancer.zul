<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="loadbalancer" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='loadbalancer')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="loadbalancer" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlbalancer" />
	   <custom-attributes namespace="atlas" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="NCNcthPSXP" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="NCNcthPSXP-row" class="row">





   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('BALANCER'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('BALANCER.label', 'Balancer'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="424431" 
	   placeholder="@load(vm.lang.getProperty('BALANCER.label', 'balancer'))" 
	   value="@bind(vm.beanData.balancer) @save(vm.beanData.balancer, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('BALANCER'))" disabled="@load(vm.isEditable('BALANCER')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['424431'])"/>
    </h:div>   









   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('IPPUBLICA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IPPUBLICA.label', 'IPs  Publicas'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="ybZxfIsZhp" 
	   placeholder="@load(vm.lang.getProperty('IPPUBLICA.label', 'ippublica'))" 
	   value="@bind(vm.beanData.ippublica) @save(vm.beanData.ippublica, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('IPPUBLICA'))" disabled="@load(vm.isEditable('IPPUBLICA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['ybZxfIsZhp'])"/>
    </h:div>   









   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('INGRESSDEPLOY'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('INGRESSDEPLOY.label', 'Ingress Deploy'))"  />
	   </hbox>
	   <textbox   tabindex="3" id="441845" 
	   placeholder="@load(vm.lang.getProperty('INGRESSDEPLOY.label', 'ingressdeploy'))" 
	   value="@bind(vm.beanData.ingressdeploy) @save(vm.beanData.ingressdeploy, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('INGRESSDEPLOY'))" disabled="@load(vm.isEditable('INGRESSDEPLOY')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['441845'])"/>
    </h:div>   









   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('IDPROVEEDOR'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'ID proveedor'))"  />
	   </hbox>
	   <textbox   tabindex="4" id="631957" 
	   placeholder="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'idproveedor'))" 
	   value="@bind(vm.beanData.idproveedor) @save(vm.beanData.idproveedor, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('IDPROVEEDOR'))" disabled="@load(vm.isEditable('IDPROVEEDOR')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['631957'])"/>
    </h:div>   









  <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('IMPORTEMES'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('IMPORTEMES.label', 'Coste Mensual'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_IMPORTEMES" />
	   </hbox>
    <decimalbox   tabindex="5" id="homCutgayk" onCreate="" placeholder="@load(vm.lang.getProperty('IMPORTEMES.label', 'importemes'))"   
    value="@bind(vm.beanData.importemes) @save(vm.beanData.importemes, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="margin-field form-control  form-control" visible="@load(vm.isVisible('IMPORTEMES'))" disabled="@load(vm.isEditable('IMPORTEMES')?false:true)" onChange="@command('onChangeInput',field='IMPORTEMES',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['homCutgayk'])"/>
    </h:div>









    <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ANCHOBANDA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ANCHOBANDA.label', 'Velocidad / Ancho banda'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_ANCHOBANDA" />
	   </hbox>
    <intbox   tabindex="6" id="KYTzvzPkgd"  placeholder="@load(vm.lang.getProperty('ANCHOBANDA.label', 'anchobanda'))" sclass="margin-field form-control  form-control "  value="@bind(vm.beanData.anchobanda) @save(vm.beanData.anchobanda, before=('grabar')) " visible="@load(vm.isVisible('ANCHOBANDA'))" disabled="@load(vm.isEditable('ANCHOBANDA')?false:true)" onChange="@command('onChangeInput',field='ANCHOBANDA',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['KYTzvzPkgd'])"/>
    </h:div>




</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['loadbalancer.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$loadbalancer');
  binder.command('doLoad');
});
function loadloadbalancer(){
  var binder = zkbind.$('$loadbalancer');
  binder.command('doLoadBean');

}
</script>	
</zk>