					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('PROJECT.label', 'project'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROJECTAsc'])" sortDescending="@load(vm.comparators['PROJECTDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ALTA.label', 'alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('REFERENCIA.label', 'referencia'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REFERENCIAAsc'])" sortDescending="@load(vm.comparators['REFERENCIADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ESTADO.label', 'ESTADO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ESTADOAsc'])" sortDescending="@load(vm.comparators['ESTADODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('BGCOLOR.label', 'BGCOLOR'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BGCOLORAsc'])" sortDescending="@load(vm.comparators['BGCOLORDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('TOTUSER.label', 'totuser'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TOTUSERAsc'])" sortDescending="@load(vm.comparators['TOTUSERDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('TOTCUSTOMERS.label', 'totcustomers'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TOTCUSTOMERSAsc'])" sortDescending="@load(vm.comparators['TOTCUSTOMERSDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('CLUSTER.label', 'CLUSTER'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CLUSTERAsc'])" sortDescending="@load(vm.comparators['CLUSTERDesc'])"/>
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('PROJECT').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ALTA').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('REFERENCIA').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('estado').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('bgcolor').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('TOTUSER').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('TOTCUSTOMERS').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('cluster').value) @converter(vm.fieldConverter)"></label>
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterproject.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
