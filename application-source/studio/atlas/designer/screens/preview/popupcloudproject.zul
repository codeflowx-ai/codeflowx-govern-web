<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="cloudproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='cloudproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="cloudproject" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlcloudproject" />
	   <custom-attributes namespace="atlas" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<div id="GxIdREhFua"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="GxIdREhFua-card" class="card  shadow-xl" style="overflow:auto;" >
       <div id="GxIdREhFua-body" class="card-body ">
        <div id="GxIdREhFua-row" class="form-group row ">

<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Proyecto" />      
                                  <tab label="Clusters"  onSelect="@command('loadSubtableOnDemand',alias='subatlkubecloud')"/>      
                                  <tab label="Almacenamiento"  onSelect="@command('loadSubtableOnDemand',alias='subatlstorage')"/>      
                                  <tab label="Proyectos"  onSelect="@command('loadSubtableOnDemand',alias='subatlproject')"/>      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">



<h:div class=" col-lg-12 col-xlg-12 col-md-12">
  <h:div class="card " style="overflow:auto;" >
       <h:div class="card-body">
        <h:div class="form-group row">





  
    <h:div class="col-md-4 border-field">
    <hbox spacing="3px" visible="@load(vm.isVisible('REFPROJECT'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REFPROJECT.label', 'Ref. proyecto'))"/>
	   </hbox>
       <label sclass="margin-field fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.refproject)"  />
    </h:div>









   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PROYECTO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="719508" 
	   placeholder="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))" 
	   value="@bind(vm.beanData.proyecto) @save(vm.beanData.proyecto, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('PROYECTO'))" disabled="@load(vm.isEditable('PROYECTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['719508'])"/>
    </h:div>   









   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('REFEXTERNA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REFEXTERNA.label', 'ID Externo'))"  />
	   </hbox>
	   <textbox   tabindex="3" id="UymdKFGvNq" 
	   placeholder="@load(vm.lang.getProperty('REFEXTERNA.label', 'ID Externo'))" 
	   value="@bind(vm.beanData.refexterna) @save(vm.beanData.refexterna, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('REFEXTERNA'))" disabled="@load(vm.isEditable('REFEXTERNA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['UymdKFGvNq'])"/>
    </h:div>   





   <h:div class="col-md-8">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripcion'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="VOeELYEzXQ" multiline="true" placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', 'Ninguno'))" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['VOeELYEzXQ'])"/>
	     
</h:div>




<h:div class="col-md-4 border-field">
   <hbox spacing="3px" sclass="margin-field">
    <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlproveedor.label', 'Proveedor'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_PLYGRLulfU" />
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idatlproveedor" placeholder="@load(vm.lang.getProperty('idatlproveedor').label,'Proveedor')" model="@bind(vm.foreings['idatlproveedor'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idatlproveedor',item=self.selectedItem.value)"  		selectedItem="@load(vm.beanData.idatlproveedor)"  onCreate="@command('onCreateCombo',component=self,alias='idatlproveedor')" value="@bind(vm.beanData.idatlproveedor .proveedor)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.proveedor)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlproveedor'])"/>
<a sclass="" tooltiptext="add" iconSclass="fa-duotone fa-arrow-up-right-from-square" d:data-bs-toggle="modal"  d:data-bs-target="#staticATLPROVEEDOR" onClick="@command('appendForeing',win=WIN_PLYGRLulfU,alias='idatlproveedor',body='body_PLYGRLulfU',page='popupproveedor.zul',close='btn_idatlproveedor')"></a>

<window id="WIN_PLYGRLulfU" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title"> Crear proveedor</h:h5>
</div>
<div class="modal-body" id="body_PLYGRLulfU"></div>
<div class="modal-footer"></div>
</div>
</window>

   <popup id="pop_PLYGRLulfU" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idatlproveedor.helptext', 'idatlproveedor'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>


         </h:div> 
       </h:div>
  </h:div>
 </h:div> 


         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">


 
 <div class="col-lg-12">		
  <grid id="uLvPObJfLe" height="400px" width="100%" 
   model="@bind(vm.grid['subatlkubecloud']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlkubecloud')" >
 	      
  
  
  
  
  
	  <columns sizable="true">
   
      
	   
        <column label="@load(vm.lang.getProperty('REFERENCIA.label', 'REFERENCIA'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('CLUSTER.label', 'CLUSTER'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('REGION.label', 'REGION'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDPROVEEDOR'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('VERSIONKBUBE.label', 'VERSIONKBUBE'))" align="center" sclass="text-capitalize"/>
	 </columns>

  </grid>
  </div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">


 
 <div class="col-lg-12">		
  <grid id="OXdaojzctb" height="400px" width="100%" 
   model="@bind(vm.grid['subatlstorage']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlstorage')" >
 	      
  
  
  
  
  
	  <columns sizable="true">
   
      
	   
        <column label="@load(vm.lang.getProperty('STORAGE.label', 'STORAGE'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('ALTA.label', 'ALTA'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('CAPACIDAD.label', 'CAPACIDAD'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('PRECIO.label', 'PRECIO'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDPROVEEDOR'))" align="center" sclass="text-capitalize"/>
	 </columns>

  </grid>
  </div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">


 
 <div class="col-lg-12">		
  <grid id="hDRYgEwQMn" height="400px" width="100%" 
   model="@bind(vm.grid['subatlproject']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlproject')" >
 	      
  
  
  
  
  
	  <columns sizable="true">
   
      
	   
        <column label="@load(vm.lang.getProperty('REFERENCIA.label', 'REFERENCIA'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('PROJECT.label', 'PROJECT'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('ALTA.label', 'ALTA'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('BAJA.label', 'BAJA'))" align="center" sclass="text-capitalize"/>
   
      
	   
        <column label="@load(vm.lang.getProperty('EMPRESA.label', 'Empresa'))" align="center" sclass="text-capitalize"/>
	 </columns>

  </grid>
  </div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        

<div id="USbjeVkAmR" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="USbjeVkAmR-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
