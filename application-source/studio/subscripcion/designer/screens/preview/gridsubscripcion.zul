<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Subscripción.label', 'Subscripción'))" align="center"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACTIVO.label', 'Activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])"  visible="@load(vm.isVisible('ACTIVO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FECALTA.label', 'Fec. Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECALTAAsc'])" sortDescending="@load(vm.comparators['FECALTADesc'])"  visible="@load(vm.isVisible('FECALTA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FECBAJA.label', 'Fec. Baja'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECBAJAAsc'])" sortDescending="@load(vm.comparators['FECBAJADesc'])"  visible="@load(vm.isVisible('FECBAJA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('TOKENLIMITS.label', 'Limite Tokens'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TOKENLIMITSAsc'])" sortDescending="@load(vm.comparators['TOKENLIMITSDesc'])"  visible="@load(vm.isVisible('TOKENLIMITS'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROJECTLIMITS.label', 'Limite Proyectos'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROJECTLIMITSAsc'])" sortDescending="@load(vm.comparators['PROJECTLIMITSDesc'])"  visible="@load(vm.isVisible('PROJECTLIMITS'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('USERLIMITS.label', 'Limite Usuarios'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USERLIMITSAsc'])" sortDescending="@load(vm.comparators['USERLIMITSDesc'])"  visible="@load(vm.isVisible('USERLIMITS'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastersubscripcion.zul')">
                                   
                                          <label  value="@load(item.idsubtiposub.nombre) @converter(vm.fieldConverter)"></label>
                                   
							             <label  value="@load(item.activo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.fecalta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.fecbaja) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.tokenlimits) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.projectlimits) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.userlimits) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='mastersubscripcion.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
