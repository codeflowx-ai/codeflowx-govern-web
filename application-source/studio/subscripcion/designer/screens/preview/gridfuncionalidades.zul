<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FUNCIONALIDAD.label', 'Funcionalidad'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FUNCIONALIDADAsc'])" sortDescending="@load(vm.comparators['FUNCIONALIDADDesc'])"  visible="@load(vm.isVisible('FUNCIONALIDAD'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('REFUUID.label', 'UUID'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REFUUIDAsc'])" sortDescending="@load(vm.comparators['REFUUIDDesc'])"  visible="@load(vm.isVisible('REFUUID'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACTIVA.label', 'Activa'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVAAsc'])" sortDescending="@load(vm.comparators['ACTIVADesc'])"  visible="@load(vm.isVisible('ACTIVA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FACTURABLE.label', 'Facturable'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FACTURABLEAsc'])" sortDescending="@load(vm.comparators['FACTURABLEDesc'])"  visible="@load(vm.isVisible('FACTURABLE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('INCLUIDAMIN.label', 'Incluida'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['INCLUIDAMINAsc'])" sortDescending="@load(vm.comparators['INCLUIDAMINDesc'])"  visible="@load(vm.isVisible('INCLUIDAMIN'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterfuncionalidades.zul')">
							             <label  value="@load(item.funcionalidad) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.refuuid) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.activa) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.facturable) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.incluidamin) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterfuncionalidades.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
