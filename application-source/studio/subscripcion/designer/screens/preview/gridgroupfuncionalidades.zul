					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('FUNCIONALIDAD.label', 'Funcionalidad'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FUNCIONALIDADAsc'])" sortDescending="@load(vm.comparators['FUNCIONALIDADDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('REFUUID.label', 'Ref.UUID'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REFUUIDAsc'])" sortDescending="@load(vm.comparators['REFUUIDDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ACTIVA.label', 'Activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVAAsc'])" sortDescending="@load(vm.comparators['ACTIVADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('FACTURABLE.label', 'facturable'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FACTURABLEAsc'])" sortDescending="@load(vm.comparators['FACTURABLEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('INCLUIDAMIN.label', 'Incluye Minimo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['INCLUIDAMINAsc'])" sortDescending="@load(vm.comparators['INCLUIDAMINDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('FUNCIONALIDAD').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('REFUUID').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ACTIVA').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('FACTURABLE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('INCLUIDAMIN').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterfuncionalidades.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
