<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
					
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Usuario Asignado.label', 'Usuario Asignado'))" align="center"/>
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Tipo.label', 'Tipo'))" align="center"/>
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Estado.label', 'Estado'))" align="center"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterticket.zul')">
                                   <cell align="center">
                                          <label  value="@load(item.idasignado.usuario) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                   </cell> 
                                   <cell align="center">
                                              <zscript>
                                                    String estilo = item.idsopmtipo.backcolor;
                                              </zscript>
                                              <label  sclass="fw-bolder badge rounded-pill"  style="font-size:12px;background-color:${estilo};"  value="@load(item.idsopmtipo.tipoincidencia) @converter(vm.fieldConverter)"></label>   
                                                
                                        
                                      
                                    <space></space>
                                                
                                        
                                      
                                    <space></space>
                                   </cell> 
                                   <cell align="center">
                                              <zscript>
                                                    String estilo = item.idsopmestado.backcolor;
                                              </zscript>
                                              <label  sclass="fw-bolder badge rounded-pill"  style="font-size:12px;background-color:${estilo};"  value="@load(item.idsopmestado.estado) @converter(vm.fieldConverter)"></label>   
                                                
                                        
                                      
                                    <space></space>
                                                
                                        
                                      
                                    <space></space>
                                   </cell> 
							
                  			
                  		<cell align="center">
						  
						<button
						onClick="@command('editData',item=item,page='masterticket.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"    />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
 </div>						
</zk>						
