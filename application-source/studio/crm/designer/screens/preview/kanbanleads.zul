<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<style>
		.kanbantag{ display:inline-block; line-height: 26px;
		height:26px; border-radius: 5px; padding: 0px 6px;
		margin-bottom: 5px; color: white; }
		.z-portalchildren-frame>.z-portalchildren-content
		.z-panel.kanbantask,.kanbantask .z-panel-body{ background-color:
		white; } .z-portalchildren-title{ color: white; font-weight:
		bold; }
        .z-chart {
            height: 500px;
        }
        .z-chart-figure {
            min-width: 310px;
            max-width: 800px;
            margin: 1em auto;
        }
    </style>
	
	
	
	<idspace id="leads" viewModel="@id('vm')@init('org.suinsit.nocode.web.KanbanPortalUI')" validationMessages="@id('vmsgs')">
	    <custom-attributes pagina="leads" />
        <custom-attributes templateView="cardkanbanleads.zul" />
        <h:div id="notificacion"></h:div>
      <toolbar align="end">
          <toolbarbutton 
				iconSclass="mdi su-2x mdi-file-pdf" onClick="@command('report',type='pdf')" tooltiptext="View Pdf"/>
		<toolbarbutton 
				iconSclass="mdi su-2x mdi-file-excel" onClick="@command('report',type='excel')" tooltiptext="View Excel"/>
         <toolbarbutton 
				iconSclass="su-icon su-2x s-icon-funnel" onClick="@command('changeChart',chart='funnel')" tooltiptext="View Funnel Chart"/>
		<toolbarbutton 
				iconSclass="mdi su-2x mdi-chart-pie" onClick="@command('changeChart',chart='pie')" tooltiptext="View Pie Chart"/>
		<toolbarbutton 
				iconSclass="mdi su-2x mdi-chart-bar" onClick="@command('changeChart',chart='bar')" tooltiptext="View Bar Chart"/>
           <toolbarbutton 
				iconSclass="su-icon su-2x su-icon-menu-1" onClick="@command('changeView',view='gridkanbanlead.zul')" tooltiptext="View List"/>
			<toolbarbutton 
				iconSclass="su-icon su-2x su-icon-menu-7" onClick="@command('changeView',view='cardkanbanlead.zul')" tooltiptext="View Kanban"/>
       
			
		</toolbar>
		<div sclass="row">
			   <div id="divTemplate" sclass="col-lg-12" hflex="1"></div>

		</div>
	</idspace>
	<script type="text/javascript" >
zk.afterMount(function() {
 var binder = zkbind.$('$leads');
  binder.command('doLoad');
});
</script>
</zk>