
<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace viewModel="@id('vm') @init('org.suinsit.nocode.web.FindEntityUI')">
	  <custom-attributes pagina="clinetesfranquicias" />
	   <custom-attributes enviroment="preview" />
	<custom-attributes clase="org.suinsit.apps.crm.Crmempresa" />
	   <custom-attributes namespace="crm" />
	   <custom-attributes uid="962073" />
	   <custom-attributes tipo="SEARCH" />
	  <custom-attributes paginaIndex="indexclinetesfranquicias.zul" />
	   <custom-attributes templateView="gridclinetesfranquicias.zul" />
	   <h:div id="notificacion"></h:div>
	   
	   <div class="row  }" style="background-color:;">
			<div class="col-12   " style="">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
					<fragment
						exps="@load(vm.lang.getProperty('clientesfranquicias.screen', 'Clientes Franquicias'))">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    <label value="@load(vm.labelTotal)"></label>
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu} 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								Clientes Franquicias
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
		 <div class="row">
			<div class="col-lg-12">
				<div class="card   " style="background-color:;">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							
							 <button
									iconSclass="ri-add-fill me-1 align-bottom"
									  class="btn btn-info add-btn" 
									 onClick="@command('addData',page='masterclinetesfranquicias.zul')">
										Clientes Franquicias
								</button>
								</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2">
									<button class="btn btn-danger"
										iconSclass="ri-filter-2-line me-1 align-bottom">
										Filters
									</button>

																
									<button iconSclass="las la-file-alt"
										type="button" id="dropdownMenuLink1"
										d:data-bs-toggle="dropdown" d:aria-expanded="false"
										class="btn btn-soft-dark waves effect waves-light" >
									</button>
	
									<h:ul class="dropdown-menu"	aria-labelledby="dropdownMenuLink1">
										<h:li>
											<a class="dropdown-item"
												iconSclass="s-icon s-icon-cards"
												onClick="@command('changeView',view='cardclinetesfranquicias.zul')">
												Card
											</a>
										</h:li>
										<h:li>
											<a class="dropdown-item"
												iconSclass="s-icon s-icon-listing"
												onClick="@command('changeView',view='gridclinetesfranquicias.zul')">
												List
											</a>
										</h:li>
									</h:ul>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<div class="col-xxl-12">
				<div class="card" id="companyList">
					<div class="card-header">
						<div class="row g-2">
							<div class="col-md-3">
						    <div class="search-box">		
			  <textbox onOK="@command('search')"  placeholder="buscar por .. Empresa.. NIF" value="@bind(vm.search)"  sclass="form-control search"  >
			  </textbox> 
			 
			 </div> 
			 </div>  	
			
             
			
             
			
			  <div class="col-md-2">

 
<combobox mold="rounded" autodrop="true"  placeholder="@load(vm.lang.getProperty('idmtipoempresa').label,'Tipo de empresa')" model="@bind(vm.foreings['idmtipoempresa'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idmtipoempresa',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.form.getForeingByAlias('idmtipoempresa').fkentity)"  onCreate="@command('onCreateCombo',component=self,alias='idmtipoempresa')" value="@load(vm.form.getForeingByAlias('idmtipoempresa').fkentity .getFieldByAtribute('tipoempresa').value)"  ><template name="model" var="item">
<choose><when test="${item.name eq 'NOT_NULL' }">
<comboitem value="@load(item)" label="Contiene algún valor" />
</when> <when test="${item.name eq 'IS_NULL' }">
<comboitem value="@load(item)" label="No Contiene ningún valor" /></when><otherwise><comboitem value="@load(item)" label="@load(item.getFieldByAtribute('tipoempresa').value)" /></otherwise></choose></template></combobox>
                  </div>
             
			
			  <div class="col-md-2">

 
<h:div class="col-md-12">
<textbox id="tboxaQBJYUOVBJ"  placeholder="Actividad" value="@bind(vm.beanData.idmactividad.actividad)"  onOK="@command('search',alias='idmactividad',field='actividad')"  sclass="form-control  search" />
</h:div >

                  </div>
             
			
			  <div class="col-md-2">

 
<combobox mold="rounded" autodrop="true"  placeholder="@load(vm.lang.getProperty('idfrcmfranchise').label,'Franquicia')" model="@bind(vm.foreings['idfrcmfranchise'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idfrcmfranchise',item=self.selectedItem.value,changefk='idpartner',updatebean='true')"  		selectedItem="@load(vm.form.getForeingByAlias('idfrcmfranchise').fkentity)"  onCreate="@command('onCreateCombo',component=self,alias='idfrcmfranchise')" value="@load(vm.form.getForeingByAlias('idfrcmfranchise').fkentity .getFieldByAtribute('nombre').value)"  ><template name="model" var="item">
<choose><when test="${item.name eq 'NOT_NULL' }">
<comboitem value="@load(item)" label="Contiene algún valor" />
</when> <when test="${item.name eq 'IS_NULL' }">
<comboitem value="@load(item)" label="No Contiene ningún valor" /></when><otherwise><comboitem value="@load(item)" label="@load(item.getFieldByAtribute('nombre').value)" /></otherwise></choose></template></combobox>
                  </div>
             
								
							<div class="col-md-auto ms-auto">
								<div
									class="d-flex align-items-center gap-2">
									<button tooltiptext="Find"
										iconSclass="ri-search-line search-icon" sclass="btn"
										onClick="@command('search')" />
									<button tooltiptext="Clear"
										label="Clear" sclass="btn" onClick="@command('clear')" />
								</div>
							</div>
						</div>
					</div>
					<div class="card-body">
							<div id="divTemplate" sclass="col-lg-12"></div>
					</div>
					<div class="card-footer">
					<div class="row">
					<div class="col-lg-2">
							
						</div>
						
						<div class="col-lg-6 align-items-start">
						  <paging id="topagin"
							pageSize="@load(vm.scroll.maxRows)"
							totalSize="@load(vm.scroll.totalRows)" mold="os" width="100%"
							 style="background-color:#FFF;" />
						</div>
						<div class="col-lg-2 align-items-start">
							<combobox
								selectedItem="@bind(vm.scroll.maxRows)"
								value="@bind(vm.scroll.maxRows)" width="75px">
								<comboitem label="30" value="30" />
								<comboitem label="50" value="50" />
								<comboitem label="100" value="100" />
							</combobox>
						</div>
						
					</div>
					</div>
				</div>
			</div>
		</div><!-- row -->
	
	   <window id="WIN_showModal" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  >
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title"
						id="exampleModalLabel">
						Clientes Franquicias
					</h:h5>

				</div>
				<div class="modal-body" id="body_clinetesfranquicias"></div>
				<div class="modal-footer"></div>
			</div>
		</window>
	
  <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
	  
                <!--end add modal-->
	</idspace>
</zk>