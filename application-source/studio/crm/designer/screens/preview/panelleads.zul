<panel border="normal" hflex="1" sclass="kanbantask">
            <toolbar align="end">
             
			<toolbarbutton 
				iconSclass="icon-pencil7" sclass="btn-outline-secondary"
				d:data-bs-toggle="modal"  onClick="@command('onEdit',parent=self.parent.parent,popup=modalDialog)"/>
			<toolbarbutton 
				iconSclass="icon-trash" sclass="btn-outline-warning" onClick="@command('onRemove',parent=self.parent.parent)"/>
		
</toolbar>
	   <custom-attributes value="${item2}" scope="component"/>
	   <custom-attributes estado="${item1}" scope="component"/>
		<panelchildren >
			<div class="row">
			</div>
		</panelchildren>
	</panel>
