<div id="nkbUvAftBM"   visible="true"  class="col-lg-6 col-xlg-6 col-md-6">
  <div id="nkbUvAftBM-card" class="card  shadow-sm" style="overflow:auto;" >
       <div id="nkbUvAftBM-body" class="card-body ">
        <div id="nkbUvAftBM-row" class="form-group row ">

<h:div class="col-md-12 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idmactividad.label', 'Actividad'))"/>
 	 <a	iconSclass="bx bxs-message-square-dots" popup="pop_HNlHQqdPJJ" />
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idmactividad" placeholder="@load(vm.lang.getProperty('idmactividad').label,'Actividad')" model="@bind(vm.foreings['idmactividad'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idmactividad',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idmactividad)"  onCreate="@command('onCreateCombo',component=self,alias='idmactividad')" value="@bind(vm.beanData.idmactividad .actividad)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.actividad)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idmactividad'])"/>
    <popup id="pop_HNlHQqdPJJ" width="200px">
          <groupbox sclass="z-demo-config" closable="false">
            <caption>Ayuda</caption>
            <span>
                <![CDATA[
                 Actividad
                ]]>  
            </span>
        </groupbox>
 </popup>

  
</h:div>



<h:div class="col-md-12 ">
