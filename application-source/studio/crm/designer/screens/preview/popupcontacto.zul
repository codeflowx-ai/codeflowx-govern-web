<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace  viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterEntityUI',pagina='contacto')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="contacto" />
	  <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<h:div class="col-lg-3 col-xlg-3 col-md-3">
  <h:div class="card  shadow-xl bg-gradient " style="overflow:auto;background-color:#f2db96;" >
       <h:div class="card-body ">
        <h:div class="form-group row ">




   
    <h:div class="col-md-12">
       <hbox spacing="3px" visible="@load(vm.isVisible('NOMBRE'))">
	    <label id="lbNOMBRE" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))"  />
	   </hbox>
	   <textbox  tabindex="1" id="NOMBRE" placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.bean.getFieldByAtribute('NOMBRE').value )"  sclass="form-control  form-control    border-danger" visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['NOMBRE'])"/>
    </h:div>   








   
    <h:div class="col-md-12">
       <hbox spacing="3px" visible="@load(vm.isVisible('APELLIDOS'))">
	    <label id="lbAPELLIDOS" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('APELLIDOS.label', 'apellidos'))"  />
	   </hbox>
	   <textbox  tabindex="2" id="APELLIDOS" placeholder="@load(vm.lang.getProperty('APELLIDOS.label', 'apellidos'))" value="@bind(vm.beanData.apellidos) @save(vm.beanData.apellidos, before=('store')) "  sclass="form-control  form-control   " visible="@load(vm.isVisible('APELLIDOS'))" disabled="@load(vm.isEditable('APELLIDOS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['APELLIDOS'])"/>
    </h:div>   








   
    <h:div class="col-md-12">
       <hbox spacing="3px" visible="@load(vm.isVisible('DEPARTAMENTO'))">
	    <label id="lbDEPARTAMENTO" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DEPARTAMENTO.label', 'Departamento'))"  />
	   </hbox>
	   <textbox  tabindex="3" id="DEPARTAMENTO" placeholder="@load(vm.lang.getProperty('DEPARTAMENTO.label', 'Departamento'))" value="@bind(vm.beanData.departamento) @save(vm.beanData.departamento, before=('store')) @validator(vm.validator,maxl='100' ,oldValue=vm.bean.getFieldByAtribute('DEPARTAMENTO').value )"  sclass="form-control  form-control   " visible="@load(vm.isVisible('DEPARTAMENTO'))" disabled="@load(vm.isEditable('DEPARTAMENTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['DEPARTAMENTO'])"/>
    </h:div>   








   
    <h:div class="col-md-12">
       <hbox spacing="3px" visible="@load(vm.isVisible('CORREO'))">
	    <label id="lbCORREO" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CORREO.label', 'correo'))"  />
	   </hbox>
	   <textbox  tabindex="4" id="CORREO" placeholder="@load(vm.lang.getProperty('CORREO.label', 'correo'))" value="@bind(vm.beanData.correo) @save(vm.beanData.correo, before=('store')) @validator(vm.unique, field='CORREO',type='EMAIL' ,maxl='100' ,oldValue=vm.bean.getFieldByAtribute('CORREO').value )"  sclass="form-control  form-control   " visible="@load(vm.isVisible('CORREO'))" disabled="@load(vm.isEditable('CORREO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['CORREO'])"/>
    </h:div>   








   
    <h:div class="col-md-6">
       <hbox spacing="3px" visible="@load(vm.isVisible('TELEFONO'))">
	    <label id="lbTELEFONO" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('TELEFONO.label', 'telefono'))"  />
	   </hbox>
	   <textbox  tabindex="5" id="TELEFONO" placeholder="@load(vm.lang.getProperty('TELEFONO.label', 'telefono'))" value="@bind(vm.beanData.telefono) @save(vm.beanData.telefono, before=('store')) "  sclass="form-control  form-control   " visible="@load(vm.isVisible('TELEFONO'))" disabled="@load(vm.isEditable('TELEFONO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['TELEFONO'])"/>
    </h:div>   








   
    <h:div class="col-md-6">
       <hbox spacing="3px" visible="@load(vm.isVisible('MOVIL'))">
	    <label id="lbMOVIL" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MOVIL.label', 'movil'))"  />
	   </hbox>
	   <textbox  tabindex="6" id="MOVIL" placeholder="@load(vm.lang.getProperty('MOVIL.label', 'movil'))" value="@bind(vm.beanData.movil) @save(vm.beanData.movil, before=('store')) "  sclass="form-control  form-control   " visible="@load(vm.isVisible('MOVIL'))" disabled="@load(vm.isEditable('MOVIL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['MOVIL'])"/>
    </h:div>   




         </h:div> 
       </h:div>
  </h:div>
 </h:div>  
          
                              
          
        
<h:div style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4">
<h:div class="row">
</h:div>
</h:div>  <h:div style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4">
<h:div class="row">
</h:div>
</h:div>  <h:div style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12">
<h:div class="row">
</h:div>
</h:div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('store')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('storeNew')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['Contacto.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
			
			

 </idspace>
</zk>