<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace  id="direccion" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterEntityUI',pagina='direccion')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="direccion" />
	  <custom-attributes enviroment="preview" />
	  <div class="row">
	  <div class="col-lg-3"></div>
	  <div class="col-lg-6">
			<div class="row">
					<h:div class="col-lg-12">
						<h:div class="card">
							<div class="card-header bg-primary-400 header-elements-inline">
							
								
							</div>
							<h:div class="card-body">
						     <div class="row">				
<h:div style="overflow:auto;" class=" border-primary border-1 col-lg-12 col-xlg-12 col-md-12">
<h:div class="row">




   
    <h:div class="col-md-8">
       <hbox spacing="3px" visible="@load(vm.isVisible('DIRECCION'))">
	    <label id="lbDIRECCION" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DIRECCION.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="1" id="DIRECCION" placeholder="@load(vm.lang.getProperty('DIRECCION.label', ''))" value="@bind(vm.beanData.direccion) @save(vm.beanData.direccion, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.direccion)"  sclass="form-control  form-control border-danger" visible="@load(vm.isVisible('DIRECCION'))" disabled="@load(vm.isEditable('DIRECCION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['DIRECCION'])"/>
    </h:div>   







<h:div class="col-md-4">

   <hbox spacing="3px">
     <label sclass="form-label font-weight-normal text-danger" style="" value="@load(vm.lang.getProperty('TIPO.label', 'Tipo Dirección'))"/>
 </hbox>

 <combobox mold="rounded" sclass="border-warning" id="TIPO" model="@load(vm.form.getFieldByAtribute('TIPO').getFieldPropsBeanByID('txValues').enums)" 
selectedItem="@load(vm.beanData.tipo)"  value="@load(vm.beanData.tipo) @save(vm.beanData.tipo, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.bean.getFieldByAtribute('TIPO').value )">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['TIPO'])"/>
</h:div>







   
    <h:div class="col-md-6">
       <hbox spacing="3px" visible="@load(vm.isVisible('CIUDAD'))">
	    <label id="lbCIUDAD" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CIUDAD.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="3" id="CIUDAD" placeholder="@load(vm.lang.getProperty('CIUDAD.label', ''))" value="@bind(vm.beanData.ciudad) @save(vm.beanData.ciudad, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.ciudad)"  sclass="form-control  form-control border-danger" visible="@load(vm.isVisible('CIUDAD'))" disabled="@load(vm.isEditable('CIUDAD')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['CIUDAD'])"/>
    </h:div>   








   
    <h:div class="col-md-6">
       <hbox spacing="3px" visible="@load(vm.isVisible('ESTADO'))">
	    <label id="lbESTADO" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ESTADO.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="4" id="ESTADO" placeholder="@load(vm.lang.getProperty('ESTADO.label', ''))" value="@bind(vm.beanData.estado) @save(vm.beanData.estado, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.estado)"  sclass="form-control  form-control border-danger" visible="@load(vm.isVisible('ESTADO'))" disabled="@load(vm.isEditable('ESTADO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['ESTADO'])"/>
    </h:div>   








   
    <h:div class="col-md-4">
       <hbox spacing="3px" visible="@load(vm.isVisible('PAIS'))">
	    <label id="lbPAIS" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PAIS.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="5" id="PAIS" placeholder="@load(vm.lang.getProperty('PAIS.label', ''))" value="@bind(vm.beanData.pais) @save(vm.beanData.pais, before=('store')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('PAIS'))" disabled="@load(vm.isEditable('PAIS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['PAIS'])"/>
    </h:div>   








   
    <h:div class="col-md-4">
       <hbox spacing="3px" visible="@load(vm.isVisible('TELEFONO'))">
	    <label id="lbTELEFONO" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TELEFONO.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="6" id="TELEFONO" placeholder="@load(vm.lang.getProperty('TELEFONO.label', ''))" value="@bind(vm.beanData.telefono) @save(vm.beanData.telefono, before=('store')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('TELEFONO'))" disabled="@load(vm.isEditable('TELEFONO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['TELEFONO'])"/>
    </h:div>   








   
    <h:div class="col-md-4">
       <hbox spacing="3px" visible="@load(vm.isVisible('MOVIL'))">
	    <label id="lbMOVIL" sclass="form-label text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('MOVIL.label', ''))"  />
	   </hbox>
	   <textbox  tabindex="7" id="MOVIL" placeholder="@load(vm.lang.getProperty('MOVIL.label', ''))" value="@bind(vm.beanData.movil) @save(vm.beanData.movil, before=('store')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('MOVIL'))" disabled="@load(vm.isEditable('MOVIL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['MOVIL'])"/>
    </h:div>   




</h:div>
</h:div>                     </div>           
            </h:div>
            
           </h:div>
          </h:div>
         </div>   
  	  </div>
	  </div>
	  <div class="col-lg-3"></div>
		            <fragment exps="@load(vm.lang['Direccion.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>

 </idspace>
   <script>
zk.afterMount(function() {
 var binder = zkbind.$('$direccion');
  binder.command('doLoad');
});
function loaddireccion(){
  var binder = zkbind.$('$direccion');
  binder.command('doLoadBean');

}
</script>
</zk>