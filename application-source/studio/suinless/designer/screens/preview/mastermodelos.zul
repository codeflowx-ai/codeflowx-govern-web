	      placeholder="@load(vm.lang.getProperty('DESCRIPTION.label', ''))" value="@bind(vm.beanData.description) @save(vm.beanData.description, before=('grabar')) "   visible="@load(vm.isVisible('DESCRIPTION'))" disabled="@load(vm.isEditable('DESCRIPTION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['pTlmhgaHHN'])"/>
	     
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
