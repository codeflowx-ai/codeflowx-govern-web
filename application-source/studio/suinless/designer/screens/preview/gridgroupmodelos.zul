					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ALIAS.label', 'alias'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALIASAsc'])" sortDescending="@load(vm.comparators['ALIASDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('RELEASE.label', 'release'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['RELEASEAsc'])" sortDescending="@load(vm.comparators['RELEASEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('AUDIO.label', 'audio'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AUDIOAsc'])" sortDescending="@load(vm.comparators['AUDIODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('IMAGE.label', 'image'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['IMAGEAsc'])" sortDescending="@load(vm.comparators['IMAGEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('TEXT.label', 'text'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TEXTAsc'])" sortDescending="@load(vm.comparators['TEXTDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('VOICE.label', 'voice'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VOICEAsc'])" sortDescending="@load(vm.comparators['VOICEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('VIDEO.label', 'video'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VIDEOAsc'])" sortDescending="@load(vm.comparators['VIDEODesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							         <label  value="@load(item.getFieldByAtribute('ALIAS').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('RELEASE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('AUDIO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('IMAGE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('TEXT').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('VOICE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('VIDEO').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='mastermodelos.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
