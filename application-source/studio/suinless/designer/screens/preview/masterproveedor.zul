<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="proveedor" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='proveedor')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="proveedor" />
	<custom-attributes clase="org.suinsit.apps.suinless.Slprovider" />
	   <custom-attributes namespace="suinless" />
	    <custom-attributes enviroment="preview" />
	     <custom-attributes uid="58736" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	
	  	<div class="section header section-suinsit">
            <div class="left tittle-principal">
                <fragment exps="@load(vm.lang.getProperty('proveedor.screen', 'proveedor'))">
							<![CDATA[ <h2 class="mb-sm-0"
							textContent='@load(exps)'></h2> ]]>
					</fragment>
            </div>
            <div class="right">
                <h:p>	${ds.menu}  / proveedor</h:p>
            </div>
        </div>
			<div class="container-edit">
				<div class="header-buttons">
							<button onClick="@command('toSearch')"
										class="btn btn-light" >
										Volver
									</button>	
							
							<div class="right-buttons">
								
								    <button class="btn btn-secondary"
										iconSclass="s-icon s-icon-clear" onClick="@command('clear')">
										Limpiar
									</button>
									<button class="btn btn-success"
										iconSclass="s-icon s-icon-save me-1 align-bottom" onClick="@command('grabar',action='continuar')">
										Guardar
									</button>
									<button
										class="btn" iconSclass="s-icon s-icon-save me-1 align-bottom" onClick="@command('grabar',action='nuevo')">
										Guardar y Nuevo
									</button>
								
						
				</div>
			</div>
			<h:div class="col-lg-12">
						<h:div >
							<h:div >
		     <div class="row">


<div id="wDqhaunQZx"   visible="true"  class="col-lg-8 col-xlg-8 col-md-8">
  <div id="wDqhaunQZx-card" class="card  default shadow-lg" style="overflow:auto;" >
       <div id="wDqhaunQZx-body" class="card-body ">
        <div id="wDqhaunQZx-row" class="form-group row ">


				

    <h:div class="col-md-6 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('PROVIDER'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROVIDER.label', 'Proveedor'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="JcVvuLTuTT" 
	   placeholder="@load(vm.lang.getProperty('PROVIDER.label', 'Proveedor'))" 
	   value="@bind(vm.beanData.provider) @save(vm.beanData.provider, before=('grabar')) "  sclass="margin-field form-control  form-control border" 
	   visible="@load(vm.isVisible('PROVIDER'))" disabled="@load(vm.isEditable('PROVIDER')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['JcVvuLTuTT'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-6 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('ENDPOINT'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ENDPOINT.label', 'Endpoint'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="509354" 
	   placeholder="@load(vm.lang.getProperty('ENDPOINT.label', 'Endpoint'))" 
	   value="@bind(vm.beanData.endpoint) @save(vm.beanData.endpoint, before=('grabar')) "  sclass="margin-field form-control  form-control border" 
	   visible="@load(vm.isVisible('ENDPOINT'))" disabled="@load(vm.isEditable('ENDPOINT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['509354'])"/>
	   
    </h:div>   





<h:div class="col-md-3 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idsletipoprovgob.label', 'Tipo Proveedor'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idsletipoprovgob" placeholder="@load(vm.lang.getProperty('idsletipoprovgob').label,'Tipo Proveedor')" model="@bind(vm.foreings['idsletipoprovgob'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idsletipoprovgob',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idsletipoprovgob)"  onCreate="@command('onCreateCombo',component=self,alias='idsletipoprovgob')" value="@bind(vm.beanData.idsletipoprovgob .tipo)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.tipo)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idsletipoprovgob'])"/>

  
</h:div>




				

    <h:div class="col-md-6 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('CLAZZ'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CLAZZ.label', 'Clazz'))"  />
	   </hbox>
	    <textbox   tabindex="4" id="734550" 
	   placeholder="@load(vm.lang.getProperty('CLAZZ.label', 'Clazz'))" 
	   value="@bind(vm.beanData.clazz) @save(vm.beanData.clazz, before=('grabar')) "  sclass="margin-field form-control  form-control border" 
	   visible="@load(vm.isVisible('CLAZZ'))" disabled="@load(vm.isEditable('CLAZZ')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['734550'])"/>
	   
    </h:div>   





<h:div class="col-md-4 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idsleestadogob.label', 'Estado Ley EU'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idsleestadogob" placeholder="@load(vm.lang.getProperty('idsleestadogob').label,'Estado Ley EU')" model="@bind(vm.foreings['idsleestadogob'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idsleestadogob',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idsleestadogob)"  onCreate="@command('onCreateCombo',component=self,alias='idsleestadogob')" value="@bind(vm.beanData.idsleestadogob .bgcolor)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(c:cat3(item.bgcolor,' ',item.estado))" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idsleestadogob'])"/>

  
</h:div>


         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="mUhoOfnOrA"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="mUhoOfnOrA-card" class="card  default shadow-lg" style="overflow:auto;" >
       <div id="mUhoOfnOrA-body" class="card-body ">
        <div id="mUhoOfnOrA-row" class="form-group row ">

<h:div class="col-md-12">
<hbox spacing="3px">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))"/>
</hbox>


          <h:div class="image-cropper-container" style="width:100px;  height:100px;" >
     <image id="AVATAR" sclass="image-download" content="@bind(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        






<div id="eszvIkdIds" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="eszvIkdIds-row" class="row">









<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Resumen Tipo" />      
                 <tab label="Descripción" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-8">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFOPUBLIC.label', 'Resumen'))"/>
	   </hbox>
	      <textbox rows="16" cols="100" id="kOiNlnBcCF" multiline="true" placeholder="@load(vm.lang.getProperty('INFOPUBLIC.label', 'Resumen'))" value="@bind(vm.beanData.idsletipoprovgob.infopublic) @save(vm.beanData.idsletipoprovgob.infopublic, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('INFOPUBLIC'))" disabled="@load(vm.isEditable('INFOPUBLIC')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['kOiNlnBcCF'])"/>
	     
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))"/>
	   </hbox>
	  <tbeditor id="hHidNlxANP" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



</div>
</div>  


             </div>      
            </h:div>
            
           </h:div>
          </h:div>
         </div>   
            <fragment exps="@load(vm.lang['proveedor.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>

                 






                  
                 


                  
                 




                  
<window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script type="text/javascript" >
zk.afterMount(function() {
 var binder = zkbind.$('$proveedor');
  binder.command('doLoad');
});
</script>
</zk>