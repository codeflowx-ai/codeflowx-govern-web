<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="usertoken" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='usertoken')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupusertoken" />
<custom-attributes clase="org.suinsit.apps.suinless.Slrlogtoken" />
	   <custom-attributes namespace="suinless" />
	   <custom-attributes enviroment="preview" />
	        <custom-attributes uid="62872" />
	   <custom-attributes tipo="MASTER" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<div id="qSnxnUZSOL"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="qSnxnUZSOL-card" class="card  default shadow-lg" style="overflow:hidden;" >
       <div id="qSnxnUZSOL-body" class="card-body ">
        <div id="qSnxnUZSOL-row" class="form-group row ">


				

  <h:div class="col-md-2 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('FECHA'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="" value="@load(vm.lang.getProperty('FECHA.label', 'Fecha'))"/>
	   </hbox>
	<datebox     id="907883" cols="20"  tabindex="1" value="@bind(vm.beanData.fecha) @save(vm.beanData.fecha, before=('grabar')) "   format="dd/MM/yy HH:mm" placeholder="@load(vm.lang.getProperty('FECHA.label', 'fecha'))" 
    visible="@load(vm.isVisible('FECHA'))" disabled="@load(vm.isEditable('FECHA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['907883'])"/>   
    
    </h:div>






				

    <h:div class="col-md-2 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('INTOKEN'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INTOKEN.label', 'Token IN'))"/>
	   </hbox>
	      <decimalbox   tabindex="2" id="eUrmXBMpqn"  placeholder="@load(vm.lang.getProperty('INTOKEN.label', 'intoken'))"  value="@bind(vm.beanData.intoken) @save(vm.beanData.intoken, before=('grabar')) "  format="###,###,##0.00" sclass="margin-field form-control  form-control border" visible="@load(vm.isVisible('INTOKEN'))" disabled="@load(vm.isEditable('INTOKEN')?false:true)" onChange="@command('onChangeInput',field='INTOKEN',evento=event,componente=self,calculate=true)" />
           <label sclass="text-danger" value="@load(vmsgs['eUrmXBMpqn'])"/>   
    </h:div>






				

    <h:div class="col-md-3 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('OUTTOKEN'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('OUTTOKEN.label', 'Token Out'))"/>
	   </hbox>
	      <intbox   tabindex="3" id="YRWsolvKMy"  placeholder="@load(vm.lang.getProperty('OUTTOKEN.label', 'outtoken'))" sclass="margin-field form-control  form-control border "  value="@bind(vm.beanData.outtoken) @save(vm.beanData.outtoken, before=('grabar')) " visible="@load(vm.isVisible('OUTTOKEN'))" disabled="@load(vm.isEditable('OUTTOKEN')?false:true)" onChange="@command('onChangeInput',field='OUTTOKEN',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['YRWsolvKMy'])"/>   
    
    </h:div>






				

  <h:div class="col-md-3 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('PRICE'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PRICE.label', 'Importe'))"/>
	   </hbox>
   <decimalbox   tabindex="4" id="TttxxEfKAB" onCreate="" placeholder="@load(vm.lang.getProperty('PRICE.label', 'price'))"   
    value="@bind(vm.beanData.price) @save(vm.beanData.price, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="margin-field form-control  form-control border" visible="@load(vm.isVisible('PRICE'))" disabled="@load(vm.isEditable('PRICE')?false:true)" onChange="@command('onChangeInput',field='PRICE',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['TttxxEfKAB'])"/>
 
    </h:div>






 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('BILLING'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BILLING.label', 'Facturado'))"/>
	   </hbox>
 <checkbox mold="default" id="xftAxJSqmT" value="@bind(vm.beanData.billing) @save(vm.beanData.billing, before=('grabar'))" sclass="margin-field form-check-input" visible="@load(vm.isVisible('BILLING'))" disabled="@load(vm.isEditable('BILLING')?false:true)" checked="@bind(vm.beanData.billing) @save(vm.beanData.billing, before=('grabar'))"/>
</h:div>




<h:div class="col-md-6 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslesmodel.label', 'Modelo'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idslesmodel" placeholder="@load(vm.lang.getProperty('idslesmodel').label,'Modelo')" model="@bind(vm.foreings['idslesmodel'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslesmodel',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslesmodel)"  onCreate="@command('onCreateCombo',component=self,alias='idslesmodel')" value="@bind(vm.beanData.idslesmodel .model)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.model)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslesmodel'])"/>

  
</h:div>



<h:div class="col-md-6 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idalmproject.label', 'Proyecto'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idalmproject" placeholder="@load(vm.lang.getProperty('idalmproject').label,'Proyecto')" model="@bind(vm.foreings['idalmproject'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idalmproject',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idalmproject)"  onCreate="@command('onCreateCombo',component=self,alias='idalmproject')" value="@bind(vm.beanData.idalmproject .lekaproject)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.lekaproject)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idalmproject'])"/>

  
</h:div>



   <h:div class="col-md-6">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PROMPT.label', 'Prompt'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="RehoEtrLJt" multiline="true" placeholder="@load(vm.lang.getProperty('PROMPT.label', 'prompt'))" value="@bind(vm.beanData.prompt) @save(vm.beanData.prompt, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('PROMPT'))" disabled="@load(vm.isEditable('PROMPT')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['RehoEtrLJt'])"/>
	     
</h:div>




   <h:div class="col-md-6">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('USERMSG.label', 'User Msg.'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="HKCpLbCTHx" multiline="true" placeholder="@load(vm.lang.getProperty('USERMSG.label', 'usermsg'))" value="@bind(vm.beanData.usermsg) @save(vm.beanData.usermsg, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('USERMSG'))" disabled="@load(vm.isEditable('USERMSG')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['HKCpLbCTHx'])"/>
	     
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['usertoken.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 










                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$usertoken');
  binder.command('doLoad');
});
function loadusertoken(){
  var binder = zkbind.$('$usertoken');
  binder.command('doLoadBean');

}
</script>	
</zk>