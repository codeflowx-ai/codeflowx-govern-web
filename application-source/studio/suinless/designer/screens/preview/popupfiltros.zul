<combobox model="@load(vm.getEnums('PROYECTO'))" selectedItem=" @load(vm.beanData.proyecto) "   value="@load(vm.beanData.proyecto) @save(vm.beanData.proyecto, before=('grabar'))    @validator(vm.unique, field='PROYECTO',required=true ,oldValue=vm.beanDataCpy.proyecto)" >
<template name="model" var="item"><comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/></template></combobox>


  
</h:div>




				

