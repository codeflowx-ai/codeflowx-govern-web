<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="chatbot" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='chatbot')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="chatbot" />
	<custom-attributes clase="org.suinsit.apps.suinless.Sleschatbot" />
	   <custom-attributes namespace="suinless" />
	   <custom-attributes enviroment="preview" />
		<custom-attributes uid="68203" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('chatbot.screen', 'Gestion Chatbot'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">



<div id="eCOyLdyTKS" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="eCOyLdyTKS-row" class="row">


				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('CHATBOTNAME'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CHATBOTNAME.label', 'Nombre Chatbot'))"  />
	   
	    <textbox   tabindex="1" id="vTLCqTfdDo" 
	   placeholder="@load(vm.lang.getProperty('CHATBOTNAME.label', 'Nombre Chatbot'))" 
	   value="@bind(vm.beanData.chatbotname) @save(vm.beanData.chatbotname, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.chatbotname)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('CHATBOTNAME'))" disabled="@load(vm.isEditable('CHATBOTNAME')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['vTLCqTfdDo'])"/>
            
	   
    </div>   






				

    <div class="col-md-9  input-group" visible="@load(vm.isVisible('ACCESSTOKEN'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACCESSTOKEN.label', 'Token Acceso'))"  />
	   
	    <textbox   tabindex="2" id="FhMbNJugJj" 
	   placeholder="@load(vm.lang.getProperty('ACCESSTOKEN.label', 'Token Acceso'))" 
	   value="@bind(vm.beanData.accesstoken) @save(vm.beanData.accesstoken, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.accesstoken)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('ACCESSTOKEN'))" disabled="@load(vm.isEditable('ACCESSTOKEN')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['FhMbNJugJj'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('BUSINESSAREA'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('BUSINESSAREA.label', 'Área Negocio'))"  />
	   
	    <textbox   tabindex="3" id="llTLCehrJj" 
	   placeholder="@load(vm.lang.getProperty('BUSINESSAREA.label', 'Área Negocio'))" 
	   value="@bind(vm.beanData.businessarea) @save(vm.beanData.businessarea, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('BUSINESSAREA'))" disabled="@load(vm.isEditable('BUSINESSAREA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['llTLCehrJj'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('HUMANHANDOFFTHRESHOLD'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('HUMANHANDOFFTHRESHOLD.label', 'Umbral Derivación Humano'))"/>
	
	      <intbox   tabindex="4" id="ahwLLiUHSD"  placeholder="@load(vm.lang.getProperty('HUMANHANDOFFTHRESHOLD.label', 'Umbral Derivación Humano'))" sclass="  "  value="@bind(vm.beanData.humanhandoffthreshold) @save(vm.beanData.humanhandoffthreshold, before=('grabar')) " visible="@load(vm.isVisible('HUMANHANDOFFTHRESHOLD'))" disabled="@load(vm.isEditable('HUMANHANDOFFTHRESHOLD')?false:true)" onChange="@command('onChangeInput',field='HUMANHANDOFFTHRESHOLD',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['ahwLLiUHSD'])"/>   
    
    </div>





<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslesragproject.label', 'Proyecto RAG'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslesragproject" placeholder="@load(vm.lang.getProperty('idslesragproject').label,'Proyecto RAG')" model="@bind(vm.foreings['idslesragproject'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslesragproject',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslesragproject)"  onCreate="@command('onCreateCombo',component=self,alias='idslesragproject')" value="@bind(vm.beanData.idslesragproject .projectname)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.projectname)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslesragproject'])"/>

  
</h:div>


</div>
</div>  


               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['chatbot.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>







		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$chatbot');
  binder.command('doLoad');
});
</script>
</zk>