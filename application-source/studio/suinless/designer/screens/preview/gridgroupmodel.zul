					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ALIAS.label', 'alias'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALIASAsc'])" sortDescending="@load(vm.comparators['ALIASDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('RELEASE.label', 'release'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['RELEASEAsc'])" sortDescending="@load(vm.comparators['RELEASEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('PROVIDER.label', 'PROVIDER'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROVIDERAsc'])" sortDescending="@load(vm.comparators['PROVIDERDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('TIPOMODELO.label', 'TIPOMODELO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOMODELOAsc'])" sortDescending="@load(vm.comparators['TIPOMODELODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('CATEGORIA.label', 'CATEGORIA'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CATEGORIAAsc'])" sortDescending="@load(vm.comparators['CATEGORIADesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('USERAG.label', 'userag'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USERAGAsc'])" sortDescending="@load(vm.comparators['USERAGDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('MAXTOKENS.label', 'maxtokens'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['MAXTOKENSAsc'])" sortDescending="@load(vm.comparators['MAXTOKENSDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							         <label  value="@load(item.getFieldByAtribute('ALIAS').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('RELEASE').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('provider').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('tipomodelo').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('categoria').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('USERAG').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('MAXTOKENS').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='mastermodel.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
