					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ABREVIATURA.label', 'abreviatura'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ABREVIATURAAsc'])" sortDescending="@load(vm.comparators['ABREVIATURADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('FECALTA.label', 'fecalta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECALTAAsc'])" sortDescending="@load(vm.comparators['FECALTADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ESTADO.label', 'ESTADO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ESTADOAsc'])" sortDescending="@load(vm.comparators['ESTADODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('FAMILIA.label', 'FAMILIA'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FAMILIAAsc'])" sortDescending="@load(vm.comparators['FAMILIADesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('FAMILIA.label', 'FAMILIA'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FAMILIAAsc'])" sortDescending="@load(vm.comparators['FAMILIADesc'])"/>
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('NOMBRE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ABREVIATURA').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('FECALTA').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('estado').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('familia').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('familia').value) @converter(vm.fieldConverter)"></label>
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterpromp.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
