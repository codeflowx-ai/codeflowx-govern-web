<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="requisitoproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='requisitoproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="requisitoproject" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmoreqproyect" />
	   <custom-attributes namespace="pmo" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="gsutkPqeYI" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="gsutkPqeYI-row" class="row">



<h:div class=" col-lg-6 col-xlg-6 col-md-6">
  <h:div class="card " style="overflow:auto;" >
          <h:div class="card-header  bg-light">
          <h:h3 class="card-title mb-0">
               General</h:h3>
          </h:div>
       <h:div class="card-body">
        <h:div class="form-group row">


				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('REQUISITO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REQUISITO.label', 'Requisito'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="250004" 
	   placeholder="@load(vm.lang.getProperty('REQUISITO.label', 'Requisito'))" 
	   value="@bind(vm.beanData.requisito) @save(vm.beanData.requisito, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('REQUISITO'))" disabled="@load(vm.isEditable('REQUISITO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['250004'])"/>
	   
    </h:div>   






 <h:div class="col-md-6 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('OBLIGATORIO'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('OBLIGATORIO.label', 'Es Obligatorio'))"/>
	   </hbox>
 <checkbox mold="default" id="kTlueDzWuG" value="@bind(vm.beanData.obligatorio) @save(vm.beanData.obligatorio, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('OBLIGATORIO'))" disabled="@load(vm.isEditable('OBLIGATORIO')?false:true)" checked="@bind(vm.beanData.obligatorio) @save(vm.beanData.obligatorio, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-6 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('CUMPLIMENTADO'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CUMPLIMENTADO.label', 'Esta Cumplimentado'))"/>
	   </hbox>
 <checkbox mold="default" id="XdLRJveUOh" value="@bind(vm.beanData.cumplimentado) @save(vm.beanData.cumplimentado, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('CUMPLIMENTADO'))" disabled="@load(vm.isEditable('CUMPLIMENTADO')?false:true)" checked="@bind(vm.beanData.cumplimentado) @save(vm.beanData.cumplimentado, before=('grabar'))"/>
</h:div>




   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COMENTCLIENTE.label', 'Comentarios del cliente'))"/>
	   </hbox>
	  <tbeditor id="KGPlHgIILU" value="@bind(vm.beanData.comentcliente) @save(vm.beanData.comentcliente, before=('grabar')) " />
</h:div>



         </h:div> 
       </h:div>
  </h:div>
 </h:div> 





<h:div class=" col-lg-6 col-xlg-6 col-md-6">
  <h:div class="card " style="overflow:auto;" >
          <h:div class="card-header  bg-light text-light">
          <h:h3 class="card-title mb-0">
               Descripción Requisito</h:h3>
          </h:div>
       <h:div class="card-body">
        <h:div class="form-group row">

<h:div class="col-md-12 border-field">
   <hbox spacing="3px" sclass="margin-field">
    <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idpmotiporeq.label', 'Tipo de Requisito'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_kwZZkKaHxM" />
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idpmotiporeq" placeholder="@load(vm.lang.getProperty('idpmotiporeq').label,'Tipo de Requisito')" model="@bind(vm.foreings['idpmotiporeq'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idpmotiporeq',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idpmotiporeq)"  onCreate="@command('onCreateCombo',component=self,alias='idpmotiporeq')" value="@bind(vm.beanData.idpmotiporeq .tiporequisito)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.tiporequisito)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idpmotiporeq'])"/>
<a sclass="" tooltiptext="add" iconSclass="fa-duotone fa-arrow-up-right-from-square"  onClick="@command('appendForeingPopup',alias='idpmotiporeq',win=WIN_kwZZkKaHxM,body='body_kwZZkKaHxM',page='popuptiporequisito.zul')"></a>

<window id="WIN_kwZZkKaHxM" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title"> Crear tipo de requisito</h:h5>
</div>
<div class="modal-body" id="body_kwZZkKaHxM"></div>
<div class="modal-footer"></div>
</div>
</window>

   <popup id="pop_kwZZkKaHxM" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idpmotiporeq.helptext', 'idpmotiporeq'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>



   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Tipo de requisito'))"/>
	   </hbox>
	      <extHTML value="@bind(vm.beanData.idpmotiporeq.descripcion)"></extHTML>
	     
</h:div>




   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COMENTARIOS.label', 'Descripción del requisito'))"/>
	   </hbox>
	  <tbeditor id="rqkicJACAM" value="@bind(vm.beanData.comentarios) @save(vm.beanData.comentarios, before=('grabar')) " />
</h:div>



         </h:div> 
       </h:div>
  </h:div>
 </h:div> 


</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['RequisitoProject.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 










                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$requisitoproject');
  binder.command('doLoad');
});
function loadrequisitoproject(){
  var binder = zkbind.$('$requisitoproject');
  binder.command('doLoadBean');

}
</script>	
</zk>