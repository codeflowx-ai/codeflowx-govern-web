<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="userproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='userproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="userproject" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmorsuserproy" />
	   <custom-attributes namespace="pmo" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="SWqMGrkJYT" style="overflow:auto;" class=" bg-light col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="SWqMGrkJYT-row" class="row">

<h:div class="col-md-4 border-field">
   <hbox spacing="3px" sclass="margin-field">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('PERFIL.label', 'perfil'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_803055" />
   </hbox>
<combobox model="@load(vm.getEnums('PERFIL'))" selectedItem=" @load(vm.beanData.perfil) "   value="@load(vm.beanData.perfil) @save(vm.beanData.perfil, before=('grabar'))    " >
<template name="model" var="item"><comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/></template></combobox>

   <popup id="pop_803055" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('PERFIL.helptext', 'perfil'))">
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>




				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PERFIL'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PERFIL.label', 'perfil'))"  />
	   </hbox>
	      <label sclass=" font-weight-normal align-text-middle" style=" color: #336699;" value="@bind(vm.beanData.perfil) @save(vm.beanData.perfil, before=('grabar')) "/>
	   
    </h:div>   






				


    <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ALTA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'alta'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_ALTA" />
	   </hbox>
	      <label sclass=" font-weight-normal align-text-middle" style="" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) @converter(vm.fieldConverter,type='DATE')"/>
    
      </h:div>





<h:div class="col-md-4 border-field">
   <hbox spacing="3px" sclass="margin-field">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_280026" />
   </hbox>
<combobox model="@load(vm.getEnums('USUARIO'))" selectedItem=" @load(vm.beanData.usuario) "   value="@load(vm.beanData.usuario) @save(vm.beanData.usuario, before=('grabar'))    @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.usuario)" >
<template name="model" var="item"><comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/></template></combobox>

   <popup id="pop_280026" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('USUARIO.helptext', 'usuario'))">
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>




				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('USUARIO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))"  />
	   </hbox>
	      <label sclass=" font-weight-normal align-text-middle" style=" color: #336666;" value="@bind(vm.beanData.usuario) @save(vm.beanData.usuario, before=('grabar')) "/>
	   
    </h:div>   






				


    <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('BAJA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BAJA.label', 'Baja'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_BAJA" />
	   </hbox>
	      <datebox     id="293913"  placeholder="@load(vm.lang.getProperty('BAJA.label', 'Baja'))" tabindex="6" value="@bind(vm.beanData.baja) @save(vm.beanData.baja, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('BAJA'))" disabled="@load(vm.isEditable('BAJA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['293913'])"/>   
    
      </h:div>




</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['userproject.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$userproject');
  binder.command('doLoad');
});
function loaduserproject(){
  var binder = zkbind.$('$userproject');
  binder.command('doLoadBean');

}
</script>	
</zk>