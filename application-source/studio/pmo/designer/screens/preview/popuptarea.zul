<h:div class="mb-2">
<textbox id="tboxQmKRjXLBsI"  placeholder="" value="@bind(vm.beanData.idpmomproject.proyecto) @save(vm.beanData.idpmomproject.proyecto, before=('grabar'))  " 
 onChange="@command('onChangeFindTextForeing',alias='idpmomproject',att='proyecto',event=event,idcp='cbQmKRjXLBsI')"  sclass="form-control  bg-light border-0" />
<combobox id="cbQmKRjXLBsI" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idpmomproject'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,alias='idpmomproject',hidde=self)" width="85%">
