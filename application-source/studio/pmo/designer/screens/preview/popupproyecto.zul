            <h:td class="text-center">
				        <label sclass="" value="@load(item.cumplimentado) @converter(vm.fieldConverter)"></label>
              </h:td>
        <h:td>
            
                   <a d:data-bs-toggle="modal" d:data-bs-target="#staticSHhwMAjrig" 
						onClick="@command('editSubtable',alias='subpmoreqproyect',body='body_SHhwMAjrig',page='popuprequisitoproject.zul',close='btn_SHhwMAjrig',item=item,win=WIN_SHhwMAjrig)"
