<combobox mold="rounded" autodrop="true"  id="idpmoaprobacion" placeholder="@load(vm.lang.getProperty('idpmoaprobacion').label,'Estado aprobación')" model="@bind(vm.foreings['idpmoaprobacion'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idpmoaprobacion',item=self.selectedItem.value)"  		selectedItem="@load(vm.beanData.idpmoaprobacion)"  onCreate="@command('onCreateCombo',component=self,alias='idpmoaprobacion')" value="@bind(vm.beanData.idpmoaprobacion .aprobacion)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.aprobacion)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idpmoaprobacion'])"/>
   <popup id="pop_EdtoIQEglI" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idpmoaprobacion.helptext', 'idpmoaprobacion'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>



<h:div class="col-md-6 border-field">
   <hbox spacing="3px" sclass="margin-field">
    <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idpmomactivos.label', 'Activo'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_meeoQJIRgl" />
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idpmomactivos" placeholder="@load(vm.lang.getProperty('idpmomactivos').label,'Activo')" model="@bind(vm.foreings['idpmomactivos'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idpmomactivos',item=self.selectedItem.value)"  		selectedItem="@load(vm.beanData.idpmomactivos)"  onCreate="@command('onCreateCombo',component=self,alias='idpmomactivos')" value="@bind(vm.beanData.idpmomactivos .activo)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.activo)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idpmomactivos'])"/>
   <popup id="pop_meeoQJIRgl" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idpmomactivos.helptext', 'idpmomactivos'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>


</div>
