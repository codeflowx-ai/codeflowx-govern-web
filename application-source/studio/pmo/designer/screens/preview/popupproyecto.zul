						<a
						onClick="@command('removeSubtable',alias='subpmoreqproyect',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						 />
           </h:td> 
            
           
         </h:tr>
       </forEach>
      </h:tbody>
   </h:table> 
