<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="aprobacion" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='aprobacion')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="aprobacion" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmoaprobacion" />
	   <custom-attributes namespace="pmo" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="YdsPWsoRvF" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="YdsPWsoRvF-row" class="row">


				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('APROBACION'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('APROBACION.label', 'Tipo de Aprobación'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="HbVqfCoYfw" 
	   placeholder="@load(vm.lang.getProperty('APROBACION.label', 'aprobado,denegado,pendiente...'))" 
	   value="@bind(vm.beanData.aprobacion) @save(vm.beanData.aprobacion, before=('grabar')) @validator(vm.unique, field='APROBACION',required=true ,oldValue=vm.beanDataCpy.aprobacion)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('APROBACION'))" disabled="@load(vm.isEditable('APROBACION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['HbVqfCoYfw'])"/>
	   
    </h:div>   






 <h:div class="col-md-6 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('APROBADO'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('APROBADO.label', 'Está aprobado'))"/>
	   </hbox>
 <checkbox mold="default" id="iXHCBbSefs" value="@bind(vm.beanData.aprobado) @save(vm.beanData.aprobado, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('APROBADO'))" disabled="@load(vm.isEditable('APROBADO')?false:true)" checked="@bind(vm.beanData.aprobado) @save(vm.beanData.aprobado, before=('grabar'))"/>
</h:div>






<h:div class="col-md-6 border-field">

   <hbox spacing="3px">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('BGCOLOR.label', 'Backgroung Color'))"/>
 </hbox>

 <combobox mold="rounded" sclass="" id="BGCOLOR" model="@load(vm.getEnums('BGCOLOR'))" 
selectedItem="@load(vm.beanData.bgcolor)"  value="@load(vm.beanData.bgcolor) @save(vm.beanData.bgcolor, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['BGCOLOR'])"/>
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['aprobacion.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 




                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$aprobacion');
  binder.command('doLoad');
});
function loadaprobacion(){
  var binder = zkbind.$('$aprobacion');
  binder.command('doLoadBean');

}
</script>	
</zk>