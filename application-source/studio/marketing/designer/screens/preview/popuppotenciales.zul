        <div class="row">

<div class="col-md-6">
 <h:div class="col-md-6">
 <label sclass="form-label font-weight-normal align-text-middle" style="" value="Segmento"  />
   
    </h:div>
   

<listbox  checkmark="true"  model="@load(vm.foreings['idmktmsegmento'])" height="300px" onCreate="@command('onSubtableCreate',alias='submktrpotsegm',loadOnDemand='true')" ><listhead><listheader label="Segmento"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.segmento)"></listcell></listitem></template></listbox>
</div>



<div class="col-md-6">
 <h:div class="col-md-6">
 <label sclass="form-label font-weight-normal align-text-middle" style="" value="Producto"  />
   
    </h:div>
   

<listbox  checkmark="true"  model="@load(vm.foreings['idmktmproducto'])" height="300px" onCreate="@command('onSubtableCreate',alias='submktrpotprod',loadOnDemand='true')" ><listhead><listheader label="Producto"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.producto)"></listcell></listitem></template></listbox>
</div>


         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

<div class="col-lg-2">
 <div class="col-lg-1">
 <button label="Añadir" tooltiptext="añadir nuevo registro" iconSclass="s-icon s-icon-lapiz" 
		onClick="@command('appendSubtable',alias='submktreunion',body='body_oEhoPpiQvH',namespace='marketing',page='popupreunion.zul',close='btn_oEhoPpiQvH',win=WIN_oEhoPpiQvH)" 
		disabled="@load(!vm.appendSubtable)" class="btn"/>
 </div>
  	<space></space>
 </div>		
 
 <div class="table-responsive "
 
    onCreate="@command('onSubtableCreate',component=self,alias='submktreunion',body='body_oEhoPpiQvH',page='popupreunion.zul',win=WIN_oEhoPpiQvH,loadOnDemand='false')" >
  
   <h:table class="table align-middle table-bordered table-hover table-nowrap">
      <h:thead class="table-light">
        <h:tr>
       <h:th scope="col" class="text-center" ><label value="@load(vm.lang.getProperty('FECHAHORA.label', 'Fecha'))" sclass="text-capitalize font-weight-bold"/></h:th>
       <h:th scope="col" class="text-center" ><label value="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))" sclass="text-capitalize font-weight-bold"/></h:th>
       <h:th scope="col" class="text-center" ><label value="@load(vm.lang.getProperty('COMENTARIOS.label', 'Comentarios'))" sclass="text-capitalize font-weight-bold"/></h:th>
    <h:th></h:th>
        </h:tr>
      </h:thead>
      <h:tbody>
       <forEach items="@bind(vm.grid['submktreunion'])" var="item">
         <h:tr>
            <h:td class="text-center">
				     <label sclass="" value="@load(item.fechahora) @converter(vm.fieldConverter)"></label>
              </h:td>
            <h:td class="text-center">
				     <label sclass="" value="@load(item.tipo) @converter(vm.fieldConverter)"></label>
              </h:td>
            <h:td class="text-center">
				     <html><![CDATA[${item.comentarios}]]></html>
              </h:td>
        <h:td>
            
                   <a d:data-bs-toggle="modal" d:data-bs-target="#staticoEhoPpiQvH" 
						onClick="@command('editSubtable',alias='submktreunion',body='body_oEhoPpiQvH',namespace='marketing',page='popupreunion.zul',close='btn_oEhoPpiQvH',item=item,win=WIN_oEhoPpiQvH)"
						 iconSclass="s-icon s-icon-lapiz" sclass="btn" />
		                 <space></space>
						<a
						onClick="@command('removeSubtable',alias='submktreunion',item=item)"
						iconSclass="s-icon s-icon-trash"
						 />
           </h:td> 
            
           
         </h:tr>
       </forEach>
      </h:tbody>
   </h:table> 
 </div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['potenciales.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 











                  
                 
























  
