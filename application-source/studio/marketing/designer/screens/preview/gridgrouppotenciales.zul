					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('NOMBREDEEMPRESA.label', 'Empresa'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREDEEMPRESAAsc'])" sortDescending="@load(vm.comparators['NOMBREDEEMPRESADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ALTA.label', 'alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('FECHAULTIMA.label', 'fechaultima'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECHAULTIMAAsc'])" sortDescending="@load(vm.comparators['FECHAULTIMADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USUARIOAsc'])" sortDescending="@load(vm.comparators['USUARIODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('ESTADO.label', 'ESTADO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ESTADOAsc'])" sortDescending="@load(vm.comparators['ESTADODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('BACKCOLOR.label', 'BACKCOLOR'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BACKCOLORAsc'])" sortDescending="@load(vm.comparators['BACKCOLORDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('TIPOPOTENCIAL.label', 'tipopotencial'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOPOTENCIALAsc'])" sortDescending="@load(vm.comparators['TIPOPOTENCIALDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('CODE.label', 'CODE'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODEAsc'])" sortDescending="@load(vm.comparators['CODEDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('BACKCOLOR.label', 'BACKCOLOR'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BACKCOLORAsc'])" sortDescending="@load(vm.comparators['BACKCOLORDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('LOCALIDAD.label', 'Localidad'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['LOCALIDADAsc'])" sortDescending="@load(vm.comparators['LOCALIDADDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('TELEFONO1.label', 'Telefono1'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TELEFONO1Asc'])" sortDescending="@load(vm.comparators['TELEFONO1Desc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('NOMBREDEEMPRESA').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ALTA').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('FECHAULTIMA').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('usuario').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('estado').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('backcolor').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('TIPOPOTENCIAL').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('code').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('backcolor').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('LOCALIDAD').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('TELEFONO1').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterpotenciales.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
