<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="campaing" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='campaing')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="campaing" />
<custom-attributes clase="org.suinsit.apps.marketing.Mktcampaing" />
	   <custom-attributes namespace="marketing" />
	   <custom-attributes enviroment="preview" />
	        <custom-attributes uid="7993" />
	   <custom-attributes tipo="MASTER" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="tcbxXbNGgW" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="tcbxXbNGgW-row" class="row">
</div>
</div>  <div id="dBwethTAuD"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="dBwethTAuD-card" class="card  shadow-lg" style="overflow:auto;" >
       <div id="dBwethTAuD-body" class="card-body ">
        <div id="dBwethTAuD-row" class="form-group row ">


				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('CAMPAING'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CAMPAING.label', 'Campaing'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="85744" 
	   placeholder="@load(vm.lang.getProperty('CAMPAING.label', 'Campaing'))" 
	   value="@bind(vm.beanData.campaing) @save(vm.beanData.campaing, before=('grabar')) @validator(vm.unique, field='CAMPAING',required=true ,oldValue=vm.beanDataCpy.campaing)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('CAMPAING'))" disabled="@load(vm.isEditable('CAMPAING')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['85744'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('CODE'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CODE.label', 'Code'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="863497" 
	   placeholder="@load(vm.lang.getProperty('CODE.label', 'Code'))" 
	   value="@bind(vm.beanData.code) @save(vm.beanData.code, before=('grabar')) @validator(vm.unique, field='CODE',required=true ,oldValue=vm.beanDataCpy.code)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('CODE'))" disabled="@load(vm.isEditable('CODE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['863497'])"/>
	   
    </h:div>   






 <h:div class="col-md-6 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ACTIVA'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACTIVA.label', 'Activo'))"/>
	   </hbox>
 <checkbox mold="switch" id="hVxmpVrKId" value="@bind(vm.beanData.activa) @save(vm.beanData.activa, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('ACTIVA'))" disabled="@load(vm.isEditable('ACTIVA')?false:true)" checked="@bind(vm.beanData.activa) @save(vm.beanData.activa, before=('grabar'))"/>
</h:div>





				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('BACKCOLOR'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('BACKCOLOR.label', 'Color'))"  />
	   </hbox>
	     <colorbox id="TJcPlFgqdG" width="30px" height="25px" value="@bind(vm.beanData.backcolor) @save(vm.beanData.backcolor, before=('grabar'))"/>
	   
    </h:div>   




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        

<div id="TRSGYRyAAI" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="TRSGYRyAAI-row" class="row">
</div>
</div>  
<div id="PEvbxIPUSC" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="PEvbxIPUSC-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['campaing.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 

                  
                 





                  
                 

                  
                 

                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$campaing');
  binder.command('doLoad');
});
function loadcampaing(){
  var binder = zkbind.$('$campaing');
  binder.command('doLoadBean');

}
</script>	
</zk>