					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('PROYECTOALM.label', 'Proyecto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROYECTOALMAsc'])" sortDescending="@load(vm.comparators['PROYECTOALMDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('GENERACION.label', 'Fecha Generación'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['GENERACIONAsc'])" sortDescending="@load(vm.comparators['GENERACIONDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('USUARIO.label', 'Usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USUARIOAsc'])" sortDescending="@load(vm.comparators['USUARIODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('SCM.label', 'SCM'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SCMAsc'])" sortDescending="@load(vm.comparators['SCMDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('BRANCH.label', 'Branch'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BRANCHAsc'])" sortDescending="@load(vm.comparators['BRANCHDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('PROYECTOALM').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('GENERACION').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('USUARIO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('SCM').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('BRANCH').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='mastergenerador.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
