<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
			
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('TIPO.label', 'Tipo Servicio'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOAsc'])" sortDescending="@load(vm.comparators['TIPODesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ACRONIMO.label', 'Acrónimo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACRONIMOAsc'])" sortDescending="@load(vm.comparators['ACRONIMODesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('INFORMACION.label', 'Información'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['INFORMACIONAsc'])" sortDescending="@load(vm.comparators['INFORMACIONDesc'])"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;">
							             <label  value="@load(item.tipo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.acronimo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							       <label  value="@load(item.informacion) @converter(vm.converter, type='HTML',size=60)"></label>
							
                  			
                  		<cell align="center">
                  		
                  		<button
						onClick="@command('editPopup',item=item,body='body_tiposervicios',page='popuptiposervicio.zul',close='close-modal',win=WIN_showModal)"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"  />
						
                  		
						<space></space>
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn btn-square btn-outline-danger m-2"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
 </div>						
</zk>						
