<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="popenviroemnt" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='popenviroemnt')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popenviroemnt" />
<custom-attributes clase="org.suinsit.apps.myalm.Almenviroment" />
	   <custom-attributes namespace="myalm" />
	   <custom-attributes enviroment="preview" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="xbySZNvPJn" style="overflow:auto;" class=" col-lg-8 col-xlg-8 col-md-8"  visible="true" >
<div id="xbySZNvPJn-row" class="row">





   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('ENVIROMENT'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ENVIROMENT.label', 'Entorno'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="zgdTCEWnSi" 
	   placeholder="@load(vm.lang.getProperty('ENVIROMENT.label', 'Producción, Desarrollo, Test'))" 
	   value="@bind(vm.beanData.enviroment) @save(vm.beanData.enviroment, before=('grabar')) @validator(vm.unique, field='ENVIROMENT', oldValue=vm.beanDataCpy.enviroment)"  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('ENVIROMENT'))" disabled="@load(vm.isEditable('ENVIROMENT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['zgdTCEWnSi'])"/>
    </h:div>   






 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('DEVELOPMENT'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DEVELOPMENT.label', 'Entorno Desarrollo'))"/>
	   </hbox>
 <checkbox mold="default" id="exomHWaEyV" value="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('DEVELOPMENT'))" disabled="@load(vm.isEditable('DEVELOPMENT')?false:true)" checked="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('TESTING'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TESTING.label', 'Entorno de testing'))"/>
	   </hbox>
 <checkbox mold="default" id="cDJPmGGdlX" value="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('TESTING'))" disabled="@load(vm.isEditable('TESTING')?false:true)" checked="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('PRODUCTION'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PRODUCTION.label', 'Entorno de producción'))"/>
	   </hbox>
 <checkbox mold="default" id="phhClVgUlw" value="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('PRODUCTION'))" disabled="@load(vm.isEditable('PRODUCTION')?false:true)" checked="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))"/>
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['popenviroemnt.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 





                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popenviroemnt');
  binder.command('doLoad');
});
function loadpopenviroemnt(){
  var binder = zkbind.$('$popenviroemnt');
  binder.command('doLoadBean');

}
</script>	
</zk>