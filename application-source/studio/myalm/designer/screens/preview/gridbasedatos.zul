<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
			avatar - avatar
			Base de datos - Base de datos
			Patrón URL - Patrón URL
			Reverse - Reverse
			Cloud - Cloud
			Activo - Activo
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('DATABASE.label', 'Base de datos'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DATABASEAsc'])" sortDescending="@load(vm.comparators['DATABASEDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('URLPATERN.label', 'Patrón URL'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['URLPATERNAsc'])" sortDescending="@load(vm.comparators['URLPATERNDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('REVERSE.label', 'Reverse'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REVERSEAsc'])" sortDescending="@load(vm.comparators['REVERSEDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('CLOUD.label', 'Cloud'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CLOUDAsc'])" sortDescending="@load(vm.comparators['CLOUDDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ACTIVO.label', 'Activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterbasedatos.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							             <label  value="@load(item.database) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.urlpatern) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.reverse) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.cloud) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.activo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							
                  			
                  		<cell align="center">
						  
						<button
						onClick="@command('editData',item=item,page='masterbasedatos.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"   />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn btn-square btn-outline-danger m-2"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
 </div>						
</zk>						
