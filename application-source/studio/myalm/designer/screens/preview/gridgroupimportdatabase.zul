					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('NOMBRE.label', 'Referencia'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('DATABASE.label', 'DATABASE'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DATABASEAsc'])" sortDescending="@load(vm.comparators['DATABASEDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('URLJDBC.label', 'Url JDBC'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['URLJDBCAsc'])" sortDescending="@load(vm.comparators['URLJDBCDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('PROYECTOALM.label', 'PROYECTOALM'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROYECTOALMAsc'])" sortDescending="@load(vm.comparators['PROYECTOALMDesc'])"/>
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('NOMBRE').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('database').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('URLJDBC').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('proyectoalm').value) @converter(vm.fieldConverter)"></label>
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterimportdatabase.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
