<div id="sDvyAkKpkk"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="sDvyAkKpkk-card" class="card  default" style="overflow:auto;" >
       <div id="sDvyAkKpkk-body" class="card-body ">
        <div id="sDvyAkKpkk-row" class="form-group row ">

<h:div class="col-md-12 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqmarchitecture.label', 'Arquitectura'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idarqmarchitecture" placeholder="@load(vm.lang.getProperty('idarqmarchitecture').label,'Arquitectura')" model="@bind(vm.foreings['idarqmarchitecture'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarqmarchitecture',item=self.selectedItem.value,changefk='idarqsolucion',updatebean='true')"  		selectedItem="@load(vm.beanData.idarqmarchitecture)"  onCreate="@command('onCreateCombo',component=self,alias='idarqmarchitecture')" value="@bind(vm.beanData.idarqmarchitecture .arquitectura)@save(vm.beanData.idarqmarchitecture.arquitectura, before=('grabar')) @validator(vm.validator,required=true)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.arquitectura)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqmarchitecture'])"/>

  
</h:div>



<h:div class="col-md-12 ">
   <hbox spacing="3px" sclass="margin-field">
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqsolucion.label', 'Solución'))"/>
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idarqsolucion" placeholder="@load(vm.lang.getProperty('idarqsolucion').label,'Solución')" model="@bind(vm.foreings['idarqsolucion'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarqsolucion',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idarqsolucion)"  onCreate="@command('onCreateCombo',component=self,alias='idarqsolucion',loadFkFrom='idarqmarchitecture')" value="@bind(vm.beanData.idarqsolucion .solucion)@save(vm.beanData.idarqsolucion.solucion, before=('grabar')) @validator(vm.validator,required=true)" disabled="@bind(vm.beanData.idarqmarchitecture.idxarqmarchitecture eq null) " ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.solucion)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqsolucion'])"/>

  
</h:div>



   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCAMPLIA.label', ''))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="vDOiMZXTga" multiline="true" placeholder="@load(vm.lang.getProperty('DESCAMPLIA.label', ''))" value="@bind(vm.beanData.idarqsolucion.descamplia) @save(vm.beanData.idarqsolucion.descamplia, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('DESCAMPLIA'))" disabled="@load(vm.isEditable('DESCAMPLIA')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['vDOiMZXTga'])"/>
	     
</h:div>



