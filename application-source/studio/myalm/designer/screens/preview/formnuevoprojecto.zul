							<h:div class="card-body">
		     <div class="row">


<div id="rHUjjlVrGG"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="rHUjjlVrGG-card" class="card  default" style="overflow:auto;" >
       <div id="rHUjjlVrGG-body" class="card-body ">
        <div id="rHUjjlVrGG-row" class="form-group row ">


				

  <!-- sclass="margin-field" -->
     <h:div class="col-md-12 ">
    <hbox spacing="3px" visible="@load(vm.isVisible('ALMCODE'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('ALMCODE.label', 'Código'))"/>
	   </hbox>
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.almcode)"  />
    </h:div>






				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('UUID'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('UUID.label', 'UUID'))"  />
	   </hbox>
	    <textbox  readonly="true"  tabindex="2" id="545448" 
	   placeholder="@load(vm.lang.getProperty('UUID.label', 'uuid'))" 
	   value="@bind(vm.beanData.uuid) @save(vm.beanData.uuid, before=('grabar')) "  sclass="margin-field form-control  form-control border" 
	   visible="@load(vm.isVisible('UUID'))" disabled="@load(vm.isEditable('UUID')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['545448'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('PROYECTOALM'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROYECTOALM.label', 'Proyecto'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="BqSKSuUzQe" 
	   placeholder="@load(vm.lang.getProperty('PROYECTOALM.label', 'proyectoalm'))" 
	   value="@bind(vm.beanData.proyectoalm) @save(vm.beanData.proyectoalm, before=('grabar')) @validator(vm.unique, field='PROYECTOALM',required=true ,oldValue=vm.beanDataCpy.proyectoalm)"  sclass="margin-field form-control  form-control border border-danger" 
	   visible="@load(vm.isVisible('PROYECTOALM'))" disabled="@load(vm.isEditable('PROYECTOALM')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['BqSKSuUzQe'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('NAMESPACE'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))"  />
	   </hbox>
	    <textbox   tabindex="4" id="341366" 
	   placeholder="@load(vm.lang.getProperty('NAMESPACE.label', 'namespace'))" 
	   value="@bind(vm.beanData.namespace) @save(vm.beanData.namespace, before=('grabar')) @validator(vm.unique, field='NAMESPACE',required=true ,oldValue=vm.beanDataCpy.namespace)"  sclass="margin-field form-control  form-control border border-danger" 
	   visible="@load(vm.isVisible('NAMESPACE'))" disabled="@load(vm.isEditable('NAMESPACE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['341366'])"/>
	   
    </h:div>   





   <h:div class="col-md-12">
