<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tiposervicios" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='tiposervicios')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuptiposervicios" />
<custom-attributes clase="org.suinsit.apps.myalm.Almtiposervicio" />
	   <custom-attributes namespace="myalm" />
	   <custom-attributes enviroment="preview" />
	        <custom-attributes uid="88624" />
	   <custom-attributes tipo="MASTER" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="bYJNrWzDmg" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="false" >
<div id="bYJNrWzDmg-row" class="row">


				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('TIPO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="23954" 
	   placeholder="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))" 
	   value="@bind(vm.beanData.tipo) @save(vm.beanData.tipo, before=('grabar')) @validator(vm.unique, field='TIPO',required=true ,oldValue=vm.beanDataCpy.tipo)"  sclass="margin-field form-control  form-control border border-danger" 
	   visible="@load(vm.isVisible('TIPO'))" disabled="@load(vm.isEditable('TIPO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['23954'])"/>
	   
    </h:div>   





   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFORMACION.label', 'Información'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="xzvsZFlmfZ" multiline="true" placeholder="@load(vm.lang.getProperty('INFORMACION.label', 'Información'))" value="@bind(vm.beanData.informacion) @save(vm.beanData.informacion, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('INFORMACION'))" disabled="@load(vm.isEditable('INFORMACION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['xzvsZFlmfZ'])"/>
	     
</h:div>





				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('ACRONIMO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACRONIMO.label', 'Acronimo'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="325176" 
	   placeholder="@load(vm.lang.getProperty('ACRONIMO.label', 'Acronimo'))" 
	   value="@bind(vm.beanData.acronimo) @save(vm.beanData.acronimo, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.acronimo)"  sclass="margin-field form-control  form-control border border-danger" 
	   visible="@load(vm.isVisible('ACRONIMO'))" disabled="@load(vm.isEditable('ACRONIMO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['325176'])"/>
	   
    </h:div>   




</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['tiposervicios.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 




                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tiposervicios');
  binder.command('doLoad');
});
function loadtiposervicios(){
  var binder = zkbind.$('$tiposervicios');
  binder.command('doLoadBean');

}
</script>	
</zk>