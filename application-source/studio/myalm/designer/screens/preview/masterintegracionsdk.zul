<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Informacion" />      
                 <tab label="Pom" />      
                                <tab label="Documentos" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFORMACION.label', 'Documentacion'))"/>
	   </hbox>
	  <tbeditor id="mfhZEeHMoJ" value="@bind(vm.beanData.informacion) @save(vm.beanData.informacion, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">


				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('POM'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('POM.label', 'pom'))"  />
