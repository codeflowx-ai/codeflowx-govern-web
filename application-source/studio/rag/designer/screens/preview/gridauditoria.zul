<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FECHA.label', 'Fecha'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECHAAsc'])" sortDescending="@load(vm.comparators['FECHADesc'])"  visible="@load(vm.isVisible('FECHA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('IP.label', 'IP'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['IPAsc'])" sortDescending="@load(vm.comparators['IPDesc'])"  visible="@load(vm.isVisible('IP'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('TIPOACCION.label', 'Tipo Acción'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOACCIONAsc'])" sortDescending="@load(vm.comparators['TIPOACCIONDesc'])"  visible="@load(vm.isVisible('TIPOACCION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('USERAGENT.label', 'User Agent'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USERAGENTAsc'])" sortDescending="@load(vm.comparators['USERAGENTDesc'])"  visible="@load(vm.isVisible('USERAGENT'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('RAGPROYECTO.label', 'RAGPROYECTO'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;">
							             <label  value="@load(item.fecha) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.ip) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.tipoaccion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.useragent) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idragproyecto.projectname) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
