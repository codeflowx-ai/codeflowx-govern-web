<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="aplicacion" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='aplicacion')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupaplicacion" />
<custom-attributes clase="org.suinsit.apps.admin.Aplicacion" />
	   <custom-attributes namespace="admin" />
	   <custom-attributes enviroment="preview" />
	        <custom-attributes uid="74922" />
	   <custom-attributes tipo="MASTER" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="zobOUXIiZJ" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="zobOUXIiZJ-row" class="row">


				

    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('APLICACION'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('APLICACION.label', 'Aplicación'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="JdUZSCNHep" 
	   placeholder="@load(vm.lang.getProperty('APLICACION.label', 'Nombre descriptivo de la aplicación'))" 
	   value="@bind(vm.beanData.aplicacion) @save(vm.beanData.aplicacion, before=('grabar')) @validator(vm.unique, field='APLICACION',required=true ,oldValue=vm.beanDataCpy.aplicacion)"  sclass="margin-field form-control  form-control border border-danger" 
	   visible="@load(vm.isVisible('APLICACION'))" disabled="@load(vm.isEditable('APLICACION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['JdUZSCNHep'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('ICONCLASS'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('ICONCLASS.label', 'Icono'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="ThpgZbkUfy" 
	   placeholder="@load(vm.lang.getProperty('ICONCLASS.label', 'Icono'))" 
	   value="@bind(vm.beanData.iconclass) @save(vm.beanData.iconclass, before=('grabar')) "  sclass="margin-field form-control  form-control      " 
	   visible="@load(vm.isVisible('ICONCLASS'))" disabled="@load(vm.isEditable('ICONCLASS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['ThpgZbkUfy'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('NAMESPACE'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="595376" 
	   placeholder="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))" 
	   value="@bind(vm.beanData.namespace) @save(vm.beanData.namespace, before=('grabar')) "  sclass="margin-field form-control  form-control      " 
	   visible="@load(vm.isVisible('NAMESPACE'))" disabled="@load(vm.isEditable('NAMESPACE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['595376'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('PREFIJO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('PREFIJO.label', 'Prefijo'))"  />
	   </hbox>
	    <textbox   tabindex="4" id="915589" 
	   placeholder="@load(vm.lang.getProperty('PREFIJO.label', 'Prefijo'))" 
	   value="@bind(vm.beanData.prefijo) @save(vm.beanData.prefijo, before=('grabar')) "  sclass="margin-field form-control  form-control      " 
	   visible="@load(vm.isVisible('PREFIJO'))" disabled="@load(vm.isEditable('PREFIJO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['915589'])"/>
	   
    </h:div>   






				

    <h:div class="col-md-4 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('TITULO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('TITULO.label', 'Titulo / Menu'))"  />
	   </hbox>
	    <textbox   tabindex="5" id="wXjzfkShkC" 
	   placeholder="@load(vm.lang.getProperty('TITULO.label', 'Titulo / Menu'))" 
	   value="@bind(vm.beanData.titulo) @save(vm.beanData.titulo, before=('grabar')) "  sclass="margin-field form-control  form-control      " 
	   visible="@load(vm.isVisible('TITULO'))" disabled="@load(vm.isEditable('TITULO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['wXjzfkShkC'])"/>
	   
    </h:div>   





   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AYUDA.label', 'Ayuda'))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="SkSTrlkNyz" multiline="true" placeholder="@load(vm.lang.getProperty('AYUDA.label', 'Ninguno'))" value="@bind(vm.beanData.ayuda) @save(vm.beanData.ayuda, before=('grabar')) "  sclass="form-control  form-control border" visible="@load(vm.isVisible('AYUDA'))" disabled="@load(vm.isEditable('AYUDA')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['SkSTrlkNyz'])"/>
	     
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['aplicacion.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$aplicacion');
  binder.command('doLoad');
});
function loadaplicacion(){
  var binder = zkbind.$('$aplicacion');
  binder.command('doLoadBean');

}
</script>	
</zk>