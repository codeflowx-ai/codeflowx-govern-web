<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="modulos" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',env='preview',pagina='modulos')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="modulos" />
<custom-attributes clase="org.suinsit.apps.admin.Mmodulo" />
	   <custom-attributes namespace="admin" />
	   <custom-attributes enviroment="preview" />
	        <custom-attributes uid="12898" />
	   <custom-attributes tipo="MASTER" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="qHMSQxOsCg" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="qHMSQxOsCg-row" class="row">
</div>
</div>  
<div id="TysVSWftuz" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="TysVSWftuz-row" class="row">
</div>
</div>  
<div id="zffJkXDjwF" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="zffJkXDjwF-row" class="row">


				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('MODULO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style=" Font-Size:16px;" value="@load(vm.lang.getProperty('MODULO.label', 'Modulo'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="705252" 
	   placeholder="@load(vm.lang.getProperty('MODULO.label', 'Modulo'))" 
	   value="@bind(vm.beanData.modulo) @save(vm.beanData.modulo, before=('grabar')) @validator(vm.unique, field='MODULO',required=true ,oldValue=vm.beanDataCpy.modulo)"  sclass="margin-field form-control  form-control text-dark border-danger" 
	   visible="@load(vm.isVisible('MODULO'))" disabled="@load(vm.isEditable('MODULO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['705252'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('LABEL'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style=" Font-Size:16px;" value="@load(vm.lang.getProperty('LABEL.label', 'Eiqueta'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="nzPKymjKQd" 
	   placeholder="@load(vm.lang.getProperty('LABEL.label', 'Eiqueta'))" 
	   value="@bind(vm.beanData.label) @save(vm.beanData.label, before=('grabar')) "  sclass="margin-field form-control  form-control text-dark" 
	   visible="@load(vm.isVisible('LABEL'))" disabled="@load(vm.isEditable('LABEL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['nzPKymjKQd'])"/>
	   
    </h:div>   




</div>
</div>  
<div id="pwVokIAWhO" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="pwVokIAWhO-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" disabled="true">
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " disabled="false">
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" disabled="true">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['Modulos.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 

                  
                 

                  
                 



                  
                 

                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$modulos');
  binder.command('doLoad');
});
function loadmodulos(){
  var binder = zkbind.$('$modulos');
  binder.command('doLoadBean');

}
</script>	
</zk>