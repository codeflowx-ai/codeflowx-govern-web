<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="templates" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='templates')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="templates" />
	<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqtemplateview" />
	   <custom-attributes namespace="arquitecturas" />
	    <custom-attributes enviroment="preview" />
	     <custom-attributes uid="29667" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
			<div class="row">
			<div class="col-12">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
					<fragment
						exps="@load(vm.lang.getProperty('templates.screen', 'templates'))">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu} 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								templates
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
			<div class="row">
					<div class="col-lg-12">
				<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							<button onClick="@command('toSearch')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Volver
									</button>	
							</div>
							<div class="flex-shrink-0">
							<div class="hstack text-nowrap gap-2">
							       <button
									iconSclass="mdi mdi-alpha-h-circle-outline me-1 align-bottom"
									  class="btn btn-light add-btn" 
									 onClick="WIN_HELP.setVisible(true)">
									 Ayuda
								</button>
								
								    <button class="btn btn-secondary"
										iconSclass="fa-duotone fa-paintbrush-fine" onClick="@command('clear')">
										Limpiar
									</button>
									<button class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='continuar')">
										Guardar
									</button>
									<button
										class="btn" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" onClick="@command('grabar',action='nuevo')">
										Guardar y Nuevo
									</button>
								
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<h:div class="col-lg-12">
						<h:div >
							<h:div >
		     <div class="row">


<div id="VxgcGymoKa"   visible="true"  class="col-lg-8 col-xlg-8 col-md-8">
  <div id="VxgcGymoKa-card" class="card  shadow-xl" style="overflow:auto;" >
       <div id="VxgcGymoKa-body" class="card-body ">
        <div id="VxgcGymoKa-row" class="form-group row ">


				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('NOMBRE'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Plantilla'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="JEydNhxVRG" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['JEydNhxVRG'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('VERSION'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VERSION.label', 'Version'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="612337" 
	   placeholder="@load(vm.lang.getProperty('VERSION.label', 'version'))" 
	   value="@bind(vm.beanData.version) @save(vm.beanData.version, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('VERSION'))" disabled="@load(vm.isEditable('VERSION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['612337'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('XMLNAME'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('XMLNAME.label', 'XmlName'))"  />
	   </hbox>
	   <textbox   tabindex="3" id="86164" 
	   placeholder="@load(vm.lang.getProperty('XMLNAME.label', 'xmlname'))" 
	   value="@bind(vm.beanData.xmlname) @save(vm.beanData.xmlname, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('XMLNAME'))" disabled="@load(vm.isEditable('XMLNAME')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['86164'])"/>
	   
    </h:div>   






 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('POPUP'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('POPUP.label', 'Es Popup'))"/>
	   </hbox>
 <checkbox mold="default" id="HeDWrBrKVf" value="@bind(vm.beanData.popup) @save(vm.beanData.popup, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('POPUP'))" disabled="@load(vm.isEditable('POPUP')?false:true)" checked="@bind(vm.beanData.popup) @save(vm.beanData.popup, before=('grabar'))"/>
</h:div>






<h:div class="col-md-4 border-field">

   <hbox spacing="3px">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('SCOPE.label', 'Ambito'))"/>
 </hbox>

 <combobox mold="rounded" sclass="" id="SCOPE" model="@load(vm.getEnums('SCOPE'))" 
selectedItem="@load(vm.beanData.scope)"  value="@load(vm.beanData.scope) @save(vm.beanData.scope, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['SCOPE'])"/>
</h:div>





 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('CREATETABLE'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CREATETABLE.label', 'Puede Crear Tablas'))"/>
	   </hbox>
 <checkbox mold="default" id="GvkqjAjaYX" value="@bind(vm.beanData.createtable) @save(vm.beanData.createtable, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('CREATETABLE'))" disabled="@load(vm.isEditable('CREATETABLE')?false:true)" checked="@bind(vm.beanData.createtable) @save(vm.beanData.createtable, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('MULTIPLEDATA'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MULTIPLEDATA.label', 'Multiples Tablas/Vistas'))"/>
	   </hbox>
 <checkbox mold="default" id="RAhVjridEb" value="@bind(vm.beanData.multipledata) @save(vm.beanData.multipledata, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('MULTIPLEDATA'))" disabled="@load(vm.isEditable('MULTIPLEDATA')?false:true)" checked="@bind(vm.beanData.multipledata) @save(vm.beanData.multipledata, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('DATAMODEL'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DATAMODEL.label', 'DataModel'))"/>
	   </hbox>
 <checkbox mold="default" id="864110" value="@bind(vm.beanData.datamodel) @save(vm.beanData.datamodel, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('DATAMODEL'))" disabled="@load(vm.isEditable('DATAMODEL')?false:true)" checked="@bind(vm.beanData.datamodel) @save(vm.beanData.datamodel, before=('grabar'))"/>
</h:div>






<h:div class="col-md-4 border-field">

   <hbox spacing="3px">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('MODEL.label', 'Model'))"/>
 </hbox>

 <combobox mold="rounded" sclass="" id="MODEL" model="@load(vm.getEnums('MODEL'))" 
selectedItem="@load(vm.beanData.model)"  value="@load(vm.beanData.model) @save(vm.beanData.model, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['MODEL'])"/>
</h:div>




<h:div class="col-md-4 border-field">
   <hbox spacing="3px" sclass="margin-field">
    <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqmarchitecture.label', 'Arquitectura'))"/>
 	 <a	iconSclass="mdi mdi-information-outline" popup="pop_vrXaaKTYSt" />
   </hbox>
<combobox mold="rounded" autodrop="true"  id="idarqmarchitecture" placeholder="@load(vm.lang.getProperty('idarqmarchitecture').label,'Arquitectura')" model="@bind(vm.foreings['idarqmarchitecture'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idarqmarchitecture',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idarqmarchitecture)"  onCreate="@command('onCreateCombo',component=self,alias='idarqmarchitecture')" value="@bind(vm.beanData.idarqmarchitecture .arquitectura)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.arquitectura)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqmarchitecture'])"/>
   <popup id="pop_vrXaaKTYSt" width="200px">
	  <vbox>  
     <fragment exps="@load(vm.lang.getProperty('idarqmarchitecture.helptext', 'idarqmarchitecture'))" >
	 
	    	<![CDATA[
<span textContent='@load(exps)'></span>
	    	  	]]>        
	  </fragment></vbox>
  </popup>
</h:div>



   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción Asistente'))"/>
	   </hbox>
	  <tbeditor id="bmNPTrASrH" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="mKoZUATvwM"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="mKoZUATvwM-card" class="card  shadow-xl" style="overflow:auto;" >
       <div id="mKoZUATvwM-body" class="card-body ">
        <div id="mKoZUATvwM-row" class="form-group row ">

<h:div class="col-md-12">
<hbox spacing="3px">
	    <label value="@load(vm.lang['AVATAR.label'])"/>
</hbox>

      <h:div class="image-cropper-container" style="width:100%;  height:100%;" >
     <image id="AVATAR" sclass="image-download" content="@load(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        






<div id="RhBNZSXwwL" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="RhBNZSXwwL-row" class="row">
</div>
</div>  


             </div>      
            </h:div>
            
           </h:div>
          </h:div>
         </div>   
            <fragment exps="@load(vm.lang['templates.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>

                 












                  
                 


                  
                 

                  
<window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
                               <html content="@load(vm.helpBean.texto)"/>
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script type="text/javascript" >
zk.afterMount(function() {
 var binder = zkbind.$('$templates');
  binder.command('doLoad');
});
</script>
</zk>