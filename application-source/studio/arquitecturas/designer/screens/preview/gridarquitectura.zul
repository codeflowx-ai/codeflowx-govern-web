<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
			avatar - avatar
			Arquitectura - Arquitectura
			Código - Código
			Descripción Corta - Descripción Corta
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ARQUITECTURA.label', 'Arquitectura'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ARQUITECTURAAsc'])" sortDescending="@load(vm.comparators['ARQUITECTURADesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('CODE.label', 'Código'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODEAsc'])" sortDescending="@load(vm.comparators['CODEDesc'])"/>
						
							
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('DESCSHORT.label', 'Descripción Corta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCSHORTAsc'])" sortDescending="@load(vm.comparators['DESCSHORTDesc'])"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterarquitectura.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							             <label  value="@load(item.arquitectura) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.code) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.descshort) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							
                  			
                  		<cell align="center">
						  
						<button
						onClick="@command('editData',item=item,page='masterarquitectura.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"   />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn btn-square btn-outline-danger m-2"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
 </div>						
</zk>						
