<combobox mold="rounded" autodrop="true"  id="idalmscm" placeholder="@load(vm.lang.getProperty('idalmscm').label,'Servidor Git')" model="@bind(vm.foreings['idalmscm'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idalmscm',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idalmscm)"  onCreate="@command('onCreateCombo',component=self,alias='idalmscm')" value="@bind(vm.beanData.idalmscm .scm)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.scm)" /></template></combobox>
