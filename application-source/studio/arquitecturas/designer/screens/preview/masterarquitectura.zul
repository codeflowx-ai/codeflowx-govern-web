	   </hbox>
   <decimalbox   tabindex="12" id="945487" onCreate="" placeholder="@load(vm.lang.getProperty('LICENCIA.label', 'licencia'))"   
    value="@bind(vm.beanData.licencia) @save(vm.beanData.licencia, before=('grabar')) @validator(vm.validator,max=9999999 ,min=0 ,oldValue=vm.beanDataCpy.licencia)"  format="###,###,###,###,##0.00€"  sclass="margin-field form-control  form-control border" visible="@load(vm.isVisible('LICENCIA'))" disabled="@load(vm.isEditable('LICENCIA')?false:true)" onChange="@command('onChangeInput',field='LICENCIA',evento=event,componente=self,calculate=true)"/>
