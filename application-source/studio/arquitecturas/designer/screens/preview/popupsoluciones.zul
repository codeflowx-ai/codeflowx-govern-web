 onClick="@command('onChangeFindTextForeing',alias='idpartner',att='partner',event=event,idcp='cbhvgVtcohQu')" onChange="@command('onChangeFindTextForeing',alias='idpartner',att='partner',event=event,idcp='cbhvgVtcohQu')"  sclass="form-control  bg-light border-0" />
<combobox id="cbhvgVtcohQu" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idpartner'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='false',alias='idpartner',hidde=self)" width="85%">
