<div class="col-md-6">
 <h:div class="col-md-6">
 <label sclass="form-label font-weight-normal align-text-middle" style="" value="Aplicaciones/Modulos Inlcuidos"  />
   
    </h:div>
   

<listbox  checkmark="true"  model="@load(vm.foreings['idarqaplicacion'])" height="300px" onCreate="@command('onSubtableCreate',alias='subarqrsolapp',loadOnDemand='true')" ><listhead><listheader label="Aplicacion"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.aplicacion)"></listcell></listitem></template></listbox>
</div>


