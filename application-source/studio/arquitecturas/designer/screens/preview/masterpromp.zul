<idspace  id="promp" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='promp')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="promp" />
	<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqmpromp" />
	   <custom-attributes namespace="arquitecturas" />
	   <custom-attributes enviroment="preview" />
		<custom-attributes uid="27681" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('promp.screen', 'Gestión de prompt'))">
