		onClick="@command('appendSubtable',alias='subarqrprompflow',body='body_WEmgQQPHBQ',namespace='arquitecturas',page='popupflowprompt.zul',close='btn_WEmgQQPHBQ',win=WIN_WEmgQQPHBQ)" 
