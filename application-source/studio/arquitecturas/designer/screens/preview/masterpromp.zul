<listbox  checkmark="true"  model="@load(vm.foreings['idarqmarchitecture'])" height="300px" onCreate="@command('onSubtableCreate',alias='subarqrarqprompt',loadOnDemand='true')" ><listhead><listheader label="Arquitectura"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.arquitectura)"></listcell></listitem></template></listbox>
