               <cell align="center">
             <a 
						onClick="@command('editSubtable',alias='subarqrprompflow',body='body_WEmgQQPHBQ',namespace='arquitecturas',page='popupflowprompt.zul',close='btn_WEmgQQPHBQ',item=item,win=WIN_WEmgQQPHBQ)"
