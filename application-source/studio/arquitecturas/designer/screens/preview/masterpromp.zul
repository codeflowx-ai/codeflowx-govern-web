    <div class="col-md-3  input-group" visible="@load(vm.isVisible('NOMBRE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))"  />
	   
	    <textbox   tabindex="1" id="358423" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) @validator(vm.unique, field='NOMBRE',required=true ,oldValue=vm.beanDataCpy.nombre)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['358423'])"/>
            
	   
    </div>   






 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('ACTIVE'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACTIVE.label', 'Activo'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="oclBVuzdAs" value="@bind(vm.beanData.active) @save(vm.beanData.active, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('ACTIVE'))" disabled="@load(vm.isEditable('ACTIVE')?false:true)" checked="@bind(vm.beanData.active) @save(vm.beanData.active, before=('grabar'))"/>
             </div>	      
	     
 
</div>




<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqtipoprompt.label', 'Tipo Prompt'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idarqtipoprompt" placeholder="@load(vm.lang.getProperty('idarqtipoprompt').label,'Tipo Prompt')" model="@bind(vm.foreings['idarqtipoprompt'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarqtipoprompt',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idarqtipoprompt)"  onCreate="@command('onCreateCombo',component=self,alias='idarqtipoprompt')" value="@bind(vm.beanData.idarqtipoprompt .tipo)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.tipo)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqtipoprompt'])"/>

  
</h:div>



<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqmexecpromp.label', 'Ejecución prompt'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idarqmexecpromp" placeholder="@load(vm.lang.getProperty('idarqmexecpromp').label,'Ejecución prompt')" model="@bind(vm.foreings['idarqmexecpromp'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarqmexecpromp',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idarqmexecpromp)"  onCreate="@command('onCreateCombo',component=self,alias='idarqmexecpromp')" value="@bind(vm.beanData.idarqmexecpromp .servicio)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(c:cat3(item.servicio,' ',item.acronimo))" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqmexecpromp'])"/>

  
</h:div>



<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslprovider.label', 'Proveedor'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslprovider" placeholder="@load(vm.lang.getProperty('idslprovider').label,'Proveedor')" model="@bind(vm.foreings['idslprovider'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslprovider',item=self.selectedItem.value,changefk='idslesmodel',updatebean='true')"  		selectedItem="@load(vm.beanData.idslprovider)"  onCreate="@command('onCreateCombo',component=self,alias='idslprovider')" value="@bind(vm.beanData.idslprovider .provider)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.provider)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslprovider'])"/>

  
</h:div>



<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslesmodel.label', 'Modelo'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslesmodel" placeholder="@load(vm.lang.getProperty('idslesmodel').label,'Modelo')" model="@bind(vm.foreings['idslesmodel'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslesmodel',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslesmodel)"  onCreate="@command('onCreateCombo',component=self,alias='idslesmodel',loadFkFrom='idslprovider')" value="@bind(vm.beanData.idslesmodel .model)" disabled="@bind(vm.beanData.idslprovider.idxslprovider eq null) " ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.model)" /></template></combobox>
