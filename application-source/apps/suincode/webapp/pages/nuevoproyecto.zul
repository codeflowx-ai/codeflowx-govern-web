																	visible="@load(vm.isVisible('ACRONIMO'))"
																	disabled="@load(vm.isEditable('ACRONIMO')?false:true)" />
																<label
																	sclass="text-danger" value="@load(vmsgs['901768'])" />

															</h:div>




														</h:div>
													</h:div>
												</h:div>
											</h:div>


										</div>
									</div>
								</div>
							</div>









							<div id="xDuHsKaUAC" visible="true"
								class="col-lg-4 col-xlg-4 col-md-4">
								<div id="xDuHsKaUAC-card" class="card "
									style="overflow:auto;">
									<div id="xDuHsKaUAC-body"
										class="card-body ">
										<div id="xDuHsKaUAC-row"
											class="form-group row ">





											<h:div
												class=" col-lg-12 col-xlg-12 col-md-12">
												<h:div class="card "
													style="overflow:auto;">
													<h:div
														class="card-header  bg-primary text-white" style="">
														<h:h3
															class="card-title mb-0 text-white">
															Arquitectura
															/ Servidores
														</h:h3>
													</h:div>
													<h:div
														class="card-body">
														<h:div
															class="form-group row">

															<h:div
																class="col-md-6 ">
																<hbox
																	spacing="3px" sclass="margin-field">

																	<label
																		sclass="text  form-label text-capitalize font-weight-normal"
																		style=""
																		value="@load(vm.lang.getProperty('idarqmarchitecture.label', 'Arquitectura'))" />
																</hbox>
																<combobox
																	mold="rounded" autodrop="true" id="idarqmarchitecture"
																	placeholder="@load(vm.lang.getProperty('idarqmarchitecture').label,'Arquitectura')"
																	model="@bind(vm.foreings['idarqmarchitecture'])"
																	buttonVisible="true"
																	onSelect="@command('onSelectForeing', alias='idarqmarchitecture',item=self.selectedItem.value,changefk='idarqsolucion',updatebean='true')"
																	selectedItem="@load(vm.beanData.idarqmarchitecture)"
																	onCreate="@command('onCreateCombo',component=self,alias='idarqmarchitecture')"
																	value="@bind(vm.beanData.idarqmarchitecture .arquitectura)@save(vm.beanData.idarqmarchitecture.arquitectura, before=('grabar')) @validator(vm.validator,required=true)">
																	<template
																		name="model" var="item">
																		<comboitem
																			value="@load(item)" label="@load(item.arquitectura)" />
																	</template>
																</combobox>
																<label
																	sclass="text-danger"
																	value="@load(vmsgs['idarqmarchitecture'])" />


															</h:div>



															<h:div
																class="col-md-6 ">
																<hbox
																	spacing="3px" sclass="margin-field">

																	<label
																		sclass="text  form-label text-capitalize font-weight-normal"
																		style=""
																		value="@load(vm.lang.getProperty('idarqsolucion.label', 'Solución'))" />
																</hbox>
																<combobox
																	mold="rounded" autodrop="true" id="idarqsolucion"
																	placeholder="@load(vm.lang.getProperty('idarqsolucion').label,'Solución')"
																	model="@bind(vm.foreings['idarqsolucion'])"
																	buttonVisible="true"
																	onSelect="@command('onSelectForeing', alias='idarqsolucion',item=self.selectedItem.value,updatebean='true')"
																	selectedItem="@load(vm.beanData.idarqsolucion)"
																	onCreate="@command('onCreateCombo',component=self,alias='idarqsolucion',loadFkFrom='idarqmarchitecture')"
																	value="@bind(vm.beanData.idarqsolucion .solucion)@save(vm.beanData.idarqsolucion.solucion, before=('grabar')) @validator(vm.validator,required=true)"
																	disabled="@bind(vm.beanData.idarqmarchitecture.idxarqmarchitecture eq null) ">
																	<template
																		name="model" var="item">
																		<comboitem
																			value="@load(item)" label="@load(item.solucion)" />
																	</template>
																</combobox>
																<label
																	sclass="text-danger"
																	value="@load(vmsgs['idarqsolucion'])" />


															</h:div>



															<div
																class="col-md-12">
																<h:div
																	class="col-md-6">
																	<label
																		sclass="text  form-label text-capitalize font-weight-normal"
																		style="" value="Servidor Git" />

																</h:div>


																<listbox
																	checkmark="true" model="@load(vm.foreings['idalmscm'])"
																	height="100px"
																	onCreate="@command('onSubtableCreate',alias='subalmrprojscm',loadOnDemand='true')">
																	<listhead>
																		<listheader
																			label="Scm">
																		</listheader>
																	</listhead>
																	<template
																		name="model" var="item">
																		<listitem
																			value="@load(item)">
																			<listcell
																				label="@load(item.scm)">
																			</listcell>
																		</listitem>
																	</template>
																</listbox>
															</div>



															<div
																class="col-md-12">
																<h:div
																	class="col-md-6">
																	<label
																		sclass="text  form-label text-capitalize font-weight-normal"
																		style="" value="Cluster" />

																</h:div>


																<listbox
																	checkmark="true"
																	model="@load(vm.foreings['idatlkubecloud'])"
																	height="100px"
																	onCreate="@command('onSubtableCreate',alias='subalmrclusters',loadOnDemand='true')">
																	<listhead>
																		<listheader
																			label="Cluster">
																		</listheader>
																	</listhead>
																	<template
																		name="model" var="item">
																		<listitem
																			value="@load(item)">
																			<listcell
																				label="@load(item.cluster)">
																			</listcell>
																		</listitem>
																	</template>
																</listbox>
															</div>


														</h:div>
													</h:div>
												</h:div>
											</h:div>


										</div>
									</div>
								</div>
							</div>










							<div id="SLtemjFrvc" style="overflow:auto;"
								class=" col-lg-12 col-xlg-12 col-md-12" visible="true">
								<div id="SLtemjFrvc-row" class="row">

									<tabbox orient="top"
										mold="default">
										<tabs>
											<tab label="Comentarios" />
											<tab label="Documentos" />
										</tabs>
										<tabpanels>
											<tabpanel>
												<div class="row">

													<h:div
														class="col-md-12">
														<hbox
															spacing="3px">
															<label
																sclass="form-label font-weight-normal align-text-middle"
																style=""
																value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))" />
														</hbox>
														<tbeditor
															id="OtUQXChDFf"
															value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
													</h:div>



												</div>
											</tabpanel>
											<tabpanel>
												<div class="row">

													<idspace id="dms"
														viewModel="@id('dms') @init('com.suinsit.office.documents.DmsEmbedUI',vm=vm)">
														<div
															class="card">
															<div
																class="card-header">
																<div
																	class="d-flex align-items-center flex-wrap gap-2">

																	<div
																		class="flex-grow-1">
																		<button
																			iconSclass="ri-add-fill me-1 align-bottom"
																			class="btn add-btn" d:data-bs-toggle="modal"
																			d:data-bs-target="#showModalchkPygkOFB"
																			onClick="@command('addPopup',body=body_misdocumentoschkPygkOFB,page='popupdocumento.zul',close='close-modalchkPygkOFB')">
																			Documento
																		</button>

																	</div>
																	<div
																		class="flex-shrink-0">
																		<div
																			class="hstack text-nowrap gap-2">

																		</div>
																	</div>
																</div>
															</div>
														</div>

														<div
															class="table-responsive ">
															<h:table
																class="invoice-table table table--borderless table-nowrap mb-0">
																<h:thead
																	class="table-light">
																	<h:tr>
																		<h:th
																			scope="col" class="text-center"
																			style="width:30px;">
																			#
																		</h:th>
																		<h:th
																			scope="col" class="text-center">
																			<label
																				value="Catalogo"
																				sclass="text-capitalize font-weight-bold" />
																		</h:th>
																		<h:th
																			scope="col" class="text-center">
																			<label
																				value="Tipo"
																				sclass="text-capitalize font-weight-bold" />
																		</h:th>
																		<h:th
																			scope="col" class="text-center">
																			<label
																				value="Documento"
																				sclass="text-capitalize font-weight-bold" />
																		</h:th>
																		<h:th
																			scope="col" class="text-center"
																			style="width:120px;">
																			<label
																				value="Propietario"
																				sclass="text-capitalize font-weight-bold" />
																		</h:th>
																		<h:th
																			scope="col" class="text-center"
																			style="width:120px;">
																			<label
																				value="Fecha" />
																		</h:th>
																		<h:th
																			scope="col" class="text-center"
																			style="width:120px;">
																		</h:th>
																		<h:th></h:th>
																	</h:tr>
																</h:thead>
																<h:tbody>
																	<forEach
																		items="@bind(dms.documents)" var="item"
																		varStatus="status">

																		<h:tr>
																			<h:th
																				class="product-id">
																				${status.index+1}
																			</h:th>
																			<h:td
																				class="text-center">
																				<label
																					value="@load(item.iddoccatalogo.catalogo)" />
																			</h:td>
																			<h:td
																				class="text-center">
																				<label
																					value="@load(item.iddoctipodocum.tipodocumento)" />
																			</h:td>
																			<h:td
																				class="text-center">
																				<choose>
																					<when
																						test="@load(item.tipomime eq 'application/pdf')">
																						<a
																							iconSclass="fa-duotone fa-file-pdf"
																							label="@load(item.documento) @converter(dms.fieldConverter)"
																							onClick="@command('onDownload',item=item)">
																						</a>
																					</when>
																					<when
																						test="@load(item.tipomime eq 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')">
																						<a
																							iconSclass="las la-file-word"
																							label="@load(item.documento) @converter(dms.fieldConverter)"
																							onClick="@command('onDownload',item=item)">
																						</a>
																					</when>
																					<when
																						test="@load(item.tipomime eq 'application/vnd.ms-excel')">
																						<a
																							iconSclass="las la-file-excel"
																							label="@load(item.documento) @converter(dms.fieldConverter)"
																							onClick="@command('onDownload',item=item)">
																						</a>
																					</when>
																					<when
																						test="@load(item.tipomime eq 'application/vnd.openxmlformats-officedocument.presentationml.presentation')">
																						<a
																							iconSclass="las la-file-powerpoint"
																							label="@load(item.documento) @converter(dms.fieldConverter)"
																							onClick="@command('onDownload',item=item)">
																						</a>
																					</when>
																					<otherwise>
																						<a
																							iconSclass="las la-file-archive"
																							label="@load(item.documento) @converter(dms.fieldConverter)"
																							onClick="@command('onDownload',item=item)">
																						</a>
																					</otherwise>
																				</choose>
																			</h:td>
																			<h:td
																				class="text-center">
																				<label
																					value="@load(item.idpropietario.usuario)">
																				</label>
																			</h:td>
																			<h:td
																				class="text-center">
																				<label
																					value="@load(item.alta) @converter(dms.fieldConverter)">
																				</label>
																			</h:td>
																			<h:td
																				class="text-center">
																				<div
																					class="hstack gap-3 fs-15">
																					<a
																						tooltiptext="descargar"
																						onClick="@command('onDownload',item=item)">
																						<h:i
																							class="ri-download-2-line">
																						</h:i>
																					</a>
																					<a
																						tooltiptext="Crear Enlace">
																						<h:i
																							class="ri-link">
																						</h:i>
																					</a>
																					<a
																						tooltiptext="Borrar"
																						onClick="@command('onDeleteFile',item=item)"
																						visible="@load(dms.removeDoc(item))">
																						<h:i
																							class="ri-delete-bin-line">
																						</h:i>
																					</a>
																				</div>
																			</h:td>
																		</h:tr>
																	</forEach>
																</h:tbody>
																<h:tbody>
																	<h:tr>
																		<h:td
																			colspan="6">
																			<paging
																				id="topagin" pageSize="@load(dms.scroll.maxRows)"
																				totalSize="@load(dms.scroll.totalRows)" mold="os"
																				style="background-color:#FFF;">
																			</paging>
																		</h:td>
																		<h:td
																			colspan="2">
																			<combobox
																				selectedItem="@bind(dms.scroll.maxRows)"
																				value="@bind(dms.scroll.maxRows)" width="75px">
																				<comboitem
																					label="30" value="30" />
																				<comboitem
																					label="50" value="50" />
																				<comboitem
																					label="100" value="100" />
																			</combobox>
																		</h:td>
																	</h:tr>
																</h:tbody>
																<h:tfoot
																	class="table-light">
																	<h:tr>
																		<h:td
																			colspan="8">
																			<label
																				value="@load(dms.labelTotal)">
																			</label>
																		</h:td>
																	</h:tr>
																</h:tfoot>
															</h:table>
														</div>
														<h:div
															class="modal fade" id="showModalchkPygkOFB" tabindex="-1"
															aria-labelledby="exampleModalLabel" aria-hidden="true">
															<div
																class="modal-dialog modal-dialog-centered modal-lg">
																<div
																	class="modal-content border-0">
																	<div
																		class="modal-header bg-soft-info p-3">
																		<h:h5
																			class="modal-title"
																			id="exampleModalLabelchkPygkOFB">
																			Documentos
																		</h:h5>
																		<h:button
																			type="button" class="btn-close"
																			data-bs-dismiss="modal" aria-label="Close"
																			id="close-modalchkPygkOFB">
																		</h:button>
																	</div>
																	<div
																		class="modal-body"
																		id="body_misdocumentoschkPygkOFB">
																	</div>

																</div>
															</div>
														</h:div>
													</idspace>



												</div>
											</tabpanel>
										</tabpanels>
									</tabbox>



								</div>
							</div>


						</div>
					</h:div>

				</h:div>
			</h:div>
		</div>
		<fragment exps="@load(vm.lang['nuevoprojecto.screen'])">
			
			<![CDATA[ <div id="modal_iconified" class="modal fade"
			tabindex="-1" style="z-index: 99999;"> <div
			class="modal-dialog"> <div class="modal-content"> <div
			class="modal-header"> <h5 class="modal-title"><span
			textContent='@load(exps)'></span></h5> </div> <div
			class="modal-body"> <h6 class="font-weight-semibold"><i
			class="icon-law mr-2"></i>Texto de ayuda pantalla</h6> <span
			textContent='@load(exps)'></span> </div> <div
			class="modal-footer"> <button class="btn btn-link"
			data-dismiss="modal"><i class="icon-cross2 font-size-base
			mr-1"></i> Close</button> </div> </div> </div> </div> ]]>
			
				</fragment>



































		<window id="WIN_HELP" mode="modal" visible="false"
			position="center,center" action="show: slideDown;hide: slideUp"
			sclass="z-messagebox-window" border="none" width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">Ayuda</h:h5>
				</div>
				<div class="modal-body"></div>
				<div class="modal-footer">
					<div class="hstack gap-2 justify-content-end">
						<button onClick="WIN_HELP.setVisible(false)"
							class="btn btn-light">
							Cerrar
						</button>
					</div>
				</div>
			</div>
		</window>
	</idspace>
	<script type="text/javascript">
		zk.afterMount(function() { var binder =
		zkbind.$('$nuevoprojecto'); binder.command('doLoad'); });
	</script>
</zk>