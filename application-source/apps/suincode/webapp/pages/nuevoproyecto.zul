																			d:data-bs-target="#viewwrobNMOmJy"
																			onClick="@command('editForeing',win=WIN_wrobNMOmJy,alias='idcrmempresa',body='body_wrobNMOmJy',page='popuppopempresas.zul',close='btn_wrobNMOmJy')">
																		</button>
																		<window
																			id="WIN_wrobNMOmJy" mode="modal" visible="false"
																			position="center,center"
																			action="show: slideDown;hide: slideUp"
																			sclass="z-messagebox-window" border="none"
																			width="80%">
																			<div
																				class="modal-content border-0">
																				<div
																					class="modal-header bg-soft-info p-3">
																					<h:h5
																						class="modal-title">
																						Editar
