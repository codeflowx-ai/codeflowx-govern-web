																				<div
																					sclass="mb-2">
																					<textbox
																						sclass="form-control  bg-light border-0"
																						placeholder="introduzca criterios..."
																						onOK="@command('onChangeFindForeing',alias='idcrmempresa',att='empresa,',input=self)"
																						onChange="@command('onChangeFindForeing',alias='idcrmempresa',att='empresa,',event=event)" />
																				</div>
																				<div
																					sclass="mb-2">
																					<listbox
																						height="400px" mold="paging" pageSize="20"
																						pagingPosition="bottom"
																						model="@bind(vm.foreings['idcrmempresa'])"
																						onSelect="@command('onSelectForeingPopup', alias='idcrmempresa',item=self.selectedItem.value,hidde=searchwrobNMOmJy,updatebean='true' )">
																						<listhead>
																							<listheader
																								label="@load(vm.lang.getProperty('EMPRESA.label','Empresa'))" />
																						</listhead>
																						<template
																							name="model" var="item">
																							<listitem
																								value="@load(item)">
																								<listcell
																									label="@load(item.empresa)" />
																							</listitem>
																						</template>
																					</listbox>
																				</div>
																			</div>
																		</div>
																	</div>
																</window>



