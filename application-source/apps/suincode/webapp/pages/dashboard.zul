									<rows>
										<row>
											<hlayout class="card-modelos">
												<image
													src="img/news/semantic.png" class="img-bdr" width="50px"
													height="50px" />
												<vlayout spacing="5px">
													<label
														class="modelos-ttl">
														Título Card
													</label>
													<label
														class="modelos-txt">
														Por Autor
