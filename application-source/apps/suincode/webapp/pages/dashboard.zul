														Título Card
													</label>
													<label
														class="modelos-txt">
														Por Autor
													</label>
												</vlayout>
											</hlayout>
											<hlayout class="card-modelos">
												<image src="img/news/api.png"
													class="img-bdr" width="50px" height="50px" />
												<vlayout spacing="5px">
													<label
														class="modelos-ttl">
														Título Card
													</label>
													<label
														class="modelos-txt">
														Por Autor
													</label>
												</vlayout>
											</hlayout>
											<hlayout class="card-modelos">
												<image src="/img/bot.png"
