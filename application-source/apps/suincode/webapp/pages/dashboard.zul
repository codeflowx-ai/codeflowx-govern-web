														Título Card
													</label>
													<label
														class="modelos-txt">
														Por Autor
													</label>
												</vlayout>
											</hlayout>
										</row>
									</rows>
								</grid>
							</vlayout>
						</hlayout>
					</div>

				</div>
				<div class="col-4 mb-4">
