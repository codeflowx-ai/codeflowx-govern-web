
<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace viewModel="@id('vm') @init('org.suinsit.nocode.web.FindEntityUI')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="potenciales" />
	   
	<custom-attributes clase="org.suinsit.apps.marketing.Mktpotenciales" />
	   <custom-attributes namespace="marketing" />
	   <custom-attributes uid="8628" />
	   <custom-attributes tipo="SEARCH" />
	  <custom-attributes paginaIndex="indexpotenciales.zul" />
	   <custom-attributes templateView="gridpotenciales.zul" />
	   <h:div id="notificacion"></h:div>
	   
	   <div class="row  }" style="background-color:;">
			<div class="col-12   " style="">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
					<fragment
						exps="@load(vm.lang.getProperty('potenciales.screen', 'potenciales'))">
						<![CDATA[ <h4 class="mb-sm-0"
						textContent='@load(exps)'></h4> ]]>
					</fragment>
					    <label value="@load(vm.labelTotal)"></label>
					 </vbox>   
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu} 
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								potenciales
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
		 <div class="row">
			<div class="col-lg-12">
				<div class="card   " style="background-color:;">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							
							 <button
									iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
									  class="btn  btn-outline-primary" 
									 onClick="@command('addData',page='masterpotenciales.zul')">
										potenciales
								</button>
								</div>
							<div class="flex-shrink-0">
								<div class="hstack text-nowrap gap-2">
								<button
										class="btn btn-soft-info waves effect waves-light"
										iconSclass="fa-duotone fa-filters me-1 align-bottom"
										tooltiptext="Filtros"
										onClick="@command('onFilter', win=WIN_FILTERS)">
									</button> 

								
							   		
									<button iconSclass="fa-duotone fa-file-export"
										type="button" id="dropdownMenuLink1"
										d:data-bs-toggle="dropdown" d:aria-expanded="false"
										class="btn btn-soft-dark waves effect waves-light" >
									</button>
	
									<h:ul class="dropdown-menu"	aria-labelledby="dropdownMenuLink1">
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-file-pdf "
												onClick="@command('report',type='pdf')">
												Pdf
											</a>
										</h:li>
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-file-xls "
												onClick="@command('report',type='excel')">
												Excel
											</a>
										</h:li>
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-file-csv"
												onClick="@command('report',type='CSV')">
												Csv
											</a>
										</h:li>
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-file-doc "
												onClick="@command('report',type='DOCX')">
												Word
											</a>
										</h:li>  
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-chart-tree-map"
												onClick="@command('changeView',view='cardpotenciales.zul')">
												Card
											</a>
										</h:li>
										<h:li>
											<a class="dropdown-item"
												iconSclass="fa-duotone fa-list"
												onClick="@command('changeView',view='gridpotenciales.zul')">
												List
											</a>
										</h:li>
									</h:ul>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!--end col-->
			<div class="col-xxl-12">
				<div class="card" id="companyList">
					<div class="card-header">
						<div class="row g-2">
							<div class="col-md-3">
						    <div class="search-box">		
			  <textbox onOK="@command('search')"  placeholder="buscar por .. Localidad.. Telefono1.. Telefono2.. usuario informante.. Empresa" value="@bind(vm.search)"  sclass="form-control search"  >
			  </textbox> 
			 
			 </div> 
			 </div>  	
			  <div class="col-md-2">

 
<combobox mold="rounded" autodrop="true"  placeholder="@load(vm.lang.getProperty('idmktmestadopot').label,'Estado')" model="@bind(vm.foreings['idmktmestadopot'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idmktmestadopot',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.form.getForeingByAlias('idmktmestadopot').fkentity)"  onCreate="@command('onCreateCombo',component=self,alias='idmktmestadopot')" value="@load(vm.form.getForeingByAlias('idmktmestadopot').fkentity .getFieldByAtribute('estado').value)"  ><template name="model" var="item">
<choose><when test="${item.name eq 'NOT_NULL' }">
<comboitem value="@load(item)" label="Contiene algún valor" />
</when> <when test="${item.name eq 'IS_NULL' }">
<comboitem value="@load(item)" label="No Contiene ningún valor" /></when><otherwise><comboitem value="@load(item)" label="@load(item.getFieldByAtribute('estado').value)" /></otherwise></choose></template></combobox>
                  </div>
             
             
			  <div class="col-md-2">

 
<combobox mold="rounded" autodrop="true"  placeholder="@load(vm.lang.getProperty('idmktcampaing').label,'Campaña')" model="@bind(vm.foreings['idmktcampaing'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idmktcampaing',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.form.getForeingByAlias('idmktcampaing').fkentity)"  onCreate="@command('onCreateCombo',component=self,alias='idmktcampaing')" value="@load(vm.form.getForeingByAlias('idmktcampaing').fkentity .getFieldByAtribute('code').value)"  ><template name="model" var="item">
<choose><when test="${item.name eq 'NOT_NULL' }">
<comboitem value="@load(item)" label="Contiene algún valor" />
</when> <when test="${item.name eq 'IS_NULL' }">
<comboitem value="@load(item)" label="No Contiene ningún valor" /></when><otherwise><comboitem value="@load(item)" label="@load(item.getFieldByAtribute('code').value)" /></otherwise></choose></template></combobox>
                  </div>
             
             
             
             
             
			  <div class="col-md-2">

 
<combobox mold="rounded" autodrop="true"  placeholder="@load(vm.lang.getProperty('idfrcmfranchise').label,'Franquicia')" model="@bind(vm.foreings['idfrcmfranchise'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idfrcmfranchise',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.form.getForeingByAlias('idfrcmfranchise').fkentity)"  onCreate="@command('onCreateCombo',component=self,alias='idfrcmfranchise')" value="@load(vm.form.getForeingByAlias('idfrcmfranchise').fkentity .getFieldByAtribute('nombre').value)"  ><template name="model" var="item">
<choose><when test="${item.name eq 'NOT_NULL' }">
<comboitem value="@load(item)" label="Contiene algún valor" />
</when> <when test="${item.name eq 'IS_NULL' }">
<comboitem value="@load(item)" label="No Contiene ningún valor" /></when><otherwise><comboitem value="@load(item)" label="@load(item.getFieldByAtribute('nombre').value)" /></otherwise></choose></template></combobox>
                  </div>
             
								
							<div class="col-md-auto ms-auto">
								<div
									class="d-flex align-items-center gap-2">
									<button iconSclass="fa-duotone fa-line-columns"
										type="button" id="dropdownMenuCols1"
										d:data-bs-toggle="dropdown" d:aria-expanded="false"
										class="btn btn-soft-dark waves effect waves-light" >
							   </button>
							   <h:ul class="dropdown-menu"	aria-labelledby="dropdownMenuCols1">
							               <h:li>
											  <checkbox label="Empresa" checked="@load(vm.isVisible('NOMBREDEEMPRESA'))" onCheck="@command('onHidden', evento=event,field='NOMBREDEEMPRESA' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Alta" checked="@load(vm.isVisible('ALTA'))" onCheck="@command('onHidden', evento=event,field='ALTA' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Actividad" checked="@load(vm.isVisible('ACTIVIDAD'))" onCheck="@command('onHidden', evento=event,field='ACTIVIDAD' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Última Accion" checked="@load(vm.isVisible('FECHAULTIMA'))" onCheck="@command('onHidden', evento=event,field='FECHAULTIMA' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Tipo Potencial" checked="@load(vm.isVisible('TIPOPOTENCIAL'))" onCheck="@command('onHidden', evento=event,field='TIPOPOTENCIAL' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Localidad" checked="@load(vm.isVisible('LOCALIDAD'))" onCheck="@command('onHidden', evento=event,field='LOCALIDAD' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Telefono1" checked="@load(vm.isVisible('TELEFONO1'))" onCheck="@command('onHidden', evento=event,field='TELEFONO1' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Provincia" checked="@load(vm.isVisible('PROVINCIA'))" onCheck="@command('onHidden', evento=event,field='PROVINCIA' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="SitioWeb" checked="@load(vm.isVisible('SITIOWEB'))" onCheck="@command('onHidden', evento=event,field='SITIOWEB' )"/>
										   </h:li>
							               <h:li>
											  <checkbox label="Email" checked="@load(vm.isVisible('EMAIL'))" onCheck="@command('onHidden', evento=event,field='EMAIL' )"/>
										   </h:li>
							            
							   </h:ul>
									<button tooltiptext="Find"
										iconSclass="fa-duotone fa-magnifying-glass-waveform" sclass="btn btn-outline-primary m-2"
										onClick="@command('search')" />
									<button tooltiptext="Clear"
										 sclass="btn btn-outline-dark m-2"  iconSclass="fa-duotone fa-broom-wide" onClick="@command('clear')"  />
								</div>
							</div>
						</div>
					</div>
					<div class="card-body">
							<div id="divTemplate" sclass="col-lg-12"></div>
					</div>
					<div class="card-footer">
					<div class="row">
					<div class="col-lg-2">
							
						</div>
						
						<div class="col-lg-6 align-items-start">
						  <paging id="topagin"
							pageSize="@load(vm.scroll.maxRows)"
							totalSize="@load(vm.scroll.totalRows)" mold="os" width="100%"
							 style="background-color:#FFF;" />
						</div>
						<div class="col-lg-2 align-items-start">
							<combobox
								selectedItem="@bind(vm.scroll.maxRows)"
								value="@bind(vm.scroll.maxRows)" width="75px">
								<comboitem label="30" value="30" />
								<comboitem label="50" value="50" />
								<comboitem label="100" value="100" />
							</combobox>
						</div>
						
					</div>
					</div>
				</div>
			</div>
		</div><!-- row -->
	
	   <window id="WIN_showModal" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  >
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title"
						id="exampleModalLabel">
						potenciales
					</h:h5>

				</div>
				<div class="modal-body" id="body_potenciales"></div>
				<div class="modal-footer"></div>
			</div>
		</window>
	<window id="WIN_FILTERS" mode="modal" visible="false"
			position="center,center" action="show: slideDown;hide: slideUp"
			sclass="z-messagebox-window" border="none" width="90%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">Búsqueda Avanzada</h:h5>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-lg-2"></div>
						<div class="col-lg-8">
							<div class="row">
								<h:div class="col-md-3 ">
									<hbox spacing="3px"	>
										<label
											sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
											style="  "
											value="Nombre de la búsqueda" />
									</hbox>
									<textbox id="OXBshsbqpi" value="@bind(vm.criteriaBean.nombre) @save(vm.criteriaBean.nombre, before=('onSaveCriteria')) @validator(vm.validator,required=true)"
										placeholder="introduce un nombre para guardar tu búsqueda"
										sclass="margin-field form-control  form-control "
									/>
									  <label sclass="text-danger" value="@load(vmsgs['OXBshsbqpi'])"/>
								</h:div>
								<h:div class="col-md-3 ">
									<hbox spacing="3px"	>
										<label
											sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
											style="  "
											value="La consulta pueden usarla otros usuarios" />
									</hbox>
									<checkbox value="@bind(vm.criteriaBean.publico)" checked="@bind(vm.criteriaBean.publico)"/>
								</h:div>
								<h:div class="col-md-6 ">
								    <button
										class="btn btn-info"
										iconSclass="fa-duotone fa-magnifying-glass-play me-1 align-bottom"
										tooltiptext="Ejecutar Consulta"
										onClick="@command('executeCriteria', win=WIN_FILTERS)" label="Ejecutar">
									</button>
									
									<button
										class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right me-1 align-bottom"
										tooltiptext="Grabar"
										onClick="@command('onSaveCriteria')" label="Guardar">
									</button>
								
									<button
										class="btn btn-soft-info waves effect waves-light"
										iconSclass="fa-duotone fa-broom-wide me-1 align-bottom"
										tooltiptext="limpiar Búsqueda"
										onClick="@command('onClearCriteria')" label="Nueva">
									</button>
									
									
								</h:div>
							</div>

						</div>
						<div class="col-lg-2">
						      <button
										class="btn btn-square btn-outline-danger m-1"
										iconSclass="fa-light fa-nfc-trash fa-lg"
										tooltiptext="limpiar Búsqueda"
										onClick="@command('onRemoveCriteria')" >
									</button>
						</div>
					</div>
					<space></space>
					<div class="row">
						<div class="col-lg-2">
							<listbox
								model="@load(vm.screenModel.filters)" height="500px">
								<listhead>
									<listheader label="Campo">
									</listheader>
								</listhead>
								<template name="model" var="item">
									<listitem value="@load(item)"
										draggable="true">
										<listcell
											label="@load(item.label)">
										</listcell>
									</listitem>
								</template>
							</listbox>

						</div>
						<div class="col-lg-8">
							<grid height="500px"
								model="@load(vm.customCriterias)"
								rowRenderer="@load(vm.filterRender)" droppable="true"
								draggable="true" onDrop="@command('onDropFilter',evento=event)"
								emptyMessage="No hay condiciones...">
								<columns>
									<column label="Campo" width="10%" />
									<column label="Condición"
										width="80%" />
									<column label="Accion" width="10%" />
								</columns>
								<rows>

								</rows>
							</grid>
						</div>
						<div class="col-lg-2">
							<listbox height="500px" model="@bind(vm.criteriasBeans)" checkmark="true" 
							
							 onSelect="@command('onSelectBusqueda',evento=event)">
								<listhead >
									<listheader label="Búsquedas">
									</listheader>
								</listhead>
								<template name="model" var="item">
									<listitem value="@load(item)" >
										<listcell
											label="@load(item.nombre)">
										</listcell>
									</listitem>
								</template>
							</listbox>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<div class="hstack gap-2 justify-content-end">
						<button onClick="WIN_FILTERS.setVisible(false)"
							class="btn btn-light">
							Cerrar
						</button>
					</div>
				</div>
			</div>
		</window>
  <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
	  
                <!--end add modal-->
	</idspace>
</zk>