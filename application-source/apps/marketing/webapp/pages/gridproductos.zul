<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
					
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
							       <column style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PRODUCTO.label', 'Producto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PRODUCTOAsc'])" sortDescending="@load(vm.comparators['PRODUCTODesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('SUINISIT.label', 'Suinsit'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SUINISITAsc'])" sortDescending="@load(vm.comparators['SUINISITDesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('SUINCODE.label', 'Suincode'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SUINCODEAsc'])" sortDescending="@load(vm.comparators['SUINCODEDesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('OTHER.label', 'Otro'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['OTHERAsc'])" sortDescending="@load(vm.comparators['OTHERDesc'])"/>
 							      <column style="font-size:14px;"  label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;">
							          <label  value="@load(item.producto) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.suinisit) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.suincode) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.other) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
                  		
                  		<button
						onClick="@command('editPopup',item=item,body='body_productos',page='popupproducto.zul',close='close-modal',win=WIN_showModal)"
						iconSclass="fa-duotone fa-pen-to-square fa-xl"  />
						
                  		
						<space></space>
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
 </div>						
</zk>						
