</div>
</h:div>
<h:div class="mb-2">
<textbox id="tboxIkUKkapxEz"  placeholder="" value="@bind(vm.beanData.idcrmempresa.empresa) @save(vm.beanData.idcrmempresa.empresa, before=('grabar'))  " 
 onClick="@command('onChangeFindTextForeing',alias='idcrmempresa',att='empresa',event=event,idcp='cbIkUKkapxEz')" onChange="@command('onChangeFindTextForeing',alias='idcrmempresa',att='empresa',event=event,idcp='cbIkUKkapxEz')"  sclass="form-control  bg-light border-0" />
<combobox id="cbIkUKkapxEz" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idcrmempresa'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='true',alias='idcrmempresa',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.empresa}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxIkUKkapxEz'])"/></h:div>
<window id="searchIkUKkapxEz" mode="modal" visible="false">
