    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('SECRET'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SECRET.label', 'Secret'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="47268" 
	   placeholder="@load(vm.lang.getProperty('SECRET.label', 'Secret'))" 
	   value="@bind(vm.beanData.secret) @save(vm.beanData.secret, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('SECRET'))" disabled="@load(vm.isEditable('SECRET')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['47268'])"/>
	   
    </h:div>   







				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('URLAPI'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('URLAPI.label', 'URl API'))"  />
	    <a iconSclass="bx bxs-message-square-dots" popup="pop_URLAPI" />
	   </hbox>
	    <textbox   tabindex="3" id="599868" 
	   placeholder="@load(vm.lang.getProperty('URLAPI.label', 'url del api'))" 
	   value="@bind(vm.beanData.urlapi) @save(vm.beanData.urlapi, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('URLAPI'))" disabled="@load(vm.isEditable('URLAPI')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['599868'])"/>
	   
    </h:div>   
   <popup id="pop_URLAPI" width="200px">
          <groupbox sclass="z-demo-config" closable="false">
            <caption>Ayuda</caption>
            <span>
                <![CDATA[
                 Introducir la url del api de la red social
                ]]>  
            </span>
         
        </groupbox>
 </popup>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="BGaQcGvYRu"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="BGaQcGvYRu-card" class="card " style="overflow:auto;" >
       <div id="BGaQcGvYRu-body" class="card-body ">
        <div id="BGaQcGvYRu-row" class="form-group row ">

<h:div class="col-md-12">
<hbox spacing="3px">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))"/>
</hbox>


          <h:div class="image-cropper-container" style="width:100px;  height:100px;" >
     <image id="AVATAR" sclass="image-download" content="@load(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="HmeucZxYfh"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
