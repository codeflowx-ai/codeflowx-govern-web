<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="productos" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='productos')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="productos" />
<custom-attributes clase="org.suinsit.apps.marketing.Mktmproducto" />
	   <custom-attributes namespace="marketing" />
	      <custom-attributes uid="11567" />
	   <custom-attributes tipo="MASTER" />
	   
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="LzEqBsJiCw" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="LzEqBsJiCw-row" class="row">
</div>
</div>  
<div id="EyZaGjRjed" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="EyZaGjRjed-row" class="row">


				


   
    <h:div class="col-md-3 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PRODUCTO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PRODUCTO.label', 'Producto'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="UQzTGZVRUF" 
	   placeholder="@load(vm.lang.getProperty('PRODUCTO.label', 'Producto'))" 
	   value="@bind(vm.beanData.producto) @save(vm.beanData.producto, before=('grabar')) @validator(vm.unique, field='PRODUCTO',required=true ,oldValue=vm.beanDataCpy.producto)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('PRODUCTO'))" disabled="@load(vm.isEditable('PRODUCTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['UQzTGZVRUF'])"/>
	   
    </h:div>   






 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('OTHER'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('OTHER.label', 'Otro'))"/>
	   </hbox>
 <checkbox mold="default" id="rphXLpBFon" value="@bind(vm.beanData.other) @save(vm.beanData.other, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('OTHER'))" disabled="@load(vm.isEditable('OTHER')?false:true)" checked="@bind(vm.beanData.other) @save(vm.beanData.other, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('SUINCODE'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SUINCODE.label', 'Suincode'))"/>
	   </hbox>
 <checkbox mold="default" id="278275" value="@bind(vm.beanData.suincode) @save(vm.beanData.suincode, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('SUINCODE'))" disabled="@load(vm.isEditable('SUINCODE')?false:true)" checked="@bind(vm.beanData.suincode) @save(vm.beanData.suincode, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('SUINISIT'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SUINISIT.label', 'Suinsit'))"/>
	   </hbox>
 <checkbox mold="default" id="bvMPNHedIm" value="@bind(vm.beanData.suinisit) @save(vm.beanData.suinisit, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('SUINISIT'))" disabled="@load(vm.isEditable('SUINISIT')?false:true)" checked="@bind(vm.beanData.suinisit) @save(vm.beanData.suinisit, before=('grabar'))"/>
</h:div>



</div>
</div>  
<div id="tQHzlzBiPu" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="tQHzlzBiPu-row" class="row">
</div>
</div>  
<div id="cpdpPDvZZB" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="cpdpPDvZZB-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['productos.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 

                  
                 





                  
                 

                  
                 

                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$productos');
  binder.command('doLoad');
});
function loadproductos(){
  var binder = zkbind.$('$productos');
  binder.command('doLoadBean');

}
</script>	
</zk>