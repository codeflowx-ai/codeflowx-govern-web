					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('PRODUCTO.label', 'Producto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PRODUCTOAsc'])" sortDescending="@load(vm.comparators['PRODUCTODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('SUINISIT.label', 'Suinsit'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SUINISITAsc'])" sortDescending="@load(vm.comparators['SUINISITDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('SUINCODE.label', 'Suincode'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SUINCODEAsc'])" sortDescending="@load(vm.comparators['SUINCODEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('OTHER.label', 'Otro'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['OTHERAsc'])" sortDescending="@load(vm.comparators['OTHERDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('PRODUCTO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('SUINISIT').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('SUINCODE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('OTHER').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterproductos.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
