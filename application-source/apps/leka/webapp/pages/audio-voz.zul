<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="row">
		<div class="leka-drawer-filters">
			<div class="row leka-drawer-flex">
				<div class="col-md-6 col-lg-6 leka-drawer-txt">

					<div class="left tittle-principal">
						<h:h2 class="mb-sm-0">Leka Voice</h:h2>
					</div>

					<label class="txt-mkt">
						Con LEKA, dale voz a tus ideas: convierte texto
						en audio realista y explora múltiples modelos de
						voz para una experiencia verdaderamente humana.
					</label>
				</div>

				<div class="col-md-6 col-lg-6 leka-drawer-options">
					<button class="btn btn-primary"
						iconSclass="fa-duotone fa-solid fa-play" label="Run" onClick="" />
					<a iconSclass="fa-duotone fa-solid fa-sliders"
						onClick="drawer.open()" />
				</div>
			</div>


			<drawer id="drawer" class="drawer-filter" position="right"
				autodrop="false">
				<div class="d-flex mb-2">
					<a iconSclass="fa-duotone fa-light fa-xmark"
						onClick="drawer.close()" />
					<label class="drawer-ttl">Instrucciones</label>
				</div>


				<div class="filtros col-12 end-0 bg-white pt-2 pl-0">

					<div class="mb-2">

						<textbox multiline="true" class="form-control"
							height="120px" placeholder="Detalles" />
					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">Voz</label>


						<combobox class="col-12 pl-0">
							<comboitem label="Coral"
								description="Tpo de voz " />
							<comboitem label="Coral"
								description="Tpo de voz " />
						</combobox>

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Límite
						</label>


						<slider id="slider" width="100%"
							onScroll="zoom(self, img)" />

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Relleno de prefijo
						</label>

						<slider id="slider1" width="100%"
							onScroll="zoom(self, img)" />

					</div>

					<div class="mb-2">
						<label class="pad-0 leka-label-ftr">
							Duración del silencio
						</label>

						<slider id="slider2" width="100%"
							onScroll="zoom(self, img)" />

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Funciones
						</label>


						<button class="btn btn-primary w-100"
							iconSclass="fa-duotone fa-regular fa-plus" label="Añadir"
							onClick="" />

					</div>


					<div class="d-flex mb-2">
						<label class="drawer-ttl">
							Configuración Modelos
						</label>
					</div>


					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Temperatura
						</label>


						<slider id="slider3" width="100%"
							onScroll="zoom(self, img)" />

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Max Tokens
						</label>


						<slider id="slider4" width="100%"
							onScroll="zoom(self, img)" />

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">Modo</label>


						<combobox class="col-12 pl-0">
							<comboitem label="Chat"
								description="mantiene una convesacion " />
							<comboitem label="Single"
								description="responde sin mantener estados" />
						</combobox>

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Proveedor
						</label>

						<combobox class="col-12 pl-0">
							<comboitem label="Chat"
								description="mantiene una convesacion " />
							<comboitem label="Single"
								description="responde sin mantener estados" />
						</combobox>

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Modelo
						</label>


						<combobox class="col-12 pl-0">
							<comboitem label="Chat"
								description="mantiene una convesacion " />
							<comboitem label="Single"
								description="responde sin mantener estados" />
						</combobox>

					</div>

					<div class="mb-2">

						<label class="pad-0 leka-label-ftr">
							Ejemplos
						</label>


						<combobox class="col-12 pl-0">
							<comboitem label="Chat"
								description="mantiene una convesacion " />
							<comboitem label="Single"
								description="responde sin mantener estados" />
						</combobox>

					</div>

					<slider id="slider5" width="100%"
						onScroll="zoom(self, img)" />

				</div>
			</drawer>



		</div>


		<div class="col-lg-12 s-bot mb-5">

			<div class="row">
				<div class="col-8 mb-8">
					<div class="card" height="100%">

						<div class="row" height="100%">
							<div class="col-12 mb-12">
								<div class="card cards-mkt-sf">
									<hlayout spacing="10px"
										style="margin-bottom:20px;">
										<vlayout class="mkt"
											style="padding:20px; ">
											<label class="subtt-mkt">
												En tiempo real
											</label>

											<grid class="leka-audio">
												<rows>
													<row>
														<hlayout>

															<div
																class="audio-section">
																<div>
																	<a
																		iconSclass="fa-duotone fa-solid fa-waveform-lines">
																	</a>
																	<h:p>
																		La
																		conversación
																		aparecerá
																		aquí
																	</h:p>
																</div>
															</div>

														</hlayout>

													</row>
												</rows>
											</grid>

											<hlayout spacing="20px"
												class="button-container">
												<button
													class="btn btn-primary btn-action">
													Subir audio
												</button>
												<button
													class="btn btn-primary btn-action">
													Descargar audio
												</button>
											</hlayout>


										</vlayout>
									</hlayout>
								</div>

							</div>

						</div>



					</div>
				</div>
				<div class="col-4">
					<div class="card cards-mkt-sf">
						<div class="mkt-dp leka">
							<div class="row">
								<div class="chatbot">
									<div class="chatbot-header">
										<h:img src="../img/leka-1.png"
											alt="Chat Icon" />
										<h:h5>LEKA</h:h5>
									</div>

									<div class="chatbot-body">
										<h:h6>
											¿Tienes dudas sobre que IA
											Usar? Pregúntanos.
										</h:h6>



										<hlayout class="b-bot300">
											<div id="areaMsg"
												class="area-msgchat300" vflex="1">
												<forEach
													items="@bind(vm.chatmsgs)" var="item">
													<choose>
														<when
															test="${item.usuario}">
															<div
																sclass="col-12 col-md-12 col-lg-12 stl-chat">
																<if
																	test="${item.user ne null}">
																	<label
																		value="${item.user}" sclass="${item.sclass}">
																	</label>
																</if>
																<if
																	test="${item.message ne null}">
																	<label
																		value="${item.message}" sclass="${item.sclass}"
																		multiline="true">
																	</label>
																</if>
															</div>

														</when>
														<when
															test="${item.assistan}">
															<if
																test="${item.icon ne null}">
																<h:icon
																	sclass="${item.icon}">
																</h:icon>
															</if>
															<if
																test="${item.message ne null}">
																<label
																	value="${item.message}" sclass="${item.sclass}"
																	multiline="true">
																</label>
															</if>
														</when>
														<otherwise>
														</otherwise>
													</choose>
												</forEach>
											</div>

										</hlayout>
										<textbox id="tbmessage"
											multiline="true" class="form-control" height="200px"
											placeholder="Escribe tu mensaje..."
											value="@bind(vm.chatmsg)" />

										<button class="btn btn-primary"
											onClick="@command('sendChatMessage')">
											Enviar Mensaje
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


</zk>