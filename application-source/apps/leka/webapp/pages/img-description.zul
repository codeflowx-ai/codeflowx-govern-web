<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="row">
		<nodom
			viewModel="@id('vm') @init('com.suinsit.nocode.suinless.ui.MultimediaTrainingUI',pagina='promp')"
			validationMessages="@id('vmsgs')">
			<custom-attributes pagina="promp" />
			<custom-attributes
				clase="org.suinsit.apps.suinless.Slespromp" />
			<custom-attributes namespace="suinless" />
			<custom-attributes uid="21116" />
			<custom-attributes tipo="MASTER" />
			<custom-attributes msgform="Proyecto enviado" />
			<custom-attributes type="form" />
			<div class="row">
				<div class="leka-drawer-filters">
					<div class="row leka-drawer-flex">
						<div
							class="col-8 col-md-10 col-lg-10 leka-drawer-txt">

							<div class="left tittle-principal">
								<h:h2 class="mb-sm-0">Leka Media</h:h2>
							</div>

							<label class="txt-mkt">
								LEKA te permite dar vida a tus ideas:
								compara y genera imágenes y videos con
								los mejores modelos de IA en una sola
								plataforma.
							</label>
						</div>

						<div
							class="col-4 col-md-2 col-lg-2 leka-drawer-options">
							<button class="btn btn-primary"
									iconSclass="fa-duotone fa-solid fa-play" label="Ejecutar"
									onClick="@command('runMessageWithImage')"/>
						</div>
					</div>
				</div>


				<div class="col-lg-12 s-bot mb-5">

					<div class="row">
						<div class="col-12 col-md-8 col-lg-8 mb-8">
							<div class="card" height="100%">

								<div class="row" height="100%">
									<div class="col-12 mb-12">
										<div
											class="card cards-mkt-sf img-mov">
											<hlayout spacing="10px"
												style="margin-bottom:20px;">
												<vlayout class="mkt"
													style="padding:20px; ">
													<label
														class="subtt-mkt">
														Descriptor de Imagen
													</label>

													<grid>
														<rows>
															<row>
																<image style="width:100%; height:200px" id="img" />
															</row>
															<row>
																Sube la imagen
																<fileupload label="Upload" onUpload="img.setContent(event.media)" />
															</row>
														</rows>
													</grid>
													<hlayout
														style="margin-top:20px;">
														<textbox
															placeholder="Introduzca el prompt aquí"
															width="95vh" style="margin-top: 58px;" rows="5">
														</textbox>
													</hlayout>
												</vlayout>
											</hlayout>
											
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</nodom>
	</div>


</zk>