<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tipoinicidencia" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tipoinicidencia')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="tipoinicidencia" />
<custom-attributes clase="org.suinsit.apps.soporte.Sopmtipo" />
	   <custom-attributes namespace="soporte" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="oshrttQCva" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="oshrttQCva-row" class="row">


				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('TIPOINCIDENCIA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPOINCIDENCIA.label', 'Tipo incidencia'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="254473" 
	   placeholder="@load(vm.lang.getProperty('TIPOINCIDENCIA.label', 'Tipo incidencia'))" 
	   value="@bind(vm.beanData.tipoincidencia) @save(vm.beanData.tipoincidencia, before=('grabar')) @validator(vm.unique, field='TIPOINCIDENCIA', oldValue=vm.beanDataCpy.tipoincidencia)"  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('TIPOINCIDENCIA'))" disabled="@load(vm.isEditable('TIPOINCIDENCIA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['254473'])"/>
	   
    </h:div>   






 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('SOPORTE'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SOPORTE.label', 'Soporte'))"/>
	   </hbox>
 <checkbox mold="default" id="725969" value="@bind(vm.beanData.soporte) @save(vm.beanData.soporte, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('SOPORTE'))" disabled="@load(vm.isEditable('SOPORTE')?false:true)" checked="@bind(vm.beanData.soporte) @save(vm.beanData.soporte, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('TECNICA'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TECNICA.label', 'Tipo tecnica'))"/>
	   </hbox>
 <checkbox mold="default" id="tGJgDUXEBN" value="@bind(vm.beanData.tecnica) @save(vm.beanData.tecnica, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('TECNICA'))" disabled="@load(vm.isEditable('TECNICA')?false:true)" checked="@bind(vm.beanData.tecnica) @save(vm.beanData.tecnica, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('FORMACION'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('FORMACION.label', 'Falta de formación'))"/>
	   </hbox>
 <checkbox mold="default" id="KBpWqptfiL" value="@bind(vm.beanData.formacion) @save(vm.beanData.formacion, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('FORMACION'))" disabled="@load(vm.isEditable('FORMACION')?false:true)" checked="@bind(vm.beanData.formacion) @save(vm.beanData.formacion, before=('grabar'))"/>
</h:div>




   <h:div class="col-md-6">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AYUDABREVE.label', 'Ayuda Breve usuario'))"/>
	   </hbox>
	  <tbeditor id="GnMzQrZNoH" value="@bind(vm.beanData.ayudabreve) @save(vm.beanData.ayudabreve, before=('grabar')) " />
</h:div>




   <h:div class="col-md-6">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción Técnica'))"/>
	   </hbox>
	  <tbeditor id="lSjOhGVTdv" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['tipoinicidencia.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tipoinicidencia');
  binder.command('doLoad');
});
function loadtipoinicidencia(){
  var binder = zkbind.$('$tipoinicidencia');
  binder.command('doLoadBean');

}
</script>	
</zk>