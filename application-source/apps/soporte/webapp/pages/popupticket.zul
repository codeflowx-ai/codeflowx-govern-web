<combobox mold="rounded" autodrop="true"  id="idsopmtipo" placeholder="@load(vm.lang.getProperty('idsopmtipo').label,'Tipo')" model="@bind(vm.foreings['idsopmtipo'])"  buttonVisible="true"	onSelect="@command('onSelectForeing', alias='idsopmtipo',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idsopmtipo)"  onCreate="@command('onCreateCombo',component=self,alias='idsopmtipo')" value="@bind(vm.beanData.idsopmtipo .tipoincidencia)@save(vm.beanData.idsopmtipo.tipoincidencia, before=('grabar')) @validator(vm.validator,required=true)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.tipoincidencia)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idsopmtipo'])"/>
