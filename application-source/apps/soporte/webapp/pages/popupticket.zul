<div id="BcsqJwpoMO" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="BcsqJwpoMO-row" class="row">

<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Descripción Inicdencia" />      
                 <tab label="Diagnostico" />      
                 <tab label="Resolución" />      
                                <tab label="Ficheros, Documentos" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', ''))"/>
	   </hbox>
	  <tbeditor id="MNAkKFbEEE" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DIAGNOSTICO.label', ''))"/>
	   </hbox>
	      <textbox rows="4" cols="80" id="svuMbCzHRk" multiline="true" placeholder="@load(vm.lang.getProperty('DIAGNOSTICO.label', 'diagnostico'))" value="@bind(vm.beanData.diagnostico) @save(vm.beanData.diagnostico, before=('grabar')) "  sclass="form-control  form-control" visible="@load(vm.isVisible('DIAGNOSTICO'))" disabled="@load(vm.isEditable('DIAGNOSTICO')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['svuMbCzHRk'])"/>
	     
</h:div>



