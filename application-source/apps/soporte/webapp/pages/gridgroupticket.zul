					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('CODSOPORTE.label', 'codsoporte'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODSOPORTEAsc'])" sortDescending="@load(vm.comparators['CODSOPORTEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ALTA.label', 'alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('TIPOINCIDENCIA.label', 'TIPOINCIDENCIA'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOINCIDENCIAAsc'])" sortDescending="@load(vm.comparators['TIPOINCIDENCIADesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('BGCOLOR.label', 'BGCOLOR'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BGCOLORAsc'])" sortDescending="@load(vm.comparators['BGCOLORDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('CRITICIDAD.label', 'CRITICIDAD'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CRITICIDADAsc'])" sortDescending="@load(vm.comparators['CRITICIDADDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USUARIOAsc'])" sortDescending="@load(vm.comparators['USUARIODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('EMPRESA.label', 'Empresa'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['EMPRESAAsc'])" sortDescending="@load(vm.comparators['EMPRESADesc'])"/>
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('CODSOPORTE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ALTA').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('tipoincidencia').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('bgcolor').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('criticidad').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('usuario').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('empresa').value) @converter(vm.fieldConverter)"></label>
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterticket.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
