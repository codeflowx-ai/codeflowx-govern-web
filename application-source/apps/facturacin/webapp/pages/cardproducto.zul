<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="row">
 
		<forEach items="@load(vm.beans)" var="item">
			<div class="col-sm-3 col-xl-3">
				<div class="card border card-border-dark">
					<div class="card-header">
						<div class="d-flex align-items-center">
						  <div class="flex-grow-1">
						  </div>
						  <div class="flex-shrink-0">
						  
						      <h:ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
					     <h:li class="list-inline-item">
					     <button
						onClick="@command('editData',item=item,page='masterproducto.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"/>
					     			  </h:li>   			     
								     <h:li class="list-inline-item">
								      <button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn" />
								     </h:li>
						      </h:ul>
						 
						  </div> 
						</div>	
					</div>


    
     
    
     
    
     
    
     
<div class="card-body border-top-0">
	<div class="row">
	  <div class="col-lg-4">
	      <div class="row">
               <div class="col-md-12 col-xl-12">
                    <image sclass="" content="@load(vm.getImage(item,'AVATAR'))" width="100%" height="100%" />
			   </div>
          
          
          
          
          </div>                     
	  </div>  
	  <div class="col-lg-8">
	      <div class="row">
      
    
      
	          
		       <h:div class="col-md-auto">
		      
	        <label  sclass="form-label  text-capitalize  font-weight-normal align-text-middle" style=" " value="@load(item.producto) @converter(vm.fieldConverter)"></label>
	        </h:div>
    
      
	          
		       <h:div class="col-md-auto">
		      
	        <label  sclass="form-label  text-capitalize  font-weight-normal align-text-middle" style=" " value="@load(item.precioventa) @converter(vm.fieldConverter)"></label>
	        </h:div>
    
      
	          
		       <h:div class="col-md-auto">
		      
	        <label  sclass="form-label  text-capitalize  font-weight-normal align-text-middle" style=" " value="@load(item.refinterna) @converter(vm.fieldConverter)"></label>
	        </h:div>
    
     </div>
   </div>
		</div>
					</div>
				</div>
			</div>
		</forEach>
	</div>
</zk>
