<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
					
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
							       <column   style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CODIBAN.label', 'IBAN'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODIBANAsc'])" sortDescending="@load(vm.comparators['CODIBANDesc'])"/>
							       <column   style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('BANCO.label', 'Banco'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BANCOAsc'])" sortDescending="@load(vm.comparators['BANCODesc'])"/>
							       <column   style="font-size:14px;" sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CODSWIFT.label', 'Swift'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODSWIFTAsc'])" sortDescending="@load(vm.comparators['CODSWIFTDesc'])"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;">
							          <label  value="@load(item.codiban) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.banco) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.codswift) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
                  		
                  		<button
						onClick="@command('editPopup',item=item,body='body_bancos',page='popuppopbanco.zul',close='close-modal',win=WIN_showModal)"
						iconSclass="fa-duotone fa-pen-to-square fa-xl"  />
						
                  		
						<space></space>
						<space></space>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
 </div>						
</zk>						
