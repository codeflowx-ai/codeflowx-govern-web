<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="bancos" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='bancos')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupbancos" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.facturacin.Erpmabnco" />
	   <custom-attributes namespace="facturacin" />
	      <custom-attributes uid="25402" />
	   <custom-attributes tipo="MASTER" />
	   
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="ZABWSCZJfS" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="ZABWSCZJfS-row" class="row">


				


    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('CODIBAN'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CODIBAN.label', 'IBAN'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="bHHcJjKRCJ" 
	   placeholder="@load(vm.lang.getProperty('CODIBAN.label', 'IBAN'))" 
	   value="@bind(vm.beanData.codiban) @save(vm.beanData.codiban, before=('grabar')) @validator(vm.unique, field='CODIBAN',type='IBAN' ,oldValue=vm.beanDataCpy.codiban)"     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('CODIBAN'))" disabled="@load(vm.isEditable('CODIBAN')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['bHHcJjKRCJ'])"/>
	   
    </h:div>   






				


    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('BANCO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('BANCO.label', 'Banco'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="141811" 
	   placeholder="@load(vm.lang.getProperty('BANCO.label', 'Banco'))" 
	   value="@bind(vm.beanData.banco) @save(vm.beanData.banco, before=('grabar')) "     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('BANCO'))" disabled="@load(vm.isEditable('BANCO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['141811'])"/>
	   
    </h:div>   






				


    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('CODSWIFT'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CODSWIFT.label', 'Swift'))"  />
	   </hbox>
	    <textbox   tabindex="3" id="adaeuJTxQg" 
	   placeholder="@load(vm.lang.getProperty('CODSWIFT.label', 'Swift'))" 
	   value="@bind(vm.beanData.codswift) @save(vm.beanData.codswift, before=('grabar')) "     sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('CODSWIFT'))" disabled="@load(vm.isEditable('CODSWIFT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['adaeuJTxQg'])"/>
	   
    </h:div>   




</div>
</div>  
<div id="vaMQjoNDEW" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="vaMQjoNDEW-row" class="row">
</div>
</div>  
<div id="LkVtrVVlkc" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="LkVtrVVlkc-row" class="row">
</div>
</div>  
<div id="GXgLdxBzKx" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="GXgLdxBzKx-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['bancos.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 




                  
                 

                  
                 

                  
                 

                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$bancos');
  binder.command('doLoad');
});
function loadbancos(){
  var binder = zkbind.$('$bancos');
  binder.command('doLoadBean');

}
</script>	
</zk>