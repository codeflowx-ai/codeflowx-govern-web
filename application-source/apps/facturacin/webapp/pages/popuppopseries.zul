<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="popseries" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='popseries')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popseries" />
	  
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="PQKigZQFby" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="PQKigZQFby-row" class="row">





   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PREFIX'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREFIX.label', 'Serie'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="260842" 
	   placeholder="@load(vm.lang.getProperty('PREFIX.label', 'Serie'))" 
	   value="@bind(vm.beanData.prefix) @save(vm.beanData.prefix, before=('grabar')) @validator(vm.unique, field='PREFIX',required=true ,oldValue=vm.beanDataCpy.prefix)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('PREFIX'))" disabled="@load(vm.isEditable('PREFIX')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['260842'])"/>
    </h:div>   







<h:div class="col-md-4 border-field">

   <hbox spacing="3px">
     <label sclass="fs-6 text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('MASK.label', 'Mascara'))"/>
 </hbox>

 <combobox mold="rounded" sclass="border-warning" id="MASK" model="@load(vm.getEnums('MASK'))" 
selectedItem="@load(vm.beanData.mask)"  value="@load(vm.beanData.mask) @save(vm.beanData.mask, before=('grabar'))  @validator(vm.validator,required=true ,oldValue=vm.bean.getFieldByAtribute('MASK').value )">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['MASK'])"/>
</h:div>





 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ADDYEAR'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ADDYEAR.label', 'Añadir el año'))"/>
	   </hbox>
 <checkbox mold="default" id="652404" value="@bind(vm.beanData.addyear) @save(vm.beanData.addyear, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('ADDYEAR'))" disabled="@load(vm.isEditable('ADDYEAR')?false:true)" checked="@bind(vm.beanData.addyear) @save(vm.beanData.addyear, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-2 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('RESETYEAR'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('RESETYEAR.label', 'Cambiar cada año'))"/>
	   </hbox>
 <checkbox mold="default" id="437560" value="@bind(vm.beanData.resetyear) @save(vm.beanData.resetyear, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('RESETYEAR'))" disabled="@load(vm.isEditable('RESETYEAR')?false:true)" checked="@bind(vm.beanData.resetyear) @save(vm.beanData.resetyear, before=('grabar'))"/>
</h:div>








   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('SEQUENCE'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SEQUENCE.label', 'Sequencia'))"  />
	   </hbox>
	   <textbox  readonly="true"  tabindex="5" id="734150" 
	   placeholder="@load(vm.lang.getProperty('SEQUENCE.label', 'Sequencia'))" 
	   value="@bind(vm.beanData.sequence) @save(vm.beanData.sequence, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('SEQUENCE'))" disabled="@load(vm.isEditable('SEQUENCE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['734150'])"/>
    </h:div>   




</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['popseries.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 






                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popseries');
  binder.command('doLoad');
});
function loadpopseries(){
  var binder = zkbind.$('$popseries');
  binder.command('doLoadBean');

}
</script>	
</zk>