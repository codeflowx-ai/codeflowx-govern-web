<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="series" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='series')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupseries" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.facturacin.Erpseries" />
	   <custom-attributes namespace="facturacin" />
	      <custom-attributes uid="43022" />
	   <custom-attributes tipo="MASTER" />
	   
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="EhZgoFSlNp" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="EhZgoFSlNp-row" class="row">


				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('PREFIX'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREFIX.label', 'Serie'))"  />
	   </hbox>
	    <textbox   tabindex="1" id="ZgPQwvamGe" 
	   placeholder="@load(vm.lang.getProperty('PREFIX.label', 'Serie'))" 
	   value="@bind(vm.beanData.prefix) @save(vm.beanData.prefix, before=('grabar')) @validator(vm.unique, field='PREFIX',required=true ,oldValue=vm.beanDataCpy.prefix)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('PREFIX'))" disabled="@load(vm.isEditable('PREFIX')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['ZgPQwvamGe'])"/>
	   
    </h:div>   




</div>
</div>  
<div id="vZDMBBWDhs" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="vZDMBBWDhs-row" class="row">


				

    <h:div class="col-md-12 ">
       <hbox spacing="3px" visible="@load(vm.isVisible('LASTVALUE'))" sclass="margin-field">
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('LASTVALUE.label', 'Último valor'))"/>
	   </hbox>
	      <decimalbox   tabindex="1" id="bBwDRoLhOa"  placeholder="@load(vm.lang.getProperty('LASTVALUE.label', 'Último valor'))"  value="@bind(vm.beanData.lastvalue) @save(vm.beanData.lastvalue, before=('grabar')) "  format="###,###,##0.00" sclass="margin-field form-control  form-control" visible="@load(vm.isVisible('LASTVALUE'))" disabled="@load(vm.isEditable('LASTVALUE')?false:true)" onChange="@command('onChangeInput',field='LASTVALUE',evento=event,componente=self,calculate=true)" />
           <label sclass="text-danger" value="@load(vmsgs['bBwDRoLhOa'])"/>   
    </h:div>






				

    <h:div class="col-md-12 ">
    <!-- sclass="margin-field" -->
       <hbox spacing="3px" visible="@load(vm.isVisible('SEQUENCE'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SEQUENCE.label', 'Sequencia'))"  />
	   </hbox>
	    <textbox   tabindex="2" id="YqbJhzcpzt" 
	   placeholder="@load(vm.lang.getProperty('SEQUENCE.label', 'Sequencia'))" 
	   value="@bind(vm.beanData.sequence) @save(vm.beanData.sequence, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('SEQUENCE'))" disabled="@load(vm.isEditable('SEQUENCE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['YqbJhzcpzt'])"/>
	   
    </h:div>   




</div>
</div>  
<div id="VpJiaSdsde" style="overflow:auto;" class=" col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="VpJiaSdsde-row" class="row">



<h:div class="col-md-12 ">

   <hbox spacing="3px">
     <label sclass="text  form-label text-capitalize font-weight-normal text-danger" style="" value="@load(vm.lang.getProperty('MASK.label', 'Mascara'))"/>
 </hbox>


 <combobox mold="rounded" disabled="false"  sclass="border-warning" id="MASK" model="@load(vm.getEnums('MASK'))" 
selectedItem="@load(vm.beanData.mask)"  value="@load(vm.beanData.mask) @save(vm.beanData.mask, before=('grabar'))  @validator(vm.validator,required=true ,oldValue=vm.bean.getFieldByAtribute('MASK').value )">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['MASK'])"/>
</h:div>





 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('RESETYEAR'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('RESETYEAR.label', 'Actualizar cada año'))"/>
	   </hbox>
 <checkbox mold="default" id="QIeKfUHZjR" value="@bind(vm.beanData.resetyear) @save(vm.beanData.resetyear, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('RESETYEAR'))" disabled="@load(vm.isEditable('RESETYEAR')?false:true)" checked="@bind(vm.beanData.resetyear) @save(vm.beanData.resetyear, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ADDYEAR'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ADDYEAR.label', 'Añadir Año'))"/>
	   </hbox>
 <checkbox mold="default" id="DuDxRsiCPv" value="@bind(vm.beanData.addyear) @save(vm.beanData.addyear, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('ADDYEAR'))" disabled="@load(vm.isEditable('ADDYEAR')?false:true)" checked="@bind(vm.beanData.addyear) @save(vm.beanData.addyear, before=('grabar'))"/>
</h:div>



</div>
</div>  
<div id="ZPIvaYvsHv" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="ZPIvaYvsHv-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['series.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 


                  
                 



                  
                 




                  
                 

                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$series');
  binder.command('doLoad');
});
function loadseries(){
  var binder = zkbind.$('$series');
  binder.command('doLoadBean');

}
</script>	
</zk>