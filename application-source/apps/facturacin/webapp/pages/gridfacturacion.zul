<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" >
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('FACTURA.label', 'Factura'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FACTURAAsc'])" sortDescending="@load(vm.comparators['FACTURADesc'])"  visible="@load(vm.isVisible('FACTURA'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('FECHAFACT.label', 'Fecha Factura'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECHAFACTAsc'])" sortDescending="@load(vm.comparators['FECHAFACTDesc'])"  visible="@load(vm.isVisible('FECHAFACT'))"/>
						
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Cliente.label', 'Cliente'))" align="center"/>
						
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Comercial.label', 'Comercial'))" align="center"/>
						
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ERPEMPRESA.label', 'ERPEMPRESA'))" align="center"/>
						
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Estado.label', 'Estado'))" align="center"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('IMPUESTOS.label', 'Impuestos'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['IMPUESTOSAsc'])" sortDescending="@load(vm.comparators['IMPUESTOSDesc'])"  visible="@load(vm.isVisible('IMPUESTOS'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('SUBTOTAL.label', 'Subtotal'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SUBTOTALAsc'])" sortDescending="@load(vm.comparators['SUBTOTALDesc'])"  visible="@load(vm.isVisible('SUBTOTAL'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('TOTAL.label', 'Total'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TOTALAsc'])" sortDescending="@load(vm.comparators['TOTALDesc'])"  visible="@load(vm.isVisible('TOTAL'))"/>
						
							      <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('Estado Cobro.label', 'Estado Cobro'))" align="center"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('FECOBRO.label', 'Fec. Cobro'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECOBROAsc'])" sortDescending="@load(vm.comparators['FECOBRODesc'])"  visible="@load(vm.isVisible('FECOBRO'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('FECSIGNED.label', 'Fec. Firma'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECSIGNEDAsc'])" sortDescending="@load(vm.comparators['FECSIGNEDDesc'])"  visible="@load(vm.isVisible('FECSIGNED'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ENDDATE.label', 'Fin'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ENDDATEAsc'])" sortDescending="@load(vm.comparators['ENDDATEDesc'])"  visible="@load(vm.isVisible('ENDDATE'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('VENCIMIENTO.label', 'Vencimiento'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VENCIMIENTOAsc'])" sortDescending="@load(vm.comparators['VENCIMIENTODesc'])"  visible="@load(vm.isVisible('VENCIMIENTO'))"/>
						
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('CONTABILIZADO.label', 'Contabilizado'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CONTABILIZADOAsc'])" sortDescending="@load(vm.comparators['CONTABILIZADODesc'])"  visible="@load(vm.isVisible('CONTABILIZADO'))"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='facturacion.zul')">
						
							             <label  value="@load(item.factura) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
							             <label  value="@load(item.fechafact) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
                                   <cell align="center">
                                          <label  value="@load(item.idcrmempresa.empresa) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                   </cell> 
						
                                   <cell align="center">
                                          <label  value="@load(item.iderpcomercial.nombre) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                   </cell> 
						
                                   <cell align="center">
                                          <label  value="@load(item.idcompany.nombre) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                          <label  value="@load(item.idcompany.retencion) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                          <label  value="@load(item.idcompany.cif) @converter(vm.fieldConverter)"></label>
                                        
                                      
                                    <space></space>
                                   </cell> 
						
                                   <cell align="center">
                                        
                                      
                                    <space></space>
                                              <label style="font-size:12px;" sclass="@load(vm.concat('fw-bolder badge rounded-pill ',item.iderpmestado.bgcolor))" value="@load(item.iderpmestado.estado) @converter(vm.fieldConverter)"></label>   
                                        
                                      
                                    <space></space>
                                   </cell> 
						
							                     <label  value="@load(item.impuestos) @converter(vm.fieldConverter,format='###,###,###,##0.00€')"></label>
							          
                                   
						
							                     <label  value="@load(item.subtotal) @converter(vm.fieldConverter,format='###,###,###,##0.00€')"></label>
							          
                                   
						
							                     <label  value="@load(item.total) @converter(vm.fieldConverter,format='###,###,###,##0.00€')"></label>
							          
                                   
						
                                   <cell align="center">
                                              <label style="font-size:12px;" sclass="@load(vm.concat('fw-bolder badge rounded-pill ',item.iderpmestadocbo.bgcolor))" value="@load(item.iderpmestadocbo.estado) @converter(vm.fieldConverter)"></label>   
                                        
                                      
                                    <space></space>
                                        
                                      
                                    <space></space>
                                   </cell> 
						
							             <label  value="@load(item.fecobro) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
							             <label  value="@load(item.fecsigned) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
							             <label  value="@load(item.enddate) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
							             <label  value="@load(item.vencimiento) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
						
							             <label  value="@load(item.contabilizado) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							
                  			
                  		<cell align="center">
						  
						<button
						onClick="@command('editData',item=item,page='facturacion.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"   />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn btn-square btn-outline-danger m-2"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							                <label value="@load(vm.totales['impuestos']) @converter(vm.fieldConverter,type='CURRENCY',format='###,###,###,##0.00€')"/>
							      </footer>
							      <footer>
							                <label value="@load(vm.totales['subtotal']) @converter(vm.fieldConverter,type='CURRENCY',format='###,###,###,##0.00€')"/>
							      </footer>
							      <footer>
							                <label value="@load(vm.totales['total']) @converter(vm.fieldConverter,type='CURRENCY',format='###,###,###,##0.00€')"/>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
 </div>						
</zk>						
