<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tipotarea" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tipotarea')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="tipotarea" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmomtipotask" />
	   <custom-attributes namespace="pmo" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<div id="hLflLHCklB"   visible="true"  class="col-lg-8 col-xlg-8 col-md-8">
  <div id="hLflLHCklB-card" class="card  bg-light shadow-xl" style="overflow:auto;" >
       <div id="hLflLHCklB-body" class="card-body ">
        <div id="hLflLHCklB-row" class="form-group row ">


				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('TIPOTASK'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPOTASK.label', 'Tipo de Tarea'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="fPvDzdGXyo" 
	   placeholder="@load(vm.lang.getProperty('TIPOTASK.label', 'Tipo de Tarea ( Incidencia, soporte,desarrollo...)'))" 
	   value="@bind(vm.beanData.tipotask) @save(vm.beanData.tipotask, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('TIPOTASK'))" disabled="@load(vm.isEditable('TIPOTASK')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['fPvDzdGXyo'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-12 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('RESUMEN'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('RESUMEN.label', 'Resumen'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="640460" 
	   placeholder="@load(vm.lang.getProperty('RESUMEN.label', 'Resumen'))" 
	   value="@bind(vm.beanData.resumen) @save(vm.beanData.resumen, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('RESUMEN'))" disabled="@load(vm.isEditable('RESUMEN')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['640460'])"/>
	   
    </h:div>   




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
<div id="RNYbkdwCnw"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="RNYbkdwCnw-card" class="card  bg-light" style="overflow:auto;" >
       <div id="RNYbkdwCnw-body" class="card-body ">
        <div id="RNYbkdwCnw-row" class="form-group row ">

<h:div class="col-md-4">
<hbox spacing="3px">
	    <label value="@load(vm.lang['AVATAR.label'])"/>
</hbox>

      <h:div class="image-cropper-container" style="width:100px;  height:100px;" >
     <image id="AVATAR" sclass="image-download" content="@load(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['tipotarea.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 



                  
                 


                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tipotarea');
  binder.command('doLoad');
});
function loadtipotarea(){
  var binder = zkbind.$('$tipotarea');
  binder.command('doLoadBean');

}
</script>	
</zk>