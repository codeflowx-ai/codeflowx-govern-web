<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tiporequisito" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tiporequisito')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="tiporequisito" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmotiporeq" />
	   <custom-attributes namespace="pmo" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="sJtDYGkfZj" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="sJtDYGkfZj-row" class="row">


				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('TIPOREQUISITO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPOREQUISITO.label', 'Tipo de requisito'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="eBxkbdMOlh" 
	   placeholder="@load(vm.lang.getProperty('TIPOREQUISITO.label', 'Tipo de requisito'))" 
	   value="@bind(vm.beanData.tiporequisito) @save(vm.beanData.tiporequisito, before=('grabar')) @validator(vm.unique, field='TIPOREQUISITO', oldValue=vm.beanDataCpy.tiporequisito)"  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('TIPOREQUISITO'))" disabled="@load(vm.isEditable('TIPOREQUISITO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['eBxkbdMOlh'])"/>
	   
    </h:div>   






 <h:div class="col-md-6 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ADJUNTARDOC'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ADJUNTARDOC.label', 'Debe adjuntar documento'))"/>
	   </hbox>
 <checkbox mold="default" id="vtCjyyJvul" value="@bind(vm.beanData.adjuntardoc) @save(vm.beanData.adjuntardoc, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('ADJUNTARDOC'))" disabled="@load(vm.isEditable('ADJUNTARDOC')?false:true)" checked="@bind(vm.beanData.adjuntardoc) @save(vm.beanData.adjuntardoc, before=('grabar'))"/>
</h:div>




   <h:div class="col-md-4">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Ayuda al cliente'))"/>
	   </hbox>
	  <tbeditor id="byfKFLpnFQ" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>




   <h:div class="col-md-8">
     <hbox spacing="3px">
	    <label sclass="form-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('TEMPLATE.label', 'Plantilla a cumplimentar'))"/>
	   </hbox>
	  <tbeditor id="xSUnwKrNCW" value="@bind(vm.beanData.template) @save(vm.beanData.template, before=('grabar')) " />
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['tiporequisito.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 





                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tiporequisito');
  binder.command('doLoad');
});
function loadtiporequisito(){
  var binder = zkbind.$('$tiporequisito');
  binder.command('doLoadBean');

}
</script>	
</zk>