<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="perfiles" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='perfiles')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="perfiles" />
<custom-attributes clase="org.suinsit.apps.pmo.Pmomperfil" />
	   <custom-attributes namespace="pmo" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="DZcaCHQWhS" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="DZcaCHQWhS-row" class="row">


				


   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PERFIL'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PERFIL.label', 'Perfil'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="482249" 
	   placeholder="@load(vm.lang.getProperty('PERFIL.label', 'desarrollador, jefe de proyecto, analista, arquitecto'))" 
	   value="@bind(vm.beanData.perfil) @save(vm.beanData.perfil, before=('grabar')) @validator(vm.unique, field='PERFIL', oldValue=vm.beanDataCpy.perfil)"  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('PERFIL'))" disabled="@load(vm.isEditable('PERFIL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['482249'])"/>
	   
    </h:div>   






 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('INTERNO'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('INTERNO.label', 'Personal interno'))"/>
	   </hbox>
 <checkbox mold="default" id="wHrujTjseI" value="@bind(vm.beanData.interno) @save(vm.beanData.interno, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('INTERNO'))" disabled="@load(vm.isEditable('INTERNO')?false:true)" checked="@bind(vm.beanData.interno) @save(vm.beanData.interno, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('EXTERNO'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('EXTERNO.label', 'Personal Externo'))"/>
	   </hbox>
 <checkbox mold="default" id="zFGOltyWhe" value="@bind(vm.beanData.externo) @save(vm.beanData.externo, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('EXTERNO'))" disabled="@load(vm.isEditable('EXTERNO')?false:true)" checked="@bind(vm.beanData.externo) @save(vm.beanData.externo, before=('grabar'))"/>
</h:div>



</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['perfiles.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 




                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$perfiles');
  binder.command('doLoad');
});
function loadperfiles(){
  var binder = zkbind.$('$perfiles');
  binder.command('doLoadBean');

}
</script>	
</zk>