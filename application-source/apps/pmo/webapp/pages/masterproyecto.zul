  <div class="col-md-6  input-group" visible="@load(vm.isVisible('FECHAFIN')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('FECHAFIN.label', 'Fecha Fin'))"/>
	  
	      <datebox     id="ZNdlmDWzAJ"  placeholder="@load(vm.lang.getProperty('FECHAFIN.label', 'Fecha Fin'))" tabindex="1" value="@bind(vm.beanData.fechafin) @save(vm.beanData.fechafin, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('FECHAFIN'))" disabled="@load(vm.isEditable('FECHAFIN')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['ZNdlmDWzAJ'])"/>   
    
      </div>






				

 <div class="col-md-6  input-group" visible="@load(vm.isVisible('BENEFICIOESPERA'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BENEFICIOESPERA.label', 'Beneficio Esperado'))"/>
	   
   <decimalbox   tabindex="2" id="qvfTwTHxrk" onCreate="" placeholder="@load(vm.lang.getProperty('BENEFICIOESPERA.label', 'Beneficio Esperado'))"   
    value="@bind(vm.beanData.beneficioespera) @save(vm.beanData.beneficioespera, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('BENEFICIOESPERA'))" disabled="@load(vm.isEditable('BENEFICIOESPERA')?false:true)" onChange="@command('onChangeInput',field='BENEFICIOESPERA',evento=event,componente=self,calculate=true)"/>
