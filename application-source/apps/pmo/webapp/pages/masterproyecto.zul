<div id="vChptodRCN"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="vChptodRCN-card" class="card  default shadow-xl" style="overflow:auto;" >
       <div id="vChptodRCN-body" class="card-body ">
        <div id="vChptodRCN-row" class="form-group row ">


				

  <!-- sclass="margin-field" -->
    <div class="col-md-3  input-group" visible="@load(vm.isVisible('CODPROYECTO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('CODPROYECTO.label', 'ID Proyecto'))"/>
	   
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.codproyecto)"  />
  </div>






				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('PROYECTO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))"  />
	   
	    <textbox   tabindex="2" id="BoEhyEHMNF" 
	   placeholder="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))" 
	   value="@bind(vm.beanData.proyecto) @save(vm.beanData.proyecto, before=('grabar')) @validator(vm.unique, field='PROYECTO',required=true ,oldValue=vm.beanDataCpy.proyecto)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('PROYECTO'))" disabled="@load(vm.isEditable('PROYECTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['BoEhyEHMNF'])"/>
            
	   
    </div>   






				

  <div class="col-md-3  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	  
	      <datebox     id="kXguMysveo"  placeholder="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" tabindex="3" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('ALTA'))" disabled="@load(vm.isEditable('ALTA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['kXguMysveo'])"/>   
    
      </div>





<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idcrmempresa.label', 'Cliente'))"/>
   
<h:div class="col-md-12">
<div >
<a  iconSclass="fa-duotone fa-magnifying-glass-waveform"  onClick="@command('findComboForeing',win=searchDtOIxyuktv,alias='idcrmempresa',input=tboxDtOIxyuktv) " /><a  iconSclass="fa-duotone fa-pen-to-square"   d:data-bs-toggle="modal" d:data-bs-target="#viewDtOIxyuktv" onClick="@command('editForeing',win=WIN_DtOIxyuktv,alias='idcrmempresa',body='body_DtOIxyuktv',page='popuppopempresas.zul',close='btn_DtOIxyuktv')" ></a>
<window id="WIN_DtOIxyuktv" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title"> Editar Empresas</h:h5>
</div>
<div class="modal-body" id="body_DtOIxyuktv"></div>
<div class="modal-footer"></div>
</div>
</window>
<a  iconSclass="fa-duotone fa-broom-wide"  onClick="@command('clearForeing',alias='idcrmempresa')">	</a>
</div>
</h:div>
<h:div class="mb-2">
<textbox id="tboxDtOIxyuktv"  placeholder="" value="@bind(vm.beanData.idcrmempresa.empresa) @save(vm.beanData.idcrmempresa.empresa, before=('grabar'))  " 
 onClick="@command('onChangeFindTextForeing',alias='idcrmempresa',att='empresa',event=event,idcp='cbDtOIxyuktv')" onChange="@command('onChangeFindTextForeing',alias='idcrmempresa',att='empresa',event=event,idcp='cbDtOIxyuktv')"  sclass="form-control  bg-light border-0" />
<combobox id="cbDtOIxyuktv" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idcrmempresa'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='false',alias='idcrmempresa',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.empresa}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxDtOIxyuktv'])"/></h:div>
<window id="searchDtOIxyuktv" mode="modal" visible="false">
<div class="modal-dialog modal-dialog-centered modal-lg">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title" id="examplesDtOIxyuktv">Empresas</h:h5>
<a id="btn_SDtOIxyuktv" class="btn-close"  onClick="searchDtOIxyuktv.visible=false" ></a>
</div><div class="modal-body">
<div sclass="mb-2">
<textbox sclass="form-control  bg-light border-0" placeholder="introduzca criterios..." onOK="@command('onChangeFindForeing',alias='idcrmempresa',att='empresa,',input=self)" onChange="@command('onChangeFindForeing',alias='idcrmempresa',att='empresa,',event=event)"/>
</div><div sclass="mb-2">
<listbox height="400px" mold="paging" pageSize="20" pagingPosition="bottom" model="@bind(vm.foreings['idcrmempresa'])" onSelect="@command('onSelectForeingPopup', alias='idcrmempresa',item=self.selectedItem.value,hidde=searchDtOIxyuktv,updatebean='false' )">
<listhead>
<listheader label="@load(vm.lang.getProperty('EMPRESA.label','Empresa'))"  />
</listhead>
<template name="model" var="item">
<listitem value="@load(item)">
<listcell label="@load(item.empresa)" />
</listitem></template></listbox>
</div></div></div></div></window>


  
</h:div>


         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





