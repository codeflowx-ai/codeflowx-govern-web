<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="templates" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='templates')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="templates" />
	<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqtemplateview" />
	   <custom-attributes namespace="arquitecturas" />
		<custom-attributes uid="29667" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('templates.screen', 'templates'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							       <a
									iconSclass="fa-duotone fa-solid fa-comment-question  align-middle fs-16 me-2"  	class="waves-effect waves-light"
									 onClick="WIN_HELP.setVisible(true)">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="jiBuJwAmRK"   visible="true"  class="col-lg-8 col-xlg-8 col-md-8">
  <div id="jiBuJwAmRK-card" class="card  default shadow-xl" style="overflow:hidden;" >
       <div id="jiBuJwAmRK-body" class="card-body ">
        <div id="jiBuJwAmRK-row" class="form-group row ">


				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('NOMBRE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Plantilla'))"  />
	   
	    <textbox   tabindex="1" id="cxxdaBXsVk" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'Plantilla'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['cxxdaBXsVk'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('VERSION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VERSION.label', 'Version'))"  />
	   
	    <textbox   tabindex="2" id="612337" 
	   placeholder="@load(vm.lang.getProperty('VERSION.label', 'Version'))" 
	   value="@bind(vm.beanData.version) @save(vm.beanData.version, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('VERSION'))" disabled="@load(vm.isEditable('VERSION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['612337'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('XMLNAME'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('XMLNAME.label', 'XmlName'))"  />
	   
	    <textbox   tabindex="3" id="86164" 
	   placeholder="@load(vm.lang.getProperty('XMLNAME.label', 'XmlName'))" 
	   value="@bind(vm.beanData.xmlname) @save(vm.beanData.xmlname, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('XMLNAME'))" disabled="@load(vm.isEditable('XMLNAME')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['86164'])"/>
            
	   
    </div>   






 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('POPUP'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('POPUP.label', 'Es Popup'))"/>
             <checkbox mold="default" id="LhdlRcuNIN" value="@bind(vm.beanData.popup) @save(vm.beanData.popup, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('POPUP'))" disabled="@load(vm.isEditable('POPUP')?false:true)" checked="@bind(vm.beanData.popup) @save(vm.beanData.popup, before=('grabar'))"/>	      
	     
 
</div>






<h:div class="col-md-3  input-group">
     <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('SCOPE.label', 'Ambito'))"/>
 


 <combobox mold="rounded" disabled="false"  sclass="" id="SCOPE" model="@load(vm.getEnums('SCOPE'))" 
selectedItem="@load(vm.beanData.scope)"  value="@load(vm.beanData.scope) @save(vm.beanData.scope, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['SCOPE'])"/>
</h:div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('CREATETABLE'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CREATETABLE.label', 'Puede Crear Tablas'))"/>
             <checkbox mold="default" id="aKazCZndir" value="@bind(vm.beanData.createtable) @save(vm.beanData.createtable, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('CREATETABLE'))" disabled="@load(vm.isEditable('CREATETABLE')?false:true)" checked="@bind(vm.beanData.createtable) @save(vm.beanData.createtable, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('MULTIPLEDATA'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MULTIPLEDATA.label', 'Multiples Tablas/Vistas'))"/>
             <checkbox mold="default" id="QswQXupNSO" value="@bind(vm.beanData.multipledata) @save(vm.beanData.multipledata, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('MULTIPLEDATA'))" disabled="@load(vm.isEditable('MULTIPLEDATA')?false:true)" checked="@bind(vm.beanData.multipledata) @save(vm.beanData.multipledata, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('DATAMODEL'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DATAMODEL.label', 'DataModel'))"/>
             <checkbox mold="default" id="864110" value="@bind(vm.beanData.datamodel) @save(vm.beanData.datamodel, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DATAMODEL'))" disabled="@load(vm.isEditable('DATAMODEL')?false:true)" checked="@bind(vm.beanData.datamodel) @save(vm.beanData.datamodel, before=('grabar'))"/>	      
	     
 
</div>






<h:div class="col-md-3  input-group">
     <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('MODEL.label', 'Model'))"/>
 


 <combobox mold="rounded" disabled="false"  sclass="" id="MODEL" model="@load(vm.getEnums('MODEL'))" 
selectedItem="@load(vm.beanData.model)"  value="@load(vm.beanData.model) @save(vm.beanData.model, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['MODEL'])"/>
</h:div>




<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarqmarchitecture.label', 'Arquitectura'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idarqmarchitecture" placeholder="@load(vm.lang.getProperty('idarqmarchitecture').label,'Arquitectura')" model="@bind(vm.foreings['idarqmarchitecture'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarqmarchitecture',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idarqmarchitecture)"  onCreate="@command('onCreateCombo',component=self,alias='idarqmarchitecture')" value="@bind(vm.beanData.idarqmarchitecture .arquitectura)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.arquitectura)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarqmarchitecture'])"/>

  
</h:div>


         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        





<div id="anQBKAJhKJ"   visible="true"  class="col-lg-4 col-xlg-4 col-md-4">
  <div id="anQBKAJhKJ-card" class="card  default shadow-xl" style="overflow:hidden;" >
       <div id="anQBKAJhKJ-body" class="card-body ">
        <div id="anQBKAJhKJ-row" class="form-group row ">

<h:div class="col-md-12 input-group">

	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))"/>



          <h:div class="image-cropper-container" style="width:200px;  height:200px;" >
     <image id="AVATAR" sclass="image-download" content="@load(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        






<div id="wUNIayDZcS" style="overflow:hidden;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="wUNIayDZcS-row" class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción Asistente'))"/>
	  
	  <tbeditor id="CiLxMTUuxr" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
</h:div>



</div>
</div>  


               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['templates.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
















		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
                               <html content="@load(vm.helpBean.texto)"/>
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$templates');
  binder.command('doLoad');
});
</script>
</zk>