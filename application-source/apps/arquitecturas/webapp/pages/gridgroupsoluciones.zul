					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('CODIGO.label', 'codigo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODIGOAsc'])" sortDescending="@load(vm.comparators['CODIGODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('SOLUCION.label', 'Solución'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SOLUCIONAsc'])" sortDescending="@load(vm.comparators['SOLUCIONDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('DESCORTA.label', 'descorta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCORTAAsc'])" sortDescending="@load(vm.comparators['DESCORTADesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ACTIVO.label', 'activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('VERSION.label', 'version'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VERSIONAsc'])" sortDescending="@load(vm.comparators['VERSIONDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('PRODUCCION.label', 'produccion'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PRODUCCIONAsc'])" sortDescending="@load(vm.comparators['PRODUCCIONDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							         <label  value="@load(item.getFieldByAtribute('CODIGO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('SOLUCION').value) @converter(vm.fieldConverter)"></label>
                                   
							       <label  value="@load(item.getFieldByAtribute('DESCORTA').value) @converter(vm.converter, type='HTML',size=60)"></label>
							         <label  value="@load(item.getFieldByAtribute('ACTIVO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('VERSION').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('PRODUCCION').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='mastersoluciones.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
