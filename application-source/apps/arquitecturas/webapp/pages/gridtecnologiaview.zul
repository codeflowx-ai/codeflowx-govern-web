<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"  visible="@load(vm.isVisible('AVATAR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ARQUITECTURA.label', 'Arquitectura'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ARQUITECTURAAsc'])" sortDescending="@load(vm.comparators['ARQUITECTURADesc'])"  visible="@load(vm.isVisible('ARQUITECTURA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CODE.label', 'Código'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODEAsc'])" sortDescending="@load(vm.comparators['CODEDesc'])"  visible="@load(vm.isVisible('CODE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DESCSHORT.label', 'Descripción Corta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCSHORTAsc'])" sortDescending="@load(vm.comparators['DESCSHORTDesc'])"  visible="@load(vm.isVisible('DESCSHORT'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastertecnologiaview.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="30%" height="30%" />
							             <label  value="@load(item.arquitectura) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.code) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.descshort) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='mastertecnologiaview.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
