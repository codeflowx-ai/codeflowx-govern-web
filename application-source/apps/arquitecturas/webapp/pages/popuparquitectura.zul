<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="arquitectura" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='arquitectura')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuparquitectura" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqmarchitecture" />
	   <custom-attributes namespace="arquitecturas" />
	      <custom-attributes uid="30021" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('arquitectura.screen', 'Arquitectura'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
							       <a
										iconSclass="fa-duotone fa-square-question"
									  class="waves-effect waves-light" 
									 onClick="WIN_HELP.setVisible(true)">
								</a>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">
<div id="ToCWIdhmgV"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="ToCWIdhmgV-card" class="card  default" style="overflow:auto;" >
       <div id="ToCWIdhmgV-body" class="card-body ">
        <div id="ToCWIdhmgV-row" class="form-group row ">

<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                 <tab label="Arquitectura" />      
                 <tab label="Descripción Ampliada" />      
                                <tab label="Documentación" />      
                 <tab label="Bases de datos" />      
                 <tab label="Avatar" />      
     </tabs>
