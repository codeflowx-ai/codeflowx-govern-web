        <div class="row">

<div class="col-md-6">
 <h:div class="col-md-6">
 <label sclass=" font-weight-normal align-text-middle" style="" value="Base de Datos"  />
   
    </h:div>
   

<listbox  checkmark="true"  model="@load(vm.foreings['idalmdatabase'])" height="300px" onCreate="@command('onSubtableCreate',alias='subarqrsoludata',loadOnDemand='true')" ><listhead><listheader label="Database"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.database)"></listcell></listitem></template></listbox>
</div>


