     </tabpanels>
</tabbox> 



</div>
</div>  





<div id="szqDrJdIGt" style="overflow:auto;" class=" default col-lg-3 col-xlg-3 col-md-3"  visible="true" >
<div id="szqDrJdIGt-row" class="row">

<h:div class="col-md-12 input-group">

	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))"/>



          <h:div class="image-cropper-container" style="width:200px;  height:200px;" >
     <image id="AVATAR" sclass="image-download" content="@load(vm.loadImage('AVATAR'))" width="100%" height="100%"/>
   </h:div>
     <dropupload maxsize="1024" detection="browser" anchor="${AVATAR}" content="Drag your image here (max 1024KB)"
	 onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />
   
 

</h:div>




