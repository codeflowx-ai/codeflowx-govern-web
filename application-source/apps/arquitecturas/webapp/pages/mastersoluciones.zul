<idspace  id="soluciones" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='soluciones')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="soluciones" />
	<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqsolucion" />
