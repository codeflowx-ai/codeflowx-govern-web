<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="flowprompt" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='flowprompt')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="flowprompt" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.arquitecturas.Arqrprompflow" />
	   <custom-attributes namespace="arquitecturas" />
	      <custom-attributes uid="10595" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('flowprompt.screen', 'Flujo de promp'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">
<div id="nUthpRUUFG"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="nUthpRUUFG-card" class="card  default shadow-lg" style="overflow:hidden;" >
       <div id="nUthpRUUFG-body" class="card-body ">
        <div id="nUthpRUUFG-row" class="form-group row ">


				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('DESCRIPCION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))"  />
	   
	    <textbox   tabindex="1" id="RUnhNjmdhX" 
	   placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', 'descripcion'))" 
	   value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['RUnhNjmdhX'])"/>
            
	   
    </div>   






 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('DOCUMENTO'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DOCUMENTO.label', 'Enviar documento'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="GIRFaRSSJP" value="@bind(vm.beanData.documento) @save(vm.beanData.documento, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DOCUMENTO'))" disabled="@load(vm.isEditable('DOCUMENTO')?false:true)" checked="@bind(vm.beanData.documento) @save(vm.beanData.documento, before=('grabar'))"/>
             </div>	      
	     
 
</div>





 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('USUARIO'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('USUARIO.label', 'Mensaje de usuario'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="JHoOfOJQQe" value="@bind(vm.beanData.usuario) @save(vm.beanData.usuario, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('USUARIO'))" disabled="@load(vm.isEditable('USUARIO')?false:true)" checked="@bind(vm.beanData.usuario) @save(vm.beanData.usuario, before=('grabar'))"/>
             </div>	      
	     
 
</div>





				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('ORDER'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ORDER.label', 'Orden Ejecución'))"/>
	
	      <intbox   tabindex="4" id="ekvPPAapHq"  placeholder="@load(vm.lang.getProperty('ORDER.label', 'order'))" sclass="  "  value="@bind(vm.beanData.order) @save(vm.beanData.order, before=('grabar')) " visible="@load(vm.isVisible('ORDER'))" disabled="@load(vm.isEditable('ORDER')?false:true)" onChange="@command('onChangeInput',field='ORDER',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['ekvPPAapHq'])"/>   
    
    </div>






 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('ASISTENTE'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ASISTENTE.label', 'Mensaje del asistente'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="zbbfxsoTua" value="@bind(vm.beanData.asistente) @save(vm.beanData.asistente, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('ASISTENTE'))" disabled="@load(vm.isEditable('ASISTENTE')?false:true)" checked="@bind(vm.beanData.asistente) @save(vm.beanData.asistente, before=('grabar'))"/>
             </div>	      
	     
 
</div>





 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('DATOS'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DATOS.label', 'Enviar Datos'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="HDSfUjrdCU" value="@bind(vm.beanData.datos) @save(vm.beanData.datos, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DATOS'))" disabled="@load(vm.isEditable('DATOS')?false:true)" checked="@bind(vm.beanData.datos) @save(vm.beanData.datos, before=('grabar'))"/>
             </div>	      
	     
 
</div>




<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idarprompchild.label', 'Prompt'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idarprompchild" placeholder="@load(vm.lang.getProperty('idarprompchild').label,'Prompt')" model="@bind(vm.foreings['idarprompchild'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idarprompchild',item=self.selectedItem.value,updatebean='true')"  		selectedItem="@load(vm.beanData.idarprompchild)"  onCreate="@command('onCreateCombo',component=self,alias='idarprompchild')" value="@bind(vm.beanData.idarprompchild .nombre)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.nombre)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idarprompchild'])"/>

  
</h:div>




 <div class="col-md-3   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('SENDPREVIO'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('SENDPREVIO.label', 'Enviar resultado anterior'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="switch" id="ujQsygeLhI" value="@bind(vm.beanData.sendprevio) @save(vm.beanData.sendprevio, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('SENDPREVIO'))" disabled="@load(vm.isEditable('SENDPREVIO')?false:true)" checked="@bind(vm.beanData.sendprevio) @save(vm.beanData.sendprevio, before=('grabar'))"/>
             </div>	      
	     
 
</div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['flowprompt.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 









                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$flowprompt');
  binder.command('doLoad');
});
function loadflowprompt(){
  var binder = zkbind.$('$flowprompt');
  binder.command('doLoadBean');

}
</script>	
</zk>