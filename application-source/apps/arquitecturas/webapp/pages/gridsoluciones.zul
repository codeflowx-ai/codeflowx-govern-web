<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"  visible="@load(vm.isVisible('AVATAR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CODIGO.label', 'Código'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODIGOAsc'])" sortDescending="@load(vm.comparators['CODIGODesc'])"  visible="@load(vm.isVisible('CODIGO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('SOLUCION.label', 'Solución'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SOLUCIONAsc'])" sortDescending="@load(vm.comparators['SOLUCIONDesc'])"  visible="@load(vm.isVisible('SOLUCION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DESCORTA.label', 'descorta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCORTAAsc'])" sortDescending="@load(vm.comparators['DESCORTADesc'])"  visible="@load(vm.isVisible('DESCORTA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACTIVO.label', 'activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])"  visible="@load(vm.isVisible('ACTIVO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('VERSION.label', 'version'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VERSIONAsc'])" sortDescending="@load(vm.comparators['VERSIONDesc'])"  visible="@load(vm.isVisible('VERSION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PRODUCCION.label', 'produccion'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PRODUCCIONAsc'])" sortDescending="@load(vm.comparators['PRODUCCIONDesc'])"  visible="@load(vm.isVisible('PRODUCCION'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastersoluciones.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="70%" height="70%" />
							             <label  value="@load(item.codigo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.solucion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							       <label  value="@load(item.descorta) @converter(vm.converter, type='HTML',size=60)"></label>
							             <label  value="@load(item.activo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.version) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.produccion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='mastersoluciones.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
