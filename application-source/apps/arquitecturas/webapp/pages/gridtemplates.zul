<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"  visible="@load(vm.isVisible('AVATAR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NOMBRE.label', 'Plantilla'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])"  visible="@load(vm.isVisible('NOMBRE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción Asistente'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCRIPCIONAsc'])" sortDescending="@load(vm.comparators['DESCRIPCIONDesc'])"  visible="@load(vm.isVisible('DESCRIPCION'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ARQMARCHITECTURE.label', 'ARQMARCHITECTURE'))" align="center"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('VERSION.label', 'Version'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VERSIONAsc'])" sortDescending="@load(vm.comparators['VERSIONDesc'])"  visible="@load(vm.isVisible('VERSION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('SCOPE.label', 'Ambito'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SCOPEAsc'])" sortDescending="@load(vm.comparators['SCOPEDesc'])"  visible="@load(vm.isVisible('SCOPE'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastertemplates.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="30%" height="30%" />
							             <label  value="@load(item.nombre) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							       <label  value="@load(item.descripcion) @converter(vm.converter, type='HTML',size=60)"></label>
                                   
                                          <label  value="@load(item.idarqmarchitecture.arquitectura) @converter(vm.fieldConverter)"></label>
                                   
							             <label  value="@load(item.version) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.scope) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='mastertemplates.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
