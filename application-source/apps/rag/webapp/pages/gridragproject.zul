<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROJECTCODE.label', 'Código Proyecto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROJECTCODEAsc'])" sortDescending="@load(vm.comparators['PROJECTCODEDesc'])"  visible="@load(vm.isVisible('PROJECTCODE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROJECTNAME.label', 'Nombre Proyecto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROJECTNAMEAsc'])" sortDescending="@load(vm.comparators['PROJECTNAMEDesc'])"  visible="@load(vm.isVisible('PROJECTNAME'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Cliente.label', 'Cliente'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterragproject.zul')">
							             <label  value="@load(item.projectcode) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.projectname) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idxcrmempresa.empresa) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterragproject.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
