<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="ragproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='ragproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="ragproject" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.rag.Ragproyecto" />
	   <custom-attributes namespace="rag" />
	      <custom-attributes uid="54466" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('ragproject.screen', 'Proyecto Rag'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="JRBFeiciZX" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="JRBFeiciZX-row" class="row">


				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('PROJECTCODE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROJECTCODE.label', 'Código Proyecto'))"  />
	   
	    <textbox   tabindex="1" id="GpOnLbuMbg" 
	   placeholder="@load(vm.lang.getProperty('PROJECTCODE.label', 'Código Proyecto'))" 
	   value="@bind(vm.beanData.projectcode) @save(vm.beanData.projectcode, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.projectcode)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('PROJECTCODE'))" disabled="@load(vm.isEditable('PROJECTCODE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['GpOnLbuMbg'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('PROJECTNAME'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROJECTNAME.label', 'Nombre Proyecto'))"  />
	   
	    <textbox   tabindex="2" id="fNzHviHYFB" 
	   placeholder="@load(vm.lang.getProperty('PROJECTNAME.label', 'Nombre Proyecto'))" 
	   value="@bind(vm.beanData.projectname) @save(vm.beanData.projectname, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.projectname)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('PROJECTNAME'))" disabled="@load(vm.isEditable('PROJECTNAME')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['fNzHviHYFB'])"/>
            
	   
    </div>   







<h:div class="col-md-3  input-group">
     <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('ESTADO.label', 'Estado'))"/>
 


 <combobox mold="rounded" disabled="false"  sclass="" id="ESTADO" model="@load(vm.getEnums('ESTADO'))" 
selectedItem="@load(vm.beanData.estado)"  value="@load(vm.beanData.estado) @save(vm.beanData.estado, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['ESTADO'])"/>
</h:div>





				

  <div class="col-md-3  input-group" visible="@load(vm.isVisible('FECHACREACION')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('FECHACREACION.label', 'Fecha Creación'))"/>
	  
	      <label sclass=" font-weight-normal align-text-middle" style="" value="@bind(vm.beanData.fechacreacion) @save(vm.beanData.fechacreacion, before=('grabar')) @converter(vm.fieldConverter,type='DATE')"/>
    
      </div>






				

    <div class="col-md-5  input-group" visible="@load(vm.isVisible('DESCRIPTION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DESCRIPTION.label', 'Descripción'))"  />
	   
	    <textbox   tabindex="5" id="gQubJhOJlt" 
	   placeholder="@load(vm.lang.getProperty('DESCRIPTION.label', 'Descripción'))" 
	   value="@bind(vm.beanData.description) @save(vm.beanData.description, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DESCRIPTION'))" disabled="@load(vm.isEditable('DESCRIPTION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['gQubJhOJlt'])"/>
            
	   
    </div>   






				

  <div class="col-md-3  input-group" visible="@load(vm.isVisible('FECHAMODIFICACION')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('FECHAMODIFICACION.label', 'Fecha Modificación'))"/>
	  
	      <datebox     id="YUnasraRea"  placeholder="@load(vm.lang.getProperty('FECHAMODIFICACION.label', 'Fecha Modificación'))" tabindex="6" value="@bind(vm.beanData.fechamodificacion) @save(vm.beanData.fechamodificacion, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('FECHAMODIFICACION'))" disabled="@load(vm.isEditable('FECHAMODIFICACION')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['YUnasraRea'])"/>   
    
      </div>





<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idxcrmempresa.label', 'CRMEMPRESA'))"/>
   
<h:div class="col-md-12">
<div >
<a  iconSclass="fa-duotone fa-magnifying-glass-waveform"  onClick="@command('findComboForeing',win=searchrjYDlAbOSA,alias='idxcrmempresa',input=tboxrjYDlAbOSA) " /><a  iconSclass="fa-duotone fa-pen-to-square"   d:data-bs-toggle="modal" d:data-bs-target="#viewrjYDlAbOSA" onClick="@command('editForeing',win=WIN_rjYDlAbOSA,alias='idxcrmempresa',body='body_rjYDlAbOSA',page='popuppopempresas.zul',close='btn_rjYDlAbOSA')" ></a>
<window id="WIN_rjYDlAbOSA" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title"> Editar Empresas</h:h5>
</div>
<div class="modal-body" id="body_rjYDlAbOSA"></div>
<div class="modal-footer"></div>
</div>
</window>
<a  iconSclass="fa-duotone fa-broom-wide"  onClick="@command('clearForeing',alias='idxcrmempresa')">	</a>
</div>
</h:div>
<h:div class="mb-2">
<textbox id="tboxrjYDlAbOSA"  placeholder="" value="@bind(vm.beanData.idxcrmempresa.empresa) @save(vm.beanData.idxcrmempresa.empresa, before=('grabar'))  " 
 onClick="@command('onChangeFindTextForeing',alias='idxcrmempresa',att='empresa',event=event,idcp='cbrjYDlAbOSA')" onChange="@command('onChangeFindTextForeing',alias='idxcrmempresa',att='empresa',event=event,idcp='cbrjYDlAbOSA')"  sclass="form-control  bg-light border-0" />
<combobox id="cbrjYDlAbOSA" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idxcrmempresa'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='false',alias='idxcrmempresa',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.empresa}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxrjYDlAbOSA'])"/></h:div>
<window id="searchrjYDlAbOSA" mode="modal" visible="false">
<div class="modal-dialog modal-dialog-centered modal-lg">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title" id="examplesrjYDlAbOSA">Empresas</h:h5>
<a id="btn_SrjYDlAbOSA" class="btn-close"  onClick="searchrjYDlAbOSA.visible=false" ></a>
</div><div class="modal-body">
<div sclass="mb-2">
<textbox sclass="form-control  bg-light border-0" placeholder="introduzca criterios..." onOK="@command('onChangeFindForeing',alias='idxcrmempresa',att='empresa,',input=self)" onChange="@command('onChangeFindForeing',alias='idxcrmempresa',att='empresa,',event=event)"/>
</div><div sclass="mb-2">
<listbox height="400px" mold="paging" pageSize="20" pagingPosition="bottom" model="@bind(vm.foreings['idxcrmempresa'])" onSelect="@command('onSelectForeingPopup', alias='idxcrmempresa',item=self.selectedItem.value,hidde=searchrjYDlAbOSA,updatebean='false' )">
<listhead>
<listheader label="@load(vm.lang.getProperty('EMPRESA.label','Empresa'))"  />
</listhead>
<template name="model" var="item">
<listitem value="@load(item)">
<listcell label="@load(item.empresa)" />
</listitem></template></listbox>
</div></div></div></div></window>


  
</h:div>



<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                                 <tab label="label" onCreate="@command('loadSubtableOnDemand',alias='subragdatasource')" />
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

 <!-- d:data-bs-toggle="modal" d:data-bs-target="#statictpkVPXQSKA-->
 <div class="col-lg-12">
 <a  tooltiptext="añadir nuevo registro" iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
		onClick="@command('appendSubtable',alias='subragdatasource',body='body_tpkVPXQSKA',namespace='rag',page='popupdatasource.zul',close='btn_tpkVPXQSKA',win=WIN_tpkVPXQSKA)" 
		disabled="@load(!vm.appendSubtable)" class="waves-effect waves-success">Añadir</a>
 </div>
 <!--	if(comp.getPropBeans().get("loadOnDemand")!=null) {-->
 <div class="col-lg-12">		
  <grid id="tpkVPXQSKA" height="400px" width="100%" 
   model="@bind(vm.grid['subragdatasource']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subragdatasource',body='body_tpkVPXQSKA',page='popupdatasource.zul',win=WIN_tpkVPXQSKA,loadOnDemand='false')" >
  <columns sizable="true">
	    <column label="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('ESTADO.label', 'Estado'))"   align="center" sclass="text-capitalize"/>
     
     
        <column align="center" />
	 </columns>
	   
       <template name="model" var="item">
      	 <row style="text-align:right;" >
				     <label  value="@load(item.nombre) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.tipo) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.estado) @converter(vm.fieldConverter)"></label>
               <cell align="center">
             <a 
						onClick="@command('editSubtable',alias='subragdatasource',body='body_tpkVPXQSKA',namespace='rag',page='popupdatasource.zul',close='btn_tpkVPXQSKA',item=item,win=WIN_tpkVPXQSKA)"
						 iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="waves-effect waves-success m-2" />
                    
						<a
						onClick="@command('removeSubtable',alias='subragdatasource',item=item )"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="waves-effect waves-danger m-2" />
		 </cell> 
       </row>
   	</template>
  </grid>
  </div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
