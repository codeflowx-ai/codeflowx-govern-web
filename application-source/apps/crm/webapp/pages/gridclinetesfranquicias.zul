<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CODCLIENTE.label', 'Código Cliente'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CODCLIENTEAsc'])" sortDescending="@load(vm.comparators['CODCLIENTEDesc'])"  visible="@load(vm.isVisible('CODCLIENTE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('EMPRESA.label', 'Empresa'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['EMPRESAAsc'])" sortDescending="@load(vm.comparators['EMPRESADesc'])"  visible="@load(vm.isVisible('EMPRESA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CIFNIF.label', 'NIF'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CIFNIFAsc'])" sortDescending="@load(vm.comparators['CIFNIFDesc'])"  visible="@load(vm.isVisible('CIFNIF'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CIUDAD.label', 'ciudad'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CIUDADAsc'])" sortDescending="@load(vm.comparators['CIUDADDesc'])"  visible="@load(vm.isVisible('CIUDAD'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterclinetesfranquicias.zul')">
							             <label  value="@load(item.codcliente) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.empresa) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.cifnif) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.ciudad) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterclinetesfranquicias.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
