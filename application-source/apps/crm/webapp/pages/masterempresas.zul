<combobox id="cbfcCgmeICGH" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idpropietario'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='false',alias='idpropietario',hidde=self)" width="85%">
