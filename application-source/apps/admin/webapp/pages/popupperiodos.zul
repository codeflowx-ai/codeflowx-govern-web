<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="periodos" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='periodos')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="periodos" />
<custom-attributes clase="org.suinsit.apps.admin.Mperidicidad" />
	   <custom-attributes namespace="admin" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<div id="ItNXWYuZEl"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="ItNXWYuZEl-card" class="card  shadow-lg" style="overflow:auto;" >
       <div id="ItNXWYuZEl-body" class="card-body ">
        <div id="ItNXWYuZEl-row" class="form-group row ">


				


   
    <h:div class="col-md-3 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('CODIGO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CODIGO.label', 'Código'))"  />
	   </hbox>
	   <textbox   tabindex="1" id="gMeIWizXfo" 
	   placeholder="@load(vm.lang.getProperty('CODIGO.label', 'Código'))" 
	   value="@bind(vm.beanData.codigo) @save(vm.beanData.codigo, before=('grabar')) @validator(vm.unique, field='CODIGO',required=true ,oldValue=vm.beanDataCpy.codigo)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('CODIGO'))" disabled="@load(vm.isEditable('CODIGO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['gMeIWizXfo'])"/>
	   
    </h:div>   






				


   
    <h:div class="col-md-3 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('PERIODO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PERIODO.label', 'Periodo'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="798296" 
	   placeholder="@load(vm.lang.getProperty('PERIODO.label', 'Periodo'))" 
	   value="@bind(vm.beanData.periodo) @save(vm.beanData.periodo, before=('grabar')) @validator(vm.unique, field='PERIODO',required=true ,oldValue=vm.beanDataCpy.periodo)"  sclass="margin-field form-control  form-control border-danger" 
	   visible="@load(vm.isVisible('PERIODO'))" disabled="@load(vm.isEditable('PERIODO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['798296'])"/>
	   
    </h:div>   






				


    <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('PERIDICIDAD'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PERIDICIDAD.label', 'Periodicidad/dias'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_PERIDICIDAD" />
	   </hbox>
	      <intbox   tabindex="3" id="udGYcBcdbc"  placeholder="@load(vm.lang.getProperty('PERIDICIDAD.label', 'Periodicidad Días'))" sclass="margin-field form-control  form-control "  value="@bind(vm.beanData.peridicidad) @save(vm.beanData.peridicidad, before=('grabar')) " visible="@load(vm.isVisible('PERIDICIDAD'))" disabled="@load(vm.isEditable('PERIDICIDAD')?false:true)" onChange="@command('onChangeInput',field='PERIDICIDAD',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['udGYcBcdbc'])"/>   
    
    </h:div>






				


    <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ALTA'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_ALTA" />
	   </hbox>
	      <datebox  readonly="true"   buttonVisible="false"  id="544740"  placeholder="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" tabindex="4" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('ALTA'))" disabled="@load(vm.isEditable('ALTA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['544740'])"/>   
    
      </h:div>






 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('ANONATURAL'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ANONATURAL.label', 'Trimestre Natural'))"/>
	   </hbox>
 <checkbox mold="default" id="492354" value="@bind(vm.beanData.anonatural) @save(vm.beanData.anonatural, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('ANONATURAL'))" disabled="@load(vm.isEditable('ANONATURAL')?false:true)" checked="@bind(vm.beanData.anonatural) @save(vm.beanData.anonatural, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('SEMESTRENATURAL'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('SEMESTRENATURAL.label', 'Semenstre Natural'))"/>
	   </hbox>
 <checkbox mold="default" id="ebInCJAHNq" value="@bind(vm.beanData.semestrenatural) @save(vm.beanData.semestrenatural, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('SEMESTRENATURAL'))" disabled="@load(vm.isEditable('SEMESTRENATURAL')?false:true)" checked="@bind(vm.beanData.semestrenatural) @save(vm.beanData.semestrenatural, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('TRIMESTRENATURAL'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('TRIMESTRENATURAL.label', 'Trimestre Natural'))"/>
	   </hbox>
 <checkbox mold="default" id="492354" value="@bind(vm.beanData.trimestrenatural) @save(vm.beanData.trimestrenatural, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('TRIMESTRENATURAL'))" disabled="@load(vm.isEditable('TRIMESTRENATURAL')?false:true)" checked="@bind(vm.beanData.trimestrenatural) @save(vm.beanData.trimestrenatural, before=('grabar'))"/>
</h:div>





 <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('MESNATURAL'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MESNATURAL.label', 'Mes Natural'))"/>
	   </hbox>
 <checkbox mold="default" id="820077" value="@bind(vm.beanData.mesnatural) @save(vm.beanData.mesnatural, before=('grabar'))" sclass="margin-field " visible="@load(vm.isVisible('MESNATURAL'))" disabled="@load(vm.isEditable('MESNATURAL')?false:true)" checked="@bind(vm.beanData.mesnatural) @save(vm.beanData.mesnatural, before=('grabar'))"/>
</h:div>





				


    <h:div class="col-md-3 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('DIAVTO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DIAVTO.label', 'Día Mes'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_DIAVTO" />
	   </hbox>
	      <intbox   tabindex="9" id="rWBpUEVMbD"  placeholder="@load(vm.lang.getProperty('DIAVTO.label', 'Día del mes'))" sclass="margin-field form-control  form-control "  value="@bind(vm.beanData.diavto) @save(vm.beanData.diavto, before=('grabar')) " visible="@load(vm.isVisible('DIAVTO'))" disabled="@load(vm.isEditable('DIAVTO')?false:true)" onChange="@command('onChangeInput',field='DIAVTO',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['rWBpUEVMbD'])"/>   
    
    </h:div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        

<div id="qBOesHcbQw" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="qBOesHcbQw-row" class="row">
</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['periodos.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 










                  
                 

                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$periodos');
  binder.command('doLoad');
});
function loadperiodos(){
  var binder = zkbind.$('$periodos');
  binder.command('doLoadBean');

}
</script>	
</zk>