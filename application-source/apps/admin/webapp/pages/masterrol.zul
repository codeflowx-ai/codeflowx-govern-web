<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="rol" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='rol')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="rol" />
	<custom-attributes clase="org.suinsit.apps.admin.Ssorol" />
	   <custom-attributes namespace="admin" />
		<custom-attributes uid="20" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('Rol.screen', 'Roles'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">



<div id="oekzWgTbbs" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="false" >
<div id="oekzWgTbbs-row" class="row">
</div>
</div>  





<div id="fohljqNjLX" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="false" >
<div id="fohljqNjLX-row" class="row">
</div>
</div>  





<div id="sUcbAQEfHT" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="false" >
<div id="sUcbAQEfHT-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('ROL'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('ROL.label', 'Rol'))"  />
	   
	    <textbox   tabindex="1" id="514414" 
	   placeholder="@load(vm.lang.getProperty('ROL.label', 'rol'))" 
	   value="@bind(vm.beanData.rol) @save(vm.beanData.rol, before=('grabar')) @validator(vm.unique, field='ROL',required=true ,oldValue=vm.beanDataCpy.rol)"  sclass="   bg-light text-dark border-danger" 
	   visible="@load(vm.isVisible('ROL'))" disabled="@load(vm.isEditable('ROL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['514414'])"/>
            
	   
    </div>   






 <div class="col-md-12   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('SYSTEM'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('SYSTEM.label', 'De sistemas'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="default" id="wcteaWLIfR" value="@bind(vm.beanData.system) @save(vm.beanData.system, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('SYSTEM'))" disabled="@load(vm.isEditable('SYSTEM')?false:true)" checked="@bind(vm.beanData.system) @save(vm.beanData.system, before=('grabar'))"/>
             </div>	      
	     
 
</div>





				

  <div class="col-md-12  input-group" visible="@load(vm.isVisible('BAJA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('BAJA.label', 'Baja'))"/>
	  
	      <datebox     id="365178"  placeholder="@load(vm.lang.getProperty('BAJA.label', 'baja'))" tabindex="3" value="@bind(vm.beanData.baja) @save(vm.beanData.baja, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('BAJA'))" disabled="@load(vm.isEditable('BAJA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['365178'])"/>   
    
      </div>




</div>
</div>  





<div id="jIaqunUiCr" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="jIaqunUiCr-row" class="row">
</div>
</div>  


               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['Rol.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>








		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$rol');
  binder.command('doLoad');
});
</script>
</zk>