<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="mens" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='mens')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="mens" />
	<custom-attributes clase="org.suinsit.apps.admin.Ssomenu" />
	   <custom-attributes namespace="admin" />
		<custom-attributes uid="31344" />
	   <custom-attributes tipo="MASTER" />
	      <custom-attributes reload="true" />
	      <custom-attributes reloadPage="mastermens.zul" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('Menús.screen', 'Menús'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							       <a
									iconSclass="fa-duotone fa-solid fa-comment-question  align-middle fs-16 me-2"  	class="waves-effect waves-light"
									 onClick="WIN_HELP.setVisible(true)">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="PnJJIDinbj"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="PnJJIDinbj-card" class="card  default" style="overflow:hidden;" >
       <div id="PnJJIDinbj-body" class="card-body ">
        <div id="PnJJIDinbj-row" class="form-group row ">


				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('MENU'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('MENU.label', 'Menú'))"  />
	   
	    <textbox   tabindex="1" id="mqJMJGleBe" 
	   placeholder="@load(vm.lang.getProperty('MENU.label', 'menu'))" 
	   value="@bind(vm.beanData.menu) @save(vm.beanData.menu, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.menu)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('MENU'))" disabled="@load(vm.isEditable('MENU')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['mqJMJGleBe'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('ICONO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ICONO.label', 'Icono'))"  />
	   
	    <textbox   tabindex="2" id="936366" 
	   placeholder="@load(vm.lang.getProperty('ICONO.label', 'icono'))" 
	   value="@bind(vm.beanData.icono) @save(vm.beanData.icono, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('ICONO'))" disabled="@load(vm.isEditable('ICONO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['936366'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('DESCRIPCION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))"  />
	   
	    <textbox   tabindex="3" id="IwAgklvqkS" 
	   placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', 'descripcion'))" 
	   value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['IwAgklvqkS'])"/>
            
	   
    </div>   





<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idssoaplicacion.label', 'Aplicación'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idssoaplicacion" placeholder="@load(vm.lang.getProperty('idssoaplicacion').label,'Aplicación')" model="@bind(vm.foreings['idssoaplicacion'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idssoaplicacion',item=self.selectedItem.value,changefk='idparent',updatebean='false')"  		selectedItem="@load(vm.beanData.idssoaplicacion)"  onCreate="@command('onCreateCombo',component=self,alias='idssoaplicacion')" value="@bind(vm.beanData.idssoaplicacion .aplicacion)@save(vm.beanData.idssoaplicacion.aplicacion, before=('grabar')) @validator(vm.validator,required=true)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(c:cat3(item.aplicacion,' ',item.namespace))" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idssoaplicacion'])"/>

  
</h:div>



<h:div class="col-md-3  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idparent.label', 'Menú Parent'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idparent" placeholder="@load(vm.lang.getProperty('idparent').label,'Menú Parent')" model="@bind(vm.foreings['idparent'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idparent',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idparent)"  onCreate="@command('onCreateCombo',component=self,alias='idparent',loadFkFrom='idssoaplicacion')" value="@bind(vm.beanData.idparent .menu)" disabled="@bind(vm.beanData.idssoaplicacion.idxaplicacion eq null) " ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.menu)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idparent'])"/>

  
</h:div>




				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('DASHBOARDPAGE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DASHBOARDPAGE.label', 'Página Dashboard'))"  />
	   
	    <textbox   tabindex="6" id="KhmCJtZmuQ" 
	   placeholder="@load(vm.lang.getProperty('DASHBOARDPAGE.label', 'Página Dashboard'))" 
	   value="@bind(vm.beanData.dashboardpage) @save(vm.beanData.dashboardpage, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DASHBOARDPAGE'))" disabled="@load(vm.isEditable('DASHBOARDPAGE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['KhmCJtZmuQ'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('TITLE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TITLE.label', 'Titulo'))"  />
	   
	    <textbox   tabindex="7" id="RUXYqxusek" 
	   placeholder="@load(vm.lang.getProperty('TITLE.label', 'Titulo'))" 
	   value="@bind(vm.beanData.title) @save(vm.beanData.title, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('TITLE'))" disabled="@load(vm.isEditable('TITLE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['RUXYqxusek'])"/>
            
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('NAMESPACE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))"  />
	   
	    <textbox   tabindex="8" id="535080" 
	   placeholder="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))" 
	   value="@bind(vm.beanData.namespace) @save(vm.beanData.namespace, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('NAMESPACE'))" disabled="@load(vm.isEditable('NAMESPACE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['535080'])"/>
            
	   
    </div>   





<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                                 <tab label="SubMenus" onCreate="@command('loadSubtableOnDemand',alias='subssomenuitem')" />
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

 <!-- d:data-bs-toggle="modal" d:data-bs-target="#staticuWBoxcXofW-->
 <div class="col-lg-12">
 <a  tooltiptext="añadir nuevo registro" iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
		onClick="@command('appendSubtable',alias='subssomenuitem',body='body_uWBoxcXofW',namespace='admin',page='popuppopmenuitems.zul',close='btn_uWBoxcXofW',win=WIN_uWBoxcXofW)" 
		disabled="@load(!vm.appendSubtable)" class="waves-effect waves-success">Nuevo Submenú</a>
 </div>
 <!--	if(comp.getPropBeans().get("loadOnDemand")!=null) {-->
 <div class="col-lg-12">		
  <grid id="uWBoxcXofW" height="400px" width="100%" 
   model="@bind(vm.grid['subssomenuitem']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subssomenuitem',body='body_uWBoxcXofW',page='popuppopmenuitems.zul',win=WIN_uWBoxcXofW,loadOnDemand='false')" >
  <columns sizable="true">
	    <column label="@load(vm.lang.getProperty('ITEM.label', ''))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('PAGE.label', 'PAGE'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('NAMESPACE.label', 'NAMESPACE'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('DASHBOARD.label', 'DASHBOARD'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('URL.label', 'URL'))"   align="center" sclass="text-capitalize"/>
     
        <column align="center" />
	 </columns>
	   
       <template name="model" var="item">
      	 <row style="text-align:right;" >
				     <label  value="@load(item.item) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.page) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.namespace) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.dashboard) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.url) @converter(vm.fieldConverter)"></label>
               <cell align="center">
             <a 
						onClick="@command('editSubtable',alias='subssomenuitem',body='body_uWBoxcXofW',namespace='admin',page='popuppopmenuitems.zul',close='btn_uWBoxcXofW',item=item,win=WIN_uWBoxcXofW)"
						 iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="waves-effect waves-success m-2" />
                    
						<a
						onClick="@command('removeSubtable',alias='subssomenuitem',item=item )"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="waves-effect waves-danger m-2" />
		 </cell> 
       </row>
   	</template>
  </grid>
  </div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        



               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['Menús.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>












  <window id="WIN_uWBoxcXofW" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="50%" height="70%">
				<div id="body_uWBoxcXofW" style="overflow: scroll;"></div>
  </window>
  
  
 <!-- 
  <h:div class="modal fade" id="staticuWBoxcXofW" tabindex="-1" aria-labelledby="exampleuWBoxcXofW" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content border-0">
                            <div class="modal-header bg-soft-info p-3">
                                <h:h5 class="modal-title" id="exampleuWBoxcXofW">Sub Menús</h:h5>
                                <h:button id="btn_uWBoxcXofW" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" ></h:button>
                            </div>
                            <div class="modal-body" id="body_uWBoxcXofW"></div>
                        </div>
                    </div>
                  </h:div> 
  -->                
		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
                               <html content="@load(vm.helpBean.texto)"/>
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$mens');
  binder.command('doLoad');
});
</script>
</zk>