<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('USUARIO.label', 'Usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USUARIOAsc'])" sortDescending="@load(vm.comparators['USUARIODesc'])"  visible="@load(vm.isVisible('USUARIO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('TIPOUSUARIO.label', 'Tipo de Usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOUSUARIOAsc'])" sortDescending="@load(vm.comparators['TIPOUSUARIODesc'])"  visible="@load(vm.isVisible('TIPOUSUARIO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])"  visible="@load(vm.isVisible('NOMBRE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('APELLIDOS.label', 'apellidos'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['APELLIDOSAsc'])" sortDescending="@load(vm.comparators['APELLIDOSDesc'])"  visible="@load(vm.isVisible('APELLIDOS'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterusuarios.zul')">
							             <label  value="@load(item.usuario) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.tipousuario) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.nombre) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.apellidos) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterusuarios.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
