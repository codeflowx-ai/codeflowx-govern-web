	      <intbox  readonly="true"  tabindex="3" id="ShjwPKXcwY"  placeholder="@load(vm.lang.getProperty('IDTUPLA.label', 'TUPLA'))" sclass="  "  value="@bind(vm.beanData.idtupla) @save(vm.beanData.idtupla, before=('grabar')) " visible="@load(vm.isVisible('IDTUPLA'))" disabled="@load(vm.isEditable('IDTUPLA')?false:true)" onChange="@command('onChangeInput',field='IDTUPLA',evento=event,componente=self,calculate=true)" />
