	    <textbox  readonly="true"  tabindex="1" id="82382" 
	   placeholder="@load(vm.lang.getProperty('APLICACION.label', 'Aplicacion'))" 
	   value="@bind(vm.beanData.aplicacion) @save(vm.beanData.aplicacion, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('APLICACION'))" disabled="@load(vm.isEditable('APLICACION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['82382'])"/>
            
	   
    </div>   






				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('MODULO'))" >
   
