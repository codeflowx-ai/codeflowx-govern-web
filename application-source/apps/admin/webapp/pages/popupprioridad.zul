<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="prioridad" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='prioridad')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="prioridad" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.admin.Mtipoprioridad" />
	   <custom-attributes namespace="admin" />
	      <custom-attributes uid="62172" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('Prioridad.screen', 'Prioridad'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="sBShCGujgz" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="sBShCGujgz-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('PRIORIDAD'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PRIORIDAD.label', 'Prioridad'))"  />
	   
	    <textbox   tabindex="1" id="cVOGiOADej" 
	   placeholder="@load(vm.lang.getProperty('PRIORIDAD.label', 'Prioridad'))" 
	   value="@bind(vm.beanData.prioridad) @save(vm.beanData.prioridad, before=('grabar')) @validator(vm.unique, field='PRIORIDAD',required=true ,oldValue=vm.beanDataCpy.prioridad)"  sclass="      border-danger" 
	   visible="@load(vm.isVisible('PRIORIDAD'))" disabled="@load(vm.isEditable('PRIORIDAD')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['cVOGiOADej'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('COLOR'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('COLOR.label', 'Color'))"  />
	   
	     <colorbox id="OklxdzMjzQ" width="30px" height="25px" value="@bind(vm.beanData.color) @save(vm.beanData.color, before=('grabar'))"/>
	   
    </div>   






				

  <div class="col-md-4  input-group" visible="@load(vm.isVisible('BAJA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BAJA.label', 'Fecha Baja'))"/>
	  
	      <datebox     id="ZkhbcNiFaK"  placeholder="@load(vm.lang.getProperty('BAJA.label', 'Fecha Baja'))" tabindex="3" value="@bind(vm.beanData.baja) @save(vm.beanData.baja, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('BAJA'))" disabled="@load(vm.isEditable('BAJA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['ZkhbcNiFaK'])"/>   
    
      </div>




</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['Prioridad.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 




                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$prioridad');
  binder.command('doLoad');
});
function loadprioridad(){
  var binder = zkbind.$('$prioridad');
  binder.command('doLoadBean');

}
</script>	
</zk>