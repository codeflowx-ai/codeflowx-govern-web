<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="aplicacion" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='aplicacion')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="aplicacion" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.admin.Aplicacion" />
	   <custom-attributes namespace="admin" />
	      <custom-attributes uid="74922" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('aplicacion.screen', 'Aplicaciones'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="uSHMIbAWeU" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="uSHMIbAWeU-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('APLICACION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('APLICACION.label', 'Aplicación'))"  />
	   
	    <textbox   tabindex="1" id="gjejuwgoQf" 
	   placeholder="@load(vm.lang.getProperty('APLICACION.label', 'Nombre descriptivo de la aplicación'))" 
	   value="@bind(vm.beanData.aplicacion) @save(vm.beanData.aplicacion, before=('grabar')) @validator(vm.unique, field='APLICACION',required=true ,oldValue=vm.beanDataCpy.aplicacion)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('APLICACION'))" disabled="@load(vm.isEditable('APLICACION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['gjejuwgoQf'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('ICONCLASS'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('ICONCLASS.label', 'Icono'))"  />
	   
	    <textbox   tabindex="2" id="dCkFVrsIpd" 
	   placeholder="@load(vm.lang.getProperty('ICONCLASS.label', 'Icono'))" 
	   value="@bind(vm.beanData.iconclass) @save(vm.beanData.iconclass, before=('grabar')) "  sclass="     " 
	   visible="@load(vm.isVisible('ICONCLASS'))" disabled="@load(vm.isEditable('ICONCLASS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['dCkFVrsIpd'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('NAMESPACE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))"  />
	   
	    <textbox   tabindex="3" id="595376" 
	   placeholder="@load(vm.lang.getProperty('NAMESPACE.label', 'Namespace'))" 
	   value="@bind(vm.beanData.namespace) @save(vm.beanData.namespace, before=('grabar')) "  sclass="     " 
	   visible="@load(vm.isVisible('NAMESPACE'))" disabled="@load(vm.isEditable('NAMESPACE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['595376'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('PREFIJO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('PREFIJO.label', 'Prefijo'))"  />
	   
	    <textbox   tabindex="4" id="915589" 
	   placeholder="@load(vm.lang.getProperty('PREFIJO.label', 'Prefijo'))" 
	   value="@bind(vm.beanData.prefijo) @save(vm.beanData.prefijo, before=('grabar')) "  sclass="     " 
	   visible="@load(vm.isVisible('PREFIJO'))" disabled="@load(vm.isEditable('PREFIJO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['915589'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('TITULO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('TITULO.label', 'Titulo / Menu'))"  />
	   
	    <textbox   tabindex="5" id="PrvIKtbiQv" 
	   placeholder="@load(vm.lang.getProperty('TITULO.label', 'Titulo / Menu'))" 
	   value="@bind(vm.beanData.titulo) @save(vm.beanData.titulo, before=('grabar')) "  sclass="     " 
	   visible="@load(vm.isVisible('TITULO'))" disabled="@load(vm.isEditable('TITULO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['PrvIKtbiQv'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('DASHBOARD'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style=" font-size:16px;" value="@load(vm.lang.getProperty('DASHBOARD.label', 'Dashboard'))"  />
	   
	    <textbox   tabindex="6" id="125577" 
	   placeholder="@load(vm.lang.getProperty('DASHBOARD.label', 'Dashboard'))" 
	   value="@bind(vm.beanData.dashboard) @save(vm.beanData.dashboard, before=('grabar')) "  sclass="     " 
	   visible="@load(vm.isVisible('DASHBOARD'))" disabled="@load(vm.isEditable('DASHBOARD')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['125577'])"/>
            
	   
    </div>   





   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('AYUDA.label', 'Ayuda'))"/>
	  
	      <textbox rows="4" cols="80" id="CaQjVOtMvt" multiline="true" 
	      placeholder="@load(vm.lang.getProperty('AYUDA.label', ''))" value="@bind(vm.beanData.ayuda) @save(vm.beanData.ayuda, before=('grabar')) "   visible="@load(vm.isVisible('AYUDA'))" disabled="@load(vm.isEditable('AYUDA')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['CaQjVOtMvt'])"/>
	     
</h:div>



</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['aplicacion.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 








                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$aplicacion');
  binder.command('doLoad');
});
function loadaplicacion(){
  var binder = zkbind.$('$aplicacion');
  binder.command('doLoadBean');

}
</script>	
</zk>