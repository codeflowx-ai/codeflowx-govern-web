<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="popusuerempleado" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='popusuerempleado')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popusuerempleado" />
	  
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<h:div class="col-lg-12 col-xlg-12 col-md-12">
  <h:div class="card " style="overflow:auto;" >
       <h:div class="card-body ">
        <h:div class="form-group row ">

<h:ul class="nav nav-tabs nav-border-top nav-border-top-primary mb-3" d:role="tablist">
      <h:li class="nav-item">
         <h:a class="nav-link  active " data-bs-toggle="tab" href="#lFpmyXxBMI" role="tab" aria-selected="true">Datos Usuario</h:a>
       </h:li>
      <h:li class="nav-item">
         <h:a class="nav-link " data-bs-toggle="tab" href="#JuZLakcfiB" role="tab" aria-selected="false">Permisos</h:a>
       </h:li>
</h:ul>
<h:div class="tab-content text-muted">
       <h:div id="lFpmyXxBMI" class="tab-pane  active " role="tabpanel">
          <h:div class="row">




   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('USUARIO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))"  />
	   </hbox>
	   <textbox   tabindex="0" id="905384" 
	   placeholder="@load(vm.lang.getProperty('USUARIO.label', 'usuario'))" 
	   value="@bind(vm.beanData.usuario) @save(vm.beanData.usuario, before=('store')) @validator(vm.unique, field='USUARIO',required=true ,oldValue=vm.beanDataCpy.usuario)"  sclass="margin-field form-control  form-control text-dark border-danger" 
	   visible="@load(vm.isVisible('USUARIO'))" disabled="@load(vm.isEditable('USUARIO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['905384'])"/>
    </h:div>   








      <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('PASSWORD'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style=" Font-Size:16px;" value="@load(vm.lang.getProperty('PASSWORD.label', 'Password'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_PASSWORD" />
	   </hbox>
       <textbox   tabindex="0" type="password"  id="36683" placeholder="@load(vm.lang.getProperty('PASSWORD.label', 'Password'))" value="@bind(vm.beanData.password) @save(vm.beanData.password, before=('store')) @validator(vm.validator,required=true ,type='PASSWORD' ,oldValue=vm.beanDataCpy.password)"  sclass="margin-field form-control  form-control text-dark border-danger" visible="@load(vm.isVisible('PASSWORD'))" disabled="@load(vm.isEditable('PASSWORD')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['36683'])"/>
    </h:div>   








   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('NOMBRE'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))"  />
	   </hbox>
	   <textbox   tabindex="0" id="996576" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('store')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.nombre)"  sclass="margin-field form-control  form-control text-dark border-danger" 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['996576'])"/>
    </h:div>   








   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('APELLIDOS'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('APELLIDOS.label', 'apellidos'))"  />
	   </hbox>
	   <textbox   tabindex="0" id="433831" 
	   placeholder="@load(vm.lang.getProperty('APELLIDOS.label', 'apellidos'))" 
	   value="@bind(vm.beanData.apellidos) @save(vm.beanData.apellidos, before=('store')) "  sclass="margin-field form-control text-dark" 
	   visible="@load(vm.isVisible('APELLIDOS'))" disabled="@load(vm.isEditable('APELLIDOS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['433831'])"/>
    </h:div>   








   
    <h:div class="col-md-6 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('EMAIL'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('EMAIL.label', 'email'))"  />
	   </hbox>
	   <textbox   tabindex="0" id="688462" 
	   placeholder="@load(vm.lang.getProperty('EMAIL.label', 'email'))" 
	   value="@bind(vm.beanData.email) @save(vm.beanData.email, before=('store')) @validator(vm.unique, field='EMAIL',required=true ,type='EMAIL' ,oldValue=vm.beanDataCpy.email)"  sclass="margin-field form-control  form-control text-dark border-danger" 
	   visible="@load(vm.isVisible('EMAIL'))" disabled="@load(vm.isEditable('EMAIL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['688462'])"/>
    </h:div>   





 <h:div class="col-md-12 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('LOCKED'))" sclass="margin-field" >
	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('LOCKED.label', 'Bloquear'))"/>
	   </hbox>
 <checkbox mold="switch" id="886120" value="@bind(vm.beanData.locked) @save(vm.beanData.locked, before=('store'))" sclass="margin-field " visible="@load(vm.isVisible('LOCKED'))" disabled="@load(vm.isEditable('LOCKED')?false:true)" checked="@bind(vm.beanData.locked) @save(vm.beanData.locked, before=('store'))"/>
</h:div>



          </h:div>
       </h:div>
       <h:div id="JuZLakcfiB" class="tab-pane " role="tabpanel">
          <h:div class="row">
<div class="col-md-6">
<listbox  checkmark="true"  model="@load(vm.foreings['idssorol'])" height="300px" onCreate="@command('onSubtableCreate',alias='subssoruserol')" ><listhead><listheader label="rol"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.rol)"></listcell></listitem></template></listbox>
</div>


<div class="col-md-6">
<listbox  checkmark="true"  model="@load(vm.foreings['idssoaplicacion'])" height="300px" onCreate="@command('onSubtableCreate',alias='subssoruserapp')" ><listhead><listheader label=""></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.aplicacion)"></listcell></listitem></template></listbox>
</div>


          </h:div>
       </h:div>
</h:div>



         </h:div> 
       </h:div>
  </h:div>
 </h:div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('store')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('storeNew')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['popusuerempleado.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popusuerempleado');
  binder.command('doLoad');
});
function loadpopusuerempleado(){
  var binder = zkbind.$('$popusuerempleado');
  binder.command('doLoadBean');

}
</script>	
</zk>