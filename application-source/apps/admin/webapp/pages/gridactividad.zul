<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('APLICACION.label', 'Aplicacion'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['APLICACIONAsc'])" sortDescending="@load(vm.comparators['APLICACIONDesc'])"  visible="@load(vm.isVisible('APLICACION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('USERNAME.label', 'User'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USERNAMEAsc'])" sortDescending="@load(vm.comparators['USERNAMEDesc'])"  visible="@load(vm.isVisible('USERNAME'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])"  visible="@load(vm.isVisible('ALTA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('MODULO.label', 'Modulo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['MODULOAsc'])" sortDescending="@load(vm.comparators['MODULODesc'])"  visible="@load(vm.isVisible('MODULO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACCION.label', 'Accion'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACCIONAsc'])" sortDescending="@load(vm.comparators['ACCIONDesc'])"  visible="@load(vm.isVisible('ACCION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROCESS.label', 'Process'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROCESSAsc'])" sortDescending="@load(vm.comparators['PROCESSDesc'])"  visible="@load(vm.isVisible('PROCESS'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('TASK.label', 'Task'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TASKAsc'])" sortDescending="@load(vm.comparators['TASKDesc'])"  visible="@load(vm.isVisible('TASK'))"/>
 							      <column  label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masteractividad.zul')">
							             <label  value="@load(item.aplicacion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.username) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.alta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.modulo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.accion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.process) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.task) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masteractividad.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
