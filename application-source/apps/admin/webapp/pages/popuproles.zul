<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="roles" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='roles')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="roles" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.admin.Ssorol" />
	   <custom-attributes namespace="admin" />
	      <custom-attributes uid="15061" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('Roles.screen', 'Roles'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="CWwwECSgrG" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="CWwwECSgrG-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('ROL'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="   " value="@load(vm.lang.getProperty('ROL.label', 'Rol'))"  />
	   
	    <textbox   tabindex="1" id="514414" 
	   placeholder="@load(vm.lang.getProperty('ROL.label', 'rol'))" 
	   value="@bind(vm.beanData.rol) @save(vm.beanData.rol, before=('grabar')) @validator(vm.unique, field='ROL',required=true ,oldValue=vm.beanDataCpy.rol)"  sclass="   bg-light text-dark border-danger" 
	   visible="@load(vm.isVisible('ROL'))" disabled="@load(vm.isEditable('ROL')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['514414'])"/>
            
	   
    </div>   






				

  <div class="col-md-4  input-group" visible="@load(vm.isVisible('BAJA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="   " value="@load(vm.lang.getProperty('BAJA.label', 'Fecha Baja'))"/>
	  
	      <datebox     id="DiMjlrvweT"  placeholder="@load(vm.lang.getProperty('BAJA.label', 'baja'))" tabindex="2" value="@bind(vm.beanData.baja) @save(vm.beanData.baja, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('BAJA'))" disabled="@load(vm.isEditable('BAJA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['DiMjlrvweT'])"/>   
    
      </div>






 <div class="col-md-4   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('SYSTEM'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="   " value="@load(vm.lang.getProperty('SYSTEM.label', 'Rol de sistema'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="default" id="HignmHkXkF" value="@bind(vm.beanData.system) @save(vm.beanData.system, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('SYSTEM'))" disabled="@load(vm.isEditable('SYSTEM')?false:true)" checked="@bind(vm.beanData.system) @save(vm.beanData.system, before=('grabar'))"/>
             </div>	      
	     
 
</div>






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('DASHBOARD'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="   " value="@load(vm.lang.getProperty('DASHBOARD.label', 'Pagina Principal Acceso'))"  />
	    <a iconSclass="bx bxs-message-square-dots" popup="pop_DASHBOARD" />
	   
	    <textbox   tabindex="4" id="RfCaXKVuPB" 
	   placeholder="@load(vm.lang.getProperty('DASHBOARD.label', 'Pagina Principal Acceso'))" 
	   value="@bind(vm.beanData.dashboard) @save(vm.beanData.dashboard, before=('grabar')) "  sclass="   bg-light text-dark" 
	   visible="@load(vm.isVisible('DASHBOARD'))" disabled="@load(vm.isEditable('DASHBOARD')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['RfCaXKVuPB'])"/>
            
	   
    </div>   
   <popup id="pop_DASHBOARD" width="200px">
          <groupbox sclass="z-demo-config" closable="false">
            <caption>Ayuda</caption>
            <span>
                <![CDATA[
                 Pagina Principal Acceso
                ]]>  
            </span>
         
        </groupbox>
 </popup>




</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['Roles.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 





                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$roles');
  binder.command('doLoad');
});
function loadroles(){
  var binder = zkbind.$('$roles');
  binder.command('doLoadBean');

}
</script>	
</zk>