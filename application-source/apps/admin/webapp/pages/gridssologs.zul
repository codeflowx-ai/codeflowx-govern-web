<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACCESO.label', 'acceso'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACCESOAsc'])" sortDescending="@load(vm.comparators['ACCESODesc'])"  visible="@load(vm.isVisible('ACCESO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DISPOSITIVO.label', 'dispositivo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DISPOSITIVOAsc'])" sortDescending="@load(vm.comparators['DISPOSITIVODesc'])"  visible="@load(vm.isVisible('DISPOSITIVO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('USERNAME.label', 'User name'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USERNAMEAsc'])" sortDescending="@load(vm.comparators['USERNAMEDesc'])"  visible="@load(vm.isVisible('USERNAME'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ERROR.label', 'Error'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ERRORAsc'])" sortDescending="@load(vm.comparators['ERRORDesc'])"  visible="@load(vm.isVisible('ERROR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('LOGIN.label', 'login'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['LOGINAsc'])" sortDescending="@load(vm.comparators['LOGINDesc'])"  visible="@load(vm.isVisible('LOGIN'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DIRIP.label', 'IP'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DIRIPAsc'])" sortDescending="@load(vm.comparators['DIRIPDesc'])"  visible="@load(vm.isVisible('DIRIP'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NAME.label', 'Nombre'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NAMEAsc'])" sortDescending="@load(vm.comparators['NAMEDesc'])"  visible="@load(vm.isVisible('NAME'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('MENSAJE.label', 'Mensaje'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['MENSAJEAsc'])" sortDescending="@load(vm.comparators['MENSAJEDesc'])"  visible="@load(vm.isVisible('MENSAJE'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterssologs.zul')">
							             <label  value="@load(item.acceso) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.dispositivo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.username) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.error) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.login) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.dirip) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.name) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.mensaje) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterssologs.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
