<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tiposervicio" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tiposervicio')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuptiposervicio" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.myalm.Almtiposervicio" />
	   <custom-attributes namespace="myalm" />
	      <custom-attributes uid="38836" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('tiposervicio.screen', 'Tipo de servicio'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="zDsEsHSfJE" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="zDsEsHSfJE-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('TIPO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))"  />
	   
	    <textbox   tabindex="1" id="23954" 
	   placeholder="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))" 
	   value="@bind(vm.beanData.tipo) @save(vm.beanData.tipo, before=('grabar')) @validator(vm.unique, field='TIPO',required=true ,oldValue=vm.beanDataCpy.tipo)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('TIPO'))" disabled="@load(vm.isEditable('TIPO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['23954'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('ACRONIMO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACRONIMO.label', 'Acronimo'))"  />
	   
	    <textbox   tabindex="2" id="325176" 
	   placeholder="@load(vm.lang.getProperty('ACRONIMO.label', 'Acronimo'))" 
	   value="@bind(vm.beanData.acronimo) @save(vm.beanData.acronimo, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.acronimo)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('ACRONIMO'))" disabled="@load(vm.isEditable('ACRONIMO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['325176'])"/>
            
	   
    </div>   






 <div class="col-md-2   input-grou" visible="@load(vm.isVisible('ACTIVO'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ACTIVO.label', 'Activo'))"/>
 <checkbox mold="default" id="785689" value="@bind(vm.beanData.activo) @save(vm.beanData.activo, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('ACTIVO'))" disabled="@load(vm.isEditable('ACTIVO')?false:true)" checked="@bind(vm.beanData.activo) @save(vm.beanData.activo, before=('grabar'))"/>
</div>





 <div class="col-md-2   input-grou" visible="@load(vm.isVisible('SDK'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SDK.label', 'SDK'))"/>
 <checkbox mold="default" id="441530" value="@bind(vm.beanData.sdk) @save(vm.beanData.sdk, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('SDK'))" disabled="@load(vm.isEditable('SDK')?false:true)" checked="@bind(vm.beanData.sdk) @save(vm.beanData.sdk, before=('grabar'))"/>
</div>





 <div class="col-md-2   input-grou" visible="@load(vm.isVisible('API'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('API.label', 'Api'))"/>
 <checkbox mold="default" id="912709" value="@bind(vm.beanData.api) @save(vm.beanData.api, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('API'))" disabled="@load(vm.isEditable('API')?false:true)" checked="@bind(vm.beanData.api) @save(vm.beanData.api, before=('grabar'))"/>
</div>




   <h:div class="col-md-8 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFORMACION.label', 'Información'))"/>
	  
	      <textbox rows="6" cols="80" id="sjShVukgKy" multiline="true" placeholder="@load(vm.lang.getProperty('INFORMACION.label', 'Ninguno'))" value="@bind(vm.beanData.informacion) @save(vm.beanData.informacion, before=('grabar')) "   visible="@load(vm.isVisible('INFORMACION'))" disabled="@load(vm.isEditable('INFORMACION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['sjShVukgKy'])"/>
	     
</h:div>



</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['tiposervicio.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tiposervicio');
  binder.command('doLoad');
});
function loadtiposervicio(){
  var binder = zkbind.$('$tiposervicio');
  binder.command('doLoadBean');

}
</script>	
</zk>