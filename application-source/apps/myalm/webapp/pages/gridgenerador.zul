<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
		
						 
<div class="table-responsive table-card">					 
					
				 <grid  	model="@load(vm.beans)" sizedByContent="true" span="true" sclass="table align-middle mb-0" >  
							<columns sizable="true" menupopup="auto">
							       <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('PROYECTOALM.label', 'Proyecto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROYECTOALMAsc'])" sortDescending="@load(vm.comparators['PROYECTOALMDesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('GENERACION.label', 'Fecha Generación'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['GENERACIONAsc'])" sortDescending="@load(vm.comparators['GENERACIONDesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('USUARIO.label', 'Usuario'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['USUARIOAsc'])" sortDescending="@load(vm.comparators['USUARIODesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('SCM.label', 'SCM'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SCMAsc'])" sortDescending="@load(vm.comparators['SCMDesc'])"/>
							       <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('BRANCH.label', 'Branch'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BRANCHAsc'])" sortDescending="@load(vm.comparators['BRANCHDesc'])"/>
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastergenerador.zul')">
							           <label  value="@load(item.idalmproject.proyectoalm) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.generacion) @converter(vm.fieldConverter)"></label>
                                   
							           <label  value="@load(item.idssousuario.usuario) @converter(vm.fieldConverter)"></label>
                                   
							           <label  value="@load(item.idalmscm.scm) @converter(vm.fieldConverter)"></label>
                                   
							          <label  value="@load(item.branch) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						  
						<button
						onClick="@command('editData',item=item,page='mastergenerador.zul')"
						iconSclass="fa-duotone fa-pen-to-square fa-xl" sclass="btn btn-square btn-outline-success m-2"    />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl"
						sclass="btn"   />
						
					    </cell>
					   </row>
                  		</template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
 </div>						
</zk>						
