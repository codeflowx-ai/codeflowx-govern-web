<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"  visible="@load(vm.isVisible('AVATAR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ALMCODE.label', 'ALM Code'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALMCODEAsc'])" sortDescending="@load(vm.comparators['ALMCODEDesc'])"  visible="@load(vm.isVisible('ALMCODE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROYECTOALM.label', 'Proyecto'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROYECTOALMAsc'])" sortDescending="@load(vm.comparators['PROYECTOALMDesc'])"  visible="@load(vm.isVisible('PROYECTOALM'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Cliente.label', 'Cliente'))" align="center"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Arquitectura.label', 'Arquitectura'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterproyectos.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="30%" height="30%" />
							             <label  value="@load(item.almcode) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.proyectoalm) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idcrmempresa.empresa) @converter(vm.fieldConverter)"></label>
                                   
                                   
                                          <label  value="@load(item.idarqmarchitecture.arquitectura) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterproyectos.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
