<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="entorno" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='entorno')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="entorno" />
	<custom-attributes clase="org.suinsit.apps.myalm.Almenviroment" />
	   <custom-attributes namespace="myalm" />
		<custom-attributes uid="31105" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('entorno.screen', 'entorno'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">



<div id="eJCHamlVij" style="overflow:auto;" class=" default col-lg-6 col-xlg-6 col-md-6"  visible="true" >
<div id="eJCHamlVij-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('ENVIROMENT'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ENVIROMENT.label', 'Entorno'))"  />
	   
	    <textbox   tabindex="1" id="oVmnzfDDmw" 
	   placeholder="@load(vm.lang.getProperty('ENVIROMENT.label', 'enviroment'))" 
	   value="@bind(vm.beanData.enviroment) @save(vm.beanData.enviroment, before=('grabar')) @validator(vm.unique, field='ENVIROMENT', oldValue=vm.beanDataCpy.enviroment)"  sclass="  " 
	   visible="@load(vm.isVisible('ENVIROMENT'))" disabled="@load(vm.isEditable('ENVIROMENT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['oVmnzfDDmw'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="wzGboanvAx" style="overflow:auto;" class=" default col-lg-6 col-xlg-6 col-md-6"  visible="true" >
<div id="wzGboanvAx-row" class="row">


 <div class="col-md-12   input-grou" visible="@load(vm.isVisible('DEVELOPMENT'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DEVELOPMENT.label', 'Desarrollo'))"/>
             <checkbox mold="default" id="VlrjxGVyYA" value="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DEVELOPMENT'))" disabled="@load(vm.isEditable('DEVELOPMENT')?false:true)" checked="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-12   input-grou" visible="@load(vm.isVisible('PRODUCTION'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PRODUCTION.label', 'Producción'))"/>
             <checkbox mold="default" id="BamdAyGNCA" value="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('PRODUCTION'))" disabled="@load(vm.isEditable('PRODUCTION')?false:true)" checked="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-12   input-grou" visible="@load(vm.isVisible('TESTING'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TESTING.label', 'Testing'))"/>
             <checkbox mold="default" id="853882" value="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('TESTING'))" disabled="@load(vm.isEditable('TESTING')?false:true)" checked="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-12   input-grou" visible="@load(vm.isVisible('PREPRODUCTION'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREPRODUCTION.label', 'Pre Produccion'))"/>
             <checkbox mold="default" id="AoPfLWNMMV" value="@bind(vm.beanData.preproduction) @save(vm.beanData.preproduction, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('PREPRODUCTION'))" disabled="@load(vm.isEditable('PREPRODUCTION')?false:true)" checked="@bind(vm.beanData.preproduction) @save(vm.beanData.preproduction, before=('grabar'))"/>	      
	     
 
</div>





				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('PREFIX'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREFIX.label', 'Prefix'))"  />
	   
	    <textbox   tabindex="5" id="317495" 
	   placeholder="@load(vm.lang.getProperty('PREFIX.label', 'Prefix'))" 
	   value="@bind(vm.beanData.prefix) @save(vm.beanData.prefix, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('PREFIX'))" disabled="@load(vm.isEditable('PREFIX')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['317495'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="mLOvnsbErb" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="mLOvnsbErb-row" class="row">
</div>
</div>  


               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['entorno.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>










		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$entorno');
  binder.command('doLoad');
});
</script>
</zk>