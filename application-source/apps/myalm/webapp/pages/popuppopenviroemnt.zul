<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="popenviroemnt" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='popenviroemnt')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuppopenviroemnt" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.myalm.Almenviroment" />
	   <custom-attributes namespace="myalm" />
	      <custom-attributes uid="80815" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('popenviroemnt.screen', 'enviroment'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="bMUQecTeBh" style="overflow:auto;" class=" default col-lg-10 col-xlg-10 col-md-10"  visible="true" >
<div id="bMUQecTeBh-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('ENVIROMENT'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ENVIROMENT.label', 'Entorno'))"  />
	   
	    <textbox   tabindex="1" id="FHCyfHwfGw" 
	   placeholder="@load(vm.lang.getProperty('ENVIROMENT.label', 'Producción, Desarrollo, Test'))" 
	   value="@bind(vm.beanData.enviroment) @save(vm.beanData.enviroment, before=('grabar')) @validator(vm.unique, field='ENVIROMENT', oldValue=vm.beanDataCpy.enviroment)"  sclass="  " 
	   visible="@load(vm.isVisible('ENVIROMENT'))" disabled="@load(vm.isEditable('ENVIROMENT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['FHCyfHwfGw'])"/>
            
	   
    </div>   






 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('DEVELOPMENT'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DEVELOPMENT.label', 'Entorno Desarrollo'))"/>
             <checkbox mold="default" id="EjDGDemySS" value="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DEVELOPMENT'))" disabled="@load(vm.isEditable('DEVELOPMENT')?false:true)" checked="@bind(vm.beanData.development) @save(vm.beanData.development, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('TESTING'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TESTING.label', 'Entorno de testing'))"/>
             <checkbox mold="default" id="lhktvtaCTa" value="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('TESTING'))" disabled="@load(vm.isEditable('TESTING')?false:true)" checked="@bind(vm.beanData.testing) @save(vm.beanData.testing, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('PREPRODUCTION'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREPRODUCTION.label', 'Entorno Pre producción'))"/>
             <checkbox mold="default" id="NlRKrJhgJl" value="@bind(vm.beanData.preproduction) @save(vm.beanData.preproduction, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('PREPRODUCTION'))" disabled="@load(vm.isEditable('PREPRODUCTION')?false:true)" checked="@bind(vm.beanData.preproduction) @save(vm.beanData.preproduction, before=('grabar'))"/>	      
	     
 
</div>





 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('PRODUCTION'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PRODUCTION.label', 'Entorno de producción'))"/>
             <checkbox mold="default" id="wROuvNHiTh" value="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('PRODUCTION'))" disabled="@load(vm.isEditable('PRODUCTION')?false:true)" checked="@bind(vm.beanData.production) @save(vm.beanData.production, before=('grabar'))"/>	      
	     
 
</div>





				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('PREFIX'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PREFIX.label', 'Prefijo DNS'))"  />
	   
	    <textbox   tabindex="6" id="RCBiqjdeoz" 
	   placeholder="@load(vm.lang.getProperty('PREFIX.label', 'desa,pre,test'))" 
	   value="@bind(vm.beanData.prefix) @save(vm.beanData.prefix, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('PREFIX'))" disabled="@load(vm.isEditable('PREFIX')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['RCBiqjdeoz'])"/>
            
	   
    </div>   




</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['popenviroemnt.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popenviroemnt');
  binder.command('doLoad');
});
function loadpopenviroemnt(){
  var binder = zkbind.$('$popenviroemnt');
  binder.command('doLoadBean');

}
</script>	
</zk>