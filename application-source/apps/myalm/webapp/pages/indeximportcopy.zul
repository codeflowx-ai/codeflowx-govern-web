
<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<idspace viewModel="@id('vm') @init('org.suinsit.nocode.web.FindEntityUI')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="importcopy" />
	   
	<custom-attributes clase="org.suinsit.apps.myalm.Almimportcopy" />
	   <custom-attributes namespace="myalm" />
	   <custom-attributes uid="17286" />
	   <custom-attributes tipo="SEARCH" />
	  <custom-attributes paginaIndex="indeximportcopy.zul" />
	   <custom-attributes templateView="gridimportcopy.zul" />
	   <h:div id="notificacion"></h:div>
	   
	   
	   
	 <div class="row  " style="background-color:;">
		 <div class="col-12   " style="">
			<div class="section header section-suinsit">
              <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('importcopy.screen', 'Importar Copys'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                <label value="@load(vm.labelTotal)"></label>
             </div>
             <div class="right">
                <h:p>	${ds.menu}  / Importar Copys</h:p>
             </div>
          </div>
	    </div>
	    
        <div class="section-prod actions">
          <div class="left">
				  <button iconSclass="fa-duotone fa-grid-2-plus me-1 align-bottom"
						 class="btn btn-primary mov-icon-hide" 	 onClick="@command('addData',page='masterimportcopy.zul')">
						Importar Copys
				</button>
        </div>
       <div class="right ic-hiden">
			<a 	
										iconSclass="fa-duotone fa-filters me-1 align-bottom"
										tooltiptext="Filtros"
										onClick="@command('onFilter', win=WIN_FILTERS)">
			</a> 
  <div class="dropdown">
 	    <h:i class="fa-duotone fa-file-export" aria-hidden="true"></h:i>
         <div class="dropdown-content">
           <a iconSclass="fa-duotone fa-file-pdf " onClick="@command('report',type='pdf')" >PDF</a>
           <a iconSclass="fa-duotone fa-file-xls " onClick="@command('report',type='excel')" >Excel</a>
           <a iconSclass="fa-duotone fa-file-csv" onClick="@command('report',type='CSV')" >CSV</a>
          <a iconSclass="fa-duotone fa-file-doc " onClick="@command('report',type='DOCX')" >Word</a>
       <a iconSclass="fa-duotone fa-chart-tree-map"
			onClick="@command('changeView',view='cardimportcopy.zul')">
			Card
	</a>
   <a iconSclass="fa-duotone fa-list"
		onClick="@command('changeView',view='gridimportcopy.zul')">
		List
</a>
  </div> 	    
 </div>
 <div class="dropdown">
                   <h:i class="fa-duotone fa-line-columns" aria-hidden="true"></h:i>
                       <div class="dropdown-content">
                          <vbox spacing="1px;">
								<checkbox label="Nombre" checked="@load(vm.isVisible('NOMBRE'))" onCheck="@command('onHidden', evento=event,field='NOMBRE' )"/>
								<checkbox label="Alta" checked="@load(vm.isVisible('ALTA'))" onCheck="@command('onHidden', evento=event,field='ALTA' )"/>
	                   </vbox>
                     </div> 	    
              </div>
   </div>
 </div>


        <div class="section filters">
              <div class="search-bar">
     </div>
    <div class="filter-icons">
               
              <a tooltiptext="Find"
					iconSclass="fa-duotone fa-magnifying-glass-waveform" 
										onClick="@command('search')" />
			<a tooltiptext="Clear"
					  iconSclass="fa-duotone fa-broom-wide" onClick="@command('clear')"  />
        </div>	
</div>
        <div class="section table-section">	
           <div class="card-body">
							<div id="divTemplate" sclass="col-lg-12"></div>
		  </div>
	   </div>

        <div class="section footer-prd">
            <div class="pagination">
                <paging id="topagin"
							pageSize="@load(vm.scroll.maxRows)"
							totalSize="@load(vm.scroll.totalRows)" mold="os" width="100%"
							 style="background-color:#FFF;"  />
							
            </div>
            <div class="records">
                <combobox
								selectedItem="@bind(vm.scroll.maxRows)"
								value="@bind(vm.scroll.maxRows)" width="75px">
								<comboitem label="30" value="30" />
								<comboitem label="50" value="50" />
								<comboitem label="100" value="100" />
							</combobox>
            </div>
     </div>	   
	</div>

	   <window id="WIN_showModal" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  >
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title"
						id="exampleModalLabel">
						Importar Copys
					</h:h5>

				</div>
				<div class="modal-body" id="body_importcopy"></div>
				<div class="modal-footer"></div>
			</div>
		</window>
	<window id="WIN_FILTERS" mode="modal" visible="false"
			position="center,center" action="show: slideDown;hide: slideUp"
			sclass="z-messagebox-window" border="none" width="90%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">Búsqueda Avanzada</h:h5>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-lg-2"></div>
						<div class="col-lg-8">
							<div class="row">
								<h:div class="col-md-3 ">
									<hbox spacing="3px"	>
										<label
											sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
											style="  "
											value="Nombre de la búsqueda" />
									</hbox>
									<textbox id="OXBshsbqpi"  
										placeholder="introduce un nombre para guardar tu búsqueda"
										sclass="margin-field form-control  form-control "
									/>
									  <label sclass="text-danger" value="@load(vmsgs['OXBshsbqpi'])"/>
								</h:div>
								<h:div class="col-md-3 ">
									<hbox spacing="3px"	>
										<label
											sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
											style="  "
											value="La consulta pueden usarla otros usuarios" />
									</hbox>
									<checkbox />
								</h:div>
								<h:div class="col-md-6 ">
								    <button
										class="btn btn-info"
										iconSclass="fa-duotone fa-magnifying-glass-play me-1 align-bottom"
										tooltiptext="Ejecutar Consulta"
										label="Ejecutar">
									</button>
									
									<button
										class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right me-1 align-bottom"
										tooltiptext="Grabar"
										 label="Guardar">
									</button>
								
									<button
										class="btn btn-soft-info waves effect waves-light"
										iconSclass="fa-duotone fa-broom-wide me-1 align-bottom"
										tooltiptext="limpiar Búsqueda"
										 label="Nueva">
									</button>
									
									
								</h:div>
							</div>

						</div>
						<div class="col-lg-2">
						      <button
										class="btn btn-square btn-outline-danger m-1"
										iconSclass="fa-light fa-nfc-trash fa-lg"
										tooltiptext="limpiar Búsqueda"
										 >
									</button>
						</div>
					</div>
					<space></space>
					<div class="row">
						<div class="col-lg-2">
							<listbox
								 height="500px">
								<listhead>
									<listheader label="Campo">
									</listheader>
								</listhead>
								<template name="model" var="item">
									<listitem value="@load(item)"
										draggable="true">
										<listcell
											label="@load(item.label)">
										</listcell>
									</listitem>
								</template>
							</listbox>

						</div>
						<div class="col-lg-8">
							<grid height="500px"
								
								
								emptyMessage="No hay condiciones...">
								<columns>
									<column label="Campo" width="10%" />
									<column label="Condición"
										width="80%" />
									<column label="Accion" width="10%" />
								</columns>
								<rows>

								</rows>
							</grid>
						</div>
						<div class="col-lg-2">
							<listbox height="500px"  checkmark="true" 
							
							 onSelect="@command('onSelectBusqueda',evento=event)">
								<listhead >
									<listheader label="Búsquedas">
									</listheader>
								</listhead>
								<template name="model" var="item">
									<listitem value="@load(item)" >
										<listcell
											label="@load(item.nombre)">
										</listcell>
									</listitem>
								</template>
							</listbox>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<div class="hstack gap-2 justify-content-end">
						<button onClick="WIN_FILTERS.setVisible(false)"
							class="btn btn-light">
							Cerrar
						</button>
					</div>
				</div>
			</div>
		</window>
  <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
	  
              
	</idspace>
</zk>