<combobox mold="rounded" autodrop="true"  id="idalmtiposervicio" placeholder="@load(vm.lang.getProperty('idalmtiposervicio').label,'Tipo de servicio')" model="@bind(vm.foreings['idalmtiposervicio'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idalmtiposervicio',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idalmtiposervicio)"  onCreate="@command('onCreateCombo',component=self,alias='idalmtiposervicio')" value="@bind(vm.beanData.idalmtiposervicio .tipo)@save(vm.beanData.idalmtiposervicio.tipo, before=('grabar')) @validator(vm.validator,required=true)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.tipo)" /></template></combobox>
