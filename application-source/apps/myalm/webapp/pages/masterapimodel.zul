<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                 <tab label="Información" />      
                                <tab label="Documentación" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFORMATION.label', ''))"/>
	  
	  <tbeditor id="DnPLKcjmAw" value="@bind(vm.beanData.information) @save(vm.beanData.information, before=('grabar')) " />
</h:div>



