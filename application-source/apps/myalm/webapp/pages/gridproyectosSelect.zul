<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">


	<div class="table-responsive table-card">

		<grid model="@load(vm.beans)" sizedByContent="true" span="true"
			sclass="table align-middle mb-0">
			<columns sizable="true" menupopup="auto">
				<column style="font-size:14px;"
					sclass=" text-capitalize " hflex="1"
					label="@load(vm.lang.getProperty('ALMCODE.label', 'ALM Code'))"
					align="center" sort="auto"
					sortAscending="@load(vm.comparators['ALMCODEAsc'])"
					sortDescending="@load(vm.comparators['ALMCODEDesc'])" />
				<column style="font-size:14px;"
					sclass=" text-capitalize " hflex="1"
					label="@load(vm.lang.getProperty('PROYECTOALM.label', 'Proyecto'))"
					align="center" sort="auto"
					sortAscending="@load(vm.comparators['PROYECTOALMAsc'])"
					sortDescending="@load(vm.comparators['PROYECTOALMDesc'])" />
				<column style="font-size:14px;"
					sclass=" text-capitalize " hflex="1"
					label="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"
					align="center" sort="auto"
					sortAscending="@load(vm.comparators['ALTAAsc'])"
					sortDescending="@load(vm.comparators['ALTADesc'])" />
				<column style="font-size:14px;"
					sclass=" text-capitalize " hflex="1"
					label="@load(vm.lang.getProperty('Cliente.label', 'Cliente'))"
					align="center" />
				<column style="font-size:14px;" hflex="1"
					label="Acciones" align="center" />
			</columns>
			<template name="model" var="item">
				<row style="text-align:right;cursor:pointer;"
					onClick="@command('editData',item=item,page='masterproyectos.zul')">
					<label
						value="@load(item.almcode) @converter(vm.fieldConverter)">
					</label>
					<label
						value="@load(item.proyectoalm) @converter(vm.fieldConverter)">
					</label>

					<label
						value="@load(item.alta) @converter(vm.fieldConverter)">
					</label>

					<cell align="center">
						<label
							value="@load(item.idcrmempresa.empresa) @converter(vm.fieldConverter)">
						</label>


						<space></space>
					</cell>


					<cell align="center">

						<button
							onClick="@global-command('selectProject',item=item)"
							iconSclass="mdi mdi-cog-clockwise" sclass="btn" />
						<space></space>


					</cell>
				</row>
			</template>
			<foot>
				<footer span="4" align="right"
					label="@load(vm.labelTotal)" />
			</foot>
		</grid>
	</div>
</zk>
