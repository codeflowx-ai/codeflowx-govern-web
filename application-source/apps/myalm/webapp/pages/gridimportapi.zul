<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])"  visible="@load(vm.isVisible('NOMBRE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])"  visible="@load(vm.isVisible('ALTA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('OPENAPI.label', 'Open Api'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['OPENAPIAsc'])" sortDescending="@load(vm.comparators['OPENAPIDesc'])"  visible="@load(vm.isVisible('OPENAPI'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('SWAGGER.label', 'Swagger'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['SWAGGERAsc'])" sortDescending="@load(vm.comparators['SWAGGERDesc'])"  visible="@load(vm.isVisible('SWAGGER'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('WSDL.label', 'Wsdl'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['WSDLAsc'])" sortDescending="@load(vm.comparators['WSDLDesc'])"  visible="@load(vm.isVisible('WSDL'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('JSON.label', 'Json'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['JSONAsc'])" sortDescending="@load(vm.comparators['JSONDesc'])"  visible="@load(vm.isVisible('JSON'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('API Service.label', 'API Service'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterimportapi.zul')">
							             <label  value="@load(item.nombre) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.alta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.openapi) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.swagger) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.wsdl) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.json) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idalmapimodel.nombre) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterimportapi.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
