  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$importdatabase');
  binder.command('doLoad');
});
function loadimportdatabase(){
  var binder = zkbind.$('$importdatabase');
  binder.command('doLoadBean');

}
</script>	
</zk>