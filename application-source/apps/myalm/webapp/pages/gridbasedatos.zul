<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])"  visible="@load(vm.isVisible('AVATAR'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DATABASE.label', 'Base de datos'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DATABASEAsc'])" sortDescending="@load(vm.comparators['DATABASEDesc'])"  visible="@load(vm.isVisible('DATABASE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('URLPATERN.label', 'Patrón URL'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['URLPATERNAsc'])" sortDescending="@load(vm.comparators['URLPATERNDesc'])"  visible="@load(vm.isVisible('URLPATERN'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('REVERSE.label', 'Reverse'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REVERSEAsc'])" sortDescending="@load(vm.comparators['REVERSEDesc'])"  visible="@load(vm.isVisible('REVERSE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CLOUD.label', 'Cloud'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CLOUDAsc'])" sortDescending="@load(vm.comparators['CLOUDDesc'])"  visible="@load(vm.isVisible('CLOUD'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACTIVO.label', 'Activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])"  visible="@load(vm.isVisible('ACTIVO'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterbasedatos.zul')">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="30%" height="30%" />
							             <label  value="@load(item.database) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.urlpatern) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.reverse) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.cloud) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.activo) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterbasedatos.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
