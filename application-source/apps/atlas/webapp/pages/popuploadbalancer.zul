<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="loadbalancer" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='loadbalancer')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuploadbalancer" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlbalancer" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="95433" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('loadbalancer.screen', 'Load balancer'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="sMSNqEpmZw" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="sMSNqEpmZw-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('BALANCER'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('BALANCER.label', 'Balancer'))"  />
	   
	    <textbox   tabindex="1" id="424431" 
	   placeholder="@load(vm.lang.getProperty('BALANCER.label', 'Balancer'))" 
	   value="@bind(vm.beanData.balancer) @save(vm.beanData.balancer, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('BALANCER'))" disabled="@load(vm.isEditable('BALANCER')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['424431'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('CLASSINGRESS'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CLASSINGRESS.label', 'Ingress Alias'))"  />
	   
	    <textbox   tabindex="2" id="dBeWERLNJE" 
	   placeholder="@load(vm.lang.getProperty('CLASSINGRESS.label', 'Ingress Alias'))" 
	   value="@bind(vm.beanData.classingress) @save(vm.beanData.classingress, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('CLASSINGRESS'))" disabled="@load(vm.isEditable('CLASSINGRESS')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['dBeWERLNJE'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('IPPUBLICA'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IPPUBLICA.label', 'IPs  Publicas'))"  />
	   
	    <textbox   tabindex="3" id="sgNakOtdHU" 
	   placeholder="@load(vm.lang.getProperty('IPPUBLICA.label', 'IPs  Publicas'))" 
	   value="@bind(vm.beanData.ippublica) @save(vm.beanData.ippublica, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('IPPUBLICA'))" disabled="@load(vm.isEditable('IPPUBLICA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['sgNakOtdHU'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('INGRESSDEPLOY'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('INGRESSDEPLOY.label', 'Ingress Deploy'))"  />
	   
	    <textbox   tabindex="4" id="441845" 
	   placeholder="@load(vm.lang.getProperty('INGRESSDEPLOY.label', 'Ingress Deploy'))" 
	   value="@bind(vm.beanData.ingressdeploy) @save(vm.beanData.ingressdeploy, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('INGRESSDEPLOY'))" disabled="@load(vm.isEditable('INGRESSDEPLOY')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['441845'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('IDPROVEEDOR'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'ID proveedor'))"  />
	   
	    <textbox   tabindex="5" id="631957" 
	   placeholder="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'ID proveedor'))" 
	   value="@bind(vm.beanData.idproveedor) @save(vm.beanData.idproveedor, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('IDPROVEEDOR'))" disabled="@load(vm.isEditable('IDPROVEEDOR')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['631957'])"/>
            
	   
    </div>   






				

 <div class="col-md-4  input-group" visible="@load(vm.isVisible('IMPORTEMES'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('IMPORTEMES.label', 'Coste Mensual'))"/>
	   
   <decimalbox   tabindex="6" id="KlOyqTxrvP" onCreate="" placeholder="@load(vm.lang.getProperty('IMPORTEMES.label', 'Coste Mensual'))"   
    value="@bind(vm.beanData.importemes) @save(vm.beanData.importemes, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('IMPORTEMES'))" disabled="@load(vm.isEditable('IMPORTEMES')?false:true)" onChange="@command('onChangeInput',field='IMPORTEMES',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['KlOyqTxrvP'])"/>
 
  </div>






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('ANCHOBANDA'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ANCHOBANDA.label', 'Velocidad / Ancho banda'))"/>
	
	      <intbox   tabindex="7" id="GoNRUVVbsA"  placeholder="@load(vm.lang.getProperty('ANCHOBANDA.label', 'Velocidad / Ancho banda'))" sclass="  "  value="@bind(vm.beanData.anchobanda) @save(vm.beanData.anchobanda, before=('grabar')) " visible="@load(vm.isVisible('ANCHOBANDA'))" disabled="@load(vm.isEditable('ANCHOBANDA')?false:true)" onChange="@command('onChangeInput',field='ANCHOBANDA',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['GoNRUVVbsA'])"/>   
    
    </div>




</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['loadbalancer.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 








                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$loadbalancer');
  binder.command('doLoad');
});
function loadloadbalancer(){
  var binder = zkbind.$('$loadbalancer');
  binder.command('doLoadBean');

}
</script>	
</zk>