       <label sclass="text-danger" value="@load(vmsgs['631269'])"/>
            
	   
    </div>   





<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlproveedor.label', 'Proveedor'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idatlproveedor" placeholder="@load(vm.lang.getProperty('idatlproveedor').label,'Proveedor')" model="@bind(vm.foreings['idatlproveedor'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idatlproveedor',item=self.selectedItem.value,changefk='idatlcloudproject',updatebean='false')"  		selectedItem="@load(vm.beanData.idatlproveedor)"  onCreate="@command('onCreateCombo',component=self,alias='idatlproveedor')" value="@bind(vm.beanData.idatlproveedor .proveedor)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.proveedor)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlproveedor'])"/>

  
</h:div>




				

 <div class="col-md-4  input-group" visible="@load(vm.isVisible('CTEESTIMADO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CTEESTIMADO.label', 'Coste Estimado'))"/>
	   
   <decimalbox   tabindex="0" id="dVmyukrXSa" onCreate="" placeholder="@load(vm.lang.getProperty('CTEESTIMADO.label', 'cteestimado'))"   
    value="@bind(vm.beanData.cteestimado) @save(vm.beanData.cteestimado, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('CTEESTIMADO'))" disabled="@load(vm.isEditable('CTEESTIMADO')?false:true)" onChange="@command('onChangeInput',field='CTEESTIMADO',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['dVmyukrXSa'])"/>
 
