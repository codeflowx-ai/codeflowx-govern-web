<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="cloudkube" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='cloudkube')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="cloudkube" />
	<custom-attributes clase="org.suinsit.apps.atlas.Atlkubecloud" />
	   <custom-attributes namespace="atlas" />
		<custom-attributes uid="46789" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('cloudkube.screen', 'Cloud Kubernetes'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')">
										
									</a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="peDZHigocB"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="peDZHigocB-card" class="card  default shadow-xl" style="overflow:auto;" >
       <div id="peDZHigocB-body" class="card-body ">
        <div id="peDZHigocB-row" class="form-group row ">

<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Proyecto" />      
                                  <tab label="Nodos"  onSelect="@command('loadSubtableOnDemand',alias='subatlnode')"/>      
                                  <tab label="Load Balancer"  onSelect="@command('loadSubtableOnDemand',alias='subatlbalancer')"/>      
                                  <tab label="Almacenamiento"  onSelect="@command('loadSubtableOnDemand',alias='subatlstorage')"/>      
                                  <tab label="Proyectos"  onSelect="@command('loadSubtableOnDemand',alias='subatlproject')"/>      
                 <tab label="Kube" />      
                 <tab label="Componentes Infraestructura" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">


				

  <!-- sclass="margin-field" -->
    <div class="col-md-4  input-group" visible="@load(vm.isVisible('REFERENCIA'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('REFERENCIA.label', 'Referencia'))"/>
	   
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.referencia)"  />
  </div>






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('CLUSTER'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('CLUSTER.label', 'Cluster'))"  />
	   
	    <textbox   tabindex="0" id="264110" 
	   placeholder="@load(vm.lang.getProperty('CLUSTER.label', 'cluster'))" 
	   value="@bind(vm.beanData.cluster) @save(vm.beanData.cluster, before=('grabar')) @validator(vm.unique, field='CLUSTER',required=true ,oldValue=vm.beanDataCpy.cluster)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('CLUSTER'))" disabled="@load(vm.isEditable('CLUSTER')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['264110'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('IDPROVEEDOR'))" >
   
