<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="componentproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='componentproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupcomponentproject" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlrproject" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="81415" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('componentproject.screen', 'Componentes de Proyectos'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="MdHxNrpkOt" style="overflow:auto;" class=" default col-lg-6 col-xlg-6 col-md-6"  visible="true" >
<div id="MdHxNrpkOt-row" class="row">


				

  <!-- sclass="margin-field" -->
    <div class="col-md-6  input-group" visible="@load(vm.isVisible('REFERENCIA'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('REFERENCIA.label', 'Referencia'))"/>
	   
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.referencia)"  />
  </div>






				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('DEPLOYAPP'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DEPLOYAPP.label', 'Deployment APP'))"  />
	   
	    <textbox   tabindex="2" id="DNWxPvBbBm" 
	   placeholder="@load(vm.lang.getProperty('DEPLOYAPP.label', 'deployapp'))" 
	   value="@bind(vm.beanData.deployapp) @save(vm.beanData.deployapp, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DEPLOYAPP'))" disabled="@load(vm.isEditable('DEPLOYAPP')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['DNWxPvBbBm'])"/>
            
	   
    </div>   






				

  <div class="col-md-6  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	  
	      <datebox     id="764911"  placeholder="@load(vm.lang.getProperty('ALTA.label', 'alta'))" tabindex="3" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('ALTA'))" disabled="@load(vm.isEditable('ALTA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['764911'])"/>   
    
      </div>






				

  <div class="col-md-6  input-group" visible="@load(vm.isVisible('BAJA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BAJA.label', 'Baja'))"/>
	  
	      <datebox     id="859606"  placeholder="@load(vm.lang.getProperty('BAJA.label', 'baja'))" tabindex="4" value="@bind(vm.beanData.baja) @save(vm.beanData.baja, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('BAJA'))" disabled="@load(vm.isEditable('BAJA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['859606'])"/>   
    
      </div>






				

 <div class="col-md-6  input-group" visible="@load(vm.isVisible('COSTEESTIMADO'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COSTEESTIMADO.label', 'Coste estimado'))"/>
	   
   <decimalbox   tabindex="5" id="737578" onCreate="" placeholder="@load(vm.lang.getProperty('COSTEESTIMADO.label', 'costeestimado'))"   
    value="@bind(vm.beanData.costeestimado) @save(vm.beanData.costeestimado, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('COSTEESTIMADO'))" disabled="@load(vm.isEditable('COSTEESTIMADO')?false:true)" onChange="@command('onChangeInput',field='COSTEESTIMADO',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['737578'])"/>
 
  </div>






				

 <div class="col-md-6  input-group" visible="@load(vm.isVisible('COSTEMES'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COSTEMES.label', 'Coste Mes'))"/>
	   
   <decimalbox   tabindex="6" id="911264" onCreate="" placeholder="@load(vm.lang.getProperty('COSTEMES.label', 'costemes'))"   
    value="@bind(vm.beanData.costemes) @save(vm.beanData.costemes, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('COSTEMES'))" disabled="@load(vm.isEditable('COSTEMES')?false:true)" onChange="@command('onChangeInput',field='COSTEMES',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['911264'])"/>
 
  </div>






				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('URLPUBLIC'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('URLPUBLIC.label', 'URL Publica'))"  />
	   
	    <textbox   tabindex="7" id="UzQNpYxRoq" 
	   placeholder="@load(vm.lang.getProperty('URLPUBLIC.label', 'urlpublic'))" 
	   value="@bind(vm.beanData.urlpublic) @save(vm.beanData.urlpublic, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('URLPUBLIC'))" disabled="@load(vm.isEditable('URLPUBLIC')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['UzQNpYxRoq'])"/>
            
	   
    </div>   






				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('STORAGE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('STORAGE.label', 'Storage'))"  />
	   
	    <textbox   tabindex="8" id="56486" 
	   placeholder="@load(vm.lang.getProperty('STORAGE.label', 'storage'))" 
	   value="@bind(vm.beanData.storage) @save(vm.beanData.storage, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('STORAGE'))" disabled="@load(vm.isEditable('STORAGE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['56486'])"/>
            
	   
    </div>   





   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COMENTARIOS.label', 'Comentarios'))"/>
	  
	      <textbox rows="4" cols="80" id="eaKPEktSif" multiline="true" placeholder="@load(vm.lang.getProperty('COMENTARIOS.label', 'comentarios'))" value="@bind(vm.beanData.comentarios) @save(vm.beanData.comentarios, before=('grabar')) "   visible="@load(vm.isVisible('COMENTARIOS'))" disabled="@load(vm.isEditable('COMENTARIOS')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['eaKPEktSif'])"/>
	     
</h:div>



</div>
</div>  
<div id="ZvktSJlOkg" style="overflow:auto;" class=" default col-lg-1 col-xlg-1 col-md-1 "  visible="false" >
<div id="ZvktSJlOkg-row" class="row">
</div>
</div>  
<div id="ciScRyFBbx" style="overflow:auto;" class=" default col-lg-5 col-xlg-5 col-md-5"  visible="true" >
<div id="ciScRyFBbx-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('VERSION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VERSION.label', 'Versión'))"  />
	   
	    <textbox   tabindex="1" id="qHcXRTeVOI" 
	   placeholder="@load(vm.lang.getProperty('VERSION.label', 'Versión publicada'))" 
	   value="@bind(vm.beanData.version) @save(vm.beanData.version, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('VERSION'))" disabled="@load(vm.isEditable('VERSION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['qHcXRTeVOI'])"/>
            
	   
    </div>   





<h:div class="col-md-12  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlcomponent.label', 'Componente'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idatlcomponent" placeholder="@load(vm.lang.getProperty('idatlcomponent').label,'Componente')" model="@bind(vm.foreings['idatlcomponent'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idatlcomponent',item=self.selectedItem.value,changefk='idatlrcomponver',updatebean='true')"  		selectedItem="@load(vm.beanData.idatlcomponent)"  onCreate="@command('onCreateCombo',component=self,alias='idatlcomponent')" value="@bind(vm.beanData.idatlcomponent .componente)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.componente)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlcomponent'])"/>

  
</h:div>



   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DEPLOYMENT.label', 'Deployment YML'))"/>
	  
	      <textbox rows="4" cols="80" id="SPFvbTMHFs" multiline="true" placeholder="@load(vm.lang.getProperty('DEPLOYMENT.label', 'deployment'))" value="@bind(vm.beanData.deployment) @save(vm.beanData.deployment, before=('grabar')) "   visible="@load(vm.isVisible('DEPLOYMENT'))" disabled="@load(vm.isEditable('DEPLOYMENT')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['SPFvbTMHFs'])"/>
	     
</h:div>




   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DEPLOYMENTYML.label', 'Deployment'))"/>
	  
	      <extHTML value="@bind(vm.beanData.idatlrcomponver.deploymentyml)"></extHTML>
	     
</h:div>



</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['componentproject.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 










                  
                 

                  
                 





                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$componentproject');
  binder.command('doLoad');
});
function loadcomponentproject(){
  var binder = zkbind.$('$componentproject');
  binder.command('doLoadBean');

}
</script>	
</zk>