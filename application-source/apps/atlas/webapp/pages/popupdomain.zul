<combobox id="cbYXArohJThm" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idatlproject'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='true',alias='idatlproject',hidde=self)" width="85%">
