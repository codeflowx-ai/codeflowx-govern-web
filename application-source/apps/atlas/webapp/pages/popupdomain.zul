<textbox sclass="form-control  bg-light border-0" placeholder="introduzca criterios..." onOK="@command('onChangeFindForeing',alias='idatlproject',att='project,referencia,',input=self)" onChange="@command('onChangeFindForeing',alias='idatlproject',att='project,referencia,',event=event)"/>
</div><div sclass="mb-2">
<listbox height="400px" mold="paging" pageSize="20" pagingPosition="bottom" model="@bind(vm.foreings['idatlproject'])" onSelect="@command('onSelectForeingPopup', alias='idatlproject',item=self.selectedItem.value,hidde=searchYXArohJThm,updatebean='true' )">
<listhead>
<listheader label="@load(vm.lang.getProperty('PROJECT.label','PROJECT'))"  />
<listheader label="@load(vm.lang.getProperty('REFERENCIA.label','REFERENCIA'))"  />
</listhead>
<template name="model" var="item">
<listitem value="@load(item)">
<listcell label="@load(item.project)" />
<listcell label="@load(item.referencia)" />
</listitem></template></listbox>
</div></div></div></div></window>


  
</h:div>




				

