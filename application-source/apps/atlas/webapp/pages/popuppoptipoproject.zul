<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="poptipoproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='poptipoproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuppoptipoproject" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atltipoproject" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="33462" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('poptipoproject.screen', 'Tipo proyecto'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="ykQuiciniM" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="false" >
<div id="ykQuiciniM-row" class="row">


				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('TIPOPROJECT'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPOPROJECT.label', 'Tipo de proyecto'))"  />
	   
	    <textbox   tabindex="1" id="NgZUhUOqZG" 
	   placeholder="@load(vm.lang.getProperty('TIPOPROJECT.label', 'Tipo de proyecto'))" 
	   value="@bind(vm.beanData.tipoproject) @save(vm.beanData.tipoproject, before=('grabar')) @validator(vm.unique, field='TIPOPROJECT',required=true ,oldValue=vm.beanDataCpy.tipoproject)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('TIPOPROJECT'))" disabled="@load(vm.isEditable('TIPOPROJECT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['NgZUhUOqZG'])"/>
            
	   
    </div>   






				

  <div class="col-md-6  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	  
	      <datebox     id="770246"  placeholder="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" tabindex="2" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('ALTA'))" disabled="@load(vm.isEditable('ALTA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['770246'])"/>   
    
      </div>






 <div class="col-md-6   input-grou" visible="@load(vm.isVisible('MARCABLANCA'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MARCABLANCA.label', 'Es Marca Blanca'))"/>
 <checkbox mold="default" id="qnhNFCACTI" value="@bind(vm.beanData.marcablanca) @save(vm.beanData.marcablanca, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('MARCABLANCA'))" disabled="@load(vm.isEditable('MARCABLANCA')?false:true)" checked="@bind(vm.beanData.marcablanca) @save(vm.beanData.marcablanca, before=('grabar'))"/>
</div>





				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('MARCA'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('MARCA.label', 'Marca'))"  />
	   
	    <textbox   tabindex="4" id="137210" 
	   placeholder="@load(vm.lang.getProperty('MARCA.label', 'Marca'))" 
	   value="@bind(vm.beanData.marca) @save(vm.beanData.marca, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('MARCA'))" disabled="@load(vm.isEditable('MARCA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['137210'])"/>
            
	   
    </div>   




</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['poptipoproject.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 





                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$poptipoproject');
  binder.command('doLoad');
});
function loadpoptipoproject(){
  var binder = zkbind.$('$poptipoproject');
  binder.command('doLoadBean');

}
</script>	
</zk>