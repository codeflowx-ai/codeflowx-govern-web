<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="storage" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='storage')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="storage" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlstorage" />
	   <custom-attributes namespace="atlas" />
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				

<div id="QdzLEwbuWB" style="overflow:auto;" class=" col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="QdzLEwbuWB-row" class="row">


				


  
    <h:div class="col-md-4 border-field">
    <hbox spacing="3px" visible="@load(vm.isVisible('STORAGE'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('STORAGE.label', 'Storage'))"/>
	   </hbox>
       <label sclass="margin-field fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.storage)"  />
    </h:div>






				


   
    <h:div class="col-md-4 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('IDPROVEEDOR'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDProveedor'))"  />
	   </hbox>
	   <textbox   tabindex="2" id="406889" 
	   placeholder="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDProveedor'))" 
	   value="@bind(vm.beanData.idproveedor) @save(vm.beanData.idproveedor, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('IDPROVEEDOR'))" disabled="@load(vm.isEditable('IDPROVEEDOR')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['406889'])"/>
	   
    </h:div>   






				


  <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('PRECIO'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PRECIO.label', 'Coste'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_PRECIO" />
	   </hbox>
   <decimalbox   tabindex="3" id="KShryNvaZm" onCreate="" placeholder="@load(vm.lang.getProperty('PRECIO.label', 'Coste'))"   
    value="@bind(vm.beanData.precio) @save(vm.beanData.precio, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="margin-field form-control  form-control" visible="@load(vm.isVisible('PRECIO'))" disabled="@load(vm.isEditable('PRECIO')?false:true)" onChange="@command('onChangeInput',field='PRECIO',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['KShryNvaZm'])"/>
 
    </h:div>






				


    <h:div class="col-md-4 border-field">
       <hbox spacing="3px" visible="@load(vm.isVisible('CAPACIDAD'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('CAPACIDAD.label', 'Capacidad'))"/>
	    <a iconSclass="su-icon su-icon-question" popup="pop_CAPACIDAD" />
	   </hbox>
	      <intbox   tabindex="4" id="67248"  placeholder="@load(vm.lang.getProperty('CAPACIDAD.label', 'Capacidad'))" sclass="margin-field form-control  form-control "  value="@bind(vm.beanData.capacidad) @save(vm.beanData.capacidad, before=('grabar')) " visible="@load(vm.isVisible('CAPACIDAD'))" disabled="@load(vm.isEditable('CAPACIDAD')?false:true)" onChange="@command('onChangeInput',field='CAPACIDAD',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['67248'])"/>   
    
    </h:div>






				


   
    <h:div class="col-md-8 border-field">
    
       <hbox spacing="3px" visible="@load(vm.isVisible('DESCRPROV'))" sclass="margin-field">
	    <label sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DESCRPROV.label', 'Descripción prov.'))"  />
	   </hbox>
	   <textbox   tabindex="5" id="mrTkDhuWRT" 
	   placeholder="@load(vm.lang.getProperty('DESCRPROV.label', 'Descripción prov.'))" 
	   value="@bind(vm.beanData.descrprov) @save(vm.beanData.descrprov, before=('grabar')) "  sclass="margin-field form-control  form-control" 
	   visible="@load(vm.isVisible('DESCRPROV'))" disabled="@load(vm.isEditable('DESCRPROV')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['mrTkDhuWRT'])"/>
	   
    </h:div>   




</div>
</div>                     </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
								
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn " >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc" >
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['storage.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 






                  
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$storage');
  binder.command('doLoad');
});
function loadstorage(){
  var binder = zkbind.$('$storage');
  binder.command('doLoadBean');

}
</script>	
</zk>