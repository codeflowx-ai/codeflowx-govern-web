<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="cloudproject" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='cloudproject')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupcloudproject" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlcloudproject" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="61958" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('cloudproject.screen', 'Proyecto Cloud'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">
<div id="ZRWjYnzWTb"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="ZRWjYnzWTb-card" class="card  default shadow-xl" style="overflow:auto;" >
       <div id="ZRWjYnzWTb-body" class="card-body ">
        <div id="ZRWjYnzWTb-row" class="form-group row ">

<tabbox orient="top" mold="default" >
     <tabs>
                 <tab label="Proyecto" />      
                                  <tab label="Clusters"  onSelect="@command('loadSubtableOnDemand',alias='subatlkubecloud')"/>      
                                  <tab label="Almacenamiento"  onSelect="@command('loadSubtableOnDemand',alias='subatlstorage')"/>      
                                  <tab label="Proyectos"  onSelect="@command('loadSubtableOnDemand',alias='subatlproject')"/>      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">



<h:div class=" col-lg-12 col-xlg-12 col-md-12">
  <h:div class="card  default" style="overflow:auto;" >
       <h:div class="card-body">
        <h:div class="form-group row">


				

  <!-- sclass="margin-field" -->
    <div class="col-md-4  input-group" visible="@load(vm.isVisible('REFPROJECT'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="  " value="@load(vm.lang.getProperty('REFPROJECT.label', 'Ref. proyecto'))"/>
	   
       <label sclass="margin-field text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.beanData.refproject)"  />
  </div>






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('PROYECTO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('PROYECTO.label', 'Proyecto'))"  />
	   
	    <textbox   tabindex="2" id="719508" 
	   placeholder="@load(vm.lang.getProperty('PROYECTO.label', 'proyecto'))" 
	   value="@bind(vm.beanData.proyecto) @save(vm.beanData.proyecto, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('PROYECTO'))" disabled="@load(vm.isEditable('PROYECTO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['719508'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('REFEXTERNA'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REFEXTERNA.label', 'ID Externo'))"  />
	   
	    <textbox   tabindex="3" id="wasaXRnMZH" 
	   placeholder="@load(vm.lang.getProperty('REFEXTERNA.label', 'refexterna'))" 
	   value="@bind(vm.beanData.refexterna) @save(vm.beanData.refexterna, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('REFEXTERNA'))" disabled="@load(vm.isEditable('REFEXTERNA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['wasaXRnMZH'])"/>
            
	   
    </div>   





   <h:div class="col-md-8 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripcion'))"/>
	  
	      <textbox rows="4" cols="80" id="tEYxeFmsrW" multiline="true" placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', 'descripcion'))" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "   visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['tEYxeFmsrW'])"/>
	     
</h:div>




<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idatlproveedor.label', 'Proveedor'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idatlproveedor" placeholder="@load(vm.lang.getProperty('idatlproveedor').label,'Proveedor')" model="@bind(vm.foreings['idatlproveedor'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idatlproveedor',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idatlproveedor)"  onCreate="@command('onCreateCombo',component=self,alias='idatlproveedor')" value="@bind(vm.beanData.idatlproveedor .proveedor)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.proveedor)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idatlproveedor'])"/>
<a sclass="btn " tooltiptext="add" iconSclass="fa-duotone fa-pen-to-square" d:data-bs-toggle="modal"  d:data-bs-target="#staticATLPROVEEDOR" onClick="@command('appendForeing',win=WIN_KqUTXzaqyy,alias='idatlproveedor',body='body_KqUTXzaqyy',page='popupproveedor.zul',close='btn_idatlproveedor')"></a>

<window id="WIN_KqUTXzaqyy" mode="modal" visible="false" position="center,center" action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none" width="80%">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title"> Crear proveedor</h:h5>
</div>
<div class="modal-body" id="body_KqUTXzaqyy"></div>
<div class="modal-footer"></div>
</div>
</window>


  
</h:div>


         </h:div> 
       </h:div>
  </h:div>
 </h:div> 


         </div>
