 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$cloudproject');
  binder.command('doLoad');
});
function loadcloudproject(){
  var binder = zkbind.$('$cloudproject');
  binder.command('doLoadBean');

}
</script>	
