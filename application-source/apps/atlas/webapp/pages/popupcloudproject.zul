 <div class="col-lg-12">		
  <grid id="sJxVmnlteV" height="400px" width="100%" 
   model="@bind(vm.grid['subatlkubecloud']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlkubecloud',loadOnDemand='false'  )" >
  <columns sizable="true">
	    <column label="@load(vm.lang.getProperty('REFERENCIA.label', 'REFERENCIA'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('CLUSTER.label', 'CLUSTER'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('REGION.label', 'REGION'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDPROVEEDOR'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('VERSIONKBUBE.label', 'VERSIONKBUBE'))"   align="center" sclass="text-capitalize"/>
     
	 </columns>

  </grid>
  </div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

 <!--	if(comp.getPropBeans().get("loadOnDemand")!=null) {-->
 <div class="col-lg-12">		
  <grid id="syCEVwDcJr" height="400px" width="100%" 
   model="@bind(vm.grid['subatlstorage']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlstorage',loadOnDemand='false'  )" >
  <columns sizable="true">
	    <column label="@load(vm.lang.getProperty('STORAGE.label', 'STORAGE'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('ALTA.label', 'ALTA'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('CAPACIDAD.label', 'CAPACIDAD'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('PRECIO.label', 'PRECIO'))"   align="center" sclass="text-capitalize"/>
     
	    <column label="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDPROVEEDOR'))"   align="center" sclass="text-capitalize"/>
     
	 </columns>

  </grid>
  </div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

 <!--	if(comp.getPropBeans().get("loadOnDemand")!=null) {-->
 <div class="col-lg-12">		
  <grid id="CjTkKYRnms" height="400px" width="100%" 
   model="@bind(vm.grid['subatlproject']) " 
    onCreate="@command('onSubtableCreate',component=self,alias='subatlproject',loadOnDemand='false'  )" >
  <columns sizable="true">
	    <column label="@load(vm.lang.getProperty('REFERENCIA.label', 'REFERENCIA'))"   align="center" sclass="text-capitalize"/>
     
