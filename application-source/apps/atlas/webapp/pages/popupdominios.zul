 <checkbox mold="switch" id="YSZmxNcBAP" value="@bind(vm.beanData.deleteexpire) @save(vm.beanData.deleteexpire, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('DELETEEXPIRE'))" disabled="@load(vm.isEditable('DELETEEXPIRE')?false:true)" checked="@bind(vm.beanData.deleteexpire) @save(vm.beanData.deleteexpire, before=('grabar'))"/>
