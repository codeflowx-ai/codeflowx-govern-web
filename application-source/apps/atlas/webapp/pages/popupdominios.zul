	    <textbox   tabindex="1" id="nlmLSFqzod" 
	   placeholder="@load(vm.lang.getProperty('DOMAIN.label', 'Dominio.es'))" 
	   value="@bind(vm.beanData.domain) @save(vm.beanData.domain, before=('grabar')) @validator(vm.unique, field='DOMAIN', oldValue=vm.beanDataCpy.domain)"  sclass="  " 
	   visible="@load(vm.isVisible('DOMAIN'))" disabled="@load(vm.isEditable('DOMAIN')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['nlmLSFqzod'])"/>
            
	   
    </div>   






				

  <div class="col-md-3  input-group" visible="@load(vm.isVisible('CREACION')) " >
