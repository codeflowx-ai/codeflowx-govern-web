	      <datebox     id="twoVMYDKxn"  placeholder="@load(vm.lang.getProperty('CREACION.label', 'Creación'))" tabindex="2" value="@bind(vm.beanData.creacion) @save(vm.beanData.creacion, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('CREACION'))" disabled="@load(vm.isEditable('CREACION')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['twoVMYDKxn'])"/>   
    
