	      <datebox     id="47556"  placeholder="@load(vm.lang.getProperty('EXPIRA.label', 'Expira'))" tabindex="3" value="@bind(vm.beanData.expira) @save(vm.beanData.expira, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('EXPIRA'))" disabled="@load(vm.isEditable('EXPIRA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['47556'])"/>   
    
