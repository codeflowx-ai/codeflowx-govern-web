<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="deployments" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='deployments')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popupdeployments" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atldeployment" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="73302" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('deployments.screen', 'Deployments'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
							       <a
										iconSclass="fa-duotone fa-square-question"
									  class="waves-effect waves-light" 
									 onClick="WIN_HELP.setVisible(true)">
								</a>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">
<div id="PZRMsBZMhA"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="PZRMsBZMhA-card" class="card  default" style="overflow:auto;" >
       <div id="PZRMsBZMhA-body" class="card-body ">
        <div id="PZRMsBZMhA-row" class="form-group row ">

<tabbox orient="top" mold="default" width="100%">
     <tabs>
                 <tab label="Descripción" />      
                 <tab label="YAML" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">


				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('NOMBRE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))"  />
	   
	    <textbox   tabindex="0" id="127886" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'nombre'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) @validator(vm.unique, field='NOMBRE',required=true ,oldValue=vm.beanDataCpy.nombre)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['127886'])"/>
            
	   
    </div>   






				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('VERSION'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VERSION.label', 'Version'))"  />
	   
	    <textbox   tabindex="0" id="436590" 
	   placeholder="@load(vm.lang.getProperty('VERSION.label', 'version'))" 
	   value="@bind(vm.beanData.version) @save(vm.beanData.version, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.version)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('VERSION'))" disabled="@load(vm.isEditable('VERSION')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['436590'])"/>
            
	   
    </div>   







<h:div class="col-md-6  input-group">
     <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))"/>
 


 <combobox mold="rounded" disabled="false"  sclass="" id="TIPO" model="@load(vm.getEnums('TIPO'))" 
selectedItem="@load(vm.beanData.tipo)"  value="@load(vm.beanData.tipo) @save(vm.beanData.tipo, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['TIPO'])"/>
</h:div>





 <div class="col-md-6   input-grou" visible="@load(vm.isVisible('APPLICATION'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('APPLICATION.label', 'Reiniciar al actualizar fuentes'))"/>
 <checkbox mold="default" id="JphtVWIFyh" value="@bind(vm.beanData.application) @save(vm.beanData.application, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('APPLICATION'))" disabled="@load(vm.isEditable('APPLICATION')?false:true)" checked="@bind(vm.beanData.application) @save(vm.beanData.application, before=('grabar'))"/>
</div>




   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFORMACION.label', 'Información'))"/>
	  
	  <tbeditor id="VDyfQkXJUe" value="@bind(vm.beanData.informacion) @save(vm.beanData.informacion, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DEPLOYMENT.label', 'Yaml'))"/>
	  
	      <textbox rows="16" cols="80" id="qweHORsNLY" multiline="true" placeholder="@load(vm.lang.getProperty('DEPLOYMENT.label', 'deployment'))" value="@bind(vm.beanData.deployment) @save(vm.beanData.deployment, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.deployment)"   visible="@load(vm.isVisible('DEPLOYMENT'))" disabled="@load(vm.isEditable('DEPLOYMENT')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['qweHORsNLY'])"/>
	     
</h:div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['deployments.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 








                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
                               <html content="@load(vm.helpBean.texto)"/>
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$deployments');
  binder.command('doLoad');
});
function loaddeployments(){
  var binder = zkbind.$('$deployments');
  binder.command('doLoadBean');

}
</script>	
</zk>