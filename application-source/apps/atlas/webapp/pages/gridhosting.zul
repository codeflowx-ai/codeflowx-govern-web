<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('REFERENCIA.label', 'Referencia'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['REFERENCIAAsc'])" sortDescending="@load(vm.comparators['REFERENCIADesc'])"  visible="@load(vm.isVisible('REFERENCIA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DOMINIO.label', 'Dominio'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DOMINIOAsc'])" sortDescending="@load(vm.comparators['DOMINIODesc'])"  visible="@load(vm.isVisible('DOMINIO'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])"  visible="@load(vm.isVisible('ALTA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('VENCIMIENTO.label', 'Vencimiento'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['VENCIMIENTOAsc'])" sortDescending="@load(vm.comparators['VENCIMIENTODesc'])"  visible="@load(vm.isVisible('VENCIMIENTO'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterhosting.zul')">
							             <label  value="@load(item.referencia) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.dominio) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.alta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.vencimiento) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterhosting.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
