<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="componente" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='componente')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="componente" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlcomponent" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="96706" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('componente.screen', 'componente'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="KCpcRCofls" style="overflow:auto;" class=" default col-lg-5 col-xlg-5 col-md-5"  visible="true" >
<div id="KCpcRCofls-row" class="row">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('COMPONENTE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('COMPONENTE.label', 'Componente'))"  />
	   
	    <textbox   tabindex="1" id="997390" 
	   placeholder="@load(vm.lang.getProperty('COMPONENTE.label', 'Componente'))" 
	   value="@bind(vm.beanData.componente) @save(vm.beanData.componente, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('COMPONENTE'))" disabled="@load(vm.isEditable('COMPONENTE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['997390'])"/>
            
	   
    </div>   






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('NAMESPACE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NAMESPACE.label', 'Namspace'))"  />
	   
	    <textbox   tabindex="2" id="mMAsKJIDBn" 
	   placeholder="@load(vm.lang.getProperty('NAMESPACE.label', 'Namspace'))" 
	   value="@bind(vm.beanData.namespace) @save(vm.beanData.namespace, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('NAMESPACE'))" disabled="@load(vm.isEditable('NAMESPACE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['mMAsKJIDBn'])"/>
            
	   
    </div>   






 <div class="col-md-4   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('INFRAESTRUCTURE'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('INFRAESTRUCTURE.label', 'Es de infraestructura'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="default" id="soQPOhYlOJ" value="@bind(vm.beanData.infraestructure) @save(vm.beanData.infraestructure, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('INFRAESTRUCTURE'))" disabled="@load(vm.isEditable('INFRAESTRUCTURE')?false:true)" checked="@bind(vm.beanData.infraestructure) @save(vm.beanData.infraestructure, before=('grabar'))"/>
             </div>	      
	     
 
</div>





				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('MEMORY'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MEMORY.label', 'Memoria'))"/>
	
	      <intbox   tabindex="4" id="SkwwLdDobN"  placeholder="@load(vm.lang.getProperty('MEMORY.label', 'Memoria'))" sclass="  "  value="@bind(vm.beanData.memory) @save(vm.beanData.memory, before=('grabar')) " visible="@load(vm.isVisible('MEMORY'))" disabled="@load(vm.isEditable('MEMORY')?false:true)" onChange="@command('onChangeInput',field='MEMORY',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['SkwwLdDobN'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('STORAGE'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('STORAGE.label', 'Storage'))"/>
	
	      <intbox   tabindex="5" id="279571"  placeholder="@load(vm.lang.getProperty('STORAGE.label', 'Storage'))" sclass="  "  value="@bind(vm.beanData.storage) @save(vm.beanData.storage, before=('grabar')) " visible="@load(vm.isVisible('STORAGE'))" disabled="@load(vm.isEditable('STORAGE')?false:true)" onChange="@command('onChangeInput',field='STORAGE',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['279571'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('VCPU'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('VCPU.label', 'vCpu'))"/>
	
	      <intbox   tabindex="6" id="244888"  placeholder="@load(vm.lang.getProperty('VCPU.label', 'vCpu'))" sclass="  "  value="@bind(vm.beanData.vcpu) @save(vm.beanData.vcpu, before=('grabar')) " visible="@load(vm.isVisible('VCPU'))" disabled="@load(vm.isEditable('VCPU')?false:true)" onChange="@command('onChangeInput',field='VCPU',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['244888'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('COSTEMES'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('COSTEMES.label', 'Coste Mensual'))"/>
	
	      <decimalbox   tabindex="7" id="jpxmLZpoEq"  placeholder="@load(vm.lang.getProperty('COSTEMES.label', 'Coste Mensual'))"  value="@bind(vm.beanData.costemes) @save(vm.beanData.costemes, before=('grabar')) "  format="###,###,##0.00" 
	      sclass="   " visible="@load(vm.isVisible('COSTEMES'))" disabled="@load(vm.isEditable('COSTEMES')?false:true)" onChange="@command('onChangeInput',field='COSTEMES',evento=event,componente=self,calculate=true)" />
           <label sclass="text-danger" value="@load(vmsgs['jpxmLZpoEq'])"/>   
    </div>





   <h:div class="col-md-6 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))"/>
	  
	      <textbox rows="4" cols="80" id="RJbHtUudbE" multiline="true" 
	      placeholder="@load(vm.lang.getProperty('DESCRIPCION.label', ''))" value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) "   visible="@load(vm.isVisible('DESCRIPCION'))" disabled="@load(vm.isEditable('DESCRIPCION')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['RJbHtUudbE'])"/>
	     
</h:div>



</div>
</div>  
<div id="yvcxArziHO" style="overflow:auto;" class=" default col-lg-7 col-xlg-7 col-md-7"  visible="true" >
<div id="yvcxArziHO-row" class="row">

<div class="col-md-12">
 <h:div class="col-md-6">
 <label sclass=" font-weight-normal align-text-middle" style="" value="Delpyments"  />
   
    </h:div>
   

<listbox  checkmark="true"  model="@load(vm.foreings['idatldeployment'])" height="400px" onCreate="@command('onSubtableCreate',alias='subatlrcompdeploy',loadOnDemand='true')" ><listhead><listheader label="Nombre"></listheader><listheader label="Tipo"></listheader><listheader label="Version"></listheader></listhead> <template name="model" var="item"><listitem value="@load(item)"><listcell label="@load(item.nombre)"></listcell><listcell label="@load(item.tipo)"></listcell><listcell label="@load(item.version)"></listcell></listitem></template></listbox>
</div>


</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['componente.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 









                  
                 


                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$componente');
  binder.command('doLoad');
});
function loadcomponente(){
  var binder = zkbind.$('$componente');
  binder.command('doLoadBean');

}
</script>	
</zk>