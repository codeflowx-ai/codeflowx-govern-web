       <label sclass="text-danger" value="@load(vmsgs['136747'])"/>
               <space/>
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('MAXPODS'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MAXPODS.label', 'Max. Pods'))"/>
	
	      <intbox   tabindex="10" id="390147"  placeholder="@load(vm.lang.getProperty('MAXPODS.label', 'Max. Pods'))" sclass="  "  value="@bind(vm.beanData.maxpods) @save(vm.beanData.maxpods, before=('grabar')) " visible="@load(vm.isVisible('MAXPODS'))" disabled="@load(vm.isEditable('MAXPODS')?false:true)" onChange="@command('onChangeInput',field='MAXPODS',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['390147'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('PODS'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PODS.label', 'Pods'))"/>
	
	      <intbox   tabindex="11" id="537571"  placeholder="@load(vm.lang.getProperty('PODS.label', 'Pods'))" sclass="  "  value="@bind(vm.beanData.pods) @save(vm.beanData.pods, before=('grabar')) " visible="@load(vm.isVisible('PODS'))" disabled="@load(vm.isEditable('PODS')?false:true)" onChange="@command('onChangeInput',field='PODS',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['537571'])"/>   
    
    </div>




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
                   </div>           
            </h:div>
            <div class="hstack gap-2 justify-content-end">
									<button onClick="@command('grabar',action='continuar')"
										class="btn btn-success"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" >
										Guardar
									</button>
									<button onClick="@command('grabar',action='nuevo')"
										class="btn" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right" >
										Guardar y Nuevo
									</button>
									<button onClick="@command('cerrarPopup')"
										class="btn btn-light" iconSclass="fa-duotone fa-arrow-left-from-arc">
										Cerrar
									</button>
								
							</div>
           </h:div>
          </h:div>
         </div>   
        		</panelchildren>
		</panel> 
            <fragment exps="@load(vm.lang['popnodo.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 












                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$popnodo');
  binder.command('doLoad');
});
function loadpopnodo(){
  var binder = zkbind.$('$popnodo');
  binder.command('doLoadBean');

}
</script>	
</zk>