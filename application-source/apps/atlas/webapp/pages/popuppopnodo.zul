<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="popnodo" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='popnodo')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="popuppopnodo" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.atlas.Atlnode" />
	   <custom-attributes namespace="atlas" />
	      <custom-attributes uid="81456" />
	   <custom-attributes tipo="MASTER" />
	   
			<panel >
			<panelchildren>
			<div class="row">
					<h:div class="col-lg-12">
					<h:div class="card">
						<h:div class="card-body">
						   <div class="row">				
<div id="AxGDieugYj"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="AxGDieugYj-card" class="card  shadow-xl" style="overflow:auto;" >
       <div id="AxGDieugYj-body" class="card-body ">
        <div id="AxGDieugYj-row" class="form-group row ">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('NODO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NODO.label', 'Nodo'))"  />
	   
	    <textbox   tabindex="1" id="27720" 
	   placeholder="@load(vm.lang.getProperty('NODO.label', 'Nodo'))" 
	   value="@bind(vm.beanData.nodo) @save(vm.beanData.nodo, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('NODO'))" disabled="@load(vm.isEditable('NODO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['27720'])"/>
               <space/>
	   
    </div>   






				

  <div class="col-md-4  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	  
	      <datebox     id="217695"  placeholder="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" tabindex="2" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) "   format="dd/MM/yyyy"  
    visible="@load(vm.isVisible('ALTA'))" disabled="@load(vm.isEditable('ALTA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['217695'])"/>   
    
      </div>






				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('IDPROVEEDOR'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDProveedor'))"  />
	   
	    <textbox   tabindex="3" id="997000" 
	   placeholder="@load(vm.lang.getProperty('IDPROVEEDOR.label', 'IDProveedor'))" 
	   value="@bind(vm.beanData.idproveedor) @save(vm.beanData.idproveedor, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('IDPROVEEDOR'))" disabled="@load(vm.isEditable('IDPROVEEDOR')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['997000'])"/>
               <space/>
	   
    </div>   






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('MEMORIA'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('MEMORIA.label', 'Memoria ram'))"/>
	
	      <intbox   tabindex="4" id="PmllwTKwqP"  placeholder="@load(vm.lang.getProperty('MEMORIA.label', 'Memoria ram'))" sclass="  "  value="@bind(vm.beanData.memoria) @save(vm.beanData.memoria, before=('grabar')) " visible="@load(vm.isVisible('MEMORIA'))" disabled="@load(vm.isEditable('MEMORIA')?false:true)" onChange="@command('onChangeInput',field='MEMORIA',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['PmllwTKwqP'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('VCPU'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('VCPU.label', 'Vcpus'))"/>
	
	      <intbox   tabindex="5" id="YZZUwNWcay"  placeholder="@load(vm.lang.getProperty('VCPU.label', 'Vcpus'))" sclass="  "  value="@bind(vm.beanData.vcpu) @save(vm.beanData.vcpu, before=('grabar')) " visible="@load(vm.isVisible('VCPU'))" disabled="@load(vm.isEditable('VCPU')?false:true)" onChange="@command('onChangeInput',field='VCPU',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['YZZUwNWcay'])"/>   
    
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('DISCO'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DISCO.label', 'Disco SSD'))"/>
	
	      <intbox   tabindex="6" id="fEXsmVsazp"  placeholder="@load(vm.lang.getProperty('DISCO.label', 'Disco SSD'))" sclass="  "  value="@bind(vm.beanData.disco) @save(vm.beanData.disco, before=('grabar')) " visible="@load(vm.isVisible('DISCO'))" disabled="@load(vm.isEditable('DISCO')?false:true)" onChange="@command('onChangeInput',field='DISCO',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['fEXsmVsazp'])"/>   
    
    </div>






				

 <div class="col-md-3  input-group" visible="@load(vm.isVisible('IMPORTEMES'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('IMPORTEMES.label', 'Coste mes'))"/>
	   
   <decimalbox   tabindex="7" id="INCjBEioBK" onCreate="" placeholder="@load(vm.lang.getProperty('IMPORTEMES.label', 'Coste mes'))"   
    value="@bind(vm.beanData.importemes) @save(vm.beanData.importemes, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('IMPORTEMES'))" disabled="@load(vm.isEditable('IMPORTEMES')?false:true)" onChange="@command('onChangeInput',field='IMPORTEMES',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['INCjBEioBK'])"/>
 
  </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('IPLOCAL'))" >
   
