<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('DOMAIN.label', 'Dominio'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DOMAINAsc'])" sortDescending="@load(vm.comparators['DOMAINDesc'])"  visible="@load(vm.isVisible('DOMAIN'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CREACION.label', 'Creación'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CREACIONAsc'])" sortDescending="@load(vm.comparators['CREACIONDesc'])"  visible="@load(vm.isVisible('CREACION'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('EXPIRA.label', 'Expira'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['EXPIRAAsc'])" sortDescending="@load(vm.comparators['EXPIRADesc'])"  visible="@load(vm.isVisible('EXPIRA'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Cliente.label', 'Cliente'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterdominios.zul')">
							             <label  value="@load(item.domain) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.creacion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.expira) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   <cell align="center">
                                          <label  value="@load(item.idcrmempresa.empresa) @converter(vm.fieldConverter)"></label>
                                   </cell> 
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterdominios.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
