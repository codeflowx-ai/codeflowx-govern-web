<combobox mold="rounded" autodrop="true"  id="idslprovider" placeholder="@load(vm.lang.getProperty('idslprovider').label,'Proveedor')" model="@bind(vm.foreings['idslprovider'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslprovider',item=self.selectedItem.value,changefk='idslesmodel',updatebean='false')"  		selectedItem="@load(vm.beanData.idslprovider)"  onCreate="@command('onCreateCombo',component=self,alias='idslprovider')" value="@bind(vm.beanData.idslprovider .provider)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.provider)" /></template></combobox><a  iconSclass="fa-sharp-duotone fa-solid fa-trash-can-list"  onClick="@command('clearForeing',alias='idslprovider')">	</a>

 <label sclass="text-danger" value="@load(vmsgs['idslprovider'])"/>

  
</h:div>



<h:div class="col-md-6  input-group">
   
   
