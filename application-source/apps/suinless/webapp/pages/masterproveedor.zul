<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

	<idspace id="proveedor"
		viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='proveedor')"
		validationMessages="@id('vmsgs')">
		<custom-attributes pagina="proveedor" />
		<custom-attributes clase="org.suinsit.apps.suinless.Slprovider" />
		<custom-attributes namespace="suinless" />
		<custom-attributes uid="58736" />
		<custom-attributes tipo="MASTER" />
		<h:div id="notificacion"></h:div>
		<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div
							class="d-flex align-items-center flex-wrap gap-3">
							<div class="left tittle-principal">
								<fragment
									exps="@load(vm.lang.getProperty('proveedor.screen', 'proveedor'))">
									
									<![CDATA[ <h2 class="mb-sm-0"
									textContent='@load(exps)'></h2> ]]>
									
					</fragment>
							</div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light" tooltiptext="Volver">
								</a>
							</div>
							<div class="flex-shrink-0">
								<div
									class="hstack text-nowrap gap-2 d-flex">
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2"
										onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2"
										onClick="@command('grabar',action='continuar')">

									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2"
										onClick="@command('grabar',action='nuevo')">

									</a>
								</div>
							</div>
						</div>
					</div><!--header-->
					<div class="card-body">
						<div class="row">


							<div id="KwrGLZiFQn" visible="true"
								class="col-lg-10 col-xlg-10 col-md-10">
								<div id="KwrGLZiFQn-card"
									class="card  default" style="overflow:auto;">
									<div id="KwrGLZiFQn-body"
										class="card-body ">
										<div id="KwrGLZiFQn-row"
											class="form-group row ">




											<div
												class="col-md-4  input-group"
												visible="@load(vm.isVisible('PROVIDER'))">

												<label
													sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
													style="  "
													value="@load(vm.lang.getProperty('PROVIDER.label', 'Proveedor'))" />

												<textbox tabindex="1"
													id="PshtCqAhmX"
													placeholder="@load(vm.lang.getProperty('PROVIDER.label', 'provider'))"
													value="@bind(vm.beanData.provider) @save(vm.beanData.provider, before=('grabar')) "
													sclass="  " visible="@load(vm.isVisible('PROVIDER'))"
													disabled="@load(vm.isEditable('PROVIDER')?false:true)" />
												<label
													sclass="text-danger" value="@load(vmsgs['PshtCqAhmX'])" />


											</div>








											<div
												class="col-md-4  input-group"
												visible="@load(vm.isVisible('ENDPOINT'))">

												<label
													sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
													style="  "
													value="@load(vm.lang.getProperty('ENDPOINT.label', 'Endpoint'))" />

												<textbox tabindex="2"
													id="509354"
													placeholder="@load(vm.lang.getProperty('ENDPOINT.label', 'endpoint'))"
													value="@bind(vm.beanData.endpoint) @save(vm.beanData.endpoint, before=('grabar')) "
													sclass="  " visible="@load(vm.isVisible('ENDPOINT'))"
													disabled="@load(vm.isEditable('ENDPOINT')?false:true)" />
												<label
													sclass="text-danger" value="@load(vmsgs['509354'])" />


											</div>





											<h:div
												class="col-md-4  input-group">


												<label
													sclass="text  form-label text-capitalize font-weight-normal"
													style=""
													value="@load(vm.lang.getProperty('idsletipoprovgob.label', 'Tipo Proveedor'))" />

												<combobox mold="rounded"
													autodrop="true" id="idsletipoprovgob"
													placeholder="@load(vm.lang.getProperty('idsletipoprovgob').label,'Tipo Proveedor')"
													model="@bind(vm.foreings['idsletipoprovgob'])"
													visible="true"
													onSelect="@command('onSelectForeing', alias='idsletipoprovgob',item=self.selectedItem.value,updatebean='true')"
													selectedItem="@load(vm.beanData.idsletipoprovgob)"
													onCreate="@command('onCreateCombo',component=self,alias='idsletipoprovgob')"
													value="@bind(vm.beanData.idsletipoprovgob .tipo)">
													<template
														name="model" var="item">
														<comboitem
															value="@load(item)" label="@load(item.tipo)" />
													</template>
												</combobox>
												<label
													sclass="text-danger"
													value="@load(vmsgs['idsletipoprovgob'])" />


											</h:div>






											<div
												class="col-md-4  input-group"
												visible="@load(vm.isVisible('CLAZZ'))">

												<label
													sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
													style="  "
													value="@load(vm.lang.getProperty('CLAZZ.label', 'Clazz'))" />

												<textbox tabindex="4"
													id="734550"
													placeholder="@load(vm.lang.getProperty('CLAZZ.label', 'clazz'))"
													value="@bind(vm.beanData.clazz) @save(vm.beanData.clazz, before=('grabar')) "
													sclass="  " visible="@load(vm.isVisible('CLAZZ'))"
													disabled="@load(vm.isEditable('CLAZZ')?false:true)" />
												<label
													sclass="text-danger" value="@load(vmsgs['734550'])" />


											</div>





											<h:div
												class="col-md-4  input-group">


												<label
													sclass="text  form-label text-capitalize font-weight-normal"
													style=""
													value="@load(vm.lang.getProperty('idsleestadogob.label', 'Estado Ley EU'))" />

												<combobox mold="rounded"
													autodrop="true" id="idsleestadogob"
													placeholder="@load(vm.lang.getProperty('idsleestadogob').label,'Estado Ley EU')"
													model="@bind(vm.foreings['idsleestadogob'])" visible="true"
													onSelect="@command('onSelectForeing', alias='idsleestadogob',item=self.selectedItem.value,changefk='idslenivelgob',updatebean='true')"
													selectedItem="@load(vm.beanData.idsleestadogob)"
													onCreate="@command('onCreateCombo',component=self,alias='idsleestadogob')"
													value="@bind(vm.beanData.idsleestadogob .estado)">
													<template
														name="model" var="item">
														<comboitem
															value="@load(item)" label="@load(item.estado)" />
													</template>
												</combobox>
												<label
													sclass="text-danger"
													value="@load(vmsgs['idsleestadogob'])" />


											</h:div>



											<h:div
												class="col-md-4  input-group">


												<label
													sclass="text  form-label text-capitalize font-weight-normal"
													style=""
													value="@load(vm.lang.getProperty('idslenivelgob.label', 'Nivel Ley EU'))" />

												<combobox mold="rounded"
													autodrop="true" id="idslenivelgob"
													placeholder="@load(vm.lang.getProperty('idslenivelgob').label,'Nivel Ley EU')"
													model="@bind(vm.foreings['idslenivelgob'])" visible="true"
													onSelect="@command('onSelectForeing', alias='idslenivelgob',item=self.selectedItem.value,updatebean='true')"
													selectedItem="@load(vm.beanData.idslenivelgob)"
													onCreate="@command('onCreateCombo',component=self,alias='idslenivelgob',loadFkFrom='idsleestadogob')"
													value="@bind(vm.beanData.idslenivelgob .nivel)"
													disabled="@bind(vm.beanData.idsleestadogob.idxsleestadogob eq null) ">
													<template
														name="model" var="item">
														<comboitem
															value="@load(item)" label="@load(item.nivel)" />
													</template>
												</combobox>
												<label
													sclass="text-danger" value="@load(vmsgs['idslenivelgob'])" />


											</h:div>




											<div
												class="col-md-2   input-grou"
												visible="@load(vm.isVisible('SHOWHOME'))">
												<label
													sclass="form-check-label font-weight-normal align-text-middle"
													style=""
													value="@load(vm.lang.getProperty('SHOWHOME.label', 'Mostrar Home'))" />
												<checkbox mold="default"
													id="nrxPEftfKZ"
													value="@bind(vm.beanData.showhome) @save(vm.beanData.showhome, before=('grabar'))"
													sclass=" " visible="@load(vm.isVisible('SHOWHOME'))"
													disabled="@load(vm.isEditable('SHOWHOME')?false:true)"
													checked="@bind(vm.beanData.showhome) @save(vm.beanData.showhome, before=('grabar'))" />
											</div>





											<div
												class="col-md-2   input-grou"
												visible="@load(vm.isVisible('OPENSOURCE'))">
												<label
													sclass="form-check-label font-weight-normal align-text-middle"
													style=""
													value="@load(vm.lang.getProperty('OPENSOURCE.label', 'Open Source'))" />
												<checkbox mold="default"
													id="62499"
													value="@bind(vm.beanData.opensource) @save(vm.beanData.opensource, before=('grabar'))"
													sclass=" " visible="@load(vm.isVisible('OPENSOURCE'))"
													disabled="@load(vm.isEditable('OPENSOURCE')?false:true)"
													checked="@bind(vm.beanData.opensource) @save(vm.beanData.opensource, before=('grabar'))" />
											</div>





											<div
												class="col-md-2   input-grou"
												visible="@load(vm.isVisible('COMUNITY'))">
												<label
													sclass="form-check-label font-weight-normal align-text-middle"
													style=""
													value="@load(vm.lang.getProperty('COMUNITY.label', 'Community'))" />
												<checkbox mold="default"
													id="dsSAdyoPbj"
													value="@bind(vm.beanData.comunity) @save(vm.beanData.comunity, before=('grabar'))"
													sclass=" " visible="@load(vm.isVisible('COMUNITY'))"
													disabled="@load(vm.isEditable('COMUNITY')?false:true)"
													checked="@bind(vm.beanData.comunity) @save(vm.beanData.comunity, before=('grabar'))" />
											</div>







											<div
												class="col-md-6  input-group"
												visible="@load(vm.isVisible('URLWEB'))">

												<label
													sclass="text form-label  text-capitalize  font-weight-normal align-text-middle"
													style="  "
													value="@load(vm.lang.getProperty('URLWEB.label', 'Web'))" />

												<textbox tabindex="10"
													id="DnAnbxacJQ"
													placeholder="@load(vm.lang.getProperty('URLWEB.label', 'Web'))"
													value="@bind(vm.beanData.urlweb) @save(vm.beanData.urlweb, before=('grabar')) @validator(vm.validator,type='URL' ,oldValue=vm.beanDataCpy.urlweb)"
													sclass="  " visible="@load(vm.isVisible('URLWEB'))"
													disabled="@load(vm.isEditable('URLWEB')?false:true)" />
												<label
													sclass="text-danger" value="@load(vmsgs['DnAnbxacJQ'])" />


											</div>





											<tabbox orient="top"
												mold="default" width="100%" class="mt-4">
												<tabs>
													<tab
														label="Resumen Tipo" />
													<tab
														label="Descripción" />
													<tab
														label="Info Home" />
													<tab label="Modelos"
														onSelect="@command('loadSubtableOnDemand',alias='subslesmodel')" />
												</tabs>
												<tabpanels>
													<tabpanel>
														<div
															class="row">

															<h:div
																class="col-md-12 input-group">

																<label
																	sclass=" font-weight-normal align-text-middle" style=""
																	value="@load(vm.lang.getProperty('INFOPUBLIC.label', 'Resumen'))" />

																<tbeditor
																	id="WVdHEtlzmo"
																	value="@bind(vm.beanData.idsletipoprovgob.infopublic) @save(vm.beanData.idsletipoprovgob.infopublic, before=('grabar')) " height="600px"/>
															</h:div>



														</div>
													</tabpanel>
													<tabpanel>
														<div
															class="row">

															<h:div
																class="col-md-12 input-group">

																<label
																	sclass=" font-weight-normal align-text-middle" style=""
																	value="@load(vm.lang.getProperty('DESCRIPCION.label', 'Descripción'))" />

																<tbeditor
																	id="exJUhVjGmh"
																	value="@bind(vm.beanData.descripcion) @save(vm.beanData.descripcion, before=('grabar')) " />
															</h:div>



														</div>
													</tabpanel>
													<tabpanel>
														<div
															class="row">

															<h:div
																class="col-md-12 input-group">

																<label
																	sclass=" font-weight-normal align-text-middle" style=""
																	value="@load(vm.lang.getProperty('INFOHOME.label', ''))" />

																<tbeditor
																	id="CEeHxrMSOk"
																	value="@bind(vm.beanData.infohome) @save(vm.beanData.infohome, before=('grabar')) " />
															</h:div>



														</div>
													</tabpanel>
													<tabpanel>
														<div
															class="row">

															<!--	if(comp.getPropBeans().get("loadOnDemand")!=null) {-->
															<div
																class="col-lg-12">
																<grid
																	id="DLYxuYAHEY" height="400px" width="100%"
																	model="@bind(vm.grid['subslesmodel']) "
																	onCreate="@command('onSubtableCreate',component=self,alias='subslesmodel',loadOnDemand='false'  )">
																	<columns
																		sizable="true">
																		<column
																			label="@load(vm.lang.getProperty('ALIAS.label', 'ALIAS'))"
																			align="center" sclass="text-capitalize" />

																		<column
																			label="@load(vm.lang.getProperty('MODEL.label', 'MODEL'))"
																			align="center" sclass="text-capitalize" />

																		<column
																			label="@load(vm.lang.getProperty('PRICEITEMS.label', 'PRICEITEMS'))"
																			align="center" sclass="text-capitalize" />

																	</columns>

																</grid>
															</div>



														</div>
													</tabpanel>
												</tabpanels>
											</tabbox>



										</div>
									</div>
								</div>
							</div>









							<div id="qJqOHenAal" visible="true"
								class="col-lg-2 col-xlg-2 col-md-2">
								<div id="qJqOHenAal-card"
									class="card  default shadow-lg" style="overflow:hidden;">
									<div id="qJqOHenAal-body"
										class="card-body ">
										<div id="qJqOHenAal-row"
											class="form-group row ">

											<h:div
												class="col-md-12 input-group">

												<label
													sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
													style=""
													value="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" />



												<h:div
													class="image-cropper-container"
													style="width:100%;  height:100%;">
													<image id="AVATAR"
														sclass="image-download"
														content="@load(vm.loadImage('AVATAR'))" width="100%"
														height="100%" />
												</h:div>
												<dropupload
													maxsize="1024" detection="browser" anchor="${AVATAR}"
													content="Drag your image here (max 1024KB)"
													onUpload="@command('onUploadImagen', file=event.media,field='AVATAR')" />



											</h:div>




										</div>
									</div>
								</div>
							</div>










							<div id="fEejxSDFkF" style="overflow:auto;"
