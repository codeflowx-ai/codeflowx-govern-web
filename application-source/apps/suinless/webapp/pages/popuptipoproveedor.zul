<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tipoproveedor" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tipoproveedor')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="tipoproveedor" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.suinless.Sletipoprovgob" />
	   <custom-attributes namespace="suinless" />
	      <custom-attributes uid="21757" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('tipoproveedor.screen', 'Tipo proveedor'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="xRrfabxhII" style="overflow:auto;" class=" default col-lg-12 col-xlg-12 col-md-12"  visible="true" >
<div id="xRrfabxhII-row" class="row">



<div id="KXnzOXCyQo" style="overflow:auto;" class=" default col-lg-6 col-xlg-6 col-md-6"  visible="true" >
<div id="KXnzOXCyQo-row" class="row">


				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('TIPO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))"  />
	   
	    <textbox   tabindex="1" id="286900" 
	   placeholder="@load(vm.lang.getProperty('TIPO.label', 'Tipo'))" 
	   value="@bind(vm.beanData.tipo) @save(vm.beanData.tipo, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('TIPO'))" disabled="@load(vm.isEditable('TIPO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['286900'])"/>
            
	   
    </div>   







<h:div class="col-md-6  input-group">
     <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('NIVEL.label', 'Nivel'))"/>
 


 <combobox mold="rounded" disabled="false"  sclass="" id="NIVEL" model="@load(vm.getEnums('NIVEL'))" 
selectedItem="@load(vm.beanData.nivel)"  value="@load(vm.beanData.nivel) @save(vm.beanData.nivel, before=('grabar')) ">
<template name="model" var="item">
<comboitem value="${item.stValue ne null ? item.stValue:item.stValue}" label="${item.stValue ne null?item.stValue:item.inValue}"/>
</template>
</combobox>
 <label sclass="text-danger" value="@load(vmsgs['NIVEL'])"/>
</h:div>



</div>
</div>  





<div id="XQuwPecYOF" style="overflow:auto;" class=" default col-lg-6 col-xlg-6 col-md-6"  visible="true" >
<div id="XQuwPecYOF-row" class="row">

<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                 <tab label="Resumen" />      
                 <tab label="Reglamento" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFOPUBLIC.label', ''))"/>
	  
	      <textbox rows="4" cols="80" id="EUXmUuGxEU" multiline="true" 
	      placeholder="@load(vm.lang.getProperty('INFOPUBLIC.label', ''))" value="@bind(vm.beanData.infopublic) @save(vm.beanData.infopublic, before=('grabar')) "   visible="@load(vm.isVisible('INFOPUBLIC'))" disabled="@load(vm.isEditable('INFOPUBLIC')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['EUXmUuGxEU'])"/>
	     
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('REGLAMENTO.label', ''))"/>
	  
	      <textbox rows="4" cols="80" id="lUQUmrdmew" multiline="true" 
	      placeholder="@load(vm.lang.getProperty('REGLAMENTO.label', ''))" value="@bind(vm.beanData.reglamento) @save(vm.beanData.reglamento, before=('grabar')) "   visible="@load(vm.isVisible('REGLAMENTO'))" disabled="@load(vm.isEditable('REGLAMENTO')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['lUQUmrdmew'])"/>
	     
</h:div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



</div>
</div>  


</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['tipoproveedor.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 








                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tipoproveedor');
  binder.command('doLoad');
});
function loadtipoproveedor(){
  var binder = zkbind.$('$tipoproveedor');
  binder.command('doLoadBean');

}
</script>	
</zk>