<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="table-responsive table-card">					 
			
				    <grid  	model="@load(vm.beans) @template(each.updatable ? 'modelWrite' : 'model')"  sclass="table align-middle mb-0" >  
							<columns >
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ESTADO.label', 'Estado'))" align="center"   />
							    <column style="font-size:14px;" sclass=" text-capitalize " hflex="1" label="@load(vm.lang.getProperty('ACRONIMO.label', 'Acronimo'))" align="center"   />
 							      <column style="font-size:14px;" hflex="1" label="Acciones" align="center" />
							</columns >
      <template name="model" var="item">
      <row>
       				     <label  value="@load(item.estado) @converter(vm.fieldConverter)"></label>
				     <label  value="@load(item.acronimo) @converter(vm.fieldConverter)"></label>
          <cell align="center"  class="d-flex">
                 <div class="edit">
		           <a onClick="@command('editItem',item=item)"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"  />
				</div>		
							<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger"   />
						</div>
		                </cell> 
       </row>
   	</template>      <template name="modelWrite" var="item">
      	 <row style="text-align:right;" >
           <cell>
				          <textbox  sclass="margin-field form-control  form-control   "  value="@bind(item.estado)  @validator(vm.unique, field='ESTADO',required=true ,oldValue=vm.beanDataCpy.estado)  @save(item.estado, before=('saveItem'))" ></textbox>
				          <label sclass="text-danger" value="@load(vmsgs[self.previousSibling])"/>
                  </cell>
        <cell>
				          <textbox  sclass="margin-field form-control  form-control   "  value="@bind(item.acronimo)  @validator(vm.unique, field='ACRONIMO',required=true ,oldValue=vm.beanDataCpy.acronimo)  @save(item.acronimo, before=('saveItem'))" ></textbox>
				          <label sclass="text-danger" value="@load(vmsgs[self.previousSibling])"/>
                  </cell>

           		<cell align="center"  class="d-flex">
           		 <div class="edit">
  					<a onClick="@command('saveItem',item=item)"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"  />
		           </div>
		           <div class="delete">
		            <a
						onClick="@command('cancelItem',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger"  />
						</div>
                </cell> 
       </row>
   	</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
 </div>						
</zk>						
