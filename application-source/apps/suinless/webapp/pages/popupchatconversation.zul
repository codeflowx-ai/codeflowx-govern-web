<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="chatconversation" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='chatconversation')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="chatconversation" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.suinless.Sleschatconversation" />
	   <custom-attributes namespace="suinless" />
	      <custom-attributes uid="33647" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('chatconversation.screen', 'chatconversation'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="rHCaSWpvPj" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="rHCaSWpvPj-row" class="row">



<div id="BYmwrKdQbf" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="BYmwrKdQbf-row" class="row">

<h:div class="col-md-12  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idxsleschatbot.label', 'ChatBot'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idxsleschatbot" placeholder="@load(vm.lang.getProperty('idxsleschatbot').label,'ChatBot')" model="@bind(vm.foreings['idxsleschatbot'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idxsleschatbot',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idxsleschatbot)"  onCreate="@command('onCreateCombo',component=self,alias='idxsleschatbot')" value="@bind(vm.beanData.idxsleschatbot .chatbotname)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.chatbotname)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idxsleschatbot'])"/>

  
</h:div>


</div>
</div>  





<div id="FWwJhJAYVg" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="FWwJhJAYVg-row" class="row">


				

 <div class="col-md-12  input-group" visible="@load(vm.isVisible('STARTTIME'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="" value="@load(vm.lang.getProperty('STARTTIME.label', 'Hora Inicio'))"/>
	   
	<datebox     id="WbhJdqMdWR" cols="20"  tabindex="1" value="@bind(vm.beanData.starttime) @save(vm.beanData.starttime, before=('grabar')) "   format="dd/MM/yy HH:mm" placeholder="@load(vm.lang.getProperty('STARTTIME.label', 'Hora Inicio'))" 
    visible="@load(vm.isVisible('STARTTIME'))" disabled="@load(vm.isEditable('STARTTIME')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['WbhJdqMdWR'])"/>   
    
  </div>






				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('LANGUAGE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('LANGUAGE.label', 'Idioma'))"  />
	   
	    <textbox   tabindex="2" id="FtzJwpwvUV" 
	   placeholder="@load(vm.lang.getProperty('LANGUAGE.label', 'Idioma'))" 
	   value="@bind(vm.beanData.language) @save(vm.beanData.language, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('LANGUAGE'))" disabled="@load(vm.isEditable('LANGUAGE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['FtzJwpwvUV'])"/>
            
	   
    </div>   






				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('SESSIONID'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SESSIONID.label', 'ID Sesión'))"  />
	   
	    <textbox   tabindex="3" id="qoJQUHCGHL" 
	   placeholder="@load(vm.lang.getProperty('SESSIONID.label', 'ID Sesión'))" 
	   value="@bind(vm.beanData.sessionid) @save(vm.beanData.sessionid, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.sessionid)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('SESSIONID'))" disabled="@load(vm.isEditable('SESSIONID')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['qoJQUHCGHL'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="ySPYIGuBYl" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="ySPYIGuBYl-row" class="row">
</div>
</div>  


</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['chatconversation.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 








                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$chatconversation');
  binder.command('doLoad');
});
function loadchatconversation(){
  var binder = zkbind.$('$chatconversation');
  binder.command('doLoadBean');

}
</script>	
</zk>