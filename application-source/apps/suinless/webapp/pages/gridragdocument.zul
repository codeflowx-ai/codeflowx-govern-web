<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ASSISTANT.label', 'Asistente'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ASSISTANTAsc'])" sortDescending="@load(vm.comparators['ASSISTANTDesc'])"  visible="@load(vm.isVisible('ASSISTANT'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ALTA.label', 'Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ALTAAsc'])" sortDescending="@load(vm.comparators['ALTADesc'])"  visible="@load(vm.isVisible('ALTA'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Proyecto.label', 'Proyecto'))" align="center"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Modelo.label', 'Modelo'))" align="center"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CHATBOT.label', 'chatbot'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CHATBOTAsc'])" sortDescending="@load(vm.comparators['CHATBOTDesc'])"  visible="@load(vm.isVisible('CHATBOT'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('MULTIDIOMA.label', 'Multi Idioma'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['MULTIDIOMAAsc'])" sortDescending="@load(vm.comparators['MULTIDIOMADesc'])"  visible="@load(vm.isVisible('MULTIDIOMA'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='ragdocument.zul')">
							             <label  value="@load(item.assistant) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.alta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idalmproject.proyectoalm) @converter(vm.fieldConverter)"></label>
                                   
                                   
                                          <label  value="@load(item.idslesmodel.model) @converter(vm.fieldConverter)"></label>
                                   
							             <label  value="@load(item.chatbot) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.multidioma) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='ragdocument.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
