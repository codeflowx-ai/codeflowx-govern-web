<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="moderationrule" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='moderationrule')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="moderationrule" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.suinless.Slmrulemoderation" />
	   <custom-attributes namespace="suinless" />
	      <custom-attributes uid="39351" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('moderationrule.screen', 'Reglas de moderacion'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">
<div id="CWzlkUmuWg"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="CWzlkUmuWg-card" class="card  default shadow-lg" style="overflow:hidden;" >
       <div id="CWzlkUmuWg-body" class="card-body ">
        <div id="CWzlkUmuWg-row" class="form-group row ">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('NOMBRE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Regla'))"  />
	   
	    <textbox   tabindex="1" id="934858" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre de la regla'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['934858'])"/>
            
	   
    </div>   






				

  <div class="col-md-2  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', 'Alta'))"/>
	  
	      <label sclass=" font-weight-normal align-text-middle" style="" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) @converter(vm.fieldConverter,type='DATE')"/>
    
      </div>






				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('DESCRIBE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('DESCRIBE.label', 'Descripcion'))"  />
	   
	    <textbox   tabindex="3" id="wsJXsgrLuG" 
	   placeholder="@load(vm.lang.getProperty('DESCRIBE.label', 'Descripcion Corta'))" 
	   value="@bind(vm.beanData.describe) @save(vm.beanData.describe, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('DESCRIBE'))" disabled="@load(vm.isEditable('DESCRIBE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['wsJXsgrLuG'])"/>
            
	   
    </div>   





   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('REGLA.label', 'Definicion'))"/>
	  
	      <textbox rows="16" cols="200" id="OcqVnXIwYT" multiline="true" 
	      placeholder="@load(vm.lang.getProperty('REGLA.label', 'Redacta las reglas de moderacion que se aplicaran a los mensajes'))" value="@bind(vm.beanData.regla) @save(vm.beanData.regla, before=('grabar')) "   visible="@load(vm.isVisible('REGLA'))" disabled="@load(vm.isEditable('REGLA')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['OcqVnXIwYT'])"/>
	     
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        
					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['moderationrule.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 





                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$moderationrule');
  binder.command('doLoad');
});
function loadmoderationrule(){
  var binder = zkbind.$('$moderationrule');
  binder.command('doLoadBean');

}
</script>	
</zk>