<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
			
			
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NOMBREAsc'])" sortDescending="@load(vm.comparators['NOMBREDesc'])"  visible="@load(vm.isVisible('NOMBRE'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ABREVIATURA.label', 'Codigo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ABREVIATURAAsc'])" sortDescending="@load(vm.comparators['ABREVIATURADesc'])"  visible="@load(vm.isVisible('ABREVIATURA'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('FECALTA.label', 'Alta'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FECALTAAsc'])" sortDescending="@load(vm.comparators['FECALTADesc'])"  visible="@load(vm.isVisible('FECALTA'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Estado prompt.label', 'Estado prompt'))" align="center"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Categoría Padre.label', 'Categoría Padre'))" align="center"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Subfamilia.label', 'Subfamilia'))" align="center"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('PROMPTFLOW.label', 'Es prompt flow'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROMPTFLOWAsc'])" sortDescending="@load(vm.comparators['PROMPTFLOWDesc'])"  visible="@load(vm.isVisible('PROMPTFLOW'))"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterpromp.zul')">
							             <label  value="@load(item.nombre) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.abreviatura) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.fecalta) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idslestadopromp.estado) @converter(vm.fieldConverter)"></label>
                                   
                                   
                                          <label  value="@load(item.idslemfamiliapromp.familia) @converter(vm.fieldConverter)"></label>
                                   
                                   
                                          <label  value="@load(item.idslesubfamilia.familia) @converter(vm.fieldConverter)"></label>
                                   
							             <label  value="@load(item.promptflow) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterpromp.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
