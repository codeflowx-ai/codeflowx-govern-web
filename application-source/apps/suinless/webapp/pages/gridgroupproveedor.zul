					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('AVATAR.label', 'avatar'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['AVATARAsc'])" sortDescending="@load(vm.comparators['AVATARDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('PROVIDER.label', 'provider'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['PROVIDERAsc'])" sortDescending="@load(vm.comparators['PROVIDERDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('TIPO.label', 'TIPO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['TIPOAsc'])" sortDescending="@load(vm.comparators['TIPODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('ESTADO.label', 'ESTADO'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ESTADOAsc'])" sortDescending="@load(vm.comparators['ESTADODesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('BACKCOLOR.label', 'BACKCOLOR'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['BACKCOLORAsc'])" sortDescending="@load(vm.comparators['BACKCOLORDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('NIVEL.label', 'NIVEL'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NIVELAsc'])" sortDescending="@load(vm.comparators['NIVELDesc'])"/>
							       <column hflex="1" label="@load(vm.lang.getProperty('URLWEB.label', 'Web'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['URLWEBAsc'])" sortDescending="@load(vm.comparators['URLWEBDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
                                   <image content="@load(vm.getImage(item,'AVATAR'))" width="50%" height="50%" />
							         <label  value="@load(item.getFieldByAtribute('PROVIDER').value) @converter(vm.fieldConverter)"></label>
                                   
                                   <label  value="@load(item.getFieldByAtribute('tipo').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('estado').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('backcolor').value) @converter(vm.fieldConverter)"></label>
                                   <label  value="@load(item.getFieldByAtribute('nivel').value) @converter(vm.fieldConverter)"></label>
							         <label  value="@load(item.getFieldByAtribute('URLWEB').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='masterproveedor.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
