<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('NIVEL.label', 'Nivel'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NIVELAsc'])" sortDescending="@load(vm.comparators['NIVELDesc'])"  visible="@load(vm.isVisible('NIVEL'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('ACTUALIZACION.label', 'Actualizacion'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTUALIZACIONAsc'])" sortDescending="@load(vm.comparators['ACTUALIZACIONDesc'])"  visible="@load(vm.isVisible('ACTUALIZACION'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Estado Cumplimiento.label', 'Estado Cumplimiento'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='mastercumplimiento.zul')">
							             <label  value="@load(item.nivel) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.actualizacion) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idsleestadogob.estado) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='mastercumplimiento.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
