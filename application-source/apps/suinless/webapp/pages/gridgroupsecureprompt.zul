					 <grid  height="600px" width="100%"	model="@load(vm.groups)" >  
							<columns sizable="true" menupopup="auto">
							       <column hflex="1" label="@load(vm.lang.getProperty('NAME.label', 'name'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['NAMEAsc'])" sortDescending="@load(vm.comparators['NAMEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('ACTIVO.label', 'activo'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['ACTIVOAsc'])" sortDescending="@load(vm.comparators['ACTIVODesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('DESCRIBE.label', 'describe'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['DESCRIBEAsc'])" sortDescending="@load(vm.comparators['DESCRIBEDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('GLOBALCHAT.label', 'globalchat'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['GLOBALCHATAsc'])" sortDescending="@load(vm.comparators['GLOBALCHATDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('MEDIATIC.label', 'mediatic'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['MEDIATICAsc'])" sortDescending="@load(vm.comparators['MEDIATICDesc'])" />
							       <column hflex="1" label="@load(vm.lang.getProperty('FILTERPROMPT.label', 'filterprompt'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['FILTERPROMPTAsc'])" sortDescending="@load(vm.comparators['FILTERPROMPTDesc'])" />
 							      <column hflex="1" align="center" />
							</columns >
							<!-- template for group -->
                              <template name="model:group">
                                <group label="@load(each)" style="text-align:left;"/>
                              </template>
							<template name="model" var="item">
                  			<row style="text-align:right;">
							         <label  value="@load(item.getFieldByAtribute('NAME').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('ACTIVO').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('DESCRIBE').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('GLOBALCHAT').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('MEDIATIC').value) @converter(vm.fieldConverter)"></label>
                                   
							         <label  value="@load(item.getFieldByAtribute('FILTERPROMPT').value) @converter(vm.fieldConverter)"></label>
                                   
							
                  			
                  		<cell align="center">
						<button
						onClick="@command('editData',item=item,page='mastersecureprompt.zul')"
						iconSclass="icon-pencil7" sclass="btn btn-outline-secondary" />
						<space></space>
						<button
						onClick="@command('removeData',item=item)"
						iconSclass="icon-trash"
						sclass="btn btn-outline-warning" />
						
					    </cell>
					   </row>
					   
                  		</template>
                  		            		 <!-- template for footer -->
        <template name="model:groupfoot">
            <groupfoot>
                <cell colspan="5" style="text-align: right; padding-right: 15px">
                    <label value="@load(each)" style="font-weight:bold;" />
                </cell>
            </groupfoot>
        </template>
							<foot>
						     <footer span="4" align="right" label="@load(vm.labelTotal)" />
						    </foot>
						</grid>
