 onClick="@command('onChangeFindTextForeing',alias='idalmproject',att='proyectoalm',event=event,idcp='cbCTgYIJgYyv')" onChange="@command('onChangeFindTextForeing',alias='idalmproject',att='proyectoalm',event=event,idcp='cbCTgYIJgYyv')"  sclass="form-control  bg-light border-0" />
<combobox id="cbCTgYIJgYyv" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idalmproject'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='true',alias='idalmproject',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.proyectoalm}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxCTgYIJgYyv'])"/></h:div>
<window id="searchCTgYIJgYyv" mode="modal" visible="false">
<div class="modal-dialog modal-dialog-centered modal-lg">
