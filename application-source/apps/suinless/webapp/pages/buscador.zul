<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
	<div class="row">
		<div>
			<div class="left tittle-principal">
				<h:h2 class="mb-sm-0">Leka Desktop</h:h2>
			</div>
		</div>
		<div class="col-lg-12 s-bot ">
			<div class="row">
				<div class="col-12 mb-4">
					<label class="txt-mkt">
						Configura Leka, para integrar diferentes modelos
						fundacionales de I.A. en las aplicaciones
						creadas con suinsit, para que puedan ser usadas
						por vuestros usuarios.
					</label>
				</div>
			</div>
			<div class="row">

				<div class="col-12 mb-12">
					<div class="card cards-mkt-sf">
						<div class="mkt-dp">


							<div class="row">
								<div class="col-6 mb-4">
									<div class="chatbot">
										<div class="chatbot-header">
											<h:img
												src="../img/leka-1.png" alt="Chat Icon" />
											<h:h5>LEKA</h:h5>
										</div>
										<div class="chatbot-body">
											<h:h6>
												¿Qué tipo de modelo
												estas buscando?
												Pregúntanos.
											</h:h6>
											<hlayout class="b-bot">
												<div id="areaMsg"
													class="area-msgchat" vflex="1">
													<forEach
														items="@bind(vm.chatmsgs)" var="item">
														<choose>
															<when
																test="${item.usuario}">
																<div
																	sclass="col-12 col-md-12 col-lg-12 stl-chat">
																	<if
																		test="${item.user ne null}">
																		<label
																			value="${item.user}" sclass="${item.sclass}">
																		</label>
																	</if>
																	<if
																		test="${item.message ne null}">
																		<label
																			value="${item.message}" sclass="${item.sclass}"
																			multiline="true">
																		</label>
																	</if>
																</div>

															</when>
															<when
																test="${item.assistan}">
																<if
																	test="${item.icon ne null}">
																	<h:icon
																		sclass="${item.icon}">
																	</h:icon>
																</if>
																<if
																	test="${item.message ne null}">
																	<label
																		value="${item.message}" sclass="${item.sclass}"
																		multiline="true">
																	</label>
																</if>
															</when>
															<otherwise>
															</otherwise>
														</choose>
													</forEach>
												</div>

											</hlayout>
											<textbox id="tbmessage"
												multiline="true" rows="3" class="form-control"
												placeholder="Escribe tu mensaje..."
												value="@bind(vm.chatmsg)" />

											<button
												class="btn btn-primary"
												onClick="@command('sendChatMessage')">
												Enviar Mensaje
											</button>
										</div>
									</div>

								</div>
								<div class="col-6 mb-6">
									<div class="chatbot">
										<div
											class="chatbot-header justify-content-center">
											<h:h5>
												Modelos Disponibles
											</h:h5>
										</div>
										<div class="chatbot-body"
											height="548px">
											
											<listbox id="messages"
												model="@load(vm.messages)">
												<listhead>
													<listheader
														label="Modelos" sort="auto" />
												</listhead>
												<template name="model"
													var="item">
													<listitem
														value="${item}">
														<listcell
															label="${item}">
														</listcell>
													</listitem>
												</template>
											</listbox>
										</div>
									</div>
								</div>
							</div>


						</div>

					</div>
				</div>
			</div>
		</div>
	</div>


</zk>