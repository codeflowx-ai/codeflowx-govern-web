<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
				
			
			
				<grid  	model="@load(vm.beans)"   style="overflow:auto;" >  
							<columns sizable="true" columnsgroup="false" columnshide="false" >
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('CHATBOTNAME.label', 'Nombre Chatbot'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['CHATBOTNAMEAsc'])" sortDescending="@load(vm.comparators['CHATBOTNAMEDesc'])"  visible="@load(vm.isVisible('CHATBOTNAME'))"/>
							    <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('HUMANHANDOFFTHRESHOLD.label', 'Umbral Derivación Humano'))" align="center" sort="auto"  sortAscending="@load(vm.comparators['HUMANHANDOFFTHRESHOLDAsc'])" sortDescending="@load(vm.comparators['HUMANHANDOFFTHRESHOLDDesc'])"  visible="@load(vm.isVisible('HUMANHANDOFFTHRESHOLD'))"/>
							      <column  sclass=" text-capitalize "  label="@load(vm.lang.getProperty('Proyecto RAG.label', 'Proyecto RAG'))" align="center"/>
 							      <column  label="Acciones" align="center" width="150px;"/>
							</columns >
							<template name="model" var="item">
						       <row style="text-align:right;cursor:pointer;"  onClick="@command('editData',item=item,page='masterchatbot.zul')">
							             <label  value="@load(item.chatbotname) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
							             <label  value="@load(item.humanhandoffthreshold) @converter(vm.fieldConverter)"></label>
							              
							          
                                   
                                   
                                          <label  value="@load(item.idslesragproject.projectname) @converter(vm.fieldConverter)"></label>
                                   
	               		<cell align="center"  class="d-flex">
                  		<div class="edit">
							<a
						onClick="@command('editData',item=item,page='masterchatbot.zul')"
						iconSclass="fa-duotone fa-solid fa-pen-to-square fs-2x"
													sclass="waves-effect waves-success"   />
						</div>
						<div class="delete">
						<a
						onClick="@command('removeData',item=item)"
						iconSclass="fa-light fa-nfc-trash fa-xl" 	sclass="waves-effect waves-danger" 
						  />
						</div>
						
					    </cell>
					   </row>
                  		</template>
							<foot>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
							      <footer>
							      </footer>
						     <!--<footer span="4" align="right" label="@load(vm.labelTotal)" />-->
						    </foot>
						</grid>
						
</zk>						
