<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">
<idspace id="tiposvariables" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='tiposvariables')" validationMessages="@id('vmsgs')">
	   <space></space>
	  <custom-attributes pagina="tiposvariables" />
	  <custom-attributes loadScreen="true" />
<custom-attributes clase="org.suinsit.apps.suinless.Slestypevar" />
	   <custom-attributes namespace="suinless" />
	      <custom-attributes uid="90471" />
	      <custom-attributes tipo="MASTER" />
	      <panel >
			<panelchildren>
			 <div class="row">
	       <div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-2">
							<div class="flex-grow-1">
							 <div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('tiposvariables.screen', 'tiposvariables'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
                
             </div>
                              </div>
                              <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">						 	
									<a onClick="@command('grabar',action='continuar')"
										class="waves-effect waves-success"
										iconSclass="fa-duotone fa-floppy-disk align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('grabar',action='nuevo')"
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right align-middle fs-16 me-2" >
										
									</a>
									<a onClick="@command('cerrarPopup')"
										class="waves-effect waves-dark" iconSclass="fa-duotone fa-arrow-left-from-arc align-middle fs-16 me-2">
										
									</a>
								       </div>
	  	                     </div>
						</div>
					</div> <!-- header -->
					  <div class="card-body">
					    <div class="row">

<div id="kWreXvszMl" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="kWreXvszMl-row" class="row">



<div id="PqmmVnhQuq" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="PqmmVnhQuq-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('JAVATYPE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('JAVATYPE.label', 'Tipo de Java'))"  />
	   
	    <textbox   tabindex="1" id="bWvLlYtQha" 
	   placeholder="@load(vm.lang.getProperty('JAVATYPE.label', 'Tipo de Java'))" 
	   value="@bind(vm.beanData.javatype) @save(vm.beanData.javatype, before=('grabar')) @validator(vm.validator,required=true ,oldValue=vm.beanDataCpy.javatype)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('JAVATYPE'))" disabled="@load(vm.isEditable('JAVATYPE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['bWvLlYtQha'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="zQilXhmuvn" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="zQilXhmuvn-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('NOMBRE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))"  />
	   
	    <textbox   tabindex="1" id="72125" 
	   placeholder="@load(vm.lang.getProperty('NOMBRE.label', 'Nombre'))" 
	   value="@bind(vm.beanData.nombre) @save(vm.beanData.nombre, before=('grabar')) @validator(vm.unique, field='NOMBRE',required=true ,oldValue=vm.beanDataCpy.nombre)"  sclass="   border-danger" 
	   visible="@load(vm.isVisible('NOMBRE'))" disabled="@load(vm.isEditable('NOMBRE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['72125'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="moKgtXQnJD" style="overflow:hidden;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="moKgtXQnJD-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('TYPEFRONT'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TYPEFRONT.label', 'Tipo de front'))"  />
	   
	    <textbox   tabindex="1" id="RnyUWmSmhT" 
	   placeholder="@load(vm.lang.getProperty('TYPEFRONT.label', 'Tipo de front'))" 
	   value="@bind(vm.beanData.typefront) @save(vm.beanData.typefront, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('TYPEFRONT'))" disabled="@load(vm.isEditable('TYPEFRONT')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['RnyUWmSmhT'])"/>
            
	   
    </div>   




</div>
</div>  


</div>
</div>  					  </div>
					  </div> <!-- body -->		
					 </div> <!-- card --> 
					 </div> <!-- cold -->  
                    </div>
                    </panelchildren>
                </panel>    
            <fragment exps="@load(vm.lang['tiposvariables.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>
                 







                  
            <window id="WIN_HELP" mode="modal" visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
  <script>
zk.afterMount(function() {
 var binder = zkbind.$('$tiposvariables');
  binder.command('doLoad');
});
function loadtiposvariables(){
  var binder = zkbind.$('$tiposvariables');
  binder.command('doLoadBean');

}
</script>	
</zk>