<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">


	<idspace
		viewModel="@id('vm') @init('com.suinsit.nocode.semantic.ui.EvalContentUI')">

		<div id="notificacion"></div>

		<div class="row">
			<div class="col-12">
				<div
					class="page-title-box d-sm-flex align-items-center justify-content-between">
					<vbox spacing="3px">
						<label value="Suinless - Contenidos"
							sclass="h3">
						</label>

					</vbox>
					<h:div class="page-title-right">
						<h:ol class="breadcrumb m-0">
							<h:li class="breadcrumb-item">
								<h:a href="javascript: void(0);">
									${ds.menu}
								</h:a>
							</h:li>
							<h:li class="breadcrumb-item active">
								contenido
							</h:li>
						</h:ol>
					</h:div>
				</div>
			</div>
		</div>
		<div class="col-lg-12">
			<div class="card">
				<div class="card-header">
					<div
						class="d-flex align-items-center flex-wrap gap-2">
						<div class="flex-grow-1">
							
						</div>
						<div class="flex-shrink-0">
							<div class="hstack text-nowrap gap-2">
								<div class="hstack text-nowrap gap-2">

									<button tooltiptext="Evaluar"
										iconSclass="mdi mdi-motion-play-outline label-icon align-middle fs-16 me-2"
										onClick="@command('evalContent')"
										sclass="btn btn-label btn-secondary waves-effect waves-light">
										Evaluar Contenido
									</button>

								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div><!--end col-->
		<space></space>
		<div class="row">
			<div visible="true"
				class="col-lg-12 col-xlg-12 col-md-12">
				<div class="card  shadow-xl" style="overflow:auto;">
					<div class="card-body ">
						<div class="form-group row ">
							<h:div class="col-md-2">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="¿ Quien eres ?" />
								</hbox>
								<combobox value="@bind(vm.systems)"
									selectedItem="@bind(vm.systems)">
									<comboitem
										label="Soy administrativo" />
									<comboitem label="Soy abogado" />
									<comboitem label="Soy economista" />
									<comboitem label="Soy financiero" />
									<comboitem
										label="Soy técnico de marketing" />
									<comboitem label="Soy publicista" />
								</combobox>

							</h:div>
							<h:div class="col-md-2">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="¿Qué deseas recibir ?" />
								</hbox>
								<combobox value="@bind(vm.quiero)"
									selectedItem="@bind(vm.quiero)">
									<comboitem
										label="Quiero Información" />
									<comboitem
										label="Quiero Asesoramiento" />
									<comboitem
										label="Crear un contenido publicitario" />
									<comboitem
										label="Crear un post redes" />
									<comboitem label="Crear un slogan" />
								</combobox>

							</h:div>

							<h:div class="col-md-3">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="¿Qué Contenido quieres crear?" />
								</hbox>
								<textbox tabindex="1"
									value="@bind(vm.evalText)"
									sclass="margin-field form-control  form-control " width="98%"
									multiline="true" rows="4">
								</textbox>

							</h:div>
							<h:div class="col-md-3">
								<hbox spacing="3px"
									sclass="margin-field">
									<!-- 									<label -->
									<!-- 										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle" -->
									<!-- 										style="" value="Nombre del Contenido para publicar" /> -->
								</hbox>
								<!-- 								<textbox tabindex="1" value="" -->
								<!-- 									sclass="margin-field form-control  form-control " -->
								<!-- 									width="98%"> -->
								<!-- 								</textbox> -->

							</h:div>
						</div>
					</div>
				</div>
			</div>
			<div visible="true"
				class="col-lg-10 col-xlg-10 col-md-10">
				<div class="card  shadow-xl" style="overflow:auto;">
					<div class="card-body ">
						<div class="form-group row ">
							<div id="divEditor"></div>

						</div>
					</div>
				</div>
			</div>
			<div visible="true" class="col-lg-2 col-xlg-2 col-md-2">
				<div class="card  shadow-xl" style="overflow:auto;">
					<div class="card-body ">
						<div class="form-group row ">
							<h:div class="col-md-12">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="Núm. Max. Tokens" />
								</hbox>


								<slider maxpos="5000" minpos="100"
									scaleInput="50" curpos="@bind(vm.tokens)" />
							</h:div>
							<h:div class="col-md-12">
								<hbox spacing="3px"
									sclass="margin-field">
									<label
										sclass="fs-6 text form-label  text-capitalize  font-weight-normal align-text-middle"
										style="" value="Total tokens" />
								</hbox>
								<intbox tabindex="1"
									value="@bind(vm.tokensRes)"
									sclass="margin-field form-control  form-control "
									width="40%">
								</intbox>

							</h:div>
						</div>
					</div>
				</div>
			</div>
		</div>

	</idspace>
</zk>