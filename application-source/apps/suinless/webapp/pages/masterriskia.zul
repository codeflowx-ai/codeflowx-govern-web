<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="riskia" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='riskia')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="riskia" />
	<custom-attributes clase="org.suinsit.apps.suinless.Sleriskia" />
	   <custom-attributes namespace="suinless" />
		<custom-attributes uid="79797" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('riskia.screen', 'Riesgos de IA'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="HHGipjMIsm"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="HHGipjMIsm-card" class="card  default shadow-lg" style="overflow:hidden;" >
       <div id="HHGipjMIsm-body" class="card-body ">
        <div id="HHGipjMIsm-row" class="form-group row ">


				

    <div class="col-md-4  input-group" visible="@load(vm.isVisible('TITULO'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('TITULO.label', 'Titulo'))"  />
	   
	    <textbox   tabindex="1" id="449734" 
	   placeholder="@load(vm.lang.getProperty('TITULO.label', 'Titulo'))" 
	   value="@bind(vm.beanData.titulo) @save(vm.beanData.titulo, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('TITULO'))" disabled="@load(vm.isEditable('TITULO')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['449734'])"/>
            
	   
    </div>   





<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslenivelrisk.label', 'Nivel de Riesgo'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslenivelrisk" placeholder="@load(vm.lang.getProperty('idslenivelrisk').label,'Nivel de Riesgo')" model="@bind(vm.foreings['idslenivelrisk'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslenivelrisk',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslenivelrisk)"  onCreate="@command('onCreateCombo',component=self,alias='idslenivelrisk')" value="@bind(vm.beanData.idslenivelrisk .nivel)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.nivel)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslenivelrisk'])"/>

  
</h:div>


         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        




<tabbox orient="top" mold="default" width="100%" maximalHeight="true" >
     <tabs>
                 <tab label="Info Breve" />      
                 <tab label="Info Ampliada" />      
     </tabs>
     <tabpanels>
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('DESCBREVE.label', ''))"/>
	  
	  <tbeditor id="GgJGuynYys" value="@bind(vm.beanData.descbreve) @save(vm.beanData.descbreve, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
      <tabpanel>
        <div class="row">

   <h:div class="col-md-12 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INFOPUBLIC.label', ''))"/>
	  
	  <tbeditor id="MzzJXeyBUg" value="@bind(vm.beanData.infopublic) @save(vm.beanData.infopublic, before=('grabar')) " />
</h:div>



         </div>
      </tabpanel>   
     </tabpanels>
</tabbox> 



               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['riskia.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>







		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$riskia');
  binder.command('doLoad');
});
</script>
</zk>