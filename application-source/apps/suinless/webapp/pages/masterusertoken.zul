<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="usertoken" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='usertoken')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="usertoken" />
	<custom-attributes clase="org.suinsit.apps.suinless.Slrlogtoken" />
	   <custom-attributes namespace="suinless" />
		<custom-attributes uid="62872" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('usertoken.screen', 'Consumo Tokens'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="DemYuupjAg"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="DemYuupjAg-card" class="card  default shadow-lg" style="overflow:hidden;" >
       <div id="DemYuupjAg-body" class="card-body ">
        <div id="DemYuupjAg-row" class="form-group row ">


				

 <div class="col-md-2  input-group" visible="@load(vm.isVisible('FECHA'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle " style="" value="@load(vm.lang.getProperty('FECHA.label', 'Fecha'))"/>
	   
	<datebox     id="907883" cols="20"  tabindex="1" value="@bind(vm.beanData.fecha) @save(vm.beanData.fecha, before=('grabar')) "   format="dd/MM/yy HH:mm" placeholder="@load(vm.lang.getProperty('FECHA.label', 'fecha'))" 
    visible="@load(vm.isVisible('FECHA'))" disabled="@load(vm.isEditable('FECHA')?false:true)" sclass="margin-field"/>
    <label sclass="text-danger" value="@load(vmsgs['907883'])"/>   
    
  </div>






				

    <div class="col-md-2  input-group" visible="@load(vm.isVisible('INTOKEN'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('INTOKEN.label', 'Token IN'))"/>
	
	      <decimalbox   tabindex="2" id="YdHUZncyqY"  placeholder="@load(vm.lang.getProperty('INTOKEN.label', 'intoken'))"  value="@bind(vm.beanData.intoken) @save(vm.beanData.intoken, before=('grabar')) "  format="###,###,##0.00" 
	      sclass="   " visible="@load(vm.isVisible('INTOKEN'))" disabled="@load(vm.isEditable('INTOKEN')?false:true)" onChange="@command('onChangeInput',field='INTOKEN',evento=event,componente=self,calculate=true)" />
           <label sclass="text-danger" value="@load(vmsgs['YdHUZncyqY'])"/>   
    </div>






				

    <div class="col-md-3  input-group" visible="@load(vm.isVisible('OUTTOKEN'))" >
    
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('OUTTOKEN.label', 'Token Out'))"/>
	
	      <intbox   tabindex="3" id="MvsjXAmuLm"  placeholder="@load(vm.lang.getProperty('OUTTOKEN.label', 'outtoken'))" sclass="  "  value="@bind(vm.beanData.outtoken) @save(vm.beanData.outtoken, before=('grabar')) " visible="@load(vm.isVisible('OUTTOKEN'))" disabled="@load(vm.isEditable('OUTTOKEN')?false:true)" onChange="@command('onChangeInput',field='OUTTOKEN',evento=event,componente=self,calculate=true)" />
    <label sclass="text-danger" value="@load(vmsgs['MvsjXAmuLm'])"/>   
    
    </div>






				

 <div class="col-md-3  input-group" visible="@load(vm.isVisible('PRICE'))" >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PRICE.label', 'Importe'))"/>
	   
   <decimalbox   tabindex="4" id="xKOSzjOoze" onCreate="" placeholder="@load(vm.lang.getProperty('PRICE.label', 'price'))"   
    value="@bind(vm.beanData.price) @save(vm.beanData.price, before=('grabar')) "  format="###,###,###,###,##0.00€"  sclass="  " visible="@load(vm.isVisible('PRICE'))" disabled="@load(vm.isEditable('PRICE')?false:true)" onChange="@command('onChangeInput',field='PRICE',evento=event,componente=self,calculate=true)"/>
    <label sclass="text-danger" value="@load(vmsgs['xKOSzjOoze'])"/>
 
  </div>






 <div class="col-md-2   input-grou" visible="@load(vm.isVisible('BILLING'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('BILLING.label', 'Facturado'))"/>
	        <label  value="@bind(vm.beanData.billing) @save(vm.beanData.billing, before=('grabar')) @converter(vm.fieldConverter)"></label>
	     
 
</div>




<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idalmproject.label', 'Proyecto'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idalmproject" placeholder="@load(vm.lang.getProperty('idalmproject').label,'Proyecto')" model="@bind(vm.foreings['idalmproject'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idalmproject',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idalmproject)"  onCreate="@command('onCreateCombo',component=self,alias='idalmproject')" value="@bind(vm.beanData.idalmproject .proyectoalm)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.proyectoalm)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idalmproject'])"/>

  
</h:div>



<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslesmodel.label', 'Modelo'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslesmodel" placeholder="@load(vm.lang.getProperty('idslesmodel').label,'Modelo')" model="@bind(vm.foreings['idslesmodel'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslesmodel',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslesmodel)"  onCreate="@command('onCreateCombo',component=self,alias='idslesmodel')" value="@bind(vm.beanData.idslesmodel .model)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.model)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslesmodel'])"/>

  
</h:div>



<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idssousuario.label', 'Usuario'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idssousuario" placeholder="@load(vm.lang.getProperty('idssousuario').label,'Usuario')" model="@bind(vm.foreings['idssousuario'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idssousuario',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idssousuario)"  onCreate="@command('onCreateCombo',component=self,alias='idssousuario')" value="@bind(vm.beanData.idssousuario .usuario)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.usuario)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idssousuario'])"/>

  
</h:div>



   <h:div class="col-md-6 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('PROMPT.label', 'Prompt'))"/>
	  
	      <textbox rows="4" cols="80" id="GiateEZidC" multiline="true" placeholder="@load(vm.lang.getProperty('PROMPT.label', 'prompt'))" value="@bind(vm.beanData.prompt) @save(vm.beanData.prompt, before=('grabar')) "   visible="@load(vm.isVisible('PROMPT'))" disabled="@load(vm.isEditable('PROMPT')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['GiateEZidC'])"/>
	     
</h:div>




   <h:div class="col-md-6 input-group">
     
	    <label sclass=" font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('USERMSG.label', 'User Msg.'))"/>
	  
	      <textbox rows="4" cols="80" id="YcAEsRPpJo" multiline="true" placeholder="@load(vm.lang.getProperty('USERMSG.label', 'usermsg'))" value="@bind(vm.beanData.usermsg) @save(vm.beanData.usermsg, before=('grabar')) "   visible="@load(vm.isVisible('USERMSG'))" disabled="@load(vm.isEditable('USERMSG')?false:true)"/>
           <label sclass="text-danger" value="@load(vmsgs['YcAEsRPpJo'])"/>
	     
</h:div>



         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        



               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['usertoken.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>












		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$usertoken');
  binder.command('doLoad');
});
</script>
</zk>