<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="variablesprompt" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='variablesprompt')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="variablesprompt" />
	<custom-attributes clase="org.suinsit.apps.suinless.Slervar" />
	   <custom-attributes namespace="suinless" />
		<custom-attributes uid="23139" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('variablesprompt.screen', 'variablesprompt'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')"></a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">



<div id="EokiAxArHn" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="false" >
<div id="EokiAxArHn-row" class="row">



<div id="tDAyLAwlEX" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="tDAyLAwlEX-row" class="row">

<h:div class="col-md-12  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslespromp.label', 'Promp'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslespromp" placeholder="@load(vm.lang.getProperty('idslespromp').label,'Promp')" model="@bind(vm.foreings['idslespromp'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslespromp',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslespromp)"  onCreate="@command('onCreateCombo',component=self,alias='idslespromp')" value="@bind(vm.beanData.idslespromp .nombre)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.nombre)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslespromp'])"/>

  
</h:div>


</div>
</div>  





<div id="vjhyVZmvbS" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="vjhyVZmvbS-row" class="row">


				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('VARIABLE'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('VARIABLE.label', 'Variable'))"  />
	   
	    <textbox   tabindex="1" id="945017" 
	   placeholder="@load(vm.lang.getProperty('VARIABLE.label', 'Variable'))" 
	   value="@bind(vm.beanData.variable) @save(vm.beanData.variable, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('VARIABLE'))" disabled="@load(vm.isEditable('VARIABLE')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['945017'])"/>
            
	   
    </div>   






 <div class="col-md-12   leka-filters leka-d-flex  input-grou" visible="@load(vm.isVisible('REQUIRED'))">
 <div
															class="col-md-6">
 	    <label sclass="form-check-label l align-text-middle p-0 font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('REQUIRED.label', 'Requerido'))"/>
 	    </div>
	      <div
															class="col-md-6">
             <checkbox mold="default" id="tczDdRJcEF" value="@bind(vm.beanData.required) @save(vm.beanData.required, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('REQUIRED'))" disabled="@load(vm.isEditable('REQUIRED')?false:true)" checked="@bind(vm.beanData.required) @save(vm.beanData.required, before=('grabar'))"/>
             </div>	      
	     
 
</div>





				

    <div class="col-md-12  input-group" visible="@load(vm.isVisible('ETIQUETA'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('ETIQUETA.label', 'Etiqueta'))"  />
	   
	    <textbox   tabindex="3" id="140054" 
	   placeholder="@load(vm.lang.getProperty('ETIQUETA.label', 'Etiqueta'))" 
	   value="@bind(vm.beanData.etiqueta) @save(vm.beanData.etiqueta, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('ETIQUETA'))" disabled="@load(vm.isEditable('ETIQUETA')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['140054'])"/>
            
	   
    </div>   




</div>
</div>  





<div id="JrnwfccMiG" style="overflow:auto;" class=" default col-lg-4 col-xlg-4 col-md-4"  visible="true" >
<div id="JrnwfccMiG-row" class="row">

<h:div class="col-md-12  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idslestypevar.label', 'Tipo variable'))"/>
   
<combobox mold="rounded" autodrop="true"  id="idslestypevar" placeholder="@load(vm.lang.getProperty('idslestypevar').label,'Tipo variable')" model="@bind(vm.foreings['idslestypevar'])"  visible="true"	onSelect="@command('onSelectForeing', alias='idslestypevar',item=self.selectedItem.value,updatebean='false')"  		selectedItem="@load(vm.beanData.idslestypevar)"  onCreate="@command('onCreateCombo',component=self,alias='idslestypevar')" value="@bind(vm.beanData.idslestypevar .nombre)"  ><template name="model" var="item"><comboitem value="@load(item)" label="@load(item.nombre)" /></template></combobox>
 <label sclass="text-danger" value="@load(vmsgs['idslestypevar'])"/>

  
</h:div>


</div>
</div>  


</div>
</div>  


               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['variablesprompt.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>










		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$variablesprompt');
  binder.command('doLoad');
});
</script>
</zk>