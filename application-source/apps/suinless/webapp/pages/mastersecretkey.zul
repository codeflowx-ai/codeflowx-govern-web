<?component name="includeHTML" extends="include" class="org.enartframework.zk.utils.IncludeHTML"?>
<?component name="extHTML" extends="html" class="org.suinsit.nocode.web.components.HtmlExt"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<zk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul/zul.xsd"
	xmlns:h="xhtml"
	xmlns:d="http://www.zkoss.org/2005/zk/client/attribute">

<idspace  id="secretkey" viewModel="@id('vm') @init('org.suinsit.nocode.web.MasterBeanUI',pagina='secretkey')" validationMessages="@id('vmsgs')">
	  <custom-attributes pagina="secretkey" />
	<custom-attributes clase="org.suinsit.apps.suinless.Slkeyproject" />
	   <custom-attributes namespace="suinless" />
		<custom-attributes uid="617" />
	   <custom-attributes tipo="MASTER" />
	  	<h:div id="notificacion"></h:div>
	  	<div class="row">
			<div class="col-lg-12 s-bot">
				<div class="card">
					<div class="card-header">
						<div 	class="d-flex align-items-center flex-wrap gap-3">
						<div class="left tittle-principal">
                <fragment 	exps="@load(vm.lang.getProperty('secretkey.screen', 'Acceso Leka'))">
						<![CDATA[ <h2 class="mb-sm-0"
						textContent='@load(exps)'></h2> ]]>
					</fragment>
             </div>
							<div class="flex-grow-1">
								<a
									iconSclass="fa-duotone fa-solid fa-reply label-icon align-middle fs-16 me-2"
									onClick="@command('toSearch')"
									sclass="waves-effect waves-light"
									tooltiptext="Volver">
								</a>
							</div>
	                  	     <div class="flex-shrink-0">
								    <div class="hstack text-nowrap gap-2 d-flex">
								    <a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-paintbrush-fine label-icon align-middle fs-16 me-2" onClick="@command('clear')">
									</a>
									<a class="waves-effect waves-light"
										iconSclass="fa-duotone fa-solid fa-floppy-disks label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='continuar')">
										
									</a>
									<a
										class="waves-effect waves-light" iconSclass="fa-duotone fa-floppy-disk-circle-arrow-right label-icon align-middle fs-16 me-2" onClick="@command('grabar',action='nuevo')">
										
									</a>
	  	                            </div>
	  	                     </div>
	  	              </div>
	  	          </div><!--header-->
	  	          <div class="card-body">
		              <div class="row">


<div id="zHQXWTLEFQ"   visible="true"  class="col-lg-12 col-xlg-12 col-md-12">
  <div id="zHQXWTLEFQ-card" class="card  default" style="overflow:hidden;" >
       <div id="zHQXWTLEFQ-body" class="card-body ">
        <div id="zHQXWTLEFQ-row" class="form-group row ">

<h:div class="col-md-4  input-group">
   
   
    <label sclass="text  form-label text-capitalize font-weight-normal" style="" value="@load(vm.lang.getProperty('idalmproject.label', 'Proyecto'))"/>
   
<h:div class="col-md-12">
<div >
<a  iconSclass="fa-duotone fa-magnifying-glass-waveform"  onClick="@command('findComboForeing',win=searchqzTexLMpkk,alias='idalmproject',input=tboxqzTexLMpkk) " /><a  iconSclass="fa-duotone fa-broom-wide"  onClick="@command('clearForeing',alias='idalmproject')">	</a>
</div>
</h:div>
<h:div class="mb-2">
<textbox id="tboxqzTexLMpkk"  placeholder="" value="@bind(vm.beanData.idalmproject.proyectoalm) @save(vm.beanData.idalmproject.proyectoalm, before=('grabar'))  " 
 onClick="@command('onChangeFindTextForeing',alias='idalmproject',att='proyectoalm',event=event,idcp='cbqzTexLMpkk')" onChange="@command('onChangeFindTextForeing',alias='idalmproject',att='proyectoalm',event=event,idcp='cbqzTexLMpkk')"  sclass="form-control  bg-light border-0" />
<combobox id="cbqzTexLMpkk" mold="rounded" autodrop="true" visible="false" model="@load(vm.foreings['idalmproject'])" onSelect="@command('onSelectTextForeing',item=self.selectedItem.value,updatebean='false',alias='idalmproject',hidde=self)" width="85%">
<template name="model" var="item"><comboitem value="${item}" label="${item.proyectoalm}"></comboitem>
</template></combobox>
<label sclass="text-danger" value="@load(vmsgs['tboxqzTexLMpkk'])"/></h:div>
<window id="searchqzTexLMpkk" mode="modal" visible="false">
<div class="modal-dialog modal-dialog-centered modal-lg">
<div class="modal-content border-0">
<div class="modal-header bg-soft-info p-3">
<h:h5 class="modal-title" id="examplesqzTexLMpkk">Proyecto</h:h5>
<a id="btn_SqzTexLMpkk" class="btn-close"  onClick="searchqzTexLMpkk.visible=false" ></a>
</div><div class="modal-body">
<div sclass="mb-2">
<textbox sclass="form-control  bg-light border-0" placeholder="introduzca criterios..." onOK="@command('onChangeFindForeing',alias='idalmproject',att='proyectoalm,',input=self)" onChange="@command('onChangeFindForeing',alias='idalmproject',att='proyectoalm,',event=event)"/>
</div><div sclass="mb-2">
<listbox height="400px" mold="paging" pageSize="20" pagingPosition="bottom" model="@bind(vm.foreings['idalmproject'])" onSelect="@command('onSelectForeingPopup', alias='idalmproject',item=self.selectedItem.value,hidde=searchqzTexLMpkk,updatebean='false' )">
<listhead>
<listheader label="@load(vm.lang.getProperty('PROYECTOALM.label','PROYECTOALM'))"  />
</listhead>
<template name="model" var="item">
<listitem value="@load(item)">
<listcell label="@load(item.proyectoalm)" />
</listitem></template></listbox>
</div></div></div></div></window>


  
</h:div>




				

  <div class="col-md-3  input-group" visible="@load(vm.isVisible('ALTA')) " >
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ALTA.label', ''))"/>
	  
	      <label sclass=" font-weight-normal align-text-middle" style="" value="@bind(vm.beanData.alta) @save(vm.beanData.alta, before=('grabar')) @converter(vm.fieldConverter,type='DATE')"/>
    
      </div>






 <div class="col-md-3   input-grou" visible="@load(vm.isVisible('ACTIVATED'))">
 	    <label sclass="form-check-label font-weight-normal align-text-middle" style="" value="@load(vm.lang.getProperty('ACTIVATED.label', 'Activado'))"/>
 <checkbox mold="switch" id="ibqqKYJLRO" value="@bind(vm.beanData.activated) @save(vm.beanData.activated, before=('grabar'))" sclass=" " visible="@load(vm.isVisible('ACTIVATED'))" disabled="@load(vm.isEditable('ACTIVATED')?false:true)" checked="@bind(vm.beanData.activated) @save(vm.beanData.activated, before=('grabar'))"/>
</div>





				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('SECRETKEY'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('SECRETKEY.label', 'Secret Key'))"  />
	   
	    <textbox  readonly="true"  tabindex="4" id="904379" 
	   placeholder="@load(vm.lang.getProperty('SECRETKEY.label', 'Secret Key'))" 
	   value="@bind(vm.beanData.secretkey) @save(vm.beanData.secretkey, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('SECRETKEY'))" disabled="@load(vm.isEditable('SECRETKEY')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['904379'])"/>
            
	   
    </div>   






				

    <div class="col-md-6  input-group" visible="@load(vm.isVisible('USERKEY'))" >
   
	    <label sclass="text form-label  text-capitalize  font-weight-normal align-text-middle" style="  " value="@load(vm.lang.getProperty('USERKEY.label', 'User Key'))"  />
	   
	    <textbox  readonly="true"  tabindex="5" id="989872" 
	   placeholder="@load(vm.lang.getProperty('USERKEY.label', 'User Key'))" 
	   value="@bind(vm.beanData.userkey) @save(vm.beanData.userkey, before=('grabar')) "  sclass="  " 
	   visible="@load(vm.isVisible('USERKEY'))" disabled="@load(vm.isEditable('USERKEY')?false:true)"/>
       <label sclass="text-danger" value="@load(vmsgs['989872'])"/>
            
	   
    </div>   




         </div> 
       </div>
  </div>
 </div>  
          
                              
          
        



               </div>      
	  	          
	  	          </div>
			 </div>
			 </div>
		 </div>
		  <fragment exps="@load(vm.lang['secretkey.screen'])" >
				<![CDATA[
				<div id="modal_iconified" class="modal fade" tabindex="-1" style="z-index: 99999;">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title"><span textContent='@load(exps)'></span></h5>
							</div>
							<div class="modal-body">
								<h6 class="font-weight-semibold"><i class="icon-law mr-2"></i>Texto de ayuda pantalla</h6>
								<span textContent='@load(exps)'></span>
							</div>
							<div class="modal-footer">
								<button class="btn btn-link" data-dismiss="modal"><i class="icon-cross2 font-size-base mr-1"></i> Close</button>
							</div>
						</div>
					</div>
				</div>
				]]>
				</fragment>







		 <window id="WIN_HELP"  visible="false" position="center,center" 
    action="show: slideDown;hide: slideUp" sclass="z-messagebox-window" border="none"  width="70%">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h:h5 class="modal-title">
						Ayuda
					</h:h5>
				</div>
				<div class="modal-body" >
				</div>
				<div class="modal-footer">
				  <div class="hstack gap-2 justify-content-end">
									<button onClick="WIN_HELP.setVisible(false)"
										class="btn btn-light" >
										Cerrar
									</button>
				</div>
			</div>
		</div>
	</window>
 </idspace>
<script  >
zk.afterMount(function() {
 var binder = zkbind.$('$secretkey');
  binder.command('doLoad');
});
</script>
</zk>